#ifndef FTL_CONCEPTS_HEADER
#define FTL_CONCEPTS_HEADER

#ifdef FTL_REPLACE_STL
#include <type_traits>
#else
#include <ftl/type_traits>
#endif

FTL_BEGIN_NAMESPACE

template <class T, class U>
concept same_as = is_same_v<T, U> && is_same_v<U, T>;

template <class Derived, class Base>
concept derived_from =
    is_base_of_v<Base, Derived> &&
    is_convertible_v<const volatile Derived *, const volatile Base *>;

template <class From, class To>
concept convertible_to = is_convertible_v<From, To> &&
                         requires { static_cast<To>(declval<From>()); };

template <class T, class U>
concept common_reference_with =
    same_as<common_reference_t<T, U>, common_reference_t<U, T>> &&
    convertible_to<T, common_reference_t<T, U>> &&
    convertible_to<U, common_reference_t<T, U>>;

template <class T, class U>
concept common_with =
    same_as<common_type_t<T, U>, common_type_t<U, T>> &&
    requires {
      static_cast<common_type_t<T, U>>(declval<T>());
      static_cast<common_type_t<T, U>>(declval<U>());
    } &&
    common_reference_with<add_lvalue_reference_t<const T>,
                          add_lvalue_reference_t<const U>> &&
    common_reference_with<add_lvalue_reference_t<common_type_t<T, U>>,
                          common_reference_t<add_lvalue_reference_t<const T>,
                                             add_lvalue_reference_t<const U>>>;

template <class T>
concept integral = is_integral_v<T>;

template <class T>
concept signed_integral = integral<T> && is_signed_v<T>;

template <class T>
concept unsigned_integral = integral<T> && is_unsigned_v<T>;

template <class T>
concept floating_point = is_floating_point_v<T>;

template <class T>
concept destructible = is_nothrow_destructible_v<T>;

template <class T, class... Args>
concept constructible_from = destructible<T> && is_constructible_v<T, Args...>;

template <class T>
concept default_initializable = constructible_from<T> && requires {
  T{};
  ::new T;
};

template <class T>
concept move_constructible = constructible_from<T, T> && convertible_to<T, T>;

template <class T>
concept copy_constructible =
    move_constructible<T> && constructible_from<T, T &> &&
    convertible_to<T &, T> && constructible_from<T, const T &> &&
    convertible_to<const T &, T> && constructible_from<T, const T> &&
    convertible_to<const T, T>;

template <class Left, class Right>
concept assignable_from =
    is_lvalue_reference_v<Left> &&
    common_reference_with<const remove_reference_t<Left> &,
                          const remove_reference_t<Right> &> &&
    requires(Left left, Right &&right) {
      { left = static_cast<Right &&>(right) } -> same_as<Left>;
    };

namespace ranges {
namespace detail {

namespace swap_adl {

template <class T> void swap(T &, T &) = delete;

template <class T>
concept class_or_enum =
    is_class_v<remove_cvref_t<T>> || is_union_v<remove_cvref_t<T>> ||
    is_enum_v<remove_cvref_t<T>>;

template <class T, class U>
concept has_adl_swap =
    (class_or_enum<T> || class_or_enum<U>) && requires(T &&left, U &&right) {
      swap(static_cast<T &&>(left), static_cast<U &&>(right));
    };

template <class T, class U>
constexpr void call(T &&left, U &&right) noexcept(
    noexcept(swap(static_cast<T &&>(left), static_cast<U &&>(right))))
  requires has_adl_swap<T, U>
{
  (void)swap(static_cast<T &&>(left), static_cast<U &&>(right));
}

} // namespace swap_adl

struct swap_fn {
private:
  template <class T, class U> static consteval bool is_noexcept() {
    if constexpr (swap_adl::has_adl_swap<T, U>) {
      return noexcept(swap_adl::call(declval<T>(), declval<U>()));
    } else {
      using value_type = remove_reference_t<T>;
      return is_nothrow_move_constructible_v<value_type> &&
             is_nothrow_move_assignable_v<value_type>;
    }
  }

public:
  template <class T, class U>
    requires swap_adl::has_adl_swap<T, U> ||
             (same_as<T, U> && is_lvalue_reference_v<T> &&
              move_constructible<remove_reference_t<T>> &&
              assignable_from<T, remove_reference_t<T>>)
  constexpr void operator()(T &&left, U &&right) const
      noexcept(is_noexcept<T, U>()) {
    if constexpr (swap_adl::has_adl_swap<T, U>) {
      swap_adl::call(static_cast<T &&>(left), static_cast<U &&>(right));
    } else {
      using value_type = remove_reference_t<T>;

      value_type temporary(static_cast<value_type &&>(left));

      left = static_cast<value_type &&>(right);
      right = static_cast<value_type &&>(temporary);
    }
  }

  template <class T, class U, size_t Size>
    requires requires(const swap_fn &swapper, T &left, U &right) {
      swapper(left, right);
    }
  constexpr void operator()(T (&left)[Size], U (&right)[Size]) const
      noexcept(noexcept(declval<const swap_fn &>()(declval<T &>(),
                                                   declval<U &>()))) {
    for (size_t index = 0; index < Size; ++index) {
      (*this)(left[index], right[index]);
    }
  }
};

} // namespace detail

inline namespace cpo {
inline constexpr detail::swap_fn swap{};
}

} // namespace ranges

template <class T>
concept swappable = requires(T &left, T &right) { ranges::swap(left, right); };

template <class T, class U>
concept swappable_with =
    common_reference_with<T, U> && requires(T &&left, U &&right) {
      ranges::swap(static_cast<T &&>(left), static_cast<T &&>(left));

      ranges::swap(static_cast<U &&>(right), static_cast<U &&>(right));

      ranges::swap(static_cast<T &&>(left), static_cast<U &&>(right));

      ranges::swap(static_cast<U &&>(right), static_cast<T &&>(left));
    };

namespace detail {

template <class T>
concept boolean_testable_impl = convertible_to<T, bool>;

template <class T>
concept boolean_testable = boolean_testable_impl<T> && requires(T &&value) {
  { !static_cast<T &&>(value) } -> boolean_testable_impl;
};

template <class T, class U, class C = common_reference_t<const T &, const U &>>
concept comparison_common_type_with_impl =
    same_as<common_reference_t<const T &, const U &>,
            common_reference_t<const U &, const T &>> &&
    requires {
      requires convertible_to<const T &, const C &> ||
                   convertible_to<T, const C &>;

      requires convertible_to<const U &, const C &> ||
                   convertible_to<U, const C &>;
    };

template <class T, class U>
concept comparison_common_type_with =
    comparison_common_type_with_impl<remove_cvref_t<T>, remove_cvref_t<U>>;

template <class T, class U>
concept weakly_equality_comparable_with = requires(
    const remove_reference_t<T> &left, const remove_reference_t<U> &right) {
  { left == right } -> boolean_testable;
  { left != right } -> boolean_testable;
  { right == left } -> boolean_testable;
  { right != left } -> boolean_testable;
};

template <class T, class U>
concept partially_ordered_with = requires(const remove_reference_t<T> &left,
                                          const remove_reference_t<U> &right) {
  { left < right } -> boolean_testable;
  { left > right } -> boolean_testable;
  { left <= right } -> boolean_testable;
  { left >= right } -> boolean_testable;

  { right < left } -> boolean_testable;
  { right > left } -> boolean_testable;
  { right <= left } -> boolean_testable;
  { right >= left } -> boolean_testable;
};

} // namespace detail

template <class T>
concept equality_comparable = detail::weakly_equality_comparable_with<T, T>;

template <class T, class U>
concept equality_comparable_with =
    equality_comparable<T> && equality_comparable<U> &&
    detail::comparison_common_type_with<T, U> &&
    equality_comparable<common_reference_t<const remove_reference_t<T> &,
                                           const remove_reference_t<U> &>> &&
    detail::weakly_equality_comparable_with<T, U>;

template <class T>
concept totally_ordered =
    equality_comparable<T> && detail::partially_ordered_with<T, T>;

template <class T, class U>
concept totally_ordered_with =
    totally_ordered<T> && totally_ordered<U> &&
    equality_comparable_with<T, U> &&
    totally_ordered<common_reference_t<const remove_reference_t<T> &,
                                       const remove_reference_t<U> &>> &&
    detail::partially_ordered_with<T, U>;

template <class T>
concept movable = is_object_v<T> && move_constructible<T> &&
                  assignable_from<T &, T> && swappable<T>;

template <class T>
concept copyable =
    copy_constructible<T> && movable<T> && assignable_from<T &, T &> &&
    assignable_from<T &, const T &> && assignable_from<T &, const T>;

template <class T>
concept semiregular = copyable<T> && default_initializable<T>;

template <class T>
concept regular = semiregular<T> && equality_comparable<T>;

template <class F, class... Args>
concept invocable = is_invocable_v<F, Args...>;

template <class F, class... Args>
concept regular_invocable = invocable<F, Args...>;

template <class F, class... Args>
concept predicate = regular_invocable<F, Args...> &&
                    detail::boolean_testable<invoke_result_t<F, Args...>>;

template <class Relation, class T, class U>
concept relation = predicate<Relation, T, T> && predicate<Relation, U, U> &&
                   predicate<Relation, T, U> && predicate<Relation, U, T>;

template <class Relation, class T, class U>
concept equivalence_relation = relation<Relation, T, U>;

template <class Relation, class T, class U>
concept strict_weak_order = relation<Relation, T, U>;

