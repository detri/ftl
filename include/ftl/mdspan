template <class IndexType, size_t... Extents> class extents;

namespace detail {

template <class IndexType, size_t Rank, size_t... Values>
struct make_dextents
    : make_dextents<IndexType, Rank - 1, Values..., dynamic_extent> {};

template <class IndexType, size_t... Values>
struct make_dextents<IndexType, 0, Values...> {
  using type = extents<IndexType, Values...>;
};

template <class IndexType, size_t Count> class extents_storage {
public:
  [[nodiscard]]
  constexpr IndexType get(size_t index) const noexcept {
    return values_[index];
  }

  constexpr void set(size_t index, IndexType value) noexcept {
    values_[index] = value;
  }

private:
  IndexType values_[Count]{};
};

template <class IndexType> class extents_storage<IndexType, 0> {
public:
  [[nodiscard]]
  constexpr IndexType get(size_t) const noexcept {
    /*
     * No valid dynamic index exists. This only keeps discarded
     * or precondition-violating code paths well-formed.
     */
    return IndexType{};
  }

  constexpr void set(size_t, IndexType) noexcept {}
};

template <size_t... Values> struct extent_pack {};

template <class To, class From> struct extents_conversion {
  static constexpr bool compatible = false;
  static constexpr bool dynamic_to_static = false;
};

template <> struct extents_conversion<extent_pack<>, extent_pack<>> {
  static constexpr bool compatible = true;
  static constexpr bool dynamic_to_static = false;
};

template <size_t To, size_t... ToRest, size_t From, size_t... FromRest>
struct extents_conversion<extent_pack<To, ToRest...>,
                          extent_pack<From, FromRest...>> {
private:
  using tail =
      extents_conversion<extent_pack<ToRest...>, extent_pack<FromRest...>>;

public:
  static constexpr bool compatible =
      (From == dynamic_extent || To == dynamic_extent || From == To) &&
      tail::compatible;

  static constexpr bool dynamic_to_static =
      (To != dynamic_extent && From == dynamic_extent) ||
      tail::dynamic_to_static;
};

template<class T>
inline constexpr bool is_mdspan_index_type_v =
    is_integral_v<T> &&
    !is_same_v<T, bool> &&
    !is_same_v<T, char> &&
    !is_same_v<T, wchar_t> &&
    !is_same_v<T, char8_t> &&
    !is_same_v<T, char16_t> &&
    !is_same_v<T, char32_t>;

} // namespace detail

template <class IndexType, size_t Rank>
using dextents = typename detail::make_dextents<IndexType, Rank>::type;

template <class IndexType, size_t... Extents> class extents {
public:
  using index_type = IndexType;
  using size_type = make_unsigned_t<index_type>;
  using rank_type = size_t;

private:
  static_assert(is_same_v<index_type, remove_cv_t<index_type>>,
                "extents index type must be cv-unqualified");

  static_assert(detail::is_mdspan_index_type_v<index_type>,
                "extents index type must be a signed or unsigned integer type");

  [[nodiscard]]
  static consteval bool static_extent_is_valid(size_t value) noexcept {
    if (value == dynamic_extent) {
      return true;
    }

    /*
     * Every size_t value is representable when index_type has at
     * least as many value bits. Otherwise compare against its max.
     */
    if constexpr (numeric_limits<index_type>::digits >=
                  numeric_limits<size_t>::digits) {
      return true;
    } else {
      return value <= static_cast<size_t>(numeric_limits<index_type>::max());
    }
  }

  static_assert((static_extent_is_valid(Extents) && ...),
                "static extent is not representable by index_type");

  [[nodiscard]]
  static constexpr rank_type dynamic_index(rank_type rank_index) noexcept {
    rank_type result = 0;

    for (rank_type current = 0; current < rank_index; ++current) {
      if (static_extent(current) == dynamic_extent) {
        ++result;
      }
    }

    return result;
  }

  template <size_t N, class Sequence>
  constexpr void assign_from(const Sequence &values) noexcept {
    if constexpr (N == 0 || rank_dynamic() == 0) {
      return;
    } else if constexpr (N == rank_dynamic()) {
      for (rank_type dynamic = 0; dynamic < rank_dynamic(); ++dynamic) {
        dynamic_extents_.set(
            dynamic, static_cast<index_type>(as_const(values[dynamic])));
      }
    } else {
      rank_type dynamic = 0;

      for (rank_type current = 0; current < rank(); ++current) {
        if (static_extent(current) == dynamic_extent) {
          dynamic_extents_.set(
              dynamic, static_cast<index_type>(as_const(values[current])));
          ++dynamic;
        }
      }
    }
  }

public:
  [[nodiscard]]
  static constexpr rank_type rank() noexcept {
    return sizeof...(Extents);
  }

  [[nodiscard]]
  static constexpr rank_type rank_dynamic() noexcept {
    return (rank_type{0} + ... +
            (Extents == dynamic_extent ? rank_type{1} : rank_type{0}));
  }

  [[nodiscard]]
  static constexpr size_t static_extent(rank_type rank_index) noexcept {
    if constexpr (rank() == 0) {
      /*
       * static_extent(i) requires i < rank(). No valid index exists
       * for rank-zero extents; this branch only prevents formation
       * of array<size_t, 0>::operator[].
       */
      (void)rank_index;
      return dynamic_extent;
    } else {
      constexpr array<size_t, rank()> values{Extents...};

      return values[rank_index];
    }
  }

  [[nodiscard]]
  constexpr index_type extent(rank_type rank_index) const noexcept {
    const size_t static_value = static_extent(rank_index);

    if (static_value != dynamic_extent) {
      return static_cast<index_type>(static_value);
    }

    return dynamic_extents_.get(dynamic_index(rank_index));
  }

  constexpr extents() noexcept = default;

  template <class OtherIndexType, size_t... OtherExtents>
    requires detail::extents_conversion<
        detail::extent_pack<Extents...>,
        detail::extent_pack<OtherExtents...>>::compatible
  constexpr explicit(
      detail::extents_conversion<
          detail::extent_pack<Extents...>,
          detail::extent_pack<OtherExtents...>>::dynamic_to_static ||
      numeric_limits<index_type>::max() < numeric_limits<OtherIndexType>::max())
      extents(const extents<OtherIndexType, OtherExtents...> &other) noexcept {
    if constexpr (rank_dynamic() > 0) {
      rank_type dynamic = 0;

      for (rank_type current = 0; current < rank(); ++current) {
        if (static_extent(current) == dynamic_extent) {
          dynamic_extents_.set(dynamic,
                               static_cast<index_type>(other.extent(current)));
          ++dynamic;
        }
      }
    }
  }

  template <class... OtherIndexTypes>
    requires((is_convertible_v<OtherIndexTypes, index_type> && ...) &&
             (is_nothrow_constructible_v<index_type, OtherIndexTypes> && ...) &&
             (sizeof...(OtherIndexTypes) == rank_dynamic() ||
              sizeof...(OtherIndexTypes) == rank()))
  explicit constexpr extents(OtherIndexTypes... values) noexcept {
    constexpr size_t count = sizeof...(OtherIndexTypes);

    array<index_type, count> converted{
        static_cast<index_type>(move(values))...};

    assign_from<count>(converted);
  }

  template <class OtherIndexType, size_t N>
    requires(is_convertible_v<const OtherIndexType &, index_type> &&
             is_nothrow_constructible_v<index_type, const OtherIndexType &> &&
             (N == rank_dynamic() || N == rank()))
  constexpr explicit(N != rank_dynamic())
      extents(span<OtherIndexType, N> values) noexcept {
    assign_from<N>(values);
  }

  template <class OtherIndexType, size_t N>
    requires(is_convertible_v<const OtherIndexType &, index_type> &&
             is_nothrow_constructible_v<index_type, const OtherIndexType &> &&
             (N == rank_dynamic() || N == rank()))
  constexpr explicit(N != rank_dynamic())
      extents(const array<OtherIndexType, N> &values) noexcept {
    assign_from<N>(values);
  }

    template<class OtherIndexType, size_t... OtherExtents>
    friend constexpr bool
    operator==(const extents& left,
               const extents<OtherIndexType, OtherExtents...>& right) noexcept {
        if constexpr (rank() != sizeof...(OtherExtents)) {
            return false;
        } else {
            for (rank_type current = 0; current < rank(); ++current) {
                if (left.extent(current) != right.extent(current))
                    return false;
            }

            return true;
        }
    }

private:
  FTL_NO_UNIQUE_ADDRESS
  detail::extents_storage<index_type, rank_dynamic()> dynamic_extents_{};
};

template <class... Integrals>
  requires((is_convertible_v<Integrals, size_t> && ...))
explicit extents(Integrals...)
    -> extents<size_t,
               (static_cast<void>(sizeof(Integrals)), dynamic_extent)...>;

namespace detail {

template<class T, class = void>
struct valid_default_accessor_element : false_type {};

template<class T>
struct valid_default_accessor_element<T, void_t<decltype(sizeof(T))>>
    : bool_constant<is_object_v<T> && !is_array_v<T> && !is_abstract_v<T>> {};

template<class T>
inline constexpr bool valid_default_accessor_element_v =
    valid_default_accessor_element<T>::value;

template<class T>
struct is_extents : false_type {};

template<class IndexType, size_t... Extents>
struct is_extents<extents<IndexType, Extents...>> : true_type {};

template<class T>
inline constexpr bool is_extents_v = is_extents<T>::value;

template<class Extents>
consteval bool mapping_static_size_is_representable() {
    if constexpr (Extents::rank_dynamic() != 0) {
        return true;
    } else {
        using index_type = typename Extents::index_type;
        using size_type = typename Extents::size_type;

        for (size_t rank = 0; rank < Extents::rank(); ++rank) {
            if (Extents::static_extent(rank) == 0)
                return true;
        }

        const size_type limit =
            static_cast<size_type>(numeric_limits<index_type>::max());

        size_type product = 1;

        for (size_t rank = 0; rank < Extents::rank(); ++rank) {
            const size_type extent =
                static_cast<size_type>(Extents::static_extent(rank));

            if (product > limit / extent)
                return false;

            product *= extent;
        }

        return true;
    }
}

template<class ToExtents, class FromExtents>
inline constexpr bool mapping_extents_constructible_v =
    is_constructible_v<ToExtents, FromExtents>;

template<class ToExtents, class FromExtents>
inline constexpr bool left_right_mapping_constructible_v =
    ToExtents::rank() <= 1 &&
    is_constructible_v<ToExtents, FromExtents>;

} // namespace detail

struct layout_left {
    template<class Extents>
    class mapping;
};

struct layout_right {
    template<class Extents>
    class mapping;
};

struct layout_stride {
    template<class Extents>
    class mapping;
};

namespace detail {

template<class Layout, class Mapping>
inline constexpr bool is_mapping_of_v = false;

template<class Extents>
inline constexpr bool
    is_mapping_of_v<layout_left, layout_left::mapping<Extents>> = true;

template<class Extents>
inline constexpr bool
    is_mapping_of_v<layout_right, layout_right::mapping<Extents>> = true;

template<class Extents>
inline constexpr bool
    is_mapping_of_v<layout_stride, layout_stride::mapping<Extents>> = true;

template<class Mapping>
using mapping_extents_t = typename Mapping::extents_type;

template<class Mapping>
inline constexpr size_t mapping_rank_v = mapping_extents_t<Mapping>::rank();

template<class Mapping>
concept layout_mapping_alike = requires {
    typename Mapping::extents_type;

    requires is_extents_v<typename Mapping::extents_type>;

    { Mapping::is_always_strided() } -> same_as<bool>;
    { Mapping::is_always_exhaustive() } -> same_as<bool>;
    { Mapping::is_always_unique() } -> same_as<bool>;

    bool_constant<Mapping::is_always_strided()>::value;
    bool_constant<Mapping::is_always_exhaustive()>::value;
    bool_constant<Mapping::is_always_unique()>::value;
};

template<class Mapping, size_t... Indices>
constexpr typename Mapping::index_type
mapping_offset_impl(const Mapping& mapping,
                    index_sequence<Indices...>) noexcept {
    using index_type = typename Mapping::index_type;

    return mapping((static_cast<void>(Indices), index_type{})...);
}

template<class Mapping>
constexpr typename Mapping::index_type
mapping_offset(const Mapping& mapping) noexcept {
    using extents_type = typename Mapping::extents_type;
    using index_type = typename Mapping::index_type;

    if constexpr (extents_type::rank() == 0) {
        return mapping();
    } else {
        for (size_t rank = 0; rank < extents_type::rank(); ++rank) {
            if (mapping.extents().extent(rank) == 0)
                return index_type{};
        }

        return mapping_offset_impl(
            mapping, make_index_sequence<extents_type::rank()>{});
    }
}

} // namespace detail

template<class ElementType>
struct default_accessor {
    static_assert(detail::valid_default_accessor_element_v<ElementType>,
                  "default_accessor requires a complete, non-array, "
                  "non-abstract object type");

    using offset_policy = default_accessor;
    using element_type = ElementType;
    using reference = ElementType&;
    using data_handle_type = ElementType*;

    constexpr default_accessor() noexcept = default;

    template<class OtherElementType>
        requires is_convertible_v<OtherElementType (*)[], element_type (*)[]>
    constexpr default_accessor(default_accessor<OtherElementType>) noexcept {}

    [[nodiscard]] constexpr reference
    access(data_handle_type pointer, size_t index) const noexcept {
        return pointer[index];
    }

    [[nodiscard]] constexpr data_handle_type
    offset(data_handle_type pointer, size_t index) const noexcept {
        return pointer + index;
    }
};

template<class Extents>
class layout_left::mapping {
    static_assert(detail::is_extents_v<Extents>,
                  "layout_left::mapping requires an extents specialization");

public:
    using extents_type = Extents;
    using index_type = typename extents_type::index_type;
    using size_type = typename extents_type::size_type;
    using rank_type = typename extents_type::rank_type;
    using layout_type = layout_left;

private:
    static_assert(
        detail::mapping_static_size_is_representable<extents_type>(),
        "layout_left index space is not representable by its index type");

public:
    constexpr mapping() noexcept = default;
    constexpr mapping(const mapping&) noexcept = default;

    constexpr mapping(const extents_type& extents) noexcept
        : extents_(extents) {}

    template<class OtherExtents>
        requires detail::left_right_mapping_constructible_v<Extents, OtherExtents>
    constexpr explicit(!is_convertible_v<OtherExtents, Extents>)
    mapping(const layout_right::mapping<OtherExtents>& other) noexcept;

    template<class OtherExtents>
        requires detail::mapping_extents_constructible_v<Extents, OtherExtents>
    constexpr explicit(Extents::rank() > 0)
    mapping(const layout_stride::mapping<OtherExtents>& other);

    constexpr mapping& operator=(const mapping&) noexcept = default;

    [[nodiscard]] constexpr const extents_type& extents() const noexcept {
        return extents_;
    }

    template<class OtherExtents>
        requires is_constructible_v<extents_type, OtherExtents>
    constexpr explicit(!is_convertible_v<OtherExtents, extents_type>)
    mapping(const layout_left::mapping<OtherExtents>& other) noexcept
        : extents_(other.extents()) {}

    [[nodiscard]] constexpr index_type required_span_size() const noexcept {
        for (rank_type rank = 0; rank < extents_type::rank(); ++rank) {
            if (extents_.extent(rank) == 0)
                return 0;
        }

        size_type result = 1;

        for (rank_type rank = 0; rank < extents_type::rank(); ++rank)
            result *= static_cast<size_type>(extents_.extent(rank));

        return static_cast<index_type>(result);
    }

    template<class... Indices>
        requires(sizeof...(Indices) == extents_type::rank() &&
                 (is_convertible_v<Indices, index_type> && ...) &&
                 (is_nothrow_constructible_v<index_type, Indices> && ...))
    [[nodiscard]] constexpr index_type
    operator()(Indices... indices) const noexcept {
        index_type result = 0;
        rank_type rank = 0;

        ((result +=
              static_cast<index_type>(indices) * stride(rank++)),
         ...);

        return result;
    }

    [[nodiscard]] static constexpr bool is_always_unique() noexcept {
        return true;
    }

    [[nodiscard]] static constexpr bool is_always_exhaustive() noexcept {
        return true;
    }

    [[nodiscard]] static constexpr bool is_always_strided() noexcept {
        return true;
    }

    [[nodiscard]] static constexpr bool is_unique() noexcept {
        return true;
    }

    [[nodiscard]] static constexpr bool is_exhaustive() noexcept {
        return true;
    }

    [[nodiscard]] static constexpr bool is_strided() noexcept {
        return true;
    }

    [[nodiscard]] constexpr index_type stride(rank_type rank) const noexcept
        requires(extents_type::rank() > 0)
    {
        size_type result = 1;

        for (rank_type current = 0; current < rank; ++current)
            result *= static_cast<size_type>(extents_.extent(current));

        return static_cast<index_type>(result);
    }

    template<class OtherExtents>
        requires(extents_type::rank() == OtherExtents::rank())
    friend constexpr bool
    operator==(const mapping& left,
               const layout_left::mapping<OtherExtents>& right) noexcept {
        return left.extents() == right.extents();
    }

private:
    FTL_NO_UNIQUE_ADDRESS extents_type extents_{};
};

