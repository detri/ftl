#ifndef FTL_CASSERT_HEADER
#define FTL_CASSERT_HEADER

#undef assert
#ifdef NDEBUG
#define assert(E) ((void)0)
#elif defined(_WIN32)
extern "C" void _assert(const char*, const char*, unsigned);
#define assert(E) ((E) ? (void)0 : _assert(#E, __FILE__, __LINE__))
#elif defined(__APPLE__)
extern "C" void __assert_rtn(const char*, const char*, int, const char*);
#define assert(E) ((E) ? (void)0 : __assert_rtn(__func__, __FILE__, __LINE__, #E))
#else
extern "C" [[noreturn]] void __assert_fail(const char*, const char*, unsigned, const char*) noexcept;
#define assert(E) ((E) ? (void)0 : __assert_fail(#E, __FILE__, __LINE__, __func__))
#endif

#endif
