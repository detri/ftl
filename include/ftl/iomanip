namespace detail {
struct reset_flags {
  ios_base::fmtflags mask;
};
struct set_flags {
  ios_base::fmtflags mask;
};
struct set_base {
  int base;
};
template <class C> struct set_fill {
  C value;
};
struct set_precision {
  int value;
};
struct set_width {
  int value;
};
template <class Money> struct get_money_value {
  Money &value;
  bool international;
};
template <class Money> struct put_money_value {
  const Money &value;
  bool international;
};
template <class C> struct get_time_value {
  tm *value;
  const C *format;
};
template <class C> struct put_time_value {
  const tm *value;
  const C *format;
};
template <class C, class T = char_traits<C>> struct quoted_output {
  basic_string_view<C, T> value;
  C delimiter;
  C escape;
};
template <class C, class T, class A> struct quoted_input {
  basic_string<C, T, A> &value;
  C delimiter;
  C escape;
};
template <class Stream> Stream &apply_base(Stream &s, int base) {
  auto flag = base == 8    ? ios_base::oct
              : base == 10 ? ios_base::dec
              : base == 16 ? ios_base::hex
                           : ios_base::fmtflags{};
  s.setf(flag, ios_base::basefield);
  return s;
}
} // namespace detail

inline detail::reset_flags resetiosflags(ios_base::fmtflags mask) {
  return {mask};
}
inline detail::set_flags setiosflags(ios_base::fmtflags mask) { return {mask}; }
inline detail::set_base setbase(int base) { return {base}; }
template <class C> detail::set_fill<C> setfill(C value) { return {value}; }
inline detail::set_precision setprecision(int value) { return {value}; }
inline detail::set_width setw(int value) { return {value}; }
template <class Money>
detail::get_money_value<Money> get_money(Money &value,
                                         bool international = false) {
  return {value, international};
}
template <class Money>
detail::put_money_value<Money> put_money(const Money &value,
                                         bool international = false) {
  return {value, international};
}
template <class C>
detail::get_time_value<C> get_time(tm *value, const C *format) {
  return {value, format};
}
template <class C>
detail::put_time_value<C> put_time(const tm *value, const C *format) {
  return {value, format};
}
template <class C>
detail::quoted_output<C> quoted(const C *value, C delimiter = C('"'),
                                C escape = C('\\')) {
  return {{value}, delimiter, escape};
}
template <class C, class T, class A>
detail::quoted_input<C, T, A> quoted(basic_string<C, T, A> &value,
                                     C delimiter = C('"'), C escape = C('\\')) {
  return {value, delimiter, escape};
}
template <class C, class T, class A>
detail::quoted_output<C, T> quoted(const basic_string<C, T, A> &value,
                                   C delimiter = C('"'), C escape = C('\\')) {
  return {{value.data(), value.size()}, delimiter, escape};
}
template <class C, class T>
detail::quoted_output<C, T> quoted(basic_string_view<C, T> value,
                                   C delimiter = C('"'), C escape = C('\\')) {
  return {value, delimiter, escape};
}

template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s, detail::reset_flags v) {
  s.unsetf(v.mask);
  return s;
}
template <class C, class T>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s, detail::reset_flags v) {
  s.unsetf(v.mask);
  return s;
}
template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s, detail::set_flags v) {
  s.setf(v.mask);
  return s;
}
template <class C, class T>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s, detail::set_flags v) {
  s.setf(v.mask);
  return s;
}
template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s, detail::set_base v) {
  return detail::apply_base(s, v.base);
}
template <class C, class T>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s, detail::set_base v) {
  return detail::apply_base(s, v.base);
}
template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s, detail::set_fill<C> v) {
