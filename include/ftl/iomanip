template <class C, class T, class Money>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s,
                                detail::get_money_value<Money> v) {
  typename basic_istream<C, T>::sentry guard(s);
  ios_base::iostate state = ios_base::goodbit;
  if (guard) {
    using iterator = istreambuf_iterator<C, T>;
    use_facet<money_get<C, iterator>>(s.getloc())
        .get(iterator(s), iterator(), v.international, s, state, v.value);
  }
  if (state)
    s.setstate(state);
  return s;
}
template <class C, class T, class Money>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s,
                                detail::put_money_value<Money> v) {
  typename basic_ostream<C, T>::sentry guard(s);
  if (guard) {
    using iterator = ostreambuf_iterator<C, T>;
    auto result = use_facet<money_put<C, iterator>>(s.getloc())
                      .put(iterator(s), v.international, s, s.fill(), v.value);
    if (result.failed())
      s.setstate(ios_base::badbit);
  }
  return s;
}
template <class C, class T>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s,
                                detail::get_time_value<C> v) {
  typename basic_istream<C, T>::sentry guard(s);
  ios_base::iostate state = ios_base::goodbit;
  if (guard) {
    using iterator = istreambuf_iterator<C, T>;
    const C *end = v.format;
    while (*end)
      ++end;
    use_facet<time_get<C, iterator>>(s.getloc())
        .get(iterator(s), iterator(), s, state, v.value, v.format, end);
  }
  if (state)
    s.setstate(state);
  return s;
}
template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s,
                                detail::put_time_value<C> v) {
  typename basic_ostream<C, T>::sentry guard(s);
  if (guard) {
    using iterator = ostreambuf_iterator<C, T>;
    const C *end = v.format;
    while (*end)
      ++end;
    auto result = use_facet<time_put<C, iterator>>(s.getloc())
                      .put(iterator(s), s, s.fill(), v.value, v.format, end);
    if (result.failed())
      s.setstate(ios_base::badbit);
  }
  return s;
}

template <class C, class T>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s,
                                const detail::quoted_output<C, T> &v) {
  basic_string<C, T> text;
  text.push_back(v.delimiter);
  for (C c : v.value) {
    if (T::eq(c, v.delimiter) || T::eq(c, v.escape))
      text.push_back(v.escape);
    text.push_back(c);
  }
  text.push_back(v.delimiter);
  return s << text;
}
template <class C, class T, class A>
basic_ostream<C, T> &operator<<(basic_ostream<C, T> &s,
                                const detail::quoted_input<C, T, A> &v) {
  return s << detail::quoted_output<C, T>{
             {v.value.data(), v.value.size()}, v.delimiter, v.escape};
}
template <class C, class T, class A>
basic_istream<C, T> &operator>>(basic_istream<C, T> &s,
                                const detail::quoted_input<C, T, A> &v) {
  C first{};
  if (!(s >> first))
    return s;
  if (!T::eq(first, v.delimiter)) {
    s.putback(first);
    return s >> v.value;
  }
  auto flags = s.flags();
  s.unsetf(ios_base::skipws);
  v.value.clear();
  bool escaped = false, closed = false;
  for (C c{}; s.get(c);) {
    if (escaped) {
      v.value.push_back(c);
      escaped = false;
    } else if (T::eq(c, v.escape))
      escaped = true;
    else if (T::eq(c, v.delimiter)) {
      closed = true;
      break;
    } else
      v.value.push_back(c);
  }
  s.flags(flags);
  if (!closed)
    s.setstate(ios_base::failbit);
  return s;
}

