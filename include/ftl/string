template <class C, class T, class A, class U>
constexpr typename basic_string<C, T, A>::size_type
erase(basic_string<C, T, A> &value, const U &removed) {
  const auto old = value.size();
  auto output = value.begin();
  for (auto current = value.begin(); current != value.end(); ++current)
    if (!(*current == removed))
      *output++ = move(*current);
  value.erase(output, value.end());
  return old - value.size();
}

template <class C, class T, class A, class Predicate>
constexpr typename basic_string<C, T, A>::size_type
erase_if(basic_string<C, T, A> &value, Predicate predicate) {
  const auto old = value.size();
  auto output = value.begin();
  for (auto current = value.begin(); current != value.end(); ++current)
    if (!predicate(*current))
      *output++ = move(*current);
  value.erase(output, value.end());
  return old - value.size();
}

