template <class T> struct hash;

namespace detail {

[[noreturn]] inline void string_position_failure() {
#if FTL_HAS_EXCEPTIONS
  throw out_of_range("basic_string");
#else
  FTL_STRING_TRAP();
#endif
}

[[noreturn]] inline void string_length_failure() {
#if FTL_HAS_EXCEPTIONS
  throw length_error("basic_string");
#else
  FTL_STRING_TRAP();
#endif
}

template <class Traits, class = void> struct string_comparison_category {
  using type = weak_ordering;
};

template <class Traits>
struct string_comparison_category<Traits,
                                  void_t<typename Traits::comparison_category>> {
  using type = typename Traits::comparison_category;
};

template <class Traits>
using string_comparison_category_t =
    typename string_comparison_category<Traits>::type;

template <class R, class Character>
concept string_compatible_range =
    ranges::input_range<R> &&
    convertible_to<ranges::range_reference_t<R>, Character>;

} // namespace detail

template <class Character, class Traits = char_traits<Character>,
          class Allocator = allocator<Character>>
class basic_string {
  static_assert(is_same_v<typename Traits::char_type, Character>);
  static_assert(is_same_v<typename allocator_traits<Allocator>::value_type,
                          Character>);

public:
  using traits_type = Traits;
  using value_type = Character;
  using allocator_type = Allocator;
  using size_type = typename allocator_traits<Allocator>::size_type;
  using difference_type = typename allocator_traits<Allocator>::difference_type;
  using pointer = typename allocator_traits<Allocator>::pointer;
  using const_pointer = typename allocator_traits<Allocator>::const_pointer;
  using reference = value_type &;
  using const_reference = const value_type &;
  using iterator = value_type *;
  using const_iterator = const value_type *;
  using reverse_iterator = FTL_STRING_NAMESPACE::reverse_iterator<iterator>;
  using const_reverse_iterator =
      FTL_STRING_NAMESPACE::reverse_iterator<const_iterator>;

  static constexpr size_type npos = size_type(-1);

  constexpr basic_string() noexcept(noexcept(Allocator()))
      : basic_string(Allocator()) {}

  constexpr explicit basic_string(const Allocator &allocator) noexcept
      : allocator_(allocator) {}

  constexpr basic_string(const basic_string &other)
      : allocator_(allocator_traits<Allocator>::
                       select_on_container_copy_construction(other.allocator_)) {
    initialize(other.data(), other.size());
  }

  constexpr basic_string(basic_string &&other) noexcept
      : allocator_(move(other.allocator_)) {
    steal(other);
  }

  constexpr basic_string(const basic_string &other, size_type position,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    initialize_substring(other, position, npos);
  }

  constexpr basic_string(const basic_string &other, size_type position,
                         size_type count,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    initialize_substring(other, position, count);
  }

  constexpr basic_string(basic_string &&other, size_type position,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    initialize_substring(other, position, npos);
    other.clear();
  }

  constexpr basic_string(basic_string &&other, size_type position,
                         size_type count,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    initialize_substring(other, position, count);
    other.clear();
  }

  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>>
  constexpr basic_string(const T &value, size_type position, size_type count,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    basic_string_view<Character, Traits> view = value;
    view = view.substr(position, count);
    initialize(view.data(), view.size());
  }

  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr explicit basic_string(const T &value,
                                  const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    basic_string_view<Character, Traits> view = value;
    initialize(view.data(), view.size());
  }

  constexpr basic_string(const Character *characters, size_type count,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    initialize(characters, count);
  }

  constexpr basic_string(const Character *characters,
                         const Allocator &allocator = Allocator())
      : basic_string(characters, Traits::length(characters), allocator) {}

  basic_string(nullptr_t) = delete;

  constexpr basic_string(size_type count, Character character,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    assign_fill(count, character);
  }

  template <class InputIterator>
    requires input_iterator<InputIterator>
  constexpr basic_string(InputIterator first, InputIterator last,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      for (; first != last; ++first)
        push_back(static_cast<Character>(*first));
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      deallocate();
      throw;
    }
#endif
  }

  template <detail::string_compatible_range<Character> R>
  constexpr basic_string(from_range_t, R &&range,
                         const Allocator &allocator = Allocator())
      : allocator_(allocator) {
    append_range(static_cast<R &&>(range));
  }

  constexpr basic_string(initializer_list<Character> values,
                         const Allocator &allocator = Allocator())
      : basic_string(values.begin(), values.end(), allocator) {}

  constexpr basic_string(const basic_string &other, const Allocator &allocator)
      : allocator_(allocator) {
    initialize(other.data(), other.size());
  }

  constexpr basic_string(basic_string &&other, const Allocator &allocator)
      : allocator_(allocator) {
    if (allocator_ == other.allocator_) {
      steal(other);
    } else {
      initialize(other.data(), other.size());
    }
  }

  constexpr ~basic_string() { deallocate(); }

  constexpr basic_string &operator=(const basic_string &other) {
    if (this != &other) {
      if constexpr (allocator_traits<Allocator>::
                        propagate_on_container_copy_assignment::value) {
        if (!(allocator_ == other.allocator_)) {
          deallocate();
          allocator_ = other.allocator_;
        }
      }
      assign(other.data(), other.size());
    }
    return *this;
  }

  constexpr basic_string &operator=(basic_string &&other) noexcept(
      allocator_traits<Allocator>::propagate_on_container_move_assignment::
          value ||
      allocator_traits<Allocator>::is_always_equal::value) {
    if (this == &other)
      return *this;
    if constexpr (allocator_traits<Allocator>::
                      propagate_on_container_move_assignment::value) {
      deallocate();
      allocator_ = move(other.allocator_);
      steal(other);
    } else if (allocator_ == other.allocator_) {
      deallocate();
      steal(other);
    } else {
      assign(other.data(), other.size());
      other.clear();
    }
    return *this;
  }

  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &operator=(const T &value) {
    return assign(value);
  }

  constexpr basic_string &operator=(const Character *characters) {
    return assign(characters);
  }
  basic_string &operator=(nullptr_t) = delete;
  constexpr basic_string &operator=(Character character) {
    return assign(1, character);
  }
  constexpr basic_string &operator=(initializer_list<Character> values) {
    return assign(values);
  }

  [[nodiscard]] constexpr iterator begin() noexcept { return data(); }
  [[nodiscard]] constexpr const_iterator begin() const noexcept { return data(); }
  [[nodiscard]] constexpr iterator end() noexcept { return data() + size_; }
  [[nodiscard]] constexpr const_iterator end() const noexcept {
    return data() + size_;
  }
  [[nodiscard]] constexpr reverse_iterator rbegin() noexcept {
    return reverse_iterator(end());
  }
  [[nodiscard]] constexpr const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  [[nodiscard]] constexpr reverse_iterator rend() noexcept {
    return reverse_iterator(begin());
  }
  [[nodiscard]] constexpr const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(begin());
  }
  [[nodiscard]] constexpr const_iterator cbegin() const noexcept {
    return begin();
  }
  [[nodiscard]] constexpr const_iterator cend() const noexcept { return end(); }
  [[nodiscard]] constexpr const_reverse_iterator crbegin() const noexcept {
    return rbegin();
  }
  [[nodiscard]] constexpr const_reverse_iterator crend() const noexcept {
    return rend();
  }

  [[nodiscard]] constexpr size_type size() const noexcept { return size_; }
  [[nodiscard]] constexpr size_type length() const noexcept { return size_; }
  [[nodiscard]] constexpr size_type max_size() const noexcept {
    const size_type allocator_max = allocator_traits<Allocator>::max_size(allocator_);
    return allocator_max == 0 ? 0 : allocator_max - 1;
  }

  constexpr void resize(size_type count, Character character) {
    if (count < size_)
      set_size(count);
    else if (count > size_)
      append(count - size_, character);
  }
  constexpr void resize(size_type count) { resize(count, Character{}); }

  template <class Operation>
  constexpr void resize_and_overwrite(size_type count, Operation operation) {
    reserve_exact(count);
    const size_type result = static_cast<size_type>(operation(data(), count));
    if (result > count)
      FTL_STRING_TRAP();
    set_size(result);
  }

  [[nodiscard]] constexpr size_type capacity() const noexcept {
    return capacity_;
  }
  constexpr void reserve(size_type requested) {
    if (requested > capacity_)
      reserve_exact(requested);
  }
  constexpr void shrink_to_fit() {
    if (size_ == capacity_)
      return;
    basic_string replacement(data(), size_, allocator_);
    swap_storage(replacement);
  }
  constexpr void clear() noexcept { set_size(0); }
  [[nodiscard]] constexpr bool empty() const noexcept { return size_ == 0; }

  [[nodiscard]] constexpr const_reference operator[](size_type position) const {
    return data()[position];
  }
  [[nodiscard]] constexpr reference operator[](size_type position) {
    return data()[position];
  }
  [[nodiscard]] constexpr const_reference at(size_type position) const {
    if (position >= size_)
      detail::string_position_failure();
    return data()[position];
  }
  [[nodiscard]] constexpr reference at(size_type position) {
    if (position >= size_)
      detail::string_position_failure();
    return data()[position];
  }
  [[nodiscard]] constexpr const_reference front() const { return data()[0]; }
  [[nodiscard]] constexpr reference front() { return data()[0]; }
  [[nodiscard]] constexpr const_reference back() const {
    return data()[size_ - 1];
  }
  [[nodiscard]] constexpr reference back() { return data()[size_ - 1]; }

  constexpr basic_string &operator+=(const basic_string &value) {
    return append(value);
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &operator+=(const T &value) { return append(value); }
  constexpr basic_string &operator+=(const Character *value) {
    return append(value);
  }
  constexpr basic_string &operator+=(Character value) {
    push_back(value);
    return *this;
  }
  constexpr basic_string &operator+=(initializer_list<Character> value) {
    return append(value);
  }

  constexpr basic_string &append(const basic_string &value) {
    return append(value.data(), value.size());
  }
  constexpr basic_string &append(const basic_string &value, size_type position,
                                 size_type count = npos) {
    return append(value.substr_view(position, count));
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &append(const T &value) {
    basic_string_view<Character, Traits> view = value;
    return append(view.data(), view.size());
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &append(const T &value, size_type position,
                                 size_type count = npos) {
    basic_string_view<Character, Traits> view = value;
    view = view.substr(position, count);
    return append(view.data(), view.size());
  }
  constexpr basic_string &append(const Character *characters, size_type count) {
    return replace(size_, 0, characters, count);
  }
  constexpr basic_string &append(const Character *characters) {
    return append(characters, Traits::length(characters));
  }
  constexpr basic_string &append(size_type count, Character character) {
    if (count == 0)
      return *this;
    ensure_additional(count);
    Traits::assign(data() + size_, count, character);
    set_size(size_ + count);
    return *this;
  }
  template <class InputIterator>
    requires input_iterator<InputIterator>
  constexpr basic_string &append(InputIterator first, InputIterator last) {
    basic_string source(first, last, allocator_);
    return append(source.data(), source.size());
  }
  template <detail::string_compatible_range<Character> R>
  constexpr basic_string &append_range(R &&range) {
    return append(ranges::begin(range), ranges::end(range));
  }
  constexpr basic_string &append(initializer_list<Character> values) {
    return append(values.begin(), values.end());
  }
  constexpr void push_back(Character character) { append(1, character); }

  constexpr basic_string &assign(const basic_string &value) {
    return assign(value.data(), value.size());
  }
  constexpr basic_string &assign(basic_string &&value) noexcept(
      allocator_traits<Allocator>::propagate_on_container_move_assignment::
          value || allocator_traits<Allocator>::is_always_equal::value) {
    return *this = move(value);
  }
  constexpr basic_string &assign(const basic_string &value, size_type position,
                                 size_type count = npos) {
    return assign(value.substr_view(position, count));
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &assign(const T &value) {
    basic_string_view<Character, Traits> view = value;
    return assign(view.data(), view.size());
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &assign(const T &value, size_type position,
                                 size_type count = npos) {
    basic_string_view<Character, Traits> view = value;
    view = view.substr(position, count);
    return assign(view.data(), view.size());
  }
  constexpr basic_string &assign(const Character *characters, size_type count) {
    basic_string replacement(characters, count, allocator_);
    swap_storage(replacement);
    return *this;
  }
  constexpr basic_string &assign(const Character *characters) {
    return assign(characters, Traits::length(characters));
  }
  constexpr basic_string &assign(size_type count, Character character) {
    basic_string replacement(count, character, allocator_);
    swap_storage(replacement);
    return *this;
  }
  template <class InputIterator>
    requires input_iterator<InputIterator>
  constexpr basic_string &assign(InputIterator first, InputIterator last) {
    basic_string replacement(first, last, allocator_);
    swap_storage(replacement);
    return *this;
  }
  template <detail::string_compatible_range<Character> R>
  constexpr basic_string &assign_range(R &&range) {
    basic_string replacement(from_range, static_cast<R &&>(range), allocator_);
    swap_storage(replacement);
    return *this;
  }
  constexpr basic_string &assign(initializer_list<Character> values) {
    return assign(values.begin(), values.end());
  }

  constexpr basic_string &insert(size_type position, const basic_string &value) {
    return replace(position, 0, value);
  }
  constexpr basic_string &insert(size_type position, const basic_string &value,
                                 size_type source_position,
                                 size_type count = npos) {
    return replace(position, 0, value, source_position, count);
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &insert(size_type position, const T &value) {
    return replace(position, 0, value);
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &insert(size_type position, const T &value,
                                 size_type source_position,
                                 size_type count = npos) {
    return replace(position, 0, value, source_position, count);
  }
  constexpr basic_string &insert(size_type position, const Character *characters,
                                 size_type count) {
    return replace(position, 0, characters, count);
  }
  constexpr basic_string &insert(size_type position,
                                 const Character *characters) {
    return insert(position, characters, Traits::length(characters));
  }
  constexpr basic_string &insert(size_type position, size_type count,
                                 Character character) {
    return replace(position, 0, count, character);
  }
  constexpr iterator insert(const_iterator where, Character character) {
    const size_type position = iterator_position(where);
    insert(position, 1, character);
    return begin() + position;
  }
  constexpr iterator insert(const_iterator where, size_type count,
                            Character character) {
    const size_type position = iterator_position(where);
    insert(position, count, character);
    return begin() + position;
  }
  template <class InputIterator>
    requires input_iterator<InputIterator>
  constexpr iterator insert(const_iterator where, InputIterator first,
                            InputIterator last) {
    const size_type position = iterator_position(where);
    basic_string inserted(first, last, allocator_);
    insert(position, inserted);
    return begin() + position;
  }
  template <detail::string_compatible_range<Character> R>
  constexpr iterator insert_range(const_iterator where, R &&range) {
    return insert(where, ranges::begin(range), ranges::end(range));
  }
  constexpr iterator insert(const_iterator where,
                            initializer_list<Character> values) {
    return insert(where, values.begin(), values.end());
  }

  constexpr basic_string &erase(size_type position = 0, size_type count = npos) {
    check_position(position);
    const size_type removed = minimum(count, size_ - position);
    Traits::move(data() + position, data() + position + removed,
                 size_ - position - removed);
    set_size(size_ - removed);
    return *this;
  }
  constexpr iterator erase(const_iterator where) {
    const size_type position = iterator_position(where);
    erase(position, 1);
    return begin() + position;
  }
  constexpr iterator erase(const_iterator first, const_iterator last) {
    const size_type position = iterator_position(first);
    erase(position, static_cast<size_type>(last - first));
    return begin() + position;
  }
  constexpr void pop_back() { set_size(size_ - 1); }

  constexpr basic_string &replace(size_type position, size_type removed,
                                  const basic_string &value) {
    return replace(position, removed, value.data(), value.size());
  }
  constexpr basic_string &replace(size_type position, size_type removed,
                                  const basic_string &value,
                                  size_type source_position,
                                  size_type count = npos) {
    const auto view = value.substr_view(source_position, count);
    return replace(position, removed, view.data(), view.size());
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &replace(size_type position, size_type removed,
                                  const T &value) {
    basic_string_view<Character, Traits> view = value;
    return replace(position, removed, view.data(), view.size());
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &replace(size_type position, size_type removed,
                                  const T &value, size_type source_position,
                                  size_type count = npos) {
    basic_string_view<Character, Traits> view = value;
    view = view.substr(source_position, count);
    return replace(position, removed, view.data(), view.size());
  }
  constexpr basic_string &replace(size_type position, size_type removed,
                                  const Character *characters,
                                  size_type inserted) {
    check_position(position);
    removed = minimum(removed, size_ - position);
    basic_string source(characters, inserted, allocator_);
    if (inserted > removed)
      ensure_additional(inserted - removed);
    Traits::move(data() + position + inserted, data() + position + removed,
                 size_ - position - removed);
    Traits::copy(data() + position, source.data(), inserted);
    set_size(size_ - removed + inserted);
    return *this;
  }
  constexpr basic_string &replace(size_type position, size_type removed,
                                  const Character *characters) {
    return replace(position, removed, characters, Traits::length(characters));
  }
  constexpr basic_string &replace(size_type position, size_type removed,
                                  size_type inserted, Character character) {
    check_position(position);
    removed = minimum(removed, size_ - position);
    if (inserted > removed)
      ensure_additional(inserted - removed);
    Traits::move(data() + position + inserted, data() + position + removed,
                 size_ - position - removed);
    Traits::assign(data() + position, inserted, character);
    set_size(size_ - removed + inserted);
    return *this;
  }
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  const basic_string &value) {
    return replace(iterator_position(first), static_cast<size_type>(last - first),
                   value);
  }
  template <class T>
    requires is_convertible_v<const T &, basic_string_view<Character, Traits>> &&
             (!is_convertible_v<const T &, const Character *>)
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  const T &value) {
    return replace(iterator_position(first), static_cast<size_type>(last - first),
                   value);
  }
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  const Character *characters, size_type count) {
    return replace(iterator_position(first), static_cast<size_type>(last - first),
                   characters, count);
  }
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  const Character *characters) {
    return replace(first, last, characters, Traits::length(characters));
  }
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  size_type count, Character character) {
    return replace(iterator_position(first), static_cast<size_type>(last - first),
                   count, character);
  }
  template <class InputIterator>
    requires input_iterator<InputIterator>
  constexpr basic_string &replace(const_iterator first, const_iterator last,
                                  InputIterator source_first,
                                  InputIterator source_last) {
    basic_string source(source_first, source_last, allocator_);
    return replace(first, last, source);
  }
  template <detail::string_compatible_range<Character> R>
  constexpr basic_string &replace_with_range(const_iterator first,
