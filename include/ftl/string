  [[nodiscard]] static constexpr size_type minimum(size_type left,
                                                    size_type right) noexcept {
    return left < right ? left : right;
  }
  [[nodiscard]] constexpr basic_string_view<Character, Traits> view() const
      noexcept { return {data(), size_}; }
  [[nodiscard]] constexpr basic_string_view<Character, Traits>
  substr_view(size_type position, size_type count) const {
    return view().substr(position, count);
  }
  constexpr void check_position(size_type position) const {
    if (position > size_)
      detail::string_position_failure();
  }
  [[nodiscard]] constexpr size_type iterator_position(const_iterator value) const
      noexcept { return static_cast<size_type>(value - begin()); }
  constexpr void set_size(size_type value) noexcept {
    size_ = value;
    data()[size_] = Character{};
  }
  constexpr void initialize(const Character *characters, size_type count) {
    if (count == 0)
      return;
    reserve_exact(count);
    Traits::copy(data(), characters, count);
    set_size(count);
  }
  constexpr void initialize_substring(const basic_string &value,
                                      size_type position, size_type count) {
    value.check_position(position);
    count = minimum(count, value.size_ - position);
    initialize(value.data() + position, count);
  }
  constexpr void assign_fill(size_type count, Character character) {
    if (count == 0)
      return;
    reserve_exact(count);
    Traits::assign(data(), count, character);
    set_size(count);
  }
  constexpr void ensure_additional(size_type count) {
    if (count > max_size() - size_)
      detail::string_length_failure();
    if (size_ + count > capacity_) {
      size_type grown = capacity_ == 0 ? count : capacity_ + capacity_ / 2;
      if (grown < size_ + count)
        grown = size_ + count;
      if (grown > max_size())
        grown = max_size();
      reserve_exact(grown);
    }
  }
  constexpr void reserve_exact(size_type requested) {
    if (requested > max_size())
      detail::string_length_failure();
    if (requested <= capacity_)
      return;
    pointer replacement = allocator_traits<Allocator>::allocate(
        allocator_, requested + 1);
    Character *raw = FTL_STRING_NAMESPACE::to_address(replacement);
    const size_type old_size = size_;
    Traits::copy(raw, data(), old_size);
    raw[old_size] = Character{};
    deallocate();
    allocation_ = replacement;
    size_ = old_size;
    capacity_ = requested;
    allocated_ = true;
  }
  constexpr void deallocate() noexcept {
    if (allocated_)
      allocator_traits<Allocator>::deallocate(allocator_, allocation_,
                                               capacity_ + 1);
    release_without_deallocation();
  }
  constexpr void release_without_deallocation() noexcept {
    allocation_ = pointer{};
    size_ = 0;
    capacity_ = small_capacity;
    allocated_ = false;
    small_[0] = Character{};
  }
  constexpr void steal(basic_string &other) noexcept {
    size_ = other.size_;
    if (other.allocated_) {
      allocation_ = other.allocation_;
      capacity_ = other.capacity_;
      allocated_ = true;
      other.release_without_deallocation();
    } else {
      Traits::copy(small_, other.small_, other.size_ + 1);
      capacity_ = small_capacity;
      allocated_ = false;
      other.clear();
    }
  }
  constexpr void swap_storage(basic_string &other) noexcept {
    if (allocated_ && other.allocated_) {
      FTL_STRING_NAMESPACE::swap(allocation_, other.allocation_);
      FTL_STRING_NAMESPACE::swap(size_, other.size_);
      FTL_STRING_NAMESPACE::swap(capacity_, other.capacity_);
      return;
    }
    if (!allocated_ && !other.allocated_) {
      const size_type extent = size_ > other.size_ ? size_ : other.size_;
      for (size_type index = 0; index <= extent; ++index)
        FTL_STRING_NAMESPACE::swap(small_[index], other.small_[index]);
      FTL_STRING_NAMESPACE::swap(size_, other.size_);
      return;
    }
    if (!allocated_) {
      other.swap_storage(*this);
      return;
    }
    Character saved[small_capacity + 1]{};
    const size_type saved_size = other.size_;
    Traits::copy(saved, other.small_, saved_size + 1);
    other.allocation_ = allocation_;
    other.size_ = size_;
    other.capacity_ = capacity_;
    other.allocated_ = true;
    allocation_ = pointer{};
    size_ = saved_size;
    capacity_ = small_capacity;
    allocated_ = false;
    Traits::copy(small_, saved, saved_size + 1);
  }

  static constexpr size_type small_capacity =
      23 / sizeof(Character) > 0 ? 23 / sizeof(Character) : 1;
  pointer allocation_{};
  size_type size_{};
  size_type capacity_{small_capacity};
  bool allocated_{};
  FTL_NO_UNIQUE_ADDRESS Allocator allocator_{};
  Character small_[small_capacity + 1]{};
};

