template <class Result, class String, class Function>
Result string_to_integer(const String &value, typename String::size_type *index,
                         int base, Function function, const char *name) {
  using character = typename String::value_type;
  character *end = nullptr;
  errno = 0;
  const auto converted = function(value.c_str(), &end, base);
  if (end == value.c_str()) {
#if FTL_HAS_EXCEPTIONS
    throw invalid_argument(name);
#else
    FTL_STRING_TRAP();
#endif
  }
  if (errno == ERANGE || converted < numeric_limits<Result>::min() ||
      converted > numeric_limits<Result>::max()) {
#if FTL_HAS_EXCEPTIONS
    throw out_of_range(name);
#else
    FTL_STRING_TRAP();
#endif
  }
  if (index)
    *index = static_cast<typename String::size_type>(end - value.c_str());
  return static_cast<Result>(converted);
}

template <class Result, class String, class Function>
Result string_to_floating(const String &value,
                          typename String::size_type *index, Function function,
                          const char *name) {
  using character = typename String::value_type;
  character *end = nullptr;
  errno = 0;
  const Result converted = function(value.c_str(), &end);
  if (end == value.c_str()) {
#if FTL_HAS_EXCEPTIONS
    throw invalid_argument(name);
#else
    FTL_STRING_TRAP();
#endif
  }
  if (errno == ERANGE) {
#if FTL_HAS_EXCEPTIONS
    throw out_of_range(name);
#else
    FTL_STRING_TRAP();
#endif
  }
  if (index)
    *index = static_cast<typename String::size_type>(end - value.c_str());
  return converted;
}

template <class Number>
string number_to_string(Number value) {
  constexpr size_t capacity = is_integral_v<Number>
                                  ? numeric_limits<Number>::digits + 3
                                  : numeric_limits<Number>::max_exponent10 +
                                        numeric_limits<Number>::max_digits10 + 16;
  string result(capacity, '\0');
  to_chars_result converted;
  if constexpr (is_integral_v<Number>)
    converted = to_chars(result.data(), result.data() + result.size(), value);
  else
    converted = to_chars(result.data(), result.data() + result.size(), value,
                         chars_format::fixed, 6);
  if (converted.ec != errc{})
    string_length_failure();
  result.resize(static_cast<size_t>(converted.ptr - result.data()));
  return result;
}

template <class Number>
wstring number_to_wstring(Number value) {
  const string narrow = number_to_string(value);
  wstring wide;
  wide.reserve(narrow.size());
  for (char character : narrow)
    wide.push_back(static_cast<wchar_t>(character));
  return wide;
}

