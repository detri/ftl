#ifndef FTL_CSTDARG_HEADER
#define FTL_CSTDARG_HEADER

#if defined(_MSC_VER) && !defined(__clang__)
extern "C" void __cdecl __va_start(char**, ...);
#ifdef FTL_REPLACE_STL
namespace std { using va_list = char*; }
#else
namespace ftl { using va_list = char*; }
#endif
#define va_start(V, P) ((void)__va_start(&(V), P))
#define va_arg(V, P) (*(P*)(((V) += (sizeof(P) + 7) & ~7) - ((sizeof(P) + 7) & ~7)))
#define va_copy(D, S) ((void)((D) = (S)))
#define va_end(V) ((void)((V) = nullptr))
#else
#ifdef FTL_REPLACE_STL
namespace std { using va_list = __builtin_va_list; }
#else
namespace ftl { using va_list = __builtin_va_list; }
#endif
#define va_start(V, P) __builtin_va_start(V, P)
#define va_arg(V, P) __builtin_va_arg(V, P)
#define va_copy(D, S) __builtin_va_copy(D, S)
#define va_end(V) __builtin_va_end(V)
#endif

#endif
