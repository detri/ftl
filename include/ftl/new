FTL_NEW_BEGIN_NAMESPACE

enum class align_val_t : size_t {};

struct nothrow_t {
    explicit nothrow_t() = default;
};

inline constexpr nothrow_t nothrow{};

struct destroying_delete_t {
    explicit destroying_delete_t() = default;
};

inline constexpr destroying_delete_t destroying_delete{};

using new_handler = void(*)();

#ifdef FTL_REPLACE_STL
new_handler get_new_handler() noexcept;
new_handler set_new_handler(new_handler) noexcept;
#else
inline new_handler get_new_handler() noexcept { return ::std::get_new_handler(); }
inline new_handler set_new_handler(new_handler handler) noexcept {
    return ::std::set_new_handler(handler);
}
#endif

inline constexpr size_t hardware_destructive_interference_size = 64;
inline constexpr size_t hardware_constructive_interference_size = 64;

#ifndef __cpp_lib_hardware_interference_size
#define __cpp_lib_hardware_interference_size 201703L
#endif
#ifndef __cpp_lib_launder
#define __cpp_lib_launder 201606L
#endif

class bad_alloc : public exception {
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad allocation";
    }
};

class bad_array_new_length : public bad_alloc {
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad array new length";
    }
};

template<class T> requires FTL_NEW_NAMESPACE::is_object_v<T>
[[nodiscard]] constexpr T* launder(T* pointer) noexcept {
#if defined(_MSC_VER)
    return pointer;
#elif __has_builtin(__builtin_launder)
    return __builtin_launder(pointer);
#else
    return pointer;
#endif
}

FTL_NEW_END_NAMESPACE

