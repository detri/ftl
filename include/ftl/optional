struct nullopt_t {
    struct tag {};
    explicit constexpr nullopt_t(tag) noexcept {}
};
inline constexpr nullopt_t nullopt{nullopt_t::tag{}};

class bad_optional_access : public exception {
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad optional access";
    }
};

namespace detail {
struct optional_invoke_tag {};

[[noreturn]] inline void throw_bad_optional_access() {
#if FTL_HAS_EXCEPTIONS
    throw bad_optional_access{};
#else
    terminate();
#endif
}
}

template<class T>
class optional;

namespace detail {
template<class T>
void optional_base_probe(const optional<T>*);

template<class T>
inline constexpr bool is_derived_from_optional_v = requires {
    optional_base_probe(static_cast<const remove_cvref_t<T>*>(nullptr));
};

template<class>
struct is_optional : false_type {};

template<class T>
struct is_optional<optional<T>> : true_type {};

template<class T>
inline constexpr bool is_optional_v =
    is_optional<remove_cvref_t<T>>::value;

template<class T, class U>
inline constexpr bool converts_from_optional_v =
    is_constructible_v<T, optional<U>&> ||
    is_constructible_v<T, const optional<U>&> ||
    is_constructible_v<T, optional<U>&&> ||
    is_constructible_v<T, const optional<U>&&> ||
    is_convertible_v<optional<U>&, T> ||
    is_convertible_v<const optional<U>&, T> ||
    is_convertible_v<optional<U>&&, T> ||
    is_convertible_v<const optional<U>&&, T>;

template<class T, class U>
inline constexpr bool assigns_from_optional_v =
    is_assignable_v<T&, optional<U>&> ||
    is_assignable_v<T&, const optional<U>&> ||
    is_assignable_v<T&, optional<U>&&> ||
    is_assignable_v<T&, const optional<U>&&>;

template<class T>
constexpr T* optional_addressof(T& value) noexcept {
#if defined(_MSC_VER) || __has_builtin(__builtin_addressof)
    return __builtin_addressof(value);
#else
    return &value;
#endif
}

template<class T>
constexpr void optional_swap(T& left, T& right)
    noexcept(noexcept(swap(left, right))) {
    swap(left, right);
}
}

template<class T>
class optional {
    static_assert(!is_reference_v<T>);
    static_assert(!is_void_v<T>);
    static_assert(!is_same_v<remove_cv_t<T>, nullopt_t>);
    static_assert(!is_same_v<remove_cv_t<T>, in_place_t>);

public:
    using value_type = T;

private:
    template<class> friend class optional;

    template<class F, class Arg>
    constexpr explicit optional(detail::optional_invoke_tag, F&& function,
                                Arg&& argument)
        : stored(invoke(forward<F>(function), forward<Arg>(argument))),
          engaged{true} {}

public:

    constexpr optional() noexcept : empty{} {}
    constexpr optional(nullopt_t) noexcept : empty{} {}

    constexpr optional(const optional&)
        requires is_trivially_constructible_v<T, const T&> = default;

    constexpr optional(const optional& other)
        requires (is_copy_constructible_v<T> &&
                  !is_trivially_constructible_v<T, const T&>)
        : engaged{other.engaged} {
        if (engaged)
            construct_at(detail::optional_addressof(stored), other.stored);
    }

    constexpr optional(optional&&)
        requires is_trivially_constructible_v<T, T&&> = default;

    constexpr optional(optional&& other)
        noexcept(is_nothrow_move_constructible_v<T>)
        requires (is_move_constructible_v<T> &&
                  !is_trivially_constructible_v<T, T&&>)
        : engaged{other.engaged} {
        if (engaged)
            construct_at(
                detail::optional_addressof(stored), move(other.stored));
    }

    template<class... Args>
    constexpr explicit optional(in_place_t, Args&&... args)
        noexcept(is_nothrow_constructible_v<T, Args...>)
        requires is_constructible_v<T, Args...>
        : stored(forward<Args>(args)...), engaged{true} {}

    template<class U, class... Args>
    constexpr explicit optional(
        in_place_t, initializer_list<U> values, Args&&... args)
        noexcept(is_nothrow_constructible_v<T, initializer_list<U>&, Args...>)
        requires is_constructible_v<T, initializer_list<U>&, Args...>
        : stored(values, forward<Args>(args)...), engaged{true} {}

    template<class U = T>
    constexpr explicit(!is_convertible_v<U, T>) optional(U&& input)
        noexcept(is_nothrow_constructible_v<T, U>)
        requires (!detail::is_optional_v<remove_cvref_t<U>> &&
                  !is_same_v<remove_cvref_t<U>, in_place_t> &&
                  !is_same_v<remove_cvref_t<U>, nullopt_t> &&
                  is_constructible_v<T, U>)
        : stored(forward<U>(input)), engaged{true} {}

    template<class U>
    constexpr explicit(!is_convertible_v<const U&, T>)
    optional(const optional<U>& other)
        requires (is_constructible_v<T, const U&> &&
                  (is_same_v<remove_cv_t<T>, bool> ||
                   !detail::converts_from_optional_v<T, U>))
        : engaged{other.has_value()} {
        if (engaged)
            construct_at(detail::optional_addressof(stored), *other);
    }

    template<class U>
    constexpr explicit(!is_convertible_v<U, T>) optional(optional<U>&& other)
        noexcept(is_nothrow_constructible_v<T, U>)
        requires (is_constructible_v<T, U> &&
                  (is_same_v<remove_cv_t<T>, bool> ||
                   !detail::converts_from_optional_v<T, U>))
        : engaged{other.has_value()} {
        if (engaged)
            construct_at(detail::optional_addressof(stored), move(*other));
    }

    constexpr ~optional()
        requires is_trivially_destructible_v<T> = default;
    constexpr ~optional()
        requires (!is_trivially_destructible_v<T>) { reset(); }

    constexpr optional& operator=(nullopt_t) noexcept {
        reset();
        return *this;
    }

    constexpr optional& operator=(const optional&)
        requires (is_trivially_constructible_v<T, const T&> &&
                  is_trivially_assignable_v<T&, const T&> &&
                  is_trivially_destructible_v<T>) = default;

    constexpr optional& operator=(const optional& other)
        requires (is_copy_constructible_v<T> && is_copy_assignable_v<T> &&
                  !(is_trivially_constructible_v<T, const T&> &&
                    is_trivially_assignable_v<T&, const T&> &&
                    is_trivially_destructible_v<T>)) {
        assign(other);
        return *this;
    }

    constexpr optional& operator=(optional&&)
        requires (is_trivially_constructible_v<T, T&&> &&
                  is_trivially_assignable_v<T&, T&&> &&
                  is_trivially_destructible_v<T>) = default;

    constexpr optional& operator=(optional&& other)
        noexcept(is_nothrow_move_constructible_v<T> &&
                 is_nothrow_move_assignable_v<T>)
        requires (is_move_constructible_v<T> && is_move_assignable_v<T> &&
                  !(is_trivially_constructible_v<T, T&&> &&
                    is_trivially_assignable_v<T&, T&&> &&
                    is_trivially_destructible_v<T>)) {
        assign(move(other));
        return *this;
    }

    template<class U = T>
    constexpr optional& operator=(U&& input)
        requires (!detail::is_optional_v<remove_cvref_t<U>> &&
                  (!is_scalar_v<T> ||
                   !is_same_v<decay_t<U>, T>) &&
                  is_constructible_v<T, U> && is_assignable_v<T&, U>) {
        if (engaged)
            stored = forward<U>(input);
        else
            emplace(forward<U>(input));
        return *this;
    }

    template<class U>
    constexpr optional& operator=(const optional<U>& other)
        requires (is_constructible_v<T, const U&> &&
                  is_assignable_v<T&, const U&> &&
                  !detail::converts_from_optional_v<T, U> &&
                  !detail::assigns_from_optional_v<T, U>) {
        if (other) {
            if (engaged) stored = *other;
            else emplace(*other);
        } else reset();
        return *this;
    }

    template<class U>
    constexpr optional& operator=(optional<U>&& other)
        noexcept(is_nothrow_constructible_v<T, U> &&
                 is_nothrow_assignable_v<T&, U>)
        requires (is_constructible_v<T, U> && is_assignable_v<T&, U> &&
                  !detail::converts_from_optional_v<T, U> &&
                  !detail::assigns_from_optional_v<T, U>) {
        if (other) {
            if (engaged) stored = move(*other);
            else emplace(move(*other));
        } else reset();
        return *this;
    }

    constexpr const T* operator->() const noexcept {
        return detail::optional_addressof(stored);
    }
    constexpr T* operator->() noexcept {
        return detail::optional_addressof(stored);
    }
    constexpr const T& operator*() const& noexcept { return stored; }
    constexpr T& operator*() & noexcept { return stored; }
    constexpr const T&& operator*() const&& noexcept { return move(stored); }
    constexpr T&& operator*() && noexcept { return move(stored); }
    constexpr explicit operator bool() const noexcept { return engaged; }
    constexpr bool has_value() const noexcept { return engaged; }

    constexpr const T& value_or_throw() const& {
        if (!engaged) detail::throw_bad_optional_access();
        return stored;
    }
    constexpr T& value_or_throw() & {
        if (!engaged) detail::throw_bad_optional_access();
        return stored;
    }
    constexpr const T&& value_or_throw() const&& {
        if (!engaged) detail::throw_bad_optional_access();
        return move(stored);
    }
    constexpr T&& value_or_throw() && {
        if (!engaged) detail::throw_bad_optional_access();
        return move(stored);
    }

    constexpr const T& value() const& { return value_or_throw(); }
    constexpr T& value() & { return value_or_throw(); }
    constexpr const T&& value() const&& { return move(*this).value_or_throw(); }
    constexpr T&& value() && { return move(*this).value_or_throw(); }

    template<class U>
    constexpr T value_or(U&& fallback) const& {
        return engaged ? stored : static_cast<T>(forward<U>(fallback));
    }
    template<class U>
    constexpr T value_or(U&& fallback) && {
        return engaged ? move(stored) : static_cast<T>(forward<U>(fallback));
    }

    template<class... Args>
    constexpr T& emplace(Args&&... args)
        requires is_constructible_v<T, Args...> {
        reset();
        construct_at(
            detail::optional_addressof(stored), forward<Args>(args)...);
        engaged = true;
        return stored;
    }

    template<class U, class... Args>
    constexpr T& emplace(initializer_list<U> values, Args&&... args)
        noexcept(is_nothrow_constructible_v<T, initializer_list<U>&, Args...>)
        requires is_constructible_v<T, initializer_list<U>&, Args...> {
        reset();
        construct_at(detail::optional_addressof(stored),
                     values, forward<Args>(args)...);
        engaged = true;
        return stored;
    }

    constexpr void reset() noexcept {
        if (engaged) {
            destroy_at(detail::optional_addressof(stored));
            engaged = false;
        }
    }

    constexpr void swap(optional& other)
        noexcept(is_nothrow_move_constructible_v<T> &&
                 noexcept(detail::optional_swap(
                     declval<T&>(), declval<T&>())))
        requires (is_move_constructible_v<T> &&
                  requires(T& left, T& right) {
                      detail::optional_swap(left, right);
                  }) {
        if (engaged && other.engaged)
            detail::optional_swap(stored, other.stored);
        else if (engaged) {
            other.emplace(move(stored));
            reset();
        } else if (other.engaged) {
            emplace(move(other.stored));
            other.reset();
        }
    }

    template<class F>
    constexpr auto and_then(F&& function) & {
        using result = remove_cvref_t<invoke_result_t<F, T&>>;
        static_assert(detail::is_optional_v<result>);
        return engaged ? invoke(forward<F>(function), stored) : result{};
    }
    template<class F>
    constexpr auto and_then(F&& function) const& {
        using result = remove_cvref_t<invoke_result_t<F, const T&>>;
        static_assert(detail::is_optional_v<result>);
        return engaged ? invoke(forward<F>(function), stored) : result{};
    }
    template<class F>
    constexpr auto and_then(F&& function) && {
        using result = remove_cvref_t<invoke_result_t<F, T&&>>;
        static_assert(detail::is_optional_v<result>);
        return engaged
            ? invoke(forward<F>(function), move(stored)) : result{};
    }
    template<class F>
    constexpr auto and_then(F&& function) const&& {
        using result = remove_cvref_t<invoke_result_t<F, const T&&>>;
        static_assert(detail::is_optional_v<result>);
        return engaged
            ? invoke(forward<F>(function), move(stored)) : result{};
    }

    template<class F>
    constexpr auto transform(F&& function) & {
        using result = remove_cv_t<invoke_result_t<F, T&>>;
        return engaged
            ? optional<result>{detail::optional_invoke_tag{},
                               forward<F>(function), stored}
            : optional<result>{};
    }
    template<class F>
    constexpr auto transform(F&& function) const& {
        using result = remove_cv_t<invoke_result_t<F, const T&>>;
        return engaged
            ? optional<result>{detail::optional_invoke_tag{},
                               forward<F>(function), stored}
            : optional<result>{};
    }
    template<class F>
    constexpr auto transform(F&& function) && {
        using result = remove_cv_t<invoke_result_t<F, T&&>>;
        return engaged
            ? optional<result>{detail::optional_invoke_tag{},
                               forward<F>(function), move(stored)}
            : optional<result>{};
    }
    template<class F>
    constexpr auto transform(F&& function) const&& {
        using result = remove_cv_t<invoke_result_t<F, const T&&>>;
        return engaged
            ? optional<result>{detail::optional_invoke_tag{},
                               forward<F>(function), move(stored)}
            : optional<result>{};
    }

    template<class F>
        requires (invocable<F> && copy_constructible<T>)
    constexpr optional or_else(F&& function) const& {
        return engaged ? *this : invoke(forward<F>(function));
    }
    template<class F>
        requires (invocable<F> && move_constructible<T>)
    constexpr optional or_else(F&& function) && {
        return engaged ? move(*this) : invoke(forward<F>(function));
    }

private:
    template<class Other>
    constexpr void assign(Other&& other) {
        if (engaged && other.engaged)
            stored = forward<Other>(other).stored;
        else if (other.engaged)
            emplace(forward<Other>(other).stored);
        else
            reset();
    }

    union {
        unsigned char empty;
        T stored;
    };
    bool engaged{false};
};

template<class T>
class optional<T&> {
public:
    using value_type = T;

    constexpr optional() noexcept = default;
    constexpr optional(nullopt_t) noexcept {}
    constexpr optional(T& value) noexcept
        : pointer{detail::optional_addressof(value)} {}
    template<class U>
    constexpr explicit(!is_convertible_v<U*, T*>) optional(U& value) noexcept
        requires is_convertible_v<U*, T*>
        : pointer{detail::optional_addressof(value)} {}

    constexpr optional& operator=(nullopt_t) noexcept {
        pointer = nullptr;
        return *this;
    }
    constexpr optional& operator=(T& value) noexcept {
        pointer = detail::optional_addressof(value);
        return *this;
    }

    constexpr T* operator->() const noexcept { return pointer; }
    constexpr T& operator*() const noexcept { return *pointer; }
    constexpr explicit operator bool() const noexcept { return pointer; }
    constexpr bool has_value() const noexcept { return pointer; }
    constexpr T& value() const {
        if (!pointer) detail::throw_bad_optional_access();
        return *pointer;
    }
    template<class U>
    constexpr remove_cv_t<T> value_or(U&& fallback) const {
        return pointer ? *pointer
                       : static_cast<remove_cv_t<T>>(forward<U>(fallback));
    }
    constexpr void reset() noexcept { pointer = nullptr; }
    constexpr void emplace(T& value) noexcept {
        pointer = detail::optional_addressof(value);
    }
    constexpr void swap(optional& other) noexcept {
        T* temporary = pointer;
        pointer = other.pointer;
        other.pointer = temporary;
    }

    template<class F>
    constexpr auto and_then(F&& function) const {
        using result = remove_cvref_t<invoke_result_t<F, T&>>;
        static_assert(detail::is_optional_v<result>);
        return pointer ? invoke(forward<F>(function), *pointer) : result{};
    }
    template<class F>
    constexpr auto transform(F&& function) const {
        using result = remove_cv_t<invoke_result_t<F, T&>>;
        return pointer
            ? optional<result>{in_place,
                invoke(forward<F>(function), *pointer)}
            : optional<result>{};
    }
    template<class F>
    constexpr optional or_else(F&& function) const {
        return pointer ? *this : invoke(forward<F>(function));
    }

private:
    T* pointer{};
};

template<class T>
optional(T) -> optional<T>;

template<class T, class U>
constexpr bool operator==(const optional<T>& left,
                          const optional<U>& right) {
    return left.has_value() == right.has_value() &&
           (!left || *left == *right);
}

template<class T, class U>
    requires requires(const T& left, const U& right) { left != right; }
constexpr bool operator!=(const optional<T>& left, const optional<U>& right) {
    return left.has_value() != right.has_value() || (left && *left != *right);
}

template<class T, class U>
    requires requires(const T& left, const U& right) { left < right; }
constexpr bool operator<(const optional<T>& left, const optional<U>& right) {
    return right && (!left || *left < *right);
}

template<class T, class U>
    requires requires(const T& left, const U& right) { left > right; }
constexpr bool operator>(const optional<T>& left, const optional<U>& right) {
    return left && (!right || *left > *right);
}

template<class T, class U>
    requires requires(const T& left, const U& right) { left <= right; }
constexpr bool operator<=(const optional<T>& left, const optional<U>& right) {
    return !left || (right && *left <= *right);
}

template<class T, class U>
    requires requires(const T& left, const U& right) { left >= right; }
constexpr bool operator>=(const optional<T>& left, const optional<U>& right) {
    return !right || (left && *left >= *right);
}
template<class T>
constexpr bool operator==(const optional<T>& value, nullopt_t) noexcept {
    return !value;
}
template<class T>
constexpr bool operator==(nullopt_t, const optional<T>& value) noexcept {
    return !value;
}
template<class T, class U>
    requires (!detail::is_optional_v<U>)
constexpr bool operator==(const optional<T>& left, const U& right)
{
    return left && *left == right;
}


template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const T& left, const U& right) { left != right; })
constexpr bool operator!=(const optional<T>& left, const U& right) {
    return !left || *left != right;
}

template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const U& left, const T& right) { left != right; })
constexpr bool operator!=(const U& left, const optional<T>& right) {
    return !right || left != *right;
}

template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const T& left, const U& right) { left < right; })
constexpr bool operator<(const optional<T>& left, const U& right) {
    return !left || *left < right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const U& left, const T& right) { left < right; })
constexpr bool operator<(const U& left, const optional<T>& right) {
    return right && left < *right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const T& left, const U& right) { left > right; })
constexpr bool operator>(const optional<T>& left, const U& right) {
    return left && *left > right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const U& left, const T& right) { left > right; })
constexpr bool operator>(const U& left, const optional<T>& right) {
    return !right || left > *right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const T& left, const U& right) { left <= right; })
constexpr bool operator<=(const optional<T>& left, const U& right) {
    return !left || *left <= right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const U& left, const T& right) { left <= right; })
constexpr bool operator<=(const U& left, const optional<T>& right) {
    return right && left <= *right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const T& left, const U& right) { left >= right; })
constexpr bool operator>=(const optional<T>& left, const U& right) {
    return left && *left >= right;
}
template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              requires(const U& left, const T& right) { left >= right; })
constexpr bool operator>=(const U& left, const optional<T>& right) {
    return !right || left >= *right;
}

template<class T, class U>
    requires three_way_comparable_with<T, U>
constexpr common_comparison_category_t<compare_three_way_result_t<T, U>,
                                       strong_ordering>
operator<=>(const optional<T>& left, const optional<U>& right) {
    if (left && right)
        return compare_three_way{}(*left, *right);
    return left ? strong_ordering::greater
                : right ? strong_ordering::less
                        : strong_ordering::equal;
}
template<class T>
constexpr strong_ordering
operator<=>(const optional<T>& value, nullopt_t) noexcept {
    return value ? strong_ordering::greater : strong_ordering::equal;
}

template<class T, class U>
    requires (!detail::is_derived_from_optional_v<U> &&
              three_way_comparable_with<T, U>)
constexpr compare_three_way_result_t<T, U>
operator<=>(const optional<T>& left, const U& right) {
    if (left) {
        return compare_three_way{}(*left, right);
    }

    return strong_ordering::less;
}

template<class T>
constexpr void swap(optional<T>& left, optional<T>& right)
    noexcept(noexcept(left.swap(right)))
    requires requires { left.swap(right); } {
    left.swap(right);
}

template<class T>
constexpr optional<decay_t<T>> make_optional(T&& value) {
    return optional<decay_t<T>>{forward<T>(value)};
}
template<class T, class... Args>
constexpr optional<T> make_optional(Args&&... args) {
    return optional<T>{in_place, forward<Args>(args)...};
}
template<class T, class U, class... Args>
constexpr optional<T>
make_optional(initializer_list<U> values, Args&&... args) {
    return optional<T>{in_place, values, forward<Args>(args)...};
}

template<class T>
    requires requires(const remove_cv_t<remove_reference_t<T>>& item) {
        hash<remove_cv_t<remove_reference_t<T>>>{}(item);
    }
struct hash<optional<T>> {
    size_t operator()(const optional<T>& value) const
        noexcept(noexcept(
            hash<remove_cv_t<remove_reference_t<T>>>{}(*value))) {
        using hashed_type = remove_cv_t<remove_reference_t<T>>;
