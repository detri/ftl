template <class State> class fpos;
class ios_base;

class strong_ordering;

template <class Character> struct char_traits {
  using comparison_category = strong_ordering;
  using char_type = Character;
  using int_type = conditional_t<is_same_v<char_type, char>, int,
                   conditional_t<is_same_v<char_type, wchar_t>, wint_t,
                   conditional_t<is_same_v<char_type, char8_t>, unsigned int,
                   conditional_t<is_same_v<char_type, char16_t>, uint_least16_t,
                                 uint_least32_t>>>>;
  using off_type = streamoff;
  using state_type = mbstate_t;
  using pos_type = fpos<state_type>;

  static constexpr void assign(char_type &left,
                               const char_type &right) noexcept {
    left = right;
  }

  [[nodiscard]]
  static constexpr bool eq(char_type left, char_type right) noexcept {
    return left == right;
  }

  [[nodiscard]]
  static constexpr bool lt(char_type left, char_type right) noexcept {
    if constexpr (is_same_v<char_type, char>) {
      return static_cast<unsigned char>(left) <
             static_cast<unsigned char>(right);
    } else {
      return left < right;
    }
  }

  [[nodiscard]]
  static constexpr int compare(const char_type *left, const char_type *right,
                               size_t count) {
    for (size_t index = 0; index < count; ++index) {
      if (lt(left[index], right[index]))
        return -1;

      if (lt(right[index], left[index]))
        return 1;
    }

    return 0;
  }

  [[nodiscard]]
  static constexpr size_t length(const char_type *string) {
    size_t result = 0;

    while (!eq(string[result], char_type{}))
      ++result;

    return result;
  }

  [[nodiscard]]
  static constexpr const char_type *find(const char_type *string, size_t count,
                                         const char_type &value) {
    for (size_t index = 0; index < count; ++index) {
      if (eq(string[index], value))
        return string + index;
    }

    return nullptr;
  }

  static constexpr char_type *move(char_type *destination,
                                   const char_type *source, size_t count) {
    if (destination < source) {
      for (size_t index = 0; index < count; ++index)
        destination[index] = source[index];
    } else {
      for (size_t index = count; index != 0; --index)
        destination[index - 1] = source[index - 1];
    }

    return destination;
  }

  static constexpr char_type *copy(char_type *destination,
                                   const char_type *source, size_t count) {
    for (size_t index = 0; index < count; ++index)
      destination[index] = source[index];

    return destination;
  }

  static constexpr char_type *assign(char_type *destination, size_t count,
                                     char_type value) {
    for (size_t index = 0; index < count; ++index)
      destination[index] = value;

    return destination;
  }

  [[nodiscard]]
  static constexpr int_type to_int_type(char_type value) noexcept {
    if constexpr (is_same_v<char_type, char>)
      return static_cast<unsigned char>(value);
    else
      return static_cast<int_type>(value);
  }

  [[nodiscard]]
  static constexpr char_type to_char_type(int_type value) noexcept {
    return static_cast<char_type>(value);
  }

  [[nodiscard]]
  static constexpr bool eq_int_type(int_type left, int_type right) noexcept {
    return left == right;
  }

  [[nodiscard]]
  static constexpr int_type eof() noexcept {
    return static_cast<int_type>(-1);
  }

  [[nodiscard]]
  static constexpr int_type not_eof(int_type value) noexcept {
    return eq_int_type(value, eof()) ? int_type{} : value;
  }
};

