class format_error : public runtime_error {
public:
  explicit format_error(const string &what_arg)
      : runtime_error(what_arg.c_str()) {}

  explicit format_error(const char *what_arg) : runtime_error(what_arg) {}
};

namespace detail {

[[noreturn]]
inline void throw_format_error(const char *message) {
#if FTL_HAS_EXCEPTIONS
  throw format_error(message);
#else
  terminate();
#endif
}

} // namespace detail

template <class charT> class basic_format_parse_context {
public:
  using char_type = charT;
  using const_iterator = typename basic_string_view<charT>::const_iterator;
  using iterator = const_iterator;

  constexpr explicit basic_format_parse_context(basic_string_view<charT> fmt,
                                                size_t num_args = 0) noexcept
      : begin_(fmt.begin()), end_(fmt.end()), indexing_(indexing::unknown),
        next_arg_id_(0), num_args_(num_args) {}

  basic_format_parse_context(const basic_format_parse_context &) = delete;

  basic_format_parse_context &
  operator=(const basic_format_parse_context &) = delete;

  [[nodiscard]]
  constexpr const_iterator begin() const noexcept {
    return begin_;
  }

  [[nodiscard]]
  constexpr const_iterator end() const noexcept {
    return end_;
  }

  constexpr void advance_to(const_iterator it) { begin_ = it; }

  constexpr size_t next_arg_id() {
    if (indexing_ == indexing::manual)
      detail::throw_format_error(
          "cannot mix automatic and manual argument indexing");

    if (indexing_ == indexing::unknown)
      indexing_ = indexing::automatic;

    const size_t result = next_arg_id_++;

    /*
     * N4950 specifies an out-of-range call as not being a core constant
     * expression. At runtime the parse context still tracks the index.
     */
    if (is_constant_evaluated() && result >= num_args_)
      detail::throw_format_error("format argument index out of range");

    return result;
  }

  constexpr void check_arg_id(size_t id) {
    if (indexing_ == indexing::automatic)
      detail::throw_format_error(
          "cannot mix automatic and manual argument indexing");

    if (indexing_ == indexing::unknown)
      indexing_ = indexing::manual;

    if (is_constant_evaluated() && id >= num_args_)
      detail::throw_format_error("format argument index out of range");
  }

private:
  enum class indexing { unknown, manual, automatic };

  iterator begin_;
  iterator end_;
  indexing indexing_;
  size_t next_arg_id_;
  size_t num_args_;
};

using format_parse_context = basic_format_parse_context<char>;
using wformat_parse_context = basic_format_parse_context<wchar_t>;

template <class T, class charT = char> struct formatter {
  formatter() = delete;
  formatter(const formatter &) = delete;
  formatter(formatter &&) = delete;

  formatter &operator=(const formatter &) = delete;
  formatter &operator=(formatter &&) = delete;
};

enum class range_format { disabled, map, set, sequence, string, debug_string };

namespace detail {

enum class format_alignment { none, left, right, center };

enum class format_sign { minus, plus, space };

template <class T>
inline constexpr bool is_numeric_format_integer_v =
    is_integral_v<T> && is_same_v<T, remove_cv_t<T>> && !is_same_v<T, bool> &&
    !is_same_v<T, char> && !is_same_v<T, wchar_t> && !is_same_v<T, char8_t> &&
    !is_same_v<T, char16_t> && !is_same_v<T, char32_t>;

template <class charT>
[[nodiscard]]
constexpr charT format_widen(char value) noexcept {
  return static_cast<charT>(value);
}

template <class charT>
[[nodiscard]]
constexpr bool format_is_digit(charT value) noexcept {
  return value >= format_widen<charT>('0') && value <= format_widen<charT>('9');
}

template <class charT>
[[nodiscard]]
constexpr bool format_is_align(charT value) noexcept {
  return value == format_widen<charT>('<') ||
         value == format_widen<charT>('>') || value == format_widen<charT>('^');
}

template <class Output, class charT>
constexpr void format_put(Output &out, charT value) {
  *out = value;
  ++out;
}

template <class Output, class charT>
constexpr void format_fill(Output &out, charT value, size_t count) {
  while (count != 0) {
    format_put(out, value);
    --count;
  }
}

template <class charT>
[[nodiscard]]
constexpr format_alignment
format_alignment_from_character(charT value) noexcept {
  if (value == format_widen<charT>('<'))
    return format_alignment::left;

  if (value == format_widen<charT>('>'))
    return format_alignment::right;

  return format_alignment::center;
}

template <class T, class charT> class numeric_integer_formatter {
public:
  constexpr numeric_integer_formatter() noexcept = default;

  constexpr typename basic_format_parse_context<charT>::iterator
  parse(basic_format_parse_context<charT> &context) {
    auto current = context.begin();
    const auto end = context.end();

    /*
     * fill-and-align
     */
    if (current != end) {
      auto next = current;
      ++next;

      if (next != end && format_is_align(*next)) {
        if (*current == format_widen<charT>('{') ||
            *current == format_widen<charT>('}')) {
          detail::throw_format_error("invalid format fill character");
        }

        fill_ = *current;
        alignment_ = format_alignment_from_character(*next);

        current = next;
        ++current;
      } else if (format_is_align(*current)) {
        alignment_ = format_alignment_from_character(*current);
        ++current;
      }
    }

    /*
     * sign
     */
    if (current != end) {
      if (*current == format_widen<charT>('+')) {
        sign_ = format_sign::plus;
        ++current;
      } else if (*current == format_widen<charT>('-')) {
        sign_ = format_sign::minus;
        ++current;
      } else if (*current == format_widen<charT>(' ')) {
        sign_ = format_sign::space;
        ++current;
      }
    }

    /*
     * alternate form
     */
    if (current != end && *current == format_widen<charT>('#')) {
      alternate_ = true;
      ++current;
    }

    /*
     * zero padding
     */
    if (current != end && *current == format_widen<charT>('0')) {
      zero_padding_ = true;
      ++current;
    }

    /*
     * width
     */
    if (current != end && format_is_digit(*current)) {
      if (*current == format_widen<charT>('0'))
        detail::throw_format_error("format width must be positive");

      size_t width = 0;

      while (current != end && format_is_digit(*current)) {
        const size_t digit =
            static_cast<size_t>(*current - format_widen<charT>('0'));

        if (width > (numeric_limits<size_t>::max() - digit) / size_t{10}) {
          detail::throw_format_error("format width is too large");
        }

        width = width * size_t{10} + digit;
        ++current;
      }

      width_ = width;
    } else if (current != end && *current == format_widen<charT>('{')) {
      ++current;

      dynamic_width_ = true;

      if (current == end)
        detail::throw_format_error("unterminated dynamic format width");

      if (*current == format_widen<charT>('}')) {
        width_arg_id_ = context.next_arg_id();
        ++current;
      } else {
        if (!format_is_digit(*current))
          detail::throw_format_error("invalid dynamic format width");

        size_t id = 0;

        while (current != end && format_is_digit(*current)) {
          const size_t digit =
              static_cast<size_t>(*current - format_widen<charT>('0'));

          if (id > (numeric_limits<size_t>::max() - digit) / size_t{10}) {
            detail::throw_format_error("format argument index is too large");
          }

          id = id * size_t{10} + digit;
          ++current;
        }

        if (current == end || *current != format_widen<charT>('}')) {
          detail::throw_format_error("unterminated dynamic format width");
        }

        context.check_arg_id(id);
        width_arg_id_ = id;

        ++current;
      }
    }

    /*
     * Precision is never valid for an integral presentation.
     */
    if (current != end && *current == format_widen<charT>('.'))
      detail::throw_format_error(
          "precision is not valid for integer formatting");

    /*
     * Locale-specific form is syntactically valid here. Its actual
     * grouping behavior lands with the locale/dynamic-width integration
     * slice.
     */
    if (current != end && *current == format_widen<charT>('L')) {
      localized_ = true;
      ++current;
    }

    /*
     * Numeric integer presentation type.
     *
     * The character presentation 'c' deliberately lands with the
     * char/bool formatter slice so its cross-character and range
     * semantics are implemented once rather than bolted on here.
     */
    if (current != end && *current != format_widen<charT>('}')) {
      const char type = static_cast<char>(*current);

      switch (type) {
      case 'b':
      case 'B':
      case 'd':
      case 'o':
      case 'x':
      case 'X':
        presentation_ = type;
        ++current;
        break;

      case 'c':
        detail::throw_format_error(
            "character integer presentation is not available yet");

      default:
        detail::throw_format_error("invalid integer format presentation type");
      }
    }

    if (current != end && *current != format_widen<charT>('}')) {
      detail::throw_format_error("invalid integer format specification");
    }

    return current;
  }

  template <class FormatContext>
  typename FormatContext::iterator format(T value,
                                          FormatContext &context) const {
    if (dynamic_width_)
      detail::throw_format_error("dynamic format width is not available yet");

    if (localized_)
      detail::throw_format_error(
          "localized integer formatting is not available yet");

    int base = 10;

    switch (presentation_) {
    case 'b':
    case 'B':
      base = 2;
      break;

    case 'o':
      base = 8;
      break;

    case 'x':
    case 'X':
      base = 16;
      break;

    default:
      base = 10;
      break;
    }

    using unsigned_type = make_unsigned_t<T>;

    /*
     * Full binary representation plus a possible sign.
     */
    char buffer[numeric_limits<unsigned_type>::digits + 2];

    const to_chars_result converted =
        to_chars(buffer, buffer + sizeof(buffer), value, base);

    if (converted.ec != errc{})
      detail::throw_format_error("integer formatting conversion failed");

    char *digits = buffer;
    size_t digits_size = static_cast<size_t>(converted.ptr - buffer);

    char sign_character = '\0';

    if (digits_size != 0 && *digits == '-') {
      sign_character = '-';
      ++digits;
      --digits_size;
    } else if (sign_ == format_sign::plus) {
      sign_character = '+';
    } else if (sign_ == format_sign::space) {
      sign_character = ' ';
    }

    if (presentation_ == 'X') {
      for (size_t index = 0; index < digits_size; ++index) {
        if (digits[index] >= 'a' && digits[index] <= 'f')
          digits[index] = static_cast<char>('A' + (digits[index] - 'a'));
      }
    }

    char prefix[2]{};
    size_t prefix_size = 0;

    if (alternate_) {
      switch (presentation_) {
      case 'b':
        prefix[0] = '0';
        prefix[1] = 'b';
        prefix_size = 2;
        break;

      case 'B':
        prefix[0] = '0';
        prefix[1] = 'B';
        prefix_size = 2;
        break;

      case 'o':
        if (value != T{}) {
          prefix[0] = '0';
          prefix_size = 1;
        }
        break;

      case 'x':
        prefix[0] = '0';
        prefix[1] = 'x';
        prefix_size = 2;
        break;

      case 'X':
        prefix[0] = '0';
        prefix[1] = 'X';
        prefix_size = 2;
        break;

      default:
        break;
      }
    }

    const size_t sign_size = sign_character == '\0' ? size_t{0} : size_t{1};

    const size_t content_size = sign_size + prefix_size + digits_size;

    const size_t padding =
        width_ > content_size ? width_ - content_size : size_t{0};

    auto output = context.out();

    /*
     * N4950: explicit alignment disables the special meaning of 0.
     */
    if (zero_padding_ && alignment_ == format_alignment::none && padding != 0) {
      if (sign_character != '\0')
        format_put(output, format_widen<charT>(sign_character));

      for (size_t index = 0; index < prefix_size; ++index)
        format_put(output, format_widen<charT>(prefix[index]));

      format_fill(output, format_widen<charT>('0'), padding);

      for (size_t index = 0; index < digits_size; ++index)
        format_put(output, format_widen<charT>(digits[index]));

      return output;
    }

    const format_alignment effective_alignment =
        alignment_ == format_alignment::none ? format_alignment::right
                                             : alignment_;

    size_t leading_padding = 0;
    size_t trailing_padding = 0;

    switch (effective_alignment) {
    case format_alignment::left:
      trailing_padding = padding;
      break;

    case format_alignment::right:
      leading_padding = padding;
      break;

    case format_alignment::center:
      leading_padding = padding / 2;
      trailing_padding = padding - leading_padding;
      break;

    case format_alignment::none:
      break;
    }

    format_fill(output, fill_, leading_padding);

    if (sign_character != '\0')
      format_put(output, format_widen<charT>(sign_character));

    for (size_t index = 0; index < prefix_size; ++index)
      format_put(output, format_widen<charT>(prefix[index]));

    for (size_t index = 0; index < digits_size; ++index)
      format_put(output, format_widen<charT>(digits[index]));

    format_fill(output, fill_, trailing_padding);

    return output;
  }

private:
  charT fill_ = format_widen<charT>(' ');

  format_alignment alignment_ = format_alignment::none;
  format_sign sign_ = format_sign::minus;

  bool alternate_ = false;
  bool zero_padding_ = false;
  bool localized_ = false;
  bool dynamic_width_ = false;

  size_t width_ = 0;
  size_t width_arg_id_ = 0;

  char presentation_ = '\0';
};

} // namespace detail

template <class T, class charT>
  requires detail::is_numeric_format_integer_v<T>
struct formatter<T, charT> : detail::numeric_integer_formatter<T, charT> {};

