  fields.has_day = true;

  fields.year = static_cast<int>(value.year());

  fields.month = static_cast<unsigned>(value.month());

  fields.day = static_cast<unsigned>(value.day());

  if (value.ok()) {
    fields.has_weekday = true;

    fields.weekday =
        chrono::weekday{static_cast<chrono::sys_days>(value)}.c_encoding();

    fields.complete_date = true;
