namespace detail {

template <class charT>
constexpr size_t format_parse_replacement_arg_id(
    typename basic_format_parse_context<charT>::iterator &current,
    typename basic_format_parse_context<charT>::iterator end,
    basic_format_parse_context<charT> &context) {
  if (current == end) {
    throw_format_error("unterminated replacement field");
  }

  if (*current == format_widen<charT>('}') ||
      *current == format_widen<charT>(':')) {
    return context.next_arg_id();
  }

  if (!format_is_digit(*current)) {
    throw_format_error("invalid replacement field argument id");
  }

  size_t id = 0;

  if (*current == format_widen<charT>('0')) {
    ++current;

    if (current != end && format_is_digit(*current)) {
      throw_format_error("format argument id has a leading zero");
    }

    context.check_arg_id(0);

    return 0;
  }

  while (current != end && format_is_digit(*current)) {
    const size_t digit =
        static_cast<size_t>(*current - format_widen<charT>('0'));

    if (id > (numeric_limits<size_t>::max() - digit) / size_t{10}) {
      throw_format_error("format argument index is too large");
    }

    id = id * size_t{10} + digit;

    ++current;
  }

  context.check_arg_id(id);

  return id;
}

template <class charT>
consteval void format_validate_argument(size_t,
                                        basic_format_parse_context<charT> &) {
  throw_format_error("format argument index out of range");
}

template <class charT, class First, class... Rest>
consteval void
format_validate_argument(size_t id,
                         basic_format_parse_context<charT> &context) {
  if (id == 0) {
    using value_type = remove_cvref_t<First>;

    formatter<value_type, charT> formatter_value;

    context.advance_to(formatter_value.parse(context));

    return;
  }

  if constexpr (sizeof...(Rest) != 0) {
    format_validate_argument<charT, Rest...>(id - 1, context);
  } else {
    throw_format_error("format argument index out of range");
  }
}

template <class charT, class... Args>
consteval void format_validate_string(basic_string_view<charT> value) {
  basic_format_parse_context<charT> parse_context(value, sizeof...(Args));

  auto current = value.begin();
  const auto end = value.end();

  while (current != end) {
    if (*current == format_widen<charT>('{')) {
      auto next = current;
      ++next;

      if (next != end && *next == format_widen<charT>('{')) {
        current = next;
        ++current;
        continue;
      }

      current = next;

      const size_t id =
          format_parse_replacement_arg_id(current, end, parse_context);

      if (current == end) {
        throw_format_error("unterminated replacement field");
      }

      if (*current == format_widen<charT>(':')) {
        ++current;
      } else if (*current != format_widen<charT>('}')) {
        throw_format_error("invalid replacement field");
      }

      parse_context.advance_to(current);

      format_validate_argument<charT, Args...>(id, parse_context);

      current = parse_context.begin();

      if (current == end || *current != format_widen<charT>('}')) {
        throw_format_error("unterminated format specification");
      }

      ++current;

      parse_context.advance_to(current);

      continue;
    }

    if (*current == format_widen<charT>('}')) {
      auto next = current;
      ++next;

      if (next == end || *next != format_widen<charT>('}')) {
        throw_format_error("unmatched closing brace");
      }

      current = next;
      ++current;
      continue;
    }

    ++current;
  }
}

