template <class charT>
constexpr typename basic_format_parse_context<charT>::iterator
format_parse_container_outer_spec(basic_format_parse_context<charT> &context,
                                  standard_format_spec<charT> &spec) {
  auto current = context.begin();
  const auto end = context.end();

  current = format_parse_fill_and_align(current, end, spec, true);

  if (current != end && format_is_digit(*current)) {
    size_t width = 0;

    while (current != end && format_is_digit(*current)) {
      const size_t digit =
          static_cast<size_t>(*current - format_widen<charT>('0'));

      if (width > (numeric_limits<size_t>::max() - digit) / size_t{10}) {
        throw_format_error("format width is too large");
      }

      width = width * size_t{10} + digit;

      ++current;
    }

    if (width == 0) {
      throw_format_error("format width must be positive");
    }

    spec.width = width;
  } else if (current != end && *current == format_widen<charT>('{')) {
    ++current;

    spec.dynamic_width = true;

    spec.width_arg_id = parse_dynamic_format_argument(
        current, end, context, "invalid dynamic format width",
        "unterminated dynamic format width");
  }

  return current;
}

