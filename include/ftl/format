  auto store = make_format_args(arguments...);

  return vformat(loc, fmt.get(), format_args(store)).size();
}

template <class... Args>
size_t formatted_size(const locale &loc, wformat_string<Args...> fmt,
                      Args &&...arguments) {
  auto store = make_wformat_args(arguments...);

  return vformat(loc, fmt.get(), wformat_args(store)).size();
}

