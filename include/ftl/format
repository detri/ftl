template <class Context> class basic_format_arg {
private:
  using char_type = typename Context::char_type;

public:
  class handle {
  private:
    const void *ptr_ = nullptr;

    void (*format_)(basic_format_parse_context<char_type> &, Context &,
                    const void *) = nullptr;

    template <class T>
    static void
    format_value(basic_format_parse_context<char_type> &parse_context,
                 Context &format_context, const void *pointer) {
      using unqualified_type = remove_const_t<T>;

      typename Context::template formatter_type<unqualified_type>
          formatter_value;

      parse_context.advance_to(formatter_value.parse(parse_context));

      if constexpr (detail::formattable_with<const unqualified_type, Context>) {
        const auto *typed = static_cast<const unqualified_type *>(pointer);

        format_context.advance_to(
            formatter_value.format(*typed, format_context));
      } else {
        auto *typed = const_cast<unqualified_type *>(
            static_cast<const unqualified_type *>(pointer));

        format_context.advance_to(
            formatter_value.format(*typed, format_context));
      }
    }

    template <class T>
    explicit handle(T &value) noexcept
        : ptr_(FTL_FORMAT_NS::addressof(value)), format_(&format_value<T>) {}

    friend class basic_format_arg;

  public:
    void format(basic_format_parse_context<char_type> &parse_context,
                Context &format_context) const {
      format_(parse_context, format_context, ptr_);
    }
  };

private:
  using value_type =
      variant<monostate, bool, char_type, int, unsigned int, long long int,
              unsigned long long int, float, double, long double,
              const char_type *, basic_string_view<char_type>, const void *,
              handle>;

  value_type value_{};

  template <class T>
  [[nodiscard]]
  static value_type make_value(T &value) noexcept {
    using argument_type = remove_const_t<T>;

    if constexpr (is_same_v<argument_type, bool> ||
                  is_same_v<argument_type, char_type>) {
      return value_type(value);
    } else if constexpr (is_same_v<argument_type, char> &&
                         is_same_v<char_type, wchar_t>) {
      return value_type(static_cast<wchar_t>(value));
    } else if constexpr (is_integral_v<argument_type> &&
                         is_signed_v<argument_type> &&
                         sizeof(argument_type) <= sizeof(int)) {
      return value_type(static_cast<int>(value));
    } else if constexpr (is_integral_v<argument_type> &&
                         is_unsigned_v<argument_type> &&
                         sizeof(argument_type) <= sizeof(unsigned int)) {
      return value_type(static_cast<unsigned int>(value));
    } else if constexpr (is_integral_v<argument_type> &&
                         is_signed_v<argument_type> &&
                         sizeof(argument_type) <= sizeof(long long int)) {
      return value_type(static_cast<long long int>(value));
    } else if constexpr (is_integral_v<argument_type> &&
                         is_unsigned_v<argument_type> &&
                         sizeof(argument_type) <=
                             sizeof(unsigned long long int)) {
      return value_type(static_cast<unsigned long long int>(value));
    } else if constexpr (is_same_v<argument_type, float> ||
                         is_same_v<argument_type, double> ||
                         is_same_v<argument_type, long double>) {
      return value_type(value);
    } else if constexpr (detail::format_string_like<argument_type>::value &&
                         is_same_v<typename detail::format_string_like<
                                       argument_type>::char_type,
                                   char_type>) {
      return value_type(
          basic_string_view<char_type>(value.data(), value.size()));
    } else if constexpr (is_same_v<decay_t<argument_type>, char_type *> ||
                         is_same_v<decay_t<argument_type>, const char_type *>) {
      return value_type(static_cast<const char_type *>(value));
    } else if constexpr (is_null_pointer_v<argument_type>) {
      return value_type(static_cast<const void *>(nullptr));
    } else if constexpr (is_pointer_v<argument_type> &&
                         is_void_v<remove_pointer_t<argument_type>>) {
      return value_type(static_cast<const void *>(value));
    } else {
      return value_type(handle(value));
    }
  }

  template <class T>
    requires detail::formattable_with<T, Context>
  explicit basic_format_arg(T &value) noexcept : value_(make_value(value)) {}

  template <class, class...> friend class detail::format_arg_store;

  template <class Visitor, class OtherContext>
  friend decltype(auto) visit_format_arg(Visitor &&,
                                         basic_format_arg<OtherContext>);

public:
  basic_format_arg() noexcept = default;

  explicit operator bool() const noexcept {
    return !holds_alternative<monostate>(value_);
  }
};

template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor &&visitor,
                                basic_format_arg<Context> argument) {
