template <class Context>
void format_runtime_argument(
    basic_format_arg<Context> argument,
    basic_format_parse_context<typename Context::char_type> &parse_context,
    Context &format_context) {
  if (!argument) {
    throw_format_error("format argument index out of range");
  }

  using charT = typename Context::char_type;

  using handle_type = typename basic_format_arg<Context>::handle;

  visit_format_arg(
      [&](auto value) {
        using value_type = remove_cvref_t<decltype(value)>;

        if constexpr (is_same_v<value_type, monostate>) {
          throw_format_error("format argument index out of range");
        } else if constexpr (is_same_v<value_type, handle_type>) {
          value.format(parse_context, format_context);
        } else {
          formatter<value_type, charT> formatter_value;

          parse_context.advance_to(formatter_value.parse(parse_context));

          format_context.advance_to(
              formatter_value.format(value, format_context));
        }
      },
      argument);
}

template <class charT>
using runtime_format_context =
    basic_format_context<back_insert_iterator<basic_string<charT>>, charT>;

template <class charT>
basic_string<charT>
format_runtime(basic_string_view<charT> fmt,
               basic_format_args<runtime_format_context<charT>> arguments,
               const FTL_FORMAT_NS::locale *loc) {
  using context_type = runtime_format_context<charT>;

  basic_string<charT> output;

  context_type format_context_value(back_inserter(output), arguments, loc);

  basic_format_parse_context<charT> parse_context(fmt);

  auto current = fmt.begin();
  const auto end = fmt.end();

  while (current != end) {
    if (*current == format_widen<charT>('{')) {
      auto next = current;
      ++next;

      if (next != end && *next == format_widen<charT>('{')) {
        output.push_back(format_widen<charT>('{'));

        current = next;
        ++current;
        continue;
      }

      current = next;

      const size_t id =
          format_parse_replacement_arg_id(current, end, parse_context);

      if (current == end) {
        throw_format_error("unterminated replacement field");
      }

      if (*current == format_widen<charT>(':')) {
        ++current;
      } else if (*current != format_widen<charT>('}')) {
        throw_format_error("invalid replacement field");
      }

      parse_context.advance_to(current);

      format_runtime_argument(format_context_value.arg(id), parse_context,
                              format_context_value);

      current = parse_context.begin();

      if (current == end || *current != format_widen<charT>('}')) {
        throw_format_error("unterminated format specification");
      }

      ++current;

      parse_context.advance_to(current);

      continue;
    }

    if (*current == format_widen<charT>('}')) {
      auto next = current;
      ++next;

      if (next == end || *next != format_widen<charT>('}')) {
        throw_format_error("unmatched closing brace");
      }

      output.push_back(format_widen<charT>('}'));

      current = next;
      ++current;
      continue;
    }

    output.push_back(*current);
    ++current;
  }

  return output;
}

template <class Out, class charT>
Out format_copy_to(Out out, basic_string_view<charT> value) {
  for (charT character : value) {
    *out = character;
    ++out;
  }

  return out;
}

template <class Out, class charT>
format_to_n_result<Out> format_copy_to_n(Out out, iter_difference_t<Out> n,
                                         basic_string_view<charT> value) {
  size_t count = 0;

  if (n > 0) {
    const size_t requested = static_cast<size_t>(n);

    count = requested < value.size() ? requested : value.size();
  }

  for (size_t index = 0; index < count; ++index) {
    *out = value[index];
    ++out;
  }

  return {move(out), static_cast<iter_difference_t<Out>>(value.size())};
}

