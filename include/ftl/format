[[nodiscard]]
constexpr int chrono_floor_div_100(int value) noexcept {
  int quotient = value / 100;

  if (value < 0 && value % 100 != 0) {
    --quotient;
  }

  return quotient;
}

[[nodiscard]]
constexpr unsigned chrono_year_remainder(int value) noexcept {
  const int century = chrono_floor_div_100(value);

  return static_cast<unsigned>(value - century * 100);
}

inline constexpr const char *chrono_short_month_name(unsigned value) noexcept {
  constexpr const char *names[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                   "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};

  return value >= 1 && value <= 12 ? names[value - 1] : nullptr;
}

inline constexpr const char *chrono_long_month_name(unsigned value) noexcept {
  constexpr const char *names[] = {
      "January", "February", "March",     "April",   "May",      "June",
      "July",    "August",   "September", "October", "November", "December"};

  return value >= 1 && value <= 12 ? names[value - 1] : nullptr;
}

