template <
    class Duration,
    class TimeZonePtr,
    class charT>
struct formatter<
    chrono::zoned_time<
        Duration,
        TimeZonePtr>,
    charT>
    : formatter<
          chrono::chrono_detail::
              local_time_format_t<
                  common_type_t<
                      Duration,
                      chrono::seconds>>,
          charT> {
private:
  using local_format_type =
      chrono::chrono_detail::
          local_time_format_t<
              common_type_t<
                  Duration,
                  chrono::seconds>>;

  using base_type =
      formatter<
          local_format_type,
          charT>;

public:
  template <class FormatContext>
  typename FormatContext::iterator
  format(
      const chrono::zoned_time<
          Duration,
          TimeZonePtr> &value,
      FormatContext &context) const {
    const chrono::sys_info info =
        value.get_info();

    const auto formatted =
        chrono::local_time_format(
            value.get_local_time(),
            addressof(info.abbrev),
            addressof(info.offset));

    return base_type::format(
        formatted,
        context);
  }
};

