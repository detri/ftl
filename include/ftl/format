};

template <class TupleType, class charT, class... Types>
class tuple_formatter_base {
private:
  static constexpr bool all_const_formattable =
      (formattable<const Types, charT> && ...);

public:
  constexpr tuple_formatter_base() noexcept = default;

  constexpr void set_separator(basic_string_view<charT> separator) noexcept {
    separator_ = separator;
  }

  constexpr void set_brackets(basic_string_view<charT> opening,
                              basic_string_view<charT> closing) noexcept {
    opening_bracket_ = opening;
    closing_bracket_ = closing;
  }

  template <class ParseContext>
  constexpr typename ParseContext::iterator parse(ParseContext &context) {
    auto current = format_parse_container_outer_spec(context, outer_);

    const auto end = context.end();

    if (current != end && *current != format_widen<charT>('}')) {
      if (*current == format_widen<charT>('m')) {
        if constexpr (sizeof...(Types) != 2) {
          throw_format_error(
              "tuple m presentation requires exactly two elements");
        } else {
          separator_ = format_static_view<charT>(": ", L": ");

          opening_bracket_ = {};
          closing_bracket_ = {};
        }

        ++current;
      } else if (*current == format_widen<charT>('n')) {
        opening_bracket_ = {};
        closing_bracket_ = {};

        ++current;
      } else {
        throw_format_error("invalid tuple format presentation type");
      }
    }

    if (current != end && *current != format_widen<charT>('}')) {
      throw_format_error("invalid tuple format specification");
    }

    auto parse_one = [&](auto &underlying) constexpr {
      context.advance_to(current);

      const auto parsed = underlying.parse(context);

      if (parsed != current) {
        throw_format_error("tuple element formatter did not accept an empty "
                           "format specification");
      }

      if constexpr (requires { underlying.set_debug_format(); }) {
        underlying.set_debug_format();
      }
    };

    apply([&](auto &...underlying) constexpr { (parse_one(underlying), ...); },
          underlying_);

    context.advance_to(current);

    return current;
  }

  template <class FormatContext>
    requires all_const_formattable
  typename FormatContext::iterator format(const TupleType &value,
                                          FormatContext &context) const {
    return format_impl(value, context, index_sequence_for<Types...>{});
  }

  template <class FormatContext>
    requires(!all_const_formattable)
  typename FormatContext::iterator format(TupleType &value,
                                          FormatContext &context) const {
    return format_impl(value, context, index_sequence_for<Types...>{});
  }

private:
  template <class Value, class FormatContext, size_t... Index>
  typename FormatContext::iterator format_impl(Value &value,
                                               FormatContext &context,
                                               index_sequence<Index...>) const {
    basic_string<charT> content;

    format_append_view(content, opening_bracket_);

    buffered_format_context<FormatContext, charT> buffered(context, content);

    (
        [&] {
          if constexpr (Index != 0) {
            format_append_view(content, separator_);
          }

          auto next =
              get<Index>(underlying_).format(get<Index>(value), buffered);

          buffered.advance_to(move(next));
        }(),
        ...);

    format_append_view(content, closing_bracket_);

    return format_padded_text(
        basic_string_view<charT>(content.data(), content.size()), context,
        outer_, format_alignment::left);
  }

  tuple<formatter<remove_cvref_t<Types>, charT>...> underlying_{};

  basic_string_view<charT> separator_ = format_static_view<charT>(", ", L", ");

  basic_string_view<charT> opening_bracket_ =
      format_static_view<charT>("(", L"(");

  basic_string_view<charT> closing_bracket_ =
      format_static_view<charT>(")", L")");

  standard_format_spec<charT> outer_{};
};

