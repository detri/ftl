    closing_bracket_ = closing;
  }

  constexpr formatter<T, charT> &underlying() noexcept { return underlying_; }

  constexpr const formatter<T, charT> &underlying() const noexcept {
    return underlying_;
  }

  template <class ParseContext>
  constexpr typename ParseContext::iterator parse(ParseContext &context) {
    auto current = detail::format_parse_container_outer_spec(context, outer_);

    const auto end = context.end();

    bool no_brackets = false;

    if (current != end && *current == detail::format_widen<charT>('n')) {
      no_brackets = true;

      opening_bracket_ = {};
      closing_bracket_ = {};

      ++current;
    }

    if (current != end && *current != detail::format_widen<charT>('}') &&
        *current != detail::format_widen<charT>(':')) {
      if (*current == detail::format_widen<charT>('m')) {
        if constexpr (!detail::format_pair_or_two_tuple_v<T>) {
          detail::throw_format_error("range m presentation requires pair or "
                                     "two-element tuple elements");
        } else {
          /*
           * range-type m specifies all three
           * range presentation delimiters.
           * In particular it resets a separator
           * previously supplied through
           * set_separator().
           */
          separator_ = detail::format_static_view<charT>(", ", L", ");

          if (!no_brackets) {
            opening_bracket_ = detail::format_static_view<charT>("{", L"{");

            closing_bracket_ = detail::format_static_view<charT>("}", L"}");
          }

          underlying_.set_brackets({}, {});

          underlying_.set_separator(
              detail::format_static_view<charT>(": ", L": "));
        }

        ++current;
      } else if (*current == detail::format_widen<charT>('s')) {
        if constexpr (!same_as<T, charT>) {
          detail::throw_format_error(
              "range s presentation requires character elements");
        } else {
          if (no_brackets) {
            detail::throw_format_error(
                "range s presentation cannot be combined with n");
          }

          string_mode_ = true;
        }

        ++current;
      } else if (*current == detail::format_widen<charT>('?')) {
        auto next = current;
        ++next;

        if (next == end || *next != detail::format_widen<charT>('s')) {
          detail::throw_format_error("invalid range format presentation type");
        }

        if constexpr (!same_as<T, charT>) {
          detail::throw_format_error(
              "range ?s presentation requires character elements");
        } else {
          if (no_brackets) {
            detail::throw_format_error(
                "range ?s presentation cannot be combined with n");
          }

          string_mode_ = true;
          debug_string_mode_ = true;
        }

        current = next;
        ++current;
      } else {
        detail::throw_format_error("invalid range format presentation type");
      }
    }

    if (current != end && *current == detail::format_widen<charT>(':')) {
      if (string_mode_) {
        detail::throw_format_error("string range presentation cannot have an "
                                   "underlying format specification");
      }

      ++current;

      context.advance_to(current);

      return underlying_.parse(context);
    }

    if (current != end && *current != detail::format_widen<charT>('}')) {
      detail::throw_format_error("invalid range format specification");
    }

    context.advance_to(current);

    const auto parsed = underlying_.parse(context);

    if constexpr (requires { underlying_.set_debug_format(); }) {
      underlying_.set_debug_format();
    }

    return parsed;
  }

  template <ranges::input_range R, class FormatContext>
    requires formattable<ranges::range_reference_t<R>, charT> &&
             same_as<remove_cvref_t<ranges::range_reference_t<R>>, T>
  typename FormatContext::iterator format(R &&range,
                                          FormatContext &context) const {
    if (string_mode_) {
      if constexpr (same_as<T, charT>) {
        basic_string<charT> text;

        for (auto &&character : range) {
          text.push_back(static_cast<charT>(character));
        }

        if (debug_string_mode_) {
          const auto escaped = detail::format_escape_string(
              basic_string_view<charT>(text.data(), text.size()));

          return detail::format_padded_text(
              basic_string_view<charT>(escaped.data(), escaped.size()), context,
              outer_, detail::format_alignment::left);
        }

        return detail::format_padded_text(
            basic_string_view<charT>(text.data(), text.size()), context, outer_,
            detail::format_alignment::left);
      }
    }

    basic_string<charT> content;

    detail::format_append_view(content, opening_bracket_);

    detail::buffered_format_context<FormatContext, charT> buffered(context,
                                                                   content);

    bool first = true;

    for (auto &&element : range) {
      if (!first) {
        detail::format_append_view(content, separator_);
      }

      first = false;

      auto next = underlying_.format(element, buffered);

      buffered.advance_to(move(next));
    }

    detail::format_append_view(content, closing_bracket_);

    return detail::format_padded_text(
        basic_string_view<charT>(content.data(), content.size()), context,
        outer_, detail::format_alignment::left);
  }

private:
  formatter<T, charT> underlying_{};

  basic_string_view<charT> separator_ =
      detail::format_static_view<charT>(", ", L", ");

  basic_string_view<charT> opening_bracket_ =
      detail::format_static_view<charT>("[", L"[");

  basic_string_view<charT> closing_bracket_ =
      detail::format_static_view<charT>("]", L"]");

  detail::standard_format_spec<charT> outer_{};

  bool string_mode_ = false;
  bool debug_string_mode_ = false;
};

