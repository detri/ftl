  inline complex<float> name(const complex<float> &value) {                   \
    return detail::complex_from_abi(                                          \
        ::ftl_olm_c##name##f(detail::complex_to_abi(value)));                 \
  }                                                                           \
  inline complex<double> name(const complex<double> &value) {                 \
    return detail::complex_from_abi(                                          \
        ::ftl_olm_c##name(detail::complex_to_abi(value)));                    \
