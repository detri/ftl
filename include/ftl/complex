template <class T> inline complex<T> polar(const T &magnitude,
                                            const T &angle = T{}) {
  return {magnitude * cos(angle), magnitude * sin(angle)};
}

inline complex<float> pow(const complex<float> &left,
                          const complex<float> &right) {
  return detail::complex_from_abi(::ftl_olm_cpowf(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
}
inline complex<double> pow(const complex<double> &left,
                           const complex<double> &right) {
  return detail::complex_from_abi(::ftl_olm_cpow(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
}
inline complex<long double> pow(const complex<long double> &left,
                                const complex<long double> &right) {
  return detail::complex_from_abi(::ftl_olm_cpowl(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
