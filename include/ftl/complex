#undef FTL_COMPLEX_RUNTIME_UNARY

inline float abs(const complex<float> &value) {
  return ::ftl_olm_cabsf(detail::complex_to_abi(value));
}
inline double abs(const complex<double> &value) {
  return ::ftl_olm_cabs(detail::complex_to_abi(value));
}
inline long double abs(const complex<long double> &value) {
  return ::ftl_olm_cabsl(detail::complex_to_abi(value));
}
inline float arg(const complex<float> &value) {
  return ::ftl_olm_cargf(detail::complex_to_abi(value));
}
inline double arg(const complex<double> &value) {
  return ::ftl_olm_carg(detail::complex_to_abi(value));
}
inline long double arg(const complex<long double> &value) {
  return ::ftl_olm_cargl(detail::complex_to_abi(value));
}

template <class T> inline complex<T> polar(const T &magnitude,
                                            const T &angle = T{}) {
  return {magnitude * cos(angle), magnitude * sin(angle)};
}

inline complex<float> pow(const complex<float> &left,
                          const complex<float> &right) {
  return detail::complex_from_abi(::ftl_olm_cpowf(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
}
inline complex<double> pow(const complex<double> &left,
                           const complex<double> &right) {
  return detail::complex_from_abi(::ftl_olm_cpow(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
}
inline complex<long double> pow(const complex<long double> &left,
                                const complex<long double> &right) {
  return detail::complex_from_abi(::ftl_olm_cpowl(
      detail::complex_to_abi(left), detail::complex_to_abi(right)));
}
template <class T> inline complex<T> pow(const complex<T> &left,
                                         const T &right) {
  return pow(left, complex<T>(right));
}
template <class T> inline complex<T> pow(const T &left,
                                         const complex<T> &right) {
  return pow(complex<T>(left), right);
}

inline complex<float> log10(const complex<float> &value) {
  return log(value) / log(10.0f);
}
inline complex<double> log10(const complex<double> &value) {
  return log(value) / log(10.0);
}
inline complex<long double> log10(const complex<long double> &value) {
  return log(value) / log(10.0L);
}

namespace literals::complex_literals {
constexpr complex<double> operator""i(long double value) {
  return {0.0, static_cast<double>(value)};
}
constexpr complex<double> operator""i(unsigned long long value) {
  return {0.0, static_cast<double>(value)};
}
constexpr complex<float> operator""if(long double value) {
  return {0.0f, static_cast<float>(value)};
}
constexpr complex<float> operator""if(unsigned long long value) {
  return {0.0f, static_cast<float>(value)};
}
constexpr complex<long double> operator""il(long double value) {
  return {0.0L, value};
}
constexpr complex<long double> operator""il(unsigned long long value) {
  return {0.0L, static_cast<long double>(value)};
}
} // namespace literals::complex_literals

namespace complex_literals = literals::complex_literals;
namespace literals { using namespace complex_literals; }

