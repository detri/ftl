namespace detail {
template <class T>
inline constexpr int complex_conversion_rank =
    is_same_v<T, long double> ? 3 : is_same_v<T, double> ? 2 : 1;
}

template <class T> class complex {
public:
  using value_type = T;

  constexpr complex(const T &real = T{}, const T &imaginary = T{})
      : real_(real), imaginary_(imaginary) {}

  template <class U>
  explicit(detail::complex_conversion_rank<T> <
           detail::complex_conversion_rank<U>)
  constexpr complex(const complex<U> &other)
      : real_(static_cast<T>(other.real())),
        imaginary_(static_cast<T>(other.imag())) {}

  constexpr T real() const { return real_; }
  constexpr void real(T value) { real_ = value; }
  constexpr T imag() const { return imaginary_; }
  constexpr void imag(T value) { imaginary_ = value; }

  constexpr complex &operator=(const T &value) {
    real_ = value;
    imaginary_ = T{};
    return *this;
  }
  constexpr complex &operator+=(const T &value) {
    real_ += value;
    return *this;
  }
  constexpr complex &operator-=(const T &value) {
    real_ -= value;
    return *this;
  }
  constexpr complex &operator*=(const T &value) {
    real_ *= value;
    imaginary_ *= value;
    return *this;
  }
  constexpr complex &operator/=(const T &value) {
    real_ /= value;
    imaginary_ /= value;
    return *this;
  }

  template <class U> constexpr complex &operator+=(const complex<U> &other) {
    real_ += static_cast<T>(other.real());
    imaginary_ += static_cast<T>(other.imag());
    return *this;
  }
  template <class U> constexpr complex &operator-=(const complex<U> &other) {
    real_ -= static_cast<T>(other.real());
    imaginary_ -= static_cast<T>(other.imag());
    return *this;
  }
  template <class U> constexpr complex &operator*=(const complex<U> &other) {
    const T other_real = static_cast<T>(other.real());
    const T new_real = real_ * other_real -
                       imaginary_ * static_cast<T>(other.imag());
    imaginary_ = real_ * static_cast<T>(other.imag()) +
                 imaginary_ * other_real;
    real_ = new_real;
    return *this;
  }
  template <class U> constexpr complex &operator/=(const complex<U> &other) {
    const T left_real = real_;
    const T left_imaginary = imaginary_;
    const T other_real = static_cast<T>(other.real());
    const T other_imaginary = static_cast<T>(other.imag());
    const T abs_real = other_real < T{} ? -other_real : other_real;
    const T abs_imaginary =
        other_imaginary < T{} ? -other_imaginary : other_imaginary;
    if (abs_real < abs_imaginary) {
      const T ratio = other_real / other_imaginary;
      const T denominator = other_real * ratio + other_imaginary;
      const T new_real = (real_ * ratio + imaginary_) / denominator;
      imaginary_ = (imaginary_ * ratio - real_) / denominator;
      real_ = new_real;
    } else {
      const T ratio = other_imaginary / other_real;
      const T denominator = other_imaginary * ratio + other_real;
      const T new_real = (imaginary_ * ratio + real_) / denominator;
      imaginary_ = (imaginary_ - real_ * ratio) / denominator;
      real_ = new_real;
    }
    if (isnan(real_) && isnan(imaginary_)) {
      const T infinity = numeric_limits<T>::infinity();
      if (other_real == T{} && other_imaginary == T{} &&
          (!isnan(left_real) || !isnan(left_imaginary))) {
        real_ = copysign(infinity, other_real) * left_real;
        imaginary_ = copysign(infinity, other_real) * left_imaginary;
      } else if ((isinf(left_real) || isinf(left_imaginary)) &&
                 isfinite(other_real) && isfinite(other_imaginary)) {
        const T a = copysign(isinf(left_real) ? T{1} : T{}, left_real);
        const T b = copysign(isinf(left_imaginary) ? T{1} : T{},
                             left_imaginary);
        real_ = infinity * (a * other_real + b * other_imaginary);
        imaginary_ = infinity * (b * other_real - a * other_imaginary);
      } else if ((isinf(other_real) || isinf(other_imaginary)) &&
                 isfinite(left_real) && isfinite(left_imaginary)) {
        const T c = copysign(isinf(other_real) ? T{1} : T{}, other_real);
        const T d = copysign(isinf(other_imaginary) ? T{1} : T{},
                             other_imaginary);
        real_ = T{} * (left_real * c + left_imaginary * d);
        imaginary_ = T{} * (left_imaginary * c - left_real * d);
      }
    }
    return *this;
  }

private:
  T real_;
  T imaginary_;
};

template <class T> constexpr complex<T> operator+(const complex<T> &value) {
  return value;
}
template <class T> constexpr complex<T> operator-(const complex<T> &value) {
  return {-value.real(), -value.imag()};
}

#define FTL_COMPLEX_OPERATOR(symbol, assignment)                              \
  template <class T>                                                          \
  constexpr complex<T> operator symbol(complex<T> left,                      \
                                        const complex<T> &right) {            \
    return left assignment right;                                             \
  }                                                                           \
  template <class T>                                                          \
  constexpr complex<T> operator symbol(complex<T> left, const T &right) {     \
    return left assignment right;                                             \
  }                                                                           \
  template <class T>                                                          \
  constexpr complex<T> operator symbol(const T &left, complex<T> right) {     \
    if constexpr (#symbol[0] == '-')                                          \
      return complex<T>(left) assignment right;                               \
    else if constexpr (#symbol[0] == '/')                                     \
      return complex<T>(left) assignment right;                               \
    else                                                                      \
      return right assignment left;                                           \
  }

FTL_COMPLEX_OPERATOR(+, +=)
FTL_COMPLEX_OPERATOR(-, -=)
FTL_COMPLEX_OPERATOR(*, *=)
FTL_COMPLEX_OPERATOR(/, /=)
#undef FTL_COMPLEX_OPERATOR

template <class T>
constexpr bool operator==(const complex<T> &left, const complex<T> &right) {
  return left.real() == right.real() && left.imag() == right.imag();
}
template <class T>
constexpr bool operator==(const complex<T> &left, const T &right) {
  return left.real() == right && left.imag() == T{};
}
template <class T>
constexpr bool operator==(const T &left, const complex<T> &right) {
  return right == left;
}

namespace detail {
template <class T>
constexpr ftl_olm_complex<T> complex_to_abi(const complex<T> &value) {
  return {value.real(), value.imag()};
}
template <class T>
constexpr complex<T> complex_from_abi(ftl_olm_complex<T> value) {
  return {value.real, value.imag};
}
} // namespace detail

template <class T> constexpr T real(const complex<T> &value) {
  return value.real();
}
template <class T> constexpr T imag(const complex<T> &value) {
  return value.imag();
}
template <class T> constexpr T norm(const complex<T> &value) {
  return value.real() * value.real() + value.imag() * value.imag();
}
template <class T> constexpr complex<T> conj(const complex<T> &value) {
  return {value.real(), -value.imag()};
}
template <class Arithmetic>
  requires is_arithmetic_v<Arithmetic>
constexpr auto real(Arithmetic value) {
  using result_type = conditional_t<is_integral_v<Arithmetic>, double, Arithmetic>;
  return static_cast<result_type>(value);
}
template <class Arithmetic>
  requires is_arithmetic_v<Arithmetic>
constexpr auto imag(Arithmetic) {
  using result_type = conditional_t<is_integral_v<Arithmetic>, double, Arithmetic>;
  return result_type{};
}
template <class Arithmetic>
  requires is_arithmetic_v<Arithmetic>
constexpr auto norm(Arithmetic value) {
  using result_type = conditional_t<is_integral_v<Arithmetic>, double, Arithmetic>;
  const result_type promoted = static_cast<result_type>(value);
  return promoted * promoted;
}
template <class Arithmetic>
  requires is_arithmetic_v<Arithmetic>
inline auto arg(Arithmetic value) {
  using result_type = conditional_t<is_integral_v<Arithmetic>, double, Arithmetic>;
  return signbit(value)
      ? result_type(3.141592653589793238462643383279502884L)
      : result_type{};
}
template <class Arithmetic>
  requires is_arithmetic_v<Arithmetic>
constexpr auto conj(Arithmetic value) {
  using result_type = conditional_t<is_integral_v<Arithmetic>, double, Arithmetic>;
  return complex<result_type>{static_cast<result_type>(value), -result_type{}};
}

