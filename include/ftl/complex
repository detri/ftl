template <class T1, class T2>
inline complex<common_type_t<T1, T2>> pow(const complex<T1> &left,
                                          const complex<T2> &right) {
  using result_type = common_type_t<T1, T2>;
  return pow(complex<result_type>(left), complex<result_type>(right));
}
template <class T1, class T2>
  requires is_arithmetic_v<T2>
inline complex<common_type_t<T1, T2>> pow(const complex<T1> &left,
                                          const T2 &right) {
  using result_type = common_type_t<T1, T2>;
  return pow(complex<result_type>(left), complex<result_type>(right));
}
template <class T1, class T2>
  requires is_arithmetic_v<T1>
inline complex<common_type_t<T1, T2>> pow(const T1 &left,
                                          const complex<T2> &right) {
  using result_type = common_type_t<T1, T2>;
  return pow(complex<result_type>(left), complex<result_type>(right));
}

inline complex<float> log10(const complex<float> &value) {
  return log(value) / log(10.0f);
}
inline complex<double> log10(const complex<double> &value) {
  return log(value) / log(10.0);
}
inline complex<long double> log10(const complex<long double> &value) {
  return log(value) / log(10.0L);
}

template <class Character, class Traits, class Value>
basic_istream<Character, Traits> &operator>>(basic_istream<Character, Traits> &input,
                                             complex<Value> &value) {
  Value real{}, imaginary{};
  Character character{};
  if (!(input >> character)) return input;
  if (character != input.widen('(')) {
    input.putback(character);
    if (input >> real) value = complex<Value>(real, Value{});
    return input;
  }
  if (!(input >> real >> character)) return input;
  if (character == input.widen(')')) {
    value = complex<Value>(real, Value{});
    return input;
  }
  if (character != input.widen(',')) {
    input.setstate(ios_base::failbit);
    return input;
  }
  if (input >> imaginary >> character && character == input.widen(')'))
    value = complex<Value>(real, imaginary);
  else
    input.setstate(ios_base::failbit);
  return input;
}

template <class Character, class Traits, class Value>
basic_ostream<Character, Traits> &operator<<(basic_ostream<Character, Traits> &output,
                                             const complex<Value> &value) {
  class buffer_type : public basic_streambuf<Character, Traits> {
  public:
    basic_string<Character, Traits> value;
  protected:
    typename Traits::int_type overflow(typename Traits::int_type character) override {
      if (Traits::eq_int_type(character, Traits::eof())) return Traits::not_eof(character);
      value.push_back(Traits::to_char_type(character)); return character;
    }
    streamsize xsputn(const Character *source, streamsize count) override {
      value.append(source, static_cast<size_t>(count)); return count;
    }
  } buffer;
  basic_ostream<Character, Traits> temporary(&buffer);
  temporary.flags(output.flags());
  temporary.imbue(output.getloc());
  temporary.precision(output.precision());
  temporary << output.widen('(') << value.real() << output.widen(',')
            << value.imag() << output.widen(')');
  return output << buffer.value;
}

namespace literals::complex_literals {
constexpr complex<double> operator""i(long double value) {
  return {0.0, static_cast<double>(value)};
}
constexpr complex<double> operator""i(unsigned long long value) {
  return {0.0, static_cast<double>(value)};
}
constexpr complex<float> operator""if(long double value) {
  return {0.0f, static_cast<float>(value)};
}
constexpr complex<float> operator""if(unsigned long long value) {
  return {0.0f, static_cast<float>(value)};
}
constexpr complex<long double> operator""il(long double value) {
  return {0.0L, value};
}
constexpr complex<long double> operator""il(unsigned long long value) {
  return {0.0L, static_cast<long double>(value)};
}
} // namespace literals::complex_literals

