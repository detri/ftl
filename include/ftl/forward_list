namespace detail {
template <class R, class T>
concept forward_list_compatible_range =
    ranges::input_range<R> && convertible_to<ranges::range_reference_t<R>, T>;
template <class T> struct forward_list_compare {
  constexpr auto operator()(const T &a, const T &b) const {
    if constexpr (three_way_comparable<T>)
      return a <=> b;
    else {
      if (a < b)
        return weak_ordering::less;
      if (b < a)
        return weak_ordering::greater;
      return weak_ordering::equivalent;
    }
  }
};
} // namespace detail

template <class T, class Allocator = allocator<T>> class forward_list {
  struct node_base {
    node_base *next{};
  };
  struct node : node_base {
    template <class... Args>
    explicit node(Args &&...args) : value(forward<Args>(args)...) {}
    T value;
  };
  using traits = allocator_traits<Allocator>;
  using node_allocator = typename traits::template rebind_alloc<node>;
  using node_traits = allocator_traits<node_allocator>;

public:
  static_assert(is_same_v<typename traits::value_type, T>);
  static_assert(is_object_v<T>);
  using value_type = T;
  using allocator_type = Allocator;
  using pointer = typename traits::pointer;
  using const_pointer = typename traits::const_pointer;
  using reference = T &;
  using const_reference = const T &;
  using size_type = typename traits::size_type;
  using difference_type = typename traits::difference_type;

  template <bool Const> class basic_iterator {
    node_base *current_{};
    explicit basic_iterator(node_base *current) : current_(current) {}
    friend class forward_list;
    template <bool> friend class basic_iterator;

  public:
    using iterator_concept = forward_iterator_tag;
    using iterator_category = forward_iterator_tag;
    using value_type = T;
    using difference_type = typename forward_list::difference_type;
    using reference = conditional_t<Const, const T &, T &>;
    using pointer = conditional_t<Const, const T *, T *>;
    basic_iterator() = default;
    template <bool Other>
      requires(Const && !Other)
    basic_iterator(const basic_iterator<Other> &other)
        : current_(other.current_) {}
    reference operator*() const { return static_cast<node *>(current_)->value; }
    pointer operator->() const { return addressof(operator*()); }
    basic_iterator &operator++() {
      current_ = current_->next;
      return *this;
    }
    basic_iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }
    template <bool Other>
    bool operator==(const basic_iterator<Other> &other) const {
      return current_ == other.current_;
    }
  };

  using iterator = basic_iterator<false>;
  using const_iterator = basic_iterator<true>;

  forward_list() : forward_list(Allocator()) {}
  explicit forward_list(const Allocator &a) : allocator_(a) {}
  explicit forward_list(size_type n, const Allocator &a = Allocator())
      : forward_list(a) {
    insert_default_after(before_begin(), n);
  }
  forward_list(size_type n, const T &value, const Allocator &a = Allocator())
      : forward_list(a) {
    insert_after(before_begin(), n, value);
  }
  template <input_iterator I>
  forward_list(I first, I last, const Allocator &a = Allocator())
      : forward_list(a) {
    insert_after(before_begin(), first, last);
  }
  template <detail::forward_list_compatible_range<T> R>
  forward_list(from_range_t, R &&range, const Allocator &a = Allocator())
      : forward_list(a) {
    insert_range_after(before_begin(), static_cast<R &&>(range));
  }
  forward_list(const forward_list &other)
      : forward_list(traits::select_on_container_copy_construction(
            other.get_allocator())) {
    insert_after(before_begin(), other.begin(), other.end());
  }
  forward_list(forward_list &&other) noexcept
      : allocator_(move(other.allocator_)) {
    head_.next = exchange(other.head_.next, nullptr);
  }
  forward_list(const forward_list &other, const type_identity_t<Allocator> &a)
      : forward_list(other.begin(), other.end(), a) {}
  forward_list(forward_list &&other, const type_identity_t<Allocator> &a)
      : forward_list(a) {
    if (allocator_ == other.allocator_)
      head_.next = exchange(other.head_.next, nullptr);
    else {
      insert_after(before_begin(), make_move_iterator(other.begin()),
                   make_move_iterator(other.end()));
      other.clear();
    }
  }
  forward_list(initializer_list<T> values, const Allocator &a = Allocator())
      : forward_list(values.begin(), values.end(), a) {}
  ~forward_list() { clear(); }

  forward_list &operator=(const forward_list &other) {
    if (this == &other)
      return *this;
    if constexpr (traits::propagate_on_container_copy_assignment::value)
      if (!(allocator_ == other.allocator_)) {
        clear();
        allocator_ = other.allocator_;
      }
    assign(other.begin(), other.end());
    return *this;
  }
  forward_list &
  operator=(forward_list &&other) noexcept(traits::is_always_equal::value) {
    if (this == &other)
      return *this;
    if constexpr (traits::propagate_on_container_move_assignment::value) {
      clear();
      allocator_ = move(other.allocator_);
      head_.next = exchange(other.head_.next, nullptr);
    } else if (allocator_ == other.allocator_) {
      clear();
      head_.next = exchange(other.head_.next, nullptr);
    } else {
      assign(make_move_iterator(other.begin()),
             make_move_iterator(other.end()));
      other.clear();
    }
    return *this;
  }
  forward_list &operator=(initializer_list<T> values) {
    assign(values);
    return *this;
  }
  template <input_iterator I> void assign(I first, I last) {
    forward_list replacement(first, last, allocator_);
    swap_nodes(replacement);
  }
  template <detail::forward_list_compatible_range<T> R>
  void assign_range(R &&range) {
    forward_list replacement(from_range, static_cast<R &&>(range), allocator_);
    swap_nodes(replacement);
  }
  void assign(size_type n, const T &value) {
    forward_list replacement(n, value, allocator_);
    swap_nodes(replacement);
  }
  void assign(initializer_list<T> values) {
    assign(values.begin(), values.end());
  }
  allocator_type get_allocator() const noexcept { return allocator_; }

  iterator before_begin() noexcept { return iterator(&head_); }
  const_iterator before_begin() const noexcept {
    return const_iterator(const_cast<node_base *>(&head_));
  }
  const_iterator cbefore_begin() const noexcept { return before_begin(); }
  iterator begin() noexcept { return iterator(head_.next); }
  const_iterator begin() const noexcept { return const_iterator(head_.next); }
  const_iterator cbegin() const noexcept { return begin(); }
  iterator end() noexcept { return iterator(); }
  const_iterator end() const noexcept { return const_iterator(); }
  const_iterator cend() const noexcept { return end(); }
  [[nodiscard]] bool empty() const noexcept { return !head_.next; }
  size_type max_size() const noexcept {
    node_allocator a(allocator_);
    const auto n = node_traits::max_size(a);
    const auto d =
        static_cast<size_type>((numeric_limits<difference_type>::max)());
    return n < d ? n : d;
  }
  reference front() { return *begin(); }
  const_reference front() const { return *begin(); }

  template <class... Args> reference emplace_front(Args &&...args) {
    return *emplace_after(before_begin(), forward<Args>(args)...);
  }
  void push_front(const T &value) { emplace_front(value); }
  void push_front(T &&value) { emplace_front(move(value)); }
  template <detail::forward_list_compatible_range<T> R>
  void prepend_range(R &&range) {
    insert_range_after(before_begin(), static_cast<R &&>(range));
  }
  void pop_front() { erase_after(before_begin()); }
  template <class... Args>
  iterator emplace_after(const_iterator position, Args &&...args) {
    node *added = make_node(forward<Args>(args)...);
    added->next = position.current_->next;
    position.current_->next = added;
    return iterator(added);
  }
  iterator insert_after(const_iterator p, const T &value) {
    return emplace_after(p, value);
  }
  iterator insert_after(const_iterator p, T &&value) {
    return emplace_after(p, move(value));
  }
  iterator insert_after(const_iterator p, size_type n, const T &value) {
    forward_list added(allocator_);
    auto tail = added.before_begin();
    while (n--)
      tail = added.emplace_after(tail, value);
    if (added.empty())
      return iterator(p.current_);
    node_base *last = tail.current_;
    transfer_after(p.current_, &added.head_, nullptr);
    return iterator(last);
  }
  template <input_iterator I>
  iterator insert_after(const_iterator p, I first, I last) {
    forward_list added(allocator_);
    auto tail = added.before_begin();
    for (; first != last; ++first)
      tail = added.emplace_after(tail, *first);
    if (added.empty())
      return iterator(p.current_);
    node_base *result = tail.current_;
    transfer_after(p.current_, &added.head_, nullptr);
    return iterator(result);
  }
  template <detail::forward_list_compatible_range<T> R>
  iterator insert_range_after(const_iterator p, R &&range) {
    forward_list added(allocator_);
    auto tail = added.before_begin();
    for (auto &&value : range)
      tail = added.emplace_after(tail, static_cast<decltype(value) &&>(value));
    if (added.empty())
      return iterator(p.current_);
    node_base *result = tail.current_;
    transfer_after(p.current_, &added.head_, nullptr);
    return iterator(result);
  }
  iterator insert_after(const_iterator p, initializer_list<T> values) {
    return insert_after(p, values.begin(), values.end());
  }
  iterator erase_after(const_iterator p) {
    node_base *removed = p.current_->next;
    p.current_->next = removed->next;
    destroy_node(static_cast<node *>(removed));
    return iterator(p.current_->next);
  }
  iterator erase_after(const_iterator first, const_iterator last) {
    while (first.current_->next != last.current_)
      erase_after(first);
    return iterator(last.current_);
  }
  void swap(forward_list &other) noexcept(traits::is_always_equal::value) {
    if constexpr (traits::propagate_on_container_swap::value)
      FTL_FORWARD_LIST_NAMESPACE::swap(allocator_, other.allocator_);
    swap_nodes(other);
  }
  void resize(size_type n) { resize_impl(n, nullptr); }
  void resize(size_type n, const value_type &value) {
    resize_impl(n, addressof(value));
  }
  void clear() noexcept {
    while (head_.next)
      erase_after(before_begin());
  }

  void splice_after(const_iterator p, forward_list &other) {
    splice_after(p, move(other));
  }
  void splice_after(const_iterator p, forward_list &&other) {
    if (!other.empty())
      transfer_after(p.current_, &other.head_, nullptr);
  }
  void splice_after(const_iterator p, forward_list &other, const_iterator i) {
    splice_after(p, move(other), i);
  }
  void splice_after(const_iterator p, forward_list &&, const_iterator i) {
    node_base *moved = i.current_->next;
    if (p.current_ != i.current_ && p.current_ != moved) {
      i.current_->next = moved->next;
      moved->next = p.current_->next;
      p.current_->next = moved;
    }
  }
  void splice_after(const_iterator p, forward_list &other, const_iterator first,
                    const_iterator last) {
    splice_after(p, move(other), first, last);
  }
  void splice_after(const_iterator p, forward_list &&, const_iterator first,
                    const_iterator last) {
    if (first != last && first.current_->next != last.current_)
      transfer_after(p.current_, first.current_, last.current_);
  }
  size_type remove(const T &value) {
    return remove_if([&](const T &item) { return item == value; });
  }
  template <class Predicate> size_type remove_if(Predicate predicate) {
    size_type count{};
    auto previous = before_begin();
    while (previous.current_->next) {
      if (predicate(*next(previous))) {
        erase_after(previous);
        ++count;
      } else
        ++previous;
    }
    return count;
  }
  size_type unique() { return unique(equal_to<>{}); }
  template <class BinaryPredicate> size_type unique(BinaryPredicate predicate) {
    size_type count{};
    if (empty())
      return count;
    auto current = begin();
    while (current.current_->next) {
      if (predicate(*current, *next(current))) {
        erase_after(current);
        ++count;
      } else
        ++current;
    }
    return count;
  }
  void merge(forward_list &other) { merge(move(other)); }
  void merge(forward_list &&other) { merge(move(other), less<>{}); }
  template <class Compare> void merge(forward_list &other, Compare comp) {
    merge(move(other), move(comp));
  }
  template <class Compare> void merge(forward_list &&other, Compare comp) {
    if (this == &other)
      return;
    node_base *p = &head_;
    while (p->next && other.head_.next) {
      if (comp(static_cast<node *>(other.head_.next)->value,
               static_cast<node *>(p->next)->value)) {
        node_base *moved = other.head_.next;
        other.head_.next = moved->next;
        moved->next = p->next;
        p->next = moved;
      }
      p = p->next;
    }
    if (other.head_.next)
      p->next = exchange(other.head_.next, nullptr);
  }
  void sort() { sort(less<>{}); }
  template <class Compare> void sort(Compare comp) {
    merge_sort(head_.next, comp);
  }
  void reverse() noexcept {
    node_base *result{};
    while (head_.next) {
      node_base *moved = head_.next;
      head_.next = moved->next;
      moved->next = result;
      result = moved;
    }
    head_.next = result;
  }

private:
  template <class... Args> node *make_node(Args &&...args) {
    node_allocator a(allocator_);
    auto storage = node_traits::allocate(a, 1);
    node *result = to_address(storage);
#if FTL_HAS_EXCEPTIONS
    try {
      node_traits::construct(a, result, forward<Args>(args)...);
    } catch (...) {
      node_traits::deallocate(a, storage, 1);
      throw;
    }
#else
    node_traits::construct(a, result, forward<Args>(args)...);
#endif
    return result;
  }
  void destroy_node(node *value) noexcept {
    node_allocator a(allocator_);
    node_traits::destroy(a, value);
    node_traits::deallocate(a, typename node_traits::pointer(value), 1);
  }
  void insert_default_after(const_iterator p, size_type n) {
    forward_list added(allocator_);
    auto tail = added.before_begin();
    while (n--)
      tail = added.emplace_after(tail);
    if (!added.empty())
      transfer_after(p.current_, &added.head_, nullptr);
  }
  void resize_impl(size_type n, const T *value) {
    auto p = before_begin();
    size_type count{};
    while (p.current_->next && count < n) {
      ++p;
      ++count;
    }
    if (count == n)
      erase_after(p, end());
    else
      while (count++ < n)
        p = value ? emplace_after(p, *value) : emplace_after(p);
  }
  void swap_nodes(forward_list &other) noexcept {
    FTL_FORWARD_LIST_NAMESPACE::swap(head_.next, other.head_.next);
  }
  static void transfer_after(node_base *position, node_base *before_first,
                             node_base *last) {
    node_base *first = before_first->next;
    node_base *tail = first;
    while (tail->next != last)
      tail = tail->next;
    before_first->next = last;
    tail->next = position->next;
    position->next = first;
  }
  template <class Compare>
  static void merge_sort(node_base *&first, Compare &comp) {
    if (!first || !first->next)
      return;
    node_base *slow = first;
    node_base *fast = first->next;
    while (fast && fast->next) {
      slow = slow->next;
      fast = fast->next->next;
    }
    node_base *right = slow->next;
    slow->next = nullptr;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      merge_sort(first, comp);
      merge_sort(right, comp);
      merge_nodes(first, right, comp);
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      concatenate(first, right);
      throw;
    }
#endif
  }
  template <class Compare>
  static void merge_nodes(node_base *&left, node_base *&right, Compare &comp) {
    node_base head;
    node_base *tail = &head;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
    while (left && right) {
      node_base *&chosen = comp(static_cast<node *>(right)->value,
                                static_cast<node *>(left)->value)
                               ? right
                               : left;
      tail = tail->next = exchange(chosen, chosen->next);
    }
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      tail->next = left;
      concatenate(head.next, right);
      left = head.next;
      right = nullptr;
      throw;
    }
#endif
    tail->next = left ? left : right;
    left = head.next;
    right = nullptr;
  }
  static void concatenate(node_base *&left, node_base *&right) noexcept {
    if (!left) {
      left = exchange(right, nullptr);
      return;
    }
    node_base *tail = left;
    while (tail->next)
      tail = tail->next;
    tail->next = exchange(right, nullptr);
  }

  FTL_NO_UNIQUE_ADDRESS Allocator allocator_;
  node_base head_{};
};

template <class I, class A = allocator<typename iterator_traits<I>::value_type>>
forward_list(I, I, A = A())
    -> forward_list<typename iterator_traits<I>::value_type, A>;
template <ranges::input_range R, class A = allocator<ranges::range_value_t<R>>>
forward_list(from_range_t, R &&, A = A())
    -> forward_list<ranges::range_value_t<R>, A>;
template <class T, class A>
bool operator==(const forward_list<T, A> &x, const forward_list<T, A> &y) {
  return equal(x.begin(), x.end(), y.begin(), y.end());
}
template <class T, class A>
auto operator<=>(const forward_list<T, A> &x, const forward_list<T, A> &y) {
  return lexicographical_compare_three_way(x.begin(), x.end(), y.begin(),
                                           y.end(),
                                           detail::forward_list_compare<T>{});
}
template <class T, class A>
void swap(forward_list<T, A> &x,
          forward_list<T, A> &y) noexcept(noexcept(x.swap(y))) {
  x.swap(y);
}
template <class T, class A, class U>
typename forward_list<T, A>::size_type erase(forward_list<T, A> &c,
                                             const U &value) {
  return c.remove(value);
}
template <class T, class A, class P>
typename forward_list<T, A>::size_type erase_if(forward_list<T, A> &c, P pred) {
  return c.remove_if(move(pred));
}
