namespace detail {
[[noreturn]] inline void flat_map_range_failure() {
#if FTL_HAS_EXCEPTIONS
  throw out_of_range("flat_map");
#else
  FTL_FLAT_MAP_TRAP();
#endif
}
template <class Key, class T, class Compare, class KeyContainer,
          class MappedContainer, bool Multi>
class flat_map_base {
public:
  using key_type = Key;
  using mapped_type = T;
  using value_type = pair<Key, T>;
  using key_compare = Compare;
  class value_compare {
    Compare compare_;
    friend class flat_map_base;
    explicit value_compare(Compare compare) : compare_(compare) {}

  public:
    bool operator()(const value_type &left, const value_type &right) const {
      return compare_(left.first, right.first);
    }
  };
  using reference = pair<const Key &, T &>;
  using const_reference = pair<const Key &, const T &>;
  using size_type = typename KeyContainer::size_type;
  using difference_type = typename KeyContainer::difference_type;
  struct containers {
    KeyContainer keys;
    MappedContainer values;
  };

  template <bool Constant> class basic_iterator {
    using owner_type =
        conditional_t<Constant, const flat_map_base, flat_map_base>;
    owner_type *owner_{};
    size_type index_{};
    basic_iterator(owner_type *owner, size_type index)
        : owner_(owner), index_(index) {}
    friend class flat_map_base;
    template <bool> friend class basic_iterator;

  public:
    using iterator_concept = random_access_iterator_tag;
    using iterator_category = random_access_iterator_tag;
    using value_type = pair<Key, T>;
    using difference_type = typename flat_map_base::difference_type;
    using reference =
        conditional_t<Constant, typename flat_map_base::const_reference,
                      typename flat_map_base::reference>;
    struct pointer {
      reference value;
      const reference *operator->() const { return &value; }
    };
    basic_iterator() = default;
    template <bool Other>
      requires(Constant && !Other)
    basic_iterator(const basic_iterator<Other> &other)
        : owner_(other.owner_), index_(other.index_) {}
    reference operator*() const {
      return {owner_->keys_[index_], owner_->values_[index_]};
    }
    pointer operator->() const { return {operator*()}; }
    basic_iterator &operator++() {
      ++index_;
      return *this;
    }
    basic_iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }
    basic_iterator &operator--() {
      --index_;
      return *this;
    }
    basic_iterator operator--(int) {
      auto copy = *this;
      --*this;
      return copy;
    }
    basic_iterator &operator+=(difference_type offset) {
      index_ += static_cast<size_type>(offset);
      return *this;
    }
    basic_iterator &operator-=(difference_type offset) {
      index_ -= static_cast<size_type>(offset);
      return *this;
    }
    basic_iterator operator+(difference_type offset) const {
      auto copy = *this;
      return copy += offset;
    }
    basic_iterator operator-(difference_type offset) const {
      auto copy = *this;
      return copy -= offset;
    }
    reference operator[](difference_type offset) const {
      return *(*this + offset);
    }
    template <bool Other>
    difference_type operator-(const basic_iterator<Other> &other) const {
      return static_cast<difference_type>(index_) -
             static_cast<difference_type>(other.index_);
    }
    template <bool Other>
    bool operator==(const basic_iterator<Other> &other) const {
      return index_ == other.index_;
    }
    template <bool Other>
    strong_ordering operator<=>(const basic_iterator<Other> &other) const {
      if (index_ < other.index_)
        return strong_ordering::less;
      if (index_ > other.index_)
        return strong_ordering::greater;
      return strong_ordering::equal;
    }
    friend basic_iterator operator+(difference_type offset,
                                    basic_iterator value) {
      return value += offset;
    }
  };
  using iterator = basic_iterator<false>;
  using const_iterator = basic_iterator<true>;
  using reverse_iterator = FTL_FLAT_NAMESPACE::reverse_iterator<iterator>;
  using const_reverse_iterator =
      FTL_FLAT_NAMESPACE::reverse_iterator<const_iterator>;

  flat_map_base() = default;
  explicit flat_map_base(const Compare &compare) : compare_(compare) {}
  template <input_iterator I>
  flat_map_base(I first, I last, const Compare &compare = Compare())
      : compare_(compare) {
    insert(first, last);
  }
  template <ranges::input_range R>
  flat_map_base(from_range_t, R &&range, const Compare &compare = Compare())
      : compare_(compare) {
    insert_range(static_cast<R &&>(range));
  }
  flat_map_base(initializer_list<value_type> values,
                const Compare &compare = Compare())
      : flat_map_base(values.begin(), values.end(), compare) {}
  flat_map_base(KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
      : keys_(move(keys)), values_(move(values)), compare_(compare) {
    normalize();
  }
  flat_map_base(sorted_unique_t, KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
    requires(!Multi)
      : keys_(move(keys)), values_(move(values)), compare_(compare) {}
  flat_map_base(sorted_equivalent_t, KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
    requires(Multi)
      : keys_(move(keys)), values_(move(values)), compare_(compare) {}
  flat_map_base &operator=(initializer_list<value_type> values) {
    clear();
    insert(values);
    return *this;
  }
  iterator begin() noexcept { return iterator(this, 0); }
  const_iterator begin() const noexcept { return const_iterator(this, 0); }
  iterator end() noexcept { return iterator(this, size()); }
  const_iterator end() const noexcept { return const_iterator(this, size()); }
  reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(begin());
  }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  const_reverse_iterator crbegin() const noexcept { return rbegin(); }
  const_reverse_iterator crend() const noexcept { return rend(); }
  [[nodiscard]] bool empty() const noexcept { return keys_.empty(); }
  size_type size() const noexcept { return keys_.size(); }
  size_type max_size() const noexcept {
    return keys_.max_size() < values_.max_size() ? keys_.max_size()
                                                 : values_.max_size();
  }
  template <class... Args> auto emplace(Args &&...args) {
    value_type value(forward<Args>(args)...);
    return insert(move(value));
  }
  template <class... Args>
  iterator emplace_hint(const_iterator, Args &&...args) {
    if constexpr (Multi)
      return emplace(forward<Args>(args)...);
    else
      return emplace(forward<Args>(args)...).first;
  }
  template <class Pair> auto insert(Pair &&value) {
    return insert_value(static_cast<Pair &&>(value));
  }
  template <class Pair> iterator insert(const_iterator, Pair &&value) {
    if constexpr (Multi)
      return insert(static_cast<Pair &&>(value));
    else
      return insert(static_cast<Pair &&>(value)).first;
  }
  template <input_iterator I> void insert(I first, I last) {
    for (; first != last; ++first)
      insert(*first);
  }
  template <ranges::input_range R> void insert_range(R &&range) {
    for (auto &&value : range)
      insert(static_cast<decltype(value) &&>(value));
  }
  void insert(initializer_list<value_type> values) {
    insert(values.begin(), values.end());
  }
  template <class... Args>
  pair<iterator, bool> try_emplace(const Key &key, Args &&...args)
    requires(!Multi)
  {
    auto found = lower_bound(key);
    if (found != end() && equivalent(found->first, key))
      return {found, false};
    return insert_at(found.index_, key, T(forward<Args>(args)...));
  }
  template <class... Args>
  pair<iterator, bool> try_emplace(Key &&key, Args &&...args)
    requires(!Multi)
  {
    auto found = lower_bound(key);
    if (found != end() && equivalent(found->first, key))
      return {found, false};
    return insert_at(found.index_, move(key), T(forward<Args>(args)...));
  }
  template <class... Args>
  iterator try_emplace(const_iterator, const Key &key, Args &&...args)
    requires(!Multi)
  {
    return try_emplace(key, forward<Args>(args)...).first;
  }
  template <class... Args>
  iterator try_emplace(const_iterator, Key &&key, Args &&...args)
    requires(!Multi)
  {
    return try_emplace(move(key), forward<Args>(args)...).first;
  }
  template <class M>
  pair<iterator, bool> insert_or_assign(const Key &key, M &&value)
    requires(!Multi)
  {
    auto found = find(key);
    if (found != end()) {
      found->second = static_cast<M &&>(value);
      return {found, false};
    }
    return try_emplace(key, static_cast<M &&>(value));
  }
  template <class M>
  pair<iterator, bool> insert_or_assign(Key &&key, M &&value)
    requires(!Multi)
  {
    auto found = find(key);
    if (found != end()) {
      found->second = static_cast<M &&>(value);
      return {found, false};
    }
    return try_emplace(move(key), static_cast<M &&>(value));
  }
  iterator erase(const_iterator position) {
    auto index = position.index_;
    keys_.erase(keys_.begin() + static_cast<difference_type>(index));
    values_.erase(values_.begin() + static_cast<difference_type>(index));
    return iterator(this, index);
  }
  iterator erase(const_iterator first, const_iterator last) {
    auto index = first.index_;
    keys_.erase(keys_.begin() + static_cast<difference_type>(index),
                keys_.begin() + static_cast<difference_type>(last.index_));
    values_.erase(values_.begin() + static_cast<difference_type>(index),
                  values_.begin() + static_cast<difference_type>(last.index_));
    return iterator(this, index);
  }
  size_type erase(const Key &key) {
    auto range = equal_range(key);
    auto count = static_cast<size_type>(range.second - range.first);
    erase(range.first, range.second);
    return count;
  }
  void
  swap(flat_map_base &other) noexcept(noexcept(keys_.swap(other.keys_)) &&
                                      noexcept(values_.swap(other.values_))) {
    keys_.swap(other.keys_);
    values_.swap(other.values_);
    FTL_FLAT_NAMESPACE::swap(compare_, other.compare_);
  }
  void clear() noexcept {
    keys_.clear();
    values_.clear();
  }
  template <class K> iterator find(const K &key) {
    auto found = lower_bound(key);
    return found != end() && equivalent(found->first, key) ? found : end();
  }
  template <class K> const_iterator find(const K &key) const {
    auto found = lower_bound(key);
    return found != end() && equivalent(found->first, key) ? found : end();
  }
  template <class K> size_type count(const K &key) const {
    auto range = equal_range(key);
    return static_cast<size_type>(range.second - range.first);
  }
  template <class K> bool contains(const K &key) const {
    return find(key) != end();
  }
  template <class K> iterator lower_bound(const K &key) {
    return iterator(this, lower_index(key));
  }
  template <class K> const_iterator lower_bound(const K &key) const {
    return const_iterator(this, lower_index(key));
  }
  template <class K> iterator upper_bound(const K &key) {
    return iterator(this, upper_index(key));
  }
  template <class K> const_iterator upper_bound(const K &key) const {
    return const_iterator(this, upper_index(key));
  }
  template <class K> pair<iterator, iterator> equal_range(const K &key) {
    return {lower_bound(key), upper_bound(key)};
  }
  template <class K>
  pair<const_iterator, const_iterator> equal_range(const K &key) const {
    return {lower_bound(key), upper_bound(key)};
  }
  key_compare key_comp() const { return compare_; }
  value_compare value_comp() const { return value_compare(compare_); }
  const KeyContainer &keys() const noexcept { return keys_; }
  const MappedContainer &values() const noexcept { return values_; }
  containers extract() && { return {move(keys_), move(values_)}; }
  void replace(KeyContainer &&keys, MappedContainer &&values) {
    keys_ = move(keys);
    values_ = move(values);
  }

protected:
  template <class Pair> auto insert_value(Pair &&value) {
    auto position = Multi ? upper_bound(value.first) : lower_bound(value.first);
    if constexpr (!Multi) {
      if (position != end() && equivalent(position->first, value.first))
        return pair<iterator, bool>{position, false};
      return insert_at(position.index_, static_cast<Pair &&>(value).first,
                       static_cast<Pair &&>(value).second);
    } else {
      auto result =
          insert_at(position.index_, static_cast<Pair &&>(value).first,
                    static_cast<Pair &&>(value).second);
      return result.first;
    }
  }
  template <class K, class M>
  pair<iterator, bool> insert_at(size_type index, K &&key, M &&mapped) {
    keys_.insert(keys_.begin() + static_cast<difference_type>(index),
                 static_cast<K &&>(key));
#if FTL_HAS_EXCEPTIONS
    try {
      values_.insert(values_.begin() + static_cast<difference_type>(index),
                     static_cast<M &&>(mapped));
    } catch (...) {
      keys_.erase(keys_.begin() + static_cast<difference_type>(index));
      throw;
    }
#else
    values_.insert(values_.begin() + static_cast<difference_type>(index),
                   static_cast<M &&>(mapped));
#endif
    return {iterator(this, index), true};
  }
  template <class K> size_type lower_index(const K &key) const {
    return static_cast<size_type>(
        FTL_FLAT_NAMESPACE::lower_bound(keys_.begin(), keys_.end(), key,
                                        compare_) -
        keys_.begin());
  }
  template <class K> size_type upper_index(const K &key) const {
    return static_cast<size_type>(
        FTL_FLAT_NAMESPACE::upper_bound(keys_.begin(), keys_.end(), key,
                                        compare_) -
        keys_.begin());
  }
  template <class L, class R>
  bool equivalent(const L &left, const R &right) const {
    return !compare_(left, right) && !compare_(right, left);
  }
  void normalize() {
    containers source{move(keys_), move(values_)};
    keys_.clear();
    values_.clear();
    for (size_type i = 0; i < source.keys.size(); ++i)
      insert(value_type(move(source.keys[i]), move(source.values[i])));
  }
  KeyContainer keys_{};
  MappedContainer values_{};
  FTL_NO_UNIQUE_ADDRESS Compare compare_{};
};
} // namespace detail
template <class Key, class T, class Compare = less<Key>,
          class KeyContainer = vector<Key>, class MappedContainer = vector<T>>
class flat_map : public detail::flat_map_base<Key, T, Compare, KeyContainer,
                                              MappedContainer, false> {
  using base = detail::flat_map_base<Key, T, Compare, KeyContainer,
                                     MappedContainer, false>;

public:
  using base::base;
  using base::operator=;
  using typename base::key_type;
  using typename base::mapped_type;
  mapped_type &operator[](const key_type &key) {
    return this->try_emplace(key).first->second;
  }
  mapped_type &operator[](key_type &&key) {
    return this->try_emplace(move(key)).first->second;
  }
  mapped_type &at(const key_type &key) {
    auto found = this->find(key);
    if (found == this->end())
      detail::flat_map_range_failure();
    return found->second;
  }
  const mapped_type &at(const key_type &key) const {
    auto found = this->find(key);
    if (found == this->end())
      detail::flat_map_range_failure();
    return found->second;
  }
};
template <class Key, class T, class Compare = less<Key>,
          class KeyContainer = vector<Key>, class MappedContainer = vector<T>>
class flat_multimap
    : public detail::flat_map_base<Key, T, Compare, KeyContainer,
                                   MappedContainer, true> {
  using base = detail::flat_map_base<Key, T, Compare, KeyContainer,
                                     MappedContainer, true>;

public:
  using base::base;
  using base::operator=;
};
template <class C> bool flat_map_equal(const C &left, const C &right) {
  return left.size() == right.size() &&
         equal(left.begin(), left.end(), right.begin());
}
template <class K, class T, class C, class KC, class MC>
bool operator==(const flat_map<K, T, C, KC, MC> &left,
                const flat_map<K, T, C, KC, MC> &right) {
  return flat_map_equal(left, right);
}
template <class K, class T, class C, class KC, class MC>
bool operator==(const flat_multimap<K, T, C, KC, MC> &left,
                const flat_multimap<K, T, C, KC, MC> &right) {
  return flat_map_equal(left, right);
}
template <class C> auto flat_map_compare(const C &left, const C &right) {
  return lexicographical_compare_three_way(left.begin(), left.end(),
                                           right.begin(), right.end(),
                                           compare_three_way{});
}
template <class K, class T, class C, class KC, class MC>
auto operator<=>(const flat_map<K, T, C, KC, MC> &left,
                 const flat_map<K, T, C, KC, MC> &right) {
  return flat_map_compare(left, right);
}
template <class K, class T, class C, class KC, class MC>
auto operator<=>(const flat_multimap<K, T, C, KC, MC> &left,
                 const flat_multimap<K, T, C, KC, MC> &right) {
  return flat_map_compare(left, right);
}
template <class K, class T, class C, class KC, class MC>
void swap(
    flat_map<K, T, C, KC, MC> &left,
    flat_map<K, T, C, KC, MC> &right) noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}
template <class K, class T, class C, class KC, class MC>
void swap(flat_multimap<K, T, C, KC, MC> &left,
          flat_multimap<K, T, C, KC, MC>
              &right) noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}
template <class C, class P>
typename C::size_type flat_map_erase_if(C &values, P predicate) {
  typename C::size_type count{};
  for (auto current = values.begin(); current != values.end();)
    if (predicate(*current)) {
      current = values.erase(current);
      ++count;
    } else
      ++current;
  return count;
}
template <class K, class T, class C, class KC, class MC, class P>
typename flat_map<K, T, C, KC, MC>::size_type
erase_if(flat_map<K, T, C, KC, MC> &values, P predicate) {
  return flat_map_erase_if(values, move(predicate));
}
template <class K, class T, class C, class KC, class MC, class P>
typename flat_multimap<K, T, C, KC, MC>::size_type
erase_if(flat_multimap<K, T, C, KC, MC> &values, P predicate) {
  return flat_map_erase_if(values, move(predicate));
}
