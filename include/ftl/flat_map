    requires(!Multi && flat_transparent_compare<Compare> &&
             is_constructible_v<Key, K &&>)
  {
    return try_emplace(static_cast<K &&>(key), forward<Args>(args)...).first;
  }
  template <class M>
  pair<iterator, bool> insert_or_assign(const Key &key, M &&value)
    requires(!Multi)
  {
    auto found = find(key);
    if (found != end()) {
      found->second = static_cast<M &&>(value);
      return {found, false};
    }
    return try_emplace(key, static_cast<M &&>(value));
  }
  template <class M>
  pair<iterator, bool> insert_or_assign(Key &&key, M &&value)
    requires(!Multi)
  {
