protected:
  template <input_iterator I>
  void insert_bulk(I first, I last, bool incoming_is_sorted) {
    const auto old_size = keys_.size();
    append_sorted(first, last);
    containers source{move(keys_), move(values_)};
    vector<size_type> incoming;
    incoming.reserve(source.keys.size() - old_size);
    for (size_type index = old_size; index < source.keys.size(); ++index)
      incoming.push_back(index);
    if (!incoming_is_sorted)
      FTL_FLAT_NAMESPACE::sort(incoming.begin(), incoming.end(),
                               [&](size_type left, size_type right) {
                                 return compare_(source.keys[left],
                                                 source.keys[right]);
                               });
    if constexpr (requires { keys_.reserve(source.keys.size()); })
      keys_.reserve(source.keys.size());
    if constexpr (requires { values_.reserve(source.values.size()); })
      values_.reserve(source.values.size());

    size_type left = 0;
    auto right = incoming.begin();
    const auto append = [this, &source](size_type index) {
      if constexpr (!Multi)
        if (!keys_.empty() && equivalent(keys_.back(), source.keys[index]))
          return;
      keys_.push_back(move(source.keys[index]));
      values_.push_back(move(source.values[index]));
    };
    while (left != old_size && right != incoming.end()) {
      if (compare_(source.keys[*right], source.keys[left]))
        append(*right++);
      else
        append(left++);
    }
    while (left != old_size)
      append(left++);
    while (right != incoming.end())
      append(*right++);
  }
  template <input_iterator I> void append_sorted(I first, I last) {
    for (; first != last; ++first) {
      keys_.push_back((*first).first);
      values_.push_back((*first).second);
    }
  }
  template <class Pair> auto insert_value(Pair &&value) {
    auto position = Multi ? upper_bound(value.first) : lower_bound(value.first);
    if constexpr (!Multi) {
      if (position != end() && equivalent(position->first, value.first))
        return pair<iterator, bool>{position, false};
      return insert_at(position.index_, static_cast<Pair &&>(value).first,
                       static_cast<Pair &&>(value).second);
    } else {
      auto result =
          insert_at(position.index_, static_cast<Pair &&>(value).first,
                    static_cast<Pair &&>(value).second);
      return result.first;
    }
  }
  template <class K, class M>
  pair<iterator, bool> insert_at(size_type index, K &&key, M &&mapped) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      keys_.insert(keys_.begin() + static_cast<difference_type>(index),
                   static_cast<K &&>(key));
      values_.insert(values_.begin() + static_cast<difference_type>(index),
                     static_cast<M &&>(mapped));
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      clear();
      throw;
    }
#endif
    return {iterator(this, index), true};
  }
  template <class K> size_type lower_index(const K &key) const {
    return static_cast<size_type>(
        FTL_FLAT_NAMESPACE::lower_bound(keys_.begin(), keys_.end(), key,
                                        compare_) -
        keys_.begin());
  }
  template <class K> size_type upper_index(const K &key) const {
    return static_cast<size_type>(
        FTL_FLAT_NAMESPACE::upper_bound(keys_.begin(), keys_.end(), key,
                                        compare_) -
        keys_.begin());
  }
  template <class L, class R>
  bool equivalent(const L &left, const R &right) const {
    return !compare_(left, right) && !compare_(right, left);
  }
  void normalize() {
    containers source{move(keys_), move(values_)};
    vector<size_type> order;
    order.reserve(source.keys.size());
    for (size_type i = 0; i < source.keys.size(); ++i)
      order.push_back(i);
    if (!FTL_FLAT_NAMESPACE::is_sorted(source.keys.begin(), source.keys.end(),
                                       compare_))
      FTL_FLAT_NAMESPACE::sort(
          order.begin(), order.end(), [&](size_type left, size_type right) {
            return compare_(source.keys[left], source.keys[right]);
          });
    if constexpr (requires { keys_.reserve(source.keys.size()); })
      keys_.reserve(source.keys.size());
    if constexpr (requires { values_.reserve(source.values.size()); })
      values_.reserve(source.values.size());
    for (size_type index : order) {
      if constexpr (!Multi)
        if (!keys_.empty() && equivalent(keys_.back(), source.keys[index]))
          continue;
      keys_.push_back(move(source.keys[index]));
      values_.push_back(move(source.values[index]));
    }
  }
  KeyContainer keys_{};
  MappedContainer values_{};
  FTL_NO_UNIQUE_ADDRESS Compare compare_{};
};
