  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(initializer_list<value_type> values, const Compare &compare,
                const Allocator &allocator)
      : flat_map_base(values.begin(), values.end(), compare, allocator) {}
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(initializer_list<value_type> values, const Allocator &allocator)
      : flat_map_base(values, Compare(), allocator) {}
  flat_map_base(KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
      : keys_(move(keys)), values_(move(values)), compare_(compare) {
    normalize();
  }
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(const KeyContainer &keys, const MappedContainer &values,
                const Compare &compare, const Allocator &allocator)
      : keys_(keys, allocator), values_(values, allocator), compare_(compare) {
    normalize();
  }
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(const KeyContainer &keys, const MappedContainer &values,
                const Allocator &allocator)
      : flat_map_base(keys, values, Compare(), allocator) {}
  flat_map_base(sorted_unique_t, KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
    requires(!Multi)
      : keys_(move(keys)), values_(move(values)), compare_(compare) {}
  flat_map_base(sorted_equivalent_t, KeyContainer keys, MappedContainer values,
                const Compare &compare = Compare())
    requires(Multi)
      : keys_(move(keys)), values_(move(values)), compare_(compare) {}
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(sorted_unique_t, const KeyContainer &keys,
                const MappedContainer &values, const Compare &compare,
                const Allocator &allocator)
    requires(!Multi)
      : keys_(keys, allocator), values_(values, allocator), compare_(compare) {}
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(sorted_unique_t tag, const KeyContainer &keys,
                const MappedContainer &values, const Allocator &allocator)
    requires(!Multi)
      : flat_map_base(tag, keys, values, Compare(), allocator) {}
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(sorted_equivalent_t, const KeyContainer &keys,
                const MappedContainer &values, const Compare &compare,
                const Allocator &allocator)
    requires(Multi)
      : keys_(keys, allocator), values_(values, allocator), compare_(compare) {}
  template <class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator>)
  flat_map_base(sorted_equivalent_t tag, const KeyContainer &keys,
                const MappedContainer &values, const Allocator &allocator)
    requires(Multi)
      : flat_map_base(tag, keys, values, Compare(), allocator) {}
  template <input_iterator I>
  flat_map_base(sorted_unique_t, I first, I last,
                const Compare &compare = Compare())
    requires(!Multi)
      : compare_(compare) {
    append_sorted(first, last);
  }
  template <input_iterator I>
  flat_map_base(sorted_equivalent_t, I first, I last,
                const Compare &compare = Compare())
    requires(Multi)
      : compare_(compare) {
    append_sorted(first, last);
  }
  template <class Tag, input_iterator I, class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_map_base(Tag, I first, I last, const Compare &compare,
                const Allocator &allocator)
      : keys_(allocator), values_(allocator), compare_(compare) {
    append_sorted(first, last);
  }
  template <class Tag, input_iterator I, class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_map_base(Tag tag, I first, I last, const Allocator &allocator)
      : flat_map_base(tag, first, last, Compare(), allocator) {}
  flat_map_base(sorted_unique_t tag, initializer_list<value_type> values,
                const Compare &compare = Compare())
    requires(!Multi)
      : flat_map_base(tag, values.begin(), values.end(), compare) {}
  flat_map_base(sorted_equivalent_t tag, initializer_list<value_type> values,
                const Compare &compare = Compare())
    requires(Multi)
      : flat_map_base(tag, values.begin(), values.end(), compare) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_map_base(Tag tag, initializer_list<value_type> values,
                const Compare &compare, const Allocator &allocator)
      : flat_map_base(tag, values.begin(), values.end(), compare, allocator) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<KeyContainer, Allocator> &&
             uses_allocator_v<MappedContainer, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_map_base(Tag tag, initializer_list<value_type> values,
                const Allocator &allocator)
      : flat_map_base(tag, values, Compare(), allocator) {}
  flat_map_base(const flat_map_base &) = default;
  flat_map_base(flat_map_base &&) = default;
  flat_map_base &operator=(const flat_map_base &other) {
    if (this == &other)
      return *this;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      keys_ = other.keys_;
      values_ = other.values_;
      compare_ = other.compare_;
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      clear();
      throw;
    }
#endif
    return *this;
  }
  flat_map_base &operator=(flat_map_base &&other) noexcept(
      is_nothrow_move_assignable_v<KeyContainer> &&
      is_nothrow_move_assignable_v<MappedContainer> &&
      is_nothrow_move_assignable_v<Compare>) {
    if (this == &other)
      return *this;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      keys_ = move(other.keys_);
      values_ = move(other.values_);
      compare_ = move(other.compare_);
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      clear();
      throw;
    }
#endif
    return *this;
  }
  flat_map_base &operator=(initializer_list<value_type> values) {
    clear();
    insert(values);
    return *this;
  }
  iterator begin() noexcept { return iterator(this, 0); }
  const_iterator begin() const noexcept { return const_iterator(this, 0); }
  iterator end() noexcept { return iterator(this, size()); }
  const_iterator end() const noexcept { return const_iterator(this, size()); }
  reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(begin());
  }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  const_reverse_iterator crbegin() const noexcept { return rbegin(); }
  const_reverse_iterator crend() const noexcept { return rend(); }
  [[nodiscard]] bool empty() const noexcept { return keys_.empty(); }
  size_type size() const noexcept { return keys_.size(); }
  size_type max_size() const noexcept {
    return keys_.max_size() < values_.max_size() ? keys_.max_size()
                                                 : values_.max_size();
  }
  template <class... Args> auto emplace(Args &&...args) {
    value_type value(forward<Args>(args)...);
    return insert(move(value));
  }
  template <class... Args>
  iterator emplace_hint(const_iterator, Args &&...args) {
    if constexpr (Multi)
      return emplace(forward<Args>(args)...);
    else
      return emplace(forward<Args>(args)...).first;
  }
  template <class Pair> auto insert(Pair &&value) {
    return insert_value(static_cast<Pair &&>(value));
  }
  template <class Pair> iterator insert(const_iterator, Pair &&value) {
    if constexpr (Multi)
      return insert(static_cast<Pair &&>(value));
    else
      return insert(static_cast<Pair &&>(value)).first;
  }
  template <input_iterator I> void insert(I first, I last) {
    insert_bulk(first, last, false);
  }
  template <class Tag, input_iterator I>
    requires((is_same_v<Tag, sorted_unique_t> && !Multi) ||
             (is_same_v<Tag, sorted_equivalent_t> && Multi))
  void insert(Tag, I first, I last) {
    insert_bulk(first, last, true);
  }
  template <ranges::input_range R> void insert_range(R &&range) {
    insert(ranges::begin(range), ranges::end(range));
  }
  void insert(initializer_list<value_type> values) {
    insert(values.begin(), values.end());
  }
  void insert(sorted_unique_t tag, initializer_list<value_type> values)
    requires(!Multi)
  {
    insert(tag, values.begin(), values.end());
  }
  void insert(sorted_equivalent_t tag, initializer_list<value_type> values)
    requires(Multi)
  {
    insert(tag, values.begin(), values.end());
  }
  template <class... Args>
  pair<iterator, bool> try_emplace(const Key &key, Args &&...args)
    requires(!Multi)
  {
    auto found = lower_bound(key);
    if (found != end() && equivalent(found->first, key))
      return {found, false};
    return insert_at(found.index_, key, T(forward<Args>(args)...));
  }
  template <class... Args>
  pair<iterator, bool> try_emplace(Key &&key, Args &&...args)
    requires(!Multi)
  {
    auto found = lower_bound(key);
    if (found != end() && equivalent(found->first, key))
      return {found, false};
    return insert_at(found.index_, move(key), T(forward<Args>(args)...));
  }
  template <class K, class... Args>
  pair<iterator, bool> try_emplace(K &&key, Args &&...args)
    requires(!Multi && flat_transparent_compare<Compare> &&
             is_constructible_v<Key, K &&>)
  {
    auto found = lower_bound(key);
    if (found != end() && equivalent(found->first, key))
      return {found, false};
    return insert_at(found.index_, static_cast<K &&>(key),
                     T(forward<Args>(args)...));
  }
  template <class... Args>
  iterator try_emplace(const_iterator, const Key &key, Args &&...args)
    requires(!Multi)
  {
    return try_emplace(key, forward<Args>(args)...).first;
  }
  template <class... Args>
  iterator try_emplace(const_iterator, Key &&key, Args &&...args)
    requires(!Multi)
  {
    return try_emplace(move(key), forward<Args>(args)...).first;
  }
  template <class K, class... Args>
