FTL_BEGIN_NAMESPACE

inline constexpr size_t dynamic_extent = numeric_limits<size_t>::max();

template <class ElementType, size_t Extent = dynamic_extent> class span;

namespace ranges {

template <class ElementType, size_t Extent>
inline constexpr bool enable_view<span<ElementType, Extent>> = true;

template <class ElementType, size_t Extent>
inline constexpr bool enable_borrowed_range<span<ElementType, Extent>> = true;

} // namespace ranges

namespace detail {

template <class> inline constexpr bool span_is_specialization_v = false;

template <class ElementType, size_t Extent>
inline constexpr bool span_is_specialization_v<span<ElementType, Extent>> =
    true;

template <class> inline constexpr bool span_is_array_specialization_v = false;

template <class ElementType, size_t Size>
inline constexpr bool span_is_array_specialization_v<array<ElementType, Size>> =
    true;

template <class From, class To>
inline constexpr bool span_array_convertible_v =
    is_convertible_v<From (*)[], To (*)[]>;

template <class Pointer, size_t Extent> class span_storage {
public:
  constexpr span_storage() noexcept = default;

  constexpr span_storage(Pointer pointer, size_t) noexcept
      : pointer_(pointer) {}

  [[nodiscard]]
  constexpr Pointer data() const noexcept {
    return pointer_;
  }

  [[nodiscard]]
  static constexpr size_t size() noexcept {
    return Extent;
  }

private:
  Pointer pointer_ = nullptr;
};

template <class Pointer> class span_storage<Pointer, dynamic_extent> {
public:
  constexpr span_storage() noexcept = default;

  constexpr span_storage(Pointer pointer, size_t size) noexcept
      : pointer_(pointer), size_(size) {}

  [[nodiscard]]
  constexpr Pointer data() const noexcept {
    return pointer_;
  }

  [[nodiscard]]
  constexpr size_t size() const noexcept {
    return size_;
  }

private:
  Pointer pointer_ = nullptr;
  size_t size_ = 0;
};

template <size_t Extent, size_t Offset, size_t Count>
inline constexpr size_t span_subspan_extent_v =
    Count != dynamic_extent    ? Count
    : Extent != dynamic_extent ? Extent - Offset
                               : dynamic_extent;
} // namespace detail

template <class ElementType, size_t Extent> class span {
  static_assert(is_object_v<ElementType>);
  static_assert(!is_abstract_v<ElementType>);
  static_assert(sizeof(ElementType) != 0);

  template <class, size_t> friend class span;

public:
  using element_type = ElementType;
  using value_type = remove_cv_t<ElementType>;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using pointer = element_type *;
  using const_pointer = const element_type *;
  using reference = element_type &;
  using const_reference = const element_type &;

  using iterator = pointer;
  using const_iterator = FTL_SPAN_NAMESPACE::const_iterator<iterator>;
  using reverse_iterator = FTL_SPAN_NAMESPACE::reverse_iterator<iterator>;
  using const_reverse_iterator =
      FTL_SPAN_NAMESPACE::const_iterator<reverse_iterator>;

  static constexpr size_type extent = Extent;

private:
  using storage_type = detail::span_storage<pointer, Extent>;

public:
  constexpr span() noexcept
    requires(Extent == 0 || Extent == dynamic_extent)
  = default;

  template <class Iterator>
    requires(contiguous_iterator<Iterator> &&
             detail::span_array_convertible_v<
                 remove_reference_t<iter_reference_t<Iterator>>, element_type>)
  constexpr explicit(Extent != dynamic_extent)
      span(Iterator first, size_type count)
      : storage_(FTL_SPAN_NAMESPACE::to_address(first), count) {}

  template <class Iterator, class End>
    requires(contiguous_iterator<Iterator> &&
             sized_sentinel_for<End, Iterator> &&
             !is_convertible_v<End, size_type> &&
             detail::span_array_convertible_v<
                 remove_reference_t<iter_reference_t<Iterator>>, element_type>)
  constexpr explicit(Extent != dynamic_extent)
      span(Iterator first, End last)
      : span(first, static_cast<size_type>(last - first)) {}

  template <size_t Size>
    requires(Extent == dynamic_extent || Extent == Size)
  constexpr span(type_identity_t<element_type> (&values)[Size]) noexcept
      : storage_(values, Size) {}

  template <class OtherElement, size_t Size>
    requires((Extent == dynamic_extent || Extent == Size) &&
             detail::span_array_convertible_v<OtherElement, element_type>)
  constexpr span(array<OtherElement, Size> &values) noexcept
      : storage_(values.data(), Size) {}

  template <class OtherElement, size_t Size>
    requires((Extent == dynamic_extent || Extent == Size) &&
             detail::span_array_convertible_v<const OtherElement, element_type>)
  constexpr span(const array<OtherElement, Size> &values) noexcept
      : storage_(values.data(), Size) {}

  template <class Range>
    requires(
        ranges::contiguous_range<Range> && ranges::sized_range<Range> &&
        (ranges::borrowed_range<Range> || is_const_v<element_type>) &&
        !detail::span_is_specialization_v<remove_cvref_t<Range>> &&
        !detail::span_is_array_specialization_v<remove_cvref_t<Range>> &&
        !is_array_v<remove_cvref_t<Range>> &&
        detail::span_array_convertible_v<
            remove_reference_t<ranges::range_reference_t<Range>>, element_type>)
  constexpr explicit(Extent != dynamic_extent) span(Range &&range)
      : span(ranges::data(range), ranges::size(range)) {}

  constexpr span(const span &) noexcept = default;

  template <class OtherElement, size_t OtherExtent>
    requires((Extent == dynamic_extent || OtherExtent == dynamic_extent ||
              Extent == OtherExtent) &&
             detail::span_array_convertible_v<OtherElement, element_type>)
  constexpr explicit(Extent != dynamic_extent && OtherExtent == dynamic_extent)
      span(const span<OtherElement, OtherExtent> &other) noexcept
      : storage_(other.data(), other.size()) {}

  ~span() noexcept = default;

  constexpr span &operator=(const span &) noexcept = default;

  template <size_t Count>
  [[nodiscard]]
  constexpr span<element_type, Count> first() const {
    static_assert(Extent == dynamic_extent || Count <= Extent);

    return span<element_type, Count>(data(), Count);
  }

  template <size_t Count>
  [[nodiscard]]
  constexpr span<element_type, Count> last() const {
    static_assert(Extent == dynamic_extent || Count <= Extent);

    return span<element_type, Count>(data() + (size() - Count), Count);
  }

  template <size_t Offset, size_t Count = dynamic_extent>
  [[nodiscard]]
  constexpr span<element_type,
                 detail::span_subspan_extent_v<Extent, Offset, Count>>
  subspan() const {
    static_assert(Extent == dynamic_extent || Offset <= Extent);

    static_assert(Count == dynamic_extent || Extent == dynamic_extent ||
                  Count <= Extent - Offset);

    constexpr size_t result_extent =
        detail::span_subspan_extent_v<Extent, Offset, Count>;

    const size_type result_size =
        Count == dynamic_extent ? size() - Offset : Count;

    return span<element_type, result_extent>(data() + Offset, result_size);
  }

  [[nodiscard]]
  constexpr span<element_type, dynamic_extent>
  first(size_type count) const {
    return span<element_type, dynamic_extent>(data(), count);
  }

  [[nodiscard]]
  constexpr span<element_type, dynamic_extent>
  last(size_type count) const {
    return span<element_type, dynamic_extent>(data() + (size() - count), count);
  }

  [[nodiscard]]
  constexpr span<element_type, dynamic_extent>
  subspan(size_type offset, size_type count = dynamic_extent) const {
    const size_type result_size =
        count == dynamic_extent ? size() - offset : count;

    return span<element_type, dynamic_extent>(data() + offset, result_size);
  }

  [[nodiscard]]
  constexpr size_type size() const noexcept {
    return storage_.size();
  }

  [[nodiscard]]
  constexpr size_type size_bytes() const noexcept {
    return size() * sizeof(element_type);
  }

  [[nodiscard]]
  constexpr bool empty() const noexcept {
    return size() == 0;
  }

  [[nodiscard]]
  constexpr reference operator[](size_type index) const {
    return data()[index];
  }

  [[nodiscard]]
  constexpr reference front() const {
    return data()[0];
  }

  [[nodiscard]]
  constexpr reference back() const {
    return data()[size() - 1];
  }

  [[nodiscard]]
  constexpr pointer data() const noexcept {
    return storage_.data();
  }

  [[nodiscard]]
  constexpr iterator begin() const noexcept {
    return data();
  }

  [[nodiscard]]
  constexpr iterator end() const noexcept {
    return data() + size();
  }

  [[nodiscard]]
  constexpr const_iterator cbegin() const noexcept {
    return const_iterator(begin());
  }

  [[nodiscard]]
  constexpr const_iterator cend() const noexcept {
    return const_iterator(end());
  }

  [[nodiscard]]
  constexpr reverse_iterator rbegin() const noexcept {
    return reverse_iterator(end());
  }

  [[nodiscard]]
  constexpr reverse_iterator rend() const noexcept {
    return reverse_iterator(begin());
  }

  [[nodiscard]]
  constexpr const_reverse_iterator crbegin() const noexcept {
    return const_reverse_iterator(rbegin());
  }

  [[nodiscard]]
  constexpr const_reverse_iterator crend() const noexcept {
    return const_reverse_iterator(rend());
  }

private:
  storage_type storage_{};
};

template <class Iterator, class EndOrSize>
span(Iterator, EndOrSize)
    -> span<remove_reference_t<iter_reference_t<Iterator>>>;

template <class ElementType, size_t Size>
span(ElementType (&)[Size]) -> span<ElementType, Size>;

template <class ElementType, size_t Size>
span(array<ElementType, Size> &) -> span<ElementType, Size>;

template <class ElementType, size_t Size>
span(const array<ElementType, Size> &) -> span<const ElementType, Size>;

template <ranges::contiguous_range Range>
span(Range &&) -> span<remove_reference_t<ranges::range_reference_t<Range>>>;

template <class ElementType, size_t Extent>
  requires(!is_volatile_v<ElementType>)
[[nodiscard]]
constexpr span<const byte, Extent == dynamic_extent
                               ? dynamic_extent
                               : sizeof(ElementType) * Extent>
as_bytes(span<ElementType, Extent> source) noexcept {
  constexpr size_t result_extent =
      Extent == dynamic_extent ? dynamic_extent : sizeof(ElementType) * Extent;

  return span<const byte, result_extent>(
      reinterpret_cast<const byte *>(source.data()), source.size_bytes());
}

template <class ElementType, size_t Extent>
  requires(!is_const_v<ElementType> && !is_volatile_v<ElementType>)
[[nodiscard]]
constexpr span<byte, Extent == dynamic_extent ? dynamic_extent
                                              : sizeof(ElementType) * Extent>
as_writable_bytes(span<ElementType, Extent> source) noexcept {
  constexpr size_t result_extent =
      Extent == dynamic_extent ? dynamic_extent : sizeof(ElementType) * Extent;

  return span<byte, result_extent>(reinterpret_cast<byte *>(source.data()),
                                   source.size_bytes());
}

FTL_END_NAMESPACE

