};

template<class T, class U>
inline constexpr bool pair_dangles_v =
#if FTL_HAS_REFERENCE_CONSTRUCTS_FROM_TEMPORARY
    reference_constructs_from_temporary_v<T, U>;
#else
    false;
#endif

template<class T>
concept comparison_integer =
    is_integral_v<T> &&
    !is_same_v<remove_cv_t<T>, bool> &&
    !is_same_v<remove_cv_t<T>, char> &&
    !is_same_v<remove_cv_t<T>, wchar_t> &&
    !is_same_v<remove_cv_t<T>, char8_t> &&
    !is_same_v<remove_cv_t<T>, char16_t> &&
    !is_same_v<remove_cv_t<T>, char32_t> &&
    requires { typename make_unsigned<T>::type; };

template<class T, class U>
    requires three_way_comparable_with<T, U> ||
             requires(const T& left, const U& right) {
                 bool(left < right);
                 bool(right < left);
             }
constexpr auto synth_three_way(const T& left, const U& right) {
    if constexpr (three_way_comparable_with<T, U>) {
        return compare_three_way{}(left, right);
    } else {
        if (left < right) {
            return weak_ordering::less;
        }
        if (right < left) {
            return weak_ordering::greater;
        }
        return weak_ordering::equivalent;
    }
}

template<class T, class U>
using synth_three_way_result_t =
    decltype(synth_three_way(declval<T&>(), declval<U&>()));

template<class T, class U>
constexpr void adl_swap(T&& left, U&& right)
    noexcept(noexcept(swap(static_cast<T&&>(left), static_cast<U&&>(right)))) {
    swap(static_cast<T&&>(left), static_cast<U&&>(right));
}
}

template<class First, class Second>
struct pair {
    using first_type = First;
    using second_type = Second;

    First first;
    Second second;

    constexpr explicit(!detail::implicitly_default_constructible<First> ||
                       !detail::implicitly_default_constructible<Second>)
    pair() requires (is_default_constructible_v<First> &&
                     is_default_constructible_v<Second>)
        : first(), second() {}

    constexpr explicit(!is_convertible_v<const First&, First> ||
                       !is_convertible_v<const Second&, Second>)
    pair(const First& first_value, const Second& second_value)
        requires (is_copy_constructible_v<First> &&
                  is_copy_constructible_v<Second>)
        : first(first_value), second(second_value) {}

    template<class U1 = First, class U2 = Second>
    constexpr explicit(!is_convertible_v<U1, First> ||
                       !is_convertible_v<U2, Second>)
    pair(U1&& first_value, U2&& second_value)
        requires (is_constructible_v<First, U1> &&
                  is_constructible_v<Second, U2> &&
                  !detail::pair_dangles_v<First, U1&&> &&
                  !detail::pair_dangles_v<Second, U2&&>)
        : first(forward<U1>(first_value)), second(forward<U2>(second_value)) {}

    template<class U1 = First, class U2 = Second>
    pair(U1&&, U2&&)
        requires (is_constructible_v<First, U1> &&
                  is_constructible_v<Second, U2> &&
                  (detail::pair_dangles_v<First, U1&&> ||
                   detail::pair_dangles_v<Second, U2&&>)) = delete;

    pair(const pair&) = default;
    pair(pair&&) = default;

    template<class U1, class U2>
    constexpr explicit(!is_convertible_v<U1&, First> ||
                       !is_convertible_v<U2&, Second>)
    pair(pair<U1, U2>& other)
        requires (is_constructible_v<First, U1&> &&
                  is_constructible_v<Second, U2&> &&
                  !detail::pair_dangles_v<First, U1&> &&
                  !detail::pair_dangles_v<Second, U2&>)
        : first(other.first), second(other.second) {}

    template<class U1, class U2>
    pair(pair<U1, U2>&)
        requires (is_constructible_v<First, U1&> &&
                  is_constructible_v<Second, U2&> &&
                  (detail::pair_dangles_v<First, U1&> ||
                   detail::pair_dangles_v<Second, U2&>)) = delete;

    template<class U1, class U2>
    constexpr explicit(!is_convertible_v<const U1&, First> ||
                       !is_convertible_v<const U2&, Second>)
    pair(const pair<U1, U2>& other)
        requires (is_constructible_v<First, const U1&> &&
                  is_constructible_v<Second, const U2&> &&
                  !detail::pair_dangles_v<First, const U1&> &&
                  !detail::pair_dangles_v<Second, const U2&>)
        : first(other.first), second(other.second) {}

    template<class U1, class U2>
    pair(const pair<U1, U2>&)
        requires (is_constructible_v<First, const U1&> &&
                  is_constructible_v<Second, const U2&> &&
                  (detail::pair_dangles_v<First, const U1&> ||
                   detail::pair_dangles_v<Second, const U2&>)) = delete;

    template<class U1, class U2>
    constexpr explicit(!is_convertible_v<U1, First> ||
                       !is_convertible_v<U2, Second>)
    pair(pair<U1, U2>&& other)
        requires (is_constructible_v<First, U1> &&
                  is_constructible_v<Second, U2> &&
                  !detail::pair_dangles_v<First, U1&&> &&
                  !detail::pair_dangles_v<Second, U2&&>)
        : first(forward<U1>(other.first)), second(forward<U2>(other.second)) {}

    template<class U1, class U2>
    pair(pair<U1, U2>&&)
        requires (is_constructible_v<First, U1> &&
                  is_constructible_v<Second, U2> &&
                  (detail::pair_dangles_v<First, U1&&> ||
                   detail::pair_dangles_v<Second, U2&&>)) = delete;

    template<class U1, class U2>
    constexpr explicit(!is_convertible_v<const U1&&, First> ||
                       !is_convertible_v<const U2&&, Second>)
    pair(const pair<U1, U2>&& other)
        requires (is_constructible_v<First, const U1&&> &&
                  is_constructible_v<Second, const U2&&> &&
                  !detail::pair_dangles_v<First, const U1&&> &&
                  !detail::pair_dangles_v<Second, const U2&&>)
        : first(forward<const U1>(other.first)),
          second(forward<const U2>(other.second)) {}

    template<class U1, class U2>
    pair(const pair<U1, U2>&&)
        requires (is_constructible_v<First, const U1&&> &&
                  is_constructible_v<Second, const U2&&> &&
                  (detail::pair_dangles_v<First, const U1&&> ||
                   detail::pair_dangles_v<Second, const U2&&>)) = delete;

    template<detail::pair_like P>
    constexpr explicit(
        !is_convertible_v<decltype(get<0>(declval<P>())), First> ||
        !is_convertible_v<decltype(get<1>(declval<P>())), Second>)
    pair(P&& other)
        requires (is_constructible_v<First,
                      decltype(get<0>(declval<P>()))> &&
                  is_constructible_v<Second,
                      decltype(get<1>(declval<P>()))> &&
                  !detail::pair_dangles_v<First,
                      decltype(get<0>(declval<P>()))> &&
                  !detail::pair_dangles_v<Second,
                      decltype(get<1>(declval<P>()))>)
        : first(get<0>(forward<P>(other))),
          second(get<1>(forward<P>(other))) {}

    template<detail::pair_like P>
    pair(P&&)
        requires (is_constructible_v<First,
                      decltype(get<0>(declval<P>()))> &&
                  is_constructible_v<Second,
                      decltype(get<1>(declval<P>()))> &&
                  (detail::pair_dangles_v<First,
                       decltype(get<0>(declval<P>()))> ||
                   detail::pair_dangles_v<Second,
                       decltype(get<1>(declval<P>()))>)) = delete;

    template<class... Args1, class... Args2>
    constexpr pair(piecewise_construct_t, tuple<Args1...> first_args,
                   tuple<Args2...> second_args)
        : pair(piecewise_construct, first_args, second_args,
               index_sequence_for<Args1...>{},
               index_sequence_for<Args2...>{}) {}

    constexpr pair& operator=(const pair& other)
        requires (is_copy_assignable_v<First> && is_copy_assignable_v<Second>) {
        first = other.first;
        second = other.second;
        return *this;
    }

    constexpr const pair& operator=(const pair& other) const
        requires (is_assignable_v<const First&, const First&> &&
                  is_assignable_v<const Second&, const Second&>) {
        first = other.first;
        second = other.second;
        return *this;
    }

    constexpr pair& operator=(pair&& other)
        noexcept(is_nothrow_move_assignable_v<First> &&
                 is_nothrow_move_assignable_v<Second>)
        requires (is_move_assignable_v<First> && is_move_assignable_v<Second>) {
        first = forward<First>(other.first);
        second = forward<Second>(other.second);
        return *this;
    }

    constexpr const pair& operator=(pair&& other) const
        requires (is_assignable_v<const First&, First> &&
                  is_assignable_v<const Second&, Second>) {
        first = forward<First>(other.first);
        second = forward<Second>(other.second);
        return *this;
    }

    template<class U1, class U2>
    constexpr pair& operator=(const pair<U1, U2>& other)
        requires (is_assignable_v<First&, const U1&> &&
                  is_assignable_v<Second&, const U2&>) {
        first = other.first;
        second = other.second;
        return *this;
    }

    template<class U1, class U2>
    constexpr const pair& operator=(const pair<U1, U2>& other) const
        requires (is_assignable_v<const First&, const U1&> &&
                  is_assignable_v<const Second&, const U2&>) {
        first = other.first;
        second = other.second;
        return *this;
    }

    template<class U1, class U2>
    constexpr pair& operator=(pair<U1, U2>&& other)
        requires (is_assignable_v<First&, U1> &&
                  is_assignable_v<Second&, U2>) {
        first = forward<U1>(other.first);
        second = forward<U2>(other.second);
        return *this;
    }

    template<class U1, class U2>
    constexpr const pair& operator=(pair<U1, U2>&& other) const
        requires (is_assignable_v<const First&, U1> &&
                  is_assignable_v<const Second&, U2>) {
        first = forward<U1>(other.first);
        second = forward<U2>(other.second);
        return *this;
    }

    template<detail::pair_like P>
    constexpr pair& operator=(P&& other)
        requires (is_assignable_v<First&,
                      decltype(get<0>(declval<P>()))> &&
                  is_assignable_v<Second&,
                      decltype(get<1>(declval<P>()))>) {
        first = get<0>(forward<P>(other));
        second = get<1>(forward<P>(other));
        return *this;
    }

    template<detail::pair_like P>
    constexpr const pair& operator=(P&& other) const
        requires (is_assignable_v<const First&,
                      decltype(get<0>(declval<P>()))> &&
                  is_assignable_v<const Second&,
                      decltype(get<1>(declval<P>()))>) {
        first = get<0>(forward<P>(other));
        second = get<1>(forward<P>(other));
        return *this;
    }

    constexpr void swap(pair& other)
        noexcept(is_nothrow_swappable_v<First> &&
                 is_nothrow_swappable_v<Second>)
        requires (is_swappable_v<First> && is_swappable_v<Second>) {
        detail::adl_swap(first, other.first);
        detail::adl_swap(second, other.second);
    }

    constexpr void swap(const pair& other) const
        noexcept(is_nothrow_swappable_v<const First> &&
                 is_nothrow_swappable_v<const Second>)
        requires (is_swappable_v<const First> && is_swappable_v<const Second>) {
        detail::adl_swap(first, other.first);
        detail::adl_swap(second, other.second);
    }

private:
    template<class... Args1, class... Args2, size_t... I1, size_t... I2>
    constexpr pair(piecewise_construct_t, tuple<Args1...>& first_args,
                   tuple<Args2...>& second_args, index_sequence<I1...>,
                   index_sequence<I2...>)
        : first(forward<Args1>(get<I1>(first_args))...),
          second(forward<Args2>(get<I2>(second_args))...) {}
};

template<class First, class Second>
pair(First, Second) -> pair<First, Second>;

template<class T>
constexpr remove_reference_t<T>&& move(T&& value) noexcept {
    return static_cast<remove_reference_t<T>&&>(value);
}

namespace detail {
template<class From, class To>
using copy_const_t = conditional_t<is_const_v<remove_reference_t<From>>,
                                   const To, To>;

template<class Like, class T>
using forward_like_t = conditional_t<
    is_lvalue_reference_v<Like&&>,
    copy_const_t<Like, remove_reference_t<T>>&,
    copy_const_t<Like, remove_reference_t<T>>&&>;
}

template<class T, class U>
[[nodiscard]] constexpr auto forward_like(U&& value) noexcept
    -> detail::forward_like_t<T, U> {
    return static_cast<detail::forward_like_t<T, U>>(value);
}

template<class T>
constexpr conditional_t<!is_nothrow_move_constructible_v<T> &&
                        is_copy_constructible_v<T>, const T&, T&&>
move_if_noexcept(T& value) noexcept {
    return move(value);
}

template<class T>
constexpr T&& forward(remove_reference_t<T>& value) noexcept {
    return static_cast<T&&>(value);
}

template<class T>
constexpr T&& forward(remove_reference_t<T>&& value) noexcept {
    static_assert(!is_lvalue_reference_v<T>);
    return static_cast<T&&>(value);
}

template<class T>
constexpr void swap(T& left, T& right)
    noexcept(is_nothrow_move_constructible_v<T> &&
             is_nothrow_move_assignable_v<T>)
    requires (is_move_constructible_v<T> && is_move_assignable_v<T>) {
    T temporary = move(left);
    left = move(right);
    right = move(temporary);
}

template<class T, size_t N>
constexpr void swap(T (&left)[N], T (&right)[N])
    noexcept(detail::type_traits_nothrow_swappable_v<T>)
    requires detail::type_traits_swappable_v<T> {
    for (size_t i = 0; i < N; ++i) {
        swap(left[i], right[i]);
    }
}

template<class T, class U = T>
constexpr T exchange(T& object, U&& replacement)
    noexcept(is_nothrow_move_constructible_v<T> &&
             is_nothrow_assignable_v<T&, U>) {
    T old = move(object);
    object = forward<U>(replacement);
    return old;
}

template<class T1, class T2, class U1, class U2,
         template<class> class TQual, template<class> class UQual>
    requires requires {
        typename pair<common_reference_t<TQual<T1>, UQual<U1>>,
                      common_reference_t<TQual<T2>, UQual<U2>>>;
    }
struct basic_common_reference<pair<T1, T2>, pair<U1, U2>, TQual, UQual> {
    using type = pair<common_reference_t<TQual<T1>, UQual<U1>>,
                      common_reference_t<TQual<T2>, UQual<U2>>>;
};

template<class T1, class T2, class U1, class U2>
    requires requires {
        typename pair<common_type_t<T1, U1>, common_type_t<T2, U2>>;
    }
struct common_type<pair<T1, T2>, pair<U1, U2>> {
    using type = pair<common_type_t<T1, U1>, common_type_t<T2, U2>>;
};

template<class T1, class T2, class U1, class U2>
constexpr bool operator==(const pair<T1, T2>& left,
                          const pair<U1, U2>& right) {
    return left.first == right.first && left.second == right.second;
}

template<class T1, class T2, class U1, class U2>
constexpr auto operator<=>(const pair<T1, T2>& left,
                           const pair<U1, U2>& right) {
    using category = common_comparison_category_t<
        detail::synth_three_way_result_t<T1, U1>,
        detail::synth_three_way_result_t<T2, U2>>;
    if (category result = detail::synth_three_way(left.first, right.first);
        result != 0)
        return result;
    return category(detail::synth_three_way(left.second, right.second));
}

template<class T1, class T2>
constexpr void swap(pair<T1, T2>& left, pair<T1, T2>& right)
    noexcept(noexcept(left.swap(right)))
    requires requires { left.swap(right); } {
    left.swap(right);
}

template<class T1, class T2>
constexpr void swap(const pair<T1, T2>& left, const pair<T1, T2>& right)
    noexcept(noexcept(left.swap(right)))
    requires requires { left.swap(right); } {
    left.swap(right);
}

template<class T1, class T2>
constexpr pair<unwrap_ref_decay_t<T1>, unwrap_ref_decay_t<T2>>
make_pair(T1&& first, T2&& second) {
    return {forward<T1>(first), forward<T2>(second)};
}

