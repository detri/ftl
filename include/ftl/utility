template<class T1, class T2>
struct tuple_size<pair<T1, T2>> : integral_constant<size_t, 2> {};

template<class T1, class T2>
struct tuple_element<0, pair<T1, T2>> { using type = T1; };
template<class T1, class T2>
struct tuple_element<1, pair<T1, T2>> { using type = T2; };

template<size_t Index, class T1, class T2>
constexpr tuple_element_t<Index, pair<T1, T2>>&
get(pair<T1, T2>& value) noexcept {
    static_assert(Index < 2);
    if constexpr (Index == 0) return value.first;
    else return value.second;
}

template<size_t Index, class T1, class T2>
constexpr const tuple_element_t<Index, pair<T1, T2>>&
get(const pair<T1, T2>& value) noexcept {
    static_assert(Index < 2);
    if constexpr (Index == 0) return value.first;
    else return value.second;
}

template<size_t Index, class T1, class T2>
constexpr tuple_element_t<Index, pair<T1, T2>>&&
get(pair<T1, T2>&& value) noexcept {
    return forward<tuple_element_t<Index, pair<T1, T2>>>(get<Index>(value));
}

template<size_t Index, class T1, class T2>
constexpr const tuple_element_t<Index, pair<T1, T2>>&&
get(const pair<T1, T2>&& value) noexcept {
    return forward<const tuple_element_t<Index, pair<T1, T2>>>(get<Index>(value));
}

#define FTL_DETAIL_PAIR_GET(Type, Member)                                  \
    template<class T, class U> constexpr T& get(pair<Type, U>& value) noexcept { \
        return value.Member;                                                \
    }                                                                       \
    template<class T, class U> constexpr const T&                           \
    get(const pair<Type, U>& value) noexcept { return value.Member; }        \
    template<class T, class U> constexpr T&& get(pair<Type, U>&& value) noexcept { \
        return forward<T>(value.Member);                                    \
    }                                                                       \
    template<class T, class U> constexpr const T&&                          \
    get(const pair<Type, U>&& value) noexcept {                             \
        return forward<const T>(value.Member);                              \
    }

FTL_DETAIL_PAIR_GET(T, first)

