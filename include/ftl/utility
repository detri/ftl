struct is_library_pair_like : false_type {};
template<class... T>
struct is_library_pair_like<tuple<T...>> : true_type {};
template<class T, size_t Size>
struct is_library_pair_like<array<T, Size>> : bool_constant<Size == 2> {};

template<class>
struct is_subrange : false_type {};

template<class P>
concept pair_like = is_library_pair_like<remove_cvref_t<P>>::value &&
    !is_subrange<remove_cvref_t<P>>::value &&
    requires(P&& value) {
        requires tuple_size_v<remove_cvref_t<P>> == 2;
        get<0>(static_cast<P&&>(value));
        get<1>(static_cast<P&&>(value));
    };

