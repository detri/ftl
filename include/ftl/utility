template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_equal(T left, U right) noexcept {
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return left == right;
    else if constexpr (is_signed_v<T>)
        return left < 0 ? false : make_unsigned_t<T>(left) == right;
    else
        return right < 0 ? false : left == make_unsigned_t<U>(right);
}

template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_not_equal(T left, U right) noexcept {
    return !cmp_equal(left, right);
}

template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_less(T left, U right) noexcept {
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return left < right;
    else if constexpr (is_signed_v<T>)
        return left < 0 || make_unsigned_t<T>(left) < right;
    else
        return right >= 0 && left < make_unsigned_t<U>(right);
}

template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_greater(T left, U right) noexcept {
    return cmp_less(right, left);
}

template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_less_equal(T left, U right) noexcept {
    return !cmp_less(right, left);
}

template<detail::comparison_integer T, detail::comparison_integer U>
constexpr bool cmp_greater_equal(T left, U right) noexcept {
    return !cmp_less(left, right);
}

template<detail::comparison_integer Result, detail::comparison_integer T>
constexpr bool in_range(T value) noexcept {
    using unsigned_result = make_unsigned_t<Result>;
    constexpr unsigned_result maximum =
        unsigned_result(-1) >> (is_signed_v<Result> ? 1 : 0);
    if constexpr (is_signed_v<T> == is_signed_v<Result>) {
        if constexpr (sizeof(Result) >= sizeof(T))
            return true;
        else if constexpr (is_signed_v<Result>) {
            constexpr Result minimum =
                static_cast<Result>(-static_cast<Result>(maximum) - 1);
            return value >= static_cast<T>(minimum) &&
                   value <= static_cast<T>(maximum);
        } else
            return value <= static_cast<T>(maximum);
    } else if constexpr (is_signed_v<T>) {
        return value >= 0 &&
               (sizeof(Result) >= sizeof(T) ||
                static_cast<make_unsigned_t<T>>(value) <=
                    static_cast<make_unsigned_t<T>>(maximum));
    } else {
        return sizeof(Result) > sizeof(T) || value <= static_cast<T>(maximum);
    }
}

