[[nodiscard]]
inline const char *locale_state_name(const locale_state *state) noexcept {
  if (!state->named)
    return nullptr;

  if (state->static_name != nullptr)
    return state->static_name;

  return state->owned_name.c_str();
}

[[nodiscard]]
inline bool locale_names_equal(const locale_state *left,
                               const locale_state *right) noexcept {
  const char *lhs = locale_state_name(left);
  const char *rhs = locale_state_name(right);

  if (lhs == nullptr || rhs == nullptr)
    return false;

  while (*lhs != '\0' && *rhs != '\0') {
    if (*lhs != *rhs)
      return false;

    ++lhs;
    ++rhs;
  }

  return *lhs == *rhs;
}

[[nodiscard]]
inline locale_facet_slot *locale_find_facet(locale_state *state,
                                            const locale::id *key) noexcept {
  for (auto &slot : state->facets) {
    if (slot.key == key)
      return &slot;
  }

  return nullptr;
}

[[nodiscard]]
inline const locale_facet_slot *
locale_find_facet(const locale_state *state, const locale::id *key) noexcept {
  for (const auto &slot : state->facets) {
    if (slot.key == key)
      return &slot;
  }

  return nullptr;
}

template <class Facet>
inline void locale_replace_facet(locale_state *state, Facet *value) {
  const locale::id *key = &Facet::id;
  locale_facet_slot *slot = locale_find_facet(state, key);
  if (slot == nullptr) {
    state->facets.push_back({key, nullptr});
    slot = &state->facets.back();
  }
  locale_facet_control *replacement = new locale_facet_control(value);
  locale_facet_control *previous = slot->control;
  slot->control = replacement;
  if (previous) previous->release();
}

inline void locale_copy_facet(locale_state *destination,
                              const locale_state *source,
                              const locale::id *key) {
  const locale_facet_slot *from = locale_find_facet(source, key);
  if (!from) return;
  locale_facet_slot *to = locale_find_facet(destination, key);
  if (!to) {
    destination->facets.push_back({key, nullptr});
    to = &destination->facets.back();
  }
  from->control->retain();
  locale_facet_control *previous = to->control;
  to->control = from->control;
  if (previous) previous->release();
}

inline locale_state *locale_make_named_state(const char *name) {
  if (!name) locale_named_numpunct_failure();
  unique_ptr<locale_state> state{new locale_state(locale_classic_state(), true)};
  state->named = true;
  state->static_name = nullptr;
  state->owned_name = name;

  locale_replace_facet(state.get(), new ctype_byname<char>(name));
  locale_replace_facet(state.get(), new ctype_byname<wchar_t>(name));
  locale_replace_facet(state.get(), new collate_byname<char>(name));
  locale_replace_facet(state.get(), new collate_byname<wchar_t>(name));
  locale_replace_facet(state.get(), new numpunct_byname<char>(name));
  locale_replace_facet(state.get(), new numpunct_byname<wchar_t>(name));
  locale_replace_facet(state.get(), new codecvt_byname<char, char, mbstate_t>(name));
  locale_replace_facet(state.get(), new codecvt_byname<wchar_t, char, mbstate_t>(name));
  locale_replace_facet(state.get(), new moneypunct_byname<char, false>(name));
  locale_replace_facet(state.get(), new moneypunct_byname<wchar_t, false>(name));
  locale_replace_facet(state.get(), new moneypunct_byname<char, true>(name));
  locale_replace_facet(state.get(), new moneypunct_byname<wchar_t, true>(name));
  locale_replace_facet(state.get(), new time_get_byname<char>(name));
  locale_replace_facet(state.get(), new time_get_byname<wchar_t>(name));
  locale_replace_facet(state.get(), new time_put_byname<char>(name));
  locale_replace_facet(state.get(), new time_put_byname<wchar_t>(name));
  locale_replace_facet(state.get(), new messages_byname<char>(name));
  locale_replace_facet(state.get(), new messages_byname<wchar_t>(name));
  return state.release();
}

inline bool locale_valid_category(locale::category value) noexcept {
  return (value & ~locale::all) == 0;
}

inline void locale_copy_category(locale_state *destination,
                                 const locale_state *source,
                                 locale::category selected) {
  if (selected & locale::collate) {
    locale_copy_facet(destination, source, &collate<char>::id);
    locale_copy_facet(destination, source, &collate<wchar_t>::id);
  }
  if (selected & locale::ctype) {
    locale_copy_facet(destination, source, &ctype<char>::id);
    locale_copy_facet(destination, source, &ctype<wchar_t>::id);
    locale_copy_facet(destination, source, &codecvt<char, char, mbstate_t>::id);
    locale_copy_facet(destination, source, &codecvt<wchar_t, char, mbstate_t>::id);
    locale_copy_facet(destination, source, &codecvt<char16_t, char8_t, mbstate_t>::id);
    locale_copy_facet(destination, source, &codecvt<char32_t, char8_t, mbstate_t>::id);
    locale_copy_facet(destination, source, &codecvt<char16_t, char, mbstate_t>::id);
    locale_copy_facet(destination, source, &codecvt<char32_t, char, mbstate_t>::id);
  }
  if (selected & locale::numeric) {
    locale_copy_facet(destination, source, &numpunct<char>::id);
    locale_copy_facet(destination, source, &numpunct<wchar_t>::id);
    locale_copy_facet(destination, source, &num_get<char>::id);
    locale_copy_facet(destination, source, &num_get<wchar_t>::id);
    locale_copy_facet(destination, source, &num_put<char>::id);
    locale_copy_facet(destination, source, &num_put<wchar_t>::id);
  }
  if (selected & locale::monetary) {
    locale_copy_facet(destination, source, &moneypunct<char, false>::id);
    locale_copy_facet(destination, source, &moneypunct<wchar_t, false>::id);
    locale_copy_facet(destination, source, &moneypunct<char, true>::id);
    locale_copy_facet(destination, source, &moneypunct<wchar_t, true>::id);
    locale_copy_facet(destination, source, &money_get<char>::id);
    locale_copy_facet(destination, source, &money_get<wchar_t>::id);
    locale_copy_facet(destination, source, &money_put<char>::id);
    locale_copy_facet(destination, source, &money_put<wchar_t>::id);
  }
  if (selected & locale::time) {
    locale_copy_facet(destination, source, &time_get<char>::id);
    locale_copy_facet(destination, source, &time_get<wchar_t>::id);
    locale_copy_facet(destination, source, &time_put<char>::id);
    locale_copy_facet(destination, source, &time_put<wchar_t>::id);
  }
  if (selected & locale::messages) {
    locale_copy_facet(destination, source, &messages<char>::id);
    locale_copy_facet(destination, source, &messages<wchar_t>::id);
  }
}

template <class Facet>
[[nodiscard]]
inline const locale::id *locale_facet_key() {
  using bare_facet = remove_cv_t<Facet>;

  static_assert(!is_volatile_v<Facet>,
                "volatile-qualified locale facets are ill-formed");

  static_assert(is_convertible_v<const bare_facet *, const locale::facet *>,
                "locale facet must be publicly derived from locale::facet");

  return &bare_facet::id;
}

[[noreturn]]
inline void locale_missing_facet() {
#if FTL_HAS_EXCEPTIONS
  throw bad_cast{};
#else
  terminate();
#endif
}

[[noreturn]]
inline void locale_combine_missing_facet() {
#if FTL_HAS_EXCEPTIONS
  throw runtime_error("locale::combine");
#else
  terminate();
#endif
}

} // namespace detail

inline locale::locale() noexcept : state_(nullptr) {
  auto &global = detail::locale_global();
  detail::locale_global_lock(global);
  state_ = global.state;
  detail::locale_retain_state(state_);
  detail::locale_global_unlock(global);
}

inline locale::locale(const locale &other) noexcept : state_(other.state_) {
  detail::locale_retain_state(state_);
}

inline locale::locale(const char *name)
    : state_(detail::locale_make_named_state(name)) {}

inline locale::locale(const string &name) : locale(name.c_str()) {}

inline locale::locale(const locale &other, const char *name, category selected)
    : state_(nullptr) {
  if (!detail::locale_valid_category(selected))
    detail::locale_named_numpunct_failure();
  locale named{name};
  unique_ptr<detail::locale_state> next{
      new detail::locale_state(*other.state_, selected == none)};
  detail::locale_copy_category(next.get(), named.state_, selected);
  if (selected != none && other.state_->named) {
    next->named = true;
    next->static_name = nullptr;
    next->owned_name = other.name();
    next->owned_name.push_back(';');
    next->owned_name += name;
    next->owned_name.push_back(';');
    for (category bit = 1; bit <= messages; bit <<= 1)
      if (selected & bit) next->owned_name.push_back(static_cast<char>('0' + bit));
  } else if (selected != none) {
    next->named = false;
    next->static_name = nullptr;
    next->owned_name.clear();
  }
  state_ = next.release();
}

inline locale::locale(const locale &other, const string &name, category selected)
    : locale(other, name.c_str(), selected) {}

inline locale::locale(const locale &other, const locale &one, category selected)
    : state_(nullptr) {
  if (!detail::locale_valid_category(selected))
    detail::locale_named_numpunct_failure();
  unique_ptr<detail::locale_state> next{
      new detail::locale_state(*other.state_, selected == none)};
  detail::locale_copy_category(next.get(), one.state_, selected);
  if (selected != none && other.state_->named && one.state_->named) {
    next->named = true;
    next->static_name = nullptr;
    next->owned_name = other.name();
    next->owned_name.push_back(';');
    next->owned_name += one.name();
    next->owned_name.push_back(';');
    for (category bit = 1; bit <= messages; bit <<= 1)
      if (selected & bit) next->owned_name.push_back(static_cast<char>('0' + bit));
  } else if (selected != none) {
    next->named = false;
    next->static_name = nullptr;
    next->owned_name.clear();
  }
  state_ = next.release();
}

template <class Facet>
locale::locale(const locale &other, Facet *value) : state_(nullptr) {
  using bare_facet = remove_cv_t<Facet>;

  const id *key = detail::locale_facet_key<Facet>();

  if (value == nullptr) {
    state_ = other.state_;
    detail::locale_retain_state(state_);
    return;
  }

  const facet *base = static_cast<const facet *>(value);

  unique_ptr<detail::locale_state> next{
      new detail::locale_state(*other.state_, false)};

  detail::locale_facet_slot *slot = detail::locale_find_facet(next.get(), key);

  if (slot == nullptr) {
    next->facets.push_back({key, nullptr});
    slot = &next->facets.back();
  }

  // Do this after every potentially throwing state/vector operation.
  // Until this allocation succeeds, ownership of value has not been
  // committed to the new locale representation.
  auto *replacement = new detail::locale_facet_control(base);

  detail::locale_facet_control *previous = slot->control;
  slot->control = replacement;

  if (previous != nullptr)
    previous->release();

  state_ = next.release();

  (void)sizeof(bare_facet);
}

inline locale::~locale() { detail::locale_release_state(state_); }

inline const locale &locale::operator=(const locale &other) noexcept {
  if (this == &other)
    return *this;

  detail::locale_state *replacement = other.state_;
  detail::locale_retain_state(replacement);

  detail::locale_state *previous = state_;
  state_ = replacement;

  detail::locale_release_state(previous);

  return *this;
}

template <class Facet> locale locale::combine(const locale &other) const {
  const id *key = detail::locale_facet_key<Facet>();

  const detail::locale_facet_slot *source =
      detail::locale_find_facet(other.state_, key);

  if (source == nullptr)
    detail::locale_combine_missing_facet();

  unique_ptr<detail::locale_state> next{
      new detail::locale_state(*state_, false)};

  detail::locale_facet_slot *destination =
      detail::locale_find_facet(next.get(), key);

  if (destination == nullptr) {
    next->facets.push_back({key, nullptr});
    destination = &next->facets.back();
  }

  source->control->retain();

  detail::locale_facet_control *previous = destination->control;
  destination->control = source->control;

  if (previous != nullptr)
    previous->release();

  return locale(next.release(), adopt_state_t{});
}

inline string locale::name() const {
  if (!state_->named)
    return string("*");

  return string(detail::locale_state_name(state_));
}

inline bool locale::operator==(const locale &other) const {
  if (state_ == other.state_)
    return true;

  if (!state_->named || !other.state_->named)
    return false;

  return detail::locale_names_equal(state_, other.state_);
}

inline locale locale::global(const locale &value) {
  auto &global = detail::locale_global();
  detail::locale_global_lock(global);

  detail::locale_retain_state(value.state_);

  detail::locale_state *old = global.state;
  global.state = value.state_;

  // The effect on the C locale for an unnamed C++ locale is
  // implementation-defined. Leave it alone in that case.
  if (value.state_->named) {
    (void)setlocale(LC_ALL, detail::locale_state_name(value.state_));
  }

  detail::locale_global_unlock(global);

  // Transfer the old global anchor reference into the returned locale.
  return locale{old, adopt_state_t{}};
}

inline const locale &locale::classic() {
  static const locale value{&detail::locale_classic_state(), adopt_state_t{}};

  return value;
}

template <class Codecvt, class Elem = wchar_t,
          class WideAlloc = allocator<Elem>,
          class ByteAlloc = allocator<char>>
class wstring_convert {
public:
  using byte_string = basic_string<char, char_traits<char>, ByteAlloc>;
  using wide_string = basic_string<Elem, char_traits<Elem>, WideAlloc>;
  using state_type = typename Codecvt::state_type;
  using int_type = typename wide_string::traits_type::int_type;

  wstring_convert() : wstring_convert(new Codecvt) {}

  explicit wstring_convert(Codecvt *conversion)
      : conversion_(conversion) {}

  wstring_convert(Codecvt *conversion, state_type state)
      : conversion_(conversion), state_(state), retain_state_(true) {}

  explicit wstring_convert(const byte_string &byte_error,
                           const wide_string &wide_error = wide_string())
      : byte_error_(byte_error), wide_error_(wide_error),
        conversion_(new Codecvt), has_error_strings_(true) {}

  ~wstring_convert() { delete conversion_; }

  wstring_convert(const wstring_convert &) = delete;
  wstring_convert &operator=(const wstring_convert &) = delete;

  wide_string from_bytes(char byte) { return from_bytes(&byte, &byte + 1); }

  wide_string from_bytes(const char *pointer) {
    return from_bytes(pointer, pointer + char_traits<char>::length(pointer));
  }

  wide_string from_bytes(const byte_string &value) {
    return from_bytes(value.data(), value.data() + value.size());
  }

  wide_string from_bytes(const char *first, const char *last) {
    if (!retain_state_)
      state_ = state_type{};
    converted_ = 0;
    wide_string result;

    while (first != last) {
      Elem buffer[32];
      const char *from_next = first;
      Elem *to_next = buffer;
      const auto status = conversion_->in(state_, first, last, from_next,
                                          buffer, buffer + 32, to_next);
      result.append(buffer, static_cast<size_t>(to_next - buffer));
      converted_ += static_cast<size_t>(from_next - first);

      if (status == codecvt_base::noconv) {
        while (first != last) {
          result.push_back(static_cast<Elem>(*first++));
          ++converted_;
        }
        return result;
      }
      if (status == codecvt_base::error ||
          (status == codecvt_base::partial && from_next == last) ||
          (from_next == first && to_next == buffer))
        return from_bytes_error();
      first = from_next;
    }

    return result;
  }

  byte_string to_bytes(Elem value) { return to_bytes(&value, &value + 1); }

  byte_string to_bytes(const Elem *pointer) {
    return to_bytes(pointer, pointer + char_traits<Elem>::length(pointer));
  }

  byte_string to_bytes(const wide_string &value) {
    return to_bytes(value.data(), value.data() + value.size());
  }

  byte_string to_bytes(const Elem *first, const Elem *last) {
    if (!retain_state_)
      state_ = state_type{};
    converted_ = 0;
    byte_string result;

    while (first != last) {
      char buffer[64];
      const Elem *from_next = first;
      char *to_next = buffer;
      const auto status = conversion_->out(state_, first, last, from_next,
                                           buffer, buffer + 64, to_next);
      result.append(buffer, static_cast<size_t>(to_next - buffer));
      converted_ += static_cast<size_t>(from_next - first);

      if (status == codecvt_base::noconv) {
        while (first != last) {
          result.push_back(static_cast<char>(*first++));
          ++converted_;
        }
        return result;
      }
      if (status == codecvt_base::error ||
          (status == codecvt_base::partial && from_next == last) ||
          (from_next == first && to_next == buffer))
        return to_bytes_error();
      first = from_next;
    }

    for (;;) {
      char buffer[64];
      char *to_next = buffer;
      const auto status =
          conversion_->unshift(state_, buffer, buffer + 64, to_next);
      result.append(buffer, static_cast<size_t>(to_next - buffer));
      if (status == codecvt_base::ok || status == codecvt_base::noconv)
        break;
      if (status == codecvt_base::error || to_next == buffer)
        return to_bytes_error();
    }

    return result;
  }

  size_t converted() const noexcept { return converted_; }
  state_type state() const { return state_; }

private:
  [[noreturn]] static void conversion_error() {
#if FTL_HAS_EXCEPTIONS
    throw range_error("wstring_convert");
#else
    terminate();
#endif
  }

  wide_string from_bytes_error() const {
    if (has_error_strings_)
      return wide_error_;
    conversion_error();
  }

  byte_string to_bytes_error() const {
    if (has_error_strings_)
      return byte_error_;
    conversion_error();
  }

  byte_string byte_error_{};
  wide_string wide_error_{};
  Codecvt *conversion_{};
  state_type state_{};
  size_t converted_{};
  bool retain_state_{};
  bool has_error_strings_{};
};

template <class Facet> bool has_facet(const locale &value) noexcept {
  const locale::id *key = detail::locale_facet_key<Facet>();

  return detail::locale_find_facet(value.state_, key) != nullptr;
}

template <class Facet> const Facet &use_facet(const locale &value) {
  using bare_facet = remove_cv_t<Facet>;

  const locale::id *key = detail::locale_facet_key<Facet>();

  const detail::locale_facet_slot *slot =
      detail::locale_find_facet(value.state_, key);

  if (slot == nullptr)
    detail::locale_missing_facet();

  return *static_cast<const bare_facet *>(slot->control->value);
}

template <class Character> bool isspace(Character value, const locale &where) {
  return use_facet<ctype<Character>>(where).is(ctype_base::space, value);
}

template <class Character> bool isprint(Character value, const locale &where) {
  return use_facet<ctype<Character>>(where).is(ctype_base::print, value);
}

