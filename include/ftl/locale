class locale_windows_numeric_scope {
public:
  explicit locale_windows_numeric_scope(const char *name)
      : previous_name_(locale_current_numeric_name()),
        previous_mode_(ftl_locale_runtime::_configthreadlocale(1)),
        active_(false) {
    if (previous_mode_ == -1)
      locale_named_numpunct_failure();

    if (::setlocale(LC_NUMERIC, name) == nullptr) {
      if (previous_mode_ == 2) {
        (void)ftl_locale_runtime::_configthreadlocale(2);
      }

      locale_named_numpunct_failure();
    }

    active_ = true;
  }

  locale_windows_numeric_scope(const locale_windows_numeric_scope &) = delete;

  locale_windows_numeric_scope &
  operator=(const locale_windows_numeric_scope &) = delete;

  ~locale_windows_numeric_scope() {
    if (active_) {
      (void)::setlocale(LC_NUMERIC, previous_name_.c_str());
    }

    if (previous_mode_ == 2) {
      (void)ftl_locale_runtime::_configthreadlocale(2);
    }
  }

private:
  string previous_name_;
  int previous_mode_;
  bool active_;
};

