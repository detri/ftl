template <class Character>
class ctype : public locale::facet, public ctype_base {
  static_assert(is_same_v<Character, wchar_t>,
                "FTL provides standard ctype specializations for char and "
                "wchar_t");

public:
  using char_type = Character;

  explicit ctype(size_t refs = 0) : locale::facet(refs) {}

  [[nodiscard]]
  bool is(mask requested, char_type value) const {
    return do_is(requested, value);
  }

  const char_type *is(const char_type *low, const char_type *high,
                      mask *output) const {
    return do_is(low, high, output);
  }

  [[nodiscard]]
  const char_type *scan_is(mask requested, const char_type *low,
                           const char_type *high) const {
    return do_scan_is(requested, low, high);
  }

  [[nodiscard]]
  const char_type *scan_not(mask requested, const char_type *low,
                            const char_type *high) const {
    return do_scan_not(requested, low, high);
  }

  [[nodiscard]]
  char_type toupper(char_type value) const {
    return do_toupper(value);
  }

  const char_type *toupper(char_type *low, const char_type *high) const {
    return do_toupper(low, high);
  }

  [[nodiscard]]
  char_type tolower(char_type value) const {
    return do_tolower(value);
  }

  const char_type *tolower(char_type *low, const char_type *high) const {
    return do_tolower(low, high);
  }

  [[nodiscard]]
  char_type widen(char value) const {
    return do_widen(value);
  }

  const char *widen(const char *low, const char *high,
                    char_type *output) const {
    return do_widen(low, high, output);
  }

  [[nodiscard]]
  char narrow(char_type value, char fallback) const {
    return do_narrow(value, fallback);
  }

  const char_type *narrow(const char_type *low, const char_type *high,
                          char fallback, char *output) const {
    return do_narrow(low, high, fallback, output);
  }

  inline static locale::id id{};

protected:
  ~ctype() override = default;

  virtual bool do_is(mask requested, char_type value) const {
    return (detail::ctype_wide_mask(static_cast<wchar_t>(value)) & requested) !=
           0;
  }

  virtual const char_type *do_is(const char_type *low, const char_type *high,
                                 mask *output) const {
    for (const char_type *current = low; current != high; ++current)
      *output++ = detail::ctype_wide_mask(static_cast<wchar_t>(*current));

    return high;
  }

  virtual const char_type *do_scan_is(mask requested, const char_type *low,
                                      const char_type *high) const {
    while (low != high) {
      if (do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  virtual const char_type *do_scan_not(mask requested, const char_type *low,
                                       const char_type *high) const {
    while (low != high) {
      if (!do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  virtual char_type do_toupper(char_type value) const {
    return static_cast<char_type>(towupper(static_cast<wint_t>(value)));
  }

  virtual const char_type *do_toupper(char_type *low,
                                      const char_type *high) const {
    for (char_type *current = low; current != high; ++current)
      *current = do_toupper(*current);

    return high;
  }

  virtual char_type do_tolower(char_type value) const {
    return static_cast<char_type>(towlower(static_cast<wint_t>(value)));
  }

  virtual const char_type *do_tolower(char_type *low,
                                      const char_type *high) const {
    for (char_type *current = low; current != high; ++current)
      *current = do_tolower(*current);

    return high;
  }

  virtual char_type do_widen(char value) const {
    return static_cast<char_type>(static_cast<unsigned char>(value));
  }

  virtual const char *do_widen(const char *low, const char *high,
                               char_type *output) const {
    while (low != high)
      *output++ = do_widen(*low++);

    return high;
  }

  virtual char do_narrow(char_type value, char fallback) const {
    if constexpr (is_signed_v<char_type>) {
      if (value < 0)
        return fallback;
    }

    const auto numeric = static_cast<unsigned long long>(value);

    if (numeric <= 0x7fu)
      return static_cast<char>(numeric);

    return fallback;
  }

  virtual const char_type *do_narrow(const char_type *low,
                                     const char_type *high, char fallback,
                                     char *output) const {
    while (low != high)
      *output++ = do_narrow(*low++, fallback);

    return high;
  }
};

template <> class ctype<char> : public locale::facet, public ctype_base {
public:
  using char_type = char;

  explicit ctype(const mask *table = nullptr, bool delete_table = false,
                 size_t refs = 0)
      : locale::facet(refs), table_(table),
        delete_table_(table != nullptr && delete_table) {}

  [[nodiscard]]
  bool is(mask requested, char value) const {
    return (table()[static_cast<unsigned char>(value)] & requested) != 0;
  }

  const char *is(const char *low, const char *high, mask *output) const {
    while (low != high) {
      *output++ = table()[static_cast<unsigned char>(*low++)];
    }

    return high;
  }

  [[nodiscard]]
  const char *scan_is(mask requested, const char *low, const char *high) const {
    while (low != high) {
      if ((table()[static_cast<unsigned char>(*low)] & requested) != 0)
        break;

      ++low;
    }

    return low;
  }

  [[nodiscard]]
  const char *scan_not(mask requested, const char *low,
                       const char *high) const {
    while (low != high) {
      if ((table()[static_cast<unsigned char>(*low)] & requested) == 0)
        break;

      ++low;
    }

    return low;
  }

  [[nodiscard]]
  char toupper(char value) const {
    return do_toupper(value);
  }

  const char *toupper(char *low, const char *high) const {
    return do_toupper(low, high);
  }

  [[nodiscard]]
  char tolower(char value) const {
    return do_tolower(value);
  }

  const char *tolower(char *low, const char *high) const {
    return do_tolower(low, high);
  }

  [[nodiscard]]
  char widen(char value) const {
    return do_widen(value);
  }

  const char *widen(const char *low, const char *high, char *output) const {
    return do_widen(low, high, output);
  }

  [[nodiscard]]
  char narrow(char value, char fallback) const {
    return do_narrow(value, fallback);
  }

  const char *narrow(const char *low, const char *high, char fallback,
                     char *output) const {
    return do_narrow(low, high, fallback, output);
  }

  inline static locale::id id{};

  inline static constexpr size_t table_size = 256;

  [[nodiscard]]
  const mask *table() const noexcept {
    return table_ != nullptr ? table_ : classic_table();
  }

  [[nodiscard]]
  static const mask *classic_table() noexcept {
    return detail::ctype_classic_table.values;
  }

protected:
  ~ctype() override {
    if (delete_table_)
      delete[] table_;
  }

  virtual char do_toupper(char value) const {
    const unsigned char character = static_cast<unsigned char>(value);

    if (character >= static_cast<unsigned char>('a') &&
        character <= static_cast<unsigned char>('z')) {
      return static_cast<char>(character - static_cast<unsigned char>('a') +
                               static_cast<unsigned char>('A'));
    }

    return value;
  }

  virtual const char *do_toupper(char *low, const char *high) const {
    for (char *current = low; current != high; ++current)
      *current = do_toupper(*current);

    return high;
  }

  virtual char do_tolower(char value) const {
    const unsigned char character = static_cast<unsigned char>(value);

    if (character >= static_cast<unsigned char>('A') &&
        character <= static_cast<unsigned char>('Z')) {
      return static_cast<char>(character - static_cast<unsigned char>('A') +
                               static_cast<unsigned char>('a'));
    }

    return value;
  }

  virtual const char *do_tolower(char *low, const char *high) const {
    for (char *current = low; current != high; ++current)
      *current = do_tolower(*current);

    return high;
  }

  virtual char do_widen(char value) const { return value; }

  virtual const char *do_widen(const char *low, const char *high,
                               char *output) const {
    while (low != high)
      *output++ = *low++;

    return high;
  }

  virtual char do_narrow(char value, char) const { return value; }

  virtual const char *do_narrow(const char *low, const char *high, char,
                                char *output) const {
    while (low != high)
      *output++ = *low++;

    return high;
  }

private:
  const mask *table_;
  bool delete_table_;
};

// Named facets come with the named-locale runtime in the next slice.
