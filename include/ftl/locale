template <class Character, bool International = false>
class moneypunct_byname : public moneypunct<Character, International> {
public:
  using base_type = moneypunct<Character, International>;

  using char_type = typename base_type::char_type;

  using string_type = typename base_type::string_type;

  using pattern = money_base::pattern;

  explicit moneypunct_byname(const char *name, size_t refs = 0)
      : base_type(refs),
        context_(new detail::locale_named_moneypunct_context(name)) {}

  explicit moneypunct_byname(const string &name, size_t refs = 0)
      : moneypunct_byname(name.c_str(), refs) {}

protected:
  ~moneypunct_byname() override { delete context_; }

  char_type do_decimal_point() const override {
    return detail::locale_named_monetary_character<Character>(
        *context_, context_->monetary.decimal_point, '.');
  }

  char_type do_thousands_sep() const override {
    return detail::locale_named_monetary_character<Character>(
        *context_, context_->monetary.thousands_sep, ',');
  }

  string do_grouping() const override { return context_->monetary.grouping; }

  string_type do_curr_symbol() const override {
    const string &symbol = International
                               ? context_->monetary.international_symbol
                               : context_->monetary.local_symbol;

    return detail::locale_named_monetary_string<Character>(*context_, symbol);
  }

  string_type do_positive_sign() const override {
    const unsigned position =
        detail::locale_monetary_sign_position<International>(context_->monetary,
                                                             true);

    if (position == 0) {
      return detail::locale_ascii_string<Character>("()");
    }

    return detail::locale_named_monetary_string<Character>(
        *context_, context_->monetary.positive_sign);
  }

  string_type do_negative_sign() const override {
    const unsigned position =
        detail::locale_monetary_sign_position<International>(context_->monetary,
                                                             false);

    if (position == 0) {
      return detail::locale_ascii_string<Character>("()");
    }

    return detail::locale_named_monetary_string<Character>(
        *context_, context_->monetary.negative_sign);
  }

  int do_frac_digits() const override {
    return detail::locale_monetary_frac_digits(
        International ? context_->monetary.international_frac_digits
                      : context_->monetary.local_frac_digits);
  }

  pattern do_pos_format() const override {
    return detail::locale_monetary_pattern(
        detail::locale_monetary_cs_precedes<International>(context_->monetary,
                                                           true),
        detail::locale_monetary_sep_by_space<International>(context_->monetary,
                                                            true),
        detail::locale_monetary_sign_position<International>(context_->monetary,
                                                             true));
  }

  pattern do_neg_format() const override {
    return detail::locale_monetary_pattern(
        detail::locale_monetary_cs_precedes<International>(context_->monetary,
                                                           false),
        detail::locale_monetary_sep_by_space<International>(context_->monetary,
                                                            false),
        detail::locale_monetary_sign_position<International>(context_->monetary,
                                                             false));
  }

private:
  detail::locale_named_moneypunct_context *context_;
};

template <class Character, class InputIterator = istreambuf_iterator<Character>>
class money_get : public locale::facet {
public:
  using char_type = Character;
  using iter_type = InputIterator;
  using string_type = basic_string<char_type>;
  explicit money_get(size_t refs = 0) : locale::facet(refs) {}
  iter_type get(iter_type first, iter_type last, bool intl, ios_base &format,
                unsigned int &error, long double &units) const {
    return do_get(first, last, intl, format, error, units);
  }
  iter_type get(iter_type first, iter_type last, bool intl, ios_base &format,
                unsigned int &error, string_type &digits) const {
    return do_get(first, last, intl, format, error, digits);
  }
  inline static locale::id id{};
protected:
  ~money_get() override = default;
  virtual iter_type do_get(iter_type first, iter_type last, bool intl,
                           ios_base &format, unsigned int &error,
                           long double &units) const {
    string_type digits;
    first = do_get(first, last, intl, format, error, digits);
    if ((error & stream_failbit()) == 0) {
      string buffer;
      buffer.reserve(digits.size());
      for (char_type digit : digits)
        buffer.push_back(static_cast<char>(digit));
      char *end = nullptr;
      units = ::strtold(buffer.c_str(), &end);
      if (end != buffer.data() + buffer.size())
        error |= stream_failbit();
    }
    return first;
  }
  virtual iter_type do_get(iter_type first, iter_type last, bool intl,
                           ios_base &format, unsigned int &error,
                           string_type &digits) const {
    const locale where = format_locale(format);
    string_type symbol, positive, negative_text;
    string grouping;
    money_base::pattern pattern{};
    int fractional;
    char_type decimal, separator;
    if (intl) {
      const auto &punctuation = use_facet<moneypunct<char_type, true>>(where);
      symbol = punctuation.curr_symbol(); positive = punctuation.positive_sign();
      negative_text = punctuation.negative_sign(); grouping = punctuation.grouping();
      pattern = punctuation.neg_format(); fractional = punctuation.frac_digits();
      decimal = punctuation.decimal_point(); separator = punctuation.thousands_sep();
    } else {
      const auto &punctuation = use_facet<moneypunct<char_type, false>>(where);
      symbol = punctuation.curr_symbol(); positive = punctuation.positive_sign();
      negative_text = punctuation.negative_sign(); grouping = punctuation.grouping();
      pattern = punctuation.neg_format(); fractional = punctuation.frac_digits();
      decimal = punctuation.decimal_point(); separator = punctuation.thousands_sep();
    }
    const auto &classification = use_facet<ctype<char_type>>(where);
    string_type parsed; bool negative = false, any = false, saw_decimal = false;
    size_t fractional_count = 0;
    vector<size_t> parsed_groups;
    size_t current_group = 0;
    bool saw_separator = false;
    bool groups_closed = false;
    string_type sign_tail;
    for (int component = 0; component < 4 && (error & stream_failbit()) == 0; ++component) {
      bool final = component == 3;
      switch (static_cast<money_base::part>(pattern.field[component])) {
      case money_base::symbol:
        if (detail::locale_stream_showbase(format) && !consume_text(first, last, symbol))
          error |= stream_failbit();
        break;
      case money_base::sign:
        if (!positive.empty() && first != last && *first == positive[0]) {
          ++first; sign_tail.assign(positive.data() + 1, positive.size() - 1);
        } else if (!negative_text.empty() && first != last && *first == negative_text[0]) {
          ++first; negative = true;
          sign_tail.assign(negative_text.data() + 1, negative_text.size() - 1);
        } else if (positive.empty()) {
          negative = false;
        } else if (negative_text.empty()) {
          negative = true;
        } else error |= stream_failbit();
        break;
      case money_base::space: {
        bool consumed = false;
        if (!final) while (first != last && classification.is(ctype_base::space, *first)) {
          consumed = true; ++first;
        }
        if (!final && !consumed) error |= stream_failbit();
        break;
      }
      case money_base::none:
        if (!final) while (first != last && classification.is(ctype_base::space, *first)) ++first;
        break;
      case money_base::value:
        while (first != last) {
          char_type character = *first; char narrow = static_cast<char>(character);
          if (narrow >= '0' && narrow <= '9') {
            parsed.push_back(character); any = true;
            if (saw_decimal)
              ++fractional_count;
            else
              ++current_group;
            ++first;
          } else if (character == separator && !saw_decimal && !grouping.empty()) {
            parsed_groups.push_back(current_group);
            current_group = 0;
            saw_separator = true;
            ++first;
          } else if (character == decimal && !saw_decimal && fractional > 0) {
            if (saw_separator) {
              parsed_groups.push_back(current_group);
              groups_closed = true;
            }
            saw_decimal = true; ++first;
          } else break;
        }
        break;
      }
    }
    if (!sign_tail.empty() && !consume_text(first, last, sign_tail)) error |= stream_failbit();
    if (saw_separator && !groups_closed)
      parsed_groups.push_back(current_group);

    if (saw_separator) {
      bool valid = parsed_groups.size() > 1;
      size_t rule = 0;
      unsigned char repeated = 0;

      for (size_t position = parsed_groups.size(); valid && position != 0;
           --position) {
        unsigned char expected = static_cast<unsigned char>(grouping[rule]);
        if (expected == 0)
          expected = repeated;
        else if (expected != static_cast<unsigned char>(CHAR_MAX))
          repeated = expected;

        const size_t actual = parsed_groups[position - 1];
        if (expected == static_cast<unsigned char>(CHAR_MAX)) {
          valid = position == 1 && actual != 0;
          break;
        }
        if (expected == 0 ||
            (position == 1 ? actual == 0 || actual > expected
                           : actual != expected)) {
          valid = false;
          break;
        }
        if (rule + 1 < grouping.size())
          ++rule;
      }

      if (!valid)
        error |= stream_failbit();
    }

    if (!any || (fractional > 0 && fractional_count != static_cast<size_t>(fractional)))
      error |= stream_failbit();
    else {
      if (negative) parsed.insert(parsed.begin(), static_cast<char_type>('-'));
      digits = parsed;
    }
    if (first == last) error |= stream_eofbit();
    return first;
  }
private:
  static unsigned int stream_failbit();
  static unsigned int stream_eofbit();
  static locale format_locale(ios_base &);
  static bool consume_text(iter_type &first, iter_type last,
                           const string_type &text) {
    for (char_type expected : text) {
      if (first == last || *first != expected) return false;
      ++first;
    }
    return true;
  }
};

template <class Character, class OutputIterator = ostreambuf_iterator<Character>>
class money_put : public locale::facet {
public:
  using char_type = Character;
  using iter_type = OutputIterator;
  using string_type = basic_string<char_type>;
  explicit money_put(size_t refs = 0) : locale::facet(refs) {}
  iter_type put(iter_type out, bool intl, ios_base &format, char_type fill,
                long double units) const {
    return do_put(out, intl, format, fill, units);
  }
  iter_type put(iter_type out, bool intl, ios_base &format, char_type fill,
                const string_type &digits) const {
    return do_put(out, intl, format, fill, digits);
  }
  inline static locale::id id{};
protected:
  ~money_put() override = default;
  virtual iter_type do_put(iter_type out, bool intl, ios_base &format,
                           char_type fill, long double units) const {
    const int count = ::snprintf(nullptr, 0, "%.0Lf", units);
    if (count < 0)
      return out;
    string buffer(static_cast<size_t>(count) + 1, '\0');
    if (::snprintf(buffer.data(), buffer.size(), "%.0Lf", units) != count)
      return out;
    string_type digits;
    digits.reserve(static_cast<size_t>(count));
    for (int index = 0; index < count; ++index)
      digits.push_back(static_cast<char_type>(buffer[index]));
    return do_put(out, intl, format, fill, digits);
  }
  virtual iter_type do_put(iter_type out, bool intl, ios_base &format,
                           char_type fill, const string_type &digits) const {
    const locale where = format_locale(format);
    bool negative = !digits.empty() && digits[0] == static_cast<char_type>('-');
    string_type symbol, positive, negative_sign;
    string grouping;
    money_base::pattern pattern{};
    int fractional;
    char_type decimal, separator;
    if (intl) {
      const auto &punctuation = use_facet<moneypunct<char_type, true>>(where);
      symbol = punctuation.curr_symbol(); positive = punctuation.positive_sign();
      negative_sign = punctuation.negative_sign(); grouping = punctuation.grouping();
      pattern = negative ? punctuation.neg_format() : punctuation.pos_format();
      fractional = punctuation.frac_digits(); decimal = punctuation.decimal_point();
      separator = punctuation.thousands_sep();
    } else {
      const auto &punctuation = use_facet<moneypunct<char_type, false>>(where);
      symbol = punctuation.curr_symbol(); positive = punctuation.positive_sign();
      negative_sign = punctuation.negative_sign(); grouping = punctuation.grouping();
      pattern = negative ? punctuation.neg_format() : punctuation.pos_format();
      fractional = punctuation.frac_digits(); decimal = punctuation.decimal_point();
      separator = punctuation.thousands_sep();
    }
    if (!detail::locale_stream_showbase(format)) symbol.clear();
    const string_type &sign_text = negative ? negative_sign : positive;
    size_t begin = negative ? 1 : 0, count = 0;
    while (begin + count < digits.size()) {
      char value = static_cast<char>(digits[begin + count]);
      if (value < '0' || value > '9') break;
      ++count;
    }
    string_type number;
    if (fractional > 0 && count <= static_cast<size_t>(fractional)) {
      number.push_back(static_cast<char_type>('0')); number.push_back(decimal);
      for (size_t zeros = static_cast<size_t>(fractional) - count; zeros; --zeros)
        number.push_back(static_cast<char_type>('0'));
      number.append(digits.data() + begin, count);
    } else {
      size_t whole = fractional > 0 ? count - static_cast<size_t>(fractional) : count;
      number.append(digits.data() + begin, whole);
      if (!grouping.empty()) {
        size_t position = whole, rule = 0;
        unsigned char group = static_cast<unsigned char>(grouping[0]);
        while (group && group != static_cast<unsigned char>(CHAR_MAX) && position > group) {
          position -= group;
          number.insert(number.begin() + static_cast<ptrdiff_t>(position), separator);
          if (rule + 1 < grouping.size()) {
            unsigned char next = static_cast<unsigned char>(grouping[++rule]);
            if (next) group = next;
          }
        }
      }
      if (fractional > 0) {
        number.push_back(decimal);
        number.append(digits.data() + begin + whole, static_cast<size_t>(fractional));
      }
    }
    string_type result;
    size_t internal_position = 0;
    for (int index = 0; index < 4; ++index) {
      switch (static_cast<money_base::part>(pattern.field[index])) {
      case money_base::symbol: result += symbol; break;
      case money_base::sign:
        if (!sign_text.empty()) result.push_back(sign_text[0]);
        break;
      case money_base::value: result += number; break;
      case money_base::space: result.push_back(static_cast<char_type>(' '));
        [[fallthrough]];
      case money_base::none: internal_position = result.size(); break;
      }
    }
    if (sign_text.size() > 1) result.append(sign_text.data() + 1, sign_text.size() - 1);
    streamsize width = detail::locale_stream_take_width(format);
    streamsize padding = width > static_cast<streamsize>(result.size())
        ? width - static_cast<streamsize>(result.size()) : 0;
    int adjustment = detail::locale_stream_adjust(format);
    if (adjustment == 2 && padding > 0) {
      result.insert(internal_position, static_cast<size_t>(padding), fill);
      padding = 0;
    }
    if (adjustment == 0) while (padding-- > 0) *out++ = fill;
    for (char_type value : result) *out++ = value;
    if (adjustment == 1) while (padding-- > 0) *out++ = fill;
    return out;
  }
private:
  static locale format_locale(ios_base &);
};

