/*
 * <locale> must not depend on <mutex>.
 *
 * <mutex> itself depends on <chrono> for timed locking,
 * while C++23 chrono stream I/O depends on the iostream
 * stack. Pulling <mutex> through <locale> therefore creates
 * a real header cycle:
 *
 *   ios -> locale -> mutex -> chrono -> ostream -> ios
 *
 * The messages catalog only needs a tiny internal lock,
 * so keep that synchronization entirely inside <locale>.
 */
class locale_catalog_mutex {
public:
  constexpr locale_catalog_mutex() noexcept = default;

  locale_catalog_mutex(
      const locale_catalog_mutex &) = delete;

  locale_catalog_mutex &
  operator=(
      const locale_catalog_mutex &) = delete;

  void lock() noexcept {
    unsigned expected = 0;

    while (!state_.compare_exchange_weak(
        expected,
        1,
        memory_order_acquire,
        memory_order_relaxed)) {
      if (expected != 0) {
        state_.wait(
            expected,
            memory_order_relaxed);
      }

      expected = 0;
    }
  }

  void unlock() noexcept {
    state_.store(
        0,
        memory_order_release);

    state_.notify_one();
  }

private:
  atomic<unsigned> state_{0};
};

template <class Mutex>
class locale_catalog_lock_guard {
public:
  explicit locale_catalog_lock_guard(
      Mutex &mutex) noexcept
      : mutex_(mutex) {
    mutex_.lock();
  }

  ~locale_catalog_lock_guard() {
    mutex_.unlock();
  }

  locale_catalog_lock_guard(
      const locale_catalog_lock_guard &) =
      delete;

  locale_catalog_lock_guard &
  operator=(
      const locale_catalog_lock_guard &) =
      delete;

private:
  Mutex &mutex_;
};

