  locale_named_messages_context(const locale_named_messages_context &) = delete;

  locale_named_messages_context &
  operator=(const locale_named_messages_context &) = delete;

  ~locale_named_messages_context() { ftl_locale_runtime::destroy(native); }
};

struct locale_message_catalog_entry {
  ftl_locale_runtime::native_catalog native;
  locale conversion_locale;

  locale_message_catalog_entry(
      ftl_locale_runtime::native_catalog native_catalog,
      const locale &conversion)
      : native(native_catalog), conversion_locale(conversion) {}

  locale_message_catalog_entry(const locale_message_catalog_entry &) = delete;

  locale_message_catalog_entry &
  operator=(const locale_message_catalog_entry &) = delete;

  ~locale_message_catalog_entry() {
    ftl_locale_runtime::close_message_catalog(native);
  }
};

template <class Character>
[[nodiscard]]
inline basic_string<Character>
locale_convert_message(const char *source, const locale &conversion_locale,
                       const basic_string<Character> &fallback) {
  if (source == nullptr)
    return fallback;

  if constexpr (is_same_v<Character, char>) {
    return basic_string<char>(source);
  } else {
    static_assert(is_same_v<Character, wchar_t>,
                  "FTL provides messages for char and wchar_t");

    if (!has_facet<codecvt<wchar_t, char, mbstate_t>>(conversion_locale)) {
      return fallback;
    }

    size_t source_size = 0;

    while (source[source_size] != '\0')
      ++source_size;

    if (source_size == 0)
      return {};

    basic_string<wchar_t> result(source_size, wchar_t{});

    const auto &conversion =
        use_facet<codecvt<wchar_t, char, mbstate_t>>(conversion_locale);

    mbstate_t state{};

    const char *from_next = source;

    wchar_t *to_begin = result.data();

    wchar_t *to_next = to_begin;

    const auto status =
        conversion.in(state, source, source + source_size, from_next, to_begin,
                      to_begin + result.size(), to_next);

    if (status != codecvt_base::ok || from_next != source + source_size) {
      return fallback;
    }

    result.resize(static_cast<size_t>(to_next - to_begin));

    return result;
  }
}

