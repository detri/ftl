struct locale_facet_slot {
  const locale::id *key;
  locale_facet_control *control;
};

struct locale_state {
  atomic<size_t> references;
  bool immortal;
  bool named;
  const char *static_name;
  string owned_name;
  vector<locale_facet_slot> facets;

  locale_state()
      : references(0), immortal(true), named(true), static_name("C"),
        owned_name(), facets() {}

  locale_state(const locale_state &other, bool preserve_name)
      : references(1), immortal(false), named(preserve_name && other.named),
        static_name(named ? other.static_name : nullptr),
        owned_name(named && other.static_name == nullptr ? other.owned_name
                                                         : string{}),
        facets(other.facets) {
    for (auto &slot : facets) {
      if (slot.control != nullptr)
        slot.control->retain();
    }
  }

  locale_state(const locale_state &) = delete;
  locale_state &operator=(const locale_state &) = delete;

  ~locale_state() {
    if (immortal)
      return;

    for (auto &slot : facets) {
      if (slot.control != nullptr)
        slot.control->release();
    }
  }
};

inline void locale_retain_state(locale_state *state) noexcept {
  if (!state->immortal)
    state->references.fetch_add(1, memory_order_relaxed);
}

inline void locale_release_state(locale_state *state) noexcept {
  if (state->immortal)
    return;

  if (state->references.fetch_sub(1, memory_order_release) != 1)
    return;

  atomic_thread_fence(memory_order_acquire);
  delete state;
}

inline locale_state &
locale_classic_state() {
  static locale_state state;

  static const bool initialized = [] {
    state.facets.reserve(16);

    state.facets.push_back(
        {&ctype<char>::id,
         &locale_classic_ctype_char_control()});

    state.facets.push_back(
        {&ctype<wchar_t>::id,
         &locale_classic_ctype_wchar_control()});

    state.facets.push_back(
        {&collate<char>::id,
         &locale_classic_collate_char_control()});

    state.facets.push_back(
        {&collate<wchar_t>::id,
         &locale_classic_collate_wchar_control()});

    state.facets.push_back(
        {&numpunct<char>::id,
         &locale_classic_numpunct_char_control()});

    state.facets.push_back(
        {&numpunct<wchar_t>::id,
         &locale_classic_numpunct_wchar_control()});

    state.facets.push_back(
        {&codecvt<
             char,
             char,
             mbstate_t>::id,
         &locale_classic_codecvt_char_control()});

    state.facets.push_back(
        {&codecvt<
             char16_t,
             char8_t,
             mbstate_t>::id,
         &locale_classic_codecvt_utf16_control()});

    state.facets.push_back(
        {&codecvt<
             char32_t,
             char8_t,
             mbstate_t>::id,
         &locale_classic_codecvt_utf32_control()});

    state.facets.push_back(
        {&codecvt<
             wchar_t,
             char,
             mbstate_t>::id,
         &locale_classic_codecvt_wchar_control()});

    state.facets.push_back(
        {&codecvt<
             char16_t,
             char,
             mbstate_t>::id,
         &locale_classic_codecvt_char16_char_control()});

    state.facets.push_back(
        {&codecvt<
             char32_t,
             char,
             mbstate_t>::id,
         &locale_classic_codecvt_char32_char_control()});

    state.facets.push_back(
        {&moneypunct<char, false>::id,
         &locale_classic_moneypunct_char_control()});

    state.facets.push_back(
        {&moneypunct<wchar_t, false>::id,
         &locale_classic_moneypunct_wchar_control()});

    state.facets.push_back(
        {&moneypunct<char, true>::id,
         &locale_classic_moneypunct_intl_char_control()});

    state.facets.push_back(
        {&moneypunct<wchar_t, true>::id,
         &locale_classic_moneypunct_intl_wchar_control()});

    return true;
  }();

  (void)initialized;

  return state;
}

