inline locale_named_numeric_snapshot
locale_load_numeric_snapshot(const char *name,
                             ftl_locale_runtime::native_handle native) {
#if defined(_WIN32)
  locale_windows_numeric_scope scope(name);
#else
  locale_posix_numeric_scope scope(native);
  (void)name;
#endif

  ::lconv *information = ::localeconv();

  if (information == nullptr)
    locale_named_numpunct_failure();

  locale_named_numeric_snapshot result;

  if (information->decimal_point != nullptr)
    result.decimal_point = information->decimal_point;

  if (information->thousands_sep != nullptr)
    result.thousands_sep = information->thousands_sep;

  if (information->grouping != nullptr)
    result.grouping = information->grouping;

  return result;
}

struct locale_named_numpunct_context {
  ftl_locale_runtime::native_handle native{};
  locale_named_numeric_snapshot punctuation;

  explicit locale_named_numpunct_context(const char *name)
      : native(ftl_locale_runtime::create_numeric(name)) {
    if (native == nullptr)
      locale_named_numpunct_failure();

#if FTL_HAS_EXCEPTIONS
    try {
      punctuation = locale_load_numeric_snapshot(name, native);
    } catch (...) {
      ftl_locale_runtime::destroy(native);
      native = nullptr;
      throw;
    }
#else
    punctuation = locale_load_numeric_snapshot(name, native);
#endif
  }

  locale_named_numpunct_context(const locale_named_numpunct_context &) = delete;

  locale_named_numpunct_context &
  operator=(const locale_named_numpunct_context &) = delete;

  ~locale_named_numpunct_context() { ftl_locale_runtime::destroy(native); }
};

template <class Character>
[[nodiscard]]
inline Character
locale_named_numeric_character(const locale_named_numpunct_context &context,
                               const string &value, char fallback) noexcept {
  if (value.empty())
    return static_cast<Character>(fallback);

  if constexpr (is_same_v<Character, char>) {
    return value[0];
  } else {
    return ftl_locale_runtime::widen_first(context.native, value.c_str(),
                                           static_cast<wchar_t>(fallback));
  }
}

template <class Character>
[[nodiscard]]
inline basic_string<Character> locale_ascii_string(const char *value) {
  basic_string<Character> result;

  while (*value != '\0') {
    result.push_back(static_cast<Character>(*value++));
  }

  return result;
}

enum class codecvt_decode_status { complete, partial, error };

struct codecvt_decoded_scalar {
  codecvt_decode_status status;
  unsigned value;
  size_t units;
};

[[nodiscard]]
constexpr bool codecvt_valid_scalar(unsigned value) noexcept {
  return value <= 0x10ffffu && !(value >= 0xd800u && value <= 0xdfffu);
}

template <class Byte>
[[nodiscard]]
inline codecvt_decoded_scalar codecvt_decode_utf8(const Byte *first,
                                                  const Byte *last) noexcept {
  static_assert(is_same_v<Byte, char> || is_same_v<Byte, char8_t>);

  if (first == last)
    return {codecvt_decode_status::partial, 0, 0};

  const unsigned first_byte = static_cast<unsigned char>(*first);

  if (first_byte <= 0x7fu) {
    return {codecvt_decode_status::complete, first_byte, 1};
  }

  unsigned count = 0;
  unsigned value = 0;
  unsigned minimum = 0;

  if (first_byte >= 0xc2u && first_byte <= 0xdfu) {
    count = 2;
    value = first_byte & 0x1fu;
    minimum = 0x80u;
  } else if (first_byte >= 0xe0u && first_byte <= 0xefu) {
    count = 3;
    value = first_byte & 0x0fu;
    minimum = 0x800u;
  } else if (first_byte >= 0xf0u && first_byte <= 0xf4u) {
    count = 4;
    value = first_byte & 0x07u;
    minimum = 0x10000u;
  } else {
    return {codecvt_decode_status::error, 0, 0};
  }

  if (static_cast<size_t>(last - first) < count) {
    return {codecvt_decode_status::partial, 0, 0};
  }

  for (unsigned index = 1; index < count; ++index) {
    const unsigned byte = static_cast<unsigned char>(first[index]);

    if (byte < 0x80u || byte > 0xbfu) {
      return {codecvt_decode_status::error, 0, 0};
    }

    value = (value << 6u) | (byte & 0x3fu);
  }

  if (value < minimum || !codecvt_valid_scalar(value)) {
    return {codecvt_decode_status::error, 0, 0};
  }

  return {codecvt_decode_status::complete, value, count};
}

[[nodiscard]]
inline codecvt_decoded_scalar
codecvt_decode_utf16(const char16_t *first, const char16_t *last) noexcept {
  if (first == last)
    return {codecvt_decode_status::partial, 0, 0};

  const unsigned first_unit = static_cast<unsigned>(*first);

  if (first_unit >= 0xd800u && first_unit <= 0xdbffu) {
    if (last - first < 2) {
      return {codecvt_decode_status::partial, 0, 0};
    }

    const unsigned second_unit = static_cast<unsigned>(first[1]);

    if (second_unit < 0xdc00u || second_unit > 0xdfffu) {
      return {codecvt_decode_status::error, 0, 0};
    }

    return {codecvt_decode_status::complete,
            0x10000u + ((first_unit - 0xd800u) << 10u) +
                (second_unit - 0xdc00u),
            2};
  }

  if (first_unit >= 0xdc00u && first_unit <= 0xdfffu) {
    return {codecvt_decode_status::error, 0, 0};
  }

  return {codecvt_decode_status::complete, first_unit, 1};
}

template <class Byte>
[[nodiscard]]
inline size_t codecvt_encode_utf8(unsigned value, Byte (&output)[4]) noexcept {
  static_assert(is_same_v<Byte, char> || is_same_v<Byte, char8_t>);

  if (!codecvt_valid_scalar(value))
    return 0;

  if (value <= 0x7fu) {
    output[0] = static_cast<Byte>(value);

    return 1;
  }

  if (value <= 0x7ffu) {
    output[0] = static_cast<Byte>(0xc0u | (value >> 6u));

    output[1] = static_cast<Byte>(0x80u | (value & 0x3fu));

    return 2;
  }

  if (value <= 0xffffu) {
    output[0] = static_cast<Byte>(0xe0u | (value >> 12u));

    output[1] = static_cast<Byte>(0x80u | ((value >> 6u) & 0x3fu));

    output[2] = static_cast<Byte>(0x80u | (value & 0x3fu));

    return 3;
  }

  output[0] = static_cast<Byte>(0xf0u | (value >> 18u));

  output[1] = static_cast<Byte>(0x80u | ((value >> 12u) & 0x3fu));

  output[2] = static_cast<Byte>(0x80u | ((value >> 6u) & 0x3fu));

  output[3] = static_cast<Byte>(0x80u | (value & 0x3fu));

  return 4;
}

} // namespace detail

class codecvt_base {
public:
  enum result { ok, partial, error, noconv };
};

template <class InternT, class ExternT, class StateT>
class codecvt : public locale::facet, public codecvt_base {
public:
  using intern_type = InternT;
  using extern_type = ExternT;
  using state_type = StateT;

  explicit codecvt(size_t refs = 0) : locale::facet(refs) {}

  result out(state_type &state, const intern_type *from,
             const intern_type *from_end, const intern_type *&from_next,
             extern_type *to, extern_type *to_end,
             extern_type *&to_next) const {
    return do_out(state, from, from_end, from_next, to, to_end, to_next);
  }

  result unshift(state_type &state, extern_type *to, extern_type *to_end,
                 extern_type *&to_next) const {
    return do_unshift(state, to, to_end, to_next);
  }

  result in(state_type &state, const extern_type *from,
            const extern_type *from_end, const extern_type *&from_next,
            intern_type *to, intern_type *to_end, intern_type *&to_next) const {
    return do_in(state, from, from_end, from_next, to, to_end, to_next);
  }

  [[nodiscard]]
  int encoding() const noexcept {
    return do_encoding();
  }

  [[nodiscard]]
  bool always_noconv() const noexcept {
    return do_always_noconv();
  }

  int length(state_type &state, const extern_type *from,
             const extern_type *from_end, size_t maximum) const {
    return do_length(state, from, from_end, maximum);
  }

  [[nodiscard]]
  int max_length() const noexcept {
    return do_max_length();
  }

  inline static locale::id id{};

protected:
  ~codecvt() override = default;

  virtual result do_out(state_type &state, const intern_type *from,
                        const intern_type *from_end,
                        const intern_type *&from_next, extern_type *to,
                        extern_type *to_end, extern_type *&to_next) const {
    (void)state;

    from_next = from;
    to_next = to;

    //
    // codecvt<char, char, mbstate_t>
    //
    if constexpr (is_same_v<intern_type, char> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      return noconv;
    }

    //
    // UTF-16 -> UTF-8 (char8_t)
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char16_t *current = from;
      char8_t *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf16(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        char8_t encoded[4]{};

        const size_t count =
            detail::codecvt_encode_utf8(decoded.value, encoded);

        if (count == 0) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (static_cast<size_t>(to_end - output) < count) {
          from_next = current;
          to_next = output;
          return partial;
        }

        for (size_t index = 0; index < count; ++index) {
          *output++ = encoded[index];
        }

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // Deprecated UTF-16 -> UTF-8 stored in char.
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char16_t *current = from;
      char *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf16(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        char encoded[4]{};

        const size_t count =
            detail::codecvt_encode_utf8(decoded.value, encoded);

        if (count == 0) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (static_cast<size_t>(to_end - output) < count) {
          from_next = current;
          to_next = output;
          return partial;
        }

        for (size_t index = 0; index < count; ++index) {
          *output++ = encoded[index];
        }

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // UTF-32 -> UTF-8 (char8_t)
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char32_t *current = from;
      char8_t *output = to;

      while (current != from_end) {
        const unsigned value = static_cast<unsigned>(*current);

        char8_t encoded[4]{};

        const size_t count = detail::codecvt_encode_utf8(value, encoded);

        if (count == 0) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (static_cast<size_t>(to_end - output) < count) {
          from_next = current;
          to_next = output;
          return partial;
        }

        for (size_t index = 0; index < count; ++index) {
          *output++ = encoded[index];
        }

        ++current;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // Deprecated UTF-32 -> UTF-8 stored in char.
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char32_t *current = from;
      char *output = to;

      while (current != from_end) {
        const unsigned value = static_cast<unsigned>(*current);

        char encoded[4]{};

        const size_t count = detail::codecvt_encode_utf8(value, encoded);

        if (count == 0) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (static_cast<size_t>(to_end - output) < count) {
          from_next = current;
          to_next = output;
          return partial;
        }

        for (size_t index = 0; index < count; ++index) {
          *output++ = encoded[index];
        }

        ++current;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // FTL classic wchar_t -> char.
    //
    else if constexpr (is_same_v<intern_type, wchar_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const wchar_t *current = from;
      char *output = to;

      while (current != from_end) {
        if (output == to_end) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if constexpr (is_signed_v<wchar_t>) {
          if (*current < 0) {
            from_next = current;
            to_next = output;
            return error;
          }
        }

        const unsigned long value = static_cast<unsigned long>(*current);

        if (value > 0x7ful) {
          from_next = current;
          to_next = output;
          return error;
        }

        *output++ = static_cast<char>(static_cast<unsigned char>(value));

        ++current;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    else if constexpr (is_same_v<intern_type, extern_type>) {
      return noconv;
    }

    else {
      return error;
    }
  }

  virtual result do_in(state_type &state, const extern_type *from,
                       const extern_type *from_end,
                       const extern_type *&from_next, intern_type *to,
                       intern_type *to_end, intern_type *&to_next) const {
    (void)state;

    from_next = from;
    to_next = to;

    if constexpr (is_same_v<intern_type, char> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      return noconv;
    }

    //
    // UTF-8 (char8_t) -> UTF-16
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char8_t *current = from;
      char16_t *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        const size_t required = decoded.value <= 0xffffu ? 1 : 2;

        if (static_cast<size_t>(to_end - output) < required) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (required == 1) {
          *output++ = static_cast<char16_t>(decoded.value);
        } else {
          const unsigned value = decoded.value - 0x10000u;

          *output++ = static_cast<char16_t>(0xd800u + (value >> 10u));

          *output++ = static_cast<char16_t>(0xdc00u + (value & 0x3ffu));
        }

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // Deprecated UTF-8 stored in char -> UTF-16.
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      char16_t *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        const size_t required = decoded.value <= 0xffffu ? 1 : 2;

        if (static_cast<size_t>(to_end - output) < required) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (required == 1) {
          *output++ = static_cast<char16_t>(decoded.value);
        } else {
          const unsigned value = decoded.value - 0x10000u;

          *output++ = static_cast<char16_t>(0xd800u + (value >> 10u));

          *output++ = static_cast<char16_t>(0xdc00u + (value & 0x3ffu));
        }

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // UTF-8 (char8_t) -> UTF-32.
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char8_t *current = from;
      char32_t *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (output == to_end) {
          from_next = current;
          to_next = output;
          return partial;
        }

        *output++ = static_cast<char32_t>(decoded.value);

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // Deprecated UTF-8 stored in char -> UTF-32.
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      char32_t *output = to;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status == detail::codecvt_decode_status::partial) {
          from_next = current;
          to_next = output;
          return partial;
        }

        if (decoded.status == detail::codecvt_decode_status::error) {
          from_next = current;
          to_next = output;
          return error;
        }

        if (output == to_end) {
          from_next = current;
          to_next = output;
          return partial;
        }

        *output++ = static_cast<char32_t>(decoded.value);

        current += decoded.units;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    //
    // FTL classic char -> wchar_t.
    //
    else if constexpr (is_same_v<intern_type, wchar_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      wchar_t *output = to;

      while (current != from_end) {
        if (output == to_end) {
          from_next = current;
          to_next = output;
          return partial;
        }

        const unsigned char value = static_cast<unsigned char>(*current);

        if (value > 0x7fu) {
          from_next = current;
          to_next = output;
          return error;
        }

        *output++ = static_cast<wchar_t>(value);

        ++current;
      }

      from_next = current;
      to_next = output;
      return ok;
    }

    else if constexpr (is_same_v<intern_type, extern_type>) {
      return noconv;
    }

    else {
      return error;
    }
  }

  virtual result do_unshift(state_type &state, extern_type *to,
                            extern_type *to_end, extern_type *&to_next) const {
    (void)state;
    (void)to_end;

    to_next = to;

    //
    // Every encoding currently supplied by FTL is stateless.
    //
    return noconv;
  }

  [[nodiscard]]
  virtual int do_encoding() const noexcept {
    if constexpr (is_same_v<intern_type, char> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      return 1;
    }

    else if constexpr (is_same_v<intern_type, wchar_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      return 1;
    }

    else if constexpr ((is_same_v<intern_type, char16_t> ||
                        is_same_v<intern_type, char32_t>) &&
                       (is_same_v<extern_type, char8_t> ||
                        is_same_v<extern_type, char>) &&
                       is_same_v<state_type, mbstate_t>) {
      return 0;
    }

    else if constexpr (is_same_v<intern_type, extern_type>) {
      return 1;
    }

    else {
      return 0;
    }
  }

  [[nodiscard]]
  virtual bool do_always_noconv() const noexcept {
    return is_same_v<intern_type, extern_type>;
  }

  virtual int do_length(state_type &state, const extern_type *from,
                        const extern_type *from_end, size_t maximum) const {
    (void)state;

    //
    // Identity conversion.
    //
    if constexpr (is_same_v<intern_type, char> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      const size_t available = static_cast<size_t>(from_end - from);

      const size_t count = available < maximum ? available : maximum;

      return static_cast<int>(count);
    }

    //
    // UTF-8 (char8_t) -> UTF-16.
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char8_t *current = from;
      size_t produced = 0;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status != detail::codecvt_decode_status::complete) {
          break;
        }

        const size_t required = decoded.value <= 0xffffu ? 1 : 2;

        if (produced + required > maximum)
          break;

        produced += required;
        current += decoded.units;
      }

      return static_cast<int>(current - from);
    }

    //
    // Deprecated UTF-8 stored in char -> UTF-16.
    //
    else if constexpr (is_same_v<intern_type, char16_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      size_t produced = 0;

      while (current != from_end) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status != detail::codecvt_decode_status::complete) {
          break;
        }

        const size_t required = decoded.value <= 0xffffu ? 1 : 2;

        if (produced + required > maximum)
          break;

        produced += required;
        current += decoded.units;
      }

      return static_cast<int>(current - from);
    }

    //
    // UTF-8 (char8_t) -> UTF-32.
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char8_t> &&
                       is_same_v<state_type, mbstate_t>) {
      const char8_t *current = from;
      size_t produced = 0;

      while (current != from_end && produced < maximum) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status != detail::codecvt_decode_status::complete) {
          break;
        }

        ++produced;
        current += decoded.units;
      }

      return static_cast<int>(current - from);
    }

    //
    // Deprecated UTF-8 stored in char -> UTF-32.
    //
    else if constexpr (is_same_v<intern_type, char32_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      size_t produced = 0;

      while (current != from_end && produced < maximum) {
        const auto decoded = detail::codecvt_decode_utf8(current, from_end);

        if (decoded.status != detail::codecvt_decode_status::complete) {
          break;
        }

        ++produced;
        current += decoded.units;
      }

      return static_cast<int>(current - from);
    }

    //
    // Classic narrow -> wide.
    //
    else if constexpr (is_same_v<intern_type, wchar_t> &&
                       is_same_v<extern_type, char> &&
                       is_same_v<state_type, mbstate_t>) {
      const char *current = from;
      size_t produced = 0;

      while (current != from_end && produced < maximum) {
        if (static_cast<unsigned char>(*current) > 0x7fu) {
          break;
        }

        ++current;
        ++produced;
      }

      return static_cast<int>(current - from);
    }

    else if constexpr (is_same_v<intern_type, extern_type>) {
      const size_t available = static_cast<size_t>(from_end - from);

      return static_cast<int>(available < maximum ? available : maximum);
    }

    else {
      return 0;
    }
  }

  [[nodiscard]]
  virtual int do_max_length() const noexcept {
    if constexpr (is_same_v<intern_type, char16_t> &&
                  (is_same_v<extern_type, char8_t> ||
                   is_same_v<extern_type, char>) &&
                  is_same_v<state_type, mbstate_t>) {
      return 3;
    }

    else if constexpr (is_same_v<intern_type, char32_t> &&
                       (is_same_v<extern_type, char8_t> ||
                        is_same_v<extern_type, char>) &&
                       is_same_v<state_type, mbstate_t>) {
      return 4;
    }

    else {
      return 1;
    }
  }
};

namespace detail {

[[noreturn]]
inline void locale_named_codecvt_failure() {
#if FTL_HAS_EXCEPTIONS
  throw runtime_error("codecvt_byname");
#else
  terminate();
#endif
}

struct locale_named_codecvt_context {
  ftl_locale_runtime::native_handle native{};

  explicit locale_named_codecvt_context(const char *name)
      : native(ftl_locale_runtime::create_ctype(name)) {
    if (native == nullptr)
      locale_named_codecvt_failure();

    if (ftl_locale_runtime::multibyte_is_stateful(native)) {
      ftl_locale_runtime::destroy(native);
      native = nullptr;

      locale_named_codecvt_failure();
    }
  }

  locale_named_codecvt_context(const locale_named_codecvt_context &) = delete;

  locale_named_codecvt_context &
  operator=(const locale_named_codecvt_context &) = delete;

  ~locale_named_codecvt_context() { ftl_locale_runtime::destroy(native); }
};

} // namespace detail

template <class InternT, class ExternT, class StateT>
class codecvt_byname : public codecvt<InternT, ExternT, StateT> {
public:
  using base_type = codecvt<InternT, ExternT, StateT>;

  using intern_type = typename base_type::intern_type;

  using extern_type = typename base_type::extern_type;

  using state_type = typename base_type::state_type;

  explicit codecvt_byname(const char *name, size_t refs = 0)
      : base_type(refs),
        context_(new detail::locale_named_codecvt_context(name)) {}

  explicit codecvt_byname(const string &name, size_t refs = 0)
      : codecvt_byname(name.c_str(), refs) {}

protected:
  ~codecvt_byname() override { delete context_; }

  typename codecvt_base::result do_out(state_type &state,
                                       const intern_type *from,
                                       const intern_type *from_end,
                                       const intern_type *&from_next,
                                       extern_type *to, extern_type *to_end,
                                       extern_type *&to_next) const override {
    //
    // char/char and the UTF-fixed standard specializations do not
    // acquire different encodings merely because a named locale was
    // requested. wchar_t/char represents the native locale encoding
    // and is the one case whose conversion semantics vary by name.
    //
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      (void)state;

      from_next = from;
      to_next = to;

      const wchar_t *current = from;
      char *output = to;

      while (current != from_end) {
        const auto encoded =
            ftl_locale_runtime::encode_wide(context_->native, *current);

        if (!encoded.valid) {
          from_next = current;
          to_next = output;
          return codecvt_base::error;
        }

        if (static_cast<size_t>(to_end - output) < encoded.produced) {
          from_next = current;
          to_next = output;
          return codecvt_base::partial;
        }

        for (size_t index = 0; index < encoded.produced; ++index) {
          *output++ = encoded.bytes[index];
        }

        ++current;
      }

      from_next = current;
      to_next = output;

      return codecvt_base::ok;
    } else {
      return base_type::do_out(state, from, from_end, from_next, to, to_end,
                               to_next);
    }
  }

  typename codecvt_base::result
  do_in(state_type &state, const extern_type *from, const extern_type *from_end,
        const extern_type *&from_next, intern_type *to, intern_type *to_end,
        intern_type *&to_next) const override {
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      (void)state;

      from_next = from;
      to_next = to;

      const char *current = from;
      wchar_t *output = to;

      while (current != from_end) {
        if (output == to_end) {
          from_next = current;
          to_next = output;
          return codecvt_base::partial;
        }

        const auto decoded = ftl_locale_runtime::decode_wide(context_->native,
                                                             current, from_end);

        if (decoded.result ==
            ftl_locale_runtime::decoded_wide::status::partial) {
          from_next = current;
          to_next = output;
          return codecvt_base::partial;
        }

        if (decoded.result == ftl_locale_runtime::decoded_wide::status::error) {
          from_next = current;
          to_next = output;
          return codecvt_base::error;
        }

        *output++ = decoded.value;
        current += decoded.consumed;
      }

      from_next = current;
      to_next = output;

      return codecvt_base::ok;
    } else {
      return base_type::do_in(state, from, from_end, from_next, to, to_end,
                              to_next);
    }
  }

  typename codecvt_base::result
  do_unshift(state_type &state, extern_type *to, extern_type *to_end,
             extern_type *&to_next) const override {
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      (void)state;
      (void)to_end;

      to_next = to;

      return codecvt_base::noconv;
    } else {
      return base_type::do_unshift(state, to, to_end, to_next);
    }
  }

  int do_encoding() const noexcept override {
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      return ftl_locale_runtime::multibyte_max_length(context_->native) == 1
                 ? 1
                 : 0;
    } else {
      return base_type::do_encoding();
    }
  }

  bool do_always_noconv() const noexcept override {
    return base_type::do_always_noconv();
  }

  int do_length(state_type &state, const extern_type *from,
                const extern_type *from_end, size_t maximum) const override {
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      (void)state;

      const char *current = from;
      size_t produced = 0;

      while (current != from_end && produced < maximum) {
        const auto decoded = ftl_locale_runtime::decode_wide(context_->native,
                                                             current, from_end);

        if (decoded.result !=
            ftl_locale_runtime::decoded_wide::status::complete) {
          break;
        }

        current += decoded.consumed;
        ++produced;
      }

      return static_cast<int>(current - from);
    } else {
      return base_type::do_length(state, from, from_end, maximum);
    }
  }

  int do_max_length() const noexcept override {
    if constexpr (is_same_v<intern_type, wchar_t> &&
                  is_same_v<extern_type, char> &&
                  is_same_v<state_type, mbstate_t>) {
      return ftl_locale_runtime::multibyte_max_length(context_->native);
    } else {
      return base_type::do_max_length();
    }
  }

private:
  detail::locale_named_codecvt_context *context_;
};

template <class Character> class collate_byname : public collate<Character> {
  static_assert(is_same_v<Character, char> || is_same_v<Character, wchar_t>,
                "FTL provides the standard collate_byname specializations "
                "for char and wchar_t");

public:
  using string_type = basic_string<Character>;

  explicit collate_byname(const char *name, size_t refs = 0)
      : collate<Character>(refs),
        context_(new detail::locale_named_collate_context(name)) {}

  explicit collate_byname(const string &name, size_t refs = 0)
      : collate_byname(name.c_str(), refs) {}

protected:
  ~collate_byname() override { delete context_; }

  int do_compare(const Character *low1, const Character *high1,
                 const Character *low2, const Character *high2) const override {
    const auto left =
        detail::locale_named_collate_transform(context_->native, low1, high1);

    const auto right =
        detail::locale_named_collate_transform(context_->native, low2, high2);

    return detail::collate_lexicographical_compare(
        left.data(), left.data() + left.size(), right.data(),
        right.data() + right.size());
  }

  string_type do_transform(const Character *low,
                           const Character *high) const override {
    return detail::locale_named_collate_transform(context_->native, low, high);
  }

  long do_hash(const Character *low, const Character *high) const override {
    const auto transformed = do_transform(low, high);

    return detail::locale_named_collate_hash(transformed);
  }

private:
  detail::locale_named_collate_context *context_;
};

template <class Character> class numpunct : public locale::facet {
  static_assert(is_same_v<Character, char> || is_same_v<Character, wchar_t>,
                "FTL provides the required numpunct specializations "
                "for char and wchar_t");

public:
  using char_type = Character;
  using string_type = basic_string<Character>;

  explicit numpunct(size_t refs = 0) : locale::facet(refs) {}

  [[nodiscard]]
  char_type decimal_point() const {
    return do_decimal_point();
  }

  [[nodiscard]]
  char_type thousands_sep() const {
    return do_thousands_sep();
  }

  [[nodiscard]]
  string grouping() const {
    return do_grouping();
  }

  [[nodiscard]]
  string_type truename() const {
    return do_truename();
  }

  [[nodiscard]]
  string_type falsename() const {
    return do_falsename();
  }

  inline static locale::id id{};

protected:
  ~numpunct() override = default;

  virtual char_type do_decimal_point() const {
    return static_cast<char_type>('.');
  }

  virtual char_type do_thousands_sep() const {
    return static_cast<char_type>(',');
  }

  virtual string do_grouping() const { return {}; }

  virtual string_type do_truename() const {
    return detail::locale_ascii_string<char_type>("true");
  }

  virtual string_type do_falsename() const {
    return detail::locale_ascii_string<char_type>("false");
  }
};

template <class Character> class numpunct_byname : public numpunct<Character> {
  static_assert(is_same_v<Character, char> || is_same_v<Character, wchar_t>,
                "FTL provides numpunct_byname specializations "
                "for char and wchar_t");

public:
  using char_type = Character;
  using string_type = basic_string<Character>;

  explicit numpunct_byname(const char *name, size_t refs = 0)
      : numpunct<Character>(refs),
        context_(new detail::locale_named_numpunct_context(name)) {}

  explicit numpunct_byname(const string &name, size_t refs = 0)
      : numpunct_byname(name.c_str(), refs) {}

protected:
  ~numpunct_byname() override { delete context_; }

  char_type do_decimal_point() const override {
    return detail::locale_named_numeric_character<Character>(
        *context_, context_->punctuation.decimal_point, '.');
  }

  char_type do_thousands_sep() const override {
    //
    // The C locale reports no active grouping separator because
    // grouping itself is empty. numpunct still requires a character
    // result, so retain the classic comma when the runtime provides
    // no separator.
    //
    return detail::locale_named_numeric_character<Character>(
        *context_, context_->punctuation.thousands_sep, ',');
  }

  string do_grouping() const override { return context_->punctuation.grouping; }

private:
  detail::locale_named_numpunct_context *context_;
};

namespace detail {
struct locale_named_time_context {
  string name;
  ftl_locale_runtime::native_handle native;
  explicit locale_named_time_context(const char *value)
      : name(value ? value : ""), native(ftl_locale_runtime::create_time(value)) {
    if (!native) locale_named_numpunct_failure();
  }
  locale_named_time_context(const locale_named_time_context &) = delete;
  locale_named_time_context &operator=(const locale_named_time_context &) = delete;
  ~locale_named_time_context() { ftl_locale_runtime::destroy(native); }
};

#if defined(_WIN32)
class locale_windows_time_scope {
public:
  explicit locale_windows_time_scope(const char *name)
      : previous_mode_(ftl_locale_runtime::_configthreadlocale(1)) {
    const char *current = ::setlocale(LC_TIME, nullptr);
    if (current) previous_ = current;
    if (::setlocale(LC_TIME, name) == nullptr) locale_named_numpunct_failure();
  }
  ~locale_windows_time_scope() {
    if (!previous_.empty()) (void)::setlocale(LC_TIME, previous_.c_str());
    if (previous_mode_ != -1) (void)ftl_locale_runtime::_configthreadlocale(previous_mode_);
  }
private:
  int previous_mode_;
  string previous_;
};
#endif

inline size_t locale_named_time_format(const locale_named_time_context &context,
                                       char *buffer, size_t count,
                                       const char *pattern, const tm *value) {
#if defined(_WIN32)
  locale_windows_time_scope scope(context.name.c_str());
#else
  locale_posix_numeric_scope scope(context.native);
#endif
  return strftime(buffer, count, pattern, value);
}
} // namespace detail

template <class Character,
          class InputIterator = istreambuf_iterator<Character>>
class num_get : public locale::facet {
public:
  using char_type = Character;
  using iter_type = InputIterator;

  explicit num_get(size_t refs = 0) : locale::facet(refs) {}
  iter_type get(iter_type in, iter_type end, ios_base &format,
                unsigned int &error, bool &value) const {
    return do_get(in, end, format, error, value);
  }
#define FTL_NUM_GET_PUBLIC(Type) \
  iter_type get(iter_type in, iter_type end, ios_base &format, \
                unsigned int &error, Type &value) const { \
    return do_get(in, end, format, error, value); \
  }
  FTL_NUM_GET_PUBLIC(long)
  FTL_NUM_GET_PUBLIC(long long)
  FTL_NUM_GET_PUBLIC(unsigned short)
  FTL_NUM_GET_PUBLIC(unsigned int)
  FTL_NUM_GET_PUBLIC(unsigned long)
  FTL_NUM_GET_PUBLIC(unsigned long long)
  FTL_NUM_GET_PUBLIC(float)
  FTL_NUM_GET_PUBLIC(double)
  FTL_NUM_GET_PUBLIC(long double)
  FTL_NUM_GET_PUBLIC(void *)
#undef FTL_NUM_GET_PUBLIC
  inline static locale::id id{};

protected:
  ~num_get() override = default;

  virtual iter_type do_get(iter_type in, iter_type end, ios_base &format,
                           unsigned int &error, bool &value) const {
    char token[512]; size_t count = 0;
    in = collect(in, end, token, count, format, false,
                 detail::locale_stream_boolalpha(format));
    if (detail::locale_stream_boolalpha(format)) {
      const locale where = format_locale(format);
      const auto &punctuation = use_facet<numpunct<char_type>>(where);
      if (equals(token, count, punctuation.truename())) value = true;
      else if (equals(token, count, punctuation.falsename())) value = false;
      else error |= stream_failbit();
    } else {
      normalize(token, count, format);
      char *last = nullptr; errno = 0; long parsed = ::strtol(token, &last, detail::locale_stream_base(format));
      if (errno == ERANGE || last != token + count || (parsed != 0 && parsed != 1)) error |= stream_failbit();
      value = parsed != 0;
    }
    if (in == end) error |= stream_eofbit();
    return in;
  }
#define FTL_NUM_GET_SIGNED(Type) \
  virtual iter_type do_get(iter_type in, iter_type end, ios_base &format, \
                           unsigned int &error, Type &value) const { \
    char token[512]; size_t count = 0; in = collect(in, end, token, count, format, false, false); normalize(token, count, format); \
    char *last = nullptr; errno = 0; long long parsed = ::strtoll(token, &last, detail::locale_stream_base(format)); \
    if (errno == ERANGE || last != token + count || !assign_signed(parsed, value)) error |= stream_failbit(); \
    if (in == end) error |= stream_eofbit(); return in; \
  }
  FTL_NUM_GET_SIGNED(long)
  FTL_NUM_GET_SIGNED(long long)
#undef FTL_NUM_GET_SIGNED
#define FTL_NUM_GET_UNSIGNED(Type) \
  virtual iter_type do_get(iter_type in, iter_type end, ios_base &format, \
                           unsigned int &error, Type &value) const { \
    char token[512]; size_t count = 0; in = collect(in, end, token, count, format, false, false); normalize(token, count, format); \
    char *last = nullptr; errno = 0; unsigned long long parsed = ::strtoull(token, &last, detail::locale_stream_base(format)); \
    if (errno == ERANGE || last != token + count || !assign_unsigned(parsed, value)) error |= stream_failbit(); \
    if (in == end) error |= stream_eofbit(); return in; \
  }
  FTL_NUM_GET_UNSIGNED(unsigned short)
  FTL_NUM_GET_UNSIGNED(unsigned int)
  FTL_NUM_GET_UNSIGNED(unsigned long)
  FTL_NUM_GET_UNSIGNED(unsigned long long)
#undef FTL_NUM_GET_UNSIGNED
#define FTL_NUM_GET_FLOAT(Type) \
  virtual iter_type do_get(iter_type in, iter_type end, ios_base &format, \
                           unsigned int &error, Type &value) const { \
    char token[512]; size_t count = 0; in = collect(in, end, token, count, format, true, false); normalize(token, count, format); \
    char *last = nullptr; errno = 0; long double parsed = ::strtold(token, &last); \
    if (errno == ERANGE || last != token + count || !assign_float(parsed, value)) error |= stream_failbit(); \
    if (in == end) error |= stream_eofbit(); return in; \
  }
  FTL_NUM_GET_FLOAT(float)
  FTL_NUM_GET_FLOAT(double)
  FTL_NUM_GET_FLOAT(long double)
#undef FTL_NUM_GET_FLOAT
  virtual iter_type do_get(iter_type in, iter_type end, ios_base &format,
                           unsigned int &error, void *&value) const {
    unsigned long long parsed = 0;
    in = do_get(in, end, format, error, parsed);
    value = reinterpret_cast<void *>(static_cast<size_t>(parsed));
    return in;
  }

private:
  static unsigned int stream_failbit();
  static unsigned int stream_eofbit();
  static locale format_locale(ios_base &);
  bool accepted(char value, ios_base &format, bool floating, bool alpha,
                const char *token, size_t count) const {
    const locale where = format_locale(format);
    const auto &punctuation = use_facet<numpunct<char_type>>(where);
    if ((value >= '0' && value <= '9') || value == '+' || value == '-' ||
        value == static_cast<char>(punctuation.decimal_point()) ||
        (!punctuation.grouping().empty() &&
         value == static_cast<char>(punctuation.thousands_sep())))
      return true;
    if (alpha) return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z');
    int base = detail::locale_stream_base(format);
    size_t numeric_start = count && (token[0] == '+' || token[0] == '-') ? 1 : 0;
    bool hexadecimal = base == 16 ||
        (base == 0 && count >= numeric_start + 2 && token[numeric_start] == '0' &&
         (token[numeric_start + 1] == 'x' || token[numeric_start + 1] == 'X'));
    if ((hexadecimal || (base == 0 && count == numeric_start + 1 && token[numeric_start] == '0')) &&
        ((value >= 'a' && value <= 'f') ||
                                     (value >= 'A' && value <= 'F') ||
                                     value == 'x' || value == 'X')) return true;
    if (!floating) return false;
    if (value == 'e' || value == 'E' || value == 'p' || value == 'P') return true;
    size_t start = numeric_start;
    if (count == start && (value == 'i' || value == 'I' || value == 'n' || value == 'N')) return true;
    if (count > start && (token[start] == 'i' || token[start] == 'I'))
      return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z');
    if (count > start && (token[start] == 'n' || token[start] == 'N'))
      return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z') ||
             value == '(' || value == ')' || value == '_';
    return false;
  }
  iter_type collect(iter_type in, iter_type end, char *token, size_t &count,
                    ios_base &format, bool floating, bool alpha) const {
    while (in != end && count + 1 < 512) {
      char value = static_cast<char>(*in);
      if (!accepted(value, format, floating, alpha, token, count)) break;
      token[count++] = value; ++in;
    }
    token[count] = '\0';
    return in;
  }
  void normalize(char *token, size_t &count, ios_base &format) const {
    const locale where = format_locale(format);
    const auto &punctuation = use_facet<numpunct<char_type>>(where);
    const char decimal = static_cast<char>(punctuation.decimal_point());
    const char separator = static_cast<char>(punctuation.thousands_sep());
    const string grouping = punctuation.grouping();
    size_t groups[64]{}; size_t group_count = 0, digits = 0;
    bool has_separator = false;
    for (size_t index = 0; index < count; ++index) {
      char value = token[index];
      if (value == decimal || value == 'e' || value == 'E' || value == 'p' || value == 'P') break;
      if (value >= '0' && value <= '9') ++digits;
      else if (value == separator) {
        has_separator = true;
        if (group_count < 64) groups[group_count++] = digits;
        digits = 0;
      }
    }
    if (has_separator && group_count < 64) groups[group_count++] = digits;
    bool valid_grouping = !has_separator;
    if (has_separator && !grouping.empty() && group_count > 1) {
      valid_grouping = true; size_t rule_index = 0;
      unsigned char repeated = static_cast<unsigned char>(grouping[0]);
      for (size_t position = group_count; position != 0; --position) {
        unsigned char expected = static_cast<unsigned char>(grouping[rule_index]);
        if (expected == 0) expected = repeated;
        else repeated = expected;
        if (expected == 0 || expected == static_cast<unsigned char>(CHAR_MAX)) {
          valid_grouping = false; break;
        }
        size_t actual = groups[position - 1];
        if ((position == 1 && (actual == 0 || actual > expected)) ||
            (position != 1 && actual != expected)) {
          valid_grouping = false; break;
        }
        if (rule_index + 1 < grouping.size()) ++rule_index;
      }
    }
    size_t output = 0;
    for (size_t input = 0; input < count; ++input) {
      if (valid_grouping && token[input] == separator) continue;
      token[output++] = token[input] == decimal ? '.' : token[input];
    }
    count = output;
    token[count] = '\0';
  }
  template <class String>
  static bool equals(const char *token, size_t count, const String &value) {
    if (count != value.size()) return false;
    for (size_t i = 0; i < count; ++i)
      if (token[i] != static_cast<char>(value[i])) return false;
    return true;
  }
  template <class Value> static bool assign_signed(long long parsed, Value &value) {
    if (parsed < static_cast<long long>(numeric_limits<Value>::min())) {
      value = numeric_limits<Value>::min(); return false;
    }
    if (parsed > static_cast<long long>(numeric_limits<Value>::max())) {
      value = numeric_limits<Value>::max(); return false;
    }
    value = static_cast<Value>(parsed); return true;
  }
  template <class Value> static bool assign_unsigned(unsigned long long parsed, Value &value) {
    if (parsed > static_cast<unsigned long long>(numeric_limits<Value>::max())) {
      value = numeric_limits<Value>::max(); return false;
    }
    value = static_cast<Value>(parsed); return true;
  }
  template <class Value> static bool assign_float(long double parsed, Value &value) {
    if (parsed < -numeric_limits<Value>::max()) {
      value = -numeric_limits<Value>::max(); return false;
    }
    if (parsed > numeric_limits<Value>::max()) {
      value = numeric_limits<Value>::max(); return false;
    }
    value = static_cast<Value>(parsed); return true;
  }
};

template <class Character,
          class OutputIterator = ostreambuf_iterator<Character>>
class num_put : public locale::facet {
public:
  using char_type = Character;
  using iter_type = OutputIterator;
  explicit num_put(size_t refs = 0) : locale::facet(refs) {}
#define FTL_NUM_PUT_PUBLIC(Type) \
  iter_type put(iter_type out, ios_base &format, char_type fill, Type value) const { \
    return do_put(out, format, fill, value); \
  }
  FTL_NUM_PUT_PUBLIC(bool)
  FTL_NUM_PUT_PUBLIC(long)
  FTL_NUM_PUT_PUBLIC(unsigned long)
  FTL_NUM_PUT_PUBLIC(long long)
  FTL_NUM_PUT_PUBLIC(unsigned long long)
  FTL_NUM_PUT_PUBLIC(double)
  FTL_NUM_PUT_PUBLIC(long double)
  FTL_NUM_PUT_PUBLIC(const void *)
#undef FTL_NUM_PUT_PUBLIC
  inline static locale::id id{};

protected:
  ~num_put() override = default;
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, bool value) const {
    if (detail::locale_stream_boolalpha(format)) {
      const locale where = format_locale(format);
      const auto &punctuation = use_facet<numpunct<char_type>>(where);
      return emit_string(out, format, fill, value ? punctuation.truename() : punctuation.falsename());
    }
    return put_unsigned(out, format, fill, value ? 1 : 0);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, long value) const {
    return put_signed(out, format, fill, value);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, unsigned long value) const {
    return put_unsigned(out, format, fill, value);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, long long value) const {
    return put_signed(out, format, fill, value);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, unsigned long long value) const {
    return put_unsigned(out, format, fill, value);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, double value) const {
    return put_float(out, format, fill, static_cast<long double>(value), false);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, long double value) const {
    return put_float(out, format, fill, value, true);
  }
  virtual iter_type do_put(iter_type out, ios_base &format, char_type fill, const void *value) const {
    return put_unsigned(out, format, fill,
                        static_cast<unsigned long long>(reinterpret_cast<size_t>(value)), true);
  }

private:
  static locale format_locale(ios_base &);
  template <class String>
  static iter_type emit_string(iter_type out, ios_base &format, char_type fill,
                               const String &value, size_t prefix = 0) {
    streamsize width = detail::locale_stream_take_width(format);
    streamsize padding = width > static_cast<streamsize>(value.size())
        ? width - static_cast<streamsize>(value.size()) : 0;
    int adjustment = detail::locale_stream_adjust(format);
    if (adjustment == 0) while (padding-- > 0) *out++ = fill;
    for (size_t index = 0; index < prefix; ++index) *out++ = value[index];
    if (adjustment == 2) while (padding-- > 0) *out++ = fill;
    for (size_t index = prefix; index < value.size(); ++index) *out++ = value[index];
    if (adjustment == 1) while (padding-- > 0) *out++ = fill;
    return out;
  }
  iter_type put_signed(iter_type out, ios_base &format, char_type fill,
                       long long value) const {
    bool negative = value < 0;
    unsigned long long magnitude = negative ? 0ull - static_cast<unsigned long long>(value)
                                            : static_cast<unsigned long long>(value);
    return put_unsigned(out, format, fill, magnitude, false, negative);
  }
  iter_type put_unsigned(iter_type out, ios_base &format, char_type fill,
                         unsigned long long value, bool pointer = false,
                         bool negative = false) const {
    int base = pointer ? 16 : detail::locale_stream_base(format);
    if (base == 0) base = 10;
    const char *digits = detail::locale_stream_uppercase(format)
        ? "0123456789ABCDEF" : "0123456789abcdef";
    char buffer[70]; size_t end = 70, begin = end;
    do { buffer[--begin] = digits[value % static_cast<unsigned>(base)];
         value /= static_cast<unsigned>(base); } while (value);
    if ((pointer || detail::locale_stream_showbase(format)) && base == 16) {
      buffer[--begin] = detail::locale_stream_uppercase(format) ? 'X' : 'x'; buffer[--begin] = '0';
    } else if (detail::locale_stream_showbase(format) && base == 8 && buffer[begin] != '0') {
      buffer[--begin] = '0';
    }
    if (negative) buffer[--begin] = '-';
    else if (detail::locale_stream_showpos(format)) buffer[--begin] = '+';
    basic_string<char_type> converted;
    for (size_t i = begin; i < end; ++i) converted.push_back(static_cast<char_type>(buffer[i]));
    size_t prefix = negative || detail::locale_stream_showpos(format) ? 1 : 0;
    if ((pointer || detail::locale_stream_showbase(format)) && base == 16) prefix += 2;
    else if (detail::locale_stream_showbase(format) && base == 8) prefix += 1;
    const locale where = format_locale(format);
    const auto &punctuation = use_facet<numpunct<char_type>>(where);
    const string grouping = punctuation.grouping();
    if (!grouping.empty()) {
      size_t position = converted.size(); size_t group_index = 0;
      unsigned char group = static_cast<unsigned char>(grouping[0]);
      while (group > 0 && group != static_cast<unsigned char>(CHAR_MAX) &&
             position > prefix + group) {
        position -= group;
        converted.insert(converted.begin() + static_cast<ptrdiff_t>(position),
                         punctuation.thousands_sep());
        if (group_index + 1 < grouping.size()) {
          unsigned char next = static_cast<unsigned char>(grouping[++group_index]);
          if (next != 0) group = next;
        }
      }
    }
    return emit_string(out, format, fill, converted, prefix);
  }
  iter_type put_float(iter_type out, ios_base &format, char_type fill,
                      long double value, bool extended) const {
    char specification[16]; size_t at = 0; specification[at++] = '%';
    if (detail::locale_stream_showpos(format)) specification[at++] = '+';
    if (detail::locale_stream_showpoint(format)) specification[at++] = '#';
    specification[at++] = '.'; specification[at++] = '*';
    if (extended) specification[at++] = 'L';
    int mode = detail::locale_stream_float_mode(format);
    char conversion = mode == 1 ? 'f' : mode == 2 ? 'e' : mode == 3 ? 'a' : 'g';
    if (detail::locale_stream_uppercase(format)) conversion -= 'a' - 'A';
    specification[at++] = conversion; specification[at] = '\0';
    int precision = static_cast<int>(detail::locale_stream_precision(format));
    int count = extended ? ::snprintf(nullptr, 0, specification, precision, value)
                         : ::snprintf(nullptr, 0, specification, precision,
                                      static_cast<double>(value));
    string buffer;
    if (count > 0) {
      buffer.resize(static_cast<size_t>(count) + 1);
      if (extended) ::snprintf(buffer.data(), buffer.size(), specification, precision, value);
      else ::snprintf(buffer.data(), buffer.size(), specification, precision,
                      static_cast<double>(value));
    }
    basic_string<char_type> converted;
    if (count > 0) for (int i = 0; i < count; ++i) converted.push_back(static_cast<char_type>(buffer[static_cast<size_t>(i)]));
    const locale where = format_locale(format);
    const auto &punctuation = use_facet<numpunct<char_type>>(where);
    for (size_t index = 0; index < converted.size(); ++index)
      if (converted[index] == static_cast<char_type>('.')) {
        converted[index] = punctuation.decimal_point(); break;
      }
    size_t prefix = !converted.empty() &&
        (converted[0] == static_cast<char_type>('+') || converted[0] == static_cast<char_type>('-')) ? 1 : 0;
    const string grouping = punctuation.grouping();
    if (!grouping.empty()) {
      size_t position = prefix;
      while (position < converted.size() && converted[position] >= static_cast<char_type>('0') &&
             converted[position] <= static_cast<char_type>('9')) ++position;
      size_t group_index = 0;
      unsigned char group = static_cast<unsigned char>(grouping[0]);
      while (group && group != static_cast<unsigned char>(CHAR_MAX) && position > prefix + group) {
        position -= group;
        converted.insert(converted.begin() + static_cast<ptrdiff_t>(position),
                         punctuation.thousands_sep());
        if (group_index + 1 < grouping.size()) {
          unsigned char next = static_cast<unsigned char>(grouping[++group_index]);
          if (next) group = next;
        }
      }
    }
    return emit_string(out, format, fill, converted, prefix);
  }
};

class time_base {
