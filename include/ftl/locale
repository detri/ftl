  return control;
}

struct locale_facet_slot {
  const locale::id *key;
  locale_facet_control *control;
};

struct locale_state {
  atomic<size_t> references;
  bool immortal;
  bool named;
  const char *static_name;
  string owned_name;
  vector<locale_facet_slot> facets;

  locale_state()
      : references(0), immortal(true), named(true), static_name("C"),
        owned_name(), facets() {}

  locale_state(const locale_state &other, bool preserve_name)
      : references(1), immortal(false), named(preserve_name && other.named),
        static_name(named ? other.static_name : nullptr),
        owned_name(named && other.static_name == nullptr ? other.owned_name
                                                         : string{}),
        facets(other.facets) {
    for (auto &slot : facets) {
      if (slot.control != nullptr)
        slot.control->retain();
    }
  }

  locale_state(const locale_state &) = delete;
  locale_state &operator=(const locale_state &) = delete;

  ~locale_state() {
    if (immortal)
      return;

    for (auto &slot : facets) {
      if (slot.control != nullptr)
        slot.control->release();
    }
  }
};

inline void locale_retain_state(locale_state *state) noexcept {
  if (!state->immortal)
    state->references.fetch_add(1, memory_order_relaxed);
}

inline void locale_release_state(locale_state *state) noexcept {
  if (state->immortal)
    return;

  if (state->references.fetch_sub(1, memory_order_release) != 1)
    return;

  atomic_thread_fence(memory_order_acquire);
  delete state;
}

inline locale_state &locale_classic_state() {
  static locale_state state;

  static const bool initialized = [] {
    state.facets.reserve(4);

    state.facets.push_back(
        {&ctype<char>::id, &locale_classic_ctype_char_control()});

    state.facets.push_back(
        {&ctype<wchar_t>::id, &locale_classic_ctype_wchar_control()});

state.facets.push_back(
    {&collate<char>::id,
     &locale_classic_collate_char_control()});

state.facets.push_back(
    {&collate<wchar_t>::id,
     &locale_classic_collate_wchar_control()});

    return true;
  }();

  (void)initialized;

  return state;
}

struct locale_global_storage {
  locale_state *state;

  locale_global_storage() noexcept : state(&locale_classic_state()) {}

  ~locale_global_storage() { locale_release_state(state); }
};

inline locale_global_storage &locale_global() {
  static locale_global_storage value;
  return value;
}

[[nodiscard]]
inline const char *locale_state_name(const locale_state *state) noexcept {
  if (!state->named)
    return nullptr;

  if (state->static_name != nullptr)
    return state->static_name;

  return state->owned_name.c_str();
}

[[nodiscard]]
inline bool locale_names_equal(const locale_state *left,
                               const locale_state *right) noexcept {
  const char *lhs = locale_state_name(left);
  const char *rhs = locale_state_name(right);

  if (lhs == nullptr || rhs == nullptr)
    return false;

  while (*lhs != '\0' && *rhs != '\0') {
    if (*lhs != *rhs)
      return false;

    ++lhs;
    ++rhs;
  }

  return *lhs == *rhs;
}

[[nodiscard]]
inline locale_facet_slot *locale_find_facet(locale_state *state,
                                            const locale::id *key) noexcept {
  for (auto &slot : state->facets) {
    if (slot.key == key)
      return &slot;
  }

  return nullptr;
}

[[nodiscard]]
inline const locale_facet_slot *
locale_find_facet(const locale_state *state, const locale::id *key) noexcept {
  for (const auto &slot : state->facets) {
    if (slot.key == key)
      return &slot;
  }

  return nullptr;
}

template <class Facet>
[[nodiscard]]
inline const locale::id *locale_facet_key() {
  using bare_facet = remove_cv_t<Facet>;

  static_assert(!is_volatile_v<Facet>,
                "volatile-qualified locale facets are ill-formed");

  static_assert(is_convertible_v<const bare_facet *, const locale::facet *>,
                "locale facet must be publicly derived from locale::facet");

  return &bare_facet::id;
}

[[noreturn]]
inline void locale_missing_facet() {
#if defined(FTL_NO_EXCEPTIONS)
  terminate();
#else
  throw bad_cast{};
#endif
}

[[noreturn]]
inline void locale_combine_missing_facet() {
#if defined(FTL_NO_EXCEPTIONS)
  terminate();
#else
  throw runtime_error("locale::combine");
#endif
}

