struct locale_facet_control {
  atomic<size_t> references{1};
  const locale::facet *value;

  explicit locale_facet_control(const locale::facet *facet) noexcept
      : value(facet) {}

  void retain() noexcept { references.fetch_add(1, memory_order_relaxed); }

  void release() noexcept {
    if (references.fetch_sub(1, memory_order_release) != 1)
      return;

    atomic_thread_fence(memory_order_acquire);

    const locale::facet *facet = value;
    const bool destroy = facet != nullptr && facet->refs_ == 0;

    delete this;

    if (destroy)
      delete facet;
  }
};

