[[nodiscard]]
inline unsigned
locale_monetary_cs_precedes(const locale_named_monetary_snapshot &value,
                            bool positive) noexcept {
  if constexpr (International) {
    return positive ? value.international_positive_cs_precedes
                    : value.international_negative_cs_precedes;
