class locale {
public:
  class facet;
  class id;

  using category = int;

  static constexpr category none = 0;
  static constexpr category collate = 1 << 0;
  static constexpr category ctype = 1 << 1;
  static constexpr category monetary = 1 << 2;
  static constexpr category numeric = 1 << 3;
  static constexpr category time = 1 << 4;
  static constexpr category messages = 1 << 5;
  static constexpr category all =
      collate | ctype | monetary | numeric | time | messages;

  locale() noexcept;
  locale(const locale &other) noexcept;

  template <class Facet> locale(const locale &other, Facet *value);

  ~locale();

  const locale &operator=(const locale &other) noexcept;

  template <class Facet> locale combine(const locale &other) const;

  [[nodiscard]]
  string name() const;

  [[nodiscard]]
  bool operator==(const locale &other) const;

template <class Character, class Traits, class Allocator>
bool operator()(
    const basic_string<Character, Traits, Allocator> &left,
    const basic_string<Character, Traits, Allocator> &right) const;

  static locale global(const locale &value);

  [[nodiscard]]
  static const locale &classic();

private:
  struct adopt_state_t {};

  explicit locale(detail::locale_state *state, adopt_state_t) noexcept
      : state_(state) {}

  detail::locale_state *state_;

  template <class Facet> friend const Facet &use_facet(const locale &);

  template <class Facet> friend bool has_facet(const locale &) noexcept;
};

class locale::facet {
protected:
  explicit facet(size_t refs = 0) : refs_(refs) {}

  virtual ~facet() = default;

  facet(const facet &) = delete;
  void operator=(const facet &) = delete;

private:
  size_t refs_;

  friend struct detail::locale_facet_control;
};

class locale::id {
public:
  id() = default;

  id(const id &) = delete;
  void operator=(const id &) = delete;
};

class ctype_base {
public:
  using mask = unsigned short;

  inline static constexpr mask space = 1u << 0;
  inline static constexpr mask print = 1u << 1;
  inline static constexpr mask cntrl = 1u << 2;
  inline static constexpr mask upper = 1u << 3;
  inline static constexpr mask lower = 1u << 4;
  inline static constexpr mask alpha = 1u << 5;
  inline static constexpr mask digit = 1u << 6;
  inline static constexpr mask punct = 1u << 7;
  inline static constexpr mask xdigit = 1u << 8;
  inline static constexpr mask blank = 1u << 9;

  inline static constexpr mask alnum = alpha | digit;
  inline static constexpr mask graph = alnum | punct;
};

namespace detail {

[[nodiscard]]
constexpr ctype_base::mask ctype_ascii_mask(unsigned int value) noexcept {
  using mask = ctype_base::mask;

  const bool upper = value >= static_cast<unsigned>('A') &&
                     value <= static_cast<unsigned>('Z');

  const bool lower = value >= static_cast<unsigned>('a') &&
                     value <= static_cast<unsigned>('z');

  const bool alpha = upper || lower;

  const bool digit = value >= static_cast<unsigned>('0') &&
                     value <= static_cast<unsigned>('9');

  const bool xdigit = digit ||
                      (value >= static_cast<unsigned>('A') &&
                       value <= static_cast<unsigned>('F')) ||
                      (value >= static_cast<unsigned>('a') &&
                       value <= static_cast<unsigned>('f'));

  const bool space = value == static_cast<unsigned>(' ') ||
                     value == static_cast<unsigned>('\t') ||
                     value == static_cast<unsigned>('\n') ||
                     value == static_cast<unsigned>('\v') ||
                     value == static_cast<unsigned>('\f') ||
                     value == static_cast<unsigned>('\r');

  const bool blank = value == static_cast<unsigned>(' ') ||
                     value == static_cast<unsigned>('\t');

  const bool cntrl = value <= 0x1fu || value == 0x7fu;
  const bool print = value >= 0x20u && value <= 0x7eu;
  const bool graph = value >= 0x21u && value <= 0x7eu;
  const bool punct = graph && !alpha && !digit;

  mask result = 0;

  if (space)
    result |= ctype_base::space;

  if (print)
    result |= ctype_base::print;

  if (cntrl)
    result |= ctype_base::cntrl;

  if (upper)
    result |= ctype_base::upper;

  if (lower)
    result |= ctype_base::lower;

  if (alpha)
    result |= ctype_base::alpha;

  if (digit)
    result |= ctype_base::digit;

  if (punct)
    result |= ctype_base::punct;

  if (xdigit)
    result |= ctype_base::xdigit;

  if (blank)
    result |= ctype_base::blank;

  return result;
}

struct ctype_classic_table_storage {
  ctype_base::mask values[256]{};

  constexpr ctype_classic_table_storage() {
    for (size_t index = 0; index < 256; ++index)
      values[index] = ctype_ascii_mask(static_cast<unsigned int>(index));
  }
};

inline constexpr ctype_classic_table_storage ctype_classic_table{};

[[nodiscard]]
inline ctype_base::mask ctype_wide_mask(wchar_t value) noexcept {
  ctype_base::mask result = 0;

  const wint_t wide = static_cast<wint_t>(value);

  if (iswspace(wide))
    result |= ctype_base::space;

  if (iswprint(wide))
    result |= ctype_base::print;

  if (iswcntrl(wide))
    result |= ctype_base::cntrl;

  if (iswupper(wide))
    result |= ctype_base::upper;

  if (iswlower(wide))
    result |= ctype_base::lower;

  if (iswalpha(wide))
    result |= ctype_base::alpha;

  if (iswdigit(wide))
    result |= ctype_base::digit;

  if (iswpunct(wide))
    result |= ctype_base::punct;

  if (iswxdigit(wide))
    result |= ctype_base::xdigit;

  if (iswblank(wide))
    result |= ctype_base::blank;

  return result;
}

} // namespace detail

template <class Character>
class ctype : public locale::facet, public ctype_base {
  static_assert(is_same_v<Character, wchar_t>,
                "FTL provides standard ctype specializations for char and "
                "wchar_t");

public:
  using char_type = Character;

  explicit ctype(size_t refs = 0) : locale::facet(refs) {}

  [[nodiscard]]
  bool is(mask requested, char_type value) const {
    return do_is(requested, value);
  }

  const char_type *is(const char_type *low, const char_type *high,
                      mask *output) const {
    return do_is(low, high, output);
  }

  [[nodiscard]]
  const char_type *scan_is(mask requested, const char_type *low,
                           const char_type *high) const {
    return do_scan_is(requested, low, high);
  }

  [[nodiscard]]
  const char_type *scan_not(mask requested, const char_type *low,
                            const char_type *high) const {
    return do_scan_not(requested, low, high);
  }

  [[nodiscard]]
  char_type toupper(char_type value) const {
    return do_toupper(value);
  }

  const char_type *toupper(char_type *low, const char_type *high) const {
    return do_toupper(low, high);
  }

  [[nodiscard]]
  char_type tolower(char_type value) const {
    return do_tolower(value);
  }

  const char_type *tolower(char_type *low, const char_type *high) const {
    return do_tolower(low, high);
  }

  [[nodiscard]]
  char_type widen(char value) const {
    return do_widen(value);
  }

  const char *widen(const char *low, const char *high,
                    char_type *output) const {
    return do_widen(low, high, output);
  }

  [[nodiscard]]
  char narrow(char_type value, char fallback) const {
    return do_narrow(value, fallback);
  }

  const char_type *narrow(const char_type *low, const char_type *high,
                          char fallback, char *output) const {
    return do_narrow(low, high, fallback, output);
  }

  inline static locale::id id{};

protected:
  ~ctype() override = default;

  virtual bool do_is(mask requested, char_type value) const {
    return (detail::ctype_wide_mask(static_cast<wchar_t>(value)) & requested) !=
           0;
  }

  virtual const char_type *do_is(const char_type *low, const char_type *high,
                                 mask *output) const {
    for (const char_type *current = low; current != high; ++current)
      *output++ = detail::ctype_wide_mask(static_cast<wchar_t>(*current));

    return high;
  }

  virtual const char_type *do_scan_is(mask requested, const char_type *low,
                                      const char_type *high) const {
    while (low != high) {
      if (do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  virtual const char_type *do_scan_not(mask requested, const char_type *low,
                                       const char_type *high) const {
    while (low != high) {
      if (!do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  virtual char_type do_toupper(char_type value) const {
    return static_cast<char_type>(towupper(static_cast<wint_t>(value)));
  }

  virtual const char_type *do_toupper(char_type *low,
                                      const char_type *high) const {
    for (char_type *current = low; current != high; ++current)
      *current = do_toupper(*current);

    return high;
  }

  virtual char_type do_tolower(char_type value) const {
    return static_cast<char_type>(towlower(static_cast<wint_t>(value)));
  }

  virtual const char_type *do_tolower(char_type *low,
                                      const char_type *high) const {
    for (char_type *current = low; current != high; ++current)
      *current = do_tolower(*current);

    return high;
  }

  virtual char_type do_widen(char value) const {
    return static_cast<char_type>(static_cast<unsigned char>(value));
  }

  virtual const char *do_widen(const char *low, const char *high,
                               char_type *output) const {
    while (low != high)
      *output++ = do_widen(*low++);

    return high;
  }

  virtual char do_narrow(char_type value, char fallback) const {
    if constexpr (is_signed_v<char_type>) {
      if (value < 0)
        return fallback;
    }

    const auto numeric = static_cast<unsigned long long>(value);

    if (numeric <= 0x7fu)
      return static_cast<char>(numeric);

    return fallback;
  }

  virtual const char_type *do_narrow(const char_type *low,
                                     const char_type *high, char fallback,
                                     char *output) const {
    while (low != high)
      *output++ = do_narrow(*low++, fallback);

    return high;
  }
};

template <> class ctype<char> : public locale::facet, public ctype_base {
public:
  using char_type = char;

  explicit ctype(const mask *table = nullptr, bool delete_table = false,
                 size_t refs = 0)
      : locale::facet(refs), table_(table),
        delete_table_(table != nullptr && delete_table) {}

  [[nodiscard]]
  bool is(mask requested, char value) const {
    return (table()[static_cast<unsigned char>(value)] & requested) != 0;
  }

  const char *is(const char *low, const char *high, mask *output) const {
    while (low != high) {
      *output++ = table()[static_cast<unsigned char>(*low++)];
    }

    return high;
  }

  [[nodiscard]]
  const char *scan_is(mask requested, const char *low, const char *high) const {
    while (low != high) {
      if ((table()[static_cast<unsigned char>(*low)] & requested) != 0)
        break;

      ++low;
    }

    return low;
  }

  [[nodiscard]]
  const char *scan_not(mask requested, const char *low,
                       const char *high) const {
    while (low != high) {
      if ((table()[static_cast<unsigned char>(*low)] & requested) == 0)
        break;

      ++low;
    }

    return low;
  }

  [[nodiscard]]
  char toupper(char value) const {
    return do_toupper(value);
  }

  const char *toupper(char *low, const char *high) const {
    return do_toupper(low, high);
  }

  [[nodiscard]]
  char tolower(char value) const {
    return do_tolower(value);
  }

  const char *tolower(char *low, const char *high) const {
    return do_tolower(low, high);
  }

  [[nodiscard]]
  char widen(char value) const {
    return do_widen(value);
  }

  const char *widen(const char *low, const char *high, char *output) const {
    return do_widen(low, high, output);
  }

  [[nodiscard]]
  char narrow(char value, char fallback) const {
    return do_narrow(value, fallback);
  }

  const char *narrow(const char *low, const char *high, char fallback,
                     char *output) const {
    return do_narrow(low, high, fallback, output);
  }

  inline static locale::id id{};

  inline static constexpr size_t table_size = 256;

  [[nodiscard]]
  const mask *table() const noexcept {
    return table_ != nullptr ? table_ : classic_table();
  }

  [[nodiscard]]
  static const mask *classic_table() noexcept {
    return detail::ctype_classic_table.values;
  }

protected:
  ~ctype() override {
    if (delete_table_)
      delete[] table_;
  }

  virtual char do_toupper(char value) const {
    const unsigned char character = static_cast<unsigned char>(value);

    if (character >= static_cast<unsigned char>('a') &&
        character <= static_cast<unsigned char>('z')) {
      return static_cast<char>(character - static_cast<unsigned char>('a') +
                               static_cast<unsigned char>('A'));
    }

    return value;
  }

  virtual const char *do_toupper(char *low, const char *high) const {
    for (char *current = low; current != high; ++current)
      *current = do_toupper(*current);

    return high;
  }

  virtual char do_tolower(char value) const {
    const unsigned char character = static_cast<unsigned char>(value);

    if (character >= static_cast<unsigned char>('A') &&
        character <= static_cast<unsigned char>('Z')) {
      return static_cast<char>(character - static_cast<unsigned char>('A') +
                               static_cast<unsigned char>('a'));
    }

    return value;
  }

  virtual const char *do_tolower(char *low, const char *high) const {
    for (char *current = low; current != high; ++current)
      *current = do_tolower(*current);

    return high;
  }

  virtual char do_widen(char value) const { return value; }

  virtual const char *do_widen(const char *low, const char *high,
                               char *output) const {
    while (low != high)
      *output++ = *low++;

    return high;
  }

  virtual char do_narrow(char value, char) const { return value; }

  virtual const char *do_narrow(const char *low, const char *high, char,
                                char *output) const {
    while (low != high)
      *output++ = *low++;

    return high;
  }

private:
  const mask *table_;
  bool delete_table_;
};

// Named facets come with the named-locale runtime in the next slice.
template <class Character> class ctype_byname;

namespace detail {

[[noreturn]]
inline void locale_named_ctype_failure() {
#if defined(FTL_NO_EXCEPTIONS)
  terminate();
#else
  throw runtime_error("ctype_byname");
#endif
}

struct locale_named_ctype_context {
  ftl_locale_runtime::native_handle native;

  explicit locale_named_ctype_context(const char *name)
      : native(ftl_locale_runtime::create_ctype(name)) {
    if (native == nullptr)
      locale_named_ctype_failure();
  }

  locale_named_ctype_context(const locale_named_ctype_context &) = delete;

  locale_named_ctype_context &
  operator=(const locale_named_ctype_context &) = delete;

  ~locale_named_ctype_context() { ftl_locale_runtime::destroy(native); }
};

[[nodiscard]]
inline ctype_base::mask
locale_named_ctype_byte_mask(ftl_locale_runtime::native_handle native,
                             unsigned char value) noexcept {
  using runtime_class = ftl_locale_runtime::classification;

  ctype_base::mask result = 0;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::space))
    result |= ctype_base::space;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::print))
    result |= ctype_base::print;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::cntrl))
    result |= ctype_base::cntrl;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::upper))
    result |= ctype_base::upper;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::lower))
    result |= ctype_base::lower;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::alpha))
    result |= ctype_base::alpha;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::digit))
    result |= ctype_base::digit;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::punct))
    result |= ctype_base::punct;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::xdigit))
    result |= ctype_base::xdigit;

  if (ftl_locale_runtime::classify_byte(native, value, runtime_class::blank))
    result |= ctype_base::blank;

  return result;
}

[[nodiscard]]
inline ctype_base::mask
locale_named_ctype_wide_mask(ftl_locale_runtime::native_handle native,
                             wchar_t value) noexcept {
  using runtime_class = ftl_locale_runtime::classification;

  ctype_base::mask result = 0;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::space))
    result |= ctype_base::space;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::print))
    result |= ctype_base::print;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::cntrl))
    result |= ctype_base::cntrl;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::upper))
    result |= ctype_base::upper;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::lower))
    result |= ctype_base::lower;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::alpha))
    result |= ctype_base::alpha;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::digit))
    result |= ctype_base::digit;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::punct))
    result |= ctype_base::punct;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::xdigit))
    result |= ctype_base::xdigit;

  if (ftl_locale_runtime::classify_wide(native, value, runtime_class::blank))
    result |= ctype_base::blank;

  return result;
}

struct locale_named_ctype_char_context : locale_named_ctype_context {
  ctype_base::mask table[ctype<char>::table_size]{};

  explicit locale_named_ctype_char_context(const char *name)
      : locale_named_ctype_context(name) {
    for (size_t index = 0; index < ctype<char>::table_size; ++index) {
      table[index] = locale_named_ctype_byte_mask(
          native, static_cast<unsigned char>(index));
    }
  }
};

} // namespace detail

template <> class ctype_byname<char> : public ctype<char> {
public:
  using mask = typename ctype<char>::mask;

  explicit ctype_byname(const char *name, size_t refs = 0)
      : ctype_byname(new detail::locale_named_ctype_char_context(name), refs) {}

  explicit ctype_byname(const string &name, size_t refs = 0)
      : ctype_byname(name.c_str(), refs) {}

protected:
  ~ctype_byname() override { delete context_; }

  char do_toupper(char value) const override {
    return ftl_locale_runtime::toupper_byte(context_->native, value);
  }

  const char *do_toupper(char *low, const char *high) const override {
    for (char *current = low; current != high; ++current) {
      *current = do_toupper(*current);
    }

    return high;
  }

  char do_tolower(char value) const override {
    return ftl_locale_runtime::tolower_byte(context_->native, value);
  }

  const char *do_tolower(char *low, const char *high) const override {
    for (char *current = low; current != high; ++current) {
      *current = do_tolower(*current);
    }

    return high;
  }

private:
  explicit ctype_byname(detail::locale_named_ctype_char_context *context,
                        size_t refs)
      : ctype<char>(context->table, false, refs), context_(context) {}

  detail::locale_named_ctype_char_context *context_;
};

template <> class ctype_byname<wchar_t> : public ctype<wchar_t> {
public:
  using mask = typename ctype<wchar_t>::mask;

  explicit ctype_byname(const char *name, size_t refs = 0)
      : ctype<wchar_t>(refs),
        context_(new detail::locale_named_ctype_context(name)) {}

  explicit ctype_byname(const string &name, size_t refs = 0)
      : ctype_byname(name.c_str(), refs) {}

protected:
  ~ctype_byname() override { delete context_; }

  bool do_is(mask requested, wchar_t value) const override {
    return (detail::locale_named_ctype_wide_mask(context_->native, value) &
            requested) != 0;
  }

  const wchar_t *do_is(const wchar_t *low, const wchar_t *high,
                       mask *output) const override {
    while (low != high) {
      *output++ =
          detail::locale_named_ctype_wide_mask(context_->native, *low++);
    }

    return high;
  }

  const wchar_t *do_scan_is(mask requested, const wchar_t *low,
                            const wchar_t *high) const override {
    while (low != high) {
      if (do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  const wchar_t *do_scan_not(mask requested, const wchar_t *low,
                             const wchar_t *high) const override {
    while (low != high) {
      if (!do_is(requested, *low))
        break;

      ++low;
    }

    return low;
  }

  wchar_t do_toupper(wchar_t value) const override {
    return ftl_locale_runtime::toupper_wide(context_->native, value);
  }

  const wchar_t *do_toupper(wchar_t *low, const wchar_t *high) const override {
    for (wchar_t *current = low; current != high; ++current) {
      *current = do_toupper(*current);
    }

    return high;
  }

  wchar_t do_tolower(wchar_t value) const override {
    return ftl_locale_runtime::tolower_wide(context_->native, value);
  }

  const wchar_t *do_tolower(wchar_t *low, const wchar_t *high) const override {
    for (wchar_t *current = low; current != high; ++current) {
      *current = do_tolower(*current);
    }

    return high;
  }

  wchar_t do_widen(char value) const override {
    return ftl_locale_runtime::widen(context_->native, value);
  }

  const char *do_widen(const char *low, const char *high,
                       wchar_t *output) const override {
    while (low != high)
      *output++ = do_widen(*low++);

    return high;
  }

  char do_narrow(wchar_t value, char fallback) const override {
    return ftl_locale_runtime::narrow(context_->native, value, fallback);
  }

  const wchar_t *do_narrow(const wchar_t *low, const wchar_t *high,
                           char fallback, char *output) const override {
    while (low != high)
      *output++ = do_narrow(*low++, fallback);

    return high;
  }

private:
  detail::locale_named_ctype_context *context_;
};

namespace detail {

template <class Character>
[[nodiscard]]
inline long collate_hash_range(
    const Character *low,
    const Character *high) noexcept {
  if (low == high)
    return 0;

  const size_t count =
      static_cast<size_t>(high - low);

  const auto value =
      ftl_rapidhash::rapidhash(
          low,
          count * sizeof(Character));

  const unsigned long folded =
      static_cast<unsigned long>(value) ^
      static_cast<unsigned long>(
          value >> (sizeof(unsigned long) * 4));

  const unsigned long positive_mask =
      static_cast<unsigned long>(-1) >> 1;

  return static_cast<long>(folded & positive_mask);
}

template <class Character>
[[nodiscard]]
inline int collate_lexicographical_compare(
    const Character *low1,
    const Character *high1,
    const Character *low2,
    const Character *high2) noexcept {
  while (low1 != high1 && low2 != high2) {
    if (char_traits<Character>::lt(*low1, *low2))
      return -1;

    if (char_traits<Character>::lt(*low2, *low1))
      return 1;

    ++low1;
    ++low2;
  }

  if (low1 != high1)
    return 1;

  if (low2 != high2)
    return -1;

  return 0;
}

} // namespace detail

template <class Character>
class collate : public locale::facet {
  static_assert(
      is_same_v<Character, char> ||
          is_same_v<Character, wchar_t>,
      "FTL provides the standard collate specializations for "
      "char and wchar_t");

public:
  using char_type = Character;
  using string_type = basic_string<Character>;

  explicit collate(size_t refs = 0)
      : locale::facet(refs) {}

  [[nodiscard]]
  int compare(const Character *low1,
              const Character *high1,
              const Character *low2,
              const Character *high2) const {
    return do_compare(low1, high1, low2, high2);
  }

  [[nodiscard]]
  string_type transform(const Character *low,
                        const Character *high) const {
    return do_transform(low, high);
  }

  [[nodiscard]]
  long hash(const Character *low,
            const Character *high) const {
    return do_hash(low, high);
  }

  inline static locale::id id{};

protected:
  ~collate() override = default;

  virtual int do_compare(
      const Character *low1,
      const Character *high1,
      const Character *low2,
      const Character *high2) const {
    while (low1 != high1 && low2 != high2) {
      if (char_traits<Character>::lt(*low1, *low2))
        return -1;

      if (char_traits<Character>::lt(*low2, *low1))
        return 1;

      ++low1;
      ++low2;
    }

    if (low1 != high1)
      return 1;

    if (low2 != high2)
      return -1;

    return 0;
  }

  virtual string_type do_transform(
      const Character *low,
      const Character *high) const {
    return string_type(low, high);
  }

  virtual long do_hash(
      const Character *low,
      const Character *high) const {
    return detail::collate_hash_range(low, high);
  }
};

