template <class Character>
class messages
    : public locale::facet,
      public messages_base {
  static_assert(
      is_same_v<Character, char> ||
          is_same_v<Character, wchar_t>,
      "FTL provides the required messages "
      "specializations for char and wchar_t");

private:
  using mutex =
      detail::locale_catalog_mutex;

  template <class Mutex>
  using lock_guard =
      detail::locale_catalog_lock_guard<
          Mutex>;

public:
  using char_type = Character;
  using string_type = basic_string<Character>;

  explicit messages(size_t refs = 0) : messages("C", refs) {}

  catalog open(const string &filename, const locale &conversion_locale) const {
    return do_open(filename, conversion_locale);
  }

  string_type get(catalog opened_catalog, int set, int message,
                  const string_type &fallback) const {
    return do_get(opened_catalog, set, message, fallback);
  }

  void close(catalog opened_catalog) const { do_close(opened_catalog); }

  inline static locale::id id{};

protected:
  explicit messages(const char *name, size_t refs)
      : locale::facet(refs),
        context_(new detail::locale_named_messages_context(name)) {}

  ~messages() override {
    //
    // Closing forgotten catalogs here isn't observable through a
    // conforming caller, because using a catalog after its facet has
    // died is already invalid. It does prevent native resource leaks.
    //
    catalogs_.clear();

    delete context_;
  }

  virtual catalog do_open(const string &filename,
                          const locale &conversion_locale) const {
    const auto native = ftl_locale_runtime::open_message_catalog(
        context_->native, filename.c_str());

    if (!ftl_locale_runtime::message_catalog_valid(native)) {
      return static_cast<catalog>(-1);
    }

    unique_ptr<detail::locale_message_catalog_entry> entry(
        new detail::locale_message_catalog_entry(native, conversion_locale));

    lock_guard<mutex> lock(catalog_mutex_);

    for (size_t index = 0; index < catalogs_.size(); ++index) {
      if (!catalogs_[index]) {
        catalogs_[index] = move(entry);

        return static_cast<catalog>(index);
      }
    }

    catalogs_.push_back(move(entry));

    return static_cast<catalog>(catalogs_.size() - 1);
  }

  virtual string_type do_get(catalog opened_catalog, int set, int message,
                             const string_type &fallback) const {
    if (opened_catalog < 0)
      return fallback;

    lock_guard<mutex> lock(catalog_mutex_);

    const size_t index = static_cast<size_t>(opened_catalog);

    if (index >= catalogs_.size() || !catalogs_[index]) {
      return fallback;
    }

    const auto &entry = *catalogs_[index];

    if constexpr (is_same_v<Character, char>) {
      const char *native_fallback = fallback.c_str();

      const char *result = ftl_locale_runtime::get_message_catalog(
          entry.native, set, message, native_fallback);

      if (result == native_fallback)
        return fallback;

      return string_type(result);
    } else {
      //
      // Pointer identity lets us distinguish "message not found"
      // from an actual empty-string catalog entry.
      //
      const char missing[] = "";

      const char *result = ftl_locale_runtime::get_message_catalog(
          entry.native, set, message, missing);

      if (result == missing)
        return fallback;

      return detail::locale_convert_message<Character>(
          result, entry.conversion_locale, fallback);
    }
  }

  virtual void do_close(catalog opened_catalog) const {
    if (opened_catalog < 0)
      return;

    lock_guard<mutex> lock(catalog_mutex_);

    const size_t index = static_cast<size_t>(opened_catalog);

    if (index >= catalogs_.size())
      return;

    //
    // The entry owns and closes the native descriptor.
    //
    catalogs_[index].reset();
  }

private:
  mutable mutex catalog_mutex_;

  mutable vector<unique_ptr<detail::locale_message_catalog_entry>> catalogs_;

  detail::locale_named_messages_context *context_;
};

