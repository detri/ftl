}

template <class Character>
[[nodiscard]]
inline basic_string<Character>
locale_named_collate_transform(ftl_locale_runtime::native_handle native,
                               const Character *low, const Character *high) {
  basic_string<Character> result;

  const Character *current = low;

  for (;;) {
    const Character *segment_end = current;

    while (segment_end != high && *segment_end != Character{}) {
      ++segment_end;
    }

    basic_string<Character> source(current, segment_end);

    const size_t required =
        locale_collate_transform_size<Character>(native, source.c_str());

    basic_string<Character> transformed(required + 1, Character{});

    locale_collate_transform_into<Character>(native, transformed.data(),
                                             required + 1, source.c_str());

    transformed.resize(required);

    //
    // Encode transformed units as:
    //
    //     1, unit, 1, unit, ..., 0
    //
    // This preserves lexicographical ordering of each CRT
    // transform while also preserving embedded NUL characters
    // from the original C++ [low, high) range. The C runtime's
    // xfrm API itself is NUL-terminated.
    //
    result.reserve(result.size() + transformed.size() * 2 + 1);

    for (Character value : transformed) {
      result.push_back(static_cast<Character>(1));

      result.push_back(value);
    }

    result.push_back(Character{});

    if (segment_end == high)
      break;

    current = segment_end + 1;
  }

  return result;
}

template <class Character>
[[nodiscard]]
inline long
locale_named_collate_hash(const basic_string<Character> &key) noexcept {
  return collate_hash_range(key.data(), key.data() + key.size());
}

