  };
};

template <class Character,
          class InputIterator = istreambuf_iterator<Character>>
class time_get : public locale::facet, public time_base {
public:
  using char_type = Character;
  using iter_type = InputIterator;
  explicit time_get(size_t refs = 0) : locale::facet(refs) {}
  dateorder date_order() const { return do_date_order(); }
  iter_type get_time(iter_type first, iter_type last, ios_base &format,
                     unsigned int &error, tm *value) const {
    return do_get_time(first, last, format, error, value);
  }
  iter_type get_date(iter_type first, iter_type last, ios_base &format,
                     unsigned int &error, tm *value) const {
    return do_get_date(first, last, format, error, value);
  }
  iter_type get_weekday(iter_type first, iter_type last, ios_base &format,
                        unsigned int &error, tm *value) const {
    return do_get_weekday(first, last, format, error, value);
  }
  iter_type get_monthname(iter_type first, iter_type last, ios_base &format,
                          unsigned int &error, tm *value) const {
    return do_get_monthname(first, last, format, error, value);
  }
  iter_type get_year(iter_type first, iter_type last, ios_base &format,
                     unsigned int &error, tm *value) const {
    return do_get_year(first, last, format, error, value);
  }
  iter_type get(iter_type first, iter_type last, ios_base &format,
                unsigned int &error, tm *value, char conversion,
                char modifier = 0) const {
    return do_get(first, last, format, error, value, conversion, modifier);
  }
  iter_type get(iter_type first, iter_type last, ios_base &format,
                unsigned int &error, tm *value, const char_type *pattern,
                const char_type *pattern_end) const {
    while (pattern != pattern_end && first != last && !(error & stream_failbit())) {
      char current = static_cast<char>(*pattern++);
      if (current != '%') {
        if (static_cast<char>(*first) != current) { error |= stream_failbit(); break; }
        ++first; continue;
      }
      char modifier = 0;
      if (pattern != pattern_end && (*pattern == static_cast<char_type>('E') ||
                                     *pattern == static_cast<char_type>('O')))
        modifier = static_cast<char>(*pattern++);
      if (pattern == pattern_end) { error |= stream_failbit(); break; }
      first = do_get(first, last, format, error, value,
                     static_cast<char>(*pattern++), modifier);
    }
    if (first == last) error |= stream_eofbit();
    return first;
  }
  inline static locale::id id{};

protected:
  ~time_get() override = default;
  virtual dateorder do_date_order() const { return no_order; }
  virtual iter_type do_get_time(iter_type first, iter_type last, ios_base &format,
                                unsigned int &error, tm *value) const {
    const char_type pattern[] = {char_type('%'), char_type('H'), char_type(':'),
                                 char_type('%'), char_type('M'), char_type(':'),
                                 char_type('%'), char_type('S')};
    return get(first, last, format, error, value, pattern, pattern + 8);
  }
  virtual iter_type do_get_date(iter_type first, iter_type last, ios_base &format,
                                unsigned int &error, tm *value) const {
    const char_type pattern[] = {char_type('%'), char_type('m'), char_type('/'),
                                 char_type('%'), char_type('d'), char_type('/'),
                                 char_type('%'), char_type('y')};
    return get(first, last, format, error, value, pattern, pattern + 8);
  }
  virtual iter_type do_get_weekday(iter_type first, iter_type last, ios_base &format,
                                   unsigned int &error, tm *value) const {
    int matched = match_name(first, last, format, weekdays(), 7, error);
    if (matched >= 0) value->tm_wday = matched;
    return advance_name(first, last);
  }
  virtual iter_type do_get_monthname(iter_type first, iter_type last, ios_base &format,
                                     unsigned int &error, tm *value) const {
    int matched = match_name(first, last, format, months(), 12, error);
    if (matched >= 0) value->tm_mon = matched;
    return advance_name(first, last);
  }
  virtual iter_type do_get_year(iter_type first, iter_type last, ios_base &,
                                unsigned int &error, tm *value) const {
    int year = 0, digits = 0;
    first = parse_number(first, last, 4, year, digits);
    if (digits == 2) year += year < 69 ? 2000 : 1900;
    if (digits != 2 && digits != 4) error |= stream_failbit();
    else value->tm_year = year - 1900;
    if (first == last) error |= stream_eofbit();
    return first;
  }
  virtual iter_type do_get(iter_type first, iter_type last, ios_base &format,
                           unsigned int &error, tm *value, char conversion,
                           char) const {
    error = 0;
    int parsed = 0, digits = 0;
    switch (conversion) {
    case 'H': case 'I':
      first = parse_number(first, last, 2, parsed, digits);
      if (!digits || parsed > 23 || (conversion == 'I' && (parsed < 1 || parsed > 12))) error |= stream_failbit();
      else value->tm_hour = parsed; break;
    case 'M':
      first = parse_number(first, last, 2, parsed, digits);
      if (!digits || parsed > 59) error |= stream_failbit(); else value->tm_min = parsed; break;
    case 'S':
      first = parse_number(first, last, 2, parsed, digits);
      if (!digits || parsed > 60) error |= stream_failbit(); else value->tm_sec = parsed; break;
    case 'd': case 'e':
      first = parse_number(first, last, 2, parsed, digits);
      if (!digits || parsed < 1 || parsed > 31) error |= stream_failbit(); else value->tm_mday = parsed; break;
    case 'm':
      first = parse_number(first, last, 2, parsed, digits);
      if (!digits || parsed < 1 || parsed > 12) error |= stream_failbit(); else value->tm_mon = parsed - 1; break;
    case 'y':
      first = parse_number(first, last, 2, parsed, digits);
      if (digits != 2) error |= stream_failbit(); else value->tm_year = (parsed < 69 ? parsed + 100 : parsed); break;
    case 'Y': return do_get_year(first, last, format, error, value);
    case 'a': case 'A': return do_get_weekday(first, last, format, error, value);
    case 'b': case 'B': case 'h': return do_get_monthname(first, last, format, error, value);
    case 'R': return do_get_time_short(first, last, format, error, value, false);
    case 'T': case 'X': return do_get_time(first, last, format, error, value);
    case 'D': case 'x': return do_get_date(first, last, format, error, value);
    case '%':
      if (first == last || static_cast<char>(*first) != '%') error |= stream_failbit(); else ++first;
      break;
    default: error |= stream_failbit(); break;
    }
    if (first == last) error |= stream_eofbit();
    return first;
  }

private:
  static unsigned int stream_failbit();
  static unsigned int stream_eofbit();
  static iter_type parse_number(iter_type first, iter_type last, int maximum,
                                int &value, int &digits) {
    value = 0; digits = 0;
    while (first != last && digits < maximum) {
      char character = static_cast<char>(*first);
      if (character < '0' || character > '9') break;
      value = value * 10 + character - '0'; ++digits; ++first;
    }
    return first;
  }
  iter_type do_get_time_short(iter_type first, iter_type last, ios_base &format,
                              unsigned int &error, tm *value, bool) const {
    const char_type pattern[] = {char_type('%'), char_type('H'), char_type(':'),
                                 char_type('%'), char_type('M')};
    return get(first, last, format, error, value, pattern, pattern + 5);
  }
  static const char *const *weekdays() {
    static const char *values[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
    return values;
  }
  static const char *const *months() {
    static const char *values[] = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"};
    return values;
  }
  static int match_name(iter_type first, iter_type last, ios_base &format,
                        const char *const *names, int count,
                        unsigned int &error) {
    basic_string<char_type> input;
    iter_type position = first;
    while (position != last) {
      char value = static_cast<char>(*position);
      if (!((value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z'))) break;
      input.push_back(*position); ++position;
    }
    const locale where = detail::locale_stream_locale(format);
    const auto &classification = use_facet<ctype<char_type>>(where);
    for (int index = 0; index < count; ++index) {
      size_t length = 0; while (names[index][length]) ++length;
      if (input.size() != length && input.size() != 3) continue;
      bool equal = true;
      for (size_t offset = 0; offset < input.size(); ++offset) {
        const char_type expected = static_cast<char_type>(names[index][offset]);
        if (classification.tolower(input[offset]) !=
            classification.tolower(expected)) {
          equal = false;
          break;
        }
      }
      if (equal) return index;
    }
    error |= stream_failbit(); return -1;
  }
  static iter_type advance_name(iter_type first, iter_type last) {
    int count = 0;
    while (first != last && count < 9) {
      char value = static_cast<char>(*first);
      if (!((value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z'))) break;
      ++first; ++count;
    }
    return first;
  }
};

template <class Character, class InputIterator = istreambuf_iterator<Character>>
class time_get_byname : public time_get<Character, InputIterator> {
public:
  using dateorder = time_base::dateorder;
  using iter_type = InputIterator;
  explicit time_get_byname(const char *name, size_t refs = 0)
      : time_get<Character, InputIterator>(refs), context_(name) {}
  explicit time_get_byname(const string &name, size_t refs = 0)
      : time_get_byname(name.c_str(), refs) {}
protected:
  ~time_get_byname() override = default;
  iter_type do_get_weekday(iter_type first, iter_type last, ios_base &format,
                           unsigned int &error, tm *value) const override {
    int matched = match(first, last, format, error, false);
    if (matched >= 0) value->tm_wday = matched;
    if (first == last) error |= detail::locale_stream_eofbit();
    return consume_name(first, last, format);
  }
  iter_type do_get_monthname(iter_type first, iter_type last, ios_base &format,
                             unsigned int &error, tm *value) const override {
    int matched = match(first, last, format, error, true);
    if (matched >= 0) value->tm_mon = matched;
    if (first == last) error |= detail::locale_stream_eofbit();
    return consume_name(first, last, format);
  }
private:
  basic_string<Character> formatted_name(int index, bool month, bool abbreviated) const {
    tm value{};
    if (month) value.tm_mon = index; else value.tm_wday = index;
    char pattern[3] = {'%', abbreviated ? (month ? 'b' : 'a') : (month ? 'B' : 'A'), 0};
    string buffer(128, '\0');
    size_t count = detail::locale_named_time_format(
        context_, buffer.data(), buffer.size(), pattern, &value);
    basic_string<Character> result;
    if constexpr (is_same_v<Character, char>) {
      result.assign(buffer.data(), count);
    } else {
      const char *first = buffer.data(); const char *last = first + count;
      while (first != last) {
        auto decoded = ftl_locale_runtime::decode_wide(context_.native, first, last);
        if (decoded.result != ftl_locale_runtime::decoded_wide::status::complete) break;
        result.push_back(static_cast<Character>(decoded.value)); first += decoded.consumed;
      }
    }
    return result;
  }
  int match(iter_type first, iter_type last, ios_base &format,
            unsigned int &error, bool month) const {
    basic_string<Character> input;
    const locale where = detail::locale_stream_locale(format);
    const auto &classification = use_facet<ctype<Character>>(where);
    iter_type position = first;
    while (position != last && classification.is(ctype_base::alpha, *position)) {
      input.push_back(*position); ++position;
    }
    int count = month ? 12 : 7;
    for (int index = 0; index < count; ++index) {
      auto full = formatted_name(index, month, false);
      auto abbreviated = formatted_name(index, month, true);
      const auto equal_case_insensitive = [&](const auto &candidate) {
        if (input.size() != candidate.size())
          return false;
        for (size_t offset = 0; offset < input.size(); ++offset)
          if (classification.tolower(input[offset]) !=
              classification.tolower(candidate[offset]))
            return false;
        return true;
      };
      if (equal_case_insensitive(full) ||
          equal_case_insensitive(abbreviated))
        return index;
    }
    error |= detail::locale_stream_failbit();
    return -1;
  }
  iter_type consume_name(iter_type first, iter_type last, ios_base &format) const {
    const locale where = detail::locale_stream_locale(format);
    const auto &classification = use_facet<ctype<Character>>(where);
    while (first != last && classification.is(ctype_base::alpha, *first)) ++first;
    return first;
  }
  detail::locale_named_time_context context_;
};

template <class Character,
          class OutputIterator = ostreambuf_iterator<Character>>
class time_put : public locale::facet {
public:
  using char_type = Character;
  using iter_type = OutputIterator;
  explicit time_put(size_t refs = 0) : locale::facet(refs) {}
  iter_type put(iter_type out, ios_base &format, char_type fill, const tm *value,
                const char_type *pattern, const char_type *pattern_end) const {
    while (pattern != pattern_end) {
      char character = static_cast<char>(*pattern++);
      if (character != '%') { *out++ = static_cast<char_type>(character); continue; }
      char modifier = 0;
      if (pattern != pattern_end && (*pattern == char_type('E') || *pattern == char_type('O')))
        modifier = static_cast<char>(*pattern++);
      if (pattern != pattern_end) out = do_put(out, format, fill, value,
                                               static_cast<char>(*pattern++), modifier);
    }
    return out;
  }
  iter_type put(iter_type out, ios_base &format, char_type fill, const tm *value,
                char conversion, char modifier = 0) const {
    return do_put(out, format, fill, value, conversion, modifier);
  }
  inline static locale::id id{};
protected:
  ~time_put() override = default;
  virtual iter_type do_put(iter_type out, ios_base &, char_type, const tm *value,
                           char conversion, char modifier) const {
    char pattern[4] = {'%', 0, 0, 0};
    size_t at = 1; if (modifier) pattern[at++] = modifier; pattern[at++] = conversion;
    char buffer[256]; size_t count = strftime(buffer, sizeof(buffer), pattern, value);
    for (size_t index = 0; index < count; ++index) *out++ = static_cast<char_type>(buffer[index]);
    return out;
  }
};

template <class Character, class OutputIterator = ostreambuf_iterator<Character>>
class time_put_byname : public time_put<Character, OutputIterator> {
public:
  using char_type = Character;
  using iter_type = OutputIterator;
  explicit time_put_byname(const char *name, size_t refs = 0)
      : time_put<Character, OutputIterator>(refs), context_(name) {}
  explicit time_put_byname(const string &name, size_t refs = 0)
      : time_put_byname(name.c_str(), refs) {}
protected:
  ~time_put_byname() override = default;
  iter_type do_put(iter_type out, ios_base &, char_type, const tm *value,
                   char conversion, char modifier) const override {
    char pattern[4] = {'%', 0, 0, 0};
    size_t at = 1; if (modifier) pattern[at++] = modifier; pattern[at++] = conversion;
    size_t capacity = 128;
    string buffer;
    for (;;) {
      buffer.resize(capacity);
      size_t count = detail::locale_named_time_format(
          context_, buffer.data(), buffer.size(), pattern, value);
      if (count || capacity >= 65536) {
        if constexpr (is_same_v<char_type, char>) {
          for (size_t index = 0; index < count; ++index) *out++ = buffer[index];
        } else {
          const char *first = buffer.data(); const char *last = first + count;
          while (first != last) {
            auto decoded = ftl_locale_runtime::decode_wide(context_.native, first, last);
            if (decoded.result != ftl_locale_runtime::decoded_wide::status::complete) break;
            *out++ = static_cast<char_type>(decoded.value); first += decoded.consumed;
          }
        }
        return out;
      }
      capacity *= 2;
    }
  }
private:
  detail::locale_named_time_context context_;
};

class money_base {
public:
  enum part { none, space, symbol, sign, value };

  struct pattern {
    char field[4];
  };
};

template <class Character, bool International = false>
class moneypunct : public locale::facet, public money_base {
  static_assert(is_same_v<Character, char> || is_same_v<Character, wchar_t>,
                "FTL provides the required moneypunct "
                "specializations for char and wchar_t");

public:
  using char_type = Character;
  using string_type = basic_string<Character>;

  explicit moneypunct(size_t refs = 0) : locale::facet(refs) {}

  [[nodiscard]]
  char_type decimal_point() const {
    return do_decimal_point();
  }

  [[nodiscard]]
  char_type thousands_sep() const {
    return do_thousands_sep();
  }

  [[nodiscard]]
  string grouping() const {
    return do_grouping();
  }

  [[nodiscard]]
  string_type curr_symbol() const {
    return do_curr_symbol();
  }

  [[nodiscard]]
  string_type positive_sign() const {
    return do_positive_sign();
  }

  [[nodiscard]]
  string_type negative_sign() const {
    return do_negative_sign();
  }

  [[nodiscard]]
  int frac_digits() const {
    return do_frac_digits();
  }

  [[nodiscard]]
  pattern pos_format() const {
    return do_pos_format();
  }

  [[nodiscard]]
  pattern neg_format() const {
    return do_neg_format();
  }

  inline static locale::id id{};

  inline static constexpr bool intl = International;

protected:
  ~moneypunct() override = default;

  virtual char_type do_decimal_point() const {
    return static_cast<char_type>('.');
  }

  virtual char_type do_thousands_sep() const {
    return static_cast<char_type>(',');
  }

  virtual string do_grouping() const { return {}; }

  virtual string_type do_curr_symbol() const { return {}; }

  virtual string_type do_positive_sign() const { return {}; }

  virtual string_type do_negative_sign() const { return {}; }

  virtual int do_frac_digits() const { return 0; }

  virtual pattern do_pos_format() const {
    return pattern{{static_cast<char>(symbol), static_cast<char>(sign),
                    static_cast<char>(none), static_cast<char>(value)}};
  }

  virtual pattern do_neg_format() const {
    return pattern{{static_cast<char>(symbol), static_cast<char>(sign),
                    static_cast<char>(none), static_cast<char>(value)}};
  }
};

