template <class Character>
[[nodiscard]]
inline basic_string<Character>
locale_named_collate_transform(
    ftl_locale_runtime::native_handle native,
    const Character *low,
    const Character *high) {
  basic_string<Character> result;

  const Character *current = low;

  for (;;) {
    const Character *segment_end = current;

    while (segment_end != high &&
           *segment_end != Character{}) {
      ++segment_end;
    }

    basic_string<Character> source(
        current,
        segment_end);

    const size_t required =
        locale_collate_transform_size<Character>(
            native,
            source.c_str());

    basic_string<Character> transformed(
        required + 1,
        Character{});

    locale_collate_transform_into<Character>(
        native,
        transformed.data(),
        required + 1,
        source.c_str());

    transformed.resize(required);

    //
    // Encode transformed units as:
    //
    //     1, unit, 1, unit, ..., 0
    //
    // This preserves lexicographical ordering of each CRT
    // transform while also preserving embedded NUL characters
    // from the original C++ [low, high) range. The C runtime's
    // xfrm API itself is NUL-terminated.
    //
    result.reserve(
        result.size() +
        transformed.size() * 2 +
        1);

    for (Character value : transformed) {
      result.push_back(
          static_cast<Character>(1));

      result.push_back(value);
    }

    result.push_back(Character{});

    if (segment_end == high)
      break;

    current = segment_end + 1;
  }

  return result;
}

template <class Character>
[[nodiscard]]
inline long locale_named_collate_hash(
    const basic_string<Character> &key) noexcept {
  return collate_hash_range(
      key.data(),
      key.data() + key.size());
}

} // namespace detail

template <class Character>
class collate_byname : public collate<Character> {
  static_assert(
      is_same_v<Character, char> ||
          is_same_v<Character, wchar_t>,
      "FTL provides the standard collate_byname specializations "
      "for char and wchar_t");

public:
  using string_type = basic_string<Character>;

  explicit collate_byname(
      const char *name,
      size_t refs = 0)
      : collate<Character>(refs),
        context_(
            new detail::locale_named_collate_context(
                name)) {}

  explicit collate_byname(
      const string &name,
      size_t refs = 0)
      : collate_byname(name.c_str(), refs) {}

protected:
  ~collate_byname() override {
    delete context_;
  }

  int do_compare(
      const Character *low1,
      const Character *high1,
      const Character *low2,
      const Character *high2) const override {
    const auto left =
        detail::locale_named_collate_transform(
            context_->native,
            low1,
            high1);

    const auto right =
        detail::locale_named_collate_transform(
            context_->native,
            low2,
            high2);

    return detail::collate_lexicographical_compare(
        left.data(),
        left.data() + left.size(),
        right.data(),
        right.data() + right.size());
  }

  string_type do_transform(
      const Character *low,
      const Character *high) const override {
    return detail::locale_named_collate_transform(
        context_->native,
        low,
        high);
  }

  long do_hash(
      const Character *low,
      const Character *high) const override {
    const auto transformed =
        do_transform(low, high);

    return detail::locale_named_collate_hash(
        transformed);
  }

private:
  detail::locale_named_collate_context *context_;
};

