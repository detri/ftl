struct locale_facet_control {
  atomic<size_t> references{1};
  const locale::facet *value;

  explicit locale_facet_control(const locale::facet *facet) noexcept
      : value(facet) {}

  void retain() noexcept { references.fetch_add(1, memory_order_relaxed); }

  void release() noexcept {
    if (references.fetch_sub(1, memory_order_release) != 1)
      return;

    atomic_thread_fence(memory_order_acquire);

    const locale::facet *facet = value;
    const bool destroy = facet != nullptr && facet->refs_ == 0;

    delete this;

    if (destroy)
      delete facet;
  }
};

struct locale_classic_collate_char final
    : collate<char> {
  locale_classic_collate_char()
      : collate<char>(1) {}

  ~locale_classic_collate_char() override = default;
};

struct locale_classic_collate_wchar final
    : collate<wchar_t> {
  locale_classic_collate_wchar()
      : collate<wchar_t>(1) {}

  ~locale_classic_collate_wchar() override = default;
};

inline locale_facet_control &
locale_classic_collate_char_control() {
  static locale_classic_collate_char facet;
  static locale_facet_control control(&facet);

  return control;
}

inline locale_facet_control &
locale_classic_collate_wchar_control() {
  static locale_classic_collate_wchar facet;
  static locale_facet_control control(&facet);

  return control;
}

