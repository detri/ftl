template <
    class Character,
    bool International = false>
class moneypunct_byname
    : public moneypunct<
          Character,
          International> {
public:
  using base_type =
      moneypunct<
          Character,
          International>;

  using char_type =
      typename base_type::char_type;

  using string_type =
      typename base_type::string_type;

  using pattern =
      money_base::pattern;

  explicit moneypunct_byname(
      const char *name,
      size_t refs = 0)
      : base_type(refs),
        context_(
            new detail::
                locale_named_moneypunct_context(
                    name)) {}

  explicit moneypunct_byname(
      const string &name,
      size_t refs = 0)
      : moneypunct_byname(
            name.c_str(),
            refs) {}

protected:
  ~moneypunct_byname() override {
    delete context_;
  }

  char_type
  do_decimal_point() const override {
    return detail::
        locale_named_monetary_character<
            Character>(
            *context_,
            context_->monetary.decimal_point,
            '.');
  }

  char_type
  do_thousands_sep() const override {
    return detail::
        locale_named_monetary_character<
            Character>(
            *context_,
            context_->monetary.thousands_sep,
            ',');
  }

  string
  do_grouping() const override {
    return context_->monetary.grouping;
  }

  string_type
  do_curr_symbol() const override {
    const string &symbol =
        International
            ? context_->monetary
                  .international_symbol
            : context_->monetary
                  .local_symbol;

    return detail::
        locale_named_monetary_string<
            Character>(
            *context_,
            symbol);
  }

  string_type
  do_positive_sign() const override {
    const unsigned position =
        detail::
            locale_monetary_sign_position<
                International>(
                context_->monetary,
                true);

    if (position == 0) {
      return detail::
          locale_ascii_string<Character>(
              "()");
    }

    return detail::
        locale_named_monetary_string<
            Character>(
            *context_,
            context_->monetary
                .positive_sign);
  }

  string_type
  do_negative_sign() const override {
    const unsigned position =
        detail::
            locale_monetary_sign_position<
                International>(
                context_->monetary,
                false);

    if (position == 0) {
      return detail::
          locale_ascii_string<Character>(
              "()");
    }

    return detail::
        locale_named_monetary_string<
            Character>(
            *context_,
            context_->monetary
                .negative_sign);
  }

  int
  do_frac_digits() const override {
    return detail::locale_monetary_frac_digits(
        International
            ? context_->monetary
                  .international_frac_digits
            : context_->monetary
                  .local_frac_digits);
  }

  pattern
  do_pos_format() const override {
    return detail::locale_monetary_pattern(
        detail::
            locale_monetary_cs_precedes<
                International>(
                context_->monetary,
                true),
        detail::
            locale_monetary_sep_by_space<
                International>(
                context_->monetary,
                true),
        detail::
            locale_monetary_sign_position<
                International>(
                context_->monetary,
                true));
  }

  pattern
  do_neg_format() const override {
    return detail::locale_monetary_pattern(
        detail::
            locale_monetary_cs_precedes<
                International>(
                context_->monetary,
                false),
        detail::
            locale_monetary_sep_by_space<
                International>(
                context_->monetary,
                false),
        detail::
            locale_monetary_sign_position<
                International>(
                context_->monetary,
                false));
  }

private:
  detail::locale_named_moneypunct_context
      *context_;
};

