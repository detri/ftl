struct locale_named_monetary_snapshot {
  string decimal_point;
  string thousands_sep;
  string grouping;

  string international_symbol;
  string local_symbol;

  string positive_sign;
  string negative_sign;

  unsigned char international_frac_digits{};
  unsigned char local_frac_digits{};

  unsigned char positive_cs_precedes{};
  unsigned char positive_sep_by_space{};
  unsigned char positive_sign_position{};

  unsigned char negative_cs_precedes{};
  unsigned char negative_sep_by_space{};
  unsigned char negative_sign_position{};

  unsigned char international_positive_cs_precedes{};
  unsigned char international_positive_sep_by_space{};
  unsigned char international_positive_sign_position{};

  unsigned char international_negative_cs_precedes{};
  unsigned char international_negative_sep_by_space{};
  unsigned char international_negative_sign_position{};
};

[[noreturn]]
inline void locale_named_moneypunct_failure() {
#if FTL_HAS_EXCEPTIONS
  throw runtime_error("moneypunct_byname");
#else
  terminate();
#endif
}

inline string locale_monetary_copy_string(const char *value) {
  return value != nullptr ? string(value) : string{};
}

#if defined(_WIN32)

inline string locale_current_monetary_name() {
  const char *current = ::setlocale(LC_MONETARY, nullptr);

  return current != nullptr ? string(current) : string("C");
}

class locale_windows_monetary_scope {
public:
  explicit locale_windows_monetary_scope(const char *name)
      : previous_name_(locale_current_monetary_name()),
        previous_mode_(ftl_locale_runtime::_configthreadlocale(1)),
        active_(false) {
    if (previous_mode_ == -1)
      locale_named_moneypunct_failure();

    if (::setlocale(LC_MONETARY, name) == nullptr) {
      if (previous_mode_ == 2) {
        (void)ftl_locale_runtime::_configthreadlocale(2);
      }

      locale_named_moneypunct_failure();
    }

    active_ = true;
  }

  locale_windows_monetary_scope(const locale_windows_monetary_scope &) = delete;

  locale_windows_monetary_scope &
  operator=(const locale_windows_monetary_scope &) = delete;

  ~locale_windows_monetary_scope() {
    if (active_) {
      (void)::setlocale(LC_MONETARY, previous_name_.c_str());
    }

    if (previous_mode_ == 2) {
      (void)ftl_locale_runtime::_configthreadlocale(2);
    }
  }

private:
  string previous_name_;
  int previous_mode_;
  bool active_;
};

#else

class locale_posix_monetary_scope {
public:
  explicit locale_posix_monetary_scope(ftl_locale_runtime::native_handle locale)
      : previous_(ftl_locale_runtime::uselocale(locale)) {
    if (previous_ == nullptr)
      locale_named_moneypunct_failure();
  }

  locale_posix_monetary_scope(const locale_posix_monetary_scope &) = delete;

  locale_posix_monetary_scope &
  operator=(const locale_posix_monetary_scope &) = delete;

  ~locale_posix_monetary_scope() {
    (void)ftl_locale_runtime::uselocale(previous_);
  }

private:
  ftl_locale_runtime::native_handle previous_;
};

#endif

inline locale_named_monetary_snapshot
locale_load_monetary_snapshot(const char *name,
                              ftl_locale_runtime::native_handle native) {
#if defined(_WIN32)
  locale_windows_monetary_scope scope(name);
#else
  locale_posix_monetary_scope scope(native);
  (void)name;
#endif

  ::lconv *information = ::localeconv();

  if (information == nullptr)
    locale_named_moneypunct_failure();

  locale_named_monetary_snapshot result;

  result.decimal_point =
      locale_monetary_copy_string(information->mon_decimal_point);

  result.thousands_sep =
      locale_monetary_copy_string(information->mon_thousands_sep);

  result.grouping = locale_monetary_copy_string(information->mon_grouping);

  result.international_symbol =
      locale_monetary_copy_string(information->int_curr_symbol);

  result.local_symbol =
      locale_monetary_copy_string(information->currency_symbol);

  result.positive_sign =
      locale_monetary_copy_string(information->positive_sign);

  result.negative_sign =
      locale_monetary_copy_string(information->negative_sign);

  result.international_frac_digits =
      static_cast<unsigned char>(information->int_frac_digits);

  result.local_frac_digits =
      static_cast<unsigned char>(information->frac_digits);

  result.positive_cs_precedes =
      static_cast<unsigned char>(information->p_cs_precedes);

  result.positive_sep_by_space =
      static_cast<unsigned char>(information->p_sep_by_space);

  result.positive_sign_position =
      static_cast<unsigned char>(information->p_sign_posn);

  result.negative_cs_precedes =
      static_cast<unsigned char>(information->n_cs_precedes);

  result.negative_sep_by_space =
      static_cast<unsigned char>(information->n_sep_by_space);

  result.negative_sign_position =
      static_cast<unsigned char>(information->n_sign_posn);

#if defined(_WIN32)
  //
  // Microsoft's native lconv ABI historically does not expose
  // the C99 int_p_* / int_n_* placement extension consistently.
  // The international symbol and fractional digit count are
  // available, so use the corresponding local placement rules.
  //
  result.international_positive_cs_precedes = result.positive_cs_precedes;

  result.international_positive_sep_by_space = result.positive_sep_by_space;

  result.international_positive_sign_position = result.positive_sign_position;

  result.international_negative_cs_precedes = result.negative_cs_precedes;

  result.international_negative_sep_by_space = result.negative_sep_by_space;

  result.international_negative_sign_position = result.negative_sign_position;
#else
  result.international_positive_cs_precedes =
      static_cast<unsigned char>(information->int_p_cs_precedes);

  result.international_positive_sep_by_space =
      static_cast<unsigned char>(information->int_p_sep_by_space);

  result.international_positive_sign_position =
      static_cast<unsigned char>(information->int_p_sign_posn);

  result.international_negative_cs_precedes =
      static_cast<unsigned char>(information->int_n_cs_precedes);

  result.international_negative_sep_by_space =
      static_cast<unsigned char>(information->int_n_sep_by_space);

  result.international_negative_sign_position =
      static_cast<unsigned char>(information->int_n_sign_posn);
#endif

  return result;
}

struct locale_named_moneypunct_context {
  ftl_locale_runtime::native_handle native{};
  locale_named_monetary_snapshot monetary;

  explicit locale_named_moneypunct_context(const char *name)
      : native(ftl_locale_runtime::create_monetary(name)) {
    if (native == nullptr)
      locale_named_moneypunct_failure();

#if FTL_HAS_EXCEPTIONS
    try {
      monetary = locale_load_monetary_snapshot(name, native);
    } catch (...) {
      ftl_locale_runtime::destroy(native);
      native = nullptr;
      throw;
    }
#else
    monetary = locale_load_monetary_snapshot(name, native);
#endif
  }

  locale_named_moneypunct_context(const locale_named_moneypunct_context &) =
      delete;

  locale_named_moneypunct_context &
  operator=(const locale_named_moneypunct_context &) = delete;

  ~locale_named_moneypunct_context() { ftl_locale_runtime::destroy(native); }
};

template <class Character>
[[nodiscard]]
inline Character
locale_named_monetary_character(const locale_named_moneypunct_context &context,
                                const string &source, char fallback) noexcept {
  if (source.empty())
    return static_cast<Character>(fallback);

  if constexpr (is_same_v<Character, char>) {
    return source[0];
  } else {
    return ftl_locale_runtime::widen_first(context.native, source.c_str(),
                                           static_cast<wchar_t>(fallback));
  }
}

template <class Character>
[[nodiscard]]
inline basic_string<Character>
locale_named_monetary_string(const locale_named_moneypunct_context &context,
                             const string &source) {
  if constexpr (is_same_v<Character, char>) {
    return source;
  } else {
    basic_string<Character> result;

    const char *current = source.data();

    const char *end = source.data() + source.size();

    while (current != end) {
      const auto decoded =
          ftl_locale_runtime::decode_wide(context.native, current, end);

      if (decoded.result ==
          ftl_locale_runtime::decoded_wide::status::complete) {
        result.push_back(static_cast<Character>(decoded.value));

        current += decoded.consumed;
        continue;
      }

      //
      // Preserve progress deterministically even if the native
      // locale contains an exotic sequence that its own wchar_t
      // conversion API cannot represent.
      //
      result.push_back(
          static_cast<Character>(static_cast<unsigned char>(*current)));

      ++current;
    }

    return result;
  }
}

[[nodiscard]]
inline money_base::pattern
locale_monetary_pattern(unsigned cs_precedes, unsigned sep_by_space,
                        unsigned sign_position) noexcept {
  using part = money_base::part;

  const auto make = [](part first, part second, part third, part fourth) {
    return money_base::pattern{
        {static_cast<char>(first), static_cast<char>(second),
         static_cast<char>(third), static_cast<char>(fourth)}};
  };

  const auto fallback = make(money_base::symbol, money_base::sign,
                             money_base::none, money_base::value);

  if (cs_precedes > 1 || sep_by_space > 2 || sign_position > 4) {
    return fallback;
  }

  const bool currency_first = cs_precedes != 0;

  switch (sign_position) {
  case 0:
    if (currency_first) {
      return sep_by_space == 1 ? make(money_base::sign, money_base::symbol,
                                      money_base::space, money_base::value)
                               : make(money_base::sign, money_base::symbol,
                                      money_base::none, money_base::value);
    }

    return sep_by_space == 0 ? make(money_base::sign, money_base::value,
                                    money_base::none, money_base::symbol)
                             : make(money_base::sign, money_base::value,
                                    money_base::space, money_base::symbol);

  case 1:
    if (currency_first) {
      if (sep_by_space == 2) {
        return make(money_base::sign, money_base::space, money_base::symbol,
                    money_base::value);
      }

      if (sep_by_space == 1) {
        return make(money_base::sign, money_base::symbol, money_base::space,
                    money_base::value);
      }

      return make(money_base::sign, money_base::symbol, money_base::none,
                  money_base::value);
    }

    return sep_by_space == 0 ? make(money_base::sign, money_base::value,
                                    money_base::none, money_base::symbol)
                             : make(money_base::sign, money_base::value,
                                    money_base::space, money_base::symbol);

  case 2:
    if (currency_first) {
      if (sep_by_space == 2) {
        return make(money_base::symbol, money_base::value, money_base::space,
                    money_base::sign);
      }

      if (sep_by_space == 1) {
        return make(money_base::symbol, money_base::space, money_base::value,
                    money_base::sign);
      }

      return make(money_base::symbol, money_base::none, money_base::value,
                  money_base::sign);
    }

    if (sep_by_space == 2) {
      return make(money_base::value, money_base::symbol, money_base::space,
                  money_base::sign);
    }

    if (sep_by_space == 1) {
      return make(money_base::value, money_base::space, money_base::symbol,
                  money_base::sign);
    }

    return make(money_base::value, money_base::none, money_base::symbol,
                money_base::sign);

  case 3:
    if (currency_first) {
      if (sep_by_space == 2) {
        return make(money_base::sign, money_base::space, money_base::symbol,
                    money_base::value);
      }

      if (sep_by_space == 1) {
        return make(money_base::sign, money_base::symbol, money_base::space,
                    money_base::value);
      }

      return make(money_base::sign, money_base::symbol, money_base::none,
                  money_base::value);
    }

    if (sep_by_space == 2) {
      return make(money_base::value, money_base::sign, money_base::space,
                  money_base::symbol);
    }

    if (sep_by_space == 1) {
      return make(money_base::value, money_base::space, money_base::sign,
                  money_base::symbol);
    }

    return make(money_base::value, money_base::none, money_base::sign,
                money_base::symbol);

  case 4:
    if (currency_first) {
      if (sep_by_space == 2) {
        return make(money_base::symbol, money_base::space, money_base::sign,
                    money_base::value);
      }

      if (sep_by_space == 1) {
        return make(money_base::symbol, money_base::sign, money_base::space,
                    money_base::value);
      }

      return make(money_base::symbol, money_base::sign, money_base::none,
                  money_base::value);
    }

    if (sep_by_space == 2) {
      return make(money_base::value, money_base::symbol, money_base::space,
                  money_base::sign);
    }

    if (sep_by_space == 1) {
      return make(money_base::value, money_base::space, money_base::symbol,
                  money_base::sign);
    }

    return make(money_base::value, money_base::none, money_base::symbol,
                money_base::sign);
  }

  return fallback;
}

[[nodiscard]]
inline int locale_monetary_frac_digits(unsigned char value) noexcept {
  const auto signed_char_max =
      static_cast<unsigned char>(numeric_limits<char>::max());

  const auto unsigned_char_max = numeric_limits<unsigned char>::max();

  if (value == signed_char_max || value == unsigned_char_max) {
    return 0;
  }

  return static_cast<int>(value);
}

