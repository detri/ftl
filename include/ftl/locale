inline string
locale_current_monetary_name() {
  const char *current =
      ::setlocale(
          LC_MONETARY,
          nullptr);

  return current != nullptr
             ? string(current)
             : string("C");
}

class locale_windows_monetary_scope {
public:
  explicit locale_windows_monetary_scope(
      const char *name)
      : previous_name_(
            locale_current_monetary_name()),
        previous_mode_(
            ftl_locale_runtime::
                _configthreadlocale(1)),
        active_(false) {
    if (previous_mode_ == -1)
      locale_named_moneypunct_failure();

    if (::setlocale(
            LC_MONETARY,
            name) == nullptr) {
      if (previous_mode_ == 2) {
        (void)ftl_locale_runtime::
            _configthreadlocale(2);
      }

      locale_named_moneypunct_failure();
    }

    active_ = true;
  }

  locale_windows_monetary_scope(
      const locale_windows_monetary_scope &) =
      delete;

  locale_windows_monetary_scope &
  operator=(
      const locale_windows_monetary_scope &) =
      delete;

  ~locale_windows_monetary_scope() {
    if (active_) {
      (void)::setlocale(
          LC_MONETARY,
          previous_name_.c_str());
    }

    if (previous_mode_ == 2) {
      (void)ftl_locale_runtime::
          _configthreadlocale(2);
    }
  }

private:
  string previous_name_;
  int previous_mode_;
  bool active_;
};

