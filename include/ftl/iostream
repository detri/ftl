inline istream cin{nullptr};
inline ostream cout{nullptr};
inline ostream cerr{nullptr};
inline ostream clog{nullptr};
inline wistream wcin{nullptr};
inline wostream wcout{nullptr};
inline wostream wcerr{nullptr};
inline wostream wclog{nullptr};

namespace detail {
template <class Character, class Traits> class standard_filebuf;

template <class Traits>
class standard_filebuf<char, Traits> : public basic_streambuf<char, Traits> {
public:
  standard_filebuf(FILE *file, bool input) : file_(file), input_(input) {}

protected:
  typename Traits::int_type underflow() override {
    if (!input_)
      return Traits::eof();
    int value = ::ftl_cstdio_runtime::fgetc(file_);
    if (value == EOF)
      return Traits::eof();
    cache_ = static_cast<char>(value);
    this->setg(&cache_, &cache_, &cache_ + 1);
    return Traits::to_int_type(cache_);
  }
  typename Traits::int_type
  pbackfail(typename Traits::int_type value = Traits::eof()) override {
    if (!input_)
      return Traits::eof();
    int character =
        Traits::eq_int_type(value, Traits::eof())
            ? (this->gptr() && this->gptr() != this->eback()
                   ? static_cast<unsigned char>(this->gptr()[-1])
                   : EOF)
            : static_cast<unsigned char>(Traits::to_char_type(value));
    if (character == EOF ||
        ::ftl_cstdio_runtime::ungetc(character, file_) == EOF)
      return Traits::eof();
    this->setg(nullptr, nullptr, nullptr);
    return Traits::not_eof(value);
  }
  typename Traits::int_type
  overflow(typename Traits::int_type value = Traits::eof()) override {
    if (input_)
      return Traits::eof();
    if (Traits::eq_int_type(value, Traits::eof()))
      return Traits::not_eof(value);
    return ::ftl_cstdio_runtime::fputc(
               static_cast<unsigned char>(Traits::to_char_type(value)),
               file_) == EOF
               ? Traits::eof()
               : value;
  }
  streamsize xsputn(const char *data, streamsize count) override {
    if (input_ || count <= 0)
      return 0;
    return static_cast<streamsize>(::ftl_cstdio_runtime::fwrite(
        data, 1, static_cast<size_t>(count), file_));
  }
  int sync() override { return ::ftl_cstdio_runtime::fflush(file_); }

private:
  FILE *file_;
  bool input_;
  char cache_{};
};

template <class Traits>
class standard_filebuf<wchar_t, Traits>
    : public basic_streambuf<wchar_t, Traits> {
public:
  standard_filebuf(FILE *file, bool input) : file_(file), input_(input) {}

protected:
  typename Traits::int_type underflow() override {
    if (!input_)
      return Traits::eof();
    auto value = ::ftl_cwchar_runtime::fgetwc(file_);
    if (value == static_cast<ftl_cwchar_native_wint_t>(-1))
      return Traits::eof();
    cache_ = static_cast<wchar_t>(value);
    this->setg(&cache_, &cache_, &cache_ + 1);
    return Traits::to_int_type(cache_);
  }
  typename Traits::int_type
  overflow(typename Traits::int_type value = Traits::eof()) override {
    if (input_)
      return Traits::eof();
    if (Traits::eq_int_type(value, Traits::eof()))
      return Traits::not_eof(value);
    auto result =
        ::ftl_cwchar_runtime::fputwc(Traits::to_char_type(value), file_);
    return result == static_cast<ftl_cwchar_native_wint_t>(-1) ? Traits::eof()
                                                               : value;
  }
  int sync() override { return ::ftl_cstdio_runtime::fflush(file_); }

private:
  FILE *file_;
  bool input_;
  wchar_t cache_{};
};

struct standard_stream_buffers {
  standard_filebuf<char, char_traits<char>> in{stdin, true}, out{stdout, false},
      err{stderr, false};
  standard_filebuf<wchar_t, char_traits<wchar_t>> win{stdin, true},
      wout{stdout, false}, werr{stderr, false};
};
inline once_flag standard_stream_once;
inline atomic<unsigned> standard_stream_users{0};
inline standard_stream_buffers *standard_buffers{};

inline void initialize_standard_streams() {
  call_once(standard_stream_once, [] {
    static standard_stream_buffers buffers;
    standard_buffers = &buffers;
    cin.rdbuf(&buffers.in);
    cout.rdbuf(&buffers.out);
    cerr.rdbuf(&buffers.err);
    clog.rdbuf(&buffers.err);
    wcin.rdbuf(&buffers.win);
    wcout.rdbuf(&buffers.wout);
    wcerr.rdbuf(&buffers.werr);
    wclog.rdbuf(&buffers.werr);
    cin.tie(&cout);
    wcin.tie(&wcout);
    cerr.tie(&cout);
    wcerr.tie(&wcout);
    cerr.setf(ios_base::unitbuf);
    wcerr.setf(ios_base::unitbuf);
    cin.clear();
    cout.clear();
    cerr.clear();
    clog.clear();
    wcin.clear();
    wcout.clear();
    wcerr.clear();
    wclog.clear();
  });
}
inline void flush_standard_streams() {
  cout.flush();
  cerr.flush();
  clog.flush();
  wcout.flush();
  wcerr.flush();
  wclog.flush();
}
} // namespace detail

inline ios_base::Init::Init() {
  detail::initialize_standard_streams();
  detail::standard_stream_users.fetch_add(1, memory_order_relaxed);
}
inline ios_base::Init::~Init() {
  if (detail::standard_stream_users.fetch_sub(1, memory_order_release) == 1) {
    atomic_thread_fence(memory_order_acquire);
    detail::flush_standard_streams();
  }
}

