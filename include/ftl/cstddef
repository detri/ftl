#ifndef FTL_CSTDDEF_HEADER
#define FTL_CSTDDEF_HEADER

#ifndef NULL
#define NULL nullptr
#endif

#ifndef offsetof
#if defined(_MSC_VER) && !defined(__clang__)
#define offsetof(P, D) ((decltype(sizeof(0)))&reinterpret_cast<const volatile char&>(((P*)0)->D))
#else
#define offsetof(P, D) __builtin_offsetof(P, D)
#endif
#endif

#ifdef FTL_REPLACE_STL
#define FTL_CSTDDEF_BEGIN_NAMESPACE namespace std {
#define FTL_CSTDDEF_END_NAMESPACE }
#else
#define FTL_CSTDDEF_BEGIN_NAMESPACE namespace ftl {
#define FTL_CSTDDEF_END_NAMESPACE }
#endif

FTL_CSTDDEF_BEGIN_NAMESPACE

using size_t = decltype(sizeof(0));
using ptrdiff_t = decltype(static_cast<int*>(nullptr) -
                           static_cast<int*>(nullptr));
using nullptr_t = decltype(nullptr);

union max_align_t {
    long double long_double;
    void* pointer;
};

enum class byte : unsigned char {};

namespace detail {
template<class T, class U>
inline constexpr bool cstddef_same_as = false;

template<class T>
inline constexpr bool cstddef_same_as<T, T> = true;

template<class T>
struct cstddef_remove_cv { using type = T; };
template<class T>
struct cstddef_remove_cv<const T> { using type = T; };
template<class T>
struct cstddef_remove_cv<volatile T> { using type = T; };
template<class T>
struct cstddef_remove_cv<const volatile T> { using type = T; };

template<class T>
inline constexpr bool cstddef_integral =
    cstddef_same_as<typename cstddef_remove_cv<T>::type, bool> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, char> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, signed char> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, unsigned char> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, wchar_t> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, char8_t> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, char16_t> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, char32_t> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, short> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, unsigned short> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, int> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, unsigned int> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, long> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, unsigned long> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, long long> ||
    cstddef_same_as<typename cstddef_remove_cv<T>::type, unsigned long long>
#if defined(__SIZEOF_INT128__)
    || cstddef_same_as<typename cstddef_remove_cv<T>::type, __int128>
    || cstddef_same_as<typename cstddef_remove_cv<T>::type,
                       unsigned __int128>
#endif
    ;
} // namespace detail

template<class Integer>
    requires detail::cstddef_integral<Integer>
constexpr byte operator<<(byte value, Integer shift) noexcept {
    return byte(static_cast<unsigned int>(value) << shift);
}

template<class Integer>
    requires detail::cstddef_integral<Integer>
constexpr byte operator>>(byte value, Integer shift) noexcept {
    return byte(static_cast<unsigned int>(value) >> shift);
}

constexpr byte operator|(byte left, byte right) noexcept {
    return byte(static_cast<unsigned char>(left) |
                static_cast<unsigned char>(right));
}

constexpr byte operator&(byte left, byte right) noexcept {
    return byte(static_cast<unsigned char>(left) &
                static_cast<unsigned char>(right));
}

constexpr byte operator^(byte left, byte right) noexcept {
    return byte(static_cast<unsigned char>(left) ^
                static_cast<unsigned char>(right));
}

constexpr byte operator~(byte value) noexcept {
    return byte(~static_cast<unsigned char>(value));
}

template<class Integer>
    requires detail::cstddef_integral<Integer>
constexpr byte& operator<<=(byte& value, Integer shift) noexcept {
    return value = value << shift;
}

template<class Integer>
    requires detail::cstddef_integral<Integer>
constexpr byte& operator>>=(byte& value, Integer shift) noexcept {
    return value = value >> shift;
}

constexpr byte& operator|=(byte& left, byte right) noexcept {
    return left = left | right;
}

constexpr byte& operator&=(byte& left, byte right) noexcept {
    return left = left & right;
}

constexpr byte& operator^=(byte& left, byte right) noexcept {
    return left = left ^ right;
}

template<class Integer>
    requires detail::cstddef_integral<Integer>
constexpr Integer to_integer(byte value) noexcept {
    return static_cast<Integer>(value);
}

FTL_CSTDDEF_END_NAMESPACE

#undef FTL_CSTDDEF_BEGIN_NAMESPACE
#undef FTL_CSTDDEF_END_NAMESPACE

#if !defined(__cpp_lib_byte) || __cpp_lib_byte < 201603L
#undef __cpp_lib_byte
#define __cpp_lib_byte 201603L
#endif

#endif // FTL_CSTDDEF_HEADER
