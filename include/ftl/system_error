class generic_error_category final : public error_category {
public:
  const char *name() const noexcept override { return "generic"; }
  string message(int value) const override {
    const errno_guard guard;
    const char *text = ::strerror(value);
    return text == nullptr ? string{"Unknown error"} : string{text};
  }
};

class system_error_category final : public error_category {
public:
  const char *name() const noexcept override { return "system"; }
  error_condition default_error_condition(int value) const noexcept override {
#if defined(_WIN32)
    const int mapped = windows_error_to_errc(value);
    if (value == 0 || mapped != 0)
      return error_condition{mapped, generic_category()};
    return error_condition{value, *this};
#else
    return value == 0 || detail::is_errc_value(value)
               ? error_condition{value, generic_category()}
               : error_condition{value, *this};
#endif
  }
  string message(int value) const override {
#if defined(_WIN32)
    constexpr unsigned long allocate_buffer = 0x00000100UL;
    constexpr unsigned long from_system = 0x00001000UL;
    constexpr unsigned long ignore_inserts = 0x00000200UL;
    char *text = nullptr;
    const unsigned long count = ::FormatMessageA(
        allocate_buffer | from_system | ignore_inserts, nullptr,
        static_cast<unsigned long>(value), 0,
        reinterpret_cast<char *>(&text), 0, nullptr);
    if (!count || !text)
      return string{"Unknown error"};
    size_t length = count;
    while (length && (text[length - 1] == '\r' || text[length - 1] == '\n'))
      --length;
    string result(text, length);
    (void)::LocalFree(text);
    return result;
#else
    const errno_guard guard;
    const char *text = ::strerror(value);
    return text == nullptr ? string{"Unknown error"} : string{text};
#endif
  }
};
} // namespace detail

inline const error_category &generic_category() noexcept {
  static detail::generic_error_category value;
  return value;
}
inline const error_category &system_category() noexcept {
  static detail::system_error_category value;
  return value;
}

inline error_code make_error_code(errc value) noexcept {
  return {static_cast<int>(value), generic_category()};
}
inline error_condition make_error_condition(errc value) noexcept {
  return {static_cast<int>(value), generic_category()};
}

inline bool operator==(const error_code &left,
                       const error_code &right) noexcept {
  return left.category() == right.category() && left.value() == right.value();
}
inline bool operator==(const error_condition &left,
                       const error_condition &right) noexcept {
  return left.category() == right.category() && left.value() == right.value();
}
inline bool operator==(const error_code &code,
                       const error_condition &condition) noexcept {
  return code.category().equivalent(code.value(), condition) ||
         condition.category().equivalent(code, condition.value());
}
inline strong_ordering operator<=>(const error_code &left,
                                   const error_code &right) noexcept {
  if (auto result = left.category() <=> right.category();
      result != strong_ordering::equal)
    return result;
  return left.value() < right.value()   ? strong_ordering::less
         : left.value() > right.value() ? strong_ordering::greater
                                        : strong_ordering::equal;
}
inline strong_ordering operator<=>(const error_condition &left,
                                   const error_condition &right) noexcept {
  if (auto result = left.category() <=> right.category();
      result != strong_ordering::equal)
    return result;
  return left.value() < right.value()   ? strong_ordering::less
         : left.value() > right.value() ? strong_ordering::greater
                                        : strong_ordering::equal;
}

class system_error : public runtime_error {
public:
  system_error(error_code code, const string &what_arg)
      : system_error(code, what_arg.c_str()) {}
  system_error(error_code code, const char *what_arg)
      : runtime_error(compose(code, what_arg)), code_(code) {}
  explicit system_error(error_code code)
      : runtime_error(code.message()), code_(code) {}
  system_error(int value, const error_category &category,
               const string &what_arg)
      : system_error(error_code{value, category}, what_arg) {}
  system_error(int value, const error_category &category, const char *what_arg)
      : system_error(error_code{value, category}, what_arg) {}
  system_error(int value, const error_category &category)
      : system_error(error_code{value, category}) {}

  const error_code &code() const noexcept { return code_; }

private:
  static string compose(error_code code, const char *what_arg) {
    string result{what_arg};
    result += ": ";
    result += code.message();
    return result;
  }
  error_code code_;
};

template <> struct hash<error_code> {
  size_t operator()(const error_code &value) const noexcept {
    const error_category *pointer = &value.category();
    const auto seed = ftl_rapidhash::rapidhash(&pointer, sizeof(pointer));
    const int code = value.value();
    return static_cast<size_t>(
        ftl_rapidhash::rapidhash_with_seed(&code, sizeof(code), seed));
  }
};
template <> struct hash<error_condition> {
  size_t operator()(const error_condition &value) const noexcept {
    const error_category *pointer = &value.category();
    const auto seed = ftl_rapidhash::rapidhash(&pointer, sizeof(pointer));
    const int condition = value.value();
    return static_cast<size_t>(
        ftl_rapidhash::rapidhash_with_seed(&condition, sizeof(condition), seed));
  }
};

