namespace detail {
struct compare_zero {
    constexpr compare_zero(int compare_zero::*) noexcept {}
};
}

class weak_ordering;
class partial_ordering;

class strong_ordering {
    constexpr explicit strong_ordering(signed char value) : state{value} {}
public:
    static const strong_ordering less;
    static const strong_ordering equal;
    static const strong_ordering equivalent;
    static const strong_ordering greater;

    constexpr operator weak_ordering() const noexcept;
    constexpr operator partial_ordering() const noexcept;
    friend constexpr bool
    operator==(strong_ordering, strong_ordering) noexcept = default;
    friend constexpr bool operator==(strong_ordering, detail::compare_zero) noexcept;
    friend constexpr bool operator<(strong_ordering value, detail::compare_zero) noexcept {
        return value.state < 0;
    }
    friend constexpr bool operator>(strong_ordering value, detail::compare_zero) noexcept {
        return value.state > 0;
    }
    friend constexpr bool operator<=(strong_ordering value, detail::compare_zero) noexcept {
        return value.state <= 0;
    }
    friend constexpr bool operator>=(strong_ordering value, detail::compare_zero) noexcept {
        return value.state >= 0;
    }
    friend constexpr strong_ordering
    operator<=>(strong_ordering value, detail::compare_zero) noexcept { return value; }
    friend constexpr strong_ordering
    operator<=>(detail::compare_zero, strong_ordering value) noexcept {
        return strong_ordering{static_cast<signed char>(-value.state)};
    }
private:
    signed char state;
};

class weak_ordering {
    constexpr explicit weak_ordering(signed char value) : state{value} {}
    friend class strong_ordering;
public:
    static const weak_ordering less;
    static const weak_ordering equivalent;
    static const weak_ordering greater;

    constexpr operator partial_ordering() const noexcept;
    friend constexpr bool
    operator==(weak_ordering, weak_ordering) noexcept = default;
    friend constexpr bool operator==(weak_ordering, detail::compare_zero) noexcept;
    friend constexpr bool operator<(weak_ordering value, detail::compare_zero) noexcept {
        return value.state < 0;
    }
    friend constexpr bool operator>(weak_ordering value, detail::compare_zero) noexcept {
        return value.state > 0;
    }
    friend constexpr bool operator<=(weak_ordering value, detail::compare_zero) noexcept {
        return value.state <= 0;
    }
    friend constexpr bool operator>=(weak_ordering value, detail::compare_zero) noexcept {
        return value.state >= 0;
    }
    friend constexpr weak_ordering
    operator<=>(weak_ordering value, detail::compare_zero) noexcept { return value; }
    friend constexpr weak_ordering
    operator<=>(detail::compare_zero, weak_ordering value) noexcept {
        return weak_ordering{static_cast<signed char>(-value.state)};
    }
private:
    signed char state;
};

class partial_ordering {
    constexpr explicit partial_ordering(signed char value) : state{value} {}
    friend class weak_ordering;
    friend class strong_ordering;
public:
    static const partial_ordering less;
    static const partial_ordering equivalent;
    static const partial_ordering greater;
    static const partial_ordering unordered;

    friend constexpr bool
    operator==(partial_ordering, partial_ordering) noexcept = default;
    friend constexpr bool operator==(partial_ordering value, detail::compare_zero) noexcept {
        return value.state == 0;
    }
    friend constexpr bool operator<(partial_ordering value, detail::compare_zero) noexcept {
        return value.state == -1;
    }
    friend constexpr bool operator>(partial_ordering value, detail::compare_zero) noexcept {
        return value.state == 1;
    }
    friend constexpr bool operator<=(partial_ordering value, detail::compare_zero) noexcept {
        return value.state == -1 || value.state == 0;
    }
    friend constexpr bool operator>=(partial_ordering value, detail::compare_zero) noexcept {
        return value.state == 1 || value.state == 0;
    }
    friend constexpr partial_ordering
    operator<=>(partial_ordering value, detail::compare_zero) noexcept { return value; }
    friend constexpr partial_ordering
    operator<=>(detail::compare_zero, partial_ordering value) noexcept {
        return value.state == 2
            ? value
            : partial_ordering{
                static_cast<signed char>(-value.state)};
    }
private:
    signed char state;
};

inline constexpr strong_ordering strong_ordering::less{-1};
inline constexpr strong_ordering strong_ordering::equal{0};
inline constexpr strong_ordering strong_ordering::equivalent{0};
inline constexpr strong_ordering strong_ordering::greater{1};
inline constexpr weak_ordering weak_ordering::less{-1};
inline constexpr weak_ordering weak_ordering::equivalent{0};
inline constexpr weak_ordering weak_ordering::greater{1};
inline constexpr partial_ordering partial_ordering::less{-1};
inline constexpr partial_ordering partial_ordering::equivalent{0};
inline constexpr partial_ordering partial_ordering::greater{1};
inline constexpr partial_ordering partial_ordering::unordered{2};

constexpr strong_ordering::operator weak_ordering() const noexcept {
    return weak_ordering{state};
}
constexpr strong_ordering::operator partial_ordering() const noexcept {
    return partial_ordering{state};
}
constexpr weak_ordering::operator partial_ordering() const noexcept {
    return partial_ordering{state};
}
constexpr bool operator==(strong_ordering value, detail::compare_zero) noexcept {
    return value.state == 0;
}
constexpr bool operator==(weak_ordering value, detail::compare_zero) noexcept {
    return value.state == 0;
}

constexpr bool is_eq(partial_ordering value) noexcept { return value == 0; }
constexpr bool is_neq(partial_ordering value) noexcept { return value != 0; }
constexpr bool is_lt(partial_ordering value) noexcept { return value < 0; }
constexpr bool is_lteq(partial_ordering value) noexcept { return value <= 0; }
constexpr bool is_gt(partial_ordering value) noexcept { return value > 0; }
constexpr bool is_gteq(partial_ordering value) noexcept { return value >= 0; }

template<class... T>
struct common_comparison_category {
    using type =
        conditional_t<(is_same_v<T, strong_ordering> && ...),
                      strong_ordering,
        conditional_t<((is_same_v<T, strong_ordering> ||
                        is_same_v<T, weak_ordering>) && ...),
                      weak_ordering,
        conditional_t<((is_same_v<T, strong_ordering> ||
                        is_same_v<T, weak_ordering> ||
                        is_same_v<T, partial_ordering>) && ...),
                      partial_ordering, void>>>;
};
template<class... T>
using common_comparison_category_t =
    typename common_comparison_category<T...>::type;

namespace detail {
template<class T, class Category>
concept compares_as = same_as<common_comparison_category_t<T, Category>,
                              Category>;
}

template<class T, class Category = partial_ordering>
concept three_way_comparable =
    equality_comparable<T> &&
    requires(const remove_reference_t<T>& left,
             const remove_reference_t<T>& right) {
        { left < right } -> detail::boolean_testable;
        { left > right } -> detail::boolean_testable;
        { left <= right } -> detail::boolean_testable;
        { left >= right } -> detail::boolean_testable;
        { left <=> right } -> detail::compares_as<Category>;
    };

template<class T, class U, class Category = partial_ordering>
concept three_way_comparable_with =
    three_way_comparable<T, Category> &&
    three_way_comparable<U, Category> &&
    detail::comparison_common_type_with<T, U> &&
    three_way_comparable<
        common_reference_t<
            const remove_reference_t<T>&,
            const remove_reference_t<U>&>,
        Category> &&
    detail::weakly_equality_comparable_with<T, U> &&
    detail::partially_ordered_with<T, U> &&
    requires(const remove_reference_t<T>& left,
             const remove_reference_t<U>& right) {
        { left <=> right } -> detail::compares_as<Category>;
        { right <=> left } -> detail::compares_as<Category>;
    };

template<class T, class U = T>
struct compare_three_way_result {};

template<class T, class U>
    requires requires { declval<const remove_reference_t<T>&>() <=>
                        declval<const remove_reference_t<U>&>(); }
struct compare_three_way_result<T, U> {
    using type = decltype(declval<const remove_reference_t<T>&>() <=>
                          declval<const remove_reference_t<U>&>());
};

template<class T, class U = T>
using compare_three_way_result_t = typename compare_three_way_result<T, U>::type;

namespace detail {

template<class T, class U>
concept compare_has_nonmember_three_way =
    requires(T&& left, U&& right) {
        operator<=>(static_cast<T&&>(left),
                    static_cast<U&&>(right));
    };

template<class T, class U>
concept compare_has_member_three_way =
    requires(T&& left, U&& right) {
        static_cast<T&&>(left).operator<=>(
            static_cast<U&&>(right));
    };

template<class T, class U>
concept builtin_pointer_three_way =
    convertible_to<T, const volatile void*> &&
    convertible_to<U, const volatile void*> &&
    !compare_has_nonmember_three_way<T, U> &&
    !compare_has_member_three_way<T, U>;

#ifndef FTL_REPLACE_STL

template<class T, class U>
concept builtin_arithmetic_three_way =
    is_arithmetic_v<decay_t<T>> &&
    is_arithmetic_v<decay_t<U>> &&
    (is_same_v<decay_t<T>, bool> ==
     is_same_v<decay_t<U>, bool>);

template<class T, class U>
concept builtin_enum_three_way =
    is_enum_v<decay_t<T>> &&
    same_as<decay_t<T>, decay_t<U>>;

template<class T, class U>
concept normal_compare_three_way =
    three_way_comparable_with<T, U> ||
    builtin_arithmetic_three_way<T, U> ||
    builtin_enum_three_way<T, U> ||
    builtin_pointer_three_way<T, U>;

#endif

template<class T, class U>
constexpr strong_ordering pointer_total_order(T&& left, U&& right)
    noexcept(noexcept(static_cast<const volatile void*>(
                 static_cast<T&&>(left))) &&
             noexcept(static_cast<const volatile void*>(
                 static_cast<U&&>(right)))) {
    const volatile void* left_pointer =
        static_cast<const volatile void*>(static_cast<T&&>(left));
    const volatile void* right_pointer =
        static_cast<const volatile void*>(static_cast<U&&>(right));

    if (left_pointer == right_pointer) {
        return strong_ordering::equal;
    }

#ifdef FTL_REPLACE_STL
    if (is_constant_evaluated()) {
        return left_pointer <=> right_pointer;
    }
#else
    /*
     * In normal namespace mode the language's built-in <=> category is
     * std::strong_ordering, not ftl::strong_ordering. Preserve constexpr
     * evaluation whenever the language pointer relation itself establishes
     * an order; otherwise the runtime address-order path below is used.
     */
    if (is_constant_evaluated()) {
        if (left_pointer < right_pointer) {
            return strong_ordering::less;
        }

        if (right_pointer < left_pointer) {
            return strong_ordering::greater;
        }
    }
#endif

    using uintptr_like =
        conditional_t<sizeof(void*) == sizeof(unsigned long long),
                      unsigned long long,
                      unsigned long>;

    static_assert(sizeof(uintptr_like) == sizeof(void*));

    const uintptr_like left_address =
        reinterpret_cast<uintptr_like>(left_pointer);
    const uintptr_like right_address =
        reinterpret_cast<uintptr_like>(right_pointer);

    if (left_address < right_address) {
        return strong_ordering::less;
    }

    if (left_address > right_address) {
        return strong_ordering::greater;
    }

    return strong_ordering::equal;
}

template<class T, class U>
static consteval bool compare_three_way_noexcept() {
    if constexpr (builtin_pointer_three_way<T, U>) {
        return noexcept(pointer_total_order(declval<T>(), declval<U>()));
#ifndef FTL_REPLACE_STL
    } else if constexpr (builtin_arithmetic_three_way<T, U> ||
                         builtin_enum_three_way<T, U>) {
        return true;
#endif
    } else {
        return noexcept(declval<T>() <=> declval<U>());
    }
}

template<class T>
constexpr partial_ordering
float_partial_order(T left, T right) noexcept;

} // namespace detail

struct compare_three_way {
    using is_transparent = void;

    template<class T, class U>
#ifdef FTL_REPLACE_STL
        requires three_way_comparable_with<T, U>
#else
        requires detail::normal_compare_three_way<T, U>
#endif
    constexpr auto operator()(T&& left, U&& right) const
        noexcept(detail::compare_three_way_noexcept<T, U>()) {

        if constexpr (detail::builtin_pointer_three_way<T, U>) {
            return detail::pointer_total_order(
                static_cast<T&&>(left),
                static_cast<U&&>(right));

#ifndef FTL_REPLACE_STL
        } else if constexpr (
            detail::builtin_arithmetic_three_way<T, U>) {

            if constexpr (
                is_floating_point_v<decay_t<T>> ||
                is_floating_point_v<decay_t<U>>) {

                using common_type =
                    common_type_t<decay_t<T>, decay_t<U>>;

                return detail::float_partial_order(
                    static_cast<common_type>(
                        static_cast<T&&>(left)),
                    static_cast<common_type>(
                        static_cast<U&&>(right)));
            } else {
                if (static_cast<T&&>(left) <
                    static_cast<U&&>(right)) {
                    return strong_ordering::less;
                }

                if (static_cast<T&&>(left) >
                    static_cast<U&&>(right)) {
                    return strong_ordering::greater;
                }

                return strong_ordering::equal;
            }
        } else if constexpr (
            detail::builtin_enum_three_way<T, U>) {

            if (static_cast<T&&>(left) <
                static_cast<U&&>(right)) {
                return strong_ordering::less;
            }

            if (static_cast<T&&>(left) >
                static_cast<U&&>(right)) {
                return strong_ordering::greater;
            }

            return strong_ordering::equal;
#endif
        } else {
            return static_cast<T&&>(left) <=>
                   static_cast<U&&>(right);
        }
    }
};

namespace detail {
namespace adl {
void strong_order() = delete;
void weak_order() = delete;
void partial_order() = delete;

template<class T, class U>
concept adl_strong_order = requires(T&& left, U&& right) {
    strong_ordering(
        strong_order(static_cast<T&&>(left),
                     static_cast<U&&>(right)));
};

template<class T, class U>
concept adl_weak_order = requires(T&& left, U&& right) {
    weak_ordering(
        weak_order(static_cast<T&&>(left),
                   static_cast<U&&>(right)));
};

template<class T, class U>
concept adl_partial_order = requires(T&& left, U&& right) {
    partial_ordering(
        partial_order(static_cast<T&&>(left),
                      static_cast<U&&>(right)));
};

template<class T, class U>
constexpr strong_ordering call_strong_order(T&& left, U&& right)
    noexcept(noexcept(strong_ordering(
        strong_order(static_cast<T&&>(left),
                     static_cast<U&&>(right))))) {
    return strong_ordering(
        strong_order(static_cast<T&&>(left),
                     static_cast<U&&>(right)));
}

template<class T, class U>
constexpr weak_ordering call_weak_order(T&& left, U&& right)
    noexcept(noexcept(weak_ordering(
        weak_order(static_cast<T&&>(left),
                   static_cast<U&&>(right))))) {
    return weak_ordering(
        weak_order(static_cast<T&&>(left),
                   static_cast<U&&>(right)));
}

template<class T, class U>
constexpr partial_ordering call_partial_order(T&& left, U&& right)
    noexcept(noexcept(partial_ordering(
        partial_order(static_cast<T&&>(left),
                      static_cast<U&&>(right))))) {
    return partial_ordering(
        partial_order(static_cast<T&&>(left),
                      static_cast<U&&>(right)));
}
} // namespace adl

template<class T, class U>
concept adl_strong_order = adl::adl_strong_order<T, U>;
template<class T, class U>
concept adl_weak_order = adl::adl_weak_order<T, U>;
template<class T, class U>
concept adl_partial_order = adl::adl_partial_order<T, U>;
using adl::call_strong_order;
using adl::call_weak_order;
using adl::call_partial_order;

template<class T>
struct float_order_bits;

template<>
struct float_order_bits<float> {
    using type = unsigned int;

    static_assert(sizeof(type) == sizeof(float));

    static constexpr type sign =
        type(1) << 31;

    static constexpr type exponent =
        type(0xff) << 23;

    static constexpr type fraction =
        (type(1) << 23) - 1;

    static constexpr type mask =
        ~type(0);
};

template<>
struct float_order_bits<double> {
    using type = unsigned long long;

    static_assert(sizeof(type) == sizeof(double));

    static constexpr type sign =
        type(1) << 63;

    static constexpr type exponent =
        type(0x7ff) << 52;

    static constexpr type fraction =
        (type(1) << 52) - 1;

    static constexpr type mask =
        ~type(0);
};

template<>
struct float_order_bits<long double> {
#if defined(_MSC_VER) || __SIZEOF_LONG_DOUBLE__ == 8

    using type = unsigned long long;

    static constexpr type sign =
        type(1) << 63;

    static constexpr type exponent =
        type(0x7ff) << 52;

    static constexpr type fraction =
        (type(1) << 52) - 1;

    static constexpr type mask =
        ~type(0);

#elif defined(__SIZEOF_INT128__) && \
      __SIZEOF_LONG_DOUBLE__ == 16

    using type = unsigned __int128;

    struct representation {
        unsigned char bytes[16];
    };

    static constexpr type sign =
        type(1) << 79;

    static constexpr type exponent =
        type(0x7fff) << 64;

    /*
     * x87 extended precision has an explicit integer bit
     * at bit 63. The fraction field is bits 0..62.
     */
    static constexpr type fraction =
        (type(1) << 63) - 1;

    static constexpr type mask =
        (type(1) << 80) - 1;

#else
#error "FTL requires a supported long double representation"
#endif

    static_assert(sizeof(type) == sizeof(long double));
};

template<class T>
constexpr typename float_order_bits<T>::type
float_raw_bits(T value) noexcept {
    using traits = float_order_bits<T>;
    using bits = typename traits::type;

#if !defined(_MSC_VER) && \
    defined(__SIZEOF_INT128__) && \
    __SIZEOF_LONG_DOUBLE__ == 16

    if constexpr (is_same_v<T, long double>) {
        const auto bytes =
            __builtin_bit_cast(
                typename traits::representation,
                value);

        bits result = 0;

        for (unsigned index = 0; index < 10; ++index) {
            result |=
                bits(bytes.bytes[index]) <<
                (index * 8);
        }

        return result & traits::mask;
    } else
#endif
    {
        return __builtin_bit_cast(bits, value) &
               traits::mask;
    }
}

template<class T>
constexpr bool
float_is_nan_bits(
    typename float_order_bits<T>::type value) noexcept {

    using traits = float_order_bits<T>;

    return
        (value & traits::exponent) ==
            traits::exponent &&
        (value & traits::fraction) != 0;
}

template<class T>
constexpr bool
float_is_zero_bits(
    typename float_order_bits<T>::type value) noexcept {

    using traits = float_order_bits<T>;

    return (value & ~traits::sign) == 0;
}

template<class T>
constexpr bool
float_sign_bit(
    typename float_order_bits<T>::type value) noexcept {

    return
        (value & float_order_bits<T>::sign) != 0;
}

template<class T>
constexpr strong_ordering
float_strong_order(T left, T right) noexcept {
    using traits = float_order_bits<T>;
    using bits = typename traits::type;

    const bits left_bits =
        float_raw_bits(left);

    const bits right_bits =
        float_raw_bits(right);

    const bits left_key =
        left_bits & traits::sign
            ? (~left_bits & traits::mask)
            : (left_bits | traits::sign);

    const bits right_key =
        right_bits & traits::sign
            ? (~right_bits & traits::mask)
            : (right_bits | traits::sign);

    if (left_key < right_key) {
        return strong_ordering::less;
    }

    if (left_key > right_key) {
        return strong_ordering::greater;
    }

    return strong_ordering::equal;
}

template<class T>
constexpr weak_ordering
float_weak_order(T left, T right) noexcept {
    const auto left_bits =
        float_raw_bits(left);

    const auto right_bits =
        float_raw_bits(right);

    const bool left_nan =
        float_is_nan_bits<T>(left_bits);

    const bool right_nan =
        float_is_nan_bits<T>(right_bits);

    /*
     * IEC 60559 weak ordering:
     *
     *   all negative NaNs
     *   ...
     *   -0 == +0
     *   ...
     *   all positive NaNs
     */
    if (left_nan || right_nan) {
        const bool left_negative =
            float_sign_bit<T>(left_bits);

        const bool right_negative =
            float_sign_bit<T>(right_bits);

        if (left_nan && right_nan) {
            if (left_negative == right_negative) {
                return weak_ordering::equivalent;
            }

            return left_negative
                ? weak_ordering::less
                : weak_ordering::greater;
        }

        if (left_nan) {
            return left_negative
                ? weak_ordering::less
                : weak_ordering::greater;
        }

        return right_negative
            ? weak_ordering::greater
            : weak_ordering::less;
    }

    if (float_is_zero_bits<T>(left_bits) &&
        float_is_zero_bits<T>(right_bits)) {
        return weak_ordering::equivalent;
    }

    const strong_ordering result =
        float_strong_order(left, right);

    if (result < 0) {
        return weak_ordering::less;
    }

    if (result > 0) {
        return weak_ordering::greater;
    }

    return weak_ordering::equivalent;
}

template<class T>
constexpr partial_ordering
float_partial_order(T left, T right) noexcept {
    const auto left_bits =
        float_raw_bits(left);

    const auto right_bits =
        float_raw_bits(right);

    if (float_is_nan_bits<T>(left_bits) ||
        float_is_nan_bits<T>(right_bits)) {
        return partial_ordering::unordered;
    }

    if (float_is_zero_bits<T>(left_bits) &&
        float_is_zero_bits<T>(right_bits)) {
        return partial_ordering::equivalent;
    }

    const strong_ordering result =
        float_strong_order(left, right);

    if (result < 0) {
        return partial_ordering::less;
    }

    if (result > 0) {
        return partial_ordering::greater;
    }

    return partial_ordering::equivalent;
}

struct strong_order_fn {
private:
    template<class T, class U>
    static consteval bool call_is_noexcept() {
        if constexpr (adl_strong_order<T, U>) {
            return noexcept(
                call_strong_order(declval<T>(), declval<U>()));
        } else if constexpr (
            is_floating_point_v<decay_t<T>>) {
            return true;
        } else {
            return noexcept(strong_ordering(
                compare_three_way{}(
                    declval<T>(),
                    declval<U>())));
        }
    }

public:
    template<class T, class U>
        requires same_as<decay_t<T>, decay_t<U>> &&
                 (
                     adl_strong_order<T, U> ||
                     is_floating_point_v<decay_t<T>> ||
                     requires(T&& left, U&& right) {
                         strong_ordering(
                             compare_three_way{}(
                                 static_cast<T&&>(left),
                                 static_cast<U&&>(right)));
                     }
                 )
    constexpr strong_ordering
    operator()(T&& left, U&& right) const
        noexcept(call_is_noexcept<T, U>()) {

        if constexpr (adl_strong_order<T, U>) {
            return call_strong_order(
                static_cast<T&&>(left),
                static_cast<U&&>(right));
        } else if constexpr (
            is_floating_point_v<decay_t<T>>) {
            return float_strong_order(
                static_cast<T&&>(left),
                static_cast<U&&>(right));
        } else {
            return strong_ordering(
                compare_three_way{}(
                    static_cast<T&&>(left),
                    static_cast<U&&>(right)));
        }
    }
};
}

inline constexpr detail::strong_order_fn strong_order{};

namespace detail {
struct weak_order_fn {
private:
    template<class T, class U>
    static consteval bool call_is_noexcept() {
        if constexpr (adl_weak_order<T, U>) {
            return noexcept(
                call_weak_order(declval<T>(), declval<U>()));
        } else if constexpr (
            is_floating_point_v<decay_t<T>>) {
            return true;
        } else if constexpr (requires {
            weak_ordering(
                compare_three_way{}(
                    declval<T>(),
                    declval<U>()));
        }) {
