template<class T, class U>
concept strong_fallback_comparable =
    requires(T&& left, U&& right) {
        {
            static_cast<T&&>(left) ==
            static_cast<U&&>(right)
        } -> boolean_testable;

        {
            static_cast<T&&>(left) <
            static_cast<U&&>(right)
        } -> boolean_testable;
    };

template<class T, class U>
concept partial_fallback_comparable =
    requires(T&& left, U&& right) {
        {
            static_cast<T&&>(left) ==
            static_cast<U&&>(right)
        } -> boolean_testable;

        {
            static_cast<T&&>(left) <
            static_cast<U&&>(right)
        } -> boolean_testable;

        {
            static_cast<U&&>(right) <
            static_cast<T&&>(left)
        } -> boolean_testable;
    };

struct strong_fallback_fn {
private:
    template<class T, class U>
    static consteval bool call_is_noexcept() {
        if constexpr (requires {
            strong_order(declval<T>(), declval<U>());
        }) {
            return noexcept(
                strong_order(declval<T>(), declval<U>()));
        } else {
            return noexcept(
                       declval<T>() == declval<U>()) &&
                   noexcept(
                       declval<T>() < declval<U>());
        }
    }

public:
    template<class T, class U>
        requires same_as<decay_t<T>, decay_t<U>> &&
                 (
                     requires(T&& left, U&& right) {
                         strong_order(
                             static_cast<T&&>(left),
                             static_cast<U&&>(right));
                     } ||
                     strong_fallback_comparable<T, U>
                 )
    constexpr strong_ordering
    operator()(T&& left, U&& right) const
        noexcept(call_is_noexcept<T, U>()) {

        if constexpr (requires {
            strong_order(
                static_cast<T&&>(left),
                static_cast<U&&>(right));
        }) {
            return strong_order(
                static_cast<T&&>(left),
                static_cast<U&&>(right));
        } else if (
            static_cast<T&&>(left) ==
            static_cast<U&&>(right)) {
            return strong_ordering::equal;
        } else if (
            static_cast<T&&>(left) <
            static_cast<U&&>(right)) {
            return strong_ordering::less;
        } else {
            return strong_ordering::greater;
        }
    }
};

