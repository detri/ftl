#if defined(_WIN32)
inline void* aligned_alloc(size_t alignment, size_t size) {
    return size % alignment ? nullptr : ::_aligned_malloc(size, alignment);
}
#else
using ::aligned_alloc;
#endif

constexpr int abs(int value) { return value < 0 ? -value : value; }
constexpr long abs(long value) { return value < 0 ? -value : value; }
constexpr long long abs(long long value) { return value < 0 ? -value : value; }
constexpr float abs(float value) { return value < 0 ? -value : value; }
constexpr double abs(double value) { return value < 0 ? -value : value; }
constexpr long double abs(long double value) { return value < 0 ? -value : value; }
constexpr long labs(long value) { return abs(value); }
constexpr long long llabs(long long value) { return abs(value); }
constexpr div_t div(int numer, int denom) { return {numer / denom, numer % denom}; }
constexpr ldiv_t div(long numer, long denom) { return {numer / denom, numer % denom}; }
constexpr lldiv_t div(long long numer, long long denom) { return {numer / denom, numer % denom}; }
constexpr ldiv_t ldiv(long numer, long denom) { return div(numer, denom); }
constexpr lldiv_t lldiv(long long numer, long long denom) { return div(numer, denom); }

