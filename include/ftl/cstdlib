inline void* calloc(size_t count, size_t size) {
    if (size && count > size_t(-1) / size) return nullptr;
    auto* result = static_cast<unsigned char*>(malloc(count * size));
    if (result) for (size_t i = 0; i < count * size; ++i) result[i] = 0;
    return result;
}
