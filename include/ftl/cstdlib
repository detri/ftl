using size_t = decltype(sizeof(0));
struct div_t { int quot, rem; };
struct ldiv_t { long quot, rem; };
struct lldiv_t { long long quot, rem; };

using ::abort;
#if defined(_MSC_VER)
inline int atexit(void (*function)()) noexcept { return ::atexit(function); }
inline int at_quick_exit(void (*function)()) noexcept {
    return ::at_quick_exit(function);
}
#else
using ::atexit;
using ::at_quick_exit;
#endif
using ::exit;
using ::_Exit;
using ::quick_exit;
using ::getenv;
using ::system;
#if defined(_WIN32)
inline void* malloc(size_t size) { return ::_aligned_malloc(size, alignof(max_align_t)); }
inline void free(void* pointer) { ::_aligned_free(pointer); }
inline void* realloc(void* pointer, size_t size) {
    return ::_aligned_realloc(pointer, size, alignof(max_align_t));
}
inline void* calloc(size_t count, size_t size) {
    if (size && count > size_t(-1) / size) return nullptr;
    auto* result = static_cast<unsigned char*>(malloc(count * size));
    if (result) for (size_t i = 0; i < count * size; ++i) result[i] = 0;
    return result;
}
#else
using ::calloc;
using ::free;
using ::malloc;
using ::realloc;
#endif
