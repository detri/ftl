namespace ftl_print_runtime {

using size_type = decltype(sizeof(0));

extern "C" {

size_type fwrite(const void *, size_type, size_type, FILE *);

int fflush(FILE *);

#if defined(_WIN32)

FILE *__cdecl __acrt_iob_func(unsigned);

int __cdecl _fileno(FILE *);
int __cdecl _isatty(int);

#if defined(_WIN64)
using native_intptr = long long;
#else
using native_intptr = int;
#endif

native_intptr __cdecl _get_osfhandle(int);

__declspec(dllimport) int __stdcall GetConsoleMode(void *, unsigned long *);

__declspec(dllimport) int __stdcall
WriteConsoleW(void *, const void *, unsigned long, unsigned long *, void *);

#elif defined(__APPLE__)

extern FILE *__stdoutp;

#else

extern FILE *stdout;

#endif

} // extern "C"

[[nodiscard]]
inline FILE *stdout_stream() noexcept {
#if defined(_WIN32)
  return __acrt_iob_func(1);
#elif defined(__APPLE__)
  return __stdoutp;
#else
  return stdout;
#endif
}

#if defined(_WIN32)

[[nodiscard]]
inline void *console_handle(FILE *stream) noexcept {
  const int descriptor = _fileno(stream);

  if (descriptor < 0)
    return nullptr;

  /*
   * Do not poke arbitrary file handles
   * with the Win32 console API.
   *
   * In particular this keeps tmpfile(),
   * redirected output, pipes, and ordinary
   * files entirely on the byte-oriented
   * fwrite path.
   */
  if (_isatty(descriptor) == 0)
    return nullptr;

  const native_intptr handle = _get_osfhandle(descriptor);

  if (handle == static_cast<native_intptr>(-1)) {
    return nullptr;
  }

  unsigned long mode = 0;

  void *native = reinterpret_cast<void *>(handle);

  if (GetConsoleMode(native, &mode) == 0) {
    return nullptr;
  }

  return native;
}

#endif

} // namespace ftl_print_runtime

FTL_BEGIN_NAMESPACE

namespace detail {

inline constexpr bool print_literal_encoding_is_utf8 = [] {
  constexpr char micro[] = "\u00b5";

  return sizeof(micro) == 3 && static_cast<unsigned char>(micro[0]) == 0xc2u &&
         static_cast<unsigned char>(micro[1]) == 0xb5u;
}();

[[noreturn]]
inline void print_io_error(bool use_errno = true) {
#if FTL_HAS_EXCEPTIONS
  int code = use_errno ? errno : 0;

  if (code == 0) {
    code = static_cast<int>(errc::io_error);
  }

  throw system_error(code, generic_category(), "print");
#else
  (void)use_errno;
  FTL_PRINT_TRAP();
#endif
}

inline void print_write_raw(FILE *stream, string_view text) {
  if (text.empty())
    return;

  const size_t written =
      ftl_print_runtime::fwrite(text.data(), 1, text.size(), stream);

  if (written != text.size()) {
    print_io_error();
  }
}

#if defined(_WIN32)

inline basic_string<wchar_t> print_utf8_to_utf16(string_view text) {
  basic_string<wchar_t> result;

  result.reserve(text.size());

  auto current = text.begin();

  const auto end = text.end();

  while (current != end) {
    const auto decoded = ::ftl_unicode_format::decode<char>(current, end);

    if (!decoded.valid) {
      /*
       * N4950 makes invalid Unicode
       * undefined for the native-console
       * path, but recommends U+FFFD
       * substitution. Do that.
       */
      result.push_back(static_cast<wchar_t>(0xfffdu));

      ++current;
      continue;
    }

    const unsigned long scalar = decoded.scalar;

    if (scalar <= 0xffffu) {
      result.push_back(static_cast<wchar_t>(scalar));
    } else {
      const unsigned long value = scalar - 0x10000u;

      result.push_back(static_cast<wchar_t>(0xd800u + (value >> 10)));

      result.push_back(static_cast<wchar_t>(0xdc00u + (value & 0x3ffu)));
    }

    for (size_t index = 0; index < decoded.units; ++index) {
      ++current;
    }
  }

  return result;
}

inline void print_write_windows_console(FILE *stream, void *handle,
                                        string_view text) {
  if (ftl_print_runtime::fflush(stream) != 0) {
    print_io_error();
  }

  const auto wide = print_utf8_to_utf16(text);

  size_t offset = 0;

  while (offset < wide.size()) {
    const size_t remaining = wide.size() - offset;

    constexpr unsigned long maximum_chunk = 0x7ffffffful;

    const unsigned long count = remaining > static_cast<size_t>(maximum_chunk)
                                    ? maximum_chunk
                                    : static_cast<unsigned long>(remaining);

    unsigned long written = 0;

    if (ftl_print_runtime::WriteConsoleW(handle, wide.data() + offset, count,
                                         &written, nullptr) == 0 ||
        written != count) {
      print_io_error(false);
    }

    offset += static_cast<size_t>(written);
  }
}

#endif

inline void print_write_unicode(FILE *stream, string_view text) {
#if defined(_WIN32)
  if (void *handle = ftl_print_runtime::console_handle(stream)) {
    print_write_windows_console(stream, handle, text);

    return;
  }
#endif

  /*
   * Redirected output and POSIX terminals
   * receive the formatted byte sequence
   * unchanged.
   */
  print_write_raw(stream, text);
}

inline void print_write_selected(FILE *stream, string_view text) {
  if constexpr (print_literal_encoding_is_utf8) {
    print_write_unicode(stream, text);
  } else {
    print_write_raw(stream, text);
  }
}

} // namespace detail

inline void vprint_unicode(FILE *stream, string_view fmt, format_args args) {
  const string output = vformat(fmt, args);

  detail::print_write_unicode(stream,
                              string_view(output.data(), output.size()));
}

inline void vprint_unicode(string_view fmt, format_args args) {
  vprint_unicode(ftl_print_runtime::stdout_stream(), fmt, args);
}

inline void vprint_nonunicode(FILE *stream, string_view fmt, format_args args) {
  const string output = vformat(fmt, args);

  detail::print_write_raw(stream, string_view(output.data(), output.size()));
}

inline void vprint_nonunicode(string_view fmt, format_args args) {
  vprint_nonunicode(ftl_print_runtime::stdout_stream(), fmt, args);
}

template <class... Args>
void print(FILE *stream, format_string<Args...> fmt, Args &&...arguments) {
  const string output = format(fmt, forward<Args>(arguments)...);

  detail::print_write_selected(stream,
                               string_view(output.data(), output.size()));
}

template <class... Args>
void print(format_string<Args...> fmt, Args &&...arguments) {
  print(ftl_print_runtime::stdout_stream(), fmt, forward<Args>(arguments)...);
}

template <class... Args>
void println(FILE *stream, format_string<Args...> fmt, Args &&...arguments) {
  string output = format(fmt, forward<Args>(arguments)...);

  output.push_back('\n');

  detail::print_write_selected(stream,
                               string_view(output.data(), output.size()));
}

template <class... Args>
void println(format_string<Args...> fmt, Args &&...arguments) {
  println(ftl_print_runtime::stdout_stream(), fmt, forward<Args>(arguments)...);
}

