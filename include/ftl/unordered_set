template <class Key, class Hash, class Predicate, class Allocator>
class unordered_set;
template <class Key, class Hash, class Predicate, class Allocator>
class unordered_multiset;
template <class Key, class Hash = hash<Key>, class Predicate = equal_to<Key>,
          class Allocator = allocator<Key>>
class unordered_set : public detail::unordered_set_base<Key, Hash, Predicate,
                                                        Allocator, false> {
  using base =
      detail::unordered_set_base<Key, Hash, Predicate, Allocator, false>;

public:
  using base::base;
  using base::merge;
  using base::operator=;
  unordered_set &operator=(initializer_list<Key> values) { base::operator=(values); return *this; }
  template <class H, class P>
  void merge(unordered_set<Key, H, P, Allocator> &source) {
    using source_base = detail::unordered_set_base<Key, H, P, Allocator, false>;
    this->template merge_from<H, P, false>(static_cast<source_base &>(source));
  }
  template <class H, class P>
  void merge(unordered_multiset<Key, H, P, Allocator> &source) {
    using source_base = detail::unordered_set_base<Key, H, P, Allocator, true>;
    this->template merge_from<H, P, true>(static_cast<source_base &>(source));
  }
  template <class Source> void merge(Source &&source) requires(!is_lvalue_reference_v<Source>) { merge(source); }
};
template <class Key, class Hash = hash<Key>, class Predicate = equal_to<Key>,
          class Allocator = allocator<Key>>
class unordered_multiset
    : public detail::unordered_set_base<Key, Hash, Predicate, Allocator, true> {
  using base =
      detail::unordered_set_base<Key, Hash, Predicate, Allocator, true>;

public:
  using base::base;
  using base::merge;
  using base::operator=;
  unordered_multiset &operator=(initializer_list<Key> values) { base::operator=(values); return *this; }
  template <class H, class P>
  void merge(unordered_set<Key, H, P, Allocator> &source) {
    using source_base = detail::unordered_set_base<Key, H, P, Allocator, false>;
    this->template merge_from<H, P, false>(static_cast<source_base &>(source));
  }
  template <class H, class P>
  void merge(unordered_multiset<Key, H, P, Allocator> &source) {
    using source_base = detail::unordered_set_base<Key, H, P, Allocator, true>;
    this->template merge_from<H, P, true>(static_cast<source_base &>(source));
  }
  template <class Source> void merge(Source &&source) requires(!is_lvalue_reference_v<Source>) { merge(source); }
};

