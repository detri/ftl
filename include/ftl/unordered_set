template <class Container>
bool unordered_set_equal(const Container &left, const Container &right) {
  if (left.size() != right.size())
    return false;
  for (auto first = left.begin(); first != left.end();) {
    auto left_group = left.equal_range(*first);
    auto right_group = right.equal_range(*first);
    if (!is_permutation(left_group.first, left_group.second,
                        right_group.first, right_group.second))
      return false;
    first = left_group.second;
  }
  return true;
}
template <class Key, class Hash, class Predicate, class Allocator>
bool operator==(const unordered_set<Key, Hash, Predicate, Allocator> &left,
                const unordered_set<Key, Hash, Predicate, Allocator> &right) {
  return unordered_set_equal(left, right);
}
template <class Key, class Hash, class Predicate, class Allocator>
bool operator==(
    const unordered_multiset<Key, Hash, Predicate, Allocator> &left,
    const unordered_multiset<Key, Hash, Predicate, Allocator> &right) {
  return unordered_set_equal(left, right);
}
template <class Key, class Hash, class Predicate, class Allocator>
void swap(unordered_set<Key, Hash, Predicate, Allocator> &left,
          unordered_set<Key, Hash, Predicate, Allocator>
              &right) noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}
template <class Key, class Hash, class Predicate, class Allocator>
void swap(unordered_multiset<Key, Hash, Predicate, Allocator> &left,
          unordered_multiset<Key, Hash, Predicate, Allocator>
              &right) noexcept(noexcept(left.swap(right))) {
  left.swap(right);
}
template <class Container, class Predicate>
typename Container::size_type unordered_set_erase_if(Container &values,
                                                     Predicate predicate) {
  typename Container::size_type count{};
  for (auto current = values.begin(); current != values.end();)
    if (predicate(*current)) {
      current = values.erase(current);
      ++count;
    } else
      ++current;
  return count;
}
template <class Key, class Hash, class Equal, class Allocator, class Predicate>
typename unordered_set<Key, Hash, Equal, Allocator>::size_type
erase_if(unordered_set<Key, Hash, Equal, Allocator> &values,
         Predicate predicate) {
  return unordered_set_erase_if(values, move(predicate));
}
template <class Key, class Hash, class Equal, class Allocator, class Predicate>
typename unordered_multiset<Key, Hash, Equal, Allocator>::size_type
erase_if(unordered_multiset<Key, Hash, Equal, Allocator> &values,
         Predicate predicate) {
  return unordered_set_erase_if(values, move(predicate));
}
