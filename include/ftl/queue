namespace detail {
template<class A> concept adaptor_allocator =
  requires { typename A::value_type; } && copy_constructible<A> &&
  equality_comparable<A> &&
  requires(A& a, typename allocator_traits<A>::size_type n,
           typename allocator_traits<A>::pointer p) {
    { a.allocate(n) } -> same_as<typename allocator_traits<A>::pointer>;
    a.deallocate(p, n);
  };
}

template<class T, class charT> struct formatter;

template<class T, class Container = deque<T>> class queue {
  static_assert(is_same_v<T, typename Container::value_type>);
public:
  using value_type = typename Container::value_type;
  using reference = typename Container::reference;
  using const_reference = typename Container::const_reference;
  using size_type = typename Container::size_type;
  using container_type = Container;
protected:
  Container c;
public:
  queue() : queue(Container()) {}
  explicit queue(const Container& cont) : c(cont) {}
  explicit queue(Container&& cont) : c(move(cont)) {}
  template<input_iterator I> queue(I first, I last) : c(first, last) {}
  template<detail::deque_compatible_range<T> R> queue(from_range_t, R&& range) : c(from_range, static_cast<R&&>(range)) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> explicit queue(const Alloc& a) : c(a) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> queue(const Container& cont, const Alloc& a) : c(cont, a) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> queue(Container&& cont, const Alloc& a) : c(move(cont), a) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> queue(const queue& other, const Alloc& a) : c(other.c, a) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> queue(queue&& other, const Alloc& a) : c(move(other.c), a) {}
  template<input_iterator I, class Alloc> requires uses_allocator_v<Container, Alloc> queue(I first, I last, const Alloc& a) : c(first, last, a) {}
  template<detail::deque_compatible_range<T> R, class Alloc> requires uses_allocator_v<Container, Alloc>
  queue(from_range_t, R&& range, const Alloc& a) : c(from_range, static_cast<R&&>(range), a) {}
  [[nodiscard]] bool empty() const { return c.empty(); }
  size_type size() const { return c.size(); }
  reference front() { return c.front(); }
  const_reference front() const { return c.front(); }
  reference back() { return c.back(); }
  const_reference back() const { return c.back(); }
  void push(const value_type& value) { c.push_back(value); }
  void push(value_type&& value) { c.push_back(move(value)); }
  template<detail::deque_compatible_range<T> R> void push_range(R&& range) {
    if constexpr (requires { c.append_range(static_cast<R&&>(range)); }) c.append_range(static_cast<R&&>(range));
    else for (auto&& value : range) c.push_back(static_cast<decltype(value)&&>(value));
  }
  template<class... Args> decltype(auto) emplace(Args&&... args) { return c.emplace_back(forward<Args>(args)...); }
  void pop() { c.pop_front(); }
  void swap(queue& other) noexcept(is_nothrow_swappable_v<Container>) { using FTL_ADAPTOR_NAMESPACE::swap; swap(c, other.c); }
  template<class U, class C> friend bool operator==(const queue<U, C>&, const queue<U, C>&);
  template<class U, class C> friend bool operator!=(const queue<U, C>&, const queue<U, C>&);
  template<class U, class C> friend bool operator<(const queue<U, C>&, const queue<U, C>&);
  template<class U, class C> friend bool operator>(const queue<U, C>&, const queue<U, C>&);
  template<class U, class C> friend bool operator<=(const queue<U, C>&, const queue<U, C>&);
  template<class U, class C> friend bool operator>=(const queue<U, C>&, const queue<U, C>&);
  template<class U, three_way_comparable C> friend compare_three_way_result_t<C> operator<=>(const queue<U, C>&, const queue<U, C>&);
  template<class, class> friend struct formatter;
};
template<class C> requires (!detail::adaptor_allocator<C>) queue(C) -> queue<typename C::value_type, C>;
template<input_iterator I> queue(I, I) -> queue<typename iterator_traits<I>::value_type>;
template<ranges::input_range R> queue(from_range_t, R&&) -> queue<ranges::range_value_t<R>>;
template<class C, detail::adaptor_allocator A> requires (!detail::adaptor_allocator<C> && uses_allocator_v<C, A>) queue(C, A) -> queue<typename C::value_type, C>;
template<input_iterator I, detail::adaptor_allocator A> queue(I, I, A) -> queue<typename iterator_traits<I>::value_type, deque<typename iterator_traits<I>::value_type, A>>;
template<ranges::input_range R, detail::adaptor_allocator A> queue(from_range_t, R&&, A) -> queue<ranges::range_value_t<R>, deque<ranges::range_value_t<R>, A>>;
template<class T, class C, class A> struct uses_allocator<queue<T, C>, A> : uses_allocator<C, A>::type {};
template<class T, class C> bool operator==(const queue<T, C>& x, const queue<T, C>& y) { return x.c == y.c; }
template<class T, class C> bool operator!=(const queue<T, C>& x, const queue<T, C>& y) { return x.c != y.c; }
template<class T, class C> bool operator<(const queue<T, C>& x, const queue<T, C>& y) { return x.c < y.c; }
template<class T, class C> bool operator>(const queue<T, C>& x, const queue<T, C>& y) { return x.c > y.c; }
template<class T, class C> bool operator<=(const queue<T, C>& x, const queue<T, C>& y) { return x.c <= y.c; }
template<class T, class C> bool operator>=(const queue<T, C>& x, const queue<T, C>& y) { return x.c >= y.c; }
template<class T, three_way_comparable C> compare_three_way_result_t<C> operator<=>(const queue<T, C>& x, const queue<T, C>& y) { return x.c <=> y.c; }
template<class T, class C> void swap(queue<T, C>& x, queue<T, C>& y) noexcept(noexcept(x.swap(y))) { x.swap(y); }

template<class T, class Container = vector<T>, class Compare = less<typename Container::value_type>>
class priority_queue {
  static_assert(is_same_v<T, typename Container::value_type>);
public:
  using value_type = typename Container::value_type;
  using reference = typename Container::reference;
  using const_reference = typename Container::const_reference;
  using size_type = typename Container::size_type;
  using container_type = Container;
  using value_compare = Compare;
protected:
  Container c;
  Compare comp;
public:
  template<class, class> friend struct formatter;
  priority_queue() : priority_queue(Compare()) {}
  explicit priority_queue(const Compare& compare) : priority_queue(compare, Container()) {}
  priority_queue(const Compare& compare, const Container& cont) : c(cont), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  priority_queue(const Compare& compare, Container&& cont) : c(move(cont)), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I> priority_queue(I first, I last, const Compare& compare = Compare()) : c(first, last), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I> priority_queue(I first, I last, const Compare& compare, const Container& cont) : c(cont), comp(compare) { c.insert(c.end(), first, last); make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I> priority_queue(I first, I last, const Compare& compare, Container&& cont) : c(move(cont)), comp(compare) { c.insert(c.end(), first, last); make_heap(c.begin(), c.end(), comp); }
  template<detail::deque_compatible_range<T> R> priority_queue(from_range_t, R&& range, const Compare& compare = Compare()) : c(from_range, static_cast<R&&>(range)), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<class Alloc> requires uses_allocator_v<Container, Alloc> explicit priority_queue(const Alloc& a) : c(a), comp() {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(const Compare& compare, const Alloc& a) : c(a), comp(compare) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(const Compare& compare, const Container& cont, const Alloc& a) : c(cont, a), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(const Compare& compare, Container&& cont, const Alloc& a) : c(move(cont), a), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(const priority_queue& other, const Alloc& a) : c(other.c, a), comp(other.comp) {}
  template<class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(priority_queue&& other, const Alloc& a) : c(move(other.c), a), comp(move(other.comp)) {}
  template<input_iterator I, class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(I first, I last, const Alloc& a) : c(first, last, a), comp() { make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I, class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(I first, I last, const Compare& compare, const Alloc& a) : c(first, last, a), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I, class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(I first, I last, const Compare& compare, const Container& cont, const Alloc& a) : c(cont, a), comp(compare) { c.insert(c.end(), first, last); make_heap(c.begin(), c.end(), comp); }
  template<input_iterator I, class Alloc> requires uses_allocator_v<Container, Alloc> priority_queue(I first, I last, const Compare& compare, Container&& cont, const Alloc& a) : c(move(cont), a), comp(compare) { c.insert(c.end(), first, last); make_heap(c.begin(), c.end(), comp); }
  template<detail::deque_compatible_range<T> R, class Alloc> requires uses_allocator_v<Container, Alloc>
  priority_queue(from_range_t, R&& range, const Compare& compare, const Alloc& a) : c(from_range, static_cast<R&&>(range), a), comp(compare) { make_heap(c.begin(), c.end(), comp); }
  template<detail::deque_compatible_range<T> R, class Alloc> requires uses_allocator_v<Container, Alloc>
  priority_queue(from_range_t, R&& range, const Alloc& a) : c(from_range, static_cast<R&&>(range), a), comp() { make_heap(c.begin(), c.end(), comp); }
  [[nodiscard]] bool empty() const { return c.empty(); }
  size_type size() const { return c.size(); }
  const_reference top() const { return c.front(); }
  void push(const value_type& value) { c.push_back(value); push_heap(c.begin(), c.end(), comp); }
  void push(value_type&& value) { c.push_back(move(value)); push_heap(c.begin(), c.end(), comp); }
  template<detail::deque_compatible_range<T> R> void push_range(R&& range) {
    if constexpr (requires { c.append_range(static_cast<R&&>(range)); }) c.append_range(static_cast<R&&>(range));
    else for (auto&& value : range) c.push_back(static_cast<decltype(value)&&>(value));
    make_heap(c.begin(), c.end(), comp);
  }
  template<class... Args> void emplace(Args&&... args) { c.emplace_back(forward<Args>(args)...); push_heap(c.begin(), c.end(), comp); }
  void pop() { pop_heap(c.begin(), c.end(), comp); c.pop_back(); }
  void swap(priority_queue& other) noexcept(is_nothrow_swappable_v<Container> && is_nothrow_swappable_v<Compare>) { using FTL_ADAPTOR_NAMESPACE::swap; swap(c, other.c); swap(comp, other.comp); }
};
template<class Compare, class C> requires (!detail::adaptor_allocator<Compare> && !detail::adaptor_allocator<C>) priority_queue(Compare, C) -> priority_queue<typename C::value_type, C, Compare>;
template<input_iterator I, class Compare = less<typename iterator_traits<I>::value_type>> requires (!detail::adaptor_allocator<Compare>) priority_queue(I, I, Compare = Compare()) -> priority_queue<typename iterator_traits<I>::value_type, vector<typename iterator_traits<I>::value_type>, Compare>;
template<input_iterator I, class Compare, class C> requires (!detail::adaptor_allocator<Compare> && !detail::adaptor_allocator<C>) priority_queue(I, I, Compare, C) -> priority_queue<typename C::value_type, C, Compare>;
template<ranges::input_range R, class Compare = less<ranges::range_value_t<R>>> requires (!detail::adaptor_allocator<Compare>) priority_queue(from_range_t, R&&, Compare = Compare()) -> priority_queue<ranges::range_value_t<R>, vector<ranges::range_value_t<R>>, Compare>;
template<class Compare, class C, detail::adaptor_allocator A> requires (!detail::adaptor_allocator<Compare> && !detail::adaptor_allocator<C> && uses_allocator_v<C, A>) priority_queue(Compare, C, A) -> priority_queue<typename C::value_type, C, Compare>;
template<input_iterator I, detail::adaptor_allocator A> priority_queue(I, I, A) -> priority_queue<typename iterator_traits<I>::value_type, vector<typename iterator_traits<I>::value_type, A>>;
template<input_iterator I, class Compare, detail::adaptor_allocator A> requires (!detail::adaptor_allocator<Compare>) priority_queue(I, I, Compare, A) -> priority_queue<typename iterator_traits<I>::value_type, vector<typename iterator_traits<I>::value_type, A>, Compare>;
template<input_iterator I, class Compare, class C, detail::adaptor_allocator A> requires (!detail::adaptor_allocator<Compare> && !detail::adaptor_allocator<C> && uses_allocator_v<C, A>) priority_queue(I, I, Compare, C, A) -> priority_queue<typename C::value_type, C, Compare>;
template<ranges::input_range R, detail::adaptor_allocator A> priority_queue(from_range_t, R&&, A) -> priority_queue<ranges::range_value_t<R>, vector<ranges::range_value_t<R>, A>>;
template<ranges::input_range R, class Compare, detail::adaptor_allocator A> requires (!detail::adaptor_allocator<Compare>) priority_queue(from_range_t, R&&, Compare, A) -> priority_queue<ranges::range_value_t<R>, vector<ranges::range_value_t<R>, A>, Compare>;
template<class T, class C, class Compare, class A> struct uses_allocator<priority_queue<T, C, Compare>, A> : uses_allocator<C, A>::type {};
template<class T, class C, class Compare> void swap(priority_queue<T, C, Compare>& x, priority_queue<T, C, Compare>& y) noexcept(noexcept(x.swap(y))) { x.swap(y); }

