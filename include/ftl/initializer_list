#ifndef FTL_INITIALIZER_LIST_HEADER
#define FTL_INITIALIZER_LIST_HEADER

#if !defined(_INITIALIZER_LIST_) && \
    !defined(_LIBCPP_INITIALIZER_LIST) && \
    !defined(_GLIBCXX_INITIALIZER_LIST)
#if defined(_MSC_VER)
#define _INITIALIZER_LIST_
#elif defined(__APPLE__)
#define _LIBCPP_INITIALIZER_LIST
#else
#define _GLIBCXX_INITIALIZER_LIST
#endif
namespace std {

template<class T>
class initializer_list {
public:
    using value_type      = T;
    using reference       = const T&;
    using const_reference = const T&;
    using size_type       = decltype(sizeof(0));
    using iterator        = const T*;
    using const_iterator  = const T*;

    constexpr initializer_list() noexcept = default;
#if defined(_MSC_VER) && !defined(__clang__)
    constexpr size_type size() const noexcept {
        return static_cast<size_type>(last - first);
    }
#else
    constexpr size_type size() const noexcept { return count; }
#endif
    constexpr const T* begin() const noexcept { return first; }
    constexpr const T* end() const noexcept {
#if defined(_MSC_VER) && !defined(__clang__)
        return last;
#else
        return count ? first + count : first;
#endif
    }

private:
#if defined(_MSC_VER) && !defined(__clang__)
public:
    constexpr initializer_list(const T* begin, const T* end) noexcept
        : first{begin}, last{end} {}
private:
#else
    constexpr initializer_list(const T* input, size_type length) noexcept
        : first{input}, count{length} {}
#endif

    const T* first{};
#if defined(_MSC_VER) && !defined(__clang__)
    const T* last{};
#else
    size_type count{};
#endif
};

template<class T>
constexpr const T* begin(initializer_list<T> values) noexcept {
    return values.begin();
}

template<class T>
constexpr const T* end(initializer_list<T> values) noexcept {
    return values.end();
}

} // namespace std
#endif

#ifndef FTL_REPLACE_STL
namespace ftl {
using std::initializer_list;
template<class T>
constexpr const T* begin(initializer_list<T> values) noexcept {
    return values.begin();
}
template<class T>
constexpr const T* end(initializer_list<T> values) noexcept {
    return values.end();
}
} // namespace ftl
#endif

#endif // FTL_INITIALIZER_LIST_HEADER
