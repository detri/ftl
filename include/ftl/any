#ifndef FTL_ANY_HEADER
#define FTL_ANY_HEADER

#define __cpp_lib_any 201606L

#ifdef FTL_REPLACE_STL
#include <initializer_list>
#include <memory>
#include <type_traits>
#include <typeinfo>
#include <utility>
#else
#include <ftl/initializer_list>
#include <ftl/memory>
#include <ftl/type_traits>
#include <ftl/typeinfo>
#include <ftl/utility>
#endif

FTL_BEGIN_NAMESPACE

class bad_any_cast : public bad_cast {
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad any cast";
    }
};

namespace detail {
template<class T> inline unsigned char any_type_token;

[[noreturn]] inline void throw_bad_any_cast() {
#if FTL_HAS_EXCEPTIONS
    throw bad_any_cast{};
#else
    terminate();
#endif
}
}

class any {
    struct base {
        virtual ~base() = default;
        [[nodiscard]] virtual base* clone() const = 0;
#if defined(_CPPRTTI) || defined(__GXX_RTTI)
        [[nodiscard]] virtual const type_info& type() const noexcept = 0;
#endif
        [[nodiscard]] virtual const void* token() const noexcept = 0;
    };

    template<class T>
    struct holder final : base {
        template<class... Args>
        explicit holder(Args&&... args) : value(forward<Args>(args)...) {}

        [[nodiscard]] base* clone() const override {
            return new holder(value);
        }
#if defined(_CPPRTTI) || defined(__GXX_RTTI)
        [[nodiscard]] const type_info& type() const noexcept override {
            return typeid(T);
        }
#endif
        [[nodiscard]] const void* token() const noexcept override {
            return &detail::any_type_token<T>;
        }

        T value;
    };

    template<class T>
    static constexpr bool valid_value =
        is_copy_constructible_v<decay_t<T>>;

public:
    constexpr any() noexcept = default;

    any(const any& other)
        : content(other.content ? other.content->clone() : nullptr) {}
    any(any&& other) noexcept : content(exchange(other.content, nullptr)) {}

    template<class T>
    any(T&& value)
        requires (!is_same_v<decay_t<T>, any> && valid_value<T>)
        : content(new holder<decay_t<T>>(forward<T>(value))) {}

    template<class T, class... Args>
    explicit any(in_place_type_t<T>, Args&&... args)
        requires (is_copy_constructible_v<decay_t<T>> &&
                  is_constructible_v<decay_t<T>, Args...>)
        : content(new holder<decay_t<T>>(forward<Args>(args)...)) {}

    template<class T, class U, class... Args>
    explicit any(in_place_type_t<T>, initializer_list<U> values,
                 Args&&... args)
        requires (is_copy_constructible_v<decay_t<T>> &&
                  is_constructible_v<decay_t<T>, initializer_list<U>&, Args...>)
        : content(new holder<decay_t<T>>(values, forward<Args>(args)...)) {}

    ~any() { delete content; }

    any& operator=(const any& other) {
        any(other).swap(*this);
        return *this;
    }
    any& operator=(any&& other) noexcept {
        any(move(other)).swap(*this);
        return *this;
    }
    template<class T>
    any& operator=(T&& value)
        requires (!is_same_v<decay_t<T>, any> && valid_value<T>) {
        any(forward<T>(value)).swap(*this);
        return *this;
    }

    template<class T, class... Args>
    decay_t<T>& emplace(Args&&... args)
        requires (is_copy_constructible_v<decay_t<T>> &&
                  is_constructible_v<decay_t<T>, Args...>) {
        using U = decay_t<T>;
        any replacement(in_place_type<U>, forward<Args>(args)...);
        swap(replacement);
        return static_cast<holder<U>*>(content)->value;
    }

    template<class T, class U, class... Args>
    decay_t<T>& emplace(initializer_list<U> values, Args&&... args)
        requires (is_copy_constructible_v<decay_t<T>> &&
                  is_constructible_v<decay_t<T>, initializer_list<U>&,
                                     Args...>) {
        using V = decay_t<T>;
        any replacement(in_place_type<V>, values, forward<Args>(args)...);
        swap(replacement);
        return static_cast<holder<V>*>(content)->value;
    }

    void reset() noexcept {
        delete exchange(content, nullptr);
    }
    void swap(any& other) noexcept {
        base* temporary = content;
        content = other.content;
        other.content = temporary;
    }
    [[nodiscard]] bool has_value() const noexcept { return content; }
#if defined(_CPPRTTI) || defined(__GXX_RTTI)
    [[nodiscard]] const type_info& type() const noexcept {
        return content ? content->type() : typeid(void);
    }
#endif

private:
    template<class T> friend T* any_cast(any*) noexcept;
    template<class T> friend const T* any_cast(const any*) noexcept;

    base* content{};
};

inline void swap(any& left, any& right) noexcept { left.swap(right); }

template<class T, class... Args>
any make_any(Args&&... args) {
    return any(in_place_type<T>, forward<Args>(args)...);
}

template<class T, class U, class... Args>
any make_any(initializer_list<U> values, Args&&... args) {
    return any(in_place_type<T>, values, forward<Args>(args)...);
}

template<class T>
const T* any_cast(const any* operand) noexcept {
    static_assert(is_object_v<T>);
    using U = remove_cv_t<T>;
    if (!operand || !operand->content)
        return nullptr;
#if defined(_CPPRTTI) || defined(__GXX_RTTI)
    if (operand->type() != typeid(U)) return nullptr;
#else
    if (operand->content->token() != &detail::any_type_token<U>) return nullptr;
#endif
    return &static_cast<const any::holder<U>*>(operand->content)->value;
}

template<class T>
T* any_cast(any* operand) noexcept {
    static_assert(is_object_v<T>);
    return const_cast<T*>(any_cast<T>(static_cast<const any*>(operand)));
}

template<class T>
T any_cast(const any& operand) {
    using U = remove_cvref_t<T>;
    static_assert(is_constructible_v<T, const U&>);
    if (auto value = any_cast<U>(&operand))
        return static_cast<T>(*value);
    detail::throw_bad_any_cast();
}

template<class T>
T any_cast(any& operand) {
    using U = remove_cvref_t<T>;
    static_assert(is_constructible_v<T, U&>);
    if (auto value = any_cast<U>(&operand))
        return static_cast<T>(*value);
    detail::throw_bad_any_cast();
}

template<class T>
T any_cast(any&& operand) {
    using U = remove_cvref_t<T>;
    static_assert(is_constructible_v<T, U>);
    if (auto value = any_cast<U>(&operand))
        return static_cast<T>(move(*value));
    detail::throw_bad_any_cast();
}

FTL_END_NAMESPACE

#endif // FTL_ANY_HEADER
