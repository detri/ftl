namespace ranges {
struct advance_fn {
  template <input_or_output_iterator Iterator>
  constexpr void operator()(Iterator &iterator,
                            iter_difference_t<Iterator> distance) const {
    if constexpr (random_access_iterator<Iterator>) {
      iterator += distance;
    } else if constexpr (bidirectional_iterator<Iterator>) {
      if (distance >= 0) {
        while (distance-- > 0)
          ++iterator;
      } else {
        while (distance++ < 0)
          --iterator;
      }
    } else {
      while (distance-- > 0)
        ++iterator;
    }
  }

  template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
  constexpr void operator()(Iterator &iterator, Sentinel bound) const {
    if constexpr (assignable_from<Iterator &, Sentinel>) {
      iterator = FTL_ITER_NS::move(bound);
    } else if constexpr (sized_sentinel_for<Sentinel, Iterator>) {
      (*this)(iterator, bound - iterator);
    } else {
      while (iterator != bound)
        ++iterator;
    }
  }

  template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
  constexpr iter_difference_t<Iterator>
  operator()(Iterator &iterator, iter_difference_t<Iterator> distance,
             Sentinel bound) const {
    if constexpr (sized_sentinel_for<Sentinel, Iterator>) {
      const auto available = bound - iterator;

      if ((distance > 0 && distance >= available) ||
          (distance < 0 && distance <= available)) {
        (*this)(iterator, bound);
        return distance - available;
      }
    }

    if (distance >= 0) {
      while (distance != 0 && iterator != bound) {
        ++iterator;
        --distance;
      }
    } else if constexpr (bidirectional_iterator<Iterator>) {
      while (distance != 0 && iterator != bound) {
        --iterator;
        ++distance;
      }
    }

    return distance;
  }
};

inline constexpr advance_fn advance{};

struct distance_fn {
  template <class Iterator, sentinel_for<Iterator> Sentinel>
  constexpr iter_difference_t<Iterator> operator()(Iterator first,
                                                   Sentinel last) const {
    if constexpr (sized_sentinel_for<Sentinel, Iterator>) {
      return last - first;
    } else {
      iter_difference_t<Iterator> result{};

      while (first != last) {
        ++first;
        ++result;
      }

      return result;
    }
  }

  template <class Range>
    requires requires(Range &&value) {
      ranges::begin(value);
      ranges::end(value);
    }
  constexpr auto operator()(Range &&value) const
      -> iter_difference_t<decltype(ranges::begin(value))> {
    return (*this)(ranges::begin(value), ranges::end(value));
  }
};

inline constexpr distance_fn distance{};

struct next_fn {
  template <input_or_output_iterator Iterator>
  constexpr Iterator operator()(Iterator iterator) const {
    ++iterator;
    return iterator;
  }

  template <input_or_output_iterator Iterator>
  constexpr Iterator operator()(Iterator iterator,
                                iter_difference_t<Iterator> distance) const {
    ranges::advance(iterator, distance);
    return iterator;
  }

  template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
  constexpr Iterator operator()(Iterator iterator, Sentinel bound) const {
    ranges::advance(iterator, bound);
    return iterator;
  }

  template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
  constexpr Iterator operator()(Iterator iterator,
                                iter_difference_t<Iterator> distance,
                                Sentinel bound) const {
    ranges::advance(iterator, distance, bound);
    return iterator;
  }
};

inline constexpr next_fn next{};

struct prev_fn {
  template <bidirectional_iterator Iterator>
  constexpr Iterator operator()(Iterator iterator) const {
    --iterator;
    return iterator;
  }

  template <bidirectional_iterator Iterator>
  constexpr Iterator operator()(Iterator iterator,
                                iter_difference_t<Iterator> distance) const {
    ranges::advance(iterator, -distance);
    return iterator;
  }

  template <bidirectional_iterator Iterator>
  constexpr Iterator operator()(Iterator iterator,
                                iter_difference_t<Iterator> distance,
                                Iterator bound) const {
    ranges::advance(iterator, -distance, bound);
    return iterator;
  }
};

inline constexpr prev_fn prev{};
} // namespace ranges

template <class C> class back_insert_iterator {
  C *c{};

public:
  using iterator_category = output_iterator_tag;
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  constexpr explicit back_insert_iterator(C &x) : c(&x) {}

  constexpr back_insert_iterator &operator=(const typename C::value_type &v) {
    c->push_back(v);
    return *this;
  }

  constexpr back_insert_iterator &operator=(typename C::value_type &&v) {
    c->push_back(move(v));
    return *this;
  }

  constexpr back_insert_iterator &operator*() { return *this; }

  constexpr back_insert_iterator &operator++() { return *this; }

  constexpr back_insert_iterator operator++(int) { return *this; }
};

template <class C> constexpr back_insert_iterator<C> back_inserter(C &c) {
  return back_insert_iterator<C>(c);
}

