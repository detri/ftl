template <class C> class insert_iterator {
  C *c{};
  typename C::iterator i{};

public:
  using iterator_category = output_iterator_tag;
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  constexpr insert_iterator(C &x, typename C::iterator p) : c(&x), i(p) {}

  constexpr insert_iterator &operator=(const typename C::value_type &v) {
    i = c->insert(i, v);
    ++i;
    return *this;
  }

  constexpr insert_iterator &operator=(typename C::value_type &&v) {
    i = c->insert(i, move(v));
    ++i;
    return *this;
  }

  constexpr insert_iterator &operator*() { return *this; }

  constexpr insert_iterator &operator++() { return *this; }

  constexpr insert_iterator &operator++(int) { return *this; }
