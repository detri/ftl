template <class T> struct char_traits;
template <class C, class T> class basic_istream;
template <class C, class T> class basic_ostream;
template <class C, class T> class basic_streambuf;

template <class T, class C = char, class Traits = char_traits<C>,
          class Distance = ptrdiff_t>
class istream_iterator {
  basic_istream<C, Traits> *stream{};
  T value{};

  void read() {
    if (stream && !(*stream >> value))
      stream = nullptr;
  }

public:
  using iterator_category = input_iterator_tag;
  using iterator_concept = input_iterator_tag;
  using value_type = T;
  using difference_type = Distance;
  using pointer = const T *;
  using reference = const T &;

  constexpr istream_iterator() = default;

  istream_iterator(basic_istream<C, Traits> &s) : stream(&s) { read(); }

  const T &operator*() const { return value; }

  const T *operator->() const { return __builtin_addressof(value); }

  istream_iterator &operator++() {
    read();
    return *this;
  }

  istream_iterator operator++(int) {
    auto x = *this;
    read();
    return x;
  }

  friend bool operator==(const istream_iterator &a, const istream_iterator &b) {
    return a.stream == b.stream;
  }
};

template <class T, class C = char, class Traits = char_traits<C>>
class ostream_iterator {
  basic_ostream<C, Traits> *stream;
  const C *delimiter;

public:
  using iterator_category = output_iterator_tag;
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  ostream_iterator(basic_ostream<C, Traits> &s)
      : stream(&s), delimiter(nullptr) {}
  ostream_iterator(basic_ostream<C, Traits> &s, const C *d)
      : stream(&s), delimiter(d) {}

  ostream_iterator &operator=(const T &v) {
    *stream << v;
    if (delimiter)
      *stream << delimiter;
    return *this;
  }

  ostream_iterator &operator*() { return *this; }

  ostream_iterator &operator++() { return *this; }

  ostream_iterator &operator++(int) { return *this; }
};

template <class C, class Traits = char_traits<C>> class istreambuf_iterator {
  basic_streambuf<C, Traits> *buffer{};

public:
  using iterator_category = input_iterator_tag;
  using iterator_concept = input_iterator_tag;
  using value_type = C;
  using difference_type = typename Traits::off_type;
  using pointer = void;
  using reference = C;
  using char_type = C;
  using traits_type = Traits;
  using int_type = typename Traits::int_type;

  constexpr istreambuf_iterator() noexcept = default;

  istreambuf_iterator(basic_istream<C, Traits> &s) noexcept
      : buffer(s.rdbuf()) {}
  istreambuf_iterator(basic_streambuf<C, Traits> *b) noexcept : buffer(b) {}

  C operator*() const { return Traits::to_char_type(buffer->sgetc()); }

  istreambuf_iterator &operator++() {
    buffer->snextc();
    return *this;
  }

  istreambuf_iterator operator++(int) {
    auto x = *this;
    ++*this;
    return x;
  }

  bool equal(const istreambuf_iterator &x) const {
    return at_end() == x.at_end();
  }

private:
  bool at_end() const {
    return !buffer || Traits::eq_int_type(buffer->sgetc(), Traits::eof());
  }

  template <class X, class Y>
  friend bool operator==(const istreambuf_iterator<X, Y> &,
                         const istreambuf_iterator<X, Y> &);
};

template <class C, class Traits>
bool operator==(const istreambuf_iterator<C, Traits> &a,
                const istreambuf_iterator<C, Traits> &b) {
  return a.equal(b);
}

template <class C, class Traits = char_traits<C>> class ostreambuf_iterator {
  basic_streambuf<C, Traits> *buffer{};
  bool failed_state{};

public:
  using iterator_category = output_iterator_tag;
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  using char_type = C;
  using traits_type = Traits;
  using streambuf_type = basic_streambuf<C, Traits>;
  using ostream_type = basic_ostream<C, Traits>;
  ostreambuf_iterator(ostream_type &s) noexcept : buffer(s.rdbuf()) {}
  ostreambuf_iterator(streambuf_type *b) noexcept : buffer(b) {}

  ostreambuf_iterator &operator=(C c) {
    if (Traits::eq_int_type(buffer->sputc(c), Traits::eof()))
      failed_state = true;
    return *this;
  }

  ostreambuf_iterator &operator*() { return *this; }

  ostreambuf_iterator &operator++() { return *this; }

  ostreambuf_iterator &operator++(int) { return *this; }

  bool failed() const noexcept { return failed_state; }
};

