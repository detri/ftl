template<class I,class J> constexpr bool operator<(const reverse_iterator<I>&a,const reverse_iterator<J>&b){return b.base()<a.base();}
template<class I,class J> constexpr bool operator>(const reverse_iterator<I>&a,const reverse_iterator<J>&b){return b<a;}
template<class I,class J> constexpr bool operator<=(const reverse_iterator<I>&a,const reverse_iterator<J>&b){return !(b<a);}
template<class I,class J> constexpr bool operator>=(const reverse_iterator<I>&a,const reverse_iterator<J>&b){return !(a<b);}
template<class I,class J> constexpr auto operator<=>(const reverse_iterator<I>&a,const reverse_iterator<J>&b){return b.base()<=>a.base();}
template<class I,class J> constexpr auto operator-(const reverse_iterator<I>&a,const reverse_iterator<J>&b)->decltype(b.base()-a.base()){return b.base()-a.base();}
template<class I> constexpr reverse_iterator<I> operator+(iter_difference_t<I> n,const reverse_iterator<I>&x){return x+n;}
