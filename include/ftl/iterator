FTL_BEGIN_NAMESPACE

struct input_iterator_tag {};

struct output_iterator_tag {};

struct forward_iterator_tag : input_iterator_tag {};

struct bidirectional_iterator_tag : forward_iterator_tag {};

struct random_access_iterator_tag : bidirectional_iterator_tag {};

struct contiguous_iterator_tag : random_access_iterator_tag {};

template <class> struct incrementable_traits {};

template <class T> struct incrementable_traits<T *> {
  using difference_type = ptrdiff_t;
};

template <class T>
struct incrementable_traits<const T> : incrementable_traits<T> {};

template <class T>
  requires requires { typename T::difference_type; }
struct incrementable_traits<T> {
  using difference_type = typename T::difference_type;
};

template <class T>
  requires(
      !requires { typename T::difference_type; } &&
      requires(const T &left, const T &right) {
        { left - right } -> integral;
      })
struct incrementable_traits<T> {
  using difference_type = make_signed_t<decltype(declval<T>() - declval<T>())>;
};

template <class> struct indirectly_readable_traits {};

template <class T> struct indirectly_readable_traits<T *> {
  using value_type = remove_cv_t<T>;
};

template <class T> struct indirectly_readable_traits<T[]> {
  using value_type = remove_cv_t<T>;
};

template <class T, size_t Size> struct indirectly_readable_traits<T[Size]> {
  using value_type = remove_cv_t<T>;
};

template <class T>
struct indirectly_readable_traits<const T> : indirectly_readable_traits<T> {};

template <class T>
  requires(
      requires { typename T::value_type; } &&
      !requires { typename T::element_type; })
struct indirectly_readable_traits<T> {
  using value_type = typename T::value_type;
};

template <class T>
  requires(
      requires { typename T::element_type; } &&
      !requires { typename T::value_type; })
struct indirectly_readable_traits<T> {
  using value_type = typename T::element_type;
};

template <class T>
  requires(requires {
    typename T::value_type;
    typename T::element_type;
  } && same_as<remove_cv_t<typename T::value_type>,
               remove_cv_t<typename T::element_type>>)
struct indirectly_readable_traits<T> {
  using value_type = typename T::value_type;
};

template <class> struct iterator_traits;

template <class T>
  requires requires(T &value) { *value; }
using iter_reference_t = decltype(*declval<T &>());

namespace detail {
template <class T, class U>
concept weakly_equality_comparable_with = requires(
    const remove_reference_t<T> &left, const remove_reference_t<U> &right) {
  { left == right } -> convertible_to<bool>;
  { left != right } -> convertible_to<bool>;
  { right == left } -> convertible_to<bool>;
  { right != left } -> convertible_to<bool>;
};

template <class T> using with_reference = T &;

template <class T>
concept can_reference = requires { typename with_reference<T>; };

template <class Iterator>
concept cpp17_iterator = copyable<Iterator> && requires(Iterator iterator) {
  { *iterator } -> can_reference;
  { ++iterator } -> same_as<Iterator &>;
  { *iterator++ } -> can_reference;
};

template <class Iterator>
concept cpp17_input_iterator =
    cpp17_iterator<Iterator> && equality_comparable<Iterator> && requires {
      typename incrementable_traits<Iterator>::difference_type;
      typename indirectly_readable_traits<Iterator>::value_type;
      typename common_reference_t<
          iter_reference_t<Iterator> &&,
          typename indirectly_readable_traits<Iterator>::value_type &>;
      typename common_reference_t<
          decltype(*declval<Iterator &>()++) &&,
          typename indirectly_readable_traits<Iterator>::value_type &>;
      requires signed_integral<
          typename incrementable_traits<Iterator>::difference_type>;
    };

template <class Iterator>
concept cpp17_forward_iterator =
    cpp17_input_iterator<Iterator> && constructible_from<Iterator> &&
    is_lvalue_reference_v<iter_reference_t<Iterator>> &&
    same_as<remove_cvref_t<iter_reference_t<Iterator>>,
            typename indirectly_readable_traits<Iterator>::value_type> &&
    requires(Iterator iterator) {
      { iterator++ } -> convertible_to<const Iterator &>;
      { *iterator++ } -> same_as<iter_reference_t<Iterator>>;
    };

template <class Iterator>
concept cpp17_bidirectional_iterator =
    cpp17_forward_iterator<Iterator> && requires(Iterator iterator) {
      { --iterator } -> same_as<Iterator &>;
      { iterator-- } -> convertible_to<const Iterator &>;
      { *iterator-- } -> same_as<iter_reference_t<Iterator>>;
    };

template <class Iterator>
concept cpp17_random_access_iterator =
    cpp17_bidirectional_iterator<Iterator> && totally_ordered<Iterator> &&
    requires(Iterator iterator,
             typename incrementable_traits<Iterator>::difference_type offset) {
      { iterator += offset } -> same_as<Iterator &>;
      { iterator -= offset } -> same_as<Iterator &>;
      { iterator + offset } -> same_as<Iterator>;
      { offset + iterator } -> same_as<Iterator>;
      { iterator - offset } -> same_as<Iterator>;
      { iterator - iterator } -> same_as<decltype(offset)>;
      { iterator[offset] } -> convertible_to<iter_reference_t<Iterator>>;
    };

template <class Iterator>
concept has_legacy_member_types = requires {
  typename Iterator::difference_type;
  typename Iterator::value_type;
  typename Iterator::reference;
  typename Iterator::iterator_category;
};

template <class Iterator, class = void> struct member_pointer_or_void {
  using type = void;
};

template <class Iterator>
struct member_pointer_or_void<Iterator, void_t<typename Iterator::pointer>> {
  using type = typename Iterator::pointer;
};

template <class Iterator, class = void> struct member_pointer_or_arrow {
  using type = void;
};

template <class Iterator>
struct member_pointer_or_arrow<Iterator, void_t<typename Iterator::pointer>> {
  using type = typename Iterator::pointer;
};

template <class Iterator>
  requires(
      !requires { typename Iterator::pointer; } &&
      requires(Iterator &iterator) { iterator.operator->(); })
struct member_pointer_or_arrow<Iterator, void> {
  using type = decltype(declval<Iterator &>().operator->());
};

template <class Iterator, class = void> struct member_reference_or_deref {
  using type = iter_reference_t<Iterator>;
};

template <class Iterator>
struct member_reference_or_deref<Iterator,
                                 void_t<typename Iterator::reference>> {
  using type = typename Iterator::reference;
};

template <class Iterator, class = void> struct member_category_or_synthesized {
  using type = input_iterator_tag;
};

template <class Iterator>
struct member_category_or_synthesized<
    Iterator, void_t<typename Iterator::iterator_category>> {
  using type = typename Iterator::iterator_category;
};

template <class Iterator>
  requires(!requires { typename Iterator::iterator_category; } &&
           cpp17_random_access_iterator<Iterator>)
struct member_category_or_synthesized<Iterator, void> {
  using type = random_access_iterator_tag;
};

template <class Iterator>
  requires(!requires { typename Iterator::iterator_category; } &&
           cpp17_bidirectional_iterator<Iterator> &&
           !cpp17_random_access_iterator<Iterator>)
struct member_category_or_synthesized<Iterator, void> {
  using type = bidirectional_iterator_tag;
};

template <class Iterator>
  requires(!requires { typename Iterator::iterator_category; } &&
           cpp17_forward_iterator<Iterator> &&
           !cpp17_bidirectional_iterator<Iterator>)
struct member_category_or_synthesized<Iterator, void> {
  using type = forward_iterator_tag;
};

/*
 * Every case of the C++23 iterator_traits primary template lives here so
 * that a program-defined specialization can be told apart from a
 * generated one, which is what ITER_TRAITS requires.
 */
template <class Iterator> struct iterator_traits_primary {};

template <class Iterator>
  requires has_legacy_member_types<Iterator>
struct iterator_traits_primary<Iterator> {
  using iterator_category = typename Iterator::iterator_category;
  using value_type = typename Iterator::value_type;
  using difference_type = typename Iterator::difference_type;
  using pointer = typename member_pointer_or_void<Iterator>::type;
  using reference = typename Iterator::reference;
};

template <class Iterator>
  requires(!has_legacy_member_types<Iterator> && cpp17_input_iterator<Iterator>)
struct iterator_traits_primary<Iterator> {
  using iterator_category =
      typename member_category_or_synthesized<Iterator>::type;
  using value_type = typename indirectly_readable_traits<Iterator>::value_type;
  using difference_type =
      typename incrementable_traits<Iterator>::difference_type;
  using pointer = typename member_pointer_or_arrow<Iterator>::type;
  using reference = typename member_reference_or_deref<Iterator>::type;
};

template <class Iterator, class = void> struct difference_type_or_void {
  using type = void;
};

template <class Iterator>
struct difference_type_or_void<
    Iterator,
    void_t<typename incrementable_traits<Iterator>::difference_type>> {
  using type = typename incrementable_traits<Iterator>::difference_type;
};

template <class Iterator>
  requires(!has_legacy_member_types<Iterator> &&
           !cpp17_input_iterator<Iterator> && cpp17_iterator<Iterator>)
struct iterator_traits_primary<Iterator> {
  using iterator_category = output_iterator_tag;
  using value_type = void;
  using difference_type = typename difference_type_or_void<Iterator>::type;
  using pointer = void;
  using reference = void;
};
} // namespace detail

template <class Iterator>
struct iterator_traits : detail::iterator_traits_primary<Iterator> {};

template <class T>
  requires is_object_v<T>
struct iterator_traits<T *> {
  using iterator_concept = contiguous_iterator_tag;
  using iterator_category = random_access_iterator_tag;
  using value_type = remove_cv_t<T>;
  using difference_type = ptrdiff_t;
  using pointer = T *;
  using reference = T &;
};

namespace detail {
/*
 * ITER_TRAITS: a program-defined iterator_traits specialization wins,
 * otherwise the iterator type is consulted directly.
 */
template <class Iterator>
concept uses_generated_iterator_traits =
    is_base_of_v<detail::iterator_traits_primary<Iterator>,
                 iterator_traits<Iterator>>;

template <class Iterator>
using iter_traits_t = conditional_t<uses_generated_iterator_traits<Iterator>,
                                    Iterator, iterator_traits<Iterator>>;
} // namespace detail

namespace detail {
template <class T, class = void> struct iter_difference {};

template <class T>
struct iter_difference<
    T, void_t<typename iterator_traits<remove_cvref_t<T>>::difference_type>> {
  using type = typename iterator_traits<remove_cvref_t<T>>::difference_type;
};

template <class T>
  requires(
      !requires {
        typename iterator_traits<remove_cvref_t<T>>::difference_type;
      } &&
      requires {
        typename incrementable_traits<remove_cvref_t<T>>::difference_type;
      })
struct iter_difference<T, void> {
  using type =
      typename incrementable_traits<remove_cvref_t<T>>::difference_type;
};

template <class T, class = void> struct iter_value {};

template <class T>
struct iter_value<
    T, void_t<typename iterator_traits<remove_cvref_t<T>>::value_type>> {
  using type = typename iterator_traits<remove_cvref_t<T>>::value_type;
};

template <class T>
  requires(
      !requires { typename iterator_traits<remove_cvref_t<T>>::value_type; } &&
      requires {
        typename indirectly_readable_traits<remove_cvref_t<T>>::value_type;
      })
struct iter_value<T, void> {
  using type =
      typename indirectly_readable_traits<remove_cvref_t<T>>::value_type;
};
} // namespace detail

template <class T>
using iter_difference_t = typename detail::iter_difference<T>::type;

template <class T> using iter_value_t = typename detail::iter_value<T>::type;

namespace detail {

template <class T, class U>
constexpr bool pointer_total_less(T *left, U *right) noexcept {
  /*
   * Integer conversion is not permitted in a constant expression.
   * For constexpr evaluation, use the language pointer ordering;
   * this is also what libstdc++ does.
   */
  if (is_constant_evaluated()) {
    return left < right;
  }

  return reinterpret_cast<uintptr_t>(left) <
         reinterpret_cast<uintptr_t>(right);
}

template <class T, class U>
concept has_member_less = requires(T &&left, U &&right) {
  static_cast<T &&>(left).operator<(static_cast<U &&>(right));
};

template <class T, class U>
concept has_nonmember_less = requires(T &&left, U &&right) {
  operator<(static_cast<T &&>(left), static_cast<U &&>(right));
};

template <class T, class U>
concept has_member_three_way = requires(T &&left, U &&right) {
  static_cast<T &&>(left).operator<=>(static_cast<U &&>(right));
};

template <class T, class U>
concept has_nonmember_three_way = requires(T &&left, U &&right) {
  operator<=>(static_cast<T &&>(left), static_cast<U &&>(right));
};

template <class T, class U>
inline constexpr bool uses_builtin_object_pointer_less_v =
    is_convertible_v<T, const volatile void *> &&
    is_convertible_v<U, const volatile void *> &&
    !has_member_less<T, U> &&
    !has_nonmember_less<T, U> &&
    !has_member_three_way<T, U> &&
    !has_nonmember_three_way<T, U>;

} // namespace detail

namespace ranges {
struct less {
  using is_transparent = void;

  template <class T, class U>
    requires totally_ordered_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(static_cast<T &&>(left) <
                        static_cast<U &&>(right))) {
    if constexpr (
        is_pointer_v<remove_reference_t<T>> &&
        is_pointer_v<remove_reference_t<U>>) {
      return FTL_ITER_NS::detail::pointer_total_less(
          static_cast<T &&>(left),
          static_cast<U &&>(right));
    } else if constexpr (
        FTL_ITER_NS::detail::uses_builtin_object_pointer_less_v<T, U>) {
      return FTL_ITER_NS::detail::pointer_total_less(
          static_cast<const volatile void *>(
              static_cast<T &&>(left)),
          static_cast<const volatile void *>(
              static_cast<U &&>(right)));
    } else {
      return static_cast<T &&>(left) <
             static_cast<U &&>(right);
    }
  }
};

namespace detail {
void iter_move();

void iter_swap();

template <class T>
concept has_adl_iter_move =
    requires(T &&value) { iter_move(static_cast<T &&>(value)); };

template <class T, class U>
concept has_adl_iter_swap = requires(T &&left, U &&right) {
  iter_swap(static_cast<T &&>(left), static_cast<U &&>(right));
};
} // namespace detail

namespace detail {
template <class T> consteval bool iter_move_noexcept() {
  if constexpr (has_adl_iter_move<T>) {
    return noexcept(iter_move(declval<T &&>()));
  } else if constexpr (is_lvalue_reference_v<decltype(*declval<T &&>())>) {
    return noexcept(FTL_ITER_NS::move(*declval<T &&>()));
  } else {
    return noexcept(*declval<T &&>());
  }
}
} // namespace detail

struct iter_move_fn {
  template <class T>
  constexpr decltype(auto) operator()(T &&value) const
      noexcept(detail::iter_move_noexcept<T>()) {
    if constexpr (detail::has_adl_iter_move<T>) {
      return iter_move(static_cast<T &&>(value));
    } else if constexpr (is_lvalue_reference_v<decltype(*value)>) {
      return FTL_ITER_NS::move(*value);
    } else {
      return *value;
    }
  }
};

inline namespace cpo {
inline constexpr iter_move_fn iter_move{};
}
} // namespace ranges

template <class T>
using iter_rvalue_reference_t = decltype(ranges::iter_move(declval<T &>()));

template <class Iterator>
concept indirectly_readable = requires(const Iterator iterator) {
  typename iter_value_t<Iterator>;
  typename iter_reference_t<Iterator>;
  typename iter_rvalue_reference_t<Iterator>;

  requires common_reference_with<iter_reference_t<Iterator> &&,
                                 iter_value_t<Iterator> &>;

  requires common_reference_with<iter_reference_t<Iterator> &&,
                                 iter_rvalue_reference_t<Iterator> &&>;

  requires common_reference_with<iter_rvalue_reference_t<Iterator> &&,
                                 const iter_value_t<Iterator> &>;
};

template <indirectly_readable Iterator>
using iter_common_reference_t =
    common_reference_t<iter_reference_t<Iterator>, iter_value_t<Iterator> &>;

template <class Output, class T>
concept indirectly_writable = requires(Output &&output, T &&value) {
  *output = static_cast<T &&>(value);
  *static_cast<Output &&>(output) = static_cast<T &&>(value);

  const_cast<const iter_reference_t<Output> &&>(*output) =
      static_cast<T &&>(value);

  const_cast<const iter_reference_t<Output> &&>(
      *static_cast<Output &&>(output)) = static_cast<T &&>(value);
};

template <class Iterator>
concept weakly_incrementable =
    movable<Iterator> && requires(Iterator iterator) {
      typename iter_difference_t<Iterator>;
      requires signed_integral<iter_difference_t<Iterator>>;
      { ++iterator } -> same_as<Iterator &>;
      iterator++;
    };

template <class Iterator>
concept incrementable = regular<Iterator> && weakly_incrementable<Iterator> &&
                        requires(Iterator iterator) {
                          { iterator++ } -> same_as<Iterator>;
                        };

template <class Iterator>
concept input_or_output_iterator = requires(Iterator iterator) { *iterator; } &&
                                   weakly_incrementable<Iterator>;

template <class Sentinel, class Iterator>
concept sentinel_for =
    semiregular<Sentinel> && input_or_output_iterator<Iterator> &&
    detail::weakly_equality_comparable_with<Sentinel, Iterator>;

template <class Sentinel, class Iterator>
inline constexpr bool disable_sized_sentinel_for = false;

template <class Sentinel, class Iterator>
concept sized_sentinel_for =
    sentinel_for<Sentinel, Iterator> &&
    !disable_sized_sentinel_for<remove_cv_t<Sentinel>, remove_cv_t<Iterator>> &&
    requires(const Iterator &iterator, const Sentinel &sentinel) {
      { sentinel - iterator } -> same_as<iter_difference_t<Iterator>>;
      { iterator - sentinel } -> same_as<iter_difference_t<Iterator>>;
    };

namespace detail {
/*
 * ITER_CONCEPT: iterator_concept, then iterator_category, then
 * random_access_iterator_tag when iterator_traits is generated.
 */
template <class Iterator, class = void> struct iter_concept_generated {};

template <class Iterator>
  requires uses_generated_iterator_traits<Iterator>
struct iter_concept_generated<Iterator, void> {
  using type = random_access_iterator_tag;
};

template <class Iterator, class = void>
struct iter_concept_category : iter_concept_generated<Iterator> {};

template <class Iterator>
struct iter_concept_category<
    Iterator, void_t<typename iter_traits_t<Iterator>::iterator_category>> {
  using type = typename iter_traits_t<Iterator>::iterator_category;
};

template <class Iterator, class = void>
struct iter_concept : iter_concept_category<Iterator> {};

template <class Iterator>
struct iter_concept<
    Iterator, void_t<typename iter_traits_t<Iterator>::iterator_concept>> {
  using type = typename iter_traits_t<Iterator>::iterator_concept;
};

template <class Iterator>
using iter_concept_t = typename iter_concept<Iterator>::type;
} // namespace detail

template <class Iterator>
concept input_iterator =
    input_or_output_iterator<Iterator> && indirectly_readable<Iterator> &&
    derived_from<detail::iter_concept_t<Iterator>, input_iterator_tag>;

template <class Iterator, class T>
concept output_iterator =
    input_or_output_iterator<Iterator> && indirectly_writable<Iterator, T> &&
    requires(Iterator iterator, T &&value) {
      *iterator++ = static_cast<T &&>(value);
    };

template <class Iterator>
concept forward_iterator =
    input_iterator<Iterator> &&
    derived_from<detail::iter_concept_t<Iterator>, forward_iterator_tag> &&
    incrementable<Iterator> && sentinel_for<Iterator, Iterator>;

template <class Iterator>
concept bidirectional_iterator = forward_iterator<Iterator> &&
                                 derived_from<detail::iter_concept_t<Iterator>,
                                              bidirectional_iterator_tag> &&
                                 requires(Iterator iterator) {
                                   { --iterator } -> same_as<Iterator &>;
                                   { iterator-- } -> same_as<Iterator>;
                                 };

template <class Iterator>
concept random_access_iterator =
    bidirectional_iterator<Iterator> &&
    derived_from<detail::iter_concept_t<Iterator>,
                 random_access_iterator_tag> &&
    totally_ordered<Iterator> && sized_sentinel_for<Iterator, Iterator> &&
    requires(Iterator iterator, const Iterator constant,
             const iter_difference_t<Iterator> offset) {
      { iterator += offset } -> same_as<Iterator &>;
      { constant + offset } -> same_as<Iterator>;
      { offset + constant } -> same_as<Iterator>;
      { iterator -= offset } -> same_as<Iterator &>;
      { constant - offset } -> same_as<Iterator>;
      { constant[offset] } -> same_as<iter_reference_t<Iterator>>;
    };

template <class Iterator>
concept contiguous_iterator =
    random_access_iterator<Iterator> &&
    derived_from<detail::iter_concept_t<Iterator>, contiguous_iterator_tag> &&
    is_lvalue_reference_v<iter_reference_t<Iterator>> &&
    same_as<iter_value_t<Iterator>,
            remove_cvref_t<iter_reference_t<Iterator>>> &&
    requires(const Iterator &iterator) {
      {
        __builtin_addressof(*iterator)
      } -> same_as<add_pointer_t<iter_reference_t<Iterator>>>;
    };

namespace ranges {
namespace detail {

template <class T, class U> consteval bool iter_swap_noexcept() {
  if constexpr (has_adl_iter_swap<T, U>) {
    return noexcept(iter_swap(declval<T &&>(), declval<U &&>()));
  } else {
    using value_type = iter_value_t<T>;

    return noexcept(value_type(ranges::iter_move(declval<T &&>()))) &&
           noexcept(*declval<T &&>() = ranges::iter_move(declval<U &&>())) &&
           noexcept(*declval<U &&>() = declval<value_type &&>());
  }
}

} // namespace detail

struct iter_swap_fn {
  template <class T, class U>
  constexpr void operator()(T &&left, U &&right) const
      noexcept(detail::iter_swap_noexcept<T, U>()) {
    if constexpr (detail::has_adl_iter_swap<T, U>) {
      iter_swap(static_cast<T &&>(left), static_cast<U &&>(right));
    } else {
      iter_value_t<T> old(ranges::iter_move(left));
      *left = ranges::iter_move(right);
      *right = FTL_ITER_NS::move(old);
    }
  }
};

inline namespace cpo {
inline constexpr iter_swap_fn iter_swap{};
}
} // namespace ranges

template <class F, class Iterator>
concept indirectly_unary_invocable =
    indirectly_readable<Iterator> && copy_constructible<F> &&
    invocable<F &, iter_value_t<Iterator> &> &&
    invocable<F &, iter_reference_t<Iterator>> &&
    invocable<F &, iter_common_reference_t<Iterator>> &&
    common_reference_with<invoke_result_t<F &, iter_value_t<Iterator> &>,
                          invoke_result_t<F &, iter_reference_t<Iterator>>>;

template <class F, class Iterator>
concept indirectly_regular_unary_invocable =
    indirectly_readable<Iterator> && copy_constructible<F> &&
    regular_invocable<F &, iter_value_t<Iterator> &> &&
    regular_invocable<F &, iter_reference_t<Iterator>> &&
    regular_invocable<F &, iter_common_reference_t<Iterator>>;

template <class F, class Iterator>
concept indirect_unary_predicate =
    indirectly_readable<Iterator> && copy_constructible<F> &&
    predicate<F &, iter_value_t<Iterator> &> &&
    predicate<F &, iter_reference_t<Iterator>> &&
    predicate<F &, iter_common_reference_t<Iterator>>;

template <class F, class Iterator1, class Iterator2>
concept indirect_binary_predicate =
    indirectly_readable<Iterator1> && indirectly_readable<Iterator2> &&
    copy_constructible<F> &&
    predicate<F &, iter_value_t<Iterator1> &, iter_value_t<Iterator2> &> &&
    predicate<F &, iter_value_t<Iterator1> &, iter_reference_t<Iterator2>> &&
    predicate<F &, iter_reference_t<Iterator1>, iter_value_t<Iterator2> &> &&
    predicate<F &, iter_reference_t<Iterator1>, iter_reference_t<Iterator2>> &&
    predicate<F &, iter_common_reference_t<Iterator1>,
              iter_common_reference_t<Iterator2>>;

template <class F, class Iterator1, class Iterator2 = Iterator1>
concept indirect_equivalence_relation =
    indirect_binary_predicate<F, Iterator1, Iterator2>;

template <class F, class Iterator1, class Iterator2 = Iterator1>
concept indirect_strict_weak_order =
    indirect_binary_predicate<F, Iterator1, Iterator2>;

template <class F, class... Iterators>
  requires(indirectly_readable<Iterators> && ...) &&
              invocable<F, iter_reference_t<Iterators>...>
using indirect_result_t = invoke_result_t<F, iter_reference_t<Iterators>...>;

#ifndef FTL_DETAIL_IDENTITY_DEFINED
#define FTL_DETAIL_IDENTITY_DEFINED

struct identity {
  using is_transparent = void;

  template <class T> constexpr T &&operator()(T &&value) const noexcept {
    return static_cast<T &&>(value);
  }
};

#endif

template <indirectly_readable Iterator,
          indirectly_regular_unary_invocable<Iterator> Projection>
struct projected {
  using value_type = remove_cvref_t<indirect_result_t<Projection &, Iterator>>;

  indirect_result_t<Projection &, Iterator> operator*() const;
};

template <weakly_incrementable Iterator, class Projection>
struct incrementable_traits<projected<Iterator, Projection>> {
  using difference_type = iter_difference_t<Iterator>;
};

template <class Input, class Output>
concept indirectly_movable =
    indirectly_readable<Input> &&
    indirectly_writable<Output, iter_rvalue_reference_t<Input>>;

template <class Input, class Output>
concept indirectly_movable_storable =
    indirectly_movable<Input, Output> &&
    indirectly_writable<Output, iter_value_t<Input>> &&
    movable<iter_value_t<Input>> &&
    constructible_from<iter_value_t<Input>, iter_rvalue_reference_t<Input>> &&
    assignable_from<iter_value_t<Input> &, iter_rvalue_reference_t<Input>>;

template <class Input, class Output>
concept indirectly_copyable =
    indirectly_readable<Input> &&
    indirectly_writable<Output, iter_reference_t<Input>>;

template <class Input, class Output>
concept indirectly_copyable_storable =
    indirectly_copyable<Input, Output> &&
    indirectly_writable<Output, iter_value_t<Input> &> &&
    indirectly_writable<Output, const iter_value_t<Input> &> &&
    copyable<iter_value_t<Input>> &&
    constructible_from<iter_value_t<Input>, iter_reference_t<Input>> &&
    assignable_from<iter_value_t<Input> &, iter_reference_t<Input>>;

template <class Iterator1, class Iterator2 = Iterator1>
concept indirectly_swappable =
    indirectly_readable<Iterator1> && indirectly_readable<Iterator2> &&
    requires(const Iterator1 first, const Iterator2 second) {
      ranges::iter_swap(first, first);
      ranges::iter_swap(second, second);
      ranges::iter_swap(first, second);
      ranges::iter_swap(second, first);
    };

template <class Iterator1, class Iterator2, class Relation,
          class Projection1 = identity, class Projection2 = identity>
concept indirectly_comparable =
    indirect_binary_predicate<Relation, projected<Iterator1, Projection1>,
                              projected<Iterator2, Projection2>>;

template <class Iterator>
concept permutable = forward_iterator<Iterator> &&
                     indirectly_movable_storable<Iterator, Iterator> &&
                     indirectly_swappable<Iterator, Iterator>;

template <class Iterator1, class Iterator2, class Output,
          class Relation = ranges::less, class Projection1 = identity,
          class Projection2 = identity>
concept mergeable =
    input_iterator<Iterator1> && input_iterator<Iterator2> &&
    weakly_incrementable<Output> && indirectly_copyable<Iterator1, Output> &&
    indirectly_copyable<Iterator2, Output> &&
    indirect_strict_weak_order<Relation, projected<Iterator1, Projection1>,
                               projected<Iterator2, Projection2>>;

template <class Iterator, class Relation = ranges::less,
          class Projection = identity>
concept sortable =
    permutable<Iterator> &&
    indirect_strict_weak_order<Relation, projected<Iterator, Projection>>;

template <class InputIterator, class Distance>
constexpr void advance(InputIterator &iterator, Distance distance) {
  if constexpr (random_access_iterator<InputIterator>) {
    iterator += distance;
  } else if constexpr (bidirectional_iterator<InputIterator>) {
    if (distance >= 0) {
      while (distance-- > 0)
        ++iterator;
    } else {
      while (distance++ < 0)
        --iterator;
    }
  } else {
    while (distance-- > 0)
      ++iterator;
  }
}

template <class InputIterator>
constexpr typename iterator_traits<InputIterator>::difference_type
distance(InputIterator first, InputIterator last) {
  if constexpr (random_access_iterator<InputIterator>) {
    return last - first;
  } else {
    typename iterator_traits<InputIterator>::difference_type result{};

    while (first != last) {
      ++first;
      ++result;
    }

    return result;
  }
}

template <class InputIterator>
constexpr InputIterator
next(InputIterator iterator,
     typename iterator_traits<InputIterator>::difference_type distance = 1) {
  FTL_ITER_NS::advance(iterator, distance);
  return iterator;
}

template <class BidirectionalIterator>
constexpr BidirectionalIterator
prev(BidirectionalIterator iterator,
     typename iterator_traits<BidirectionalIterator>::difference_type distance =
         1) {
  FTL_ITER_NS::advance(iterator, -distance);
  return iterator;
}

template <class Iterator> class reverse_iterator {
private:
  Iterator current{};

public:
  using iterator_type = Iterator;

  using iterator_concept =
      conditional_t<random_access_iterator<Iterator>,
                    random_access_iterator_tag, bidirectional_iterator_tag>;

  using iterator_category =
      typename iterator_traits<Iterator>::iterator_category;

  using value_type = iter_value_t<Iterator>;
  using difference_type = iter_difference_t<Iterator>;
  using pointer = Iterator;
  using reference = iter_reference_t<Iterator>;

  constexpr reverse_iterator() = default;

  constexpr explicit reverse_iterator(Iterator iterator) : current(iterator) {}

  template <class U>
    requires(!same_as<U, Iterator> && convertible_to<const U &, Iterator>)
  constexpr reverse_iterator(const reverse_iterator<U> &other)
      : current(other.base()) {}

  constexpr Iterator base() const { return current; }

  constexpr reference operator*() const {
    auto iterator = current;
    return *--iterator;
  }

  constexpr auto operator->() const {
    auto iterator = current;
    --iterator;

    if constexpr (is_pointer_v<Iterator>) {
      return iterator;
    } else {
      return iterator.operator->();
    }
  }

  constexpr reverse_iterator &operator++() {
    --current;
    return *this;
  }

  constexpr reverse_iterator operator++(int) {
    auto copy = *this;
    --current;
    return copy;
  }

  constexpr reverse_iterator &operator--() {
    ++current;
    return *this;
  }

  constexpr reverse_iterator operator--(int) {
    auto copy = *this;
    ++current;
    return copy;
  }

  constexpr reverse_iterator operator+(difference_type offset) const {
    return reverse_iterator(current - offset);
  }

  constexpr reverse_iterator &operator+=(difference_type offset) {
    current -= offset;
    return *this;
  }

  constexpr reverse_iterator operator-(difference_type offset) const {
    return reverse_iterator(current + offset);
  }

  constexpr reverse_iterator &operator-=(difference_type offset) {
    current += offset;
    return *this;
  }

  constexpr reference operator[](difference_type offset) const {
    return current[-offset - 1];
  }
};

template <class Iterator1, class Iterator2>
constexpr bool operator==(const reverse_iterator<Iterator1> &left,
                          const reverse_iterator<Iterator2> &right) {
  return left.base() == right.base();
}

template <class Iterator1, class Iterator2>
constexpr bool operator!=(const reverse_iterator<Iterator1> &left,
                          const reverse_iterator<Iterator2> &right) {
  return !(left == right);
}

template <class Iterator1, class Iterator2>
constexpr bool operator<(const reverse_iterator<Iterator1> &left,
                         const reverse_iterator<Iterator2> &right) {
  return right.base() < left.base();
}

template <class Iterator1, class Iterator2>
constexpr bool operator>(const reverse_iterator<Iterator1> &left,
                         const reverse_iterator<Iterator2> &right) {
  return right < left;
}

template <class Iterator1, class Iterator2>
constexpr bool operator<=(const reverse_iterator<Iterator1> &left,
                          const reverse_iterator<Iterator2> &right) {
  return !(right < left);
}

template <class Iterator1, class Iterator2>
constexpr bool operator>=(const reverse_iterator<Iterator1> &left,
                          const reverse_iterator<Iterator2> &right) {
  return !(left < right);
}

template <class Iterator1, class Iterator2>
constexpr auto operator<=>(const reverse_iterator<Iterator1> &left,
                           const reverse_iterator<Iterator2> &right) {
  return right.base() <=> left.base();
}

template <class Iterator1, class Iterator2>
constexpr auto operator-(const reverse_iterator<Iterator1> &left,
                         const reverse_iterator<Iterator2> &right)
    -> decltype(right.base() - left.base()) {
  return right.base() - left.base();
}

template <class Iterator>
constexpr reverse_iterator<Iterator>
operator+(iter_difference_t<Iterator> offset,
          const reverse_iterator<Iterator> &iterator) {
  return iterator + offset;
}

template <class Iterator>
constexpr reverse_iterator<Iterator> make_reverse_iterator(Iterator iterator) {
  return reverse_iterator<Iterator>(iterator);
}

template <class Iterator1, class Iterator2>
  requires(!sized_sentinel_for<Iterator1, Iterator2>)
inline constexpr bool disable_sized_sentinel_for<reverse_iterator<Iterator1>,
                                                 reverse_iterator<Iterator2>> =
    true;

struct default_sentinel_t {};

inline constexpr default_sentinel_t default_sentinel{};

struct unreachable_sentinel_t {
  template <weakly_incrementable Iterator>
  friend constexpr bool operator==(unreachable_sentinel_t,
                                   const Iterator &) noexcept {
    return false;
  }
};

inline constexpr unreachable_sentinel_t unreachable_sentinel{};

namespace detail {
template <class Iterator, class = void> struct counted_iterator_concept_base {};

template <class Iterator>
struct counted_iterator_concept_base<
    Iterator, void_t<typename Iterator::iterator_concept>> {
  using iterator_concept = typename Iterator::iterator_concept;
};

template <class Iterator, class = void>
struct counted_iterator_category_base {};

template <class Iterator>
struct counted_iterator_category_base<
    Iterator, void_t<typename Iterator::iterator_category>> {
  using iterator_category = typename Iterator::iterator_category;
};
} // namespace detail

template <input_or_output_iterator Iterator>
class counted_iterator
    : public detail::counted_iterator_concept_base<Iterator>,
      public detail::counted_iterator_category_base<Iterator> {
private:
  Iterator current{};
  iter_difference_t<Iterator> length{};

public:
  using iterator_type = Iterator;

  using value_type = iter_value_t<Iterator>;
  using difference_type = iter_difference_t<Iterator>;
  using pointer = void;
  using reference = iter_reference_t<Iterator>;

  constexpr counted_iterator()
    requires default_initializable<Iterator>
  = default;

  constexpr counted_iterator(Iterator iterator, difference_type count)
      : current(FTL_ITER_NS::move(iterator)), length(count) {}

  template <class U>
    requires convertible_to<const U &, Iterator>
  constexpr counted_iterator(const counted_iterator<U> &other)
      : current(other.base()), length(other.count()) {}

  constexpr const Iterator &base() const & noexcept { return current; }

  constexpr Iterator base() && { return FTL_ITER_NS::move(current); }

  constexpr difference_type count() const noexcept { return length; }

  constexpr reference operator*() const { return *current; }

  constexpr counted_iterator &operator++() {
    ++current;
    --length;
    return *this;
  }

  constexpr auto operator++(int) {
    if constexpr (forward_iterator<Iterator>) {
      auto copy = *this;
      ++*this;
      return copy;
    } else {
      --length;
      return current++;
    }
  }

  constexpr counted_iterator &operator--()
    requires bidirectional_iterator<Iterator>
  {
    --current;
    ++length;
    return *this;
  }

  constexpr counted_iterator operator--(int)
    requires bidirectional_iterator<Iterator>
  {
    auto copy = *this;
    --*this;
    return copy;
  }

  constexpr counted_iterator &operator+=(difference_type offset)
    requires random_access_iterator<Iterator>
  {
    current += offset;
    length -= offset;
    return *this;
  }

  constexpr counted_iterator &operator-=(difference_type offset)
    requires random_access_iterator<Iterator>
  {
    return *this += -offset;
  }

  constexpr reference operator[](difference_type offset) const
    requires random_access_iterator<Iterator>
  {
    return current[offset];
  }

  template <class U>
  friend constexpr bool operator==(const counted_iterator &left,
                                   const counted_iterator<U> &right) {
    return left.length == right.count();
  }

  friend constexpr bool operator==(const counted_iterator &iterator,
                                   default_sentinel_t) {
    return iterator.length == 0;
  }

  template <common_with<Iterator> OtherIterator>
  [[nodiscard]]
  friend constexpr strong_ordering
  operator<=>(const counted_iterator &left,
              const counted_iterator<OtherIterator> &right) {
    return compare_three_way{}(right.count(), left.count());
  }

  friend constexpr counted_iterator operator+(counted_iterator iterator,
                                              difference_type offset)
    requires random_access_iterator<Iterator>
  {
    iterator += offset;
    return iterator;
  }

  friend constexpr counted_iterator operator+(difference_type offset,
                                              counted_iterator iterator)
    requires random_access_iterator<Iterator>
  {
    iterator += offset;
    return iterator;
  }

  friend constexpr counted_iterator operator-(counted_iterator iterator,
                                              difference_type offset)
    requires random_access_iterator<Iterator>
  {
    iterator -= offset;
    return iterator;
  }

  template <class U>
  friend constexpr auto operator-(const counted_iterator &left,
                                  const counted_iterator<U> &right) {
    return right.count() - left.length;
  }

  friend constexpr difference_type operator-(default_sentinel_t,
                                             const counted_iterator &iterator) {
    return iterator.length;
  }

  friend constexpr difference_type operator-(const counted_iterator &iterator,
                                             default_sentinel_t) {
    return -iterator.length;
  }

  friend constexpr decltype(auto)
  iter_move(const counted_iterator &iterator) noexcept(
      noexcept(ranges::iter_move(iterator.current))) {
    return ranges::iter_move(iterator.current);
  }

  template <class U>
  friend constexpr void
  iter_swap(const counted_iterator &left,
            const counted_iterator<U>
                &right) noexcept(noexcept(ranges::iter_swap(left.current,
                                                            right.base()))) {
    ranges::iter_swap(left.current, right.base());
  }
};

template <class Iterator>
using iter_const_reference_t =
    common_reference_t<const iter_value_t<Iterator> &&,
                       iter_reference_t<Iterator>>;

template <class Iterator>
concept constant_iterator =
    input_iterator<Iterator> &&
    same_as<iter_const_reference_t<Iterator>, iter_reference_t<Iterator>>;

template <input_iterator Iterator> class basic_const_iterator;

namespace detail {
template <class> struct is_basic_const_iterator : false_type {};

template <input_iterator Iterator>
struct is_basic_const_iterator<basic_const_iterator<Iterator>> : true_type {};

template <class T>
concept not_a_const_iterator =
    !is_basic_const_iterator<remove_cvref_t<T>>::value;

template <class T, class U>
concept different_from = !same_as<remove_cvref_t<T>, remove_cvref_t<U>>;

template <class Iterator, bool = forward_iterator<Iterator>>
struct basic_const_iterator_category {};

template <class Iterator> struct basic_const_iterator_category<Iterator, true> {
  using iterator_category =
      typename iterator_traits<Iterator>::iterator_category;
};
} // namespace detail

template <input_iterator Iterator>
class basic_const_iterator
    : public detail::basic_const_iterator_category<Iterator> {
private:
  template <input_iterator> friend class basic_const_iterator;

  Iterator current{};

  using reference = iter_const_reference_t<Iterator>;

  using rvalue_reference =
      common_reference_t<const iter_value_t<Iterator> &&,
                         iter_rvalue_reference_t<Iterator>>;

public:
  using iterator_concept = conditional_t<
      contiguous_iterator<Iterator>, contiguous_iterator_tag,
      conditional_t<
          random_access_iterator<Iterator>, random_access_iterator_tag,
          conditional_t<
              bidirectional_iterator<Iterator>, bidirectional_iterator_tag,
              conditional_t<forward_iterator<Iterator>, forward_iterator_tag,
                            input_iterator_tag>>>>;

  using value_type = iter_value_t<Iterator>;
  using difference_type = iter_difference_t<Iterator>;

  constexpr basic_const_iterator()
    requires default_initializable<Iterator>
  = default;

  constexpr basic_const_iterator(Iterator iterator)
      : current(FTL_ITER_NS::move(iterator)) {}

  template <class U>
    requires convertible_to<U, Iterator>
  constexpr basic_const_iterator(basic_const_iterator<U> other)
      : current(FTL_ITER_NS::move(other.current)) {}

  template <class T>
    requires(detail::different_from<T, basic_const_iterator> &&
             convertible_to<T, Iterator>)
  constexpr basic_const_iterator(T &&iterator)
      : current(static_cast<T &&>(iterator)) {}

  constexpr const Iterator &base() const & noexcept { return current; }

  constexpr Iterator base() && { return FTL_ITER_NS::move(current); }

  constexpr reference operator*() const {
    return static_cast<reference>(*current);
  }

  constexpr const auto *operator->() const
    requires(is_lvalue_reference_v<iter_reference_t<Iterator>> &&
             same_as<remove_cvref_t<iter_reference_t<Iterator>>, value_type>)
  {
    return __builtin_addressof(*current);
  }

  constexpr basic_const_iterator &operator++() {
    ++current;
    return *this;
  }

  constexpr void operator++(int) { ++current; }

  constexpr basic_const_iterator operator++(int)
    requires forward_iterator<Iterator>
  {
    auto copy = *this;
    ++*this;
    return copy;
  }

  constexpr basic_const_iterator &operator--()
    requires bidirectional_iterator<Iterator>
  {
    --current;
    return *this;
  }

  constexpr basic_const_iterator operator--(int)
    requires bidirectional_iterator<Iterator>
  {
    auto copy = *this;
    --current;
    return copy;
  }

  constexpr basic_const_iterator &operator+=(difference_type offset)
    requires random_access_iterator<Iterator>
  {
    current += offset;
    return *this;
  }

  constexpr basic_const_iterator &operator-=(difference_type offset)
    requires random_access_iterator<Iterator>
  {
    current -= offset;
    return *this;
  }

  constexpr reference operator[](difference_type offset) const
    requires random_access_iterator<Iterator>
  {
    return static_cast<reference>(current[offset]);
  }

  template <class Sentinel>
    requires sentinel_for<Sentinel, Iterator>
  constexpr bool operator==(const Sentinel &sentinel) const {
    return current == sentinel;
  }

  constexpr bool operator<(const basic_const_iterator &right) const
    requires random_access_iterator<Iterator>
  {
    return current < right.current;
  }

  constexpr bool operator>(const basic_const_iterator &right) const
    requires random_access_iterator<Iterator>
  {
    return current > right.current;
  }

  constexpr bool operator<=(const basic_const_iterator &right) const
    requires random_access_iterator<Iterator>
  {
    return current <= right.current;
  }

  constexpr bool operator>=(const basic_const_iterator &right) const
    requires random_access_iterator<Iterator>
  {
    return current >= right.current;
  }

  constexpr auto operator<=>(const basic_const_iterator &right) const
#ifdef FTL_REPLACE_STL
    requires(random_access_iterator<Iterator> && three_way_comparable<Iterator>)
#else
    requires random_access_iterator<Iterator>
#endif
  {
#ifdef FTL_REPLACE_STL
    return current <=> right.current;
#else
    return compare_three_way{}(current, right.current);
#endif
  }

  template <class I>
    requires(detail::different_from<I, basic_const_iterator> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  constexpr bool operator<(const I &right) const {
    return current < right;
  }

  template <class I>
    requires(detail::different_from<I, basic_const_iterator> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  constexpr bool operator>(const I &right) const {
    return current > right;
  }

  template <class I>
    requires(detail::different_from<I, basic_const_iterator> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  constexpr bool operator<=(const I &right) const {
    return current <= right;
  }

  template <class I>
    requires(detail::different_from<I, basic_const_iterator> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  constexpr bool operator>=(const I &right) const {
    return current >= right;
  }

  template <class I>
    requires(detail::different_from<I, basic_const_iterator> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>
#ifdef FTL_REPLACE_STL
             && three_way_comparable_with<Iterator, I>
#endif
             )
  constexpr auto operator<=>(const I &right) const {
#ifdef FTL_REPLACE_STL
    return current <=> right;
#else
    return compare_three_way{}(current, right);
#endif
  }

  template <class I>
    requires(detail::not_a_const_iterator<I> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  friend constexpr bool operator<(const I &left,
                                  const basic_const_iterator &right) {
    return left < right.current;
  }

  template <class I>
    requires(detail::not_a_const_iterator<I> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  friend constexpr bool operator>(const I &left,
                                  const basic_const_iterator &right) {
    return left > right.current;
  }

  template <class I>
    requires(detail::not_a_const_iterator<I> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  friend constexpr bool operator<=(const I &left,
                                   const basic_const_iterator &right) {
    return left <= right.current;
  }

  template <class I>
    requires(detail::not_a_const_iterator<I> &&
             random_access_iterator<Iterator> &&
             totally_ordered_with<Iterator, I>)
  friend constexpr bool operator>=(const I &left,
                                   const basic_const_iterator &right) {
    return left >= right.current;
  }

  friend constexpr basic_const_iterator
  operator+(const basic_const_iterator &iterator, difference_type offset)
    requires random_access_iterator<Iterator>
  {
    return basic_const_iterator(iterator.current + offset);
  }

  friend constexpr basic_const_iterator
  operator+(difference_type offset, const basic_const_iterator &iterator)
    requires random_access_iterator<Iterator>
  {
    return basic_const_iterator(iterator.current + offset);
  }

  friend constexpr basic_const_iterator
  operator-(const basic_const_iterator &iterator, difference_type offset)
    requires random_access_iterator<Iterator>
  {
    return basic_const_iterator(iterator.current - offset);
  }

  template <class Sentinel>
    requires sized_sentinel_for<Sentinel, Iterator>
  constexpr difference_type operator-(const Sentinel &right) const {
    return current - right;
  }

  template <class Sentinel>
    requires(detail::not_a_const_iterator<Sentinel> &&
             sized_sentinel_for<Sentinel, Iterator>)
  friend constexpr difference_type
  operator-(const Sentinel &left, const basic_const_iterator &right) {
    return left - right.current;
  }

  friend constexpr rvalue_reference
  iter_move(const basic_const_iterator &iterator) noexcept(noexcept(
      static_cast<rvalue_reference>(ranges::iter_move(iterator.current)))) {
    return static_cast<rvalue_reference>(ranges::iter_move(iterator.current));
  }
};

template <input_iterator Iterator>
using const_iterator = conditional_t<constant_iterator<Iterator>, Iterator,
                                     basic_const_iterator<Iterator>>;

namespace detail {
template <semiregular Sentinel, bool = input_iterator<Sentinel>>
struct const_sentinel_impl {
  using type = Sentinel;
};

template <semiregular Sentinel> struct const_sentinel_impl<Sentinel, true> {
  using type = const_iterator<Sentinel>;
};
} // namespace detail

template <semiregular Sentinel>
using const_sentinel = typename detail::const_sentinel_impl<Sentinel>::type;

template <input_iterator Iterator>
constexpr const_iterator<Iterator> make_const_iterator(Iterator iterator) {
  return const_iterator<Iterator>(FTL_ITER_NS::move(iterator));
}

template <semiregular Sentinel>
