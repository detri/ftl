template<class InputIterator, class Distance> constexpr void advance(InputIterator& i, Distance n) {
    if constexpr (random_access_iterator<InputIterator>) i += n;
    else if constexpr (bidirectional_iterator<InputIterator>) { if (n >= 0) while (n--) ++i; else while (n++) --i; }
    else while (n-- > 0) ++i;
}
template<class InputIterator> constexpr typename iterator_traits<InputIterator>::difference_type distance(InputIterator first, InputIterator last) {
    if constexpr (random_access_iterator<InputIterator>) return last - first;
    else { typename iterator_traits<InputIterator>::difference_type n{}; while (first != last) { ++first; ++n; } return n; }
}
template<class InputIterator> constexpr InputIterator next(InputIterator x, typename iterator_traits<InputIterator>::difference_type n = 1) { FTL_ITER_NS::advance(x, n); return x; }
template<class BidirectionalIterator> constexpr BidirectionalIterator prev(BidirectionalIterator x, typename iterator_traits<BidirectionalIterator>::difference_type n = 1) { FTL_ITER_NS::advance(x, -n); return x; }

namespace ranges {
struct advance_fn {
    template<input_or_output_iterator I> constexpr void operator()(I& i, iter_difference_t<I> n) const { if constexpr (random_access_iterator<I>) i += n; else if constexpr (bidirectional_iterator<I>) { if (n >= 0) while (n--) ++i; else while (n++) --i; } else while (n-- > 0) ++i; }
    template<input_or_output_iterator I, sentinel_for<I> S> constexpr void operator()(I& i, S bound) const { if constexpr (assignable_from<I&, S>) i = FTL_ITER_NS::move(bound); else while (i != bound) ++i; }
    template<input_or_output_iterator I, sentinel_for<I> S> constexpr iter_difference_t<I> operator()(I& i, iter_difference_t<I> n, S bound) const { auto original = n; if constexpr (sized_sentinel_for<S, I>) { auto d = bound - i; if ((n >= 0 && n >= d) || (n < 0 && n <= d)) { (*this)(i, bound); return n - d; } } if (n >= 0) while (n && i != bound) { ++i; --n; } else if constexpr (bidirectional_iterator<I>) while (n && i != bound) { --i; ++n; } return n; }
}; inline constexpr advance_fn advance{};
struct distance_fn { template<class I, sentinel_for<I> S> constexpr iter_difference_t<I> operator()(I first, S last) const { if constexpr (sized_sentinel_for<S, I>) return last - first; else { iter_difference_t<I> n{}; while (first != last) { ++first; ++n; } return n; } } }; inline constexpr distance_fn distance{};
struct next_fn { template<input_or_output_iterator I> constexpr I operator()(I x) const { ++x; return x; } template<input_or_output_iterator I> constexpr I operator()(I x, iter_difference_t<I> n) const { advance(x,n); return x; } template<input_or_output_iterator I, sentinel_for<I> S> constexpr I operator()(I x,S s) const { advance(x,s); return x; } template<input_or_output_iterator I, sentinel_for<I> S> constexpr I operator()(I x,iter_difference_t<I> n,S s) const { advance(x,n,s); return x; } }; inline constexpr next_fn next{};
struct prev_fn { template<bidirectional_iterator I> constexpr I operator()(I x) const { --x; return x; } template<bidirectional_iterator I> constexpr I operator()(I x,iter_difference_t<I> n) const { advance(x,-n); return x; } template<bidirectional_iterator I> constexpr I operator()(I x,iter_difference_t<I> n,I bound) const { advance(x,-n,bound); return x; } }; inline constexpr prev_fn prev{};
}

template<class I> class reverse_iterator {
    I current{};
public:
    using iterator_type=I; using iterator_concept=conditional_t<random_access_iterator<I>,random_access_iterator_tag,bidirectional_iterator_tag>; using iterator_category=typename iterator_traits<I>::iterator_category; using value_type=iter_value_t<I>; using difference_type=iter_difference_t<I>; using pointer=I; using reference=iter_reference_t<I>;
    constexpr reverse_iterator()=default; constexpr explicit reverse_iterator(I i):current(i){} template<class U> constexpr reverse_iterator(const reverse_iterator<U>& x):current(x.base()){}
    constexpr I base() const{return current;} constexpr reference operator*() const { auto x=current; return *--x; } constexpr auto operator->() const { auto x=current; --x; if constexpr(is_pointer_v<I>) return x; else return x.operator->(); }
    constexpr reverse_iterator& operator++(){--current;return *this;} constexpr reverse_iterator operator++(int){auto x=*this;--current;return x;} constexpr reverse_iterator& operator--(){++current;return *this;} constexpr reverse_iterator operator--(int){auto x=*this;++current;return x;}
    constexpr reverse_iterator operator+(difference_type n)const{return reverse_iterator(current-n);} constexpr reverse_iterator& operator+=(difference_type n){current-=n;return *this;} constexpr reverse_iterator operator-(difference_type n)const{return reverse_iterator(current+n);} constexpr reverse_iterator& operator-=(difference_type n){current+=n;return *this;} constexpr reference operator[](difference_type n)const{return current[-n-1];}
};
