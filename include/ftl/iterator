namespace detail {

template <class Iterator, class = void>
struct move_iterator_category_base {};

template <class Iterator>
struct move_iterator_category_base<
    Iterator,
    void_t<
        typename iterator_traits<
            Iterator
        >::iterator_category
    >
> {
private:
  using underlying_category =
      typename iterator_traits<
          Iterator
      >::iterator_category;

public:
  using iterator_category =
      conditional_t<
          derived_from<
              underlying_category,
              random_access_iterator_tag
          >,
          random_access_iterator_tag,
          underlying_category
      >;
};

template <class Iterator>
using move_iterator_concept_t =
    conditional_t<
        random_access_iterator<Iterator>,
        random_access_iterator_tag,
        conditional_t<
            bidirectional_iterator<Iterator>,
            bidirectional_iterator_tag,
            conditional_t<
                forward_iterator<Iterator>,
                forward_iterator_tag,
                input_iterator_tag
            >
        >
    >;

} // namespace detail

template <class I>
class move_iterator
    : public detail::
          move_iterator_category_base<I> {
  I current{};

public:
  using iterator_type = I;
    using iterator_concept =
        detail::move_iterator_concept_t<I>;
  using value_type = iter_value_t<I>;
  using difference_type = iter_difference_t<I>;
  using pointer = I;
  using reference = iter_rvalue_reference_t<I>;

  constexpr move_iterator() = default;

  constexpr explicit move_iterator(I i) : current(move(i)) {}

  template <class U>
    requires convertible_to<const U &, I>
  constexpr move_iterator(const move_iterator<U> &x) : current(x.base()) {}

  template <class U>
    requires assignable_from<I &, const U &>
  constexpr move_iterator &operator=(const move_iterator<U> &x) {
    current = x.base();
    return *this;
  }

  constexpr const I &base() const & noexcept { return current; }

  constexpr I base() && { return move(current); }

  constexpr reference operator*() const { return ranges::iter_move(current); }

  constexpr auto operator->() const
    requires is_pointer_v<I> || requires(const I &i) { i.operator->(); }
  {
    return current;
  }

  constexpr move_iterator &operator++() {
    ++current;
    return *this;
  }

  constexpr auto operator++(int) {
    if constexpr (forward_iterator<I>) {
      auto x = *this;
      ++current;
      return x;
    } else
      ++current;
  }

  constexpr move_iterator &operator--()
    requires bidirectional_iterator<I>
  {
    --current;
    return *this;
  }

  constexpr move_iterator operator--(int)
    requires bidirectional_iterator<I>
  {
    auto x = *this;
    --current;
    return x;
  }

  constexpr move_iterator &operator+=(difference_type n)
    requires random_access_iterator<I>
  {
    current += n;
    return *this;
  }

  constexpr move_iterator &operator-=(difference_type n)
    requires random_access_iterator<I>
  {
    current -= n;
    return *this;
  }

  constexpr reference operator[](difference_type n) const
    requires random_access_iterator<I>
  {
    return ranges::iter_move(current + n);
  }

  template <class U>
  friend constexpr bool operator==(const move_iterator &a,
                                   const move_iterator<U> &b) {
    return a.current == b.base();
  }

    template <class U>
    friend constexpr auto
    operator<=>(
        const move_iterator& a,
        const move_iterator<U>& b
    )
    #ifdef FTL_REPLACE_STL
      requires three_way_comparable_with<I, U>
    #endif
    {
    #ifdef FTL_REPLACE_STL
      return a.current <=> b.base();
    #else
      return compare_three_way{}(
          a.current,
          b.base()
      );
    #endif
    }

  friend constexpr move_iterator operator+(move_iterator x, difference_type n)
    requires random_access_iterator<I>
  {
    x += n;
    return x;
  }

  friend constexpr move_iterator operator+(difference_type n, move_iterator x)
    requires random_access_iterator<I>
  {
    x += n;
    return x;
  }

  friend constexpr move_iterator operator-(move_iterator x, difference_type n)
    requires random_access_iterator<I>
  {
    x -= n;
    return x;
  }

  template <class U>
  friend constexpr auto operator-(const move_iterator &a,
                                  const move_iterator<U> &b)
      -> decltype(a.current - b.base()) {
    return a.current - b.base();
  }

  friend constexpr decltype(auto) iter_move(const move_iterator &i) noexcept(
      noexcept(ranges::iter_move(i.current))) {
    return ranges::iter_move(i.current);
  }

  template <class U>
  friend constexpr void
  iter_swap(const move_iterator &a, const move_iterator<U> &b) noexcept(
      noexcept(ranges::iter_swap(a.current, b.base()))) {
    ranges::iter_swap(a.current, b.base());
  }
};

template <class I> constexpr move_iterator<I> make_move_iterator(I i) {
  return move_iterator<I>(move(i));
}

template <class I, class J>
constexpr bool operator<(const move_iterator<I> &a, const move_iterator<J> &b) {
  return a.base() < b.base();
}

template <class I, class J>
constexpr bool operator>(const move_iterator<I> &a, const move_iterator<J> &b) {
  return b < a;
}

template <class I, class J>
constexpr bool operator<=(const move_iterator<I> &a,
                          const move_iterator<J> &b) {
  return !(b < a);
}

template <class I, class J>
constexpr bool operator>=(const move_iterator<I> &a,
                          const move_iterator<J> &b) {
  return !(a < b);
}

template <class I, class J>
  requires(!sized_sentinel_for<I, J>)
inline constexpr bool
    disable_sized_sentinel_for<move_iterator<I>, move_iterator<J>> = true;

template <class S>
  requires semiregular<S>
class move_sentinel {
  S last{};

public:
  constexpr move_sentinel() = default;

  constexpr explicit move_sentinel(S s) : last(move(s)) {}

  template <class U>
    requires convertible_to<const U &, S>
  constexpr move_sentinel(const move_sentinel<U> &x) : last(x.base()) {}

  template <class U>
    requires assignable_from<S &, const U &>
  constexpr move_sentinel &operator=(const move_sentinel<U> &x) {
    last = x.base();
    return *this;
  }

  constexpr S base() const { return last; }

  template <class I>
  friend constexpr bool operator==(const move_iterator<I> &i,
                                   const move_sentinel &s) {
    return i.base() == s.last;
  }

  template <class I>
  friend constexpr auto operator-(const move_sentinel &s,
                                  const move_iterator<I> &i)
      -> decltype(s.last - i.base()) {
    return s.last - i.base();
  }

  template <class I>
  friend constexpr auto operator-(const move_iterator<I> &i,
                                  const move_sentinel &s)
      -> decltype(i.base() - s.last) {
    return i.base() - s.last;
  }
};

template <input_or_output_iterator I, sentinel_for<I> S>
  requires(!same_as<I, S> && copyable<I>)
class common_iterator {
public:
  union {
    I iterator;
    S sentinel;
  };

  bool holds_iterator;

private:
  constexpr void destroy() {
    if (holds_iterator)
      iterator.~I();
    else
      sentinel.~S();
  }

public:
  constexpr common_iterator() : sentinel{}, holds_iterator(false) {}
  constexpr common_iterator(I i) : iterator(move(i)), holds_iterator(true) {}
  constexpr common_iterator(S s) : sentinel(move(s)), holds_iterator(false) {}

  constexpr common_iterator(const common_iterator &x)
      : holds_iterator(x.holds_iterator) {
    if (holds_iterator)
      ::new ((void *)__builtin_addressof(iterator)) I(x.iterator);
    else
      ::new ((void *)__builtin_addressof(sentinel)) S(x.sentinel);
  }

  constexpr common_iterator(common_iterator &&x)
      : holds_iterator(x.holds_iterator) {
    if (holds_iterator)
      ::new ((void *)__builtin_addressof(iterator)) I(move(x.iterator));
    else
      ::new ((void *)__builtin_addressof(sentinel)) S(move(x.sentinel));
  }

  constexpr ~common_iterator() { destroy(); }

  constexpr common_iterator &operator=(const common_iterator &x) {
    if (this == &x)
      return *this;
    if (holds_iterator == x.holds_iterator) {
      if (holds_iterator)
        iterator = x.iterator;
      else
        sentinel = x.sentinel;
    } else {
      destroy();
      holds_iterator = x.holds_iterator;
      if (holds_iterator)
        ::new ((void *)__builtin_addressof(iterator)) I(x.iterator);
      else
        ::new ((void *)__builtin_addressof(sentinel)) S(x.sentinel);
    }
    return *this;
  }

  constexpr decltype(auto) operator*() { return *iterator; }

  constexpr decltype(auto) operator*() const
    requires requires(const I &i) { *i; }
  {
    return *iterator;
  }

  constexpr auto operator->() const
    requires indirectly_readable<const I>
  {
    if constexpr (is_pointer_v<I>)
      return iterator;
    else if constexpr (requires { iterator.operator->(); })
      return iterator.operator->();
    else
      return __builtin_addressof(*iterator);
  }

  constexpr common_iterator &operator++() {
    ++iterator;
    return *this;
  }

  constexpr decltype(auto) operator++(int) {
    if constexpr (forward_iterator<I>) {
      auto x = *this;
      ++*this;
      return x;
    } else
      return iterator++;
  }

  template <class I2, class S2>
  friend constexpr bool operator==(const common_iterator &a,
                                   const common_iterator<I2, S2> &b) {
    if (a.holds_iterator && b.holds_iterator)
      return a.iterator == b.iterator;
    if (a.holds_iterator)
      return a.iterator == b.sentinel;
    if (b.holds_iterator)
      return a.sentinel == b.iterator;
    return true;
  }

  template <class I2, class S2>
  friend constexpr auto operator-(const common_iterator &a,
                                  const common_iterator<I2, S2> &b)
    requires sized_sentinel_for<S, I2> && sized_sentinel_for<S2, I>
  {
    if (a.holds_iterator && b.holds_iterator)
      return a.iterator - b.iterator;
    if (a.holds_iterator)
      return a.iterator - b.sentinel;
    if (b.holds_iterator)
      return a.sentinel - b.iterator;
    return iter_difference_t<I>{};
  }

  friend constexpr decltype(auto) iter_move(const common_iterator &i) noexcept(
      noexcept(ranges::iter_move(i.iterator))) {
    return ranges::iter_move(i.iterator);
  }

  template <class I2, class S2>
  friend constexpr void iter_swap(
      const common_iterator &a,
      const common_iterator<I2, S2>
          &b) noexcept(noexcept(ranges::iter_swap(a.iterator, b.iterator))) {
    ranges::iter_swap(a.iterator, b.iterator);
  }
};

template <class I, class S> struct incrementable_traits<common_iterator<I, S>> {
  using difference_type = iter_difference_t<I>;
};

