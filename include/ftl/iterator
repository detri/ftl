template <class Iterator>
consteval bool common_iterator_has_forward_category() {
  if constexpr (requires {
                  typename iterator_traits<Iterator>::iterator_category;
                }) {
    return derived_from<typename iterator_traits<Iterator>::iterator_category,
                        forward_iterator_tag>;
  } else {
    return false;
  }
}

