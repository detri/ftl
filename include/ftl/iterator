template<class T> struct indirectly_readable_traits<const T> : indirectly_readable_traits<T> {};
template<class T> requires requires { typename T::value_type; } &&
    (!requires { typename T::element_type; })
struct indirectly_readable_traits<T> { using value_type = typename T::value_type; };
template<class T> requires requires { typename T::element_type; } &&
    (!requires { typename T::value_type; })
struct indirectly_readable_traits<T> { using value_type = typename T::element_type; };
template<class T> requires requires { typename T::value_type; typename T::element_type; } &&
    same_as<remove_cv_t<typename T::value_type>, remove_cv_t<typename T::element_type>>
struct indirectly_readable_traits<T> { using value_type = typename T::value_type; };

template<class I> struct iterator_traits {};
template<class I> requires requires { typename I::iterator_category; typename I::value_type;
    typename I::difference_type; typename I::pointer; typename I::reference; }
struct iterator_traits<I> {
    using iterator_category = typename I::iterator_category;
    using value_type = typename I::value_type;
    using difference_type = typename I::difference_type;
    using pointer = typename I::pointer;
    using reference = typename I::reference;
    using iterator_concept = conditional_t<requires { typename I::iterator_concept; }, typename I::iterator_concept, iterator_category>;
};
template<class T> requires is_object_v<T>
struct iterator_traits<T*> {
    using iterator_concept = contiguous_iterator_tag;
    using iterator_category = random_access_iterator_tag;
    using value_type = remove_cv_t<T>;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using reference = T&;
};

template<class T> using iter_difference_t = typename conditional_t<
    requires { typename iterator_traits<remove_cvref_t<T>>::difference_type; },
    iterator_traits<remove_cvref_t<T>>, incrementable_traits<remove_cvref_t<T>>>::difference_type;
template<class T> using iter_value_t = typename conditional_t<
    requires { typename iterator_traits<remove_cvref_t<T>>::value_type; },
    iterator_traits<remove_cvref_t<T>>, indirectly_readable_traits<remove_cvref_t<T>>>::value_type;
template<class T> requires requires(T& t) { *t; }
using iter_reference_t = decltype(*declval<T&>());

namespace ranges {
struct less {
    using is_transparent = void;
    template<class T, class U> requires totally_ordered_with<T, U>
    constexpr bool operator()(T&& left, U&& right) const
        noexcept(noexcept(static_cast<T&&>(left) < static_cast<U&&>(right))) {
        return static_cast<T&&>(left) < static_cast<U&&>(right);
    }
};
namespace detail {
void iter_move();
void iter_swap();
template<class T> concept has_adl_iter_move = requires(T&& t) { iter_move(static_cast<T&&>(t)); };
template<class T, class U> concept has_adl_iter_swap = requires(T&& t, U&& u) { iter_swap(static_cast<T&&>(t), static_cast<U&&>(u)); };
}
struct iter_move_fn {
    template<class T> constexpr decltype(auto) operator()(T&& t) const
        noexcept(noexcept([](T&& x) -> decltype(auto) {
            if constexpr (detail::has_adl_iter_move<T>) return iter_move(static_cast<T&&>(x));
            else if constexpr (is_lvalue_reference_v<decltype(*x)>) return FTL_ITER_NS::move(*x);
            else return *x;
        }(static_cast<T&&>(t)))) {
        if constexpr (detail::has_adl_iter_move<T>) return iter_move(static_cast<T&&>(t));
        else if constexpr (is_lvalue_reference_v<decltype(*t)>) return FTL_ITER_NS::move(*t);
        else return *t;
    }
};
inline constexpr iter_move_fn iter_move{};
}
template<class T> using iter_rvalue_reference_t = decltype(ranges::iter_move(declval<T&>()));

template<class I> concept indirectly_readable = requires(const I i) {
    typename iter_value_t<I>; typename iter_reference_t<I>; typename iter_rvalue_reference_t<I>;
    requires common_reference_with<iter_reference_t<I>&&, iter_value_t<I>&>;
    requires common_reference_with<iter_reference_t<I>&&, iter_rvalue_reference_t<I>&&>;
    requires common_reference_with<iter_rvalue_reference_t<I>&&, const iter_value_t<I>&>;
};
template<indirectly_readable I> using iter_common_reference_t = common_reference_t<iter_reference_t<I>, iter_value_t<I>&>;
template<class O, class T> concept indirectly_writable = requires(O&& o, T&& t) {
    *o = static_cast<T&&>(t); *static_cast<O&&>(o) = static_cast<T&&>(t);
    const_cast<const iter_reference_t<O>&&>(*o) = static_cast<T&&>(t);
    const_cast<const iter_reference_t<O>&&>(*static_cast<O&&>(o)) = static_cast<T&&>(t);
};
template<class I> concept weakly_incrementable = movable<I> && requires(I i) {
    typename iter_difference_t<I>; requires signed_integral<iter_difference_t<I>>;
    { ++i } -> same_as<I&>; i++;
};
template<class I> concept incrementable = regular<I> && weakly_incrementable<I> && requires(I i) { { i++ } -> same_as<I>; };
template<class I> concept input_or_output_iterator = requires(I i) { *i; } && weakly_incrementable<I>;
template<class S, class I> concept sentinel_for = semiregular<S> && input_or_output_iterator<I> && equality_comparable_with<S, I>;
template<class S, class I> inline constexpr bool disable_sized_sentinel_for = false;
template<class S, class I> concept sized_sentinel_for = sentinel_for<S, I> &&
    !disable_sized_sentinel_for<remove_cv_t<S>, remove_cv_t<I>> && requires(const I& i, const S& s) {
        { s - i } -> same_as<iter_difference_t<I>>; { i - s } -> same_as<iter_difference_t<I>>;
    };
namespace detail {

template<class Iterator, class = void>
struct iter_concept {
    using type =
        typename iterator_traits<Iterator>::iterator_category;
};

template<class Iterator>
struct iter_concept<
    Iterator,
    void_t<
        typename iterator_traits<Iterator>::iterator_concept
    >
> {
    using type =
        typename iterator_traits<Iterator>::iterator_concept;
};

template<class Iterator>
using iter_concept_t =
    typename iter_concept<Iterator>::type;

} // namespace detail
template<class I> concept input_iterator = input_or_output_iterator<I> && indirectly_readable<I> &&
    derived_from<detail::iter_concept_t<I>, input_iterator_tag>;
template<class I, class T> concept output_iterator = input_or_output_iterator<I> && indirectly_writable<I, T> && requires(I i, T&& t) { *i++ = static_cast<T&&>(t); };
template<class I> concept forward_iterator = input_iterator<I> && derived_from<detail::iter_concept_t<I>, forward_iterator_tag> && incrementable<I> && sentinel_for<I, I>;
template<class I> concept bidirectional_iterator = forward_iterator<I> && derived_from<detail::iter_concept_t<I>, bidirectional_iterator_tag> && requires(I i) { { --i } -> same_as<I&>; { i-- } -> same_as<I>; };
template<class I> concept random_access_iterator = bidirectional_iterator<I> && derived_from<detail::iter_concept_t<I>, random_access_iterator_tag> && totally_ordered<I> && sized_sentinel_for<I, I> && requires(I i, const I j, const iter_difference_t<I> n) {
    { i += n } -> same_as<I&>; { j + n } -> same_as<I>; { n + j } -> same_as<I>;
    { i -= n } -> same_as<I&>; { j - n } -> same_as<I>; { j[n] } -> same_as<iter_reference_t<I>>;
};
template<class I> concept contiguous_iterator = random_access_iterator<I> && derived_from<detail::iter_concept_t<I>, contiguous_iterator_tag> && is_lvalue_reference_v<iter_reference_t<I>> && same_as<iter_value_t<I>, remove_cvref_t<iter_reference_t<I>>> && requires(const I& i) { { __builtin_addressof(*i) } -> same_as<add_pointer_t<iter_reference_t<I>>>; };

namespace ranges {
struct iter_swap_fn {
    template<class T, class U> constexpr void operator()(T&& a, U&& b) const
        noexcept(noexcept([](T&& x, U&& y) {
            if constexpr (detail::has_adl_iter_swap<T, U>) iter_swap(static_cast<T&&>(x), static_cast<U&&>(y));
            else { auto old = ranges::iter_move(x); *x = ranges::iter_move(y); *y = FTL_ITER_NS::move(old); }
        }(static_cast<T&&>(a), static_cast<U&&>(b)))) {
        if constexpr (detail::has_adl_iter_swap<T, U>) iter_swap(static_cast<T&&>(a), static_cast<U&&>(b));
        else { auto old = ranges::iter_move(a); *a = ranges::iter_move(b); *b = FTL_ITER_NS::move(old); }
    }
};
inline constexpr iter_swap_fn iter_swap{};
}

template<class F, class I> concept indirectly_unary_invocable = indirectly_readable<I> && copy_constructible<F> && invocable<F&, iter_value_t<I>&> && invocable<F&, iter_reference_t<I>> && invocable<F&, iter_common_reference_t<I>> && common_reference_with<invoke_result_t<F&, iter_value_t<I>&>, invoke_result_t<F&, iter_reference_t<I>>>;
