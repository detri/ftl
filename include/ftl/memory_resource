namespace pmr {

class memory_resource {
public:
    virtual ~memory_resource() = default;
    [[nodiscard]] void* allocate(size_t bytes,
        size_t alignment = alignof(max_align_t)) {
        return do_allocate(bytes, alignment);
    }
    void deallocate(void* p, size_t bytes,
        size_t alignment = alignof(max_align_t)) {
        do_deallocate(p, bytes, alignment);
    }
    bool is_equal(const memory_resource& other) const noexcept {
        return do_is_equal(other);
    }
private:
    virtual void* do_allocate(size_t, size_t) = 0;
    virtual void do_deallocate(void*, size_t, size_t) = 0;
    virtual bool do_is_equal(const memory_resource&) const noexcept = 0;
};

inline bool operator==(const memory_resource& a,
                       const memory_resource& b) noexcept {
    return &a == &b || a.is_equal(b);
}

namespace detail {
class new_delete_memory_resource final : public memory_resource {
private:
  void *do_allocate(size_t bytes, size_t alignment) override {
    if (alignment <= alignof(max_align_t))
      return ::operator new(bytes);

    if (alignment == 0 || (alignment & (alignment - 1)) != 0) {
#if FTL_HAS_EXCEPTIONS
      throw bad_alloc{};
#else
      terminate();
#endif
    }

    constexpr size_t header_size = sizeof(void *);

    if (bytes > size_t(-1) - header_size ||
        bytes + header_size > size_t(-1) - (alignment - 1)) {
#if FTL_HAS_EXCEPTIONS
      throw bad_alloc{};
#else
      terminate();
#endif
    }

    const size_t total = bytes + header_size + alignment - 1;
    void *base = ::operator new(total);

    const auto begin =
        reinterpret_cast<uintptr_t>(base) + header_size;
    const auto aligned =
        (begin + alignment - 1) & ~(uintptr_t(alignment) - 1);

    auto *result = reinterpret_cast<void *>(aligned);
    reinterpret_cast<void **>(result)[-1] = base;

    return result;
  }

  void do_deallocate(void *pointer, size_t, size_t alignment) override {
    if (!pointer)
      return;

    if (alignment <= alignof(max_align_t)) {
      ::operator delete(pointer);
      return;
    }

    void *base = reinterpret_cast<void **>(pointer)[-1];
    ::operator delete(base);
  }

  bool do_is_equal(const memory_resource &other) const noexcept override {
    return this == &other;
  }
};
class null_memory_resource_impl final : public memory_resource {
    void* do_allocate(size_t, size_t) override {
#if FTL_HAS_EXCEPTIONS
        throw bad_alloc{};
#else
        terminate();
#endif
    }
    void do_deallocate(void*, size_t, size_t) override {}
    bool do_is_equal(const memory_resource& other) const noexcept override {
        return this == &other;
    }
};
}

inline memory_resource* new_delete_resource() noexcept {
    static detail::new_delete_memory_resource value;
    return &value;
}
inline memory_resource* null_memory_resource() noexcept {
    static detail::null_memory_resource_impl value;
    return &value;
}
inline atomic<uintptr_t>& default_resource_bits() noexcept {
    static atomic<uintptr_t> value{
        reinterpret_cast<uintptr_t>(new_delete_resource())};
    return value;
}
inline memory_resource* set_default_resource(memory_resource* resource) noexcept {
    if (!resource) resource = new_delete_resource();
    return reinterpret_cast<memory_resource*>(default_resource_bits().exchange(
        reinterpret_cast<uintptr_t>(resource), memory_order_acq_rel));
}
inline memory_resource* get_default_resource() noexcept {
    return reinterpret_cast<memory_resource*>(
        default_resource_bits().load(memory_order_acquire));
}

template<class T = byte>
class polymorphic_allocator {
    memory_resource* resource_value;
public:
    using value_type = T;
    polymorphic_allocator() noexcept : resource_value(get_default_resource()) {}
    polymorphic_allocator(memory_resource* resource) noexcept
        : resource_value(resource) {}
    polymorphic_allocator(const polymorphic_allocator&) = default;
    template<class U>
    polymorphic_allocator(const polymorphic_allocator<U>& other) noexcept
        : resource_value(other.resource()) {}
    polymorphic_allocator& operator=(const polymorphic_allocator&) = delete;

    [[nodiscard]] T* allocate(size_t count) {
        if (count > size_t(-1) / sizeof(T))
#if FTL_HAS_EXCEPTIONS
          throw bad_array_new_length{};
#else
          terminate();
#endif
        return static_cast<T*>(resource_value->allocate(count * sizeof(T), alignof(T)));
    }
    void deallocate(T* p, size_t count) {
        resource_value->deallocate(p, count * sizeof(T), alignof(T));
    }
    [[nodiscard]] void* allocate_bytes(size_t bytes,
        size_t alignment = alignof(max_align_t)) {
        return resource_value->allocate(bytes, alignment);
    }
    void deallocate_bytes(void* p, size_t bytes,
        size_t alignment = alignof(max_align_t)) {
        resource_value->deallocate(p, bytes, alignment);
    }
    template<class U> [[nodiscard]] U* allocate_object(size_t count = 1) {
        if (count > size_t(-1) / sizeof(U))
#if FTL_HAS_EXCEPTIONS
          throw bad_array_new_length{};
#else
          terminate();
#endif
        return static_cast<U*>(allocate_bytes(count * sizeof(U), alignof(U)));
    }
    template<class U> void deallocate_object(U* p, size_t count = 1) {
        deallocate_bytes(p, count * sizeof(U), alignof(U));
    }
    template<class U, class... Args> [[nodiscard]] U* new_object(Args&&... args) {
        U* p = allocate_object<U>();
#if FTL_HAS_EXCEPTIONS
        try { construct(p, forward<Args>(args)...); }
        catch (...) { deallocate_object(p); throw; }
#else
        construct(p, forward<Args>(args)...);
#endif
        return p;
    }
    template<class U> void delete_object(U* p) {
        destroy_at(p); deallocate_object(p);
    }
    template<class U, class... Args> void construct(U* p, Args&&... args) {
        uninitialized_construct_using_allocator(p, *this,
            forward<Args>(args)...);
    }
    template<class U> void destroy(U* p) { destroy_at(p); }
    polymorphic_allocator select_on_container_copy_construction() const {
        return {};
    }
    memory_resource* resource() const { return resource_value; }
};

template<class T1, class T2>
bool operator==(const polymorphic_allocator<T1>& a,
                const polymorphic_allocator<T2>& b) noexcept {
    return *a.resource() == *b.resource();
}

struct pool_options {
    size_t max_blocks_per_chunk = 0;
    size_t largest_required_pool_block = 0;
};

namespace detail {

constexpr size_t checked_add(size_t left, size_t right) {
  if (right > size_t(-1) - left) {
#if FTL_HAS_EXCEPTIONS
    throw bad_alloc{};
#else
    terminate();
#endif
  }

  return left + right;
}

constexpr size_t checked_mul(size_t left, size_t right) {
  if (left != 0 && right > size_t(-1) / left) {
#if FTL_HAS_EXCEPTIONS
    throw bad_alloc{};
#else
    terminate();
#endif
  }

  return left * right;
}

constexpr size_t round_up(size_t value, size_t alignment) {
  const size_t remainder = value % alignment;
  return remainder == 0 ? value : checked_add(value, alignment - remainder);
}

struct chunk {
  chunk *next{};
  void *memory{};
  size_t bytes{};
  size_t alignment{};
};

struct free_block {
  free_block *next{};
};

struct pool_class {
  pool_class *next{};
  chunk *chunks{};
  free_block *free{};
  size_t requested_size{};
  size_t requested_alignment{};
  size_t block_alignment{};
  size_t stride{};
  size_t next_blocks{1};
};

struct oversized_block {
  oversized_block *next{};
  void *memory{};
  size_t bytes{};
  size_t alignment{};
};

class pool_storage {
public:
  pool_storage(const pool_options &requested, memory_resource *upstream)
      : upstream_(upstream ? upstream : get_default_resource()) {
    options_.max_blocks_per_chunk =
        requested.max_blocks_per_chunk != 0 ? requested.max_blocks_per_chunk
                                            : 64;
    options_.largest_required_pool_block =
        requested.largest_required_pool_block != 0
            ? requested.largest_required_pool_block
            : 1024;
  }

  ~pool_storage() { release(); }

  pool_storage(const pool_storage &) = delete;
  pool_storage &operator=(const pool_storage &) = delete;

  void release() noexcept {
    while (oversized_) {
      oversized_block *record = oversized_;
      oversized_ = record->next;

      upstream_->deallocate(record->memory, record->bytes, record->alignment);
      record->~oversized_block();
      upstream_->deallocate(record, sizeof(oversized_block),
                            alignof(oversized_block));
    }

    while (classes_) {
      pool_class *pool = classes_;
      classes_ = pool->next;

      while (pool->chunks) {
        chunk *current = pool->chunks;
        pool->chunks = current->next;

        upstream_->deallocate(current->memory, current->bytes,
                              current->alignment);

        current->~chunk();
        upstream_->deallocate(current, sizeof(chunk), alignof(chunk));
      }

      pool->~pool_class();
      upstream_->deallocate(pool, sizeof(pool_class), alignof(pool_class));
    }
  }

  [[nodiscard]] void *allocate(size_t bytes, size_t alignment) {
    if (bytes > options_.largest_required_pool_block)
      return allocate_oversized(bytes, alignment);

    pool_class &pool = get_pool(bytes, alignment);

    if (!pool.free)
      replenish(pool);

    free_block *result = pool.free;
    pool.free = result->next;
    return result;
  }

  void deallocate(void *pointer, size_t bytes, size_t alignment) noexcept {
    if (!pointer)
      return;

    if (bytes > options_.largest_required_pool_block) {
      oversized_block **link = &oversized_;

      while (*link && (*link)->memory != pointer)
        link = &(*link)->next;

      // Supplying a pointer/size/alignment tuple that does not correspond to
      // an allocation from this resource violates memory_resource's
      // deallocation precondition.
      if (!*link)
        return;

      oversized_block *record = *link;
      *link = record->next;

      upstream_->deallocate(record->memory, record->bytes, record->alignment);
      record->~oversized_block();
      upstream_->deallocate(record, sizeof(oversized_block),
                            alignof(oversized_block));
      return;
    }

    pool_class *pool = find_pool(bytes, alignment);

    // Mismatched deallocation arguments violate the caller's precondition.
    if (!pool)
      return;

    auto *node = static_cast<free_block *>(pointer);
    node->next = pool->free;
    pool->free = node;
  }

  [[nodiscard]] memory_resource *upstream() const noexcept { return upstream_; }

  [[nodiscard]] pool_options options() const noexcept { return options_; }

private:
  [[nodiscard]] pool_class *find_pool(size_t bytes,
                                      size_t alignment) noexcept {
    for (pool_class *pool = classes_; pool; pool = pool->next) {
      if (pool->requested_size == bytes &&
          pool->requested_alignment == alignment)
        return pool;
    }

    return nullptr;
  }

  pool_class &get_pool(size_t bytes, size_t alignment) {
    if (pool_class *pool = find_pool(bytes, alignment))
      return *pool;

    void *storage =
        upstream_->allocate(sizeof(pool_class), alignof(pool_class));

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      const size_t block_alignment =
          alignment < alignof(free_block) ? alignof(free_block) : alignment;
      const size_t block_size =
          bytes < sizeof(free_block) ? sizeof(free_block) : bytes;
      const size_t stride = round_up(block_size, block_alignment);

      auto *pool = ::new (storage) pool_class{
          classes_, nullptr, nullptr, bytes, alignment, block_alignment,
          stride,   1,
      };

      classes_ = pool;
      return *pool;

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      upstream_->deallocate(storage, sizeof(pool_class), alignof(pool_class));
      throw;
    }
#endif
  }

  void replenish(pool_class &pool) {
    size_t count = pool.next_blocks;

    if (count > options_.max_blocks_per_chunk)
      count = options_.max_blocks_per_chunk;

    if (count == 0)
      count = 1;

    const size_t bytes = checked_mul(pool.stride, count);
    void *memory = upstream_->allocate(bytes, pool.block_alignment);
    void *chunk_storage = nullptr;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      chunk_storage = upstream_->allocate(sizeof(chunk), alignof(chunk));

      auto *record = ::new (chunk_storage) chunk{
          pool.chunks,
          memory,
          bytes,
          pool.block_alignment,
      };

      pool.chunks = record;
      auto *base = static_cast<unsigned char *>(memory);

      for (size_t index = 0; index < count; ++index) {
        auto *node =
            reinterpret_cast<free_block *>(base + index * pool.stride);
        node->next = pool.free;
        pool.free = node;
      }

      if (pool.next_blocks < options_.max_blocks_per_chunk) {
        pool.next_blocks =
            pool.next_blocks > options_.max_blocks_per_chunk / 2
                ? options_.max_blocks_per_chunk
                : pool.next_blocks * 2;

        if (pool.next_blocks == 0)
          pool.next_blocks = 1;
      }

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      if (chunk_storage)
        upstream_->deallocate(chunk_storage, sizeof(chunk), alignof(chunk));

      upstream_->deallocate(memory, bytes, pool.block_alignment);
      throw;
    }
#endif
  }

  [[nodiscard]] void *allocate_oversized(size_t bytes, size_t alignment) {
    void *memory = upstream_->allocate(bytes, alignment);
    void *record_storage = nullptr;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      record_storage =
          upstream_->allocate(sizeof(oversized_block), alignof(oversized_block));

      oversized_ = ::new (record_storage) oversized_block{
          oversized_,
          memory,
          bytes,
          alignment,
      };

      return memory;

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      if (record_storage)
        upstream_->deallocate(record_storage, sizeof(oversized_block),
                              alignof(oversized_block));

      upstream_->deallocate(memory, bytes, alignment);
      throw;
    }
#endif
  }

  memory_resource *upstream_;
  pool_options options_{};
  pool_class *classes_{};
  oversized_block *oversized_{};
};

} // namespace detail

class unsynchronized_pool_resource : public memory_resource {
public:
  unsynchronized_pool_resource()
      : unsynchronized_pool_resource(pool_options{}, get_default_resource()) {}

  explicit unsynchronized_pool_resource(memory_resource *upstream)
      : unsynchronized_pool_resource(pool_options{}, upstream) {}

  explicit unsynchronized_pool_resource(const pool_options &options)
      : unsynchronized_pool_resource(options, get_default_resource()) {}

  unsynchronized_pool_resource(const pool_options &options,
                               memory_resource *upstream)
      : storage_(options, upstream) {}

  ~unsynchronized_pool_resource() override = default;

  void release() { storage_.release(); }

  memory_resource *upstream_resource() const { return storage_.upstream(); }

  pool_options options() const { return storage_.options(); }

private:
  void *do_allocate(size_t bytes, size_t alignment) override {
    return storage_.allocate(bytes, alignment);
  }

  void do_deallocate(void *pointer, size_t bytes, size_t alignment) override {
    storage_.deallocate(pointer, bytes, alignment);
  }

  bool do_is_equal(const memory_resource &other) const noexcept override {
    return this == &other;
  }

  detail::pool_storage storage_;
};

class synchronized_pool_resource : public memory_resource {
public:
  synchronized_pool_resource()
      : synchronized_pool_resource(pool_options{}, get_default_resource()) {}

  explicit synchronized_pool_resource(memory_resource *upstream)
      : synchronized_pool_resource(pool_options{}, upstream) {}

  explicit synchronized_pool_resource(const pool_options &options)
      : synchronized_pool_resource(options, get_default_resource()) {}

  synchronized_pool_resource(const pool_options &options,
                             memory_resource *upstream)
      : storage_(options, upstream) {}

  ~synchronized_pool_resource() override = default;

  void release() {
    guard lock{locked_};
    storage_.release();
  }

  memory_resource *upstream_resource() const { return storage_.upstream(); }

  pool_options options() const { return storage_.options(); }

private:
  struct guard {
    explicit guard(atomic<bool> &value) : value_(value) {
      while (value_.exchange(true, memory_order_acquire))
        value_.wait(true, memory_order_relaxed);
    }

    ~guard() {
      value_.store(false, memory_order_release);
      value_.notify_one();
    }

    atomic<bool> &value_;
  };

  void *do_allocate(size_t bytes, size_t alignment) override {
    guard lock{locked_};
    return storage_.allocate(bytes, alignment);
  }

  void do_deallocate(void *pointer, size_t bytes, size_t alignment) override {
    guard lock{locked_};
    storage_.deallocate(pointer, bytes, alignment);
  }

  bool do_is_equal(const memory_resource &other) const noexcept override {
    return this == &other;
  }

  detail::pool_storage storage_;
  atomic<bool> locked_{false};
};

class monotonic_buffer_resource : public memory_resource {
public:
  monotonic_buffer_resource()
      : monotonic_buffer_resource(get_default_resource()) {}

  explicit monotonic_buffer_resource(memory_resource *upstream)
      : upstream_(upstream ? upstream : get_default_resource()) {}

  explicit monotonic_buffer_resource(
      size_t initial_size,
      memory_resource *upstream = get_default_resource())
      : upstream_(upstream ? upstream : get_default_resource()),
        next_buffer_size_(initial_size == 0 ? 1 : initial_size) {}

  monotonic_buffer_resource(void *buffer, size_t size,
                            memory_resource *upstream = get_default_resource())
      : upstream_(upstream ? upstream : get_default_resource()),
        initial_(static_cast<unsigned char *>(buffer)), initial_size_(size),
        current_(initial_), available_(size),
        next_buffer_size_(size == 0 ? 1 : size) {}

  ~monotonic_buffer_resource() override { release(); }

  void release() {
    while (blocks_) {
      block *current = blocks_;
      blocks_ = current->next;

      upstream_->deallocate(current->memory, current->bytes,
                            current->alignment);

      current->~block();
      upstream_->deallocate(current, sizeof(block), alignof(block));
    }

    current_ = initial_;
    available_ = initial_size_;
    next_buffer_size_ = initial_size_ == 0 ? 1 : initial_size_;
  }

  memory_resource *upstream_resource() const { return upstream_; }

private:
  struct block {
    block *next;
    void *memory;
    size_t bytes;
    size_t alignment;
  };

  void acquire_buffer(size_t bytes, size_t alignment) {
    const size_t required = detail::checked_add(bytes, alignment - 1);
    const size_t buffer_size =
        next_buffer_size_ < required ? required : next_buffer_size_;

    void *memory = upstream_->allocate(buffer_size, alignment);
    void *block_storage = nullptr;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      block_storage = upstream_->allocate(sizeof(block), alignof(block));

      blocks_ = ::new (block_storage) block{
          blocks_,
          memory,
          buffer_size,
          alignment,
      };

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      if (block_storage)
        upstream_->deallocate(block_storage, sizeof(block), alignof(block));

      upstream_->deallocate(memory, buffer_size, alignment);
      throw;
    }
#endif

    current_ = static_cast<unsigned char *>(memory);
    available_ = buffer_size;

    size_t next =
        next_buffer_size_ > size_t(-1) / 2 ? size_t(-1)
                                           : next_buffer_size_ * 2;
    if (next < buffer_size)
      next = buffer_size;
    next_buffer_size_ = next;
  }

  void *do_allocate(size_t bytes, size_t alignment) override {
    void *candidate = current_;
    size_t space = available_;

    if (candidate &&
        FTL_MEMORY_RESOURCE_NAMESPACE::align(alignment, bytes, candidate,
                                             space)) {
      auto *result = static_cast<unsigned char *>(candidate);
      const size_t consumed =
          static_cast<size_t>(result - current_) + bytes;

      current_ += consumed;
      available_ -= consumed;
      return result;
    }

    acquire_buffer(bytes, alignment);

    candidate = current_;
    space = available_;

    if (!FTL_MEMORY_RESOURCE_NAMESPACE::align(alignment, bytes, candidate,
                                              space))
      terminate();

    auto *result = static_cast<unsigned char *>(candidate);
    const size_t consumed = static_cast<size_t>(result - current_) + bytes;

    current_ += consumed;
    available_ -= consumed;
    return result;
  }

  void do_deallocate(void *, size_t, size_t) override {}

  bool do_is_equal(const memory_resource &other) const noexcept override {
    return this == &other;
  }

  memory_resource *upstream_;
  block *blocks_{};

  unsigned char *initial_{};
  size_t initial_size_{};

  unsigned char *current_{};
  size_t available_{};

  size_t next_buffer_size_{1};
};

