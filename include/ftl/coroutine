FTL_BEGIN_NAMESPACE

namespace detail {

template<class Return, class = void>
struct coroutine_traits_base {};

template<class Return>
struct coroutine_traits_base<
    Return,
    void_t<typename Return::promise_type>
> {
    using promise_type = typename Return::promise_type;
};

} // namespace detail

template<class Return, class... ArgumentTypes>
struct coroutine_traits
    : detail::coroutine_traits_base<Return> {};

template<class Promise = void>
struct coroutine_handle;

template<>
struct coroutine_handle<void> {
    constexpr coroutine_handle() noexcept = default;
    constexpr coroutine_handle(nullptr_t) noexcept {}

    constexpr coroutine_handle&
    operator=(nullptr_t) noexcept {
        pointer = nullptr;
        return *this;
    }

    [[nodiscard]]
    constexpr void* address() const noexcept {
        return pointer;
    }

    [[nodiscard]]
    static constexpr coroutine_handle
    from_address(void* value) noexcept {
        coroutine_handle result;
        result.pointer = value;
        return result;
    }

    constexpr explicit operator bool() const noexcept {
        return pointer != nullptr;
    }

    [[nodiscard]]
    bool done() const noexcept {
        return __builtin_coro_done(pointer);
    }

    void operator()() const {
        __builtin_coro_resume(pointer);
    }

    void resume() const {
        __builtin_coro_resume(pointer);
    }

    void destroy() const noexcept {
        __builtin_coro_destroy(pointer);
    }

private:
    void* pointer = nullptr;
};

template<class Promise>
struct coroutine_handle {
    constexpr coroutine_handle() noexcept = default;
    constexpr coroutine_handle(nullptr_t) noexcept {}

    [[nodiscard]]
    static coroutine_handle
    from_promise(Promise& promise_value) noexcept {
        const auto promise_pointer = const_cast<void*>(
            static_cast<const volatile void*>(
                addressof(promise_value)
            )
        );

        coroutine_handle result;
        result.pointer = __builtin_coro_promise(
            promise_pointer,
            0,
            true
        );
        return result;
    }

    constexpr coroutine_handle&
    operator=(nullptr_t) noexcept {
        pointer = nullptr;
        return *this;
    }

    [[nodiscard]]
    constexpr void* address() const noexcept {
        return pointer;
    }

    [[nodiscard]]
    static constexpr coroutine_handle
    from_address(void* value) noexcept {
        coroutine_handle result;
        result.pointer = value;
        return result;
    }

    constexpr operator coroutine_handle<>() const noexcept {
        return coroutine_handle<>::from_address(pointer);
    }

    constexpr explicit operator bool() const noexcept {
        return pointer != nullptr;
    }

    [[nodiscard]]
    bool done() const noexcept {
        return __builtin_coro_done(pointer);
    }

    void operator()() const {
        __builtin_coro_resume(pointer);
    }

    void resume() const {
        __builtin_coro_resume(pointer);
    }

    void destroy() const noexcept {
        __builtin_coro_destroy(pointer);
    }

    [[nodiscard]]
    Promise& promise() const noexcept {
        return *reinterpret_cast<Promise*>(
            __builtin_coro_promise(
                pointer,
                0,
                false
            )
        );
    }

private:
    void* pointer = nullptr;
};

[[nodiscard]]
constexpr bool operator==(
    coroutine_handle<> left,
    coroutine_handle<> right
) noexcept {
    return left.address() == right.address();
}

[[nodiscard]]
constexpr strong_ordering operator<=>(
    coroutine_handle<> left,
    coroutine_handle<> right
) noexcept {
    return compare_three_way{}(
        left.address(),
        right.address()
    );
}

template<class Promise>
struct hash<coroutine_handle<Promise>> {
    [[nodiscard]]
    size_t operator()(
        coroutine_handle<Promise> value
    ) const noexcept {
        return hash<void*>{}(value.address());
    }
};

struct noop_coroutine_promise {};

template<>
struct coroutine_handle<noop_coroutine_promise> {
    friend coroutine_handle noop_coroutine() noexcept;

    constexpr operator coroutine_handle<>() const noexcept {
        return coroutine_handle<>::from_address(pointer);
    }

    constexpr explicit operator bool() const noexcept {
        return true;
    }

    [[nodiscard]]
    constexpr bool done() const noexcept {
        return false;
    }

    constexpr void operator()() const noexcept {}

    constexpr void resume() const noexcept {}

    constexpr void destroy() const noexcept {}

    [[nodiscard]]
    noop_coroutine_promise& promise() const noexcept {
        return *static_cast<noop_coroutine_promise*>(
            __builtin_coro_promise(
                pointer,
                0,
                false
            )
        );
    }

    [[nodiscard]]
    constexpr void* address() const noexcept {
        return pointer;
    }

private:
    coroutine_handle() noexcept = default;

    void* pointer = __builtin_coro_noop();
};

using noop_coroutine_handle =
    coroutine_handle<noop_coroutine_promise>;

[[nodiscard]]
inline noop_coroutine_handle noop_coroutine() noexcept {
    return noop_coroutine_handle{};
}

struct suspend_never {
    [[nodiscard]]
    constexpr bool await_ready() const noexcept {
        return true;
    }

    constexpr void
    await_suspend(coroutine_handle<>) const noexcept {}

    constexpr void await_resume() const noexcept {}
};

struct suspend_always {
    [[nodiscard]]
    constexpr bool await_ready() const noexcept {
        return false;
    }

    constexpr void
    await_suspend(coroutine_handle<>) const noexcept {}

    constexpr void await_resume() const noexcept {}
};

FTL_END_NAMESPACE

#endif // FTL_COROUTINE_HEADER