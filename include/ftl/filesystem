template <class Char, class Traits>
basic_ostream<Char, Traits> &operator<<(basic_ostream<Char, Traits> &os,
                                        const path &p) {
  os.put(Char('"'));
  for (Char character : p.template string<Char, Traits>()) {
    if (character == Char('"') || character == Char('\\'))
      os.put(Char('\\'));
    os.put(character);
  }
  return os.put(Char('"'));
}
template <class Char, class Traits>
basic_istream<Char, Traits> &operator>>(basic_istream<Char, Traits> &is,
                                        path &p) {
  basic_string<Char, Traits> s;
  Char c;
  if (!(is >> c))
    return is;
  if (c == Char('"')) {
    bool escaped = false;
    while (is.get(c)) {
      if (!escaped && c == Char('"'))
        break;
      if (!escaped && c == Char('\\')) {
        escaped = true;
        continue;
      }
      s += c;
      escaped = false;
    }
  } else {
    s += c;
    while (is.get(c) && !Traits::eq(c, Char(' ')))
      s += c;
  }
  p = path(s);
  return is;
}
template <class Char, class Traits>
basic_ostream<Char, Traits> &operator<<(basic_ostream<Char, Traits> &os,
                                        const directory_entry &entry) {
  return os << entry.path();
}
