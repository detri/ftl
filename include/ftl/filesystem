inline void copy(const path &a, const path &b, copy_options o, error_code &ec) {
  bool inspect_link =
      (o & (copy_options::create_symlinks | copy_options::skip_symlinks |
            copy_options::copy_symlinks)) != copy_options{};
  auto source = inspect_link ? symlink_status(a, ec) : status(a, ec);
  if (ec)
    return;
  if (!exists(source)) {
    ec = make_error_code(errc::no_such_file_or_directory);
    return;
  }
  auto target = status(b, ec);
  if (ec)
    return;
  if (exists(target) && equivalent(a, b, ec)) {
    if (!ec)
      ec = make_error_code(errc::file_exists);
    return;
  }
  if (is_other(source) || is_other(target) ||
      (is_directory(source) && is_regular_file(target))) {
    ec = make_error_code(errc::invalid_argument);
    return;
  }
  if (is_symlink(source)) {
    if ((o & copy_options::skip_symlinks) != copy_options{}) {
      ec.clear();
      return;
    }
    if ((o & copy_options::copy_symlinks) != copy_options{} &&
        !exists(target)) {
      copy_symlink(a, b, ec);
      return;
    }
    ec = make_error_code(errc::invalid_argument);
    return;
  }
  if (is_regular_file(source)) {
    if ((o & copy_options::directories_only) != copy_options{}) {
      ec.clear();
      return;
