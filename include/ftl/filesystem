class recursive_directory_iterator {
public:
  using iterator_category = input_iterator_tag;
  using value_type = directory_entry;
  using difference_type = ptrdiff_t;
  using pointer = const directory_entry *;
  using reference = const directory_entry &;

  recursive_directory_iterator() noexcept = default;
  explicit recursive_directory_iterator(const path &p) {
    error_code ec;
    open(p, directory_options::none, ec);
    if (ec)
      detail_fs::fail("recursive_directory_iterator", p, ec);
  }
  recursive_directory_iterator(const path &p, directory_options options) {
    error_code ec;
    open(p, options, ec);
    if (ec)
      detail_fs::fail("recursive_directory_iterator", p, ec);
  }
  recursive_directory_iterator(const path &p, error_code &ec) {
    open(p, directory_options::none, ec);
  }
  recursive_directory_iterator(const path &p, directory_options options,
                               error_code &ec) {
    open(p, options, ec);
  }

  directory_options options() const { return state_->options; }
  int depth() const { return static_cast<int>(state_->stack.size() - 1); }
  bool recursion_pending() const { return state_->pending; }
  reference operator*() const { return state_->current; }
  pointer operator->() const { return &state_->current; }

  recursive_directory_iterator &operator++() {
    error_code ec;
    increment(ec);
    if (ec)
      detail_fs::fail("recursive_directory_iterator::increment", {}, ec);
    return *this;
  }
  recursive_directory_iterator operator++(int) {
    auto copy = *this;
    if (state_)
      copy.state_ = make_shared<traversal_state>(*state_);
    ++*this;
    return copy;
  }
  recursive_directory_iterator &increment(error_code &ec) {
    ec.clear();
    if (!state_)
      return *this;
    if (state_->pending && may_descend(ec)) {
      directory_iterator child(state_->current.path(), state_->options, ec);
      if (!ec && child != directory_iterator()) {
        state_->stack.push_back(child);
        state_->current = *child;
        state_->pending = true;
        return *this;
      }
      if (ec && (state_->options & directory_options::skip_permission_denied) !=
                    directory_options{})
        ec.clear();
      if (ec)
        return *this;
    }
    advance(ec);
    return *this;
  }
  void pop() {
    error_code ec;
    pop(ec);
    if (ec)
      detail_fs::fail("recursive_directory_iterator::pop", {}, ec);
  }
  void pop(error_code &ec) {
    ec.clear();
    if (!state_)
      return;
    if (state_->stack.size() == 1) {
      state_.reset();
      return;
    }
    state_->stack.pop_back();
    advance(ec);
  }
  void disable_recursion_pending() { state_->pending = false; }

  friend bool operator==(const recursive_directory_iterator &left,
                         const recursive_directory_iterator &right) {
    return (!left.state_ && !right.state_) || left.state_ == right.state_;
  }
  bool operator==(default_sentinel_t) const noexcept { return !state_; }

private:
  struct traversal_state {
    vector<directory_iterator> stack;
    directory_entry current;
    directory_options options = directory_options::none;
    bool pending = true;
  };
  shared_ptr<traversal_state> state_;

  void open(const path &p, directory_options options, error_code &ec) {
    try {
      directory_iterator first(p, options, ec);
      if (ec || first == directory_iterator())
        return;
      state_ = make_shared<traversal_state>();
      state_->options = options;
      state_->stack.push_back(first);
      state_->current = *first;
    } catch (...) {
      ec = make_error_code(errc::not_enough_memory);
      state_.reset();
    }
  }
  bool may_descend(error_code &ec) const {
    bool link = state_->current.is_symlink(ec);
    if (ec)
      return false;
    if (link &&
        (state_->options & directory_options::follow_directory_symlink) ==
            directory_options{})
      return false;
    return state_->current.is_directory(ec);
  }
  void advance(error_code &ec) {
    state_->pending = true;
    while (!state_->stack.empty()) {
      auto &current = state_->stack.back();
      current.increment(ec);
      if (ec)
        return;
      if (current != directory_iterator()) {
        state_->current = *current;
        return;
      }
      state_->stack.pop_back();
    }
    state_.reset();
  }
};
