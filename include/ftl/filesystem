class directory_iterator {
public:
  using iterator_category = input_iterator_tag;
  using value_type = directory_entry;
  using difference_type = ptrdiff_t;
  using pointer = const directory_entry *;
  using reference = const directory_entry &;
  directory_iterator() noexcept = default;
  explicit directory_iterator(const path &p) {
    error_code ec;
    open(p, ec);
    if (ec)
      detail_fs::fail("directory_iterator", p, ec);
  }
  directory_iterator(const path &p, error_code &ec) { open(p, ec); }
  directory_iterator(const path &p, directory_options options, error_code &ec) {
    open(p, ec);
    if (ec && (options & directory_options::skip_permission_denied) !=
                  directory_options{})
      ec.clear();
  }
  directory_iterator(const path &p, directory_options options) {
    error_code ec;
    open(p, ec);
    if (ec && (options & directory_options::skip_permission_denied) !=
                  directory_options{})
      ec.clear();
    if (ec)
      detail_fs::fail("directory_iterator", p, ec);
  }
  reference operator*() const { return (*entries_)[index_]; }
  pointer operator->() const { return &**this; }
  directory_iterator &operator++() {
    error_code ec;
    increment(ec);
    if (ec)
      detail_fs::fail("directory_iterator::increment", {}, ec);
    return *this;
  }
  directory_iterator operator++(int) {
    auto copy = *this;
    ++*this;
    return copy;
  }
  directory_iterator &increment(error_code &ec) noexcept {
    ec.clear();
    if (entries_ && ++index_ >= entries_->size()) {
      entries_.reset();
      index_ = 0;
    }
    return *this;
  }
  friend bool operator==(const directory_iterator &a,
                         const directory_iterator &b) {
    if (!a.entries_ && !b.entries_)
      return true;
    return a.entries_ == b.entries_ && a.index_ == b.index_;
  }
  bool operator==(default_sentinel_t) const noexcept { return !entries_; }

private:
  shared_ptr<vector<directory_entry>> entries_;
  size_t index_{};
  void open(const path &, error_code &) noexcept;
};
