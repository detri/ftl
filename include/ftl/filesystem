class file_status {
public:
  file_status() noexcept = default;
  explicit file_status(file_type t, perms p = perms::unknown) noexcept
      : type_(t), permissions_(p) {}
  file_type type() const noexcept { return type_; }
  void type(file_type t) noexcept { type_ = t; }
  perms permissions() const noexcept { return permissions_; }
  void permissions(perms p) noexcept { permissions_ = p; }
