template <class Character>
inline constexpr bool path_character =
    is_same_v<remove_cv_t<Character>, char> ||
    is_same_v<remove_cv_t<Character>, wchar_t> ||
    is_same_v<remove_cv_t<Character>, char8_t> ||
    is_same_v<remove_cv_t<Character>, char16_t> ||
    is_same_v<remove_cv_t<Character>, char32_t>;
}

class path {
public:
  using value_type = char;
  using string_type = basic_string<char>;
  static constexpr value_type preferred_separator = '/';
  enum format { native_format, generic_format, auto_format };

  path() noexcept = default;
  path(const path &) = default;
  path(path &&) noexcept = default;
  path(const string_type &s, format = auto_format) : value_(s) { normalize(); }
  path(string_type &&s, format = auto_format) : value_(move(s)) { normalize(); }
  path(const value_type *s, format = auto_format) : value_(s) { normalize(); }
  template <class Char>
    requires(detail_fs::path_character<Char> &&
             !is_same_v<remove_cv_t<Char>, value_type>)
  path(const Char *source, format = auto_format) {
    const Char *last = source;
    while (*last)
      ++last;
    assign_encoded(source, last);
    normalize();
  }
  template <class Source>
    requires requires(const Source &s) {
      s.data();
      s.size();
      requires detail_fs::path_character<
          remove_pointer_t<decltype(s.data())>>;
    }
  path(const Source &s, format = auto_format) {
    assign_encoded(s.data(), s.data() + s.size());
    normalize();
  }
  template <class InputIt>
    requires(detail_fs::path_character<
             typename iterator_traits<InputIt>::value_type>)
  path(InputIt first, InputIt last, format = auto_format) {
    assign_encoded(first, last);
    normalize();
  }
  template <class Source>
    requires requires(const Source &s) {
      s.data();
      s.size();
      requires is_same_v<
          remove_cv_t<remove_pointer_t<decltype(s.data())>>, char>;
    }
  path(const Source &source, const locale &where, format = auto_format) {
    assign_locale(source.data(), source.data() + source.size(), where);
    normalize();
  }
  path(const char *source, const locale &where, format = auto_format) {
    const char *last = source;
    while (*last)
      ++last;
    assign_locale(source, last, where);
    normalize();
  }
  template <class InputIt>
    requires(is_same_v<
             remove_cv_t<typename iterator_traits<InputIt>::value_type>, char>)
  path(InputIt first, InputIt last, const locale &where, format = auto_format) {
    basic_string<char> source(first, last);
    assign_locale(source.data(), source.data() + source.size(), where);
    normalize();
  }

  path &operator=(const path &) = default;
  path &operator=(path &&) noexcept = default;
  path &operator=(const string_type &s) {
    value_ = s;
    normalize();
    return *this;
  }
  path &operator=(string_type &&s) {
    value_ = move(s);
    normalize();
    return *this;
  }
  path &operator=(const value_type *s) {
    value_ = s;
    normalize();
    return *this;
  }
  template <class Source> path &operator=(const Source &source) {
    return assign(source);
  }
  path &assign(const path &p) { return *this = p; }
  path &assign(path &&p) noexcept { return *this = move(p); }
  path &assign(const string_type &s) { return *this = s; }
  path &assign(string_type &&s) { return *this = move(s); }
  path &assign(const value_type *s) { return *this = s; }
  template <class Source> path &assign(const Source &s) {
    value_.clear();
    assign_encoded(s.data(), s.data() + s.size());
    normalize();
    return *this;
  }
  template <class Character> path &assign(const Character *source) {
    *this = path(source);
    return *this;
  }
  template <class It> path &assign(It a, It b) {
    value_.clear();
    assign_encoded(a, b);
    normalize();
    return *this;
  }

  path &operator/=(const path &p) {
    if (p.is_absolute() ||
        (p.has_root_name() && p.root_name() != root_name())) {
      value_ = p.value_;
      return *this;
    }
    if (p.has_root_directory()) {
      value_.erase(root_name_length());
    } else if ((!has_root_directory() && is_absolute()) || has_filename() ||
               (root_name_length() > 2 && !has_relative_path())) {
      value_ += '/';
    }
    value_.append(p.value_, p.root_name_length(), string_type::npos);
    return *this;
  }
  template <class Source> path &operator/=(const Source &s) {
    return *this /= path(s);
  }
  path &append(const path &p) { return *this /= p; }
  template <class Source> path &append(const Source &s) {
    return *this /= path(s);
  }
  template <class It> path &append(It a, It b) { return *this /= path(a, b); }
  path &operator+=(const path &p) {
    value_ += p.value_;
    return *this;
  }
  path &operator+=(const string_type &s) {
    value_ += s;
    normalize();
    return *this;
  }
  path &operator+=(string_view s) {
    value_.append(s.data(), s.size());
    normalize();
    return *this;
  }
  path &operator+=(const value_type *s) {
    value_ += s;
    normalize();
    return *this;
  }
  path &operator+=(value_type c) {
    value_ += c;
    return *this;
  }
  template <class Source> path &operator+=(const Source &source) {
    return *this += path(source).native();
  }
  template <class Character>
    requires(!is_same_v<remove_cv_t<Character>, value_type>)
  path &operator+=(Character character) {
    return *this += path(&character, &character + 1).native();
  }
  template <class Source> path &concat(const Source &s) {
    return *this += string_view(s.data(), s.size());
  }
  template <class It> path &concat(It a, It b) {
    return *this += path(a, b).native();
  }
  void clear() noexcept { value_.clear(); }
  path &make_preferred() {
    normalize();
    return *this;
  }
  path &remove_filename() {
    auto name = filename();
    if (!name.empty())
      value_.erase(value_.size() - name.value_.size());
    return *this;
  }
  path &replace_filename(const path &p) { return remove_filename() /= p; }
  path &replace_extension(const path &p = path()) {
    auto ext = extension();
    if (!ext.empty())
      value_.erase(value_.size() - ext.value_.size());
    if (!p.empty()) {
      if (p.value_[0] != '.')
        value_ += '.';
      value_ += p.value_;
    }
    return *this;
  }
  void swap(path &p) noexcept { value_.swap(p.value_); }

  const string_type &native() const noexcept { return value_; }
  const value_type *c_str() const noexcept { return value_.c_str(); }
  operator string_type() const { return value_; }
  template <class Char, class Traits = char_traits<Char>,
            class Alloc = allocator<Char>>
  basic_string<Char, Traits, Alloc> string(const Alloc &a = Alloc()) const {
    basic_string<Char, Traits, Alloc> result(a);
    if constexpr (is_same_v<Char, char> || is_same_v<Char, char8_t>) {
      for (unsigned char byte : value_)
        result += static_cast<Char>(byte);
    } else {
      for (size_t index = 0; index < value_.size();) {
        unsigned char lead = static_cast<unsigned char>(value_[index++]);
        char32_t code = lead;
        unsigned continuation = 0;
        if ((lead & 0xe0) == 0xc0) {
          code = lead & 0x1f;
          continuation = 1;
        } else if ((lead & 0xf0) == 0xe0) {
          code = lead & 0x0f;
          continuation = 2;
        } else if ((lead & 0xf8) == 0xf0) {
          code = lead & 0x07;
          continuation = 3;
        }
        while (continuation-- && index < value_.size())
          code = (code << 6) |
                 (static_cast<unsigned char>(value_[index++]) & 0x3f);
        if constexpr (sizeof(Char) == 2) {
          if (code > 0xffff) {
            code -= 0x10000;
            result += static_cast<Char>(0xd800 + (code >> 10));
            result += static_cast<Char>(0xdc00 + (code & 0x3ff));
          } else {
            result += static_cast<Char>(code);
          }
        } else {
          result += static_cast<Char>(code);
        }
      }
    }
    return result;
  }
  string_type string() const { return value_; }
  basic_string<wchar_t> wstring() const { return string<wchar_t>(); }
  basic_string<char8_t> u8string() const { return string<char8_t>(); }
  basic_string<char16_t> u16string() const { return string<char16_t>(); }
  basic_string<char32_t> u32string() const { return string<char32_t>(); }
  string_type generic_string() const { return value_; }
  template <class Char, class Traits = char_traits<Char>,
            class Alloc = allocator<Char>>
  basic_string<Char, Traits, Alloc>
  generic_string(const Alloc &a = Alloc()) const {
    return string<Char, Traits, Alloc>(a);
  }
  basic_string<wchar_t> generic_wstring() const { return string<wchar_t>(); }
  basic_string<char8_t> generic_u8string() const { return string<char8_t>(); }
  basic_string<char16_t> generic_u16string() const {
    return string<char16_t>();
  }
  basic_string<char32_t> generic_u32string() const {
    return string<char32_t>();
  }
  int compare(const path &p) const noexcept;
  int compare(const string_type &s) const { return compare(path(s)); }
  int compare(string_view s) const { return compare(path(s)); }
  int compare(const value_type *s) const { return compare(path(s)); }

  path root_name() const { return path(value_.substr(0, root_name_length())); }
  path root_directory() const {
    auto n = root_name().value_.size();
    return n < value_.size() && value_[n] == '/' ? path("/") : path();
  }
  path root_path() const { return path(value_.substr(0, root_end())); }
  path relative_path() const {
    auto n = root_name().value_.size();
    if (n < value_.size() && value_[n] == '/')
      ++n;
    return path(value_.substr(n));
  }
  path parent_path() const {
    auto end = value_.size();
    while (end > root_end() && value_[end - 1] == '/')
      --end;
    if (end != value_.size())
      return path(value_.substr(0, end));
    auto n = value_.rfind('/', end - 1);
    if (n == string_type::npos)
      return root_name();
    if (n < root_end())
      return path(value_.substr(0, root_end()));
    return path(value_.substr(0, n));
  }
  path filename() const {
    if (value_.empty() || value_.back() == '/')
      return path();
    auto n = value_.rfind('/');
    return path(value_.substr(n == string_type::npos ? 0 : n + 1));
  }
  path stem() const {
    auto f = filename().value_;
    auto n = f.rfind('.');
    if (n == string_type::npos || n == 0)
      return path(f);
    return path(f.substr(0, n));
  }
  path extension() const {
    auto f = filename().value_;
    auto n = f.rfind('.');
    return n == string_type::npos || n == 0 ? path() : path(f.substr(n));
  }
  bool empty() const noexcept { return value_.empty(); }
  bool has_root_name() const { return !root_name().empty(); }
  bool has_root_directory() const { return !root_directory().empty(); }
  bool has_root_path() const { return !root_path().empty(); }
  bool has_relative_path() const { return !relative_path().empty(); }
  bool has_parent_path() const { return !parent_path().empty(); }
  bool has_filename() const { return !filename().empty(); }
  bool has_stem() const { return !stem().empty(); }
  bool has_extension() const { return !extension().empty(); }
  bool is_absolute() const {
    auto n = root_name().value_.size();
    return n < value_.size() && value_[n] == '/';
  }
  bool is_relative() const { return !is_absolute(); }
  path lexically_normal() const;
  path lexically_relative(const path &) const;
  path lexically_proximate(const path &base) const {
    auto p = lexically_relative(base);
    return p.empty() ? *this : p;
  }

  class iterator;
  using const_iterator = iterator;
  iterator begin() const;
  iterator end() const;
  friend bool operator==(const path &a, const path &b) noexcept {
    return a.compare(b) == 0;
  }
  friend strong_ordering operator<=>(const path &a, const path &b) noexcept {
    int result = a.compare(b);
    return result < 0   ? strong_ordering::less
           : result > 0 ? strong_ordering::greater
                        : strong_ordering::equal;
  }
  friend path operator/(const path &a, const path &b) { return path(a) /= b; }

private:
  string_type value_;
  bool has_drive() const {
    return value_.size() > 1 &&
           ((value_[0] >= 'A' && value_[0] <= 'Z') ||
            (value_[0] >= 'a' && value_[0] <= 'z')) &&
           value_[1] == ':';
  }
  size_t root_name_length() const {
    if (has_drive())
      return 2;
    if (value_.size() > 2 && value_[0] == '/' && value_[1] == '/' &&
        value_[2] != '/') {
      auto end = value_.find('/', 2);
      return end == string_type::npos ? value_.size() : end;
    }
    return 0;
  }
  size_t root_end() const {
    size_t n = root_name_length();
    if (n < value_.size() && value_[n] == '/')
      ++n;
    return n;
  }
  size_t element_count() const {
    size_t count = root_name_length() ? 1 : 0;
    size_t first = root_end();
    if (first > root_name_length())
      ++count;
    size_t position = first;
    while (position < value_.size()) {
      while (position < value_.size() && value_[position] == '/')
        ++position;
      if (position == value_.size())
        break;
      ++count;
      auto separator = value_.find('/', position);
      if (separator == string_type::npos)
        break;
      position = separator + 1;
    }
    if (value_.size() > first && value_.back() == '/')
      ++count;
    return count;
  }
  path element_at(size_t wanted) const {
    size_t index = 0;
    auto root_name_size = root_name_length();
    if (root_name_size) {
      if (wanted == index)
        return path(value_.substr(0, root_name_size));
      ++index;
    }
    size_t position = root_end();
    if (position > root_name_size) {
      if (wanted == index)
        return path("/");
      ++index;
    }
    while (position < value_.size()) {
      while (position < value_.size() && value_[position] == '/')
        ++position;
      if (position == value_.size())
        break;
      auto separator = value_.find('/', position);
      if (wanted == index)
        return path(value_.substr(position, separator == string_type::npos
                                                ? separator
                                                : separator - position));
      ++index;
      if (separator == string_type::npos)
        break;
      position = separator + 1;
    }
    return {};
  }
  void normalize() {}
  void append_utf8(char32_t value) {
    if (value <= 0x7f) {
      value_ += static_cast<char>(value);
    } else if (value <= 0x7ff) {
      value_ += static_cast<char>(0xc0 | (value >> 6));
      value_ += static_cast<char>(0x80 | (value & 0x3f));
    } else if (value <= 0xffff) {
      value_ += static_cast<char>(0xe0 | (value >> 12));
      value_ += static_cast<char>(0x80 | ((value >> 6) & 0x3f));
      value_ += static_cast<char>(0x80 | (value & 0x3f));
    } else {
      value_ += static_cast<char>(0xf0 | (value >> 18));
      value_ += static_cast<char>(0x80 | ((value >> 12) & 0x3f));
      value_ += static_cast<char>(0x80 | ((value >> 6) & 0x3f));
      value_ += static_cast<char>(0x80 | (value & 0x3f));
    }
  }
  template <class It> void assign_encoded(It first, It last) {
    using character = remove_cv_t<typename iterator_traits<It>::value_type>;
    if constexpr (is_same_v<character, char> || is_same_v<character, char8_t>) {
      for (; first != last; ++first)
        value_ += static_cast<char>(*first);
    } else {
      while (first != last) {
        char32_t value = static_cast<char32_t>(*first++);
        if constexpr (sizeof(character) == 2) {
          if (value >= 0xd800 && value <= 0xdbff && first != last) {
            char32_t low = static_cast<char32_t>(*first);
            if (low >= 0xdc00 && low <= 0xdfff) {
              ++first;
              value = 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00);
            }
          }
        }
        append_utf8(value);
      }
    }
  }
  void assign_locale(const char *first, const char *last, const locale &where) {
    const auto &conversion =
        use_facet<codecvt<wchar_t, char, mbstate_t>>(where);
    mbstate_t state{};
    while (first != last) {
      const char *original = first;
      wchar_t buffer[128];
      wchar_t *output = buffer;
      const char *next = first;
      auto result =
          conversion.in(state, first, last, next, buffer, buffer + 128, output);
      assign_encoded(buffer, output);
      first = next;
      if (result == codecvt_base::error ||
          (next == original && result != codecvt_base::ok))
        throw system_error(make_error_code(errc::illegal_byte_sequence));
    }
  }
};

class path::iterator {
public:
  using iterator_category = bidirectional_iterator_tag;
  using value_type = path;
  using difference_type = ptrdiff_t;
  using pointer = const path *;
  using reference = const path &;
  iterator() = default;
  reference operator*() const { return part_; }
  pointer operator->() const { return &part_; }
  iterator &operator++() {
    advance();
    return *this;
  }
  iterator operator++(int) {
    auto x = *this;
    ++*this;
    return x;
  }
  iterator &operator--() {
    retreat();
    return *this;
  }
  iterator operator--(int) {
    auto x = *this;
    --*this;
    return x;
  }
  friend bool operator==(const iterator &a, const iterator &b) {
    return a.owner_ == b.owner_ && a.pos_ == b.pos_;
  }

private:
  friend class path;
  const path *owner_{};
  size_t pos_{};
  path part_;
  iterator(const path *p, size_t n) : owner_(p), pos_(n) { load(); }
  void load() { part_ = owner_ ? owner_->element_at(pos_) : path(); }
  void advance() {
    if (!owner_ || pos_ >= owner_->element_count())
      return;
    ++pos_;
    load();
  }
  void retreat() {
    if (pos_ == 0)
      return;
    --pos_;
    load();
  }
};
inline path::iterator path::begin() const { return iterator(this, 0); }
inline path::iterator path::end() const {
  return iterator(this, element_count());
}
inline int path::compare(const path &p) const noexcept {
  auto left = begin(), right = p.begin();
  while (left != end() && right != p.end()) {
    int result = left->native().compare(right->native());
    if (result)
      return result;
    ++left;
    ++right;
  }
  return left == end() ? (right == p.end() ? 0 : -1) : 1;
}

inline path path::lexically_normal() const {
  vector<path> parts;
  size_t n = root_end();
  while (n < value_.size()) {
    while (n < value_.size() && value_[n] == '/')
      ++n;
    auto e = value_.find('/', n);
    auto p = path(value_.substr(n, e == string::npos ? e : e - n));
    if (!p.empty() && p != path(".")) {
      if (p == path("..") && !parts.empty() && parts.back() != path(".."))
        parts.pop_back();
      else if (p != path("..") || !is_absolute())
        parts.push_back(p);
    }
    if (e == string::npos)
      break;
    n = e + 1;
  }
  path out = root_path();
  for (auto &p : parts)
    out /= p;
  if (out.empty())
    return path(".");
  auto final_component = filename();
  if ((!value_.empty() && value_.back() == '/') ||
      final_component == path(".") || final_component == path(".."))
    out /= "";
  return out;
}
inline path path::lexically_relative(const path &base) const {
  if (root_name() != base.root_name() || is_absolute() != base.is_absolute() ||
      (!has_root_directory() && base.has_root_directory()))
    return {};
  auto i = begin(), j = base.begin();
  while (i != end() && j != base.end() && *i == *j) {
    ++i;
    ++j;
  }
  if (i == end() && j == base.end())
    return path(".");
  int up = 0;
  for (auto current = j; current != base.end(); ++current) {
    if (*current == path(".."))
      --up;
    else if (!current->empty() && *current != path("."))
      ++up;
  }
  if (up < 0)
    return {};
  if (up == 0 && (i == end() || i->empty()))
    return path(".");
  path out;
  while (up--)
    out /= "..";
  for (; i != end(); ++i)
    out /= *i;
  return out;
}

inline void swap(path &a, path &b) noexcept { a.swap(b); }
template <class Source> path u8path(const Source &source) {
  return path(source);
}
template <class InputIterator>
path u8path(InputIterator first, InputIterator last) {
  return path(first, last);
}
inline size_t hash_value(const path &p) noexcept {
  size_t value = sizeof(size_t) == 8 ? size_t{1469598103934665603ULL}
                                     : size_t{2166136261U};
  constexpr size_t prime =
      sizeof(size_t) == 8 ? size_t{1099511628211ULL} : size_t{16777619U};
  bool separator = false;
  for (size_t index = 0; index < p.native().size(); ++index) {
    unsigned char character = static_cast<unsigned char>(p.native()[index]);
    if (character == '/') {
      bool unc_second = index == 1 && p.native()[0] == '/';
      if (separator && !unc_second)
        continue;
      separator = true;
    } else {
      separator = false;
    }
    value = (value ^ character) * prime;
  }
  return value;
}

