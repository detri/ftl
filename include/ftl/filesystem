    ec.clear();
}
inline void copy_symlink(const path &a, const path &b,
                         error_code &ec) noexcept {
  try {
    auto target = read_symlink(a, ec);
    if (!ec)
      create_symlink(target, b, ec);
  } catch (...) {
    ec = make_error_code(errc::not_enough_memory);
  }
}
inline bool copy_file(const path &a, const path &b, copy_options o,
                      error_code &ec) noexcept {
  bool overwrite = (o & copy_options::overwrite_existing) != copy_options{};
  if ((o & copy_options::skip_existing) != copy_options{} && exists(b, ec)) {
    ec.clear();
    return false;
  }
  detail::native_io_error e;
  if (!detail::native_copy_file(a.c_str(), b.c_str(), overwrite, e)) {
    ec = detail_fs::code(e);
    return false;
  }
  ec.clear();
  return true;
}
inline void copy(const path &a, const path &b, copy_options o, error_code &ec) {
  auto s = symlink_status(a, ec);
  if (ec)
    return;
  if (is_directory(s)) {
    if ((o & copy_options::recursive) == copy_options{}) {
      ec = make_error_code(errc::is_a_directory);
      return;
    }
    create_directories(b, ec);
    if (ec)
      return;
    for (directory_iterator i(a, ec); !ec && i != directory_iterator();
         i.increment(ec))
      copy(i->path(), b / i->path().filename(), o, ec);
  } else
    copy_file(a, b, o, ec);
}
inline path temp_directory_path(error_code &ec) {
  ec.clear();
#if defined(_WIN32)
  return path("C:/Windows/Temp");
#else
  return path("/tmp");
#endif
}
