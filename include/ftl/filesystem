    path destination = is_directory(target) ? b / a.filename() : b;
    if ((o & copy_options::create_symlinks) != copy_options{})
      create_symlink(absolute(a, ec), destination, ec);
    else if ((o & copy_options::create_hard_links) != copy_options{})
      create_hard_link(a, destination, ec);
    else
      copy_file(a, destination, o, ec);
    return;
