class directory_entry {
public:
  directory_entry() noexcept = default;
  explicit directory_entry(const filesystem::path &p) : path_(p) {
    error_code ec;
    refresh(ec);
    if (ec)
      detail_fs::fail("directory_entry", p, ec);
  }
  directory_entry(const filesystem::path &p, error_code &ec) : path_(p) {
    refresh(ec);
  }
  void assign(const filesystem::path &p) { *this = directory_entry(p); }
  void assign(const filesystem::path &p, error_code &ec) {
    path_ = p;
    refresh(ec);
  }
  void replace_filename(const filesystem::path &p) {
    assign(path_.parent_path() / p);
  }
  void replace_filename(const filesystem::path &p, error_code &ec) {
    assign(path_.parent_path() / p, ec);
  }
  void refresh() {
    error_code ec;
    refresh(ec);
    if (ec)
      detail_fs::fail("refresh", path_, ec);
  }
  void refresh(error_code &ec) noexcept {
    status_ = filesystem::status(path_, ec);
    if (!ec)
      symlink_ = filesystem::symlink_status(path_, ec);
  }
  const filesystem::path &path() const noexcept { return path_; }
  operator const filesystem::path &() const noexcept { return path_; }
  bool exists() const { return filesystem::exists(status_); }
  bool exists(error_code &ec) const noexcept {
    ec.clear();
    return exists();
  }
  bool is_block_file() const { return filesystem::is_block_file(status_); }
  bool is_character_file() const {
    return filesystem::is_character_file(status_);
  }
  bool is_directory() const { return filesystem::is_directory(status_); }
  bool is_fifo() const { return filesystem::is_fifo(status_); }
  bool is_other() const { return filesystem::is_other(status_); }
  bool is_regular_file() const { return filesystem::is_regular_file(status_); }
  bool is_socket() const { return filesystem::is_socket(status_); }
  bool is_symlink() const { return filesystem::is_symlink(symlink_); }
#define FTL_FS_ENTRY_PRED(name)                                               \
  bool name(error_code &ec) const noexcept {                                  \
    ec.clear();                                                               \
    return name();                                                            \
  }
  FTL_FS_ENTRY_PRED(is_block_file)
  FTL_FS_ENTRY_PRED(is_character_file)
  FTL_FS_ENTRY_PRED(is_directory)
  FTL_FS_ENTRY_PRED(is_fifo)
  FTL_FS_ENTRY_PRED(is_other)
