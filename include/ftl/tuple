template <class Left, class Right, size_t... L, size_t... R>
constexpr auto tuple_cat_two(Left &&left, Right &&right, index_sequence<L...>,
                             index_sequence<R...>) {
  return tuple<tuple_element_t<L, remove_cvref_t<Left>>...,
               tuple_element_t<R, remove_cvref_t<Right>>...>(
      get<L>(forward<Left>(left))..., get<R>(forward<Right>(right))...);
}
} // namespace detail
inline constexpr detail::ignore_t ignore{};

template <class F, class Tuple>
constexpr decltype(auto)
apply(F &&function, Tuple &&value) noexcept(noexcept(detail::tuple_apply(
    forward<F>(function), forward<Tuple>(value),
    make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{}))) {
  return detail::tuple_apply(
      forward<F>(function), forward<Tuple>(value),
      make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}

template <class T, class Tuple>
constexpr T make_from_tuple(Tuple &&value)
  requires(detail::make_from_tuple_constructible<T, Tuple>(
      make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{}))
{
#if FTL_HAS_REFERENCE_CONSTRUCTS_FROM_TEMPORARY
  if constexpr (tuple_size_v<remove_reference_t<Tuple>> == 1)
    static_assert(!reference_constructs_from_temporary_v<
                  T, decltype(get<0>(declval<Tuple>()))>);
#endif
  return [&]<size_t... I>(index_sequence<I...>) -> T {
    return T(get<I>(forward<Tuple>(value))...);
  }(make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}

constexpr tuple<> tuple_cat() { return {}; }
template <class Tuple> constexpr auto tuple_cat(Tuple &&value) {
  return detail::tuple_cat_two(
      tuple<>{}, forward<Tuple>(value), index_sequence<>{},
      make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}
template <class First, class Second, class... Rest>
constexpr auto tuple_cat(First &&first, Second &&second, Rest &&...rest) {
  auto joined = detail::tuple_cat_two(
      forward<First>(first), forward<Second>(second),
      make_index_sequence<tuple_size_v<remove_reference_t<First>>>{},
      make_index_sequence<tuple_size_v<remove_reference_t<Second>>>{});
  return tuple_cat(move(joined), forward<Rest>(rest)...);
}

