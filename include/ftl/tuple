FTL_BEGIN_NAMESPACE

namespace detail {
template <class> struct is_tuple : false_type {};

template <class... T> struct is_tuple<tuple<T...>> : true_type {};

template <class> struct is_array : false_type {};

template <class T, size_t Size> struct is_array<array<T, Size>> : true_type {};

template <class T>
struct is_tuple_source
    : bool_constant<is_tuple<T>::value || is_pair<T>::value ||
                    is_array<T>::value || is_library_pair_like<T>::value> {};
#if defined(_MSC_VER)
#define FTL_TUPLE_NO_UNIQUE_ADDRESS [[msvc::no_unique_address]]
#else
#define FTL_TUPLE_NO_UNIQUE_ADDRESS [[no_unique_address]]
#endif

template <size_t Index, class T> struct tuple_leaf {
  FTL_TUPLE_NO_UNIQUE_ADDRESS T value;
  constexpr tuple_leaf()
    requires is_default_constructible_v<T>
      : value() {}
  template <class U> constexpr tuple_leaf(U &&item) : value(forward<U>(item)) {}
  template <class Alloc, class... U>
  constexpr tuple_leaf(allocator_arg_t, const Alloc &alloc, U &&...item)
    requires(!uses_allocator_v<T, Alloc>)
      : value(forward<U>(item)...) {}
  template <class Alloc, class... U>
  constexpr tuple_leaf(allocator_arg_t, const Alloc &alloc, U &&...item)
    requires(uses_allocator_v<T, Alloc> &&
             is_constructible_v<T, allocator_arg_t, const Alloc &, U...>)
      : value(allocator_arg, alloc, forward<U>(item)...) {}
  template <class Alloc, class... U>
  constexpr tuple_leaf(allocator_arg_t, const Alloc &alloc, U &&...item)
    requires(uses_allocator_v<T, Alloc> &&
             !is_constructible_v<T, allocator_arg_t, const Alloc &, U...> &&
             is_constructible_v<T, U..., const Alloc &>)
      : value(forward<U>(item)..., alloc) {}
};

template <class Sequence, class... Types> struct tuple_base;
template <size_t... Index, class... Types>
struct tuple_base<index_sequence<Index...>, Types...>
    : tuple_leaf<Index, Types>... {
  constexpr tuple_base()
    requires(is_default_constructible_v<Types> && ...)
  = default;
  template <class... U>
  constexpr tuple_base(U &&...values)
    requires(sizeof...(U) == sizeof...(Types))
      : tuple_leaf<Index, Types>(forward<U>(values))... {}
  template <class Alloc, class... U>
  constexpr tuple_base(allocator_arg_t, const Alloc &alloc, U &&...values)
    requires(sizeof...(U) == sizeof...(Types))
      : tuple_leaf<Index, Types>(allocator_arg, alloc, forward<U>(values))... {}
};

template <size_t Index, class Head, class... Tail>
struct nth_type : nth_type<Index - 1, Tail...> {};
template <class Head, class... Tail> struct nth_type<0, Head, Tail...> {
  using type = Head;
};

template <class Tuple, size_t... Index>
constexpr auto tuple_equal(const Tuple &left, const Tuple &right,
                           index_sequence<Index...>) {
  return ((get<Index>(left) == get<Index>(right)) && ...);
}

template <class F, class Tuple, size_t... Index>
constexpr decltype(auto)
tuple_apply(F &&function, Tuple &&value, index_sequence<Index...>) noexcept(
    noexcept(detail::invoke(forward<F>(function),
                            get<Index>(forward<Tuple>(value))...))) {
  return detail::invoke(forward<F>(function),
                        get<Index>(forward<Tuple>(value))...);
}

template <class T, class Tuple, size_t... I>
consteval bool make_from_tuple_constructible(index_sequence<I...>) {
  return is_constructible_v<T, decltype(get<I>(declval<Tuple>()))...>;
}
} // namespace detail

template <class... Types>
class tuple
    : public detail::tuple_base<index_sequence_for<Types...>, Types...> {
  using base = detail::tuple_base<index_sequence_for<Types...>, Types...>;

  template <class... U>
  static consteval bool elementwise_constructor_is_disambiguated() {
    if constexpr (sizeof...(Types) != sizeof...(U) || sizeof...(Types) == 0) {
      return false;
    } else if constexpr (sizeof...(Types) == 1) {
      using source_type = typename detail::nth_type<0, U...>::type;

      return !is_same_v<remove_cvref_t<source_type>, tuple>;
    } else if constexpr (sizeof...(Types) < 4) {
      using source_first = typename detail::nth_type<0, U...>::type;

      if constexpr (!is_same_v<remove_cvref_t<source_first>, allocator_arg_t>) {
        return true;
      } else {
        using destination_first = typename detail::nth_type<0, Types...>::type;

        return is_same_v<remove_cvref_t<destination_first>, allocator_arg_t>;
      }
    } else {
      return true;
    }
  }

  template <class TupleLike>
  static consteval bool tuple_like_uses_other_constructor() {
    if constexpr (sizeof...(Types) != 1) {
      return false;
    } else if constexpr (is_same_v<remove_cvref_t<TupleLike>, tuple>) {
      return true;
    } else {
      using element_type = typename detail::nth_type<0, Types...>::type;

      return is_convertible_v<TupleLike, element_type> ||
             is_constructible_v<element_type, TupleLike>;
    }
  }

  template <class TupleLike, size_t... I>
  static consteval bool tuple_like_convertible(index_sequence<I...>) {
    return (is_convertible_v<decltype(get<I>(declval<TupleLike>())), Types> &&
            ...);
  }

  template <class TupleLike, size_t... I>
  static consteval bool tuple_like_constructible(index_sequence<I...>) {
    return (is_constructible_v<Types, decltype(get<I>(declval<TupleLike>()))> &&
            ...);
  }

  template <class TupleLike, size_t... I>
  static consteval bool tuple_like_dangles(index_sequence<I...>) {
#if FTL_HAS_REFERENCE_CONSTRUCTS_FROM_TEMPORARY
    return (reference_constructs_from_temporary_v<
                Types, decltype(get<I>(declval<TupleLike>()))> ||
            ...);
#else
    return false;
#endif
  }

  template <class TupleLike, size_t... I>
  static consteval bool tuple_like_assignable(index_sequence<I...>) {
    return (is_assignable_v<Types &, decltype(get<I>(declval<TupleLike>()))> &&
            ...);
  }

  template <class TupleLike, size_t... I>
  static consteval bool tuple_like_const_assignable(index_sequence<I...>) {
    return (is_assignable_v<const Types &,
                            decltype(get<I>(declval<TupleLike>()))> &&
            ...);
  }

public:
  constexpr explicit(!(detail::implicitly_default_constructible<Types> && ...))
      tuple()
    requires(is_default_constructible_v<Types> && ...)
  = default;

  constexpr explicit(!(is_convertible_v<const Types &, Types> && ...))
      tuple(const Types &...values)
    requires(sizeof...(Types) != 0 &&
             (is_constructible_v<Types, const Types &> && ...))
      : base(values...) {}

  template <class... U>
  constexpr explicit(!(is_convertible_v<U, Types> && ...)) tuple(U &&...values)
    requires(elementwise_constructor_is_disambiguated<U...>() &&
             (is_constructible_v<Types, U> && ...) &&
             !(detail::pair_dangles_v<Types, U &&> || ...))
      : base(forward<U>(values)...) {}

  constexpr tuple(const tuple &) = default;

  constexpr tuple(tuple &&) = default;

  constexpr tuple &operator=(const tuple &) = default;

  constexpr tuple &operator=(tuple &&) = default;

  template <class... U>
  constexpr explicit(!tuple_like_convertible<tuple<U...> &>(
      index_sequence_for<Types...>{})) tuple(tuple<U...> &other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<tuple<U...> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<tuple<U...> &>() &&
             !tuple_like_dangles<tuple<U...> &>(index_sequence_for<Types...>{}))
      : tuple(other, index_sequence_for<Types...>{}) {}

  template <class... U>
  constexpr explicit(!tuple_like_convertible<const tuple<U...> &>(
      index_sequence_for<Types...>{})) tuple(const tuple<U...> &other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<const tuple<U...> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<const tuple<U...> &>() &&
             !tuple_like_dangles<const tuple<U...> &>(
                 index_sequence_for<Types...>{}))
      : tuple(other, index_sequence_for<Types...>{}) {}

  template <class... U>
  constexpr explicit(!tuple_like_convertible<tuple<U...> &&>(
      index_sequence_for<Types...>{})) tuple(tuple<U...> &&other)
    requires(
        sizeof...(U) == sizeof...(Types) &&
        tuple_like_constructible<tuple<U...> &&>(
            index_sequence_for<Types...>{}) &&
        !tuple_like_uses_other_constructor<tuple<U...> &&>() &&
        !tuple_like_dangles<tuple<U...> &&>(index_sequence_for<Types...>{}))
      : tuple(move(other), index_sequence_for<Types...>{}) {}

  template <class... U>
  constexpr explicit(!tuple_like_convertible<const tuple<U...> &&>(
      index_sequence_for<Types...>{})) tuple(const tuple<U...> &&other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<const tuple<U...> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<const tuple<U...> &&>() &&
             !tuple_like_dangles<const tuple<U...> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(move(other), index_sequence_for<Types...>{}) {}

  template <class First, class Second>
  constexpr explicit(!tuple_like_convertible<pair<First, Second> &>(
      index_sequence_for<Types...>{})) tuple(pair<First, Second> &other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<pair<First, Second> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<pair<First, Second> &>(
                 index_sequence_for<Types...>{}))
      : tuple(other, index_sequence_for<Types...>{}) {}

  template <class First, class Second>
  constexpr explicit(!tuple_like_convertible<const pair<First, Second> &>(
      index_sequence_for<Types...>{})) tuple(const pair<First, Second> &other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<const pair<First, Second> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<const pair<First, Second> &>(
                 index_sequence_for<Types...>{}))
      : tuple(other, index_sequence_for<Types...>{}) {}

  template <class First, class Second>
  constexpr explicit(!tuple_like_convertible<pair<First, Second> &&>(
      index_sequence_for<Types...>{})) tuple(pair<First, Second> &&other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<pair<First, Second> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<pair<First, Second> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(move(other), index_sequence_for<Types...>{}) {}

  template <class First, class Second>
  constexpr explicit(!tuple_like_convertible<const pair<First, Second> &&>(
      index_sequence_for<Types...>{})) tuple(const pair<First, Second> &&other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<const pair<First, Second> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<const pair<First, Second> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(move(other), index_sequence_for<Types...>{}) {}

  template <class TupleLike>
  constexpr explicit(!tuple_like_convertible<TupleLike>(
      index_sequence_for<Types...>{})) tuple(TupleLike &&other)
    requires(
        !detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
        !detail::is_pair<remove_cvref_t<TupleLike>>::value &&
        detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
        tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
        tuple_like_constructible<TupleLike>(index_sequence_for<Types...>{}) &&
        !tuple_like_uses_other_constructor<TupleLike>() &&
        !tuple_like_dangles<TupleLike>(index_sequence_for<Types...>{}))
      : tuple(forward<TupleLike>(other), index_sequence_for<Types...>{}) {}

  template <class Alloc>
  constexpr explicit(!(detail::implicitly_default_constructible<Types> && ...))
      tuple(allocator_arg_t, const Alloc &allocator)
    requires(is_default_constructible_v<Types> && ...)
      : base(allocator_arg, allocator) {}

  template <class Alloc>
  constexpr explicit(!(is_convertible_v<const Types &, Types> && ...))
      tuple(allocator_arg_t, const Alloc &allocator, const Types &...values)
    requires(sizeof...(Types) != 0 &&
             (is_constructible_v<Types, const Types &> && ...))
      : base(allocator_arg, allocator, values...) {}

  template <class Alloc, class... U>
  constexpr explicit(!(is_convertible_v<U, Types> && ...))
      tuple(allocator_arg_t, const Alloc &allocator, U &&...values)
    requires(elementwise_constructor_is_disambiguated<U...>() &&
             (is_constructible_v<Types, U> && ...) &&
             !(detail::pair_dangles_v<Types, U &&> || ...))
      : base(allocator_arg, allocator, forward<U>(values)...) {}

  template <class Alloc>
  constexpr tuple(allocator_arg_t, const Alloc &allocator, const tuple &other)
      : tuple(allocator_arg, allocator, other, index_sequence_for<Types...>{}) {
  }

  template <class Alloc>
  constexpr tuple(allocator_arg_t, const Alloc &allocator, tuple &&other)
      : tuple(allocator_arg, allocator, move(other),
              index_sequence_for<Types...>{}) {}

  template <class Alloc, class... U>
  constexpr explicit(
      !tuple_like_convertible<tuple<U...> &>(index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, tuple<U...> &other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<tuple<U...> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<tuple<U...> &>() &&
             !tuple_like_dangles<tuple<U...> &>(index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, other, index_sequence_for<Types...>{}) {
  }

  template <class Alloc, class... U>
  constexpr explicit(!tuple_like_convertible<const tuple<U...> &>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, const tuple<U...> &other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<const tuple<U...> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<const tuple<U...> &>() &&
             !tuple_like_dangles<const tuple<U...> &>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, other, index_sequence_for<Types...>{}) {
  }

  template <class Alloc, class... U>
  constexpr explicit(
      !tuple_like_convertible<tuple<U...> &&>(index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, tuple<U...> &&other)
    requires(
        sizeof...(U) == sizeof...(Types) &&
        tuple_like_constructible<tuple<U...> &&>(
            index_sequence_for<Types...>{}) &&
        !tuple_like_uses_other_constructor<tuple<U...> &&>() &&
        !tuple_like_dangles<tuple<U...> &&>(index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, move(other),
              index_sequence_for<Types...>{}) {}

  template <class Alloc, class... U>
  constexpr explicit(!tuple_like_convertible<const tuple<U...> &&>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, const tuple<U...> &&other)
    requires(sizeof...(U) == sizeof...(Types) &&
             tuple_like_constructible<const tuple<U...> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_uses_other_constructor<const tuple<U...> &&>() &&
             !tuple_like_dangles<const tuple<U...> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, move(other),
              index_sequence_for<Types...>{}) {}

  template <class Alloc, class First, class Second>
  constexpr explicit(!tuple_like_convertible<pair<First, Second> &>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, pair<First, Second> &other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<pair<First, Second> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<pair<First, Second> &>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, other, index_sequence_for<Types...>{}) {
  }

  template <class Alloc, class First, class Second>
  constexpr explicit(!tuple_like_convertible<const pair<First, Second> &>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator,
            const pair<First, Second> &other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<const pair<First, Second> &>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<const pair<First, Second> &>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, other, index_sequence_for<Types...>{}) {
  }

  template <class Alloc, class First, class Second>
  constexpr explicit(!tuple_like_convertible<pair<First, Second> &&>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator,
            pair<First, Second> &&other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<pair<First, Second> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<pair<First, Second> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, move(other),
              index_sequence_for<Types...>{}) {}

  template <class Alloc, class First, class Second>
  constexpr explicit(!tuple_like_convertible<const pair<First, Second> &&>(
      index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator,
            const pair<First, Second> &&other)
    requires(sizeof...(Types) == 2 &&
             tuple_like_constructible<const pair<First, Second> &&>(
                 index_sequence_for<Types...>{}) &&
             !tuple_like_dangles<const pair<First, Second> &&>(
                 index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, move(other),
              index_sequence_for<Types...>{}) {}

  template <class Alloc, class TupleLike>
  constexpr explicit(
      !tuple_like_convertible<TupleLike>(index_sequence_for<Types...>{}))
      tuple(allocator_arg_t, const Alloc &allocator, TupleLike &&other)
    requires(
        !detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
        !detail::is_pair<remove_cvref_t<TupleLike>>::value &&
        detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
        tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
        tuple_like_constructible<TupleLike>(index_sequence_for<Types...>{}) &&
        !tuple_like_uses_other_constructor<TupleLike>() &&
        !tuple_like_dangles<TupleLike>(index_sequence_for<Types...>{}))
      : tuple(allocator_arg, allocator, forward<TupleLike>(other),
              index_sequence_for<Types...>{}) {}

  template <class... U>
  constexpr tuple &operator=(const tuple<U...> &other)
    requires(sizeof...(U) == sizeof...(Types) &&
             (is_assignable_v<Types &, const U &> && ...))
  {
    assign(other, index_sequence_for<Types...>{});
    return *this;
  }

  template <class... U>
  constexpr tuple &operator=(tuple<U...> &&other)
    requires(sizeof...(U) == sizeof...(Types) &&
             (is_assignable_v<Types &, U> && ...))
  {
    assign(move(other), index_sequence_for<Types...>{});
    return *this;
  }

  template <class... U>
  constexpr const tuple &operator=(const tuple<U...> &other) const
    requires(sizeof...(U) == sizeof...(Types) &&
             (is_assignable_v<const Types &, const U &> && ...))
  {
    assign(other, index_sequence_for<Types...>{});
    return *this;
  }

  template <class... U>
  constexpr const tuple &operator=(tuple<U...> &&other) const
    requires(sizeof...(U) == sizeof...(Types) &&
             (is_assignable_v<const Types &, U> && ...))
  {
    assign(move(other), index_sequence_for<Types...>{});
    return *this;
  }

  template <class TupleLike>
  constexpr tuple &operator=(TupleLike &&other)
    requires(!detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
             detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
             tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
             tuple_like_assignable<TupleLike>(index_sequence_for<Types...>{}))
  {
    assign(forward<TupleLike>(other), index_sequence_for<Types...>{});
    return *this;
  }

  template <class TupleLike>
  constexpr const tuple &operator=(TupleLike &&other) const
    requires(
        !detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
        detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
        tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
        tuple_like_const_assignable<TupleLike>(index_sequence_for<Types...>{}))
  {
    assign(forward<TupleLike>(other), index_sequence_for<Types...>{});
    return *this;
  }

  constexpr void swap(tuple &other) noexcept((is_nothrow_swappable_v<Types> &&
                                              ...))
    requires(is_swappable_v<Types> && ...)
  {
    swap_impl(other, index_sequence_for<Types...>{});
  }

  constexpr void swap(const tuple &other) const
      noexcept((is_nothrow_swappable_v<const Types> && ...))
    requires(is_swappable_v<const Types> && ...)
  {
    swap_impl(other, index_sequence_for<Types...>{});
  }

private:
  template <class Other, size_t... I>
  constexpr tuple(Other &&other, index_sequence<I...>)
      : base(get<I>(forward<Other>(other))...) {}
  template <class Alloc, class Other, size_t... I>
  constexpr tuple(allocator_arg_t, const Alloc &alloc, Other &&other,
                  index_sequence<I...>)
      : base(allocator_arg, alloc, get<I>(forward<Other>(other))...) {}
  template <class Other, size_t... I>
  constexpr void assign(Other &&other, index_sequence<I...>) {
    ((get<I>(*this) = get<I>(forward<Other>(other))), ...);
  }
  template <class Other, size_t... I>
  constexpr void assign(Other &&other, index_sequence<I...>) const {
    ((get<I>(*this) = get<I>(forward<Other>(other))), ...);
  }
  template <class Other, size_t... I>
  constexpr void swap_impl(Other &other, index_sequence<I...>) {
    (detail::adl_swap(get<I>(*this), get<I>(other)), ...);
  }
  template <class Other, size_t... I>
  constexpr void swap_impl(Other &other, index_sequence<I...>) const {
    (detail::adl_swap(get<I>(*this), get<I>(other)), ...);
  }
};

template <class... Types, class Alloc>
struct uses_allocator<tuple<Types...>, Alloc> : true_type {};

template <class... T> tuple(T...) -> tuple<T...>;
template <class T1, class T2> tuple(pair<T1, T2>) -> tuple<T1, T2>;

template <class Alloc, class... U>
tuple(allocator_arg_t, Alloc, U...) -> tuple<U...>;

template <class Alloc, class First, class Second>
tuple(allocator_arg_t, Alloc, pair<First, Second>) -> tuple<First, Second>;

template <class Alloc, class... U>
tuple(allocator_arg_t, Alloc, tuple<U...>) -> tuple<U...>;

template <class... Types>
struct tuple_size<tuple<Types...>>
    : integral_constant<size_t, sizeof...(Types)> {};
template <size_t Index, class... Types>
struct tuple_element<Index, tuple<Types...>> {
  static_assert(Index < sizeof...(Types));
  using type = typename detail::nth_type<Index, Types...>::type;
};

template <size_t Index, class... Types>
constexpr tuple_element_t<Index, tuple<Types...>> &
get(tuple<Types...> &value) noexcept {
  using leaf =
      detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Types...>>>;
  return static_cast<leaf &>(value).value;
}
template <size_t Index, class... Types>
constexpr const tuple_element_t<Index, tuple<Types...>> &
get(const tuple<Types...> &value) noexcept {
  using leaf =
      detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Types...>>>;
  return static_cast<const leaf &>(value).value;
}
