namespace detail {
template <class T, class U>
constexpr auto tuple_compare_element(const T &left, const U &right) {
  if constexpr (requires { left <=> right; })
    return left <=> right;
  else if (left < right)
    return weak_ordering::less;
  else if (right < left)
    return weak_ordering::greater;
  else
    return weak_ordering::equivalent;
}

template <class Left, class Right, size_t... I>
constexpr auto tuple_compare_all(const Left &left, const Right &right,
                                 index_sequence<I...>) {
  using category = common_comparison_category_t<decltype(tuple_compare_element(
      get<I>(left), get<I>(right)))...>;
  auto compare = [&]<size_t Index>(auto &&self) -> category {
    if constexpr (Index == sizeof...(I))
      return category::equivalent;
    else {
      if (category result =
              tuple_compare_element(get<Index>(left), get<Index>(right));
          result != 0)
        return result;
      return self.template operator()<Index + 1>(self);
    }
  };
  return compare.template operator()<0>(compare);
}
} // namespace detail

template <class... T, class... U>
constexpr bool operator==(const tuple<T...> &left, const tuple<U...> &right)
  requires(sizeof...(T) == sizeof...(U))
{
  return [&]<size_t... I>(index_sequence<I...>) {
    return ((get<I>(left) == get<I>(right)) && ...);
  }(index_sequence_for<T...>{});
}

template <class... T, class... U>
constexpr auto operator<=>(const tuple<T...> &left, const tuple<U...> &right)
  requires(sizeof...(T) == sizeof...(U))
{
  return detail::tuple_compare_all(left, right, index_sequence_for<T...>{});
}

template <class... T, class TupleLike>
constexpr bool operator==(const tuple<T...> &left, const TupleLike &right)
  requires(!detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
           detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
           tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(T))
{
  return [&]<size_t... I>(index_sequence<I...>) {
    return ((get<I>(left) == get<I>(right)) && ...);
  }(index_sequence_for<T...>{});
}

template <class... T, class TupleLike>
constexpr auto operator<=>(const tuple<T...> &left, const TupleLike &right)
  requires(!detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
           detail::is_tuple_source<remove_cvref_t<TupleLike>>::value &&
           tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(T))
{
  return detail::tuple_compare_all(left, right, index_sequence_for<T...>{});
}

