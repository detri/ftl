template <class T, class... Types>
constexpr T &get(tuple<Types...> &value) noexcept {
  constexpr size_t index = []<size_t... I>(index_sequence<I...>) {
    size_t found = 0;
    ((is_same_v<T, Types> ? found = I : 0), ...);
    return found;
  }(index_sequence_for<Types...>{});
  static_assert(((is_same_v<T, Types> ? 1 : 0) + ...) == 1);
  return get<index>(value);
}
