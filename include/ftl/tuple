namespace detail {
template<class> struct is_tuple : false_type {};
template<class... T> struct is_tuple<tuple<T...>> : true_type {};
#if defined(_MSC_VER)
#define FTL_TUPLE_NO_UNIQUE_ADDRESS [[msvc::no_unique_address]]
#else
#define FTL_TUPLE_NO_UNIQUE_ADDRESS [[no_unique_address]]
#endif

template<size_t Index, class T>
struct tuple_leaf {
    FTL_TUPLE_NO_UNIQUE_ADDRESS T value;
    constexpr tuple_leaf() requires is_default_constructible_v<T> : value() {}
    template<class U> constexpr tuple_leaf(U&& item) : value(forward<U>(item)) {}
};

template<class Sequence, class... Types> struct tuple_base;
template<size_t... Index, class... Types>
struct tuple_base<index_sequence<Index...>, Types...> : tuple_leaf<Index, Types>... {
    constexpr tuple_base() requires (is_default_constructible_v<Types> && ...) = default;
    template<class... U>
    constexpr tuple_base(U&&... values)
        : tuple_leaf<Index, Types>(forward<U>(values))... {}
};

template<size_t Index, class Head, class... Tail>
struct nth_type : nth_type<Index - 1, Tail...> {};
template<class Head, class... Tail>
struct nth_type<0, Head, Tail...> { using type = Head; };

template<class Tuple, size_t... Index>
constexpr auto tuple_equal(const Tuple& left, const Tuple& right,
                           index_sequence<Index...>) {
    return ((get<Index>(left) == get<Index>(right)) && ...);
}

template<class F, class Tuple, size_t... Index>
constexpr decltype(auto) tuple_apply(F&& function, Tuple&& value,
                                     index_sequence<Index...>) {
    return detail::invoke(forward<F>(function), get<Index>(forward<Tuple>(value))...);
}
}

template<class... Types>
class tuple : public detail::tuple_base<index_sequence_for<Types...>, Types...> {
    using base = detail::tuple_base<index_sequence_for<Types...>, Types...>;

    template<class TupleLike, size_t... I>
    static consteval bool tuple_like_convertible(index_sequence<I...>) {
        return (is_convertible_v<decltype(get<I>(declval<TupleLike>())), Types> && ...);
    }

    template<class TupleLike, size_t... I>
    static consteval bool tuple_like_constructible(index_sequence<I...>) {
        return (is_constructible_v<Types,
            decltype(get<I>(declval<TupleLike>()))> && ...);
    }

    template<class TupleLike, size_t... I>
    static consteval bool tuple_like_assignable(index_sequence<I...>) {
        return (is_assignable_v<Types&,
            decltype(get<I>(declval<TupleLike>()))> && ...);
    }
public:
    constexpr explicit(!(detail::implicitly_default_constructible<Types> && ...))
    tuple() requires (is_default_constructible_v<Types> && ...) = default;

    constexpr explicit(!(is_convertible_v<const Types&, Types> && ...))
    tuple(const Types&... values) requires (sizeof...(Types) != 0)
        : base(values...) {}

    template<class... U>
    constexpr explicit(!(is_convertible_v<U, Types> && ...))
    tuple(U&&... values)
        requires (sizeof...(U) == sizeof...(Types) && sizeof...(Types) != 0 &&
                  (is_constructible_v<Types, U> && ...))
        : base(forward<U>(values)...) {}

    tuple(const tuple&) = default;
    tuple(tuple&&) = default;
    tuple& operator=(const tuple&) = default;
    tuple& operator=(tuple&&) = default;

    constexpr const tuple& operator=(const tuple& other) const
        requires (is_assignable_v<const Types&, const Types&> && ...) {
        assign(other, index_sequence_for<Types...>{}); return *this;
    }
    constexpr const tuple& operator=(tuple&& other) const
        requires (is_assignable_v<const Types&, Types> && ...) {
        assign(move(other), index_sequence_for<Types...>{}); return *this;
    }

    template<class... U>
    constexpr explicit(!(is_convertible_v<const U&, Types> && ...))
    tuple(const tuple<U...>& other)
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_constructible_v<Types, const U&> && ...))
        : tuple(other, index_sequence_for<Types...>{}) {}

    template<class... U>
    constexpr explicit(!(is_convertible_v<U, Types> && ...))
    tuple(tuple<U...>&& other)
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_constructible_v<Types, U> && ...))
        : tuple(move(other), index_sequence_for<Types...>{}) {}

    template<class TupleLike>
    constexpr explicit(!tuple_like_convertible<TupleLike>(
        index_sequence_for<Types...>{}))
    tuple(TupleLike&& other)
        requires (!detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
                  detail::is_library_pair_like<remove_cvref_t<TupleLike>>::value &&
                  tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
                  tuple_like_constructible<TupleLike>(
                      index_sequence_for<Types...>{}))
        : tuple(forward<TupleLike>(other), index_sequence_for<Types...>{}) {}

    template<class... U>
    constexpr tuple& operator=(const tuple<U...>& other)
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_assignable_v<Types&, const U&> && ...)) {
        assign(other, index_sequence_for<Types...>{}); return *this;
    }

    template<class... U>
    constexpr tuple& operator=(tuple<U...>&& other)
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_assignable_v<Types&, U> && ...)) {
        assign(move(other), index_sequence_for<Types...>{}); return *this;
    }

    template<class... U>
    constexpr const tuple& operator=(const tuple<U...>& other) const
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_assignable_v<const Types&, const U&> && ...)) {
        assign(other, index_sequence_for<Types...>{}); return *this;
    }

    template<class... U>
    constexpr const tuple& operator=(tuple<U...>&& other) const
        requires (sizeof...(U) == sizeof...(Types) &&
                  (is_assignable_v<const Types&, U> && ...)) {
        assign(move(other), index_sequence_for<Types...>{}); return *this;
    }

    template<class TupleLike>
    constexpr tuple& operator=(TupleLike&& other)
        requires (!detail::is_tuple<remove_cvref_t<TupleLike>>::value &&
                  detail::is_library_pair_like<remove_cvref_t<TupleLike>>::value &&
                  tuple_size_v<remove_cvref_t<TupleLike>> == sizeof...(Types) &&
                  tuple_like_assignable<TupleLike>(
                      index_sequence_for<Types...>{})) {
        assign(forward<TupleLike>(other), index_sequence_for<Types...>{}); return *this;
    }

    constexpr void swap(tuple& other)
        noexcept((is_nothrow_swappable_v<Types> && ...))
        requires (is_swappable_v<Types> && ...) {
        swap_impl(other, index_sequence_for<Types...>{});
    }

    constexpr void swap(const tuple& other) const
        noexcept((is_nothrow_swappable_v<const Types> && ...))
        requires (is_swappable_v<const Types> && ...) {
        swap_impl(other, index_sequence_for<Types...>{});
    }

private:
    template<class Other, size_t... I>
    constexpr tuple(Other&& other, index_sequence<I...>)
        : base(get<I>(forward<Other>(other))...) {}
    template<class Other, size_t... I>
    constexpr void assign(Other&& other, index_sequence<I...>) {
        ((get<I>(*this) = get<I>(forward<Other>(other))), ...);
    }
    template<class Other, size_t... I>
    constexpr void assign(Other&& other, index_sequence<I...>) const {
        ((get<I>(*this) = get<I>(forward<Other>(other))), ...);
    }
    template<class Other, size_t... I>
    constexpr void swap_impl(Other& other, index_sequence<I...>) {
        (detail::adl_swap(get<I>(*this), get<I>(other)), ...);
    }
    template<class Other, size_t... I>
    constexpr void swap_impl(Other& other, index_sequence<I...>) const {
        (detail::adl_swap(get<I>(*this), get<I>(other)), ...);
    }
};

template<class... T> tuple(T...) -> tuple<T...>;

template<class... Types>
struct tuple_size<tuple<Types...>> : integral_constant<size_t, sizeof...(Types)> {};
template<size_t Index, class... Types>
struct tuple_element<Index, tuple<Types...>> {
    static_assert(Index < sizeof...(Types));
    using type = typename detail::nth_type<Index, Types...>::type;
};

template<size_t Index, class... Types>
constexpr tuple_element_t<Index, tuple<Types...>>& get(tuple<Types...>& value) noexcept {
    using leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Types...>>>;
    return static_cast<leaf&>(value).value;
}
template<size_t Index, class... Types>
constexpr const tuple_element_t<Index, tuple<Types...>>& get(const tuple<Types...>& value) noexcept {
    using leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Types...>>>;
    return static_cast<const leaf&>(value).value;
}
template<size_t Index, class... Types>
constexpr tuple_element_t<Index, tuple<Types...>>&& get(tuple<Types...>&& value) noexcept {
    return move(get<Index>(value));
}
template<size_t Index, class... Types>
constexpr const tuple_element_t<Index, tuple<Types...>>&& get(const tuple<Types...>&& value) noexcept {
    return move(get<Index>(value));
}

template<class T, class... Types> constexpr T& get(tuple<Types...>& value) noexcept {
    constexpr size_t index = []<size_t... I>(index_sequence<I...>) {
        size_t found = 0; ((is_same_v<T, Types> ? found = I : 0), ...); return found;
    }(index_sequence_for<Types...>{});
    static_assert(((is_same_v<T, Types> ? 1 : 0) + ...) == 1);
    return get<index>(value);
}
template<class T, class... Types> constexpr const T& get(const tuple<Types...>& value) noexcept { return get<T>(const_cast<tuple<Types...>&>(value)); }
template<class T, class... Types> constexpr T&& get(tuple<Types...>&& value) noexcept { return move(get<T>(value)); }
template<class T, class... Types> constexpr const T&& get(const tuple<Types...>&& value) noexcept { return move(get<T>(value)); }

template<class... T, class... U>
constexpr bool operator==(const tuple<T...>& left, const tuple<U...>& right)
    requires (sizeof...(T) == sizeof...(U)) {
    return [&]<size_t... I>(index_sequence<I...>) { return ((get<I>(left) == get<I>(right)) && ...); }(index_sequence_for<T...>{});
}

template<class... T, class... U>
constexpr auto operator<=>(const tuple<T...>& left, const tuple<U...>& right)
    requires (sizeof...(T) == sizeof...(U)) {
    using category = common_comparison_category_t<
        decltype(compare_three_way{}(declval<const T&>(), declval<const U&>()))...>;
    auto compare = [&]<size_t Index>(auto&& self) -> category {
        if constexpr (Index == sizeof...(T)) return category::equivalent;
        else {
            if (category result = compare_three_way{}(get<Index>(left), get<Index>(right)); result != 0)
                return result;
            return self.template operator()<Index + 1>(self);
        }
    };
    return compare.template operator()<0>(compare);
}

template<class... T, class... U>
    requires (sizeof...(T) == sizeof...(U))
struct common_type<tuple<T...>, tuple<U...>> { using type = tuple<common_type_t<T, U>...>; };

template<class... T, class... U, template<class> class TQual, template<class> class UQual>
    requires (sizeof...(T) == sizeof...(U))
struct basic_common_reference<tuple<T...>, tuple<U...>, TQual, UQual> {
    using type = tuple<common_reference_t<TQual<T>, UQual<U>>...>;
};

template<class... Types>
constexpr void swap(tuple<Types...>& left, tuple<Types...>& right)
    noexcept(noexcept(left.swap(right))) requires requires { left.swap(right); } { left.swap(right); }

template<class... T> constexpr tuple<unwrap_ref_decay_t<T>...> make_tuple(T&&... value) { return {forward<T>(value)...}; }
template<class... T> constexpr tuple<T&&...> forward_as_tuple(T&&... value) noexcept { return tuple<T&&...>(forward<T>(value)...); }
template<class... T> constexpr tuple<T&...> tie(T&... value) noexcept { return tuple<T&...>(value...); }
namespace detail {
struct ignore_t { template<class T> constexpr const ignore_t& operator=(T&&) const noexcept { return *this; } };

template<class Left, class Right, size_t... L, size_t... R>
constexpr auto tuple_cat_two(Left&& left, Right&& right,
                             index_sequence<L...>, index_sequence<R...>) {
    return tuple<tuple_element_t<L, remove_cvref_t<Left>>...,
                 tuple_element_t<R, remove_cvref_t<Right>>...>(
        get<L>(forward<Left>(left))..., get<R>(forward<Right>(right))...);
}
}
inline constexpr detail::ignore_t ignore{};

template<class F, class Tuple>
constexpr decltype(auto) apply(F&& function, Tuple&& value) {
    return detail::tuple_apply(forward<F>(function), forward<Tuple>(value),
        make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}

template<class T, class Tuple>
constexpr T make_from_tuple(Tuple&& value) {
    return [&]<size_t... I>(index_sequence<I...>) -> T {
        return T(get<I>(forward<Tuple>(value))...);
    }(make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}

constexpr tuple<> tuple_cat() { return {}; }
template<class Tuple> constexpr auto tuple_cat(Tuple&& value) {
    return detail::tuple_cat_two(tuple<>{}, forward<Tuple>(value), index_sequence<>{},
        make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}
template<class First, class Second, class... Rest>
constexpr auto tuple_cat(First&& first, Second&& second, Rest&&... rest) {
    auto joined = detail::tuple_cat_two(forward<First>(first), forward<Second>(second),
        make_index_sequence<tuple_size_v<remove_reference_t<First>>>{},
        make_index_sequence<tuple_size_v<remove_reference_t<Second>>>{});
    return tuple_cat(move(joined), forward<Rest>(rest)...);
}

