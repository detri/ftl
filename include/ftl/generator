FTL_BEGIN_NAMESPACE

template<class Ref, class V = void, class Allocator = void>
class generator
    : public ranges::view_interface<
          generator<Ref, V, Allocator>
      > {
private:
    using value =
        conditional_t<
            is_void_v<V>,
            remove_cvref_t<Ref>,
            V
        >;

    using reference =
        conditional_t<
            is_void_v<V>,
            Ref&&,
            Ref
        >;

    using rvalue_reference =
        conditional_t<
            is_reference_v<reference>,
            remove_reference_t<reference>&&,
            reference
        >;

    static_assert(
        is_object_v<value> &&
        same_as<value, remove_cv_t<value>>,
        "generator value must be a cv-unqualified object type"
    );

    static_assert(
        is_reference_v<reference> ||
        (
            is_object_v<reference> &&
            same_as<reference, remove_cv_t<reference>> &&
            copy_constructible<reference>
        ),
        "generator reference must be a reference or a "
        "cv-unqualified copy-constructible object type"
    );

    static_assert(
        common_reference_with<reference&&, value&>
    );

    static_assert(
        common_reference_with<reference&&, rvalue_reference&&>
    );

    static_assert(
        common_reference_with<rvalue_reference&&, const value&>
    );

    class iterator;

public:
    using yielded =
        conditional_t<
            is_reference_v<reference>,
            reference,
            const reference&
        >;

    class promise_type {
    private:
    #if defined(__STDCPP_DEFAULT_NEW_ALIGNMENT__)
        static constexpr size_t allocation_alignment =
            __STDCPP_DEFAULT_NEW_ALIGNMENT__;
    #else
        static constexpr size_t allocation_alignment =
            alignof(max_align_t);
    #endif

        struct alignas(allocation_alignment) allocation_unit {
            unsigned char storage[allocation_alignment];
        };

        static_assert(
            sizeof(allocation_unit) == allocation_alignment
        );

        static_assert(
            alignof(allocation_unit) == allocation_alignment
        );

        struct allocation_header {
            using deallocate_function =
                void(*)(
                    void*,
                    allocation_header*
                ) noexcept;

            deallocate_function deallocate = nullptr;
            size_t unit_count = 0;
            size_t allocator_offset = 0;
        };

        [[nodiscard]]
        static constexpr size_t align_up(
            size_t value,
            size_t alignment
        ) noexcept {
            return (
                value + alignment - 1
            ) / alignment * alignment;
        }

        [[nodiscard]]
        static allocation_header* allocation_header_from(
            void* pointer,
            size_t frame_size
        ) noexcept {
            auto* bytes =
                static_cast<unsigned char*>(pointer);

            const size_t header_offset =
                align_up(
                    frame_size,
                    alignof(allocation_header)
                );

            return reinterpret_cast<allocation_header*>(
                bytes + header_offset
            );
        }

        template<class ReboundAllocator>
        static void deallocate_frame(
            void* pointer,
            allocation_header* header
        ) noexcept {
            using traits =
                allocator_traits<ReboundAllocator>;

            auto* bytes =
                static_cast<unsigned char*>(pointer);

            auto* stored_allocator =
                reinterpret_cast<ReboundAllocator*>(
                    bytes + header->allocator_offset
                );

            /*
             * Keep an equivalent allocator alive while the allocator
             * stored inside the frame allocation is destroyed.
             */
            ReboundAllocator allocator{
                *stored_allocator
            };

            const size_t unit_count =
                header->unit_count;

            destroy_at(stored_allocator);
            destroy_at(header);

            traits::deallocate(
                allocator,
                static_cast<allocation_unit*>(pointer),
                unit_count
            );
        }

        template<class SelectedAllocator>
        [[nodiscard]]
        static void* allocate_frame(
            size_t frame_size,
            const SelectedAllocator& allocator
        ) {
            using rebound_allocator =
                typename allocator_traits<
                    SelectedAllocator
                >::template rebind_alloc<
                    allocation_unit
                >;

            using rebound_traits =
                allocator_traits<rebound_allocator>;

            static_assert(
                is_pointer_v<
                    typename rebound_traits::pointer
                >,
                "generator frame allocator must use a raw pointer"
            );

            static_assert(
                alignof(rebound_allocator) <=
                    allocation_alignment,
                "generator frame allocator has unsupported "
                "over-alignment"
            );

            rebound_allocator rebound{
                allocator
            };

            const size_t header_offset =
                align_up(
                    frame_size,
                    alignof(allocation_header)
                );

            const size_t allocator_offset =
                align_up(
                    header_offset +
                        sizeof(allocation_header),
                    alignof(rebound_allocator)
                );

            const size_t total_size =
                allocator_offset +
                sizeof(rebound_allocator);

            const size_t unit_count =
                (
                    total_size +
                    sizeof(allocation_unit) -
                    1
                ) / sizeof(allocation_unit);

            allocation_unit* allocation =
                rebound_traits::allocate(
                    rebound,
                    unit_count
                );

            auto* bytes =
                reinterpret_cast<unsigned char*>(
                    allocation
                );

            auto* header =
                reinterpret_cast<allocation_header*>(
                    bytes + header_offset
                );

            auto* stored_allocator =
                reinterpret_cast<rebound_allocator*>(
                    bytes + allocator_offset
                );

    #if FTL_HAS_EXCEPTIONS
            bool header_constructed = false;

            try {
                construct_at(
                    header,
                    allocation_header{
                        &deallocate_frame<
                            rebound_allocator
                        >,
                        unit_count,
                        allocator_offset
                    }
                );

                header_constructed = true;

                construct_at(
                    stored_allocator,
                    rebound
                );
            } catch (...) {
                if (header_constructed) {
                    destroy_at(header);
                }

                rebound_traits::deallocate(
                    rebound,
                    allocation,
                    unit_count
                );

                throw;
            }
    #else
            construct_at(
                header,
                allocation_header{
                    &deallocate_frame<
                        rebound_allocator
                    >,
                    unit_count,
                    allocator_offset
                }
            );

            construct_at(
                stored_allocator,
                rebound
            );
    #endif

            return allocation;
        }

        template<class Stored>
        class copied_yield_awaiter {
        public:
            copied_yield_awaiter(
                promise_type& promise,
                const Stored& value
            )
                : promise_(
                      FTL_GENERATOR_NAMESPACE::addressof(promise)
                  ),
                  value_(value) {}

            [[nodiscard]]
            constexpr bool await_ready() const noexcept {
                return false;
            }

            void await_suspend(
                coroutine_handle<>
            ) noexcept {
                promise_->value_ =
                    FTL_GENERATOR_NAMESPACE::addressof(value_);
            }

            constexpr void await_resume() const noexcept {}

        private:
            promise_type* promise_;
            Stored value_;
        };

    public:
        [[nodiscard]]
        generator get_return_object() noexcept {
            return generator{
                coroutine_handle<promise_type>::from_promise(*this)
            };
        }

        [[nodiscard]]
        constexpr suspend_always
        initial_suspend() const noexcept {
            return {};
        }

        [[nodiscard]]
        constexpr suspend_always
        final_suspend() noexcept {
            return {};
        }

        [[nodiscard]]
        suspend_always yield_value(
            yielded value
        ) noexcept {
            value_ =
                FTL_GENERATOR_NAMESPACE::addressof(value);

            return {};
        }

        [[nodiscard]]
        auto yield_value(
            const remove_reference_t<yielded>& value
        )
            requires (
                is_rvalue_reference_v<yielded> &&
                constructible_from<
                    remove_cvref_t<yielded>,
                    const remove_reference_t<yielded>&
                >
            )
        {
            using stored_type =
                remove_cvref_t<yielded>;

            return copied_yield_awaiter<stored_type>{
                *this,
                value
            };
        }

        void await_transform() = delete;

        constexpr void return_void() const noexcept {}

        void unhandled_exception() {
#if FTL_HAS_EXCEPTIONS
            exception_ =
                FTL_GENERATOR_NAMESPACE::current_exception();
#else
            FTL_GENERATOR_NAMESPACE::terminate();
#endif
        }

        [[nodiscard]]
        static void* operator new(
            size_t size
        )
            requires (
                same_as<Allocator, void> ||
                default_initializable<Allocator>
            )
        {
            if constexpr (same_as<Allocator, void>) {
                allocator<void> allocator;
                return allocate_frame(
                    size,
                    allocator
                );
            } else {
                Allocator allocator;
                return allocate_frame(
                    size,
                    allocator
                );
            }
        }

        template<class Alloc, class... Args>
            requires (
                same_as<Allocator, void> ||
                convertible_to<
                    const Alloc&,
                    Allocator
                >
            )
        [[nodiscard]]
        static void* operator new(
            size_t size,
            allocator_arg_t,
            const Alloc& allocator,
            const Args&...
        ) {
            if constexpr (same_as<Allocator, void>) {
                return allocate_frame(
                    size,
                    allocator
                );
            } else {
                Allocator selected{
                    allocator
                };

                return allocate_frame(
                    size,
                    selected
                );
            }
        }

        template<
            class This,
            class Alloc,
            class... Args
        >
            requires (
                same_as<Allocator, void> ||
                convertible_to<
                    const Alloc&,
                    Allocator
                >
            )
        [[nodiscard]]
        static void* operator new(
            size_t size,
            const This&,
            allocator_arg_t,
            const Alloc& allocator,
            const Args&...
        ) {
            if constexpr (same_as<Allocator, void>) {
                return allocate_frame(
                    size,
                    allocator
                );
            } else {
                Allocator selected{
                    allocator
                };

                return allocate_frame(
                    size,
                    selected
                );
            }
        }

        static void operator delete(
            void* pointer,
            size_t size
        ) noexcept {
            allocation_header* header =
                allocation_header_from(
                    pointer,
                    size
                );

            header->deallocate(
                pointer,
                header
            );
        }

    private:
        friend class generator;
        friend class iterator;

        void rethrow_if_exception() {
#if FTL_HAS_EXCEPTIONS
            if (exception_) {
                FTL_GENERATOR_NAMESPACE::rethrow_exception(
                    exception_
                );
            }
#endif
        }

        add_pointer_t<yielded> value_ = nullptr;

#if FTL_HAS_EXCEPTIONS
        exception_ptr exception_{};
#endif
    };

private:
    class iterator {
    public:
        using value_type = value;
        using difference_type = ptrdiff_t;

        iterator(iterator&& other) noexcept
            : coroutine_(
                  FTL_GENERATOR_NAMESPACE::exchange(
                      other.coroutine_,
                      nullptr
                  )
              ) {}

        iterator& operator=(iterator&& other) noexcept {
            coroutine_ =
                FTL_GENERATOR_NAMESPACE::exchange(
                    other.coroutine_,
                    nullptr
                );

            return *this;
        }

        [[nodiscard]]
        reference operator*() const
            noexcept(
                is_nothrow_copy_constructible_v<reference>
            )
        {
            return static_cast<reference>(
                *coroutine_.promise().value_
            );
        }

        iterator& operator++() {
            coroutine_.resume();

            if (coroutine_.done()) {
                coroutine_.promise().rethrow_if_exception();
            }

            return *this;
        }

        void operator++(int) {
            ++*this;
        }

        [[nodiscard]]
        friend bool operator==(
            const iterator& value,
            default_sentinel_t
        ) {
            return value.coroutine_.done();
        }

    private:
        friend class generator;

        explicit iterator(
            coroutine_handle<promise_type> coroutine
        ) noexcept
            : coroutine_(coroutine) {}

        coroutine_handle<promise_type> coroutine_;
    };

public:
    generator(const generator&) = delete;

    generator(generator&& other) noexcept
        : coroutine_(
              FTL_GENERATOR_NAMESPACE::exchange(
                  other.coroutine_,
                  nullptr
              )
          ) {}

    ~generator() {
        if (coroutine_) {
            coroutine_.destroy();
        }
    }

    generator& operator=(generator other) noexcept {
        auto previous =
            FTL_GENERATOR_NAMESPACE::exchange(
                coroutine_,
                other.coroutine_
            );

        other.coroutine_ = previous;

        return *this;
    }

    [[nodiscard]]
    iterator begin() {
        coroutine_.resume();

        if (coroutine_.done()) {
            coroutine_.promise().rethrow_if_exception();
        }

        return iterator{coroutine_};
    }

    [[nodiscard]]
    default_sentinel_t end() const noexcept {
        return default_sentinel;
    }

private:
    explicit generator(
        coroutine_handle<promise_type> coroutine
    ) noexcept
        : coroutine_(coroutine) {}

    coroutine_handle<promise_type> coroutine_ = nullptr;
};

namespace pmr {

template<class R, class V = void>
using generator =
    FTL_GENERATOR_NAMESPACE::generator<
        R,
        V,
        polymorphic_allocator<>
    >;

} // namespace pmr

FTL_END_NAMESPACE

#undef FTL_GENERATOR_NAMESPACE

#endif // FTL_GENERATOR_HEADER
