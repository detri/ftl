enum class chars_format {
  scientific = 1,
  fixed = 2,
  hex = 4,
  general = fixed | scientific
};

constexpr chars_format operator&(chars_format left,
                                 chars_format right) noexcept {
  return static_cast<chars_format>(static_cast<unsigned>(left) &
                                   static_cast<unsigned>(right));
}

constexpr chars_format operator|(chars_format left,
                                 chars_format right) noexcept {
  return static_cast<chars_format>(static_cast<unsigned>(left) |
                                   static_cast<unsigned>(right));
}

constexpr chars_format operator^(chars_format left,
                                 chars_format right) noexcept {
  return static_cast<chars_format>(static_cast<unsigned>(left) ^
                                   static_cast<unsigned>(right));
}

constexpr chars_format operator~(chars_format value) noexcept {
  return static_cast<chars_format>(~static_cast<unsigned>(value));
}

constexpr chars_format &operator&=(chars_format &left,
                                   chars_format right) noexcept {
  return left = left & right;
}

constexpr chars_format &operator|=(chars_format &left,
                                   chars_format right) noexcept {
  return left = left | right;
}

constexpr chars_format &operator^=(chars_format &left,
                                   chars_format right) noexcept {
  return left = left ^ right;
}

struct to_chars_result {
  char *ptr;
  errc ec;

  friend constexpr bool operator==(const to_chars_result &,
                                   const to_chars_result &) = default;
};

struct from_chars_result {
  const char *ptr;
  errc ec;

  friend constexpr bool operator==(const from_chars_result &,
                                   const from_chars_result &) = default;
};

namespace charconv_detail {
template<class T>
inline constexpr bool is_charconv_integer_v =
    is_integral_v<T> && !is_same_v<T, bool> && !is_same_v<T, wchar_t> &&
    !is_same_v<T, char8_t> && !is_same_v<T, char16_t> &&
    !is_same_v<T, char32_t>;

[[nodiscard]]
constexpr unsigned digit_value(char value) noexcept {
  if (value >= '0' && value <= '9')
    return static_cast<unsigned>(value - '0');

  if (value >= 'a' && value <= 'z')
    return static_cast<unsigned>(value - 'a') + 10u;

  if (value >= 'A' && value <= 'Z')
    return static_cast<unsigned>(value - 'A') + 10u;

  return 255u;
}

[[nodiscard]]
constexpr char digit_character(unsigned value) noexcept {
  return value < 10u ? static_cast<char>('0' + value)
                     : static_cast<char>('a' + value - 10u);
}

template <class Integer>
using unsigned_integer_t = make_unsigned_t<remove_cv_t<Integer>>;

template <class Integer>
[[nodiscard]]
constexpr unsigned_integer_t<Integer>
unsigned_magnitude(Integer value) noexcept {
  using integer_type = remove_cv_t<Integer>;
  using unsigned_type = unsigned_integer_t<Integer>;

  if constexpr (is_signed_v<integer_type>) {
    if (value < 0) {
      /*
       * Converting first and subtracting in the unsigned
       * domain handles the minimum signed value without
       * signed overflow.
       */
      return unsigned_type{} - static_cast<unsigned_type>(value);
    }
  }

  return static_cast<unsigned_type>(value);
}

template <class Integer>
constexpr to_chars_result integer_to_chars(char *first, char *last,
                                           Integer value, int base) noexcept {
  using integer_type = remove_cv_t<Integer>;
  using unsigned_type = unsigned_integer_t<Integer>;

  const bool negative = is_signed_v<integer_type> && value < 0;

  unsigned_type magnitude = unsigned_magnitude(value);

  /*
   * 128 bits in base 2 plus a sign is enough even when
   * extension integer types eventually participate.
   */
  char reversed[numeric_limits<unsigned_type>::digits + 1];

  size_t count = 0;

  do {
    const unsigned digit =
        static_cast<unsigned>(magnitude % static_cast<unsigned_type>(base));

    reversed[count++] = digit_character(digit);

    magnitude /= static_cast<unsigned_type>(base);
  } while (magnitude != 0);

  const size_t required = count + static_cast<size_t>(negative);

  if (static_cast<size_t>(last - first) < required)
    return {last, errc::value_too_large};

  char *output = first;

  if (negative)
    *output++ = '-';

  while (count != 0)
    *output++ = reversed[--count];

  return {output, errc{}};
}

template <class Integer>
constexpr from_chars_result
integer_from_chars(const char *first, const char *last, Integer &destination,
                   int base) noexcept {
  using integer_type = remove_cv_t<Integer>;
  using unsigned_type = unsigned_integer_t<Integer>;

  const char *current = first;

  bool negative = false;

  if constexpr (is_signed_v<integer_type>) {
    if (current != last && *current == '-') {
      negative = true;
      ++current;
    }
  }

  const char *digits_begin = current;

  constexpr unsigned_type positive_limit =
      static_cast<unsigned_type>(numeric_limits<integer_type>::max());

  unsigned_type limit = numeric_limits<unsigned_type>::max();

  if constexpr (is_signed_v<integer_type>) {
    if (negative) {
      limit = positive_limit;
      ++limit;
    } else {
      limit = positive_limit;
    }
  }

  unsigned_type value = 0;
  bool overflow = false;

  while (current != last) {
    const unsigned digit = digit_value(*current);

    if (digit >= static_cast<unsigned>(base))
      break;

    const auto converted_digit = static_cast<unsigned_type>(digit);

    if (!overflow) {
      if (value >
          (limit - converted_digit) / static_cast<unsigned_type>(base)) {
        overflow = true;
      } else {
        value = value * static_cast<unsigned_type>(base) + converted_digit;
      }
    }

    ++current;
  }

  if (current == digits_begin)
    return {first, errc::invalid_argument};

  if (overflow)
    return {current, errc::result_out_of_range};

  if constexpr (is_signed_v<integer_type>) {
    if (negative) {
      if (value == positive_limit + unsigned_type{1}) {
        destination = numeric_limits<integer_type>::min();
      } else {
        destination =
            static_cast<integer_type>(-static_cast<integer_type>(value));
      }

      return {current, errc{}};
    }
  }

  destination = static_cast<integer_type>(value);

  return {current, errc{}};
}

[[nodiscard]]
constexpr ::ftl_float_conversion::decimal_exponent_mode
floating_decimal_exponent_mode(chars_format format) noexcept {
  if (format == chars_format::scientific) {
    return ::ftl_float_conversion::decimal_exponent_mode::required;
  }

  if (format == chars_format::fixed) {
    return ::ftl_float_conversion::decimal_exponent_mode::forbidden;
  }

  return ::ftl_float_conversion::decimal_exponent_mode::optional;
}

template <class Float>
[[nodiscard]]
inline from_chars_result
floating_from_chars(const char *first, const char *last, Float &destination,
                    chars_format format) noexcept {
  /*
   * Special values are part of the inherited
   * strtod subject-sequence grammar and are
   * independent of decimal/hex formatting mode.
   */
  {
    const auto special =
        ::ftl_float_conversion::scan_floating_special<Float>(first, last);

    if (special.status ==
        ::ftl_float_conversion::floating_special_scan_status::success) {
      destination = special.value;

      return {special.ptr, errc{}};
    }
  }

  if (format == chars_format::hex) {
    const auto scanned =
        ::ftl_float_conversion::scan_hexadecimal<Float>(first, last);

    if (scanned.status ==
        ::ftl_float_conversion::hexadecimal_scan_status::no_match) {
      return {first, errc::invalid_argument};
    }

    const auto converted =
        ::ftl_float_conversion::hexadecimal_to_binary<Float>(scanned.number);

    if (converted.status !=
        ::ftl_float_conversion::conversion_status::success) {
      return {scanned.ptr, errc::result_out_of_range};
    }

    destination = converted.value;

    return {scanned.ptr, errc{}};
  }

  const auto scanned = ::ftl_float_conversion::scan_decimal<Float>(
      first, last, floating_decimal_exponent_mode(format));

  if (scanned.status == ::ftl_float_conversion::decimal_scan_status::no_match) {
    return {first, errc::invalid_argument};
  }

  const auto converted =
      ::ftl_float_conversion::decimal_to_binary<Float>(scanned.number);

  if (converted.status != ::ftl_float_conversion::conversion_status::success) {
    return {scanned.ptr, errc::result_out_of_range};
  }

  destination = converted.value;

  return {scanned.ptr, errc{}};
}

template <class Float>
[[nodiscard]]
inline to_chars_result floating_to_chars_precision(
    char* first, char* last, Float value,
    chars_format format, int precision) noexcept {
  namespace conversion = ::ftl_float_conversion;

  const auto result = [&]() -> conversion::floating_format_result {
    if (precision < 0) {
      /*
       * A negative printf precision is treated as omitted.
       *
       * f/e/g use their default precision of 6.
       * a uses enough hexadecimal digits for an exact representation.
       */
      switch (format) {
      case chars_format::fixed:
        return conversion::format_fixed_precision(first, last, value, 6);

      case chars_format::scientific:
        return conversion::format_scientific_precision(first, last, value, 6);

      case chars_format::general:
        return conversion::format_general_precision(first, last, value, 6);

      case chars_format::hex:
        return conversion::format_hexadecimal_default_precision(
            first, last, value);
      }
    }

    const auto converted_precision = static_cast<unsigned>(precision);

    switch (format) {
    case chars_format::fixed:
      return conversion::format_fixed_precision(
          first, last, value, converted_precision);

    case chars_format::scientific:
      return conversion::format_scientific_precision(
          first, last, value, converted_precision);

    case chars_format::general:
      return conversion::format_general_precision(
          first, last, value, converted_precision);

    case chars_format::hex:
      return conversion::format_hexadecimal_precision(
          first, last, value, converted_precision);
    }

    /*
     * N4950 requires format to be one of the chars_format enumerators,
     * so reaching this point means the caller violated the precondition.
     */
    return {last, conversion::floating_format_status::value_too_large};
  }();

  if (result.status == conversion::floating_format_status::success)
    return {result.ptr, errc{}};

  return {last, errc::value_too_large};
}

