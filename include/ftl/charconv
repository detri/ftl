namespace charconv_detail {

namespace floating_conversion = ::ftl_float_conversion;
namespace floating_detail =
    ::ftl_float_conversion::floating_conversion_detail;

template <class Float>
[[nodiscard]]
inline bool same_floating_value(Float left, Float right) {
  const auto left_parts = floating_conversion::decompose(left);
  const auto right_parts = floating_conversion::decompose(right);

  return left_parts.kind == right_parts.kind &&
         left_parts.negative == right_parts.negative &&
         left_parts.significand == right_parts.significand &&
         left_parts.exponent == right_parts.exponent;
}

template <class Emit>
inline void emit_shortest_scientific(
    const floating_detail::shortest_decimal_representation& value,
    bool negative,
    Emit&& emit) {
  if (negative)
    emit('-');

  emit(value.digits[0]);

  if (value.digit_count > 1) {
    emit('.');

    for (unsigned index = 1; index < value.digit_count; ++index)
      emit(value.digits[index]);
  }

  const long long scientific_exponent =
      value.exponent +
      static_cast<long long>(value.digit_count) - 1;

  floating_detail::emit_scientific_exponent(
      scientific_exponent,
      static_cast<Emit&&>(emit));
}

template <class Emit>
inline void emit_shortest_fixed(
    const floating_detail::shortest_decimal_representation& value,
    bool negative,
    Emit&& emit) {
  if (negative)
    emit('-');

  const long long point =
      static_cast<long long>(value.digit_count) + value.exponent;

  if (point <= 0) {
    emit('0');
    emit('.');

    for (long long index = 0; index < -point; ++index)
      emit('0');

    for (unsigned index = 0; index < value.digit_count; ++index)
      emit(value.digits[index]);

    return;
  }

  if (point >= static_cast<long long>(value.digit_count)) {
    for (unsigned index = 0; index < value.digit_count; ++index)
      emit(value.digits[index]);

    for (long long index = value.digit_count; index < point; ++index)
      emit('0');

    return;
  }

  for (long long index = 0; index < point; ++index)
    emit(value.digits[index]);

  emit('.');

  for (unsigned index = static_cast<unsigned>(point);
       index < value.digit_count;
       ++index)
    emit(value.digits[index]);
}

[[nodiscard]]
inline size_t shortest_scientific_length(
    const floating_detail::shortest_decimal_representation& value,
    bool negative) {
  const long long scientific_exponent =
      value.exponent +
      static_cast<long long>(value.digit_count) - 1;

  return static_cast<size_t>(negative) +
         value.digit_count +
         static_cast<size_t>(value.digit_count > 1) +
         2 +
         floating_detail::decimal_exponent_digits(scientific_exponent);
}

[[nodiscard]]
inline size_t shortest_fixed_length(
    const floating_detail::shortest_decimal_representation& value,
    bool negative) {
  const long long point =
      static_cast<long long>(value.digit_count) + value.exponent;

  const size_t sign = static_cast<size_t>(negative);

  if (point <= 0) {
    return sign +
           2 +
           static_cast<size_t>(-point) +
           value.digit_count;
  }

  if (point >= static_cast<long long>(value.digit_count))
    return sign + static_cast<size_t>(point);

  return sign + value.digit_count + 1;
}

template <class Float>
[[nodiscard]]
inline bool decimal_representation_round_trips(
    const floating_detail::shortest_decimal_representation& candidate,
    bool negative,
    Float original) {
  char text[
      floating_detail::shortest_decimal_digit_capacity + 16]{};

  char* output = text;

  emit_shortest_scientific(
      candidate,
      negative,
      [&](char character) {
        *output++ = character;
      });

  Float parsed{};

  const auto result =
      from_chars(
          text,
          output,
          parsed,
          chars_format::scientific);

  return result.ec == errc{} &&
         result.ptr == output &&
         same_floating_value(parsed, original);
}

template <class Float>
[[nodiscard]]
inline bool find_shortest_decimal(
    Float value,
    floating_detail::shortest_decimal_representation& result) {
  const auto parts = floating_conversion::decompose(value);

  if (parts.kind == floating_conversion::floating_kind::zero) {
    result = {};
    result.digits[0] = '0';
    result.digit_count = 1;
    result.exponent = 0;
    return true;
  }

  if (parts.kind != floating_conversion::floating_kind::finite)
    return false;

  floating_detail::exact_decimal_digits exact{};

  if (!floating_detail::build_exact_decimal_digits(parts, exact))
    return false;

  unsigned maximum_digits =
      static_cast<unsigned>(numeric_limits<Float>::max_digits10);

  if (exact.count < maximum_digits)
    maximum_digits = static_cast<unsigned>(exact.count);

  for (unsigned digits = 1; digits <= maximum_digits; ++digits) {
    floating_conversion::uint128 nearest{};
    long long exponent = 0;

    if (!floating_detail::rounded_decimal_significand(
            exact, digits, nearest, exponent))
      return false;

    /*
     * First try the numerically nearest decimal at this
     * precision. If it round-trips, it is necessarily the
     * standard's preferred candidate.
     */
    {
      floating_detail::shortest_decimal_representation candidate{};

      if (!floating_detail::make_shortest_decimal_representation(
              nearest, exponent, candidate))
        return false;

      if (decimal_representation_round_trips(
              candidate, parts.negative, value)) {
        result = candidate;
        return true;
      }
    }

    /*
     * At a power-of-two boundary the round-trip interval is
     * asymmetric. Rarely, the nearest decimal lies outside
     * that interval while the adjacent decimal on the wider
     * side lies inside it.
     *
     * Testing both immediate neighbours is sufficient because
     * the round-trip interval is contiguous. If both neighbours
     * were inside, the nearer candidate between them would also
     * be inside.
     */
    {
      auto lower = nearest;

      if (floating_detail::decrement_uint128(lower)) {
        floating_detail::shortest_decimal_representation candidate{};

        if (!floating_detail::make_shortest_decimal_representation(
                lower, exponent, candidate))
          return false;

        if (decimal_representation_round_trips(
                candidate, parts.negative, value)) {
          result = candidate;
          return true;
        }
      }
    }

    {
      auto upper = nearest;
      floating_detail::increment_uint128(upper);

      floating_detail::shortest_decimal_representation candidate{};

      if (!floating_detail::make_shortest_decimal_representation(
              upper, exponent, candidate))
        return false;

      if (decimal_representation_round_trips(
              candidate, parts.negative, value)) {
        result = candidate;
        return true;
      }
    }
  }

  return false;
}

template <class Float>
[[nodiscard]]
inline to_chars_result write_shortest_fixed(
    char* first,
    char* last,
    Float value,
    const floating_detail::shortest_decimal_representation& decimal) {
  const auto parts = floating_conversion::decompose(value);

  const size_t required =
      shortest_fixed_length(decimal, parts.negative);

  if (static_cast<size_t>(last - first) < required)
    return {last, errc::value_too_large};

  char* output = first;

  emit_shortest_fixed(
      decimal,
      parts.negative,
      [&](char character) {
        *output++ = character;
      });

  return {output, errc{}};
}

template <class Float>
[[nodiscard]]
inline to_chars_result write_shortest_scientific(
