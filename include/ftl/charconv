template <class Float>
[[nodiscard]]
inline to_chars_result floating_to_chars_shortest_hexadecimal(
    char* first,
    char* last,
    Float value) {
  const auto parts = floating_conversion::decompose(value);

  if (parts.kind == floating_conversion::floating_kind::infinity ||
      parts.kind == floating_conversion::floating_kind::nan) {
    return floating_to_chars_precision(
        first, last, value, chars_format::fixed, 0);
  }

  if (parts.kind == floating_conversion::floating_kind::zero) {
    const size_t required =
        static_cast<size_t>(parts.negative) + 4;

    if (static_cast<size_t>(last - first) < required)
      return {last, errc::value_too_large};

    char* output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = '0';
    *output++ = 'p';
    *output++ = '+';
    *output++ = '0';

    return {output, errc{}};
  }

  const unsigned width =
      floating_detail::bit_width_uint128(parts.significand);

  /*
   * Normalize every finite nonzero value to 1.x * 2^e.
   * This also gives subnormals their shortest useful %a
   * representation, e.g. binary64 denorm_min -> 1p-1074.
   */
  const unsigned fractional_bits = width - 1;
  const unsigned hexadecimal_digits =
      (fractional_bits + 3) / 4;

  const unsigned padded_width =
      1 + hexadecimal_digits * 4;

  const unsigned padding = padded_width - width;

  const auto scaled =
      floating_detail::shift_left_uint128(
          parts.significand,
          padding);

  unsigned first_fractional_digit = 0;

  while (first_fractional_digit < hexadecimal_digits &&
         floating_detail::uint128_hexadecimal_digit(
             scaled, first_fractional_digit) == 0) {
    ++first_fractional_digit;
  }

  const unsigned emitted_fractional_digits =
      hexadecimal_digits - first_fractional_digit;

  const long long exponent =
      static_cast<long long>(parts.exponent) +
      static_cast<long long>(width - 1);

  const size_t required =
      static_cast<size_t>(parts.negative) +
      1 +
      (emitted_fractional_digits != 0
           ? 1 + emitted_fractional_digits
           : 0) +
      2 +
      floating_detail::hexadecimal_exponent_digits(exponent);

  if (static_cast<size_t>(last - first) < required)
    return {last, errc::value_too_large};

  char* output = first;

  if (parts.negative)
    *output++ = '-';

  *output++ =
      floating_detail::hexadecimal_digit_character(
          floating_detail::uint128_hexadecimal_digit(
              scaled, hexadecimal_digits));

  if (emitted_fractional_digits != 0) {
    *output++ = '.';

    for (unsigned index = hexadecimal_digits;
         index > first_fractional_digit;
         --index) {
      *output++ =
          floating_detail::hexadecimal_digit_character(
              floating_detail::uint128_hexadecimal_digit(
                  scaled, index - 1));
    }
  }

  floating_detail::emit_hexadecimal_exponent(
      exponent,
      [&](char character) {
        *output++ = character;
      });

  return {output, errc{}};
}

template <class Float>
[[nodiscard]]
inline to_chars_result floating_to_chars_shortest(
    char* first,
    char* last,
    Float value,
    chars_format format) {
  const auto parts = floating_conversion::decompose(value);

  if (parts.kind == floating_conversion::floating_kind::infinity ||
      parts.kind == floating_conversion::floating_kind::nan) {
    return floating_to_chars_precision(
        first, last, value, chars_format::fixed, 0);
  }

  if (format == chars_format::hex)
    return floating_to_chars_shortest_hexadecimal(
        first, last, value);

  floating_detail::shortest_decimal_representation decimal{};

  if (!find_shortest_decimal(value, decimal))
    return {last, errc::value_too_large};

  switch (format) {
  case chars_format::fixed:
    return write_shortest_fixed(
        first, last, value, decimal);

  case chars_format::scientific:
    return write_shortest_scientific(
        first, last, value, decimal);

  case chars_format::general: {
    /*
     * With no explicit precision, printf's %g uses P=6
     * solely to select fixed versus scientific notation.
     * The significand itself remains the shortest
     * round-tripping decimal we found above.
     */
    const long long exponent =
        decimal.exponent +
        static_cast<long long>(decimal.digit_count) - 1;

    if (exponent >= -4 && exponent < 6) {
      return write_shortest_fixed(
          first, last, value, decimal);
    }

    return write_shortest_scientific(
        first, last, value, decimal);
  }

  case chars_format::hex:
    break;
  }

  return {last, errc::value_too_large};
}

template <class Float>
[[nodiscard]]
inline to_chars_result floating_to_chars_shortest(
    char* first,
    char* last,
    Float value) {
  const auto parts = floating_conversion::decompose(value);

  if (parts.kind == floating_conversion::floating_kind::infinity ||
      parts.kind == floating_conversion::floating_kind::nan) {
    return floating_to_chars_precision(
        first, last, value, chars_format::fixed, 0);
  }

  floating_detail::shortest_decimal_representation decimal{};

  if (!find_shortest_decimal(value, decimal))
    return {last, errc::value_too_large};

  const size_t fixed_length =
      shortest_fixed_length(decimal, parts.negative);

  const size_t scientific_length =
      shortest_scientific_length(decimal, parts.negative);

  /*
   * The no-format overload chooses whichever of %f and
   * %e is shorter. Fixed wins an equal-length tie.
   */
  if (fixed_length <= scientific_length) {
    return write_shortest_fixed(
        first, last, value, decimal);
  }

  return write_shortest_scientific(
      first, last, value, decimal);
}

