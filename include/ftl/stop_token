FTL_STOP_TOKEN_BEGIN_NAMESPACE

class stop_token;
class stop_source;

template <class Callback> class stop_callback;

struct nostopstate_t {
  explicit nostopstate_t() = default;
};

inline constexpr nostopstate_t nostopstate{};

namespace detail {

struct stop_callback_base {
  using invoke_fn = void (*)(stop_callback_base *) noexcept;

  explicit stop_callback_base(invoke_fn invoke) noexcept : invoke_(invoke) {}

  void invoke() noexcept { invoke_(this); }

  invoke_fn invoke_;
  stop_callback_base *previous_ = nullptr;
  stop_callback_base *next_ = nullptr;

  atomic<bool> completed_{false};

  bool registered_ = false;
  bool executing_ = false;
  bool *destroyed_ = nullptr;
};

class stop_state;

inline thread_local stop_state *active_stop_state = nullptr;

class stop_state {
public:
  stop_state() = default;

  void add_source() noexcept {
    source_count_.fetch_add(1, memory_order_relaxed);
  }

  void remove_source() noexcept {
    source_count_.fetch_sub(1, memory_order_relaxed);
  }

  [[nodiscard]] bool stop_requested() const noexcept {
    return requested_.load(memory_order_acquire);
  }

  [[nodiscard]] bool stop_possible_for_token() const noexcept {
    if (requested_.load(memory_order_acquire))
      return true;

    return source_count_.load(memory_order_acquire) != 0;
  }

  bool request_stop() noexcept {
    lock_callbacks();

    if (requested_.load(memory_order_relaxed)) {
      unlock_callbacks();
      return false;
    }

    requested_.store(true, memory_order_release);

    while (head_ != nullptr) {
      stop_callback_base *callback = head_;

      unlink_callback(callback);

      callback->registered_ = false;
      callback->executing_ = true;

      unlock_callbacks();

      bool destroyed = false;
      callback->destroyed_ = &destroyed;

      stop_state *previous_state = active_stop_state;

      active_stop_state = this;

      callback->invoke();

      active_stop_state = previous_state;

      if (!destroyed) {
        callback->destroyed_ = nullptr;

        callback->completed_.store(true, memory_order_release);

        callback->completed_.notify_all();
      }

      lock_callbacks();
    }

    unlock_callbacks();
    return true;
  }

  bool add_callback(stop_callback_base *callback) noexcept {
    lock_callbacks();

    if (requested_.load(memory_order_relaxed)) {
      unlock_callbacks();

      callback->invoke();
      return false;
    }

    if (source_count_.load(memory_order_relaxed) == 0) {
      unlock_callbacks();
      return false;
    }

    callback->previous_ = nullptr;
    callback->next_ = head_;

    if (head_ != nullptr)
      head_->previous_ = callback;

    head_ = callback;
    callback->registered_ = true;

    unlock_callbacks();
    return true;
  }

  void remove_callback(stop_callback_base *callback) noexcept {
    lock_callbacks();

    if (callback->registered_) {
      unlink_callback(callback);
      callback->registered_ = false;

      unlock_callbacks();
      return;
    }

    if (callback->executing_) {
      const bool same_thread = active_stop_state == this;

      if (same_thread) {
        if (callback->destroyed_ != nullptr)
          *callback->destroyed_ = true;

        unlock_callbacks();
        return;
      }

      unlock_callbacks();

      callback->completed_.wait(false, memory_order_acquire);

      return;
    }

    unlock_callbacks();
  }

private:
  void lock_callbacks() noexcept {
    while (callback_lock_.test_and_set(memory_order_acquire)) {
      callback_lock_.wait(true, memory_order_relaxed);
    }
  }

  void unlock_callbacks() noexcept {
    callback_lock_.clear(memory_order_release);

    callback_lock_.notify_one();
  }

  void unlink_callback(stop_callback_base *callback) noexcept {
    if (callback->previous_ != nullptr)
      callback->previous_->next_ = callback->next_;
    else
      head_ = callback->next_;

    if (callback->next_ != nullptr)
      callback->next_->previous_ = callback->previous_;

    callback->previous_ = nullptr;
    callback->next_ = nullptr;
  }

  atomic<bool> requested_{false};
  atomic<unsigned int> source_count_{0};

  atomic_flag callback_lock_{};

  stop_callback_base *head_ = nullptr;
};

} // namespace detail

class stop_token {
  friend class stop_source;

  template <class> friend class stop_callback;

public:
  stop_token() noexcept = default;

  stop_token(const stop_token &) noexcept = default;
  stop_token(stop_token &&) noexcept = default;

  stop_token &operator=(const stop_token &) noexcept = default;

  stop_token &operator=(stop_token &&) noexcept = default;

  ~stop_token() = default;

  void swap(stop_token &other) noexcept { state_.swap(other.state_); }

  [[nodiscard]] bool stop_requested() const noexcept {
    return state_ != nullptr && state_->stop_requested();
  }

  [[nodiscard]] bool stop_possible() const noexcept {
    return state_ != nullptr && state_->stop_possible_for_token();
  }

  [[nodiscard]] friend bool operator==(const stop_token &left,
                                       const stop_token &right) noexcept {
    return left.state_.get() == right.state_.get();
  }

  friend void swap(stop_token &left, stop_token &right) noexcept {
    left.swap(right);
  }

private:
  explicit stop_token(shared_ptr<detail::stop_state> state) noexcept
      : state_(move(state)) {}

  shared_ptr<detail::stop_state> state_;
};

class stop_source {
public:
  stop_source() : state_(make_shared<detail::stop_state>()) {
    state_->add_source();
  }

  explicit stop_source(nostopstate_t) noexcept {}

  stop_source(const stop_source &other) noexcept : state_(other.state_) {
    if (state_ != nullptr)
      state_->add_source();
  }

  stop_source(stop_source &&other) noexcept : state_(move(other.state_)) {}

  stop_source &operator=(const stop_source &other) noexcept {
    stop_source(other).swap(*this);
    return *this;
  }

  stop_source &operator=(stop_source &&other) noexcept {
    stop_source(move(other)).swap(*this);
    return *this;
  }

  ~stop_source() {
    if (state_ != nullptr)
      state_->remove_source();
  }

  void swap(stop_source &other) noexcept { state_.swap(other.state_); }

  [[nodiscard]] stop_token get_token() const noexcept {
    if (state_ == nullptr)
      return stop_token{};

    return stop_token{state_};
  }

  [[nodiscard]] bool stop_possible() const noexcept {
    return state_ != nullptr;
  }

  [[nodiscard]] bool stop_requested() const noexcept {
    return state_ != nullptr && state_->stop_requested();
  }

  bool request_stop() noexcept {
    return state_ != nullptr && state_->request_stop();
  }

  [[nodiscard]] friend bool operator==(const stop_source &left,
                                       const stop_source &right) noexcept {
    return left.state_.get() == right.state_.get();
  }

  friend void swap(stop_source &left, stop_source &right) noexcept {
    left.swap(right);
  }

private:
  shared_ptr<detail::stop_state> state_;
};

template <class Callback>
class stop_callback : private detail::stop_callback_base {
  static_assert(is_invocable_v<Callback>);
  static_assert(is_destructible_v<Callback>);

public:
  using callback_type = Callback;

  template <class C>
    requires constructible_from<Callback, C>
  explicit stop_callback(const stop_token &token, C &&callback) noexcept(
      is_nothrow_constructible_v<Callback, C>)
      : detail::stop_callback_base(&stop_callback::invoke_callback),
        callback_(forward<C>(callback)) {
    register_callback(token);
  }

  template <class C>
    requires constructible_from<Callback, C>
  explicit stop_callback(stop_token &&token, C &&callback) noexcept(
      is_nothrow_constructible_v<Callback, C>)
      : detail::stop_callback_base(&stop_callback::invoke_callback),
        callback_(forward<C>(callback)) {
    register_callback(token);
  }

  ~stop_callback() {
    if (state_ != nullptr)
      state_->remove_callback(this);
  }

  stop_callback(const stop_callback &) = delete;
  stop_callback(stop_callback &&) = delete;

  stop_callback &operator=(const stop_callback &) = delete;

  stop_callback &operator=(stop_callback &&) = delete;

private:
  static void invoke_callback(detail::stop_callback_base *base) noexcept {
    auto *self = static_cast<stop_callback *>(base);

    forward<Callback>(self->callback_)();
  }

  void register_callback(const stop_token &token) noexcept {
    if (token.state_ == nullptr)
      return;

    if (token.state_->add_callback(this))
      state_ = token.state_;
  }

  Callback callback_;
  shared_ptr<detail::stop_state> state_;
};

template <class Callback>
stop_callback(stop_token, Callback) -> stop_callback<Callback>;

FTL_STOP_TOKEN_END_NAMESPACE

