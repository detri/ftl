template <class T, class Deleter, class = void> struct unique_ptr_pointer {
  using type = T *;
};

template <class T, class Deleter>
struct unique_ptr_pointer<
    T, Deleter, void_t<typename remove_reference_t<Deleter>::pointer>> {
  using type = typename remove_reference_t<Deleter>::pointer;
};

template <class Candidate, class Pointer, class T,
          bool = is_pointer_v<Candidate>>
struct unique_ptr_array_pointer : is_same<Candidate, Pointer> {};

template <class Candidate, class Pointer, class T>
struct unique_ptr_array_pointer<Candidate, Pointer, T, true>
    : bool_constant<
          is_same_v<Candidate, Pointer> ||
          (is_same_v<Pointer, T *> &&
           is_convertible_v<remove_pointer_t<Candidate> (*)[], T (*)[]>)> {};
} // namespace detail

template <class T> struct default_delete {
  constexpr default_delete() noexcept = default;

  template <class U>
    requires is_convertible_v<U *, T *>
  constexpr default_delete(const default_delete<U> &) noexcept {}

  constexpr void operator()(T *pointer) const {
    static_assert(sizeof(T) > 0, "cannot delete an incomplete type");
    delete pointer;
  }
};

template <class T> struct default_delete<T[]> {
  constexpr default_delete() noexcept = default;

  template <class U>
    requires is_convertible_v<U (*)[], T (*)[]>
  constexpr default_delete(const default_delete<U[]> &) noexcept {}

  template <class U>
    requires is_convertible_v<U (*)[], T (*)[]>
  constexpr void operator()(U *pointer) const {
    static_assert(sizeof(U) > 0, "cannot delete an incomplete type");
    delete[] pointer;
  }
};

template <class T> constexpr T *addressof(T &value) noexcept {
#if defined(_MSC_VER) || __has_builtin(__builtin_addressof)
  return __builtin_addressof(value);
#else
  return reinterpret_cast<T *>(
      &const_cast<char &>(reinterpret_cast<const volatile char &>(value)));
#endif
}

template <class T> const T *addressof(const T &&) = delete;

template <class T, class... Args>
  requires requires(T *location, Args &&...args) {
    ::new (static_cast<void *>(location)) T(forward<Args>(args)...);
  }
constexpr T *construct_at(T *location, Args &&...args) {
  FTL_MSVC_CONSTEXPR
  return ::new (static_cast<void *>(location)) T(forward<Args>(args)...);
}

template <class T> constexpr void destroy_at(T *location) {
  if constexpr (is_array_v<T>) {
    for (auto &element : *location)
      destroy_at(addressof(element));
  } else {
    location->~T();
  }
}

template <class ForwardIterator>
constexpr void destroy(ForwardIterator first, ForwardIterator last) {
  for (; first != last; ++first)
    destroy_at(addressof(*first));
}

template <class ForwardIterator, class Size>
constexpr ForwardIterator destroy_n(ForwardIterator first, Size count) {
  for (; count > 0; --count, ++first)
    destroy_at(addressof(*first));

  return first;
}

template <class InputIterator, class ForwardIterator>
constexpr ForwardIterator uninitialized_copy(InputIterator first,
                                             InputIterator last,
                                             ForwardIterator output) {
  auto current = output;

#if FTL_HAS_EXCEPTIONS
  try {
#endif
    for (; first != last; ++first, ++current)
      construct_at(addressof(*current), *first);

    return current;

#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    destroy(output, current);
    throw;
  }
#endif
}

