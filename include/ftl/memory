template <class T, class Allocator, class... Args>
  requires(!is_array_v<T>)
shared_ptr<T> allocate_shared(const Allocator &allocator, Args &&...args) {
  using block = detail::allocator_inplace_control_block<T, Allocator>;

  using block_allocator =
      typename allocator_traits<Allocator>::template rebind_alloc<block>;

  block_allocator rebound{allocator};

  block *owner = allocator_traits<block_allocator>::allocate(rebound, 1);

#if FTL_HAS_EXCEPTIONS
  try {
#endif
    allocator_traits<block_allocator>::construct(rebound, owner, allocator,
                                                 forward<Args>(args)...);

#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    allocator_traits<block_allocator>::deallocate(rebound, owner, 1);

    throw;
  }
#endif

  shared_ptr<T> result;
  result.pointer_value = owner->pointer();
  result.control = owner;
  result.enable_weak_this(result.pointer_value);
  return result;
}

template <class T, class... Args>
  requires(!is_array_v<T>)
shared_ptr<T> make_shared(Args &&...args) {
  return allocate_shared<T>(allocator<T>{}, forward<Args>(args)...);
}

namespace detail {
template <class T> constexpr size_t array_inner_leaf_count() noexcept {
  if constexpr (is_array_v<T>)
    return extent_v<T> * array_inner_leaf_count<remove_extent_t<T>>();
  else
    return 1;
}

template <class ElementAllocator, class ObjectElement,
          bool UseAllocatorDestroy>
struct allocated_array_deleter {
  ElementAllocator allocator;
  size_t constructed_count;
  size_t allocated_count;

  using element = typename allocator_traits<ElementAllocator>::value_type;
  template <class Pointer> void operator()(Pointer storage) noexcept {
    void *raw = const_cast<void *>(
        static_cast<const volatile void *>(storage));
    element *pointer = static_cast<element *>(raw);
    ObjectElement *objects = reinterpret_cast<ObjectElement *>(pointer);
    for (size_t index = constructed_count; index != 0; --index) {
      if constexpr (UseAllocatorDestroy)
        allocator_traits<ElementAllocator>::destroy(allocator,
                                                     objects + index - 1);
      else
        destroy_at(objects + index - 1);
    }
    allocator_traits<ElementAllocator>::deallocate(allocator, pointer,
                                                   allocated_count);
  }
};

template <class T>
constexpr const remove_all_extents_t<T> &array_leaf_at(const T &value,
                                                       size_t index) noexcept {
  if constexpr (is_array_v<T>) {
    constexpr size_t inner = array_inner_leaf_count<remove_extent_t<T>>();
    return array_leaf_at(value[index / inner], index % inner);
  } else {
    (void)index;
    return value;
  }
}

template <class T, bool UseAllocatorConstruct, class A, class Constructor>
shared_ptr<T> allocate_shared_array(const A &source_allocator,
                                    size_t outer_count,
                                    Constructor construct) {
  using outer_element = remove_extent_t<T>;
  using object_leaf = remove_all_extents_t<T>;
  using leaf = remove_cv_t<object_leaf>;
  using element_allocator =
      typename allocator_traits<A>::template rebind_alloc<leaf>;
  element_allocator allocator(source_allocator);
  constexpr size_t inner_count = array_inner_leaf_count<outer_element>();
  const size_t maximum = allocator_traits<element_allocator>::max_size(allocator);
  if (inner_count != 0 && outer_count > maximum / inner_count)
  {
#if FTL_HAS_EXCEPTIONS
    throw bad_array_new_length{};
#else
    terminate();
#endif
  }
  const size_t count = outer_count * inner_count;
  const size_t allocated_count = count == 0 ? 1 : count;
  if (allocated_count > maximum) {
#if FTL_HAS_EXCEPTIONS
    throw bad_array_new_length{};
#else
    terminate();
#endif
  }
  leaf *data =
      allocator_traits<element_allocator>::allocate(allocator, allocated_count);
  object_leaf *objects = reinterpret_cast<object_leaf *>(data);
  outer_element *object_data;
  if constexpr (is_array_v<outer_element>)
    object_data = start_lifetime_as_array<outer_element>(data, outer_count);
  else
    object_data = reinterpret_cast<outer_element *>(data);
  size_t built = 0;
#if FTL_HAS_EXCEPTIONS
  try {
#endif
    for (; built < count; ++built) {
      if constexpr (UseAllocatorConstruct)
        construct(allocator, objects + built, built % inner_count);
      else
        ::new (static_cast<void *>(data + built)) object_leaf;
    }
#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    while (built != 0) {
      if constexpr (UseAllocatorConstruct)
        allocator_traits<element_allocator>::destroy(allocator,
                                                       objects + --built);
      else
        destroy_at(objects + --built);
    }
    allocator_traits<element_allocator>::deallocate(allocator, data,
                                                     allocated_count);
    throw;
  }
#endif
  using deleter =
      allocated_array_deleter<element_allocator, object_leaf,
                              UseAllocatorConstruct>;
  return shared_ptr<T>(object_data,
                       deleter{allocator, count, allocated_count},
                       source_allocator);
}
} // namespace detail

