  constexpr I operator()(I first, S last, const T &value) const {
    I current = first;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      for (; current != last; ++current)
        FTL_MEMORY_NAMESPACE::construct_at(addressof(*current), value);

      return current;

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
