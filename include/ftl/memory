template<class T, class Deleter = default_delete<T>>
class unique_ptr;

template<class T, class Deleter>
class unique_ptr {
    template<class, class>
    friend class unique_ptr;

public:
    using pointer = typename detail::unique_ptr_pointer<T, Deleter>::type;
    using element_type = T;
    using deleter_type = Deleter;

    constexpr unique_ptr() noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : deleter{}, pointer_value{} {}

    constexpr unique_ptr(nullptr_t) noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : unique_ptr{} {}

    explicit constexpr unique_ptr(pointer value) noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : deleter{}, pointer_value{value} {}

    constexpr unique_ptr(pointer value, const Deleter& value_deleter) noexcept
        requires is_constructible_v<Deleter, const Deleter&>
        : deleter{value_deleter}, pointer_value{value} {}

    constexpr unique_ptr(pointer value, Deleter&& value_deleter) noexcept
        requires (!is_reference_v<Deleter> &&
                  is_constructible_v<Deleter, Deleter&&>)
        : deleter{move(value_deleter)}, pointer_value{value} {}

    constexpr unique_ptr(unique_ptr&& other) noexcept
        requires is_move_constructible_v<Deleter>
        : deleter{forward<Deleter>(other.deleter)},
          pointer_value{other.release()} {}

    template<class U, class OtherDeleter>
        requires (!is_array_v<U> &&
                  is_convertible_v<
                      typename unique_ptr<U, OtherDeleter>::pointer,
                      pointer> &&
                  (is_reference_v<Deleter>
                       ? is_same_v<Deleter, OtherDeleter>
                       : is_convertible_v<OtherDeleter, Deleter>))
    constexpr unique_ptr(unique_ptr<U, OtherDeleter>&& other) noexcept
        : deleter{forward<OtherDeleter>(other.get_deleter())},
          pointer_value{other.release()} {}

    unique_ptr& operator=(unique_ptr&& other) noexcept
        requires is_move_assignable_v<Deleter>
    {
        if (this != addressof(other)) {
            reset(other.release());
            deleter = forward<Deleter>(other.deleter);
        }
        return *this;
    }

    template<class U, class OtherDeleter>
        requires (!is_array_v<U> &&
                  is_convertible_v<U*, pointer> &&
                  is_assignable_v<Deleter&, OtherDeleter&&>)
    constexpr unique_ptr& operator=(
        unique_ptr<U, OtherDeleter>&& other) noexcept {
        reset(other.release());
        deleter = forward<OtherDeleter>(other.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    constexpr ~unique_ptr() noexcept {
        if (pointer_value)
            deleter(pointer_value);
    }

    [[nodiscard]] constexpr pointer get() const noexcept {
        return pointer_value;
    }

    [[nodiscard]] constexpr Deleter& get_deleter() noexcept {
        return deleter;
    }

    [[nodiscard]] constexpr const Deleter& get_deleter() const noexcept {
        return deleter;
    }

    [[nodiscard]] constexpr explicit operator bool() const noexcept {
        return pointer_value != nullptr;
    }

    [[nodiscard]] constexpr pointer release() noexcept {
        return exchange(pointer_value, nullptr);
    }

    constexpr void reset(pointer replacement = pointer{}) noexcept {
        pointer old = exchange(pointer_value, replacement);
        if (old)
            deleter(old);
    }

    constexpr void swap(unique_ptr& other)
        noexcept(noexcept(FTL_MEMORY_NAMESPACE::swap(
            deleter, other.deleter))) {
        FTL_MEMORY_NAMESPACE::swap(deleter, other.deleter);
        FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
    }

    [[nodiscard]] constexpr pointer operator->() const noexcept {
        return pointer_value;
    }

    constexpr T& operator*() const noexcept {
        return *pointer_value;
    }

private:
    FTL_NO_UNIQUE_ADDRESS Deleter deleter;
    pointer pointer_value;
};

template<class T, class Deleter>
class unique_ptr<T[], Deleter> {
    template<class, class>
    friend class unique_ptr;

public:
    using pointer = typename detail::unique_ptr_pointer<T, Deleter>::type;
    using element_type = T;
    using deleter_type = Deleter;

    constexpr unique_ptr() noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : deleter{}, pointer_value{} {}

    constexpr unique_ptr(nullptr_t) noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : unique_ptr{} {}

    template<class U>
        requires detail::unique_ptr_array_pointer<U, pointer, T>::value
    explicit constexpr unique_ptr(U value) noexcept
        requires (!is_pointer_v<Deleter> &&
                  is_default_constructible_v<Deleter>)
        : deleter{}, pointer_value{value} {}

    template<class U>
        requires detail::unique_ptr_array_pointer<U, pointer, T>::value
    constexpr unique_ptr(U value, const Deleter& value_deleter) noexcept
        requires is_constructible_v<Deleter, const Deleter&>
        : deleter{value_deleter}, pointer_value{value} {}

    template<class U>
        requires detail::unique_ptr_array_pointer<U, pointer, T>::value
    constexpr unique_ptr(U value, Deleter&& value_deleter) noexcept
        requires (!is_reference_v<Deleter> &&
                  is_constructible_v<Deleter, Deleter&&>)
        : deleter{move(value_deleter)}, pointer_value{value} {}

    constexpr unique_ptr(unique_ptr&& other) noexcept
        requires is_move_constructible_v<Deleter>
        : deleter{forward<Deleter>(other.deleter)},
          pointer_value{other.release()} {}

    template<class U, class OtherDeleter>
        requires (is_convertible_v<
                      typename unique_ptr<U[], OtherDeleter>::pointer,
                      pointer> &&
                  is_convertible_v<U(*)[], T(*)[]> &&
                  (is_reference_v<Deleter>
                       ? is_same_v<Deleter, OtherDeleter>
                       : is_convertible_v<OtherDeleter, Deleter>))
    constexpr unique_ptr(unique_ptr<U[], OtherDeleter>&& other) noexcept
        : deleter{forward<OtherDeleter>(other.get_deleter())},
          pointer_value{other.release()} {}

    constexpr unique_ptr& operator=(unique_ptr&& other) noexcept
        requires is_move_assignable_v<Deleter> {
        if (this != addressof(other)) {
            reset(other.release());
            deleter = forward<Deleter>(other.deleter);
        }
        return *this;
    }

    template<class U, class OtherDeleter>
        requires (is_convertible_v<
                      typename unique_ptr<U[], OtherDeleter>::pointer,
                      pointer> &&
                  is_convertible_v<U(*)[], T(*)[]> &&
                  is_assignable_v<Deleter&, OtherDeleter&&>)
    constexpr unique_ptr& operator=(
        unique_ptr<U[], OtherDeleter>&& other) noexcept {
        reset(other.release());
        deleter = forward<OtherDeleter>(other.get_deleter());
        return *this;
    }

    constexpr unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    constexpr ~unique_ptr() noexcept {
        if (pointer_value)
            deleter(pointer_value);
    }

    [[nodiscard]] constexpr pointer get() const noexcept {
        return pointer_value;
    }

    [[nodiscard]] constexpr Deleter& get_deleter() noexcept {
        return deleter;
    }

    [[nodiscard]] constexpr const Deleter& get_deleter() const noexcept {
        return deleter;
    }

    [[nodiscard]] constexpr explicit operator bool() const noexcept {
        return pointer_value != nullptr;
    }

    [[nodiscard]] constexpr pointer release() noexcept {
        return exchange(pointer_value, nullptr);
    }

    template<class U>
        requires detail::unique_ptr_array_pointer<U, pointer, T>::value
    constexpr void reset(U replacement) noexcept {
        pointer old = exchange(pointer_value, replacement);
        if (old)
            deleter(old);
    }

    constexpr void reset(nullptr_t = nullptr) noexcept {
        pointer old = exchange(pointer_value, nullptr);
        if (old)
            deleter(old);
    }

    constexpr void swap(unique_ptr& other)
        noexcept(noexcept(FTL_MEMORY_NAMESPACE::swap(
            deleter, other.deleter))) {
        FTL_MEMORY_NAMESPACE::swap(deleter, other.deleter);
        FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
    }

    constexpr T& operator[](size_t index) const {
        return pointer_value[index];
    }

private:
    FTL_NO_UNIQUE_ADDRESS Deleter deleter;
    pointer pointer_value;
};

namespace detail {
struct shared_control_block {
    atomic<long> strong{1};
    atomic<long> weak{1};

    virtual void destroy_object() noexcept = 0;
    virtual void destroy_block() noexcept = 0;
    virtual void* deleter_address(const void*) noexcept { return nullptr; }

    void add_strong() noexcept {
        strong.fetch_add(1, memory_order_relaxed);
    }

    bool try_add_strong() noexcept {
        long current = strong.load(memory_order_acquire);
        while (current != 0) {
            if (strong.compare_exchange_weak(
                    current, current + 1,
                    memory_order_acquire, memory_order_relaxed))
                return true;
        }
        return false;
    }

    void add_weak() noexcept {
        weak.fetch_add(1, memory_order_relaxed);
    }

    void release_strong() noexcept {
        if (strong.fetch_sub(1, memory_order_acq_rel) == 1) {
            destroy_object();
            release_weak();
        }
    }

    void release_weak() noexcept {
        if (weak.fetch_sub(1, memory_order_acq_rel) == 1)
            destroy_block();
    }

protected:
    ~shared_control_block() = default;
};

template<class Pointer, class Deleter>
struct pointer_control_block final : shared_control_block {
    FTL_NO_UNIQUE_ADDRESS Deleter deleter;
    Pointer pointer;

    template<class D>
    pointer_control_block(Pointer value, D&& value_deleter)
        : deleter{forward<D>(value_deleter)}, pointer{value} {}

    void destroy_object() noexcept override { deleter(pointer); }

    void destroy_block() noexcept override {
        this->~pointer_control_block();
        ::operator delete(this);
    }

    void* deleter_address(const void* type) noexcept override {
        static const int id{};
        return type == &id ? addressof(deleter) : nullptr;
    }

    static const void* deleter_id() noexcept {
        static const int id{};
        return &id;
    }
};

template<class Block, class... Args>
Block* make_control_block(Args&&... args) {
    void* storage = ::operator new(sizeof(Block));
    try {
        return construct_at(
            static_cast<Block*>(storage), forward<Args>(args)...);
    } catch (...) {
        ::operator delete(storage);
        throw;
    }
}

