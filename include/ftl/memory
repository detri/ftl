namespace detail {
template <class Smart, class = void> struct smart_pointer {
  using type = typename Smart::element_type *;
};
template <class Smart>
struct smart_pointer<Smart, void_t<typename Smart::pointer>> {
  using type = typename Smart::pointer;
};
template <class T> struct smart_pointer<T *, void> {
  using type = T *;
};
template <class Requested, class Smart>
using out_pointer_t =
    conditional_t<is_void_v<Requested>, typename smart_pointer<Smart>::type,
                  Requested>;
} // namespace detail

template <class Smart, class Pointer, class... Args> class out_ptr_t {
  Smart &smart;
  tuple<Args...> arguments;
  Pointer pointer{};

public:
  explicit out_ptr_t(Smart &value, Args... args)
      : smart(value), arguments(forward<Args>(args)...) {
    if constexpr (is_pointer_v<Smart>)
      smart = nullptr;
    else
      smart.reset();
  }
  out_ptr_t(const out_ptr_t &) = delete;
  ~out_ptr_t() {
    if constexpr (is_pointer_v<Smart>)
      smart = static_cast<Smart>(pointer);
    else
      apply(
          [&](auto &&...args) {
            smart.reset(pointer, forward<decltype(args)>(args)...);
          },
          move(arguments));
  }
  operator Pointer *() noexcept { return addressof(pointer); }
  operator void **() const noexcept
    requires is_same_v<Pointer, void *>
  {
    return reinterpret_cast<void **>(const_cast<Pointer *>(addressof(pointer)));
  }
};

template <class Pointer = void, class Smart, class... Args>
auto out_ptr(Smart &smart, Args &&...args) {
  using result_pointer = detail::out_pointer_t<Pointer, Smart>;
  return out_ptr_t<Smart, result_pointer, Args &&...>(smart,
                                                      forward<Args>(args)...);
}

template <class Smart, class Pointer, class... Args> class inout_ptr_t {
  Smart &smart;
  tuple<Args...> arguments;
  Pointer pointer;

public:
  explicit inout_ptr_t(Smart &value, Args... args)
      : smart(value), arguments(forward<Args>(args)...), pointer([&] {
          if constexpr (is_pointer_v<Smart>)
            return static_cast<Pointer>(value);
          else
            return static_cast<Pointer>(value.release());
        }()) {}
  inout_ptr_t(const inout_ptr_t &) = delete;
  ~inout_ptr_t() {
    if constexpr (is_pointer_v<Smart>)
      smart = static_cast<Smart>(pointer);
    else
      apply(
          [&](auto &&...args) {
            smart.reset(pointer, forward<decltype(args)>(args)...);
          },
          move(arguments));
  }
  operator Pointer *() noexcept { return addressof(pointer); }
  operator void **() const noexcept
    requires is_same_v<Pointer, void *>
  {
    return reinterpret_cast<void **>(const_cast<Pointer *>(addressof(pointer)));
  }
};

template <class Pointer = void, class Smart, class... Args>
auto inout_ptr(Smart &smart, Args &&...args) {
  using result_pointer = detail::out_pointer_t<Pointer, Smart>;
  return inout_ptr_t<Smart, result_pointer, Args &&...>(smart,
                                                        forward<Args>(args)...);
}

