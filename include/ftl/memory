template <class T, class A>
  requires(!is_array_v<T>)
shared_ptr<T> allocate_shared_for_overwrite(const A &allocator) {
  using rebound = typename allocator_traits<A>::template rebind_alloc<T>;
  rebound a(allocator);
  T *pointer = allocator_traits<rebound>::allocate(a, 1);
#if FTL_HAS_EXCEPTIONS
  try {
#endif
    ::new (static_cast<void *>(pointer)) T;
#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    allocator_traits<rebound>::deallocate(a, pointer, 1);
    throw;
  }
#endif
  return shared_ptr<T>(pointer,
                       detail::allocated_array_deleter<rebound, T, false>{a, 1,
                                                                         1},
                       allocator);
}
