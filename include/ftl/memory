struct replace_allocator_value;

template<template<class, class...> class Allocator,
         class U, class... Args, class T>
struct replace_allocator_value<Allocator<U, Args...>, T> {
    using type = Allocator<T, Args...>;
};

template<class Allocator, class T,
         bool = requires {
             typename Allocator::template rebind<T>::other;
         }>
struct allocator_rebind {
    using type =
        typename replace_allocator_value<Allocator, T>::type;
};

template<class Allocator, class T>
struct allocator_rebind<Allocator, T, true> {
    using type = typename Allocator::template rebind<T>::other;
};

#define FTL_DETAIL_ALLOCATOR_FLAG(NAME, DEFAULT)                 \
    template<class Allocator, class = void>                      \
    struct allocator_##NAME { using type = DEFAULT; };           \
    template<class Allocator>                                    \
    struct allocator_##NAME<                                    \
        Allocator, void_t<typename Allocator::NAME>> {           \
        using type = typename Allocator::NAME;                   \
    }

FTL_DETAIL_ALLOCATOR_FLAG(
    propagate_on_container_copy_assignment, false_type);
FTL_DETAIL_ALLOCATOR_FLAG(
    propagate_on_container_move_assignment, false_type);
FTL_DETAIL_ALLOCATOR_FLAG(propagate_on_container_swap, false_type);
FTL_DETAIL_ALLOCATOR_FLAG(is_always_equal, is_empty<Allocator>);

#undef FTL_DETAIL_ALLOCATOR_FLAG
}

template<class Allocator>
struct allocator_traits {
    using allocator_type = Allocator;
    using value_type = typename Allocator::value_type;
    using pointer = typename detail::allocator_pointer<Allocator>::type;
    using const_pointer =
        typename detail::allocator_const_pointer<Allocator, pointer>::type;
    using void_pointer =
        typename detail::allocator_void_pointer<Allocator, pointer>::type;
    using const_void_pointer =
        typename detail::allocator_const_void_pointer<Allocator, pointer>::type;
    using difference_type =
        typename detail::allocator_difference<Allocator>::type;
    using size_type =
        typename detail::allocator_size<Allocator, difference_type>::type;

    using propagate_on_container_copy_assignment =
        typename detail::allocator_propagate_on_container_copy_assignment<
            Allocator>::type;
    using propagate_on_container_move_assignment =
        typename detail::allocator_propagate_on_container_move_assignment<
            Allocator>::type;
    using propagate_on_container_swap =
        typename detail::allocator_propagate_on_container_swap<
            Allocator>::type;
    using is_always_equal =
        typename detail::allocator_is_always_equal<Allocator>::type;

    template<class T>
    using rebind_alloc =
        typename detail::allocator_rebind<Allocator, T>::type;

    template<class T>
    using rebind_traits = allocator_traits<rebind_alloc<T>>;

    [[nodiscard]] static constexpr pointer allocate(
        Allocator& allocator, size_type count) {
        return allocator.allocate(count);
    }

    [[nodiscard]] static constexpr pointer allocate(
        Allocator& allocator, size_type count, const_void_pointer hint) {
        if constexpr (requires { allocator.allocate(count, hint); })
            return allocator.allocate(count, hint);
        else
            return allocator.allocate(count);
    }

    [[nodiscard]] static constexpr allocation_result<pointer, size_type>
    allocate_at_least(Allocator& allocator, size_type count) {
        if constexpr (requires { allocator.allocate_at_least(count); })
            return allocator.allocate_at_least(count);
        else
            return {allocator.allocate(count), count};
    }

    static constexpr void deallocate(
        Allocator& allocator, pointer value, size_type count) {
        allocator.deallocate(value, count);
    }

    template<class T, class... Args>
    static constexpr void construct(
        Allocator& allocator, T* value, Args&&... args) {
        if constexpr (requires {
            allocator.construct(value, forward<Args>(args)...);
        })
            allocator.construct(value, forward<Args>(args)...);
        else
            construct_at(value, forward<Args>(args)...);
    }

    template<class T>
    static constexpr void destroy(Allocator& allocator, T* value) {
        if constexpr (requires { allocator.destroy(value); })
            allocator.destroy(value);
        else
            destroy_at(value);
    }

    [[nodiscard]] static constexpr size_type max_size(
        const Allocator& allocator) noexcept {
        if constexpr (requires { allocator.max_size(); })
            return allocator.max_size();
        else
            return size_type(-1) / sizeof(value_type);
    }

    [[nodiscard]] static constexpr Allocator
    select_on_container_copy_construction(const Allocator& allocator) {
        if constexpr (requires {
            allocator.select_on_container_copy_construction();
        })
            return allocator.select_on_container_copy_construction();
        else
            return allocator;
    }
};

namespace detail {
template<class T, class Allocator>
struct allocator_inplace_control_block final : shared_control_block {
    FTL_NO_UNIQUE_ADDRESS Allocator allocator;
    alignas(T) unsigned char storage[sizeof(T)];

    template<class... Args>
    allocator_inplace_control_block(
        const Allocator& value_allocator, Args&&... args)
        : allocator{value_allocator} {
        construct_at(pointer(), forward<Args>(args)...);
    }

    T* pointer() noexcept {
        return launder(reinterpret_cast<T*>(storage));
    }

    void destroy_object() noexcept override { destroy_at(pointer()); }

    void destroy_block() noexcept override {
        using block = allocator_inplace_control_block;
        using block_allocator =
            typename allocator_traits<Allocator>
                ::template rebind_alloc<block>;
        Allocator saved_allocator = allocator;
        this->~block();
        block_allocator rebound{saved_allocator};
        allocator_traits<block_allocator>::deallocate(
            rebound, this, 1);
    }
};
}

class bad_weak_ptr : public exception {
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad_weak_ptr";
    }
};

template<class T>
class shared_ptr {
    static_assert(!is_bounded_array_v<T>);

    template<class>
    friend class shared_ptr;
    template<class>
    friend class weak_ptr;
    template<class U, class... Args>
        requires (!is_array_v<U>)
    friend shared_ptr<U> make_shared(Args&&...);
    template<class U, class Allocator, class... Args>
        requires (!is_array_v<U>)
    friend shared_ptr<U> allocate_shared(
        const Allocator&, Args&&...);

public:
    using element_type = remove_extent_t<T>;
    using weak_type = weak_ptr<T>;

    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    template<class U>
        requires detail::shared_pointer_compatible_v<U, T>
    explicit shared_ptr(U* value)
        : shared_ptr(
              value,
              conditional_t<
                  is_array_v<T>, default_delete<U[]>, default_delete<U>>{}) {}

    template<class U, class Deleter>
        requires (detail::shared_pointer_compatible_v<U, T> &&
                  is_move_constructible_v<Deleter>)
    shared_ptr(U* value, Deleter value_deleter) : pointer_value{value} {
        if (!value)
            return;
        using block = detail::pointer_control_block<U*, Deleter>;
        try {
            control = detail::make_control_block<block>(
                value, move(value_deleter));
            enable_weak_this(value);
        } catch (...) {
            value_deleter(value);
            throw;
        }
    }

    template<class U, class Deleter>
        requires detail::shared_pointer_compatible_v<U, T>
    shared_ptr(unique_ptr<U, Deleter>&& other)
        : shared_ptr(other.release(), move(other.get_deleter())) {}

    shared_ptr(const shared_ptr& other) noexcept
        : pointer_value{other.pointer_value}, control{other.control} {
        if (control)
            control->add_strong();
    }

    template<class U>
        requires is_convertible_v<
            typename shared_ptr<U>::element_type*, element_type*>
    shared_ptr(const shared_ptr<U>& other) noexcept
        : pointer_value{other.pointer_value}, control{other.control} {
        if (control)
            control->add_strong();
    }

    shared_ptr(shared_ptr&& other) noexcept
        : pointer_value{exchange(other.pointer_value, nullptr)},
          control{exchange(other.control, nullptr)} {}

    template<class U>
        requires is_convertible_v<
            typename shared_ptr<U>::element_type*, element_type*>
    shared_ptr(shared_ptr<U>&& other) noexcept
        : pointer_value{exchange(other.pointer_value, nullptr)},
          control{exchange(other.control, nullptr)} {}

    template<class U>
    shared_ptr(const shared_ptr<U>& owner, element_type* value) noexcept
        : pointer_value{value}, control{owner.control} {
        if (control)
            control->add_strong();
    }

    template<class U>
    shared_ptr(shared_ptr<U>&& owner, element_type* value) noexcept
        : pointer_value{value}, control{exchange(owner.control, nullptr)} {
        owner.pointer_value = nullptr;
    }

    template<class U>
        requires is_convertible_v<
            typename weak_ptr<U>::element_type*, element_type*>
    explicit shared_ptr(const weak_ptr<U>& other) {
        if (!other.control || !other.control->try_add_strong())
            throw bad_weak_ptr{};
        pointer_value = other.pointer_value;
        control = other.control;
    }

    ~shared_ptr() {
        if (control)
            control->release_strong();
    }

    shared_ptr& operator=(const shared_ptr& other) noexcept {
        shared_ptr(other).swap(*this);
        return *this;
    }

    template<class U>
        requires is_convertible_v<
            typename shared_ptr<U>::element_type*, element_type*>
    shared_ptr& operator=(const shared_ptr<U>& other) noexcept {
        shared_ptr(other).swap(*this);
        return *this;
    }

    shared_ptr& operator=(shared_ptr&& other) noexcept {
        shared_ptr(move(other)).swap(*this);
        return *this;
    }

    template<class U>
        requires is_convertible_v<
            typename shared_ptr<U>::element_type*, element_type*>
    shared_ptr& operator=(shared_ptr<U>&& other) noexcept {
        shared_ptr(move(other)).swap(*this);
        return *this;
    }

    void reset() noexcept { shared_ptr{}.swap(*this); }

    template<class U>
        requires detail::shared_pointer_compatible_v<U, T>
    void reset(U* value) {
        shared_ptr(value).swap(*this);
    }

    void swap(shared_ptr& other) noexcept {
        FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
        FTL_MEMORY_NAMESPACE::swap(control, other.control);
    }

    [[nodiscard]] element_type* get() const noexcept {
        return pointer_value;
    }

    [[nodiscard]] element_type& operator*() const noexcept
        requires (!is_array_v<T>) {
        return *pointer_value;
    }

    [[nodiscard]] element_type* operator->() const noexcept
        requires (!is_array_v<T>) {
        return pointer_value;
    }

    [[nodiscard]] element_type& operator[](size_t index) const
        requires is_array_v<T> {
        return pointer_value[index];
    }

    [[nodiscard]] explicit operator bool() const noexcept {
        return pointer_value != nullptr;
    }

    [[nodiscard]] long use_count() const noexcept {
        return control ? control->strong.load(memory_order_acquire) : 0;
    }

    [[nodiscard]] bool unique() const noexcept {
        return use_count() == 1;
    }

private:
    template<class U>
    void enable_weak_this(U* value) noexcept {
        if constexpr (requires {
            value->accept_owner(*this, value);
        })
            value->accept_owner(*this, value);
    }

    element_type* pointer_value{};
    detail::shared_control_block* control{};
};

template<class T>
class weak_ptr {
    template<class>
    friend class weak_ptr;
    template<class>
    friend class shared_ptr;

public:
    using element_type = remove_extent_t<T>;

    constexpr weak_ptr() noexcept = default;

    template<class U>
        requires is_convertible_v<
            typename shared_ptr<U>::element_type*, element_type*>
    weak_ptr(const shared_ptr<U>& owner) noexcept
        : pointer_value{owner.pointer_value}, control{owner.control} {
        if (control)
            control->add_weak();
    }

    weak_ptr(const weak_ptr& other) noexcept
        : pointer_value{other.pointer_value}, control{other.control} {
        if (control)
            control->add_weak();
    }

    template<class U>
        requires is_convertible_v<
            typename weak_ptr<U>::element_type*, element_type*>
    weak_ptr(const weak_ptr<U>& other) noexcept
        : pointer_value{other.pointer_value}, control{other.control} {
        if (control)
            control->add_weak();
    }

    weak_ptr(weak_ptr&& other) noexcept
        : pointer_value{exchange(other.pointer_value, nullptr)},
          control{exchange(other.control, nullptr)} {}

    ~weak_ptr() {
        if (control)
            control->release_weak();
    }

    weak_ptr& operator=(const weak_ptr& other) noexcept {
        weak_ptr(other).swap(*this);
        return *this;
    }

    weak_ptr& operator=(weak_ptr&& other) noexcept {
        weak_ptr(move(other)).swap(*this);
        return *this;
    }

    void reset() noexcept { weak_ptr{}.swap(*this); }

    void swap(weak_ptr& other) noexcept {
        FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
        FTL_MEMORY_NAMESPACE::swap(control, other.control);
    }

    [[nodiscard]] long use_count() const noexcept {
        return control ? control->strong.load(memory_order_acquire) : 0;
    }

    [[nodiscard]] bool expired() const noexcept {
        return use_count() == 0;
    }

    [[nodiscard]] shared_ptr<T> lock() const noexcept {
        shared_ptr<T> result;
        if (control && control->try_add_strong()) {
            result.pointer_value = pointer_value;
            result.control = control;
        }
        return result;
    }

private:
    element_type* pointer_value{};
    detail::shared_control_block* control{};
};

template<class T>
class enable_shared_from_this {
    template<class>
    friend class shared_ptr;

public:
    [[nodiscard]] shared_ptr<T> shared_from_this() {
        return shared_ptr<T>{weak_this};
    }

    [[nodiscard]] shared_ptr<const T> shared_from_this() const {
        return shared_ptr<const T>{weak_this};
    }

    [[nodiscard]] weak_ptr<T> weak_from_this() noexcept {
        return weak_this;
    }

    [[nodiscard]] weak_ptr<const T> weak_from_this() const noexcept {
        return weak_this;
    }

protected:
    constexpr enable_shared_from_this() noexcept = default;
    enable_shared_from_this(
        const enable_shared_from_this&) noexcept {}
    enable_shared_from_this& operator=(
        const enable_shared_from_this&) noexcept {
        return *this;
    }
    ~enable_shared_from_this() = default;

private:
    template<class U>
    void accept_owner(
        const shared_ptr<U>& owner, T* value) const noexcept {
        if (weak_this.expired())
            weak_this = weak_ptr<T>{
                shared_ptr<T>{owner, value}};
    }

    mutable weak_ptr<T> weak_this;
};

template<class T, class Allocator, class... Args>
    requires (!is_array_v<T>)
shared_ptr<T> allocate_shared(
    const Allocator& allocator, Args&&... args) {
    using block =
        detail::allocator_inplace_control_block<T, Allocator>;
    using block_allocator =
        typename allocator_traits<Allocator>
            ::template rebind_alloc<block>;
    block_allocator rebound{allocator};
    block* owner =
        allocator_traits<block_allocator>::allocate(rebound, 1);
    try {
        allocator_traits<block_allocator>::construct(
            rebound, owner, allocator, forward<Args>(args)...);
    } catch (...) {
        allocator_traits<block_allocator>::deallocate(
            rebound, owner, 1);
        throw;
    }

    shared_ptr<T> result;
    result.pointer_value = owner->pointer();
    result.control = owner;
    result.enable_weak_this(result.pointer_value);
    return result;
}

template<class T, class... Args>
    requires (!is_array_v<T>)
shared_ptr<T> make_shared(Args&&... args) {
    return allocate_shared<T>(
        allocator<T>{}, forward<Args>(args)...);
}

