    else
        return FTL_MEMORY_NAMESPACE::to_address(value.operator->());
}

template<class T>
class allocator {
public:
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using propagate_on_container_move_assignment = true_type;
    using is_always_equal = true_type;

    constexpr allocator() noexcept = default;

    template<class U>
    constexpr allocator(const allocator<U>&) noexcept {}

    [[nodiscard]] constexpr T* allocate(size_t count) {
        if (count > size_t(-1) / sizeof(T))
            throw bad_array_new_length{};
        const size_t bytes = count * sizeof(T);
#if defined(__STDCPP_DEFAULT_NEW_ALIGNMENT__)
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
            return static_cast<T*>(
                ::operator new(bytes, align_val_t{alignof(T)}));
#endif
        return static_cast<T*>(::operator new(bytes));
    }

    [[nodiscard]] constexpr allocation_result<T*> allocate_at_least(
        size_t count) {
        return {allocate(count), count};
    }

    constexpr void deallocate(T* pointer, size_t) noexcept {
#if defined(__STDCPP_DEFAULT_NEW_ALIGNMENT__)
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__) {
            ::operator delete(pointer, align_val_t{alignof(T)});
            return;
        }
#endif
        ::operator delete(pointer);
    }
};

