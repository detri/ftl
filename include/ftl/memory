namespace ranges {

namespace detail {

template <class I>
concept nothrow_input_iterator =
    input_iterator<I> && is_lvalue_reference_v<iter_reference_t<I>> &&
    same_as<remove_cvref_t<iter_reference_t<I>>, iter_value_t<I>>;

template <class S, class I>
concept nothrow_sentinel_for = sentinel_for<S, I>;

template <class I>
concept nothrow_forward_iterator =
    nothrow_input_iterator<I> && forward_iterator<I> &&
    nothrow_sentinel_for<I, I>;

template <class R>
concept nothrow_input_range =
    range<R> && nothrow_input_iterator<iterator_t<R>> &&
    nothrow_sentinel_for<sentinel_t<R>, iterator_t<R>>;

template <class R>
concept nothrow_forward_range =
    nothrow_input_range<R> && nothrow_forward_iterator<iterator_t<R>>;

template <class O, class S>
constexpr void destroy_constructed(O first, S last) noexcept {
  for (; first != last; ++first)
    FTL_MEMORY_NAMESPACE::destroy_at(addressof(*first));
}

} // namespace detail

template <class I, class O>
using uninitialized_copy_result = in_out_result<I, O>;

template <class I, class O>
using uninitialized_move_result = in_out_result<I, O>;

struct uninitialized_default_construct_fn {
  template <detail::nothrow_forward_iterator I,
            detail::nothrow_sentinel_for<I> S>
  constexpr I operator()(I first, S last) const {
    using T = iter_value_t<I>;
    I current = first;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      for (; current != last; ++current)
        ::new (static_cast<void *>(addressof(*current))) T;

      return current;

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      detail::destroy_constructed(first, current);
      throw;
    }
#endif
  }

  template <detail::nothrow_forward_range R>
  constexpr borrowed_iterator_t<R> operator()(R &&range) const {
    auto result = (*this)(ranges::begin(range), ranges::end(range));
    return borrowed_iterator_t<R>{result};
  }
};

