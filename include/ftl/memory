struct shared_control_block {
  atomic<long> strong{1};
  atomic<long> weak{1};

  virtual void destroy_object() noexcept = 0;
  virtual void destroy_block() noexcept = 0;
  virtual void *deleter_address(const void *) noexcept { return nullptr; }

  void add_strong() noexcept { strong.fetch_add(1, memory_order_relaxed); }

  bool try_add_strong() noexcept {
    long current = strong.load(memory_order_acquire);
    while (current != 0) {
      if (strong.compare_exchange_weak(
              current, current + 1, memory_order_acquire, memory_order_relaxed))
        return true;
    }
    return false;
  }

  void add_weak() noexcept { weak.fetch_add(1, memory_order_relaxed); }

  void release_strong() noexcept {
    if (strong.fetch_sub(1, memory_order_acq_rel) == 1) {
      destroy_object();
      release_weak();
    }
  }

  void release_weak() noexcept {
    if (weak.fetch_sub(1, memory_order_acq_rel) == 1)
      destroy_block();
  }

protected:
  ~shared_control_block() = default;
};

template <class Pointer, class Deleter>
struct pointer_control_block final : shared_control_block {
  FTL_NO_UNIQUE_ADDRESS Deleter deleter;
  Pointer pointer;

  template <class D>
  pointer_control_block(Pointer value, D &&value_deleter)
      : deleter{forward<D>(value_deleter)}, pointer{value} {}

  void destroy_object() noexcept override { deleter(pointer); }

  void destroy_block() noexcept override {
    this->~pointer_control_block();
    ::operator delete(this);
  }

  void *deleter_address(const void *type) noexcept override {
    return type == type_id<Deleter>() ? addressof(deleter) : nullptr;
  }

  static const void *deleter_id() noexcept { return type_id<Deleter>(); }
};

template <class Pointer, class Deleter, class Allocator>
struct allocator_pointer_control_block final : shared_control_block {
  FTL_NO_UNIQUE_ADDRESS Deleter deleter;
  FTL_NO_UNIQUE_ADDRESS Allocator allocator;
  Pointer pointer;
  template <class D>
  allocator_pointer_control_block(Pointer p, D &&d, const Allocator &a)
      : deleter(forward<D>(d)), allocator(a), pointer(p) {}
  void destroy_object() noexcept override { deleter(pointer); }
  void destroy_block() noexcept override {
    using block = allocator_pointer_control_block;
    using block_allocator =
        typename allocator_traits<Allocator>::template rebind_alloc<block>;
    block_allocator rebound(allocator);
    this->~block();
    allocator_traits<block_allocator>::deallocate(rebound, this, 1);
  }
  void *deleter_address(const void *type) noexcept override {
    return type == type_id<Deleter>() ? addressof(deleter) : nullptr;
  }
};

template <class Block, class... Args>
Block *make_control_block(Args &&...args) {
  void *storage = ::operator new(sizeof(Block));

#if FTL_HAS_EXCEPTIONS
  try {
#endif
    return construct_at(static_cast<Block *>(storage), forward<Args>(args)...);

#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    ::operator delete(storage);
    throw;
  }
#endif
}

