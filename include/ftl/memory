template <class Allocator> struct allocator_traits {
  using allocator_type = Allocator;
  using value_type = typename Allocator::value_type;
  using pointer = typename detail::allocator_pointer<Allocator>::type;
  using const_pointer =
      typename detail::allocator_const_pointer<Allocator, pointer>::type;
  using void_pointer =
      typename detail::allocator_void_pointer<Allocator, pointer>::type;
  using const_void_pointer =
      typename detail::allocator_const_void_pointer<Allocator, pointer>::type;
  using difference_type =
      typename detail::allocator_difference<Allocator>::type;
  using size_type =
      typename detail::allocator_size<Allocator, difference_type>::type;

  using propagate_on_container_copy_assignment =
      typename detail::allocator_propagate_on_container_copy_assignment<
          Allocator>::type;
  using propagate_on_container_move_assignment =
      typename detail::allocator_propagate_on_container_move_assignment<
          Allocator>::type;
  using propagate_on_container_swap =
      typename detail::allocator_propagate_on_container_swap<Allocator>::type;
  using is_always_equal =
      typename detail::allocator_is_always_equal<Allocator>::type;

  template <class T>
  using rebind_alloc = typename detail::allocator_rebind<Allocator, T>::type;

  template <class T> using rebind_traits = allocator_traits<rebind_alloc<T>>;

  [[nodiscard]] static constexpr pointer allocate(Allocator &allocator,
                                                  size_type count) {
    return allocator.allocate(count);
  }

  [[nodiscard]] static constexpr pointer
  allocate(Allocator &allocator, size_type count, const_void_pointer hint) {
    if constexpr (requires { allocator.allocate(count, hint); })
      return allocator.allocate(count, hint);
    else
      return allocator.allocate(count);
  }

  [[nodiscard]] static constexpr allocation_result<pointer, size_type>
  allocate_at_least(Allocator &allocator, size_type count) {
    if constexpr (requires { allocator.allocate_at_least(count); })
      return allocator.allocate_at_least(count);
    else
      return {allocator.allocate(count), count};
  }

  static constexpr void deallocate(Allocator &allocator, pointer value,
                                   size_type count) {
    allocator.deallocate(value, count);
  }

  template <class T, class... Args>
  static constexpr void construct(Allocator &allocator, T *value,
                                  Args &&...args) {
    if constexpr (requires {
                    allocator.construct(value, forward<Args>(args)...);
                  })
      allocator.construct(value, forward<Args>(args)...);
    else
      construct_at(value, forward<Args>(args)...);
  }

  template <class T>
  static constexpr void destroy(Allocator &allocator, T *value) {
    if constexpr (requires { allocator.destroy(value); })
      allocator.destroy(value);
    else
      destroy_at(value);
  }

  [[nodiscard]] static constexpr size_type
  max_size(const Allocator &allocator) noexcept {
    if constexpr (requires { allocator.max_size(); })
      return allocator.max_size();
    else
      return size_type(-1) / sizeof(value_type);
  }

  [[nodiscard]] static constexpr Allocator
  select_on_container_copy_construction(const Allocator &allocator) {
    if constexpr (requires {
                    allocator.select_on_container_copy_construction();
                  })
      return allocator.select_on_container_copy_construction();
    else
      return allocator;
  }
};

namespace detail {
template <class T, class Allocator>
struct allocator_inplace_control_block final : shared_control_block {
  FTL_NO_UNIQUE_ADDRESS Allocator allocator;
  alignas(T) unsigned char storage[sizeof(T)];

  template <class... Args>
  allocator_inplace_control_block(const Allocator &value_allocator,
                                  Args &&...args)
      : allocator{value_allocator} {
    allocator_traits<Allocator>::construct(allocator, pointer(),
                                           forward<Args>(args)...);
  }

  T *pointer() noexcept { return launder(reinterpret_cast<T *>(storage)); }

  void destroy_object() noexcept override {
    allocator_traits<Allocator>::destroy(allocator, pointer());
  }

  void destroy_block() noexcept override {
    using block = allocator_inplace_control_block;
    using block_allocator =
        typename allocator_traits<Allocator>::template rebind_alloc<block>;
    Allocator saved_allocator = allocator;
    this->~block();
    block_allocator rebound{saved_allocator};
    allocator_traits<block_allocator>::deallocate(rebound, this, 1);
  }
};
struct atomic_smart_pointer_access;
} // namespace detail

class bad_weak_ptr : public exception {
public:
  [[nodiscard]] const char *what() const noexcept override {
    return "bad_weak_ptr";
  }
};

template <class T> class shared_ptr {
  template <class> friend class shared_ptr;
  template <class> friend class weak_ptr;
  template <class U, class... Args>
    requires(!is_array_v<U>)
  friend shared_ptr<U> make_shared(Args &&...);
  template <class U, class Allocator, class... Args>
    requires(!is_array_v<U>)
  friend shared_ptr<U> allocate_shared(const Allocator &, Args &&...);

public:
  using element_type = remove_extent_t<T>;
  using weak_type = weak_ptr<T>;

  constexpr shared_ptr() noexcept = default;
  constexpr shared_ptr(nullptr_t) noexcept {}

  template <class U>
    requires detail::shared_raw_pointer_compatible_v<U, T>
  explicit shared_ptr(U *value)
      : shared_ptr(value, conditional_t<is_array_v<T>, default_delete<U[]>,
                                        default_delete<U>>{}) {}

  template <class U, class Deleter>
    requires(detail::shared_raw_pointer_compatible_v<U, T> &&
             is_move_constructible_v<Deleter>)
  shared_ptr(U *value, Deleter value_deleter) : pointer_value{value} {
    using block = detail::pointer_control_block<U *, Deleter>;

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      control = detail::make_control_block<block>(value, move(value_deleter));

      enable_weak_this(value);

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      value_deleter(value);
      throw;
    }
#endif
  }

  template <class U, class Deleter, class Allocator>
    requires detail::shared_raw_pointer_compatible_v<U, T>
  shared_ptr(U *value, Deleter value_deleter, Allocator allocator)
      : pointer_value(value) {
    using block =
        detail::allocator_pointer_control_block<U *, Deleter, Allocator>;

    using block_allocator =
        typename allocator_traits<Allocator>::template rebind_alloc<block>;

    block_allocator rebound(allocator);

    block *owner = allocator_traits<block_allocator>::allocate(rebound, 1);

#if FTL_HAS_EXCEPTIONS
    try {
#endif
      allocator_traits<block_allocator>::construct(
          rebound, owner, value, move(value_deleter), allocator);

#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      allocator_traits<block_allocator>::deallocate(rebound, owner, 1);

      value_deleter(value);
      throw;
    }
#endif

    control = owner;
    enable_weak_this(value);
  }

  template <class Deleter>
  shared_ptr(nullptr_t, Deleter value_deleter)
      : shared_ptr(static_cast<element_type *>(nullptr), move(value_deleter)) {}

  template <class Deleter, class Allocator>
  shared_ptr(nullptr_t, Deleter value_deleter, Allocator allocator)
      : shared_ptr(static_cast<element_type *>(nullptr), move(value_deleter),
                   allocator) {}

  template <class U, class Deleter>
    requires(detail::shared_pointer_compatible_v<U, T> &&
             is_convertible_v<typename unique_ptr<U, Deleter>::pointer,
                              element_type *>)
  shared_ptr(unique_ptr<U, Deleter> &&other) {
    using source_pointer = typename unique_ptr<U, Deleter>::pointer;
    using block = detail::pointer_control_block<source_pointer, Deleter>;

    source_pointer pointer = other.get();

    control = detail::make_control_block<block>(
        pointer, forward<Deleter>(other.get_deleter()));
    pointer_value = static_cast<element_type *>(pointer);
    other.release();
    enable_weak_this(pointer_value);
  }

  shared_ptr(const shared_ptr &other) noexcept
      : pointer_value{other.pointer_value}, control{other.control} {
    if (control)
      control->add_strong();
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  shared_ptr(const shared_ptr<U> &other) noexcept
      : pointer_value{other.pointer_value}, control{other.control} {
    if (control)
      control->add_strong();
  }

  shared_ptr(shared_ptr &&other) noexcept
      : pointer_value{exchange(other.pointer_value, nullptr)},
        control{exchange(other.control, nullptr)} {}

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  shared_ptr(shared_ptr<U> &&other) noexcept
      : pointer_value{exchange(other.pointer_value, nullptr)},
        control{exchange(other.control, nullptr)} {}

  template <class U>
  shared_ptr(const shared_ptr<U> &owner, element_type *value) noexcept
      : pointer_value{value}, control{owner.control} {
    if (control)
      control->add_strong();
  }

  template <class U>
  shared_ptr(shared_ptr<U> &&owner, element_type *value) noexcept
      : pointer_value{value}, control{exchange(owner.control, nullptr)} {
    owner.pointer_value = nullptr;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  explicit shared_ptr(const weak_ptr<U> &other)
      : pointer_value(nullptr), control(nullptr) {
    auto *candidate = other.control;

    if (!candidate || !candidate->try_add_strong()) {
#if FTL_HAS_EXCEPTIONS
      throw bad_weak_ptr{};
#else
      terminate();
#endif
    }

    pointer_value = other.pointer_value;
    control = candidate;
  }

  ~shared_ptr() {
    if (control)
      control->release_strong();
  }

  shared_ptr &operator=(const shared_ptr &other) noexcept {
    shared_ptr(other).swap(*this);
    return *this;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  shared_ptr &operator=(const shared_ptr<U> &other) noexcept {
    shared_ptr(other).swap(*this);
    return *this;
  }

  shared_ptr &operator=(shared_ptr &&other) noexcept {
    shared_ptr(move(other)).swap(*this);
    return *this;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  shared_ptr &operator=(shared_ptr<U> &&other) noexcept {
    shared_ptr(move(other)).swap(*this);
    return *this;
  }

  void reset() noexcept { shared_ptr{}.swap(*this); }

  template <class U>
    requires detail::shared_raw_pointer_compatible_v<U, T>
  void reset(U *value) {
    shared_ptr(value).swap(*this);
  }

  template <class U, class Deleter>
    requires detail::shared_raw_pointer_compatible_v<U, T>
  void reset(U *value, Deleter deleter) {
    shared_ptr(value, move(deleter)).swap(*this);
  }

  template <class U, class Deleter, class Allocator>
    requires detail::shared_raw_pointer_compatible_v<U, T>
  void reset(U *value, Deleter deleter, Allocator allocator) {
    shared_ptr(value, move(deleter), allocator).swap(*this);
  }

  void swap(shared_ptr &other) noexcept {
    FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
    FTL_MEMORY_NAMESPACE::swap(control, other.control);
  }

  [[nodiscard]] element_type *get() const noexcept { return pointer_value; }

  [[nodiscard]] element_type &operator*() const noexcept
    requires(!is_array_v<T>)
  {
    return *pointer_value;
  }

  [[nodiscard]] element_type *operator->() const noexcept
    requires(!is_array_v<T>)
  {
    return pointer_value;
  }

  [[nodiscard]] element_type &operator[](size_t index) const
    requires is_array_v<T>
  {
    return pointer_value[index];
  }

  [[nodiscard]] explicit operator bool() const noexcept {
    return pointer_value != nullptr;
  }

  [[nodiscard]] long use_count() const noexcept {
    return control ? control->strong.load(memory_order_acquire) : 0;
  }

  [[nodiscard]] bool unique() const noexcept { return use_count() == 1; }

  template <class U>
  bool owner_before(const shared_ptr<U> &other) const noexcept {
    return compare_three_way{}(control, other.control) < 0;
  }

  template <class U>
  bool owner_before(const weak_ptr<U> &other) const noexcept {
    return compare_three_way{}(control, other.control) < 0;
  }

  template <class D> D *deleter() const noexcept {
    return control ? static_cast<D *>(
                         control->deleter_address(detail::type_id<D>()))
                   : nullptr;
  }

private:
  template <class U> void enable_weak_this(U *value) noexcept {
    if constexpr (requires { value->accept_owner(*this, value); })
      if (value)
        value->accept_owner(*this, value);
  }

  element_type *pointer_value{};
  detail::shared_control_block *control{};
};

template <class T> class weak_ptr {
  template <class> friend class weak_ptr;
  template <class> friend class shared_ptr;
  friend detail::atomic_smart_pointer_access;

public:
  using element_type = remove_extent_t<T>;

  constexpr weak_ptr() noexcept = default;

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr(const shared_ptr<U> &owner) noexcept
      : pointer_value{owner.pointer_value}, control{owner.control} {
    if (control)
      control->add_weak();
  }

  weak_ptr(const weak_ptr &other) noexcept
      : pointer_value{other.pointer_value}, control{other.control} {
    if (control)
      control->add_weak();
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr(const weak_ptr<U> &other) noexcept
      : pointer_value{other.pointer_value}, control{other.control} {
    if (control)
      control->add_weak();
  }

  weak_ptr(weak_ptr &&other) noexcept
      : pointer_value{exchange(other.pointer_value, nullptr)},
        control{exchange(other.control, nullptr)} {}

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr(weak_ptr<U> &&other) noexcept
      : pointer_value{exchange(other.pointer_value, nullptr)},
        control{exchange(other.control, nullptr)} {}

  ~weak_ptr() {
    if (control)
      control->release_weak();
  }

  weak_ptr &operator=(const weak_ptr &other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
  }

  weak_ptr &operator=(weak_ptr &&other) noexcept {
    weak_ptr(move(other)).swap(*this);
    return *this;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr &operator=(const weak_ptr<U> &other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr &operator=(weak_ptr<U> &&other) noexcept {
    weak_ptr(move(other)).swap(*this);
    return *this;
  }

  template <class U>
    requires detail::shared_pointer_compatible_v<U, T>
  weak_ptr &operator=(const shared_ptr<U> &other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
  }

  void reset() noexcept { weak_ptr{}.swap(*this); }

  void swap(weak_ptr &other) noexcept {
    FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
    FTL_MEMORY_NAMESPACE::swap(control, other.control);
  }

  [[nodiscard]] long use_count() const noexcept {
    return control ? control->strong.load(memory_order_acquire) : 0;
  }

  [[nodiscard]] bool expired() const noexcept { return use_count() == 0; }

  [[nodiscard]] shared_ptr<T> lock() const noexcept {
    shared_ptr<T> result;
    if (control && control->try_add_strong()) {
      result.pointer_value = pointer_value;
      result.control = control;
    }
    return result;
  }

  template <class U>
  bool owner_before(const shared_ptr<U> &other) const noexcept {
    return compare_three_way{}(control, other.control) < 0;
  }

  template <class U>
  bool owner_before(const weak_ptr<U> &other) const noexcept {
    return compare_three_way{}(control, other.control) < 0;
  }

private:
  element_type *pointer_value{};
  detail::shared_control_block *control{};
};

template <class T> class enable_shared_from_this {
  template <class> friend class shared_ptr;

public:
  [[nodiscard]] shared_ptr<T> shared_from_this() {
    return shared_ptr<T>{weak_this};
  }

  [[nodiscard]] shared_ptr<const T> shared_from_this() const {
    return shared_ptr<const T>{weak_this};
  }

  [[nodiscard]] weak_ptr<T> weak_from_this() noexcept { return weak_this; }

  [[nodiscard]] weak_ptr<const T> weak_from_this() const noexcept {
    return weak_this;
  }

protected:
  constexpr enable_shared_from_this() noexcept = default;
  enable_shared_from_this(const enable_shared_from_this &) noexcept {}
  enable_shared_from_this &operator=(const enable_shared_from_this &) noexcept {
    return *this;
  }
  ~enable_shared_from_this() = default;

private:
  template <class U>
  void accept_owner(const shared_ptr<U> &owner, T *value) const noexcept {
    if (weak_this.expired())
      weak_this = weak_ptr<T>{shared_ptr<T>{owner, value}};
  }

  mutable weak_ptr<T> weak_this;
};

template <class T, class U>
bool operator==(const shared_ptr<T> &left,
                const shared_ptr<U> &right) noexcept {
  return left.get() == right.get();
}
template <class T, class U>
strong_ordering operator<=>(const shared_ptr<T> &left,
                            const shared_ptr<U> &right) noexcept {
  return compare_three_way{}(left.get(), right.get());
}
template <class T>
bool operator==(const shared_ptr<T> &value, nullptr_t) noexcept {
  return !value;
}
template <class T>
strong_ordering operator<=>(const shared_ptr<T> &value, nullptr_t) noexcept {
  return compare_three_way{}(value.get(), nullptr);
}
template <class T>
void swap(shared_ptr<T> &left, shared_ptr<T> &right) noexcept {
  left.swap(right);
}
template <class T> void swap(weak_ptr<T> &left, weak_ptr<T> &right) noexcept {
  left.swap(right);
}

