namespace detail {

struct atomic_smart_pointer_access {
  template <class T>
  static bool equivalent(const shared_ptr<T> &left,
                         const shared_ptr<T> &right) noexcept {
    return left.get() == right.get() && !left.owner_before(right) &&
           !right.owner_before(left);
  }

  template <class T>
  static bool equivalent(const weak_ptr<T> &left,
                         const weak_ptr<T> &right) noexcept {
    return left.pointer_value == right.pointer_value &&
           left.control == right.control;
  }
};

template <class Pointer> class atomic_smart_pointer {
public:
  using value_type = Pointer;

  static constexpr bool is_always_lock_free = false;

  constexpr atomic_smart_pointer() noexcept = default;

  atomic_smart_pointer(Pointer desired) noexcept : value_(move(desired)) {}

  atomic_smart_pointer(const atomic_smart_pointer &) = delete;

  void operator=(const atomic_smart_pointer &) = delete;

  void operator=(Pointer desired) noexcept { store(move(desired)); }

  [[nodiscard]]
  bool is_lock_free() const noexcept {
    return false;
  }

  void store(Pointer desired, memory_order = memory_order_seq_cst) noexcept {
    {
      guard hold{lock_};

      // Keep destruction/deallocation of the old
      // smart pointer outside the implementation lock.
      value_.swap(desired);
    }
  }

  [[nodiscard]]
  Pointer load(memory_order = memory_order_seq_cst) const noexcept {
    guard hold{lock_};

    return value_;
  }

  operator Pointer() const noexcept { return load(); }

  Pointer exchange(Pointer desired,
                   memory_order = memory_order_seq_cst) noexcept {
    {
      guard hold{lock_};

      value_.swap(desired);
    }

    return desired;
  }

  bool compare_exchange_weak(Pointer &expected, Pointer desired,
                             memory_order success,
                             memory_order failure) noexcept {
    return compare_exchange(expected, move(desired), success, failure);
  }

  bool
  compare_exchange_weak(Pointer &expected, Pointer desired,
                        memory_order order = memory_order_seq_cst) noexcept {
    return compare_exchange_weak(expected, move(desired), order,
                                 atomic_failure_order(order));
  }

  bool compare_exchange_strong(Pointer &expected, Pointer desired,
                               memory_order success,
                               memory_order failure) noexcept {
    return compare_exchange(expected, move(desired), success, failure);
  }

  bool
  compare_exchange_strong(Pointer &expected, Pointer desired,
                          memory_order order = memory_order_seq_cst) noexcept {
    return compare_exchange_strong(expected, move(desired), order,
                                   atomic_failure_order(order));
  }

  void wait(Pointer old,
            memory_order order = memory_order_seq_cst) const noexcept {
    for (;;) {
      if (!equivalent(load(order), old))
        return;

      const uint32_t observed = version_.load(memory_order_relaxed);

      // Close the lost-wakeup window between
      // examining value_ and blocking on version_.
      if (!equivalent(load(order), old))
        return;

      version_.wait(observed, memory_order_relaxed);
    }
  }

  void notify_one() noexcept {
    version_.fetch_add(uint32_t{1}, memory_order_relaxed);

    version_.notify_one();
  }

  void notify_all() noexcept {
    version_.fetch_add(uint32_t{1}, memory_order_relaxed);

    version_.notify_all();
  }

private:
  struct guard {
    atomic_flag &lock;

    explicit guard(atomic_flag &value) noexcept : lock(value) {
      while (lock.test_and_set(memory_order_seq_cst)) {
        lock.wait(true, memory_order_relaxed);
      }
    }

    ~guard() {
      lock.clear(memory_order_seq_cst);
      lock.notify_one();
    }
  };

  static bool equivalent(const Pointer &left, const Pointer &right) noexcept {
    return atomic_smart_pointer_access::equivalent(left, right);
  }

  bool compare_exchange(Pointer &expected, Pointer desired, memory_order,
                        memory_order) noexcept {
    Pointer observed;

    {
      guard hold{lock_};

      if (equivalent(value_, expected)) {
        value_.swap(desired);
        return true;
      }

      // Increment the observed owner's count while
      // still inside the atomic operation.
      observed = value_;
    }

    // Replacing expected may decrement/destroy its
    // old owner, so do that after releasing our lock.
    expected.swap(observed);

    return false;
  }

  mutable atomic_flag lock_{};

  atomic<uint32_t> version_{0};

  Pointer value_{};
};

