template <class T, class Alloc, class... Args>
constexpr T make_obj_using_allocator(const Alloc &alloc, Args &&...args) {
  return make_from_tuple<T>(
      uses_allocator_construction_args<T>(alloc, forward<Args>(args)...));
}

template <class T, class Alloc, class... Args>
constexpr T *uninitialized_construct_using_allocator(T *pointer,
                                                     const Alloc &alloc,
                                                     Args &&...args) {
  return apply(
      [&](auto &&...ctor_args) {
        return construct_at(pointer,
                            forward<decltype(ctor_args)>(ctor_args)...);
      },
      uses_allocator_construction_args<T>(alloc, forward<Args>(args)...));
}

