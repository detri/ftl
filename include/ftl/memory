template <class T, class Deleter> class unique_ptr {
  template <class, class> friend class unique_ptr;

public:
  using pointer = typename detail::unique_ptr_pointer<T, Deleter>::type;
  using element_type = T;
  using deleter_type = Deleter;

  constexpr unique_ptr() noexcept
    requires(!is_pointer_v<Deleter> && is_default_constructible_v<Deleter>)
      : deleter{}, pointer_value{} {}

  constexpr unique_ptr(nullptr_t) noexcept
    requires(!is_pointer_v<Deleter> && is_default_constructible_v<Deleter>)
      : unique_ptr{} {}

  explicit constexpr unique_ptr(pointer value) noexcept
    requires(!is_pointer_v<Deleter> && is_default_constructible_v<Deleter>)
      : deleter{}, pointer_value{value} {}

  constexpr unique_ptr(pointer value, const Deleter &value_deleter) noexcept
    requires is_constructible_v<Deleter, const Deleter &>
      : deleter{value_deleter}, pointer_value{value} {}

  constexpr unique_ptr(pointer value, Deleter &&value_deleter) noexcept
    requires(!is_reference_v<Deleter> &&
             is_constructible_v<Deleter, Deleter &&>)
      : deleter{move(value_deleter)}, pointer_value{value} {}

  constexpr unique_ptr(unique_ptr &&other) noexcept
    requires is_move_constructible_v<Deleter>
      : deleter{forward<Deleter>(other.deleter)},
        pointer_value{other.release()} {}

  template <class U, class OtherDeleter>
    requires(!is_array_v<U> &&
             !is_same_v<unique_ptr<U, OtherDeleter>, unique_ptr> &&
             is_convertible_v<typename unique_ptr<U, OtherDeleter>::pointer,
                              pointer> &&
             (is_reference_v<Deleter>
                  ? is_same_v<Deleter, OtherDeleter>
                  : is_convertible_v<OtherDeleter, Deleter>))
  constexpr unique_ptr(unique_ptr<U, OtherDeleter> &&other) noexcept
      : deleter{forward<OtherDeleter>(other.get_deleter())},
        pointer_value{other.release()} {}

  constexpr unique_ptr &operator=(unique_ptr &&other) noexcept
    requires is_move_assignable_v<Deleter>
  {
    if (this != addressof(other)) {
      reset(other.release());

      deleter = forward<Deleter>(other.deleter);
    }

    return *this;
  }

  template <class U, class OtherDeleter>
    requires(!is_array_v<U> &&
             !is_same_v<unique_ptr<U, OtherDeleter>, unique_ptr> &&
             is_convertible_v<typename unique_ptr<U, OtherDeleter>::pointer,
                              pointer> &&
             is_assignable_v<Deleter &, OtherDeleter &&>)
  constexpr unique_ptr &
  operator=(unique_ptr<U, OtherDeleter> &&other) noexcept {
    reset(other.release());

    deleter = forward<OtherDeleter>(other.get_deleter());

    return *this;
  }

  constexpr unique_ptr &operator=(nullptr_t) noexcept {
    reset();
    return *this;
  }

  unique_ptr(const unique_ptr &) = delete;

  unique_ptr &operator=(const unique_ptr &) = delete;

  constexpr ~unique_ptr() noexcept {
    if (pointer_value)
      deleter(pointer_value);
  }

  [[nodiscard]]
  constexpr pointer get() const noexcept {
    return pointer_value;
  }

  [[nodiscard]]
  constexpr Deleter &get_deleter() noexcept {
    return deleter;
  }

  [[nodiscard]]
  constexpr const Deleter &get_deleter() const noexcept {
    return deleter;
  }

  [[nodiscard]]
  constexpr explicit operator bool() const noexcept {
    return pointer_value != nullptr;
  }

  [[nodiscard]]
  constexpr pointer release() noexcept {
    return exchange(pointer_value, nullptr);
  }

  constexpr void reset(pointer replacement = pointer{}) noexcept {
    pointer old = exchange(pointer_value, replacement);

    if (old)
      deleter(old);
  }

  constexpr void swap(unique_ptr &other) noexcept {
    FTL_MEMORY_NAMESPACE::swap(deleter, other.deleter);

    FTL_MEMORY_NAMESPACE::swap(pointer_value, other.pointer_value);
  }

  [[nodiscard]]
  constexpr pointer operator->() const noexcept {
    return pointer_value;
  }

  constexpr T &operator*() const noexcept { return *pointer_value; }

private:
  FTL_NO_UNIQUE_ADDRESS
  Deleter deleter;

  pointer pointer_value;
};

