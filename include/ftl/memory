inline void *align(size_t alignment, size_t size, void *&pointer,
                   size_t &space) {
  auto address = reinterpret_cast<size_t>(pointer);
  const size_t padding = (alignment - address % alignment) % alignment;
  if (padding > space || size > space - padding)
    return nullptr;
  pointer = static_cast<unsigned char *>(pointer) + padding;
  space -= padding;
  return pointer;
}

template <size_t Alignment, class T>
[[nodiscard]] constexpr T *assume_aligned(T *pointer) {
  static_assert((Alignment & (Alignment - 1)) == 0);
#if __has_builtin(__builtin_assume_aligned)
  return static_cast<T *>(__builtin_assume_aligned(pointer, Alignment));
#else
  return pointer;
#endif
}

template <class T, class Void>
using copy_cv_t = conditional_t<is_const_v<Void>, add_const_t<T>, T>;

template <class T, class Void>
using copy_cv_volatile_t =
    conditional_t<is_volatile_v<Void>, add_volatile_t<copy_cv_t<T, Void>>,
                  copy_cv_t<T, Void>>;

template <class T, class Void>
copy_cv_volatile_t<T, Void> *start_lifetime_as(Void *pointer) noexcept {
  using result_type = copy_cv_volatile_t<T, Void>;

  static_assert(is_implicit_lifetime_v<T>);
  static_assert(sizeof(T) != 0);

#if defined(_MSC_VER) && !defined(__clang__)

  /*
   * MSVC's STL uses the compiler intrinsic directly.
   * __has_builtin is not a reliable test for this on MSVC.
   */
  return __builtin_start_lifetime_as<T>(pointer);

#elif defined(__GNUC__) || defined(__clang__)

  /*
   * Same compiler-lifetime barrier strategy used by libstdc++.
   */
  auto *result = reinterpret_cast<result_type *>(pointer);

  auto *writable = reinterpret_cast<remove_cv_t<result_type> *>(
      const_cast<void *>(static_cast<const volatile void *>(pointer)));

  __asm__ __volatile__(""
                       : "=g"(result), "=m"(*writable)
                       : "0"(result), "m"(*result));

  return result;

#else

#error "FTL start_lifetime_as requires compiler lifetime support"

#endif
}

template <class T, class Void>
copy_cv_volatile_t<T, Void> *start_lifetime_as_array(Void *pointer,
                                                     size_t count) noexcept {
  using result_type = copy_cv_volatile_t<T, Void>;

  static_assert(sizeof(T) != 0);

#if defined(_MSC_VER) && !defined(__clang__)

  return __builtin_start_lifetime_as_array<T>(pointer, count);

#elif defined(__GNUC__) || defined(__clang__)

  auto *result = reinterpret_cast<result_type *>(pointer);

  if (count == 0)
    return result;

#if defined(__clang__)
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wvla-cxx-extension"
#endif

  auto *readable =
      (__extension__ reinterpret_cast<result_type(*)[count]>(pointer));

  auto *writable =
      (__extension__ reinterpret_cast<remove_cv_t<result_type>(*)[count]>(
          const_cast<void *>(static_cast<const volatile void *>(pointer))));

  __asm__ __volatile__(""
                       : "=g"(result), "=m"(*writable)
                       : "0"(result), "m"(*readable));

#if defined(__clang__)
#pragma clang diagnostic pop
#endif

  return result;

#else

#error "FTL start_lifetime_as_array requires compiler lifetime support"

#endif
}

template <class T, class Alloc, class... Args>
constexpr auto uses_allocator_construction_args(const Alloc &alloc,
                                                Args &&...args) noexcept {
  if constexpr (!uses_allocator_v<T, Alloc>)
    return forward_as_tuple(forward<Args>(args)...);
  else if constexpr (is_constructible_v<T, allocator_arg_t, const Alloc &,
                                        Args...>)
    return tuple<allocator_arg_t, const Alloc &, Args &&...>(
        allocator_arg, alloc, forward<Args>(args)...);
  else {
    static_assert(is_constructible_v<T, Args..., const Alloc &>);
    return tuple<Args &&..., const Alloc &>(forward<Args>(args)..., alloc);
  }
}

template <class T, class Alloc, class Tuple1, class Tuple2>
constexpr auto
uses_allocator_construction_args(const Alloc &alloc, piecewise_construct_t,
                                 Tuple1 &&first, Tuple2 &&second) noexcept
  requires detail::is_pair<remove_cv_t<T>>::value
{
  return tuple_cat(
      make_tuple(piecewise_construct),
      make_tuple(apply(
          [&](auto &&...args) {
            return uses_allocator_construction_args<tuple_element_t<0, T>>(
                alloc, forward<decltype(args)>(args)...);
          },
          forward<Tuple1>(first))),
      make_tuple(apply(
          [&](auto &&...args) {
            return uses_allocator_construction_args<tuple_element_t<1, T>>(
                alloc, forward<decltype(args)>(args)...);
          },
          forward<Tuple2>(second))));
}

template <class T, class Alloc, class U, class V>
constexpr auto uses_allocator_construction_args(const Alloc &alloc, U &&first,
                                                V &&second) noexcept
  requires detail::is_pair<remove_cv_t<T>>::value
{
  return uses_allocator_construction_args<T>(
      alloc, piecewise_construct, forward_as_tuple(forward<U>(first)),
      forward_as_tuple(forward<V>(second)));
}

template <class T, class Alloc, class U, class V>
constexpr auto uses_allocator_construction_args(const Alloc &alloc,
                                                pair<U, V> &value) noexcept
  requires detail::is_pair<remove_cv_t<T>>::value
{
  return uses_allocator_construction_args<T>(alloc, value.first, value.second);
}
