class day {
  unsigned char value_{};

public:
  day() = default;
  explicit constexpr day(unsigned v) noexcept
      : value_(static_cast<unsigned char>(v)) {}
  constexpr day &operator++() noexcept {
    ++value_;
    return *this;
  }
  constexpr day operator++(int) noexcept {
    auto c = *this;
    ++*this;
    return c;
  }
  constexpr day &operator--() noexcept {
    --value_;
    return *this;
  }
  constexpr day operator--(int) noexcept {
    auto c = *this;
    --*this;
    return c;
  }
  constexpr day &operator+=(const days &d) noexcept {
    value_ = static_cast<unsigned char>(value_ + d.count());
    return *this;
  }
  constexpr day &operator-=(const days &d) noexcept { return *this += -d; }
  explicit constexpr operator unsigned() const noexcept { return value_; }
  constexpr bool ok() const noexcept { return value_ >= 1 && value_ <= 31; }
  friend constexpr bool operator==(day, day) = default;
  friend constexpr strong_ordering operator<=>(day a, day b) {
    return chrono_detail::compare_values(a.value_, b.value_);
  }
};
class month {
  unsigned char value_{};

public:
  month() = default;
  explicit constexpr month(unsigned v) noexcept
      : value_(static_cast<unsigned char>(v)) {}
  constexpr month &operator++() noexcept { return *this += months{1}; }
  constexpr month operator++(int) noexcept {
    auto c = *this;
    ++*this;
    return c;
  }
  constexpr month &operator--() noexcept { return *this -= months{1}; }
  constexpr month operator--(int) noexcept {
    auto c = *this;
    --*this;
    return c;
  }
  constexpr month &operator+=(const months &m) noexcept {
    auto n = (int(value_) - 1 + m.count()) % 12;
    if (n < 0)
      n += 12;
    value_ = static_cast<unsigned char>(n + 1);
    return *this;
  }
  constexpr month &operator-=(const months &m) noexcept { return *this += -m; }
  explicit constexpr operator unsigned() const noexcept { return value_; }
  constexpr bool ok() const noexcept { return value_ >= 1 && value_ <= 12; }
  friend constexpr bool operator==(month, month) = default;
  friend constexpr strong_ordering operator<=>(month a, month b) {
    return chrono_detail::compare_values(a.value_, b.value_);
  }
};
