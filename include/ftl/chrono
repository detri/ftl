  template <class D>
    requires requires(const sys_time<D> &value) { Clock::from_sys(value); }
  constexpr auto operator()(const sys_time<D> &t) const {
    return Clock::from_sys(t);
  }
};
template <> struct clock_time_conversion<utc_clock, tai_clock> {
  template <class D> constexpr auto operator()(const tai_time<D> &t) const {
    return tai_clock::to_utc(t);
  }
};
template <> struct clock_time_conversion<tai_clock, utc_clock> {
  template <class D> constexpr auto operator()(const utc_time<D> &t) const {
    return tai_clock::from_utc(t);
  }
};
template <> struct clock_time_conversion<utc_clock, gps_clock> {
  template <class D> constexpr auto operator()(const gps_time<D> &t) const {
    return gps_clock::to_utc(t);
  }
};
template <> struct clock_time_conversion<gps_clock, utc_clock> {
  template <class D> constexpr auto operator()(const utc_time<D> &t) const {
    return gps_clock::from_utc(t);
  }
};
template <class DestinationClock, class SourceClock, class D>
constexpr auto clock_cast(const time_point<SourceClock, D> &t) {
  constexpr bool direct =
      requires { clock_time_conversion<DestinationClock, SourceClock>{}(t); };
  constexpr bool via_system = requires {
    clock_time_conversion<DestinationClock, system_clock>{}(
        clock_time_conversion<system_clock, SourceClock>{}(t));
  };
  constexpr bool via_utc = requires {
    clock_time_conversion<DestinationClock, utc_clock>{}(
        clock_time_conversion<utc_clock, SourceClock>{}(t));
  };
  constexpr bool via_system_utc = requires {
    clock_time_conversion<DestinationClock, utc_clock>{}(
        clock_time_conversion<utc_clock, system_clock>{}(
            clock_time_conversion<system_clock, SourceClock>{}(t)));
  };
  constexpr bool via_utc_system = requires {
    clock_time_conversion<DestinationClock, system_clock>{}(
        clock_time_conversion<system_clock, utc_clock>{}(
            clock_time_conversion<utc_clock, SourceClock>{}(t)));
  };

  static_assert(direct || via_system || via_utc || via_system_utc ||
                via_utc_system);
  static_assert(direct || !(via_system && via_utc));
  static_assert(direct || via_system || via_utc ||
                !(via_system_utc && via_utc_system));

  if constexpr (direct)
    return clock_time_conversion<DestinationClock, SourceClock>{}(t);
  else if constexpr (via_system)
    return clock_time_conversion<DestinationClock, system_clock>{}(
        clock_time_conversion<system_clock, SourceClock>{}(t));
  else if constexpr (via_utc)
    return clock_time_conversion<DestinationClock, utc_clock>{}(
        clock_time_conversion<utc_clock, SourceClock>{}(t));
  else if constexpr (via_system_utc)
    return clock_time_conversion<DestinationClock, utc_clock>{}(
        clock_time_conversion<utc_clock, system_clock>{}(
            clock_time_conversion<system_clock, SourceClock>{}(t)));
  else
    return clock_time_conversion<DestinationClock, system_clock>{}(
        clock_time_conversion<system_clock, utc_clock>{}(
            clock_time_conversion<utc_clock, SourceClock>{}(t)));
}

enum class choose {
  earliest,
  latest,
};

struct sys_info {
  sys_seconds begin;
  sys_seconds end;
  seconds offset;
  minutes save;
  string abbrev;
};

struct local_info {
  static constexpr int unique = 0;
  static constexpr int nonexistent = 1;
  static constexpr int ambiguous = 2;

  int result;
  sys_info first;
  sys_info second;
};

class nonexistent_local_time : public runtime_error {
public:
  template <class Duration>
  nonexistent_local_time(const local_time<Duration> &, const local_info &)
      : runtime_error("nonexistent local time") {}
};

class ambiguous_local_time : public runtime_error {
public:
  template <class Duration>
  ambiguous_local_time(const local_time<Duration> &, const local_info &)
      : runtime_error("ambiguous local time") {}
};

namespace chrono_detail {
struct time_zone_storage;
}

class time_zone {
public:
  time_zone(time_zone &&) = default;
  time_zone &operator=(time_zone &&) = default;

  string_view name() const noexcept {
    return detail::tzdb_runtime::zone_name(
        detail::tzdb_runtime::zone_ref{index_});
  }

  template <class Duration>
  sys_info get_info(const sys_time<Duration> &st) const {
    /*
     * Generated transitions occur at integral system-clock seconds.
     * Flooring rather than truncating is significant for negative
     * subsecond timestamps.
     */
    const auto whole_second = floor<seconds>(st);

    const auto interval = detail::tzdb_runtime::lookup(
        detail::tzdb_runtime::zone_ref{index_},
        whole_second.time_since_epoch().count());

    if (!interval)
      throw runtime_error(
          "chrono::time_zone::get_info: outside tzdb coverage");

    return make_sys_info(interval);
  }

  template <class Duration>
  local_info get_info(const local_time<Duration> &tp) const {
    /*
     * All generated transition boundaries are integral seconds.
     * Flooring preserves the correct side of a boundary for negative
     * subsecond local times as well.
     */
    const auto whole_second = floor<seconds>(tp);

    const auto lookup = detail::tzdb_runtime::lookup_local(
        detail::tzdb_runtime::zone_ref{index_},
        whole_second.time_since_epoch().count());

    if (!lookup)
      throw runtime_error(
          "chrono::time_zone::get_info: outside tzdb coverage");

    local_info result{};

    switch (lookup.result) {
    case detail::tzdb_runtime::local_result_kind::unique:
      result.result = local_info::unique;
      result.first = make_sys_info(lookup.first);
      break;

    case detail::tzdb_runtime::local_result_kind::nonexistent:
      result.result = local_info::nonexistent;
      result.first = make_sys_info(lookup.first);
      result.second = make_sys_info(lookup.second);
      break;

    case detail::tzdb_runtime::local_result_kind::ambiguous:
      result.result = local_info::ambiguous;
      result.first = make_sys_info(lookup.first);
      result.second = make_sys_info(lookup.second);
      break;

    case detail::tzdb_runtime::local_result_kind::invalid:
      throw runtime_error(
          "chrono::time_zone::get_info: invalid local-time result");
    }

    return result;
  }

  template <class Duration>
  sys_time<common_type_t<Duration, seconds>>
  to_sys(const local_time<Duration> &tp) const {
    using result_duration = common_type_t<Duration, seconds>;

    const auto info = get_info(tp);

    switch (info.result) {
    case local_info::unique:
      return sys_time<result_duration>{
          result_duration{tp.time_since_epoch()} -
          result_duration{info.first.offset}};

    case local_info::nonexistent:
      throw nonexistent_local_time(tp, info);

    case local_info::ambiguous:
      throw ambiguous_local_time(tp, info);
    }

    throw runtime_error(
        "chrono::time_zone::to_sys: invalid local_info result");
  }

  template <class Duration>
  sys_time<common_type_t<Duration, seconds>>
  to_sys(const local_time<Duration> &tp, choose selection) const {
    using result_duration = common_type_t<Duration, seconds>;

    const auto info = get_info(tp);

    switch (info.result) {
    case local_info::unique:
      return sys_time<result_duration>{
          result_duration{tp.time_since_epoch()} -
          result_duration{info.first.offset}};

    case local_info::nonexistent:
      /*
       * A gap is bounded by two local representations of the same
       * system-clock transition instant.
       */
      return sys_time<result_duration>{
          result_duration{info.first.end.time_since_epoch()}};

    case local_info::ambiguous: {
      const auto &selected =
          selection == choose::earliest ? info.first : info.second;

      return sys_time<result_duration>{
          result_duration{tp.time_since_epoch()} -
          result_duration{selected.offset}};
    }
    }

    throw runtime_error(
        "chrono::time_zone::to_sys: invalid local_info result");
  }

  template <class Duration>
  local_time<common_type_t<Duration, seconds>>
  to_local(const sys_time<Duration> &tp) const {
    using result_duration = common_type_t<Duration, seconds>;

    const auto info = get_info(tp);

    return local_time<result_duration>{
        result_duration{tp.time_since_epoch()} +
        result_duration{info.offset}};
  }

private:
  constexpr time_zone() noexcept = default;

  static sys_info
  make_sys_info(const detail::tzdb_runtime::zone_interval &interval) {
    sys_info result;

    result.begin =
        interval.begin_unbounded
            ? sys_seconds::min()
            : sys_seconds{seconds{interval.begin}};

    result.end = sys_seconds{seconds{interval.end}};
    result.offset = seconds{interval.offset_seconds};
    result.save = minutes{interval.save_minutes};
    result.abbrev = interval.abbreviation;

    return result;
  }

  unsigned index_ = 0;

  friend struct chrono_detail::time_zone_storage;
};

namespace chrono_detail {

/*
 * The generated tzdb owns the canonical zone ordering. Mirror that ordering
 * with one stable public time_zone object per generated canonical Zone.
 *
 * Links never receive their own time_zone object: locate_zone(alias) returns
 * the canonical target object, matching tzdb::locate_zone semantics.
 */
struct time_zone_storage {
  time_zone zones[detail::tzdb_runtime::zone_count()];

  constexpr time_zone_storage() noexcept {
    for (unsigned index = 0; index < detail::tzdb_runtime::zone_count();
         ++index) {
      zones[index].index_ = index;
    }
  }
};

inline const time_zone_storage &time_zone_objects() noexcept {
  static constexpr time_zone_storage storage{};
  return storage;
}

} // namespace chrono_detail

inline const time_zone *locate_zone(string_view name) {
  const auto zone =
      detail::tzdb_runtime::locate_zone(name.data(), name.size());

  if (!zone)
    throw runtime_error("chrono::locate_zone: time zone not found");

  return &chrono_detail::time_zone_objects().zones[zone.index];
}

inline bool operator==(const time_zone &left,
                       const time_zone &right) noexcept {
  return left.name() == right.name();
}

inline strong_ordering operator<=>(const time_zone &left,
                                   const time_zone &right) noexcept {
  return left.name() <=> right.name();
}

