template <class R1, class P, class R2>
  requires is_convertible_v<const R2 &, common_type_t<R1, R2>>
constexpr auto operator*(duration<R1, P> d, const R2 &value) {
  using C = common_type_t<R1, R2>;
  return duration<C, P>(C(d.count()) * C(value));
}
template <class R1, class P, class R2>
  requires is_convertible_v<const R1 &, common_type_t<R1, R2>>
constexpr auto operator*(const R1 &value, duration<R2, P> d) {
  return d * value;
}
template <class R1, class P, class R2>
  requires is_convertible_v<const R2 &, common_type_t<R1, R2>> &&
           (!chrono_detail::is_duration<remove_cvref_t<R2>>::value)
constexpr auto operator/(duration<R1, P> d, const R2 &value) {
  using C = common_type_t<R1, R2>;
  return duration<C, P>(C(d.count()) / C(value));
}
template <class R1, class P1, class R2, class P2>
constexpr auto operator/(duration<R1, P1> a, duration<R2, P2> b) {
  using C = duration_common_t<R1, P1, R2, P2>;
  return C(a).count() / C(b).count();
}
template <class R1, class P, class R2>
  requires(!treat_as_floating_point_v<common_type_t<R1, R2>>)
constexpr auto operator%(duration<R1, P> d, const R2 &value) {
  using C = common_type_t<R1, R2>;
  return duration<C, P>(C(d.count()) % C(value));
}
template <class R1, class P1, class R2, class P2>
constexpr auto operator%(duration<R1, P1> a, duration<R2, P2> b) {
  using C = duration_common_t<R1, P1, R2, P2>;
  return C(C(a).count() % C(b).count());
}
template <class R1, class P1, class R2, class P2>
constexpr bool operator==(duration<R1, P1> a, duration<R2, P2> b) {
  using C = duration_common_t<R1, P1, R2, P2>;
  return C(a).count() == C(b).count();
}
template <class R1, class P1, class R2, class P2>
constexpr auto operator<=>(duration<R1, P1> a, duration<R2, P2> b) {
  using C = duration_common_t<R1, P1, R2, P2>;
  return chrono_detail::compare_values(C(a).count(), C(b).count());
}

template <class To, class Rep, class Period>
constexpr To floor(const duration<Rep, Period> &d) {
  auto result = duration_cast<To>(d);
  if (result > d)
    --result;
  return result;
}
template <class To, class Rep, class Period>
constexpr To ceil(const duration<Rep, Period> &d) {
  auto result = duration_cast<To>(d);
  if (result < d)
    ++result;
  return result;
}
template <class To, class Rep, class Period>
  requires(!treat_as_floating_point_v<typename To::rep>)
constexpr To round(const duration<Rep, Period> &d) {
  auto low = floor<To>(d), high = low + To{1};
  auto dl = d - low, dh = high - d;
  return dl < dh ? low : dh < dl ? high : low.count() % 2 ? high : low;
}
template <class Rep, class Period>
  requires numeric_limits<Rep>::is_signed
constexpr duration<Rep, Period> abs(duration<Rep, Period> d) {
  return d < duration<Rep, Period>::zero() ? -d : d;
}

