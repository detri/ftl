namespace chrono {

namespace chrono_detail {
template <class T> constexpr auto compare_values(const T &a, const T &b) {
  using category =
      conditional_t<is_floating_point_v<T>, partial_ordering, strong_ordering>;
  return a < b   ? category::less
         : b < a ? category::greater
                 : category::equivalent;
}
} // namespace chrono_detail

template <class Rep> struct treat_as_floating_point : is_floating_point<Rep> {};
template <class Rep>
inline constexpr bool treat_as_floating_point_v =
    treat_as_floating_point<Rep>::value;
template <class Rep> struct duration_values {
  static constexpr Rep zero() noexcept { return Rep(0); }
  static constexpr Rep min() noexcept { return numeric_limits<Rep>::lowest(); }
  static constexpr Rep max() noexcept { return numeric_limits<Rep>::max(); }
};

template <class Rep, class Period = ratio<1>> class duration;
namespace chrono_detail {
template <class> struct is_duration : false_type {};
template <class Rep, class Period>
struct is_duration<duration<Rep, Period>> : true_type {};
template <class> struct is_ratio : false_type {};
template <intmax_t Numerator, intmax_t Denominator>
struct is_ratio<ratio<Numerator, Denominator>> : true_type {};
} // namespace chrono_detail
template <class To, class Rep, class Period>
constexpr To duration_cast(const duration<Rep, Period> &value);

template <class Rep, class Period> class duration {
  static_assert(!chrono_detail::is_duration<Rep>::value);
  static_assert(chrono_detail::is_ratio<Period>::value && Period::num > 0);
  Rep value_{};

public:
  using rep = Rep;
  using period = typename Period::type;
  constexpr duration() = default;
  template <class R>
    requires is_convertible_v<const R &, Rep> &&
             (treat_as_floating_point_v<Rep> || !treat_as_floating_point_v<R>)
  explicit constexpr duration(const R &value) : value_(value) {}
  template <class R, class P>
    requires(treat_as_floating_point_v<Rep> ||
             (ratio_divide_t<P, Period>::den == 1 &&
              !treat_as_floating_point_v<R>))
  constexpr duration(const duration<R, P> &other)
      : value_(duration_cast<duration>(other).count()) {}
  constexpr Rep count() const { return value_; }
  constexpr duration operator+() const { return *this; }
  constexpr duration operator-() const { return duration(-value_); }
  constexpr duration &operator++() {
    ++value_;
    return *this;
  }
  constexpr duration operator++(int) {
    auto copy = *this;
    ++*this;
    return copy;
  }
  constexpr duration &operator--() {
    --value_;
    return *this;
  }
  constexpr duration operator--(int) {
    auto copy = *this;
    --*this;
    return copy;
  }
  constexpr duration &operator+=(const duration &other) {
    value_ += other.value_;
    return *this;
  }
  constexpr duration &operator-=(const duration &other) {
    value_ -= other.value_;
    return *this;
  }
  constexpr duration &operator*=(const Rep &value) {
    value_ *= value;
    return *this;
  }
  constexpr duration &operator/=(const Rep &value) {
    value_ /= value;
    return *this;
  }
  constexpr duration &operator%=(const Rep &value) {
    value_ %= value;
    return *this;
  }
  constexpr duration &operator%=(const duration &value) {
    value_ %= value.value_;
    return *this;
  }
  static constexpr duration zero() noexcept {
    return duration(duration_values<Rep>::zero());
  }
  static constexpr duration min() noexcept {
    return duration(duration_values<Rep>::min());
  }
  static constexpr duration max() noexcept {
    return duration(duration_values<Rep>::max());
  }
};

template <class To, class Rep, class Period>
constexpr To duration_cast(const duration<Rep, Period> &value) {
  using factor = ratio_divide_t<Period, typename To::period>;
  using common = common_type_t<typename To::rep, Rep, intmax_t>;
  if constexpr (factor::num == 1 && factor::den == 1)
    return To(static_cast<typename To::rep>(value.count()));
  else if constexpr (factor::den == 1)
    return To(
        static_cast<typename To::rep>(common(value.count()) * factor::num));
  else if constexpr (factor::num == 1)
    return To(
        static_cast<typename To::rep>(common(value.count()) / factor::den));
  else
    return To(static_cast<typename To::rep>(common(value.count()) *
                                            factor::num / factor::den));
}

template <class R1, class P1, class R2, class P2>
using duration_common_t = duration<
    common_type_t<R1, R2>,
    ratio<detail::ratio_gcd(P1::num, P2::num),
          intmax_t(P1::den / detail::ratio_gcd(P1::den, P2::den) * P2::den)>>;

} // namespace chrono

template <class R1, class P1, class R2, class P2>
struct common_type<chrono::duration<R1, P1>, chrono::duration<R2, P2>> {
  using type = chrono::duration_common_t<R1, P1, R2, P2>;
};

