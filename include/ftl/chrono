template <class Clock, class Duration = typename Clock::duration>
class time_point {
  static_assert(chrono_detail::is_duration<Duration>::value);
  Duration value_{};

public:
  using clock = Clock;
  using duration = Duration;
  using rep = typename Duration::rep;
  using period = typename Duration::period;
  constexpr time_point() = default;
  explicit constexpr time_point(const Duration &d) : value_(d) {}
  template <class D>
    requires is_convertible_v<D, Duration>
  constexpr time_point(const time_point<Clock, D> &p)
      : value_(p.time_since_epoch()) {}
  constexpr Duration time_since_epoch() const { return value_; }
  constexpr time_point &operator++() {
    ++value_;
    return *this;
  }
  constexpr time_point operator++(int) { return time_point{value_++}; }
  constexpr time_point &operator--() {
    --value_;
    return *this;
  }
  constexpr time_point operator--(int) { return time_point{value_--}; }
  constexpr time_point &operator+=(const Duration &d) {
    value_ += d;
    return *this;
  }
  constexpr time_point &operator-=(const Duration &d) {
    value_ -= d;
    return *this;
  }
  static constexpr time_point min() noexcept {
    return time_point(Duration::min());
  }
  static constexpr time_point max() noexcept {
    return time_point(Duration::max());
  }
};
template <class C, class D1, class R, class P>
constexpr auto operator+(time_point<C, D1> p, duration<R, P> d) {
  using D = duration_common_t<typename D1::rep, typename D1::period, R, P>;
  return time_point<C, D>(D(p.time_since_epoch()) + D(d));
}
template <class R, class P, class C, class D>
constexpr auto operator+(duration<R, P> d, time_point<C, D> p) {
  return p + d;
}
template <class C, class D1, class R, class P>
constexpr auto operator-(time_point<C, D1> p, duration<R, P> d) {
  return p + (-d);
}
template <class C, class D1, class D2>
constexpr auto operator-(time_point<C, D1> a, time_point<C, D2> b) {
  return a.time_since_epoch() - b.time_since_epoch();
}
template <class C, class D1, class D2>
constexpr bool operator==(time_point<C, D1> a, time_point<C, D2> b) {
  return a.time_since_epoch() == b.time_since_epoch();
}
template <class C, class D1, class D2>
constexpr auto operator<=>(time_point<C, D1> a, time_point<C, D2> b) {
  return chrono_detail::compare_values(a.time_since_epoch(),
                                       b.time_since_epoch());
}
template <class To, class C, class D>
constexpr auto time_point_cast(const time_point<C, D> &p) {
  return time_point<C, To>(duration_cast<To>(p.time_since_epoch()));
}
template <class To, class C, class D>
constexpr auto floor(const time_point<C, D> &p) {
  return time_point<C, To>(chrono::floor<To>(p.time_since_epoch()));
}
template <class To, class C, class D>
constexpr auto ceil(const time_point<C, D> &p) {
  return time_point<C, To>(chrono::ceil<To>(p.time_since_epoch()));
}
template <class To, class C, class D>
constexpr auto round(const time_point<C, D> &p) {
  return time_point<C, To>(chrono::round<To>(p.time_since_epoch()));
}

struct system_clock {
