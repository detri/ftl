class weekday {
  unsigned char value_{};

public:
  weekday() = default;
  explicit constexpr weekday(unsigned v)
      : value_(static_cast<unsigned char>(v == 7 ? 0 : v)) {}
  constexpr weekday(const sys_days &d)
      : value_(static_cast<unsigned char>(
            ((d.time_since_epoch().count() + 4) % 7 + 7) % 7)) {}
  explicit constexpr weekday(const local_days &d)
      : weekday(sys_days{d.time_since_epoch()}) {}
  constexpr weekday &operator++() { return *this += days{1}; }
  constexpr weekday operator++(int) {
    auto copy = *this;
    ++*this;
    return copy;
  }
  constexpr weekday &operator--() { return *this -= days{1}; }
  constexpr weekday operator--(int) {
    auto copy = *this;
    --*this;
    return copy;
  }
  constexpr unsigned c_encoding() const { return value_; }
  constexpr unsigned iso_encoding() const { return value_ == 0 ? 7 : value_; }
  constexpr bool ok() const { return value_ <= 6; }
  constexpr weekday &operator+=(const days &d) {
    auto n = (int(value_) + d.count()) % 7;
    if (n < 0)
      n += 7;
    value_ = static_cast<unsigned char>(n);
    return *this;
  }
  constexpr weekday &operator-=(const days &d) { return *this += -d; }
  constexpr weekday_indexed operator[](unsigned) const;
  constexpr weekday_last operator[](last_spec) const;
  friend constexpr bool operator==(weekday, weekday) = default;
};
