template <class IntType = int> class discrete_distribution {
  static_assert(is_integral_v<IntType> && !is_same_v<remove_cv_t<IntType>, bool>);
public:
  using result_type = IntType;
  class param_type {
  public:
    using distribution_type = discrete_distribution;
    param_type() : probabilities_{1.0} {}
    template <class InputIterator>
    param_type(InputIterator first, InputIterator last) {
      for (; first != last; ++first)
        probabilities_.push_back(static_cast<double>(*first));
      normalize();
    }
    param_type(initializer_list<double> weights)
        : param_type(weights.begin(), weights.end()) {}
    template <class UnaryOperation>
    param_type(size_t count, double minimum, double maximum, UnaryOperation weight) {
      if (count == 0) {
        probabilities_.push_back(1.0);
      } else {
        const double delta = (maximum - minimum) / static_cast<double>(count);
        for (size_t i = 0; i < count; ++i)
          probabilities_.push_back(weight(minimum + (static_cast<double>(i) + 0.5) * delta));
        normalize();
      }
    }
    vector<double> probabilities() const { return probabilities_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    friend class discrete_distribution;
    friend struct detail::random_stream_access;
    void normalize() {
      if (probabilities_.empty()) {
        probabilities_.push_back(1.0);
        return;
      }
      double sum = 0;
      for (double value : probabilities_)
        sum += value;
      for (double &value : probabilities_)
        value /= sum;
    }
    vector<double> probabilities_;
  };

  discrete_distribution() = default;
  template <class InputIterator>
  discrete_distribution(InputIterator first, InputIterator last) : parameters_(first, last) {}
  discrete_distribution(initializer_list<double> weights) : parameters_(weights) {}
  template <class UnaryOperation>
  discrete_distribution(size_t count, double minimum, double maximum, UnaryOperation weight)
      : parameters_(count, minimum, maximum, weight) {}
  explicit discrete_distribution(const param_type &parameters) : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) { return (*this)(generator, parameters_); }
  template <class URBG> result_type operator()(URBG &generator, const param_type &p) {
    const double value = detail::random_unit<double>(generator);
    double cumulative = 0;
    for (size_t i = 0; i + 1 < p.probabilities_.size(); ++i) {
      cumulative += p.probabilities_[i];
      if (value < cumulative)
        return static_cast<result_type>(i);
    }
    return static_cast<result_type>(p.probabilities_.size() - 1);
  }
  vector<double> probabilities() const { return parameters_.probabilities(); }
  param_type param() const { return parameters_; }
  void param(const param_type &p) { parameters_ = p; }
  result_type min() const noexcept { return 0; }
  result_type max() const noexcept {
    return static_cast<result_type>(parameters_.probabilities_.size() - 1);
  }
  friend bool operator==(const discrete_distribution &,
                         const discrete_distribution &) = default;
private:
  friend struct detail::random_stream_access;
  param_type parameters_;
};

template <class RealType = double> class piecewise_constant_distribution {
  static_assert(is_floating_point_v<RealType>);
public:
  using result_type = RealType;
  class param_type {
  public:
    using distribution_type = piecewise_constant_distribution;
    param_type() : intervals_{result_type{0}, result_type{1}}, densities_{result_type{1}} {}
    template <class InputIteratorB, class InputIteratorW>
    param_type(InputIteratorB first_boundary, InputIteratorB last_boundary,
               InputIteratorW first_weight) {
      for (; first_boundary != last_boundary; ++first_boundary)
        intervals_.push_back(static_cast<result_type>(*first_boundary));
      if (intervals_.size() < 2) {
        intervals_ = vector<result_type>{result_type{0}, result_type{1}};
        densities_ = vector<result_type>{result_type{1}};
        return;
      }
      vector<result_type> weights;
      for (size_t i = 0; i + 1 < intervals_.size(); ++i, ++first_weight)
        weights.push_back(static_cast<result_type>(*first_weight));
      initialize(weights);
    }
    template <class UnaryOperation>
    param_type(initializer_list<result_type> boundaries, UnaryOperation weight) {
      if (boundaries.size() < 2) {
        intervals_ = vector<result_type>{result_type{0}, result_type{1}};
        densities_ = vector<result_type>{result_type{1}};
        return;
      }
      for (result_type boundary : boundaries)
        intervals_.push_back(boundary);
      vector<result_type> weights;
      for (size_t i = 0; i + 1 < intervals_.size(); ++i)
        weights.push_back(static_cast<result_type>(
            weight((intervals_[i] + intervals_[i + 1]) / result_type{2})));
      initialize(weights);
    }
    template <class UnaryOperation>
    param_type(size_t count, result_type minimum, result_type maximum,
               UnaryOperation weight) {
      const size_t n = count == 0 ? 1 : count;
      const result_type delta = (maximum - minimum) / static_cast<result_type>(n);
      for (size_t i = 0; i <= n; ++i)
        intervals_.push_back(minimum + static_cast<result_type>(i) * delta);
      vector<result_type> weights;
      for (size_t i = 0; i < n; ++i)
        weights.push_back(static_cast<result_type>(
            weight(intervals_[i] + delta / result_type{2})));
      initialize(weights);
    }
    vector<result_type> intervals() const { return intervals_; }
    vector<result_type> densities() const { return densities_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    friend class piecewise_constant_distribution;
    friend struct detail::random_stream_access;
    void initialize(const vector<result_type> &weights) {
      result_type sum = 0;
      for (result_type weight : weights)
        sum += weight;
      for (size_t i = 0; i < weights.size(); ++i)
        densities_.push_back(weights[i] /
            (sum * (intervals_[i + 1] - intervals_[i])));
    }
    vector<result_type> intervals_;
    vector<result_type> densities_;
  };

  piecewise_constant_distribution() = default;
  template <class InputIteratorB, class InputIteratorW>
  piecewise_constant_distribution(InputIteratorB first_boundary,
      InputIteratorB last_boundary, InputIteratorW first_weight)
      : parameters_(first_boundary, last_boundary, first_weight) {}
  template <class UnaryOperation>
  piecewise_constant_distribution(initializer_list<result_type> boundaries,
                                  UnaryOperation weight)
      : parameters_(boundaries, weight) {}
  template <class UnaryOperation>
  piecewise_constant_distribution(size_t count, result_type minimum,
      result_type maximum, UnaryOperation weight)
      : parameters_(count, minimum, maximum, weight) {}
  explicit piecewise_constant_distribution(const param_type &parameters)
      : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) { return (*this)(generator, parameters_); }
  template <class URBG> result_type operator()(URBG &generator, const param_type &p) {
    const result_type value = detail::random_unit<result_type>(generator);
    result_type lower_mass = 0;
    for (size_t index = 0; index < p.densities_.size(); ++index) {
      const result_type interval_mass =
          p.densities_[index] * (p.intervals_[index + 1] - p.intervals_[index]);
      if (index + 1 == p.densities_.size() || value < lower_mass + interval_mass)
        return p.intervals_[index] + (value - lower_mass) / p.densities_[index];
      lower_mass += interval_mass;
    }
    return p.intervals_.back();
  }
  vector<result_type> intervals() const { return parameters_.intervals(); }
  vector<result_type> densities() const { return parameters_.densities(); }
  param_type param() const { return parameters_; }
  void param(const param_type &p) { parameters_ = p; }
  result_type min() const noexcept { return parameters_.intervals_[0]; }
  result_type max() const noexcept { return parameters_.intervals_.back(); }
  friend bool operator==(const piecewise_constant_distribution &,
                         const piecewise_constant_distribution &) = default;
private:
  friend struct detail::random_stream_access;
  param_type parameters_;
};

template <class RealType = double> class piecewise_linear_distribution {
  static_assert(is_floating_point_v<RealType>);
public:
  using result_type = RealType;
  class param_type {
  public:
    using distribution_type = piecewise_linear_distribution;
    param_type()
        : intervals_{result_type{0}, result_type{1}},
          densities_{result_type{1}, result_type{1}} {}
    template <class InputIteratorB, class InputIteratorW>
    param_type(InputIteratorB first_boundary, InputIteratorB last_boundary,
               InputIteratorW first_weight) {
      for (; first_boundary != last_boundary; ++first_boundary)
        intervals_.push_back(static_cast<result_type>(*first_boundary));
      if (intervals_.size() < 2) {
        set_default();
        return;
      }
      for (size_t i = 0; i < intervals_.size(); ++i, ++first_weight)
        densities_.push_back(static_cast<result_type>(*first_weight));
      normalize();
    }
    template <class UnaryOperation>
    param_type(initializer_list<result_type> boundaries, UnaryOperation weight) {
      if (boundaries.size() < 2) {
        set_default();
        return;
      }
      for (result_type boundary : boundaries) {
        intervals_.push_back(boundary);
        densities_.push_back(static_cast<result_type>(weight(boundary)));
      }
      normalize();
    }
    template <class UnaryOperation>
    param_type(size_t count, result_type minimum, result_type maximum,
               UnaryOperation weight) {
      const size_t n = count == 0 ? 1 : count;
      const result_type delta = (maximum - minimum) / static_cast<result_type>(n);
      for (size_t i = 0; i <= n; ++i) {
        const result_type boundary = minimum + static_cast<result_type>(i) * delta;
        intervals_.push_back(boundary);
        densities_.push_back(static_cast<result_type>(weight(boundary)));
      }
      normalize();
    }
    vector<result_type> intervals() const { return intervals_; }
    vector<result_type> densities() const { return densities_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    friend class piecewise_linear_distribution;
    friend struct detail::random_stream_access;
    void set_default() {
      intervals_ = vector<result_type>{result_type{0}, result_type{1}};
      densities_ = vector<result_type>{result_type{1}, result_type{1}};
    }
    void normalize() {
      result_type area = 0;
      for (size_t i = 0; i + 1 < intervals_.size(); ++i)
        area += (densities_[i] + densities_[i + 1]) *
                (intervals_[i + 1] - intervals_[i]) / result_type{2};
      for (result_type &density : densities_)
        density /= area;
    }
    vector<result_type> intervals_;
    vector<result_type> densities_;
  };

  piecewise_linear_distribution() = default;
  template <class InputIteratorB, class InputIteratorW>
  piecewise_linear_distribution(InputIteratorB first_boundary,
      InputIteratorB last_boundary, InputIteratorW first_weight)
      : parameters_(first_boundary, last_boundary, first_weight) {}
  template <class UnaryOperation>
  piecewise_linear_distribution(initializer_list<result_type> boundaries,
                                UnaryOperation weight)
      : parameters_(boundaries, weight) {}
  template <class UnaryOperation>
  piecewise_linear_distribution(size_t count, result_type minimum,
      result_type maximum, UnaryOperation weight)
      : parameters_(count, minimum, maximum, weight) {}
  explicit piecewise_linear_distribution(const param_type &parameters)
      : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) { return (*this)(generator, parameters_); }
  template <class URBG> result_type operator()(URBG &generator, const param_type &p) {
    const result_type value = detail::random_unit<result_type>(generator);
    result_type lower_mass = 0;
    for (size_t i = 0; i + 1 < p.intervals_.size(); ++i) {
      const result_type width = p.intervals_[i + 1] - p.intervals_[i];
      const result_type interval_mass =
          (p.densities_[i] + p.densities_[i + 1]) * width / result_type{2};
      if (i + 2 == p.intervals_.size() || value < lower_mass + interval_mass) {
        const result_type mass = value - lower_mass;
        const result_type slope = (p.densities_[i + 1] - p.densities_[i]) / width;
        const result_type offset = slope == result_type{0}
            ? mass / p.densities_[i]
            : result_type{2} * mass /
                  (p.densities_[i] +
                   sqrt(p.densities_[i] * p.densities_[i] +
                        result_type{2} * slope * mass));
        return p.intervals_[i] + offset;
      }
      lower_mass += interval_mass;
    }
    return p.intervals_.back();
  }
  vector<result_type> intervals() const { return parameters_.intervals(); }
  vector<result_type> densities() const { return parameters_.densities(); }
  param_type param() const { return parameters_; }
  void param(const param_type &p) { parameters_ = p; }
  result_type min() const noexcept { return parameters_.intervals_[0]; }
  result_type max() const noexcept { return parameters_.intervals_.back(); }
  friend bool operator==(const piecewise_linear_distribution &,
                         const piecewise_linear_distribution &) = default;
private:
  friend struct detail::random_stream_access;
  param_type parameters_;
};

namespace detail {

template <class Stream> class random_output_guard {
public:
  explicit random_output_guard(Stream &stream)
      : stream_(stream), flags_(stream.flags()), fill_(stream.fill()),
        precision_(stream.precision()) {
    stream_.setf(ios_base::dec, ios_base::basefield);
    stream_.setf(ios_base::left, ios_base::adjustfield);
    stream_.fill(stream_.widen(' '));
    stream_.precision(numeric_limits<long double>::max_digits10);
  }
  ~random_output_guard() {
    stream_.flags(flags_); stream_.fill(fill_); stream_.precision(precision_);
  }
private:
  Stream &stream_;
  ios_base::fmtflags flags_;
  typename Stream::char_type fill_;
  streamsize precision_;
};

template <class Stream> class random_input_guard {
public:
  explicit random_input_guard(Stream &stream)
      : stream_(stream), flags_(stream.flags()) {
    stream_.setf(ios_base::dec, ios_base::basefield);
  }
  ~random_input_guard() { stream_.flags(flags_); }
private:
  Stream &stream_;
  ios_base::fmtflags flags_;
};

struct random_stream_access {
  template <class O, class U, U a, U c, U m>
  static void write(O &o, const linear_congruential_engine<U, a, c, m> &x) {
    o << x.state_;
  }
  template <class I, class U, U a, U c, U m>
  static void read(I &i, linear_congruential_engine<U, a, c, m> &x) {
    U state{}; i >> state;
    if (i && state >= linear_congruential_engine<U, a, c, m>::min() &&
        state <= linear_congruential_engine<U, a, c, m>::max()) x.state_ = state;
    else i.setstate(ios_base::failbit);
  }

  template <class O, class U, size_t w, size_t n, size_t m, size_t r, U a,
            size_t u, U d, size_t s, U b, size_t t, U c, size_t l, U f>
  static void write(O &o, const mersenne_twister_engine<U, w, n, m, r, a, u,
                    d, s, b, t, c, l, f> &x) {
    for (size_t index = 0; index < n; ++index) {
      if (index) o << o.widen(' ');
      o << x.state_[(x.index_ + index) % n];
    }
  }
  template <class I, class U, size_t w, size_t n, size_t m, size_t r, U a,
            size_t u, U d, size_t s, U b, size_t t, U c, size_t l, U f>
  static void read(I &i, mersenne_twister_engine<U, w, n, m, r, a, u,
                   d, s, b, t, c, l, f> &x) {
    U state[n]{};
    for (size_t index = 0; index < n; ++index) i >> state[index];
    if (!i) return;
    for (size_t index = 0; index < n; ++index)
      if (state[index] > mersenne_twister_engine<U, w, n, m, r, a, u, d, s,
                                               b, t, c, l, f>::max()) {
        i.setstate(ios_base::failbit); return;
      }
    for (size_t index = 0; index < n; ++index) x.state_[index] = state[index];
    x.index_ = 0;
  }

  template <class O, class U, size_t w, size_t s, size_t r>
  static void write(O &o, const subtract_with_carry_engine<U, w, s, r> &x) {
    for (size_t index = 0; index < r; ++index) {
      if (index) o << o.widen(' ');
      o << x.state_[(x.index_ + index) % r];
    }
    o << o.widen(' ') << x.carry_;
  }
  template <class I, class U, size_t w, size_t s, size_t r>
  static void read(I &i, subtract_with_carry_engine<U, w, s, r> &x) {
    U state[r]{}; unsigned int carry{};
    for (size_t index = 0; index < r; ++index) i >> state[index];
    i >> carry;
    if (!i || carry > 1) { i.setstate(ios_base::failbit); return; }
    for (size_t index = 0; index < r; ++index)
      if (state[index] > subtract_with_carry_engine<U, w, s, r>::max()) {
        i.setstate(ios_base::failbit); return;
      }
    for (size_t index = 0; index < r; ++index) x.state_[index] = state[index];
    x.index_ = 0; x.carry_ = carry;
  }

  template <class O, class E, size_t p, size_t r>
  static void write(O &o, const discard_block_engine<E, p, r> &x) {
    o << x.engine_ << o.widen(' ') << x.used_;
  }
  template <class I, class E, size_t p, size_t r>
  static void read(I &i, discard_block_engine<E, p, r> &x) {
    E engine; size_t used{}; i >> engine >> used;
    if (!i || used > r) { i.setstate(ios_base::failbit); return; }
    x.engine_ = engine; x.used_ = used;
  }

  template <class O, class E, size_t w, class U>
  static void write(O &o, const independent_bits_engine<E, w, U> &x) { o << x.engine_; }
  template <class I, class E, size_t w, class U>
  static void read(I &i, independent_bits_engine<E, w, U> &x) {
    E engine; i >> engine; if (i) x.engine_ = engine;
  }

  template <class O, class E, size_t k>
  static void write(O &o, const shuffle_order_engine<E, k> &x) {
    o << x.engine_;
    for (size_t index = 0; index < k; ++index) o << o.widen(' ') << x.table_[index];
    o << o.widen(' ') << x.value_;
  }
  template <class I, class E, size_t k>
  static void read(I &i, shuffle_order_engine<E, k> &x) {
    E engine; typename E::result_type table[k]{}, value{}; i >> engine;
    for (size_t index = 0; index < k; ++index) i >> table[index];
    i >> value; if (!i) return;
    x.engine_ = engine;
    for (size_t index = 0; index < k; ++index) x.table_[index] = table[index];
    x.value_ = value;
  }

#define FTL_RANDOM_IO_ONE(Type, Getter)                                      \
  template <class O, class T> static void write(O &o, const Type<T> &x) {    \
    o << x.Getter();                                                         \
  }                                                                          \
  template <class I, class T> static void read(I &i, Type<T> &x) {           \
    T value{}; i >> value; if (i) x = Type<T>(value);                        \
  }

#define FTL_RANDOM_IO_TWO(Type, First, Second)                               \
  template <class O, class T> static void write(O &o, const Type<T> &x) {    \
    o << x.First() << o.widen(' ') << x.Second();                            \
  }                                                                          \
  template <class I, class T> static void read(I &i, Type<T> &x) {           \
    T first{}, second{}; i >> first >> second;                               \
    if (i) x = Type<T>(first, second);                                       \
  }

  FTL_RANDOM_IO_TWO(uniform_int_distribution, a, b)
  FTL_RANDOM_IO_TWO(uniform_real_distribution, a, b)
  FTL_RANDOM_IO_ONE(exponential_distribution, lambda)
  FTL_RANDOM_IO_TWO(gamma_distribution, alpha, beta)
  FTL_RANDOM_IO_TWO(weibull_distribution, a, b)
  FTL_RANDOM_IO_TWO(extreme_value_distribution, a, b)
  FTL_RANDOM_IO_TWO(cauchy_distribution, a, b)
  FTL_RANDOM_IO_ONE(chi_squared_distribution, n)
  FTL_RANDOM_IO_TWO(fisher_f_distribution, m, n)

#undef FTL_RANDOM_IO_TWO
#undef FTL_RANDOM_IO_ONE

  template <class O> static void write(O &o, const bernoulli_distribution &x) {
    o << x.p();
  }
  template <class I> static void read(I &i, bernoulli_distribution &x) {
    double value{}; i >> value; if (i) x = bernoulli_distribution(value);
  }

  template <class O, class T> static void write(O &o, const binomial_distribution<T> &x) {
    o << x.t() << o.widen(' ') << x.p();
  }
  template <class I, class T> static void read(I &i, binomial_distribution<T> &x) {
    T trials{}; double probability{}; i >> trials >> probability;
    if (i) x = binomial_distribution<T>(trials, probability);
  }
  template <class O, class T>
  static void write(O &o, const negative_binomial_distribution<T> &x) {
    o << x.k() << o.widen(' ') << x.p();
  }
  template <class I, class T>
  static void read(I &i, negative_binomial_distribution<T> &x) {
    T successes{}; double probability{}; i >> successes >> probability;
    if (i) x = negative_binomial_distribution<T>(successes, probability);
  }
  template <class O, class T> static void write(O &o, const geometric_distribution<T> &x) {
    o << x.p();
  }
  template <class I, class T> static void read(I &i, geometric_distribution<T> &x) {
    double probability{}; i >> probability;
    if (i) x = geometric_distribution<T>(probability);
  }
  template <class O, class T> static void write(O &o, const poisson_distribution<T> &x) {
    o << x.mean();
  }
  template <class I, class T> static void read(I &i, poisson_distribution<T> &x) {
    double mean{}; i >> mean; if (i) x = poisson_distribution<T>(mean);
  }

  template <class O, class T> static void write(O &o, const normal_distribution<T> &x) {
    o << x.mean() << o.widen(' ') << x.stddev() << o.widen(' ')
      << static_cast<unsigned int>(x.saved_);
    if (x.saved_) o << o.widen(' ') << x.saved_value_;
  }
  template <class I, class T> static void read(I &i, normal_distribution<T> &x) {
    T mean{}, deviation{}, saved_value{}; unsigned int saved{};
    i >> mean >> deviation >> saved;
    if (saved) i >> saved_value;
    if (i) {
      x.parameters_ = typename normal_distribution<T>::param_type(mean, deviation);
      if (saved > 1) { i.setstate(ios_base::failbit); return; }
      x.saved_ = saved != 0; x.saved_value_ = saved_value;
    }
  }

  template <class O, class T> static void write(O &o, const lognormal_distribution<T> &x) {
    o << x.m() << o.widen(' ') << x.s() << o.widen(' ') << x.normal_;
  }
  template <class I, class T> static void read(I &i, lognormal_distribution<T> &x) {
    T mean{}, deviation{}; normal_distribution<T> normal;
    i >> mean >> deviation >> normal;
    if (i) {
      x.parameters_ = typename lognormal_distribution<T>::param_type(mean, deviation);
      x.normal_ = normal;
    }
  }

  template <class O, class T> static void write(O &o, const student_t_distribution<T> &x) {
    o << x.n() << o.widen(' ') << x.normal_;
  }
  template <class I, class T> static void read(I &i, student_t_distribution<T> &x) {
    T degrees{}; normal_distribution<T> normal; i >> degrees >> normal;
    if (i) {
      x.parameters_ = typename student_t_distribution<T>::param_type(degrees);
      x.normal_ = normal;
    }
  }

  template <class O, class T> static void write(O &o, const discrete_distribution<T> &x) {
    o << x.parameters_.probabilities_.size();
    for (double value : x.parameters_.probabilities_) o << o.widen(' ') << value;
  }
  template <class I, class T> static void read(I &i, discrete_distribution<T> &x) {
    size_t count{}; i >> count; vector<double> values(count);
    for (size_t index = 0; index < count; ++index) i >> values[index];
    if (!i || count == 0) { i.setstate(ios_base::failbit); return; }
    x.parameters_.probabilities_ = static_cast<vector<double> &&>(values);
  }

  template <class O, class T>
  static void write(O &o, const piecewise_constant_distribution<T> &x) {
    o << x.parameters_.intervals_.size();
    for (T value : x.parameters_.intervals_) o << o.widen(' ') << value;
    for (T value : x.parameters_.densities_) o << o.widen(' ') << value;
  }
  template <class I, class T>
  static void read(I &i, piecewise_constant_distribution<T> &x) {
    size_t count{}; i >> count;
    vector<T> intervals(count), densities(count > 0 ? count - 1 : 0);
    for (T &value : intervals) i >> value;
    for (T &value : densities) i >> value;
    if (!i || count < 2) { i.setstate(ios_base::failbit); return; }
    x.parameters_.intervals_ = static_cast<vector<T> &&>(intervals);
    x.parameters_.densities_ = static_cast<vector<T> &&>(densities);
  }

  template <class O, class T>
  static void write(O &o, const piecewise_linear_distribution<T> &x) {
    o << x.parameters_.intervals_.size();
    for (T value : x.parameters_.intervals_) o << o.widen(' ') << value;
    for (T value : x.parameters_.densities_) o << o.widen(' ') << value;
  }
  template <class I, class T>
  static void read(I &i, piecewise_linear_distribution<T> &x) {
    size_t count{}; i >> count; vector<T> intervals(count), densities(count);
    for (T &value : intervals) i >> value;
    for (T &value : densities) i >> value;
    if (!i || count < 2) { i.setstate(ios_base::failbit); return; }
    x.parameters_.intervals_ = static_cast<vector<T> &&>(intervals);
    x.parameters_.densities_ = static_cast<vector<T> &&>(densities);
  }
};

} // namespace detail

template <class Character, class Traits, class Random>
  requires requires(basic_ostream<Character, Traits> &stream, const Random &value) {
    detail::random_stream_access::write(stream, value);
  }
basic_ostream<Character, Traits> &operator<<(basic_ostream<Character, Traits> &stream,
                                             const Random &value) {
  detail::random_output_guard guard(stream);
  detail::random_stream_access::write(stream, value);
  return stream;
}

template <class Character, class Traits, class Random>
  requires requires(basic_istream<Character, Traits> &stream, Random &value) {
    detail::random_stream_access::read(stream, value);
  }
basic_istream<Character, Traits> &operator>>(basic_istream<Character, Traits> &stream,
                                             Random &value) {
  detail::random_input_guard guard(stream);
  Random candidate(value);
  detail::random_stream_access::read(stream, candidate);
  if (stream) value = candidate;
  return stream;
}

