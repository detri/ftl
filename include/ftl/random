template <class RealType = double> class uniform_real_distribution {
  static_assert(is_floating_point_v<RealType>);

public:
  using result_type = RealType;
  class param_type {
  public:
    using distribution_type = uniform_real_distribution;
    explicit param_type(result_type lower = 0, result_type upper = 1)
        : lower_(lower), upper_(upper) {}
    result_type a() const noexcept { return lower_; }
    result_type b() const noexcept { return upper_; }
    friend bool operator==(const param_type &, const param_type &) = default;

  private:
    result_type lower_;
    result_type upper_;
  };

  uniform_real_distribution() : uniform_real_distribution(0) {}
  explicit uniform_real_distribution(result_type lower, result_type upper = 1)
      : parameters_(lower, upper) {}
  explicit uniform_real_distribution(const param_type &parameters)
      : parameters_(parameters) {}
  void reset() noexcept {}

  template <class URBG> result_type operator()(URBG &generator) {
    return (*this)(generator, parameters_);
  }
  template <class URBG>
  result_type operator()(URBG &generator, const param_type &parameters) {
    if (parameters.a() == parameters.b())
      return parameters.a();
    const result_type value = parameters.a() +
        (parameters.b() - parameters.a()) *
            generate_canonical<result_type, numeric_limits<result_type>::digits>(generator);
    return value < parameters.b() ? value
                                  : nextafter(parameters.b(), parameters.a());
  }
  result_type a() const noexcept { return parameters_.a(); }
  result_type b() const noexcept { return parameters_.b(); }
  param_type param() const noexcept { return parameters_; }
  void param(const param_type &parameters) noexcept { parameters_ = parameters; }
  result_type min() const noexcept { return a(); }
  result_type max() const noexcept { return b(); }
  friend bool operator==(const uniform_real_distribution &,
                         const uniform_real_distribution &) = default;

private:
  param_type parameters_;
};

namespace detail {
template <class Real, class URBG> Real random_unit(URBG &generator) {
  return generate_canonical<Real, numeric_limits<Real>::digits>(generator);
}
template <class Real, class URBG> Real random_open_unit(URBG &generator) {
  Real value;
  do {
    value = random_unit<Real>(generator);
  } while (value == Real{0});
  return value;
}
