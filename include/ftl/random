template <class IntType = int> class binomial_distribution {
  static_assert(is_integral_v<IntType> && !is_same_v<remove_cv_t<IntType>, bool>);
public:
  using result_type = IntType;
  class param_type {
  public:
    using distribution_type = binomial_distribution;
    explicit param_type(result_type trials = 1, double probability = 0.5)
        : trials_(trials), probability_(probability) {}
    result_type t() const noexcept { return trials_; }
    double p() const noexcept { return probability_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    result_type trials_;
    double probability_;
  };
  binomial_distribution() : binomial_distribution(1) {}
  explicit binomial_distribution(result_type trials, double probability = 0.5)
      : parameters_(trials, probability) {}
  explicit binomial_distribution(const param_type &parameters) : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) { return (*this)(generator, parameters_); }
  template <class URBG> result_type operator()(URBG &generator, const param_type &p) {
    if (p.p() == 0.0)
      return 0;
    if (p.p() == 1.0)
      return p.t();
    const bool complement = p.p() > 0.5;
    geometric_distribution<result_type> gaps(complement ? 1.0 - p.p() : p.p());
    result_type remaining = p.t();
    result_type count = 0;
    while (remaining > 0) {
      const result_type gap = gaps(generator);
      if (gap >= remaining)
        break;
      ++count;
      remaining -= gap + 1;
    }
    return complement ? p.t() - count : count;
  }
  result_type t() const noexcept { return parameters_.t(); }
  double p() const noexcept { return parameters_.p(); }
  param_type param() const noexcept { return parameters_; }
  void param(const param_type &p) noexcept { parameters_ = p; }
  result_type min() const noexcept { return 0; }
  result_type max() const noexcept { return t(); }
  friend bool operator==(const binomial_distribution &,
                         const binomial_distribution &) = default;
private:
  param_type parameters_;
};

