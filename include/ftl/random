template <class RealType = double> class normal_distribution {
  static_assert(is_floating_point_v<RealType>);
public:
  using result_type = RealType;
  class param_type {
  public:
    using distribution_type = normal_distribution;
    explicit param_type(result_type mean = 0, result_type deviation = 1)
        : mean_(mean), deviation_(deviation) {}
    result_type mean() const noexcept { return mean_; }
    result_type stddev() const noexcept { return deviation_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    result_type mean_;
    result_type deviation_;
  };
  normal_distribution() : normal_distribution(0) {}
  explicit normal_distribution(result_type mean, result_type deviation = 1)
      : parameters_(mean, deviation) {}
  explicit normal_distribution(const param_type &parameters) : parameters_(parameters) {}
  void reset() noexcept { saved_ = false; }
  template <class URBG> result_type operator()(URBG &generator) {
    return (*this)(generator, parameters_);
  }
  template <class URBG>
  result_type operator()(URBG &generator, const param_type &parameters) {
    result_type standard;
    if (saved_) {
      standard = saved_value_;
      saved_ = false;
    } else {
      result_type x;
      result_type y;
      result_type radius;
      do {
        x = result_type{2} * detail::random_unit<result_type>(generator) - result_type{1};
        y = result_type{2} * detail::random_unit<result_type>(generator) - result_type{1};
        radius = x * x + y * y;
      } while (radius == result_type{0} || radius >= result_type{1});
      const result_type factor = sqrt(result_type{-2} * log(radius) / radius);
      standard = x * factor;
      saved_value_ = y * factor;
      saved_ = true;
    }
    return parameters.mean() + parameters.stddev() * standard;
  }
  result_type mean() const noexcept { return parameters_.mean(); }
  result_type stddev() const noexcept { return parameters_.stddev(); }
  param_type param() const noexcept { return parameters_; }
  void param(const param_type &parameters) noexcept { parameters_ = parameters; }
  result_type min() const noexcept { return numeric_limits<result_type>::lowest(); }
  result_type max() const noexcept { return numeric_limits<result_type>::max(); }
  friend bool operator==(const normal_distribution &left,
                         const normal_distribution &right) {
    return left.parameters_ == right.parameters_ && left.saved_ == right.saved_ &&
           (!left.saved_ || left.saved_value_ == right.saved_value_);
  }
private:
  friend struct detail::random_stream_access;
  param_type parameters_;
  result_type saved_value_{};
  bool saved_ = false;
};

