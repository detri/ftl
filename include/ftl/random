  static_assert(is_integral_v<IntType> && !is_same_v<remove_cv_t<IntType>, bool>);
public:
  using result_type = IntType;
  class param_type {
  public:
    using distribution_type = poisson_distribution;
    explicit param_type(double mean = 1) : mean_(mean) {}
    double mean() const noexcept { return mean_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    double mean_;
  };
  poisson_distribution() : poisson_distribution(1) {}
  explicit poisson_distribution(double mean) : parameters_(mean) {}
  explicit poisson_distribution(const param_type &parameters) : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) { return (*this)(generator, parameters_); }
  template <class URBG> result_type operator()(URBG &generator, const param_type &p) {
    const double mean = p.mean();
    if (mean < 10.0) {
      const double limit = exp(-mean);
      result_type count = 0;
      double product = 1.0;
      do {
        ++count;
        product *= detail::random_open_unit<double>(generator);
      } while (product > limit);
      return count - 1;
    }
    const double b = 0.931 + 2.53 * sqrt(mean);
    const double a = -0.059 + 0.02483 * b;
    const double inverse_alpha = 1.1239 + 1.1328 / (b - 3.4);
    const double squeeze = 0.9277 - 3.6224 / (b - 2.0);
    for (;;) {
      const double u = detail::random_unit<double>(generator) - 0.5;
      const double v = detail::random_unit<double>(generator);
      const double us = 0.5 - (u < 0 ? -u : u);
      const double candidate = floor((2.0 * a / us + b) * u + mean + 0.43);
      if (us >= 0.07 && v <= squeeze)
        return static_cast<result_type>(candidate);
      if (candidate < 0 || (us < 0.013 && v > us))
        continue;
      if (log(v * inverse_alpha / (a / (us * us) + b)) <=
          -mean + candidate * log(mean) - lgamma(candidate + 1.0))
        return static_cast<result_type>(candidate);
    }
  }
  double mean() const noexcept { return parameters_.mean(); }
  param_type param() const noexcept { return parameters_; }
  void param(const param_type &p) noexcept { parameters_ = p; }
  result_type min() const noexcept { return 0; }
  result_type max() const noexcept { return numeric_limits<result_type>::max(); }
  friend bool operator==(const poisson_distribution &,
                         const poisson_distribution &) = default;
private:
  param_type parameters_;
};

