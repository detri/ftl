template <class RealType, size_t bits, class URBG>
RealType generate_canonical(URBG &generator) {
  const size_t target = bits < static_cast<size_t>(numeric_limits<RealType>::digits)
                            ? bits
                            : static_cast<size_t>(numeric_limits<RealType>::digits);
  const RealType range = static_cast<RealType>(URBG::max()) -
                         static_cast<RealType>(URBG::min()) + RealType{1};
  RealType required = 1;
  for (size_t i = 0; i < target; ++i)
    required *= 2;
  size_t draws = 1;
  RealType scale = range;
  while (scale < required) {
    scale *= range;
    ++draws;
  }
  RealType result = 0;
  RealType factor = 1;
  for (size_t i = 0; i < draws; ++i) {
    result += (static_cast<RealType>(generator()) - static_cast<RealType>(URBG::min())) * factor;
    factor *= range;
  }
  return result / factor;
}

namespace detail {

template <class URBG> struct random_engine_reference {
  using result_type = typename URBG::result_type;
  URBG *engine;
  static constexpr result_type min() noexcept { return URBG::min(); }
  static constexpr result_type max() noexcept { return URBG::max(); }
  result_type operator()() { return (*engine)(); }
};

template <class UInt, class URBG> UInt random_full_width(URBG &generator) {
  using reference = random_engine_reference<URBG>;
  independent_bits_engine<reference, numeric_limits<UInt>::digits, UInt> bits(
      reference{&generator});
  return bits();
}

template <class Int, class URBG>
Int random_uniform_integer(URBG &generator, Int lower, Int upper) {
  using UInt = make_unsigned_t<Int>;
  const UInt lower_bits = static_cast<UInt>(lower);
  const UInt count = static_cast<UInt>(upper) - lower_bits + UInt{1};
  UInt offset;
  if (count == 0) {
    offset = random_full_width<UInt>(generator);
  } else {
    const UInt threshold = static_cast<UInt>(UInt{0} - count) % count;
    do {
      offset = random_full_width<UInt>(generator);
    } while (offset < threshold);
    offset %= count;
  }
  return static_cast<Int>(lower_bits + offset);
}

} // namespace detail

class random_device {
public:
  using result_type = unsigned int;
  random_device() = default;
  explicit random_device(const string &) {}
  random_device(const random_device &) = delete;
  void operator=(const random_device &) = delete;
  static constexpr result_type min() noexcept {
    return numeric_limits<result_type>::min();
  }
  static constexpr result_type max() noexcept {
    return numeric_limits<result_type>::max();
  }
  result_type operator()() {
#if defined(_WIN32)
    result_type value;
    if (!detail::SystemFunction036(&value, sizeof(value)))
      throw runtime_error("random_device entropy source failed");
    return value;
#elif defined(__APPLE__)
    result_type value;
    detail::arc4random_buf(&value, sizeof(value));
    return value;
#elif defined(__linux__) && defined(__x86_64__)
    result_type value;
    auto *current = reinterpret_cast<unsigned char *>(&value);
    size_t remaining = sizeof(value);
    while (remaining != 0) {
      const long count = detail::random_getrandom(current, remaining);
      if (count == -4)
        continue;
      if (count <= 0)
        throw runtime_error("random_device entropy source failed");
      current += count;
      remaining -= static_cast<size_t>(count);
    }
    return value;
#else
    return detail::random_full_width<result_type>(engine_);
#endif
  }
  double entropy() const noexcept {
#if defined(_WIN32) || defined(__APPLE__) ||                              \
    (defined(__linux__) && defined(__x86_64__))
    return numeric_limits<result_type>::digits;
#else
    return 0.0;
#endif
  }
private:
  minstd_rand engine_{};
};

