template <class G>
concept uniform_random_bit_generator =
    invocable<G &> && unsigned_integral<invoke_result_t<G &>> && requires {
      { G::min() } -> same_as<invoke_result_t<G &>>;
      { G::max() } -> same_as<invoke_result_t<G &>>;
      requires bool_constant<(G::min() < G::max())>::value;
    };

namespace detail {

struct random_stream_access;

#if defined(_WIN32)
extern "C" unsigned char __stdcall SystemFunction036(void *, unsigned long);
#elif defined(__APPLE__)
extern "C" void arc4random_buf(void *, size_t);
#elif defined(__linux__) && defined(__x86_64__)
inline long random_getrandom(void *buffer, size_t size) noexcept {
  long result;
  __asm__ volatile("syscall"
                   : "=a"(result)
                   : "a"(318L), "D"(buffer), "S"(size), "d"(0L)
                   : "rcx", "r11", "memory");
  return result;
}
#endif

template <class T, size_t Bits> constexpr T random_mask() noexcept {
  if constexpr (Bits == numeric_limits<T>::digits)
    return numeric_limits<T>::max();
  else
    return static_cast<T>((T{1} << Bits) - 1);
}

template <class T> constexpr T random_add_mod(T x, T y, T modulus) noexcept {
  if (modulus == 0)
    return static_cast<T>(x + y);
  return x >= modulus - y ? static_cast<T>(x - (modulus - y))
                          : static_cast<T>(x + y);
}

template <class T> constexpr T random_multiply_mod(T x, T y,
                                                   T modulus) noexcept {
  if (modulus == 0)
    return static_cast<T>(x * y);
  T result = 0;
  while (y != 0) {
    if ((y & 1) != 0)
      result = random_add_mod(result, x, modulus);
    y >>= 1;
    if (y != 0)
      x = random_add_mod(x, x, modulus);
  }
  return result;
}

template <class T> constexpr size_t random_bit_width(T value) noexcept {
  size_t result = 0;
  while (value != 0) {
    ++result;
    value >>= 1;
  }
  return result;
}

template <class Sseq, class Engine>
concept random_seed_sequence =
    !same_as<remove_cvref_t<Sseq>, Engine> &&
    requires(Sseq &sequence, uint32_t *first, uint32_t *last) {
      sequence.generate(first, last);
    };

template <class T, size_t Count>
constexpr T random_pack_words(const uint32_t *words, T modulus = 0) noexcept {
  T result = 0;
  T factor = 1;
  for (size_t index = 0; index < Count; ++index) {
    if (modulus == 0) {
      if (index * 32 < numeric_limits<T>::digits)
        result |= static_cast<T>(words[index]) << (index * 32);
    } else {
      result = random_add_mod(
          result,
          random_multiply_mod(static_cast<T>(words[index] % modulus), factor,
                              modulus),
          modulus);
      for (int bit = 0; bit < 32; ++bit)
        factor = random_add_mod(factor, factor, modulus);
    }
  }
  return result;
}

} // namespace detail

class seed_seq {
public:
  using result_type = uint32_t;

  seed_seq() noexcept = default;

  template <class T>
    requires is_integral_v<T>
  seed_seq(initializer_list<T> values) : seed_seq(values.begin(), values.end()) {}

  template <class InputIterator>
  seed_seq(InputIterator first, InputIterator last) {
    for (; first != last; ++first)
      seeds_.push_back(static_cast<result_type>(*first));
  }

  seed_seq(const seed_seq &) = delete;
  seed_seq &operator=(const seed_seq &) = delete;

  template <class RandomAccessIterator>
  void generate(RandomAccessIterator first, RandomAccessIterator last) {
    const size_t n = static_cast<size_t>(last - first);
    if (n == 0)
      return;
    const size_t s = seeds_.size();
    const size_t t = n >= 623 ? 11 : n >= 68 ? 7 : n >= 39 ? 5
                                                       : n >= 7  ? 3
                                                                 : (n - 1) / 2;
    const size_t p = (n - t) / 2;
    const size_t q = p + t;
    const size_t m = n > s ? n : s + 1;
    for (size_t i = 0; i < n; ++i)
      first[i] = static_cast<typename iterator_traits<RandomAccessIterator>::value_type>(
          0x8b8b8b8bu);
    size_t k = 0;
    for (; k < m; ++k) {
      const result_type r1 = 1664525u *
          (static_cast<result_type>(first[k % n]) ^
           static_cast<result_type>(first[(k + p) % n]) ^
           static_cast<result_type>(first[(k + n - 1) % n]) ^
           ((static_cast<result_type>(first[k % n]) ^
             static_cast<result_type>(first[(k + p) % n]) ^
             static_cast<result_type>(first[(k + n - 1) % n])) >> 27));
      const result_type offset = k == 0 ? static_cast<result_type>(s)
                                 : k <= s ? static_cast<result_type>(k % n + seeds_[k - 1])
                                          : static_cast<result_type>(k % n);
      const result_type r2 = r1 + offset;
      first[(k + p) % n] = static_cast<result_type>(first[(k + p) % n]) + r1;
      first[(k + q) % n] = static_cast<result_type>(first[(k + q) % n]) + r2;
      first[k % n] = r2;
    }
    for (; k < m + n; ++k) {
      const result_type value = static_cast<result_type>(first[k % n]) +
                                static_cast<result_type>(first[(k + p) % n]) +
                                static_cast<result_type>(first[(k + n - 1) % n]);
      const result_type r3 = 1566083941u * (value ^ (value >> 27));
      const result_type r4 = r3 - static_cast<result_type>(k % n);
      first[(k + p) % n] = static_cast<result_type>(first[(k + p) % n]) ^ r3;
      first[(k + q) % n] = static_cast<result_type>(first[(k + q) % n]) ^ r4;
      first[k % n] = r4;
    }
  }

  template <class OutputIterator> void param(OutputIterator destination) const {
    for (result_type value : seeds_)
      *destination++ = value;
  }

  size_t size() const noexcept { return seeds_.size(); }

private:
  vector<result_type> seeds_;
};

template <class UIntType, UIntType a, UIntType c, UIntType m>
class linear_congruential_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(m == 0 || (a < m && c < m));

  static constexpr UIntType normalize(UIntType value) noexcept {
    if constexpr (m != 0)
      value %= m;
    return c == 0 && value == 0 ? UIntType{1} : value;
  }

public:
  using result_type = UIntType;
  static constexpr result_type multiplier = a;
  static constexpr result_type increment = c;
  static constexpr result_type modulus = m;
  static constexpr result_type default_seed = 1u;
  static constexpr result_type min() noexcept { return c == 0 ? 1u : 0u; }
  static constexpr result_type max() noexcept { return m - 1u; }

  linear_congruential_engine() noexcept : state_(normalize(default_seed)) {}
  explicit linear_congruential_engine(result_type value) noexcept
      : state_(normalize(value)) {}

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, linear_congruential_engine>
  explicit linear_congruential_engine(Sseq &sequence) { seed(sequence); }

  void seed(result_type value = default_seed) noexcept { state_ = normalize(value); }

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, linear_congruential_engine>
  void seed(Sseq &sequence) {
    constexpr size_t k =
        m == 0 ? (numeric_limits<result_type>::digits + 31) / 32
               : (detail::random_bit_width(static_cast<result_type>(m - 1)) + 31) / 32;
    uint32_t words[k + 3]{};
    sequence.generate(words, words + k + 3);
    state_ = normalize(detail::random_pack_words<result_type, k>(words + 3, m));
  }

  result_type operator()() noexcept {
    state_ = detail::random_add_mod(
        detail::random_multiply_mod(state_, a, m), c, m);
    return state_;
  }

  void discard(unsigned long long count) noexcept {
    while (count-- != 0)
      operator()();
  }

  friend bool operator==(const linear_congruential_engine &,
                         const linear_congruential_engine &) = default;

private:
  friend struct detail::random_stream_access;
  result_type state_;
};

template <class UIntType, size_t w, size_t n, size_t m, size_t r, UIntType a,
          size_t u, UIntType d, size_t s, UIntType b, size_t t, UIntType c,
          size_t l, UIntType f>
class mersenne_twister_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < m && m <= n && 2 < w && r <= w && u <= w && s <= w &&
                t <= w && l <= w && w <= numeric_limits<UIntType>::digits);
  static constexpr UIntType mask_ = detail::random_mask<UIntType, w>();
  static constexpr UIntType lower_mask_ =
      r == 0 ? UIntType{0} : detail::random_mask<UIntType, r>();
  static constexpr UIntType upper_mask_ = mask_ & ~lower_mask_;

public:
  using result_type = UIntType;
  static constexpr size_t word_size = w;
  static constexpr size_t state_size = n;
  static constexpr size_t shift_size = m;
  static constexpr size_t mask_bits = r;
  static constexpr result_type xor_mask = a;
  static constexpr size_t tempering_u = u;
  static constexpr result_type tempering_d = d;
  static constexpr size_t tempering_s = s;
  static constexpr result_type tempering_b = b;
  static constexpr size_t tempering_t = t;
  static constexpr result_type tempering_c = c;
  static constexpr size_t tempering_l = l;
  static constexpr result_type initialization_multiplier = f;
  static constexpr result_type default_seed = 5489u;
  static constexpr result_type min() noexcept { return 0; }
  static constexpr result_type max() noexcept { return mask_; }

  mersenne_twister_engine() { seed(); }
  explicit mersenne_twister_engine(result_type value) { seed(value); }

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, mersenne_twister_engine>
  explicit mersenne_twister_engine(Sseq &sequence) { seed(sequence); }

  void seed(result_type value = default_seed) noexcept {
    state_[0] = value & mask_;
    for (size_t i = 1; i < n; ++i)
      state_[i] = static_cast<result_type>(
          f * (state_[i - 1] ^ (state_[i - 1] >> (w - 2))) + i) & mask_;
    index_ = 0;
  }

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, mersenne_twister_engine>
  void seed(Sseq &sequence) {
    constexpr size_t k = (w + 31) / 32;
    uint32_t words[n * k]{};
    sequence.generate(words, words + n * k);
    result_type nonzero = 0;
    for (size_t i = 0; i < n; ++i) {
      state_[i] = detail::random_pack_words<result_type, k>(words + i * k) & mask_;
      nonzero |= i == 0 ? state_[i] & upper_mask_ : state_[i];
    }
    if (nonzero == 0)
      state_[0] = result_type{1} << (w - 1);
    index_ = 0;
  }

  result_type operator()() noexcept {
    const size_t next = (index_ + 1) % n;
    const result_type y = (state_[index_] & upper_mask_) | (state_[next] & lower_mask_);
    state_[index_] = (state_[(index_ + m) % n] ^ (y >> 1) ^
                     ((y & 1) != 0 ? a : 0)) & mask_;
    result_type value = state_[index_];
    index_ = next;
    value ^= (value >> u) & d;
    value ^= (value << s) & b;
    value ^= (value << t) & c;
    value ^= value >> l;
    return value & mask_;
  }

  void discard(unsigned long long count) noexcept {
    while (count-- != 0)
      operator()();
  }

  friend bool operator==(const mersenne_twister_engine &left,
                         const mersenne_twister_engine &right) noexcept {
    for (size_t i = 0; i < n; ++i)
      if (left.state_[(left.index_ + i) % n] !=
          right.state_[(right.index_ + i) % n])
        return false;
    return true;
  }

private:
  friend struct detail::random_stream_access;
  result_type state_[n]{};
  size_t index_ = 0;
};

template <class UIntType, size_t w, size_t s, size_t r>
class subtract_with_carry_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < s && s < r && 0 < w && w <= numeric_limits<UIntType>::digits);
  static constexpr UIntType mask_value() noexcept {
    return detail::random_mask<UIntType, w>();
  }

public:
  using result_type = UIntType;
  static constexpr size_t word_size = w;
  static constexpr size_t short_lag = s;
  static constexpr size_t long_lag = r;
  static constexpr result_type default_seed = 19780503u;
  static constexpr result_type min() noexcept { return 0; }
  static constexpr result_type max() noexcept { return mask_value(); }

  subtract_with_carry_engine() { seed(); }
  explicit subtract_with_carry_engine(result_type value) { seed(value); }

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, subtract_with_carry_engine>
  explicit subtract_with_carry_engine(Sseq &sequence) { seed(sequence); }

  void seed(result_type value = default_seed) {
    linear_congruential_engine<result_type, 40014u, 0u, 2147483563u> engine(
        value == 0 ? default_seed : value);
    constexpr size_t k = (w + 31) / 32;
    for (size_t i = 0; i < r; ++i) {
      uint32_t words[k]{};
      for (size_t j = 0; j < k; ++j)
        words[j] = static_cast<uint32_t>(engine());
      state_[i] = detail::random_pack_words<result_type, k>(words) & mask_value();
    }
    carry_ = state_[r - 1] == 0;
    index_ = 0;
  }

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, subtract_with_carry_engine>
  void seed(Sseq &sequence) {
    constexpr size_t k = (w + 31) / 32;
    uint32_t words[r * k]{};
    sequence.generate(words, words + r * k);
    for (size_t i = 0; i < r; ++i)
      state_[i] = detail::random_pack_words<result_type, k>(words + i * k) & mask_value();
    carry_ = state_[r - 1] == 0;
    index_ = 0;
  }

  result_type operator()() noexcept {
    const size_t short_index = (index_ + r - s) % r;
    const result_type short_value = state_[short_index];
    const result_type long_value = state_[index_];
    const bool borrow = short_value < long_value ||
                        (carry_ != 0 && short_value == long_value);
    const result_type value = static_cast<result_type>(short_value - long_value - carry_) &
                              mask_value();
    state_[index_] = value;
    carry_ = borrow;
    index_ = (index_ + 1) % r;
    return value;
  }

  void discard(unsigned long long count) noexcept {
    while (count-- != 0)
      operator()();
  }

  friend bool operator==(const subtract_with_carry_engine &left,
                         const subtract_with_carry_engine &right) noexcept {
    if (left.carry_ != right.carry_)
      return false;
    for (size_t i = 0; i < r; ++i)
      if (left.state_[(left.index_ + i) % r] !=
          right.state_[(right.index_ + i) % r])
        return false;
    return true;
  }

private:
  friend struct detail::random_stream_access;
  result_type state_[r]{};
  size_t index_ = 0;
  unsigned int carry_ = 0;
};

template <class Engine, size_t p, size_t r> class discard_block_engine {
  static_assert(0 < r && r <= p);

public:
  using result_type = typename Engine::result_type;
  static constexpr size_t block_size = p;
  static constexpr size_t used_block = r;
  static constexpr result_type min() noexcept { return Engine::min(); }
  static constexpr result_type max() noexcept { return Engine::max(); }

  discard_block_engine() = default;
  explicit discard_block_engine(const Engine &engine) : engine_(engine) {}
  explicit discard_block_engine(Engine &&engine)
      : engine_(static_cast<Engine &&>(engine)) {}
  explicit discard_block_engine(result_type value) : engine_(value) {}

  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, discard_block_engine>
  explicit discard_block_engine(Sseq &sequence) : engine_(sequence) {}

  void seed() {
    engine_.seed();
    used_ = 0;
  }
  void seed(result_type value) {
    engine_.seed(value);
    used_ = 0;
  }
  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, discard_block_engine>
  void seed(Sseq &sequence) {
    engine_.seed(sequence);
    used_ = 0;
  }

  result_type operator()() {
    if (used_ == r) {
      engine_.discard(p - r);
      used_ = 0;
    }
    ++used_;
    return engine_();
  }
  void discard(unsigned long long count) {
    while (count-- != 0)
      operator()();
  }
  const Engine &base() const noexcept { return engine_; }

  friend bool operator==(const discard_block_engine &left,
                         const discard_block_engine &right) {
    return left.engine_ == right.engine_ && left.used_ == right.used_;
  }

private:
  friend struct detail::random_stream_access;
  Engine engine_{};
  size_t used_ = 0;
};

template <class Engine, size_t w, class UIntType>
class independent_bits_engine {
  static_assert(is_unsigned_v<UIntType>);
  static_assert(0 < w && w <= numeric_limits<UIntType>::digits);

  using engine_result = typename Engine::result_type;
  using engine_unsigned = make_unsigned_t<engine_result>;

  static constexpr size_t source_bits() noexcept {
    constexpr engine_unsigned span =
        static_cast<engine_unsigned>(Engine::max()) -
        static_cast<engine_unsigned>(Engine::min());
    if constexpr (span == numeric_limits<engine_unsigned>::max())
      return numeric_limits<engine_unsigned>::digits;
    else
      return detail::random_bit_width(static_cast<engine_unsigned>(span + 1)) - 1;
  }

  UIntType draw(size_t width) {
    constexpr engine_unsigned span =
        static_cast<engine_unsigned>(Engine::max()) -
        static_cast<engine_unsigned>(Engine::min());
    constexpr bool full_range = span == numeric_limits<engine_unsigned>::max();
    engine_unsigned limit = 0;
    if constexpr (!full_range) {
      const engine_unsigned range = span + 1;
      const engine_unsigned unit = engine_unsigned{1} << width;
      limit = static_cast<engine_unsigned>((range / unit) * unit);
    }
    engine_unsigned value;
    do {
      value = static_cast<engine_unsigned>(engine_()) -
              static_cast<engine_unsigned>(Engine::min());
    } while (!full_range && value >= limit);
    if (width == numeric_limits<UIntType>::digits)
      return static_cast<UIntType>(value);
    return static_cast<UIntType>(value & ((UIntType{1} << width) - 1));
  }

public:
  using result_type = UIntType;
  static constexpr result_type min() noexcept { return 0; }
  static constexpr result_type max() noexcept {
    return detail::random_mask<result_type, w>();
  }

  independent_bits_engine() = default;
  explicit independent_bits_engine(const Engine &engine) : engine_(engine) {}
  explicit independent_bits_engine(Engine &&engine)
      : engine_(static_cast<Engine &&>(engine)) {}
  explicit independent_bits_engine(result_type value) : engine_(value) {}
  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, independent_bits_engine>
  explicit independent_bits_engine(Sseq &sequence) : engine_(sequence) {}

  void seed() { engine_.seed(); }
  void seed(result_type value) { engine_.seed(value); }
  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, independent_bits_engine>
  void seed(Sseq &sequence) { engine_.seed(sequence); }

  result_type operator()() {
    constexpr size_t m = source_bits();
    size_t count = (w + m - 1) / m;
    size_t small_width = w / count;
    size_t small_count = count - w % count;

    constexpr engine_unsigned span =
        static_cast<engine_unsigned>(Engine::max()) -
        static_cast<engine_unsigned>(Engine::min());
    if constexpr (span != numeric_limits<engine_unsigned>::max()) {
      const engine_unsigned range = span + 1;
      const engine_unsigned unit = engine_unsigned{1} << small_width;
      const engine_unsigned y = static_cast<engine_unsigned>((range / unit) * unit);
      if (range - y > y / count) {
        ++count;
        small_width = w / count;
        small_count = count - w % count;
      }
    }

    result_type result = 0;
    for (size_t i = 0; i < count; ++i) {
      const size_t width = i < small_count ? small_width : small_width + 1;
      if (width == numeric_limits<result_type>::digits)
        result = draw(width);
      else
        result = static_cast<result_type>((result << width) | draw(width));
    }
    return result;
  }

  void discard(unsigned long long count) {
    while (count-- != 0)
      operator()();
  }
  const Engine &base() const noexcept { return engine_; }
  friend bool operator==(const independent_bits_engine &,
                         const independent_bits_engine &) = default;

private:
  friend struct detail::random_stream_access;
  Engine engine_{};
};

template <class Engine, size_t k> class shuffle_order_engine {
  static_assert(0 < k);

public:
  using result_type = typename Engine::result_type;
  static constexpr size_t table_size = k;
  static constexpr result_type min() noexcept { return Engine::min(); }
  static constexpr result_type max() noexcept { return Engine::max(); }

  shuffle_order_engine() { initialize(); }
  explicit shuffle_order_engine(const Engine &engine) : engine_(engine) { initialize(); }
  explicit shuffle_order_engine(Engine &&engine)
      : engine_(static_cast<Engine &&>(engine)) { initialize(); }
  explicit shuffle_order_engine(result_type value) : engine_(value) { initialize(); }
  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, shuffle_order_engine>
  explicit shuffle_order_engine(Sseq &sequence) : engine_(sequence) { initialize(); }

  void seed() {
    engine_.seed();
    initialize();
  }
  void seed(result_type value) {
    engine_.seed(value);
    initialize();
  }
  template <class Sseq>
    requires detail::random_seed_sequence<Sseq, shuffle_order_engine>
  void seed(Sseq &sequence) {
    engine_.seed(sequence);
    initialize();
  }

  result_type operator()() {
    const long double numerator = static_cast<long double>(k) *
        (static_cast<long double>(value_) - static_cast<long double>(Engine::min()));
    const long double denominator = static_cast<long double>(Engine::max()) -
                                    static_cast<long double>(Engine::min()) + 1.0L;
    const size_t index = static_cast<size_t>(numerator / denominator);
    value_ = table_[index];
    table_[index] = engine_();
    return value_;
  }
  void discard(unsigned long long count) {
    while (count-- != 0)
      operator()();
  }
  const Engine &base() const noexcept { return engine_; }
  friend bool operator==(const shuffle_order_engine &left,
                         const shuffle_order_engine &right) {
    if (!(left.engine_ == right.engine_) || left.value_ != right.value_)
      return false;
    for (size_t i = 0; i < k; ++i)
      if (left.table_[i] != right.table_[i])
        return false;
    return true;
  }

private:
  friend struct detail::random_stream_access;
  void initialize() {
    for (size_t i = 0; i < k; ++i)
      table_[i] = engine_();
    value_ = engine_();
  }

  Engine engine_{};
  result_type table_[k]{};
  result_type value_{};
};

