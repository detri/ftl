  static_assert(is_floating_point_v<RealType>);
public:
  using result_type = RealType;
  class param_type {
  public:
    using distribution_type = gamma_distribution;
    explicit param_type(result_type alpha = 1, result_type beta = 1)
        : alpha_(alpha), beta_(beta) {}
    result_type alpha() const noexcept { return alpha_; }
    result_type beta() const noexcept { return beta_; }
    friend bool operator==(const param_type &, const param_type &) = default;
  private:
    result_type alpha_;
    result_type beta_;
  };
  gamma_distribution() : gamma_distribution(1) {}
  explicit gamma_distribution(result_type alpha, result_type beta = 1)
      : parameters_(alpha, beta) {}
  explicit gamma_distribution(const param_type &parameters) : parameters_(parameters) {}
  void reset() noexcept {}
  template <class URBG> result_type operator()(URBG &generator) {
    return (*this)(generator, parameters_);
  }
  template <class URBG>
  result_type operator()(URBG &generator, const param_type &parameters) {
    return sample(generator, parameters.alpha()) * parameters.beta();
  }
  result_type alpha() const noexcept { return parameters_.alpha(); }
  result_type beta() const noexcept { return parameters_.beta(); }
  param_type param() const noexcept { return parameters_; }
  void param(const param_type &parameters) noexcept { parameters_ = parameters; }
  result_type min() const noexcept { return 0; }
  result_type max() const noexcept { return numeric_limits<result_type>::max(); }
  friend bool operator==(const gamma_distribution &,
                         const gamma_distribution &) = default;
private:
  template <class URBG> static result_type sample(URBG &generator, result_type alpha) {
    if (alpha < result_type{1})
      return sample(generator, alpha + result_type{1}) *
             pow(detail::random_open_unit<result_type>(generator), result_type{1} / alpha);
    const result_type d = alpha - result_type{1} / result_type{3};
    const result_type c = result_type{1} / sqrt(result_type{9} * d);
    normal_distribution<result_type> normal;
    for (;;) {
      const result_type x = normal(generator);
      result_type v = result_type{1} + c * x;
      if (v <= result_type{0})
        continue;
      v = v * v * v;
      const result_type u = detail::random_unit<result_type>(generator);
      if (u < result_type{1} - result_type{0.0331} * x * x * x * x ||
          log(u) < result_type{0.5} * x * x + d * (result_type{1} - v + log(v)))
        return d * v;
    }
  }
  param_type parameters_;
};

