struct imaxdiv_t { intmax_t quot, rem; };
constexpr intmax_t imaxabs(intmax_t value) { return value < 0 ? -value : value; }
constexpr imaxdiv_t imaxdiv(intmax_t numer, intmax_t denom) {
    return {numer / denom, numer % denom};
}
