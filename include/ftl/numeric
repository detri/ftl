// [adjacent.difference]

template <class InputIterator, class OutputIterator, class BinaryOperation>
constexpr OutputIterator
adjacent_difference(InputIterator first, InputIterator last,
                    OutputIterator result, BinaryOperation binary_op) {

  using value_type = typename iterator_traits<InputIterator>::value_type;

  static_assert(
      is_constructible_v<value_type, decltype(*declval<InputIterator &>())>,
      "adjacent_difference accumulator is not constructible from input");

  static_assert(
      requires(OutputIterator &output, BinaryOperation &operation,
               value_type &accumulator, value_type &value) {
        *output = accumulator;
        *output = operation(value, move(accumulator));
      },
      "adjacent_difference does not satisfy N4950 mandates");

  if (first == last)
    return result;

  value_type accumulator = *first;
  *result = accumulator;

  ++first;
  ++result;

  for (; first != last; ++first, ++result) {
    value_type value = *first;

    *result = binary_op(value, move(accumulator));

    accumulator = move(value);
  }

  return result;
}

template <class InputIterator, class OutputIterator>
constexpr OutputIterator adjacent_difference(InputIterator first,
                                             InputIterator last,
                                             OutputIterator result) {

  return adjacent_difference(first, last, result, minus<>{});
}

template <class ExecutionPolicy, class ForwardIterator1, class ForwardIterator2,
          class BinaryOperation>
  requires(is_execution_policy_v<remove_cvref_t<ExecutionPolicy>>)
ForwardIterator2
adjacent_difference(ExecutionPolicy &&exec, ForwardIterator1 first,
                    ForwardIterator1 last, ForwardIterator2 result,
                    BinaryOperation binary_op) {

  static_cast<void>(exec);

  static_assert(
      requires(ForwardIterator1 &input, ForwardIterator2 &output,
               BinaryOperation &operation) {
        *output = *input;
        *output = operation(*input, *input);
      },
      "policy adjacent_difference does not satisfy N4950 mandates");

  if (first == last)
    return result;

  ForwardIterator1 previous = first;

  *result = *first;

  ++first;
  ++result;

  for (; first != last; ++first, ++previous, ++result)
    *result = binary_op(*first, *previous);

  return result;
}

template <class ExecutionPolicy, class ForwardIterator1, class ForwardIterator2>
  requires(is_execution_policy_v<remove_cvref_t<ExecutionPolicy>>)
ForwardIterator2
adjacent_difference(ExecutionPolicy &&exec, ForwardIterator1 first,
                    ForwardIterator1 last, ForwardIterator2 result) {

  return adjacent_difference(forward<ExecutionPolicy>(exec), first, last,
                             result, minus<>{});
}

// [numeric.iota]

template <class ForwardIterator, class T>
constexpr void iota(ForwardIterator first, ForwardIterator last, T value) {

  using value_type = typename iterator_traits<ForwardIterator>::value_type;

  static_assert(is_convertible_v<T, value_type>,
                "iota value is not convertible to the iterator value type");

  static_assert(
      requires(T &current) { ++current; }, "iota value is not incrementable");

  for (; first != last; ++first, ++value)
    *first = value;
}

namespace ranges {

template <class O, class T> using iota_result = out_value_result<O, T>;

namespace detail {

struct iota_fn {
  template <input_or_output_iterator O, sentinel_for<O> S,
            weakly_incrementable T>
    requires indirectly_writable<O, const T &>
  constexpr iota_result<O, T> operator()(O first, S last, T value) const {
    while (first != last) {
      *first = as_const(value);
      ++first;
      ++value;
    }

    return {static_cast<O &&>(first), static_cast<T &&>(value)};
  }

  template <weakly_incrementable T, output_range<const T &> R>
  constexpr iota_result<borrowed_iterator_t<R>, T> operator()(R &&range,
                                                              T value) const {
    auto result = (*this)(ranges::begin(range), ranges::end(range),
                          static_cast<T &&>(value));

    return {static_cast<decltype(result.out) &&>(result.out),
            static_cast<T &&>(result.value)};
  }
};

} // namespace detail

inline constexpr detail::iota_fn iota{};

} // namespace ranges

// [numeric.ops.gcd]

template <class M, class N> constexpr common_type_t<M, N> gcd(M m, N n) {
  static_assert(is_integral_v<M> && is_integral_v<N>,
                "gcd arguments must be integer types");

  static_assert(!is_same_v<remove_cv_t<M>, bool> &&
                    !is_same_v<remove_cv_t<N>, bool>,
                "gcd arguments must not be bool");

  using common_type = common_type_t<M, N>;
  using unsigned_type = make_unsigned_t<common_type>;

  const unsigned_type left = detail::numeric_magnitude<unsigned_type>(m);

  const unsigned_type right = detail::numeric_magnitude<unsigned_type>(n);

  return static_cast<common_type>(detail::numeric_gcd(left, right));
}

// [numeric.ops.lcm]

template <class M, class N> constexpr common_type_t<M, N> lcm(M m, N n) {
  static_assert(is_integral_v<M> && is_integral_v<N>,
                "lcm arguments must be integer types");

  static_assert(!is_same_v<remove_cv_t<M>, bool> &&
                    !is_same_v<remove_cv_t<N>, bool>,
                "lcm arguments must not be bool");

  using common_type = common_type_t<M, N>;
  using unsigned_type = make_unsigned_t<common_type>;

  const unsigned_type left = detail::numeric_magnitude<unsigned_type>(m);

  const unsigned_type right = detail::numeric_magnitude<unsigned_type>(n);

  if (left == 0 || right == 0)
    return common_type{0};

  const unsigned_type divisor = detail::numeric_gcd(left, right);

  return static_cast<common_type>((left / divisor) * right);
}

// [numeric.ops.midpoint]

template <class T>
  requires(is_arithmetic_v<T> && !is_same_v<T, bool>)
constexpr T midpoint(T a, T b) noexcept {
  using value_type = remove_cv_t<T>;

  if constexpr (is_same_v<value_type, bool>) {
    return a;
  } else if constexpr (is_integral_v<T>) {
    using unsigned_type = make_unsigned_t<value_type>;

    const value_type left = a;
    const value_type right = b;

    if (left < right) {
      const unsigned_type distance =
          static_cast<unsigned_type>(right) - static_cast<unsigned_type>(left);

      return static_cast<T>(left + static_cast<value_type>(distance / 2));
    }

    const unsigned_type distance =
        static_cast<unsigned_type>(left) - static_cast<unsigned_type>(right);

    return static_cast<T>(left - static_cast<value_type>(distance / 2));
  } else {
    constexpr value_type low =
        numeric_limits<value_type>::min() * value_type{2};

    constexpr value_type high =
        numeric_limits<value_type>::max() / value_type{2};

    const value_type left = a;
    const value_type right = b;

    const value_type abs_left = left < value_type{0} ? -left : left;

    const value_type abs_right = right < value_type{0} ? -right : right;

    if (abs_left <= high && abs_right <= high)
      return static_cast<T>((left + right) / value_type{2});

    if (abs_left < low)
      return static_cast<T>(left + right / value_type{2});

    if (abs_right < low)
      return static_cast<T>(left / value_type{2} + right);

    return static_cast<T>(left / value_type{2} + right / value_type{2});
  }
}

template <class T>
  requires is_object_v<T>
constexpr T *midpoint(T *a, T *b) {
  static_assert(sizeof(T) != 0,
                "midpoint pointer element type must be complete");

  return a + (b - a) / 2;
}

