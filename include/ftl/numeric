// [partial.sum]

template <class InputIterator, class OutputIterator, class BinaryOperation>
constexpr OutputIterator partial_sum(InputIterator first, InputIterator last,
                                     OutputIterator result,
                                     BinaryOperation binary_op) {

  using value_type = typename iterator_traits<InputIterator>::value_type;

  static_assert(
      is_constructible_v<value_type, decltype(*declval<InputIterator &>())>,
      "partial_sum accumulator is not constructible from the input");

  static_assert(
      requires(BinaryOperation &operation) {
        requires is_convertible_v<decltype(operation(
                                      declval<value_type &&>(),
                                      *declval<InputIterator &>())),
                                  value_type>;
      }, "partial_sum binary operation does not satisfy N4950 mandates");

  static_assert(
      requires(OutputIterator &output, value_type &value) { *output = value; },
      "partial_sum accumulator is not writable to the output");

  if (first == last)
    return result;

  value_type accumulator = *first;
  *result = accumulator;

  ++first;
  ++result;

  for (; first != last; ++first, ++result) {
    accumulator = binary_op(move(accumulator), *first);

    *result = accumulator;
  }

  return result;
}

template <class InputIterator, class OutputIterator>
constexpr OutputIterator partial_sum(InputIterator first, InputIterator last,
                                     OutputIterator result) {

  return partial_sum(first, last, result, plus<>{});
}

