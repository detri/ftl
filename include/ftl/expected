FTL_BEGIN_NAMESPACE

template<class E> class unexpected;
template<class T, class E> class expected;

template<class> inline constexpr bool is_unexpected_v = false;
template<class E> inline constexpr bool is_unexpected_v<unexpected<E>> = true;

struct unexpect_t { explicit unexpect_t() = default; };
inline constexpr unexpect_t unexpect{};

namespace detail {
template<class T>
constexpr void expected_swap(T& left, T& right)
    noexcept(noexcept(swap(left, right))) {
    swap(left, right);
}
}

template<class E>
class unexpected {
    static_assert(is_object_v<E> && !is_array_v<E> &&
                  !is_const_v<E> && !is_volatile_v<E>);
public:
    constexpr unexpected(const unexpected&) = default;
    constexpr unexpected(unexpected&&) = default;

    template<class Err = E>
    constexpr explicit unexpected(Err&& value)
        requires (!is_same_v<remove_cvref_t<Err>, unexpected> &&
                  !is_same_v<remove_cvref_t<Err>, in_place_t> &&
                  is_constructible_v<E, Err>)
        : stored(forward<Err>(value)) {}

    template<class... Args>
    constexpr explicit unexpected(in_place_t, Args&&... args)
        requires is_constructible_v<E, Args...>
        : stored(forward<Args>(args)...) {}

    template<class U, class... Args>
    constexpr explicit unexpected(in_place_t, initializer_list<U> values,
                                  Args&&... args)
        requires is_constructible_v<E, initializer_list<U>&, Args...>
        : stored(values, forward<Args>(args)...) {}

    constexpr const E& error() const& noexcept { return stored; }
    constexpr E& error() & noexcept { return stored; }
    constexpr const E&& error() const&& noexcept { return move(stored); }
    constexpr E&& error() && noexcept { return move(stored); }

    constexpr void swap(unexpected& other)
        noexcept(is_nothrow_swappable_v<E>)
        requires is_swappable_v<E> { detail::expected_swap(stored, other.stored); }

    template<class E2>
    friend constexpr bool operator==(const unexpected& left,
                                     const unexpected<E2>& right) {
        return left.error() == right.error();
    }
private:
    E stored;
};

template<class E> unexpected(E) -> unexpected<E>;
template<class E>
constexpr void swap(unexpected<E>& left, unexpected<E>& right)
    noexcept(noexcept(left.swap(right)))
    requires requires { left.swap(right); } { left.swap(right); }

template<class E> class bad_expected_access;

template<>
class bad_expected_access<void> : public exception {
protected:
    bad_expected_access() noexcept = default;
public:
    [[nodiscard]] const char* what() const noexcept override {
        return "bad expected access";
    }
};

template<class E>
class bad_expected_access : public bad_expected_access<void> {
public:
    explicit bad_expected_access(E error) : stored(move(error)) {}
    E& error() & noexcept { return stored; }
    const E& error() const& noexcept { return stored; }
    E&& error() && noexcept { return move(stored); }
    const E&& error() const&& noexcept { return move(stored); }
private:
    E stored;
};

namespace detail {
template<class E>
[[noreturn]] void throw_bad_expected_access(E&& error) {
#if FTL_HAS_EXCEPTIONS
    throw bad_expected_access<remove_cvref_t<E>>(forward<E>(error));
#else
    (void)error;
    terminate();
#endif
}

template<class> inline constexpr bool is_expected_v = false;
template<class T, class E>
inline constexpr bool is_expected_v<expected<T, E>> = true;

template<class T, class W>
inline constexpr bool expected_converts_from_any_cvref_v =
    is_constructible_v<T, W&> || is_convertible_v<W&, T> ||
    is_constructible_v<T, W> || is_convertible_v<W, T> ||
    is_constructible_v<T, const W&> || is_convertible_v<const W&, T> ||
    is_constructible_v<T, const W> || is_convertible_v<const W, T>;

template<class E, class W>
inline constexpr bool unexpected_converts_from_any_cvref_v =
    is_constructible_v<unexpected<E>, W&> ||
    is_constructible_v<unexpected<E>, W> ||
    is_constructible_v<unexpected<E>, const W&> ||
    is_constructible_v<unexpected<E>, const W>;

template<class T>
constexpr T* expected_address(T& value) noexcept {
#if defined(_MSC_VER) || __has_builtin(__builtin_addressof)
    return __builtin_addressof(value);
#else
    return &value;
#endif
}
}

template<class T, class E>
class expected {
    static_assert(!is_reference_v<T> && !is_void_v<T> && is_object_v<T>);
    static_assert(!is_reference_v<E> && !is_void_v<E> && is_object_v<E>);
    static_assert(!is_same_v<remove_cv_t<T>, in_place_t>);
    static_assert(!is_same_v<remove_cv_t<T>, unexpect_t>);
    static_assert(!is_unexpected_v<remove_cv_t<T>>);
public:
    using value_type = T;
    using error_type = E;
    using unexpected_type = unexpected<E>;
    template<class U> using rebind = expected<U, error_type>;

    constexpr expected() requires is_default_constructible_v<T>
        : value_data(), has{true} {}

    constexpr expected(const expected&)
        requires (is_trivially_copy_constructible_v<T> &&
                  is_trivially_copy_constructible_v<E>) = default;
    constexpr expected(const expected& other)
        requires (is_copy_constructible_v<T> && is_copy_constructible_v<E> &&
                  !(is_trivially_copy_constructible_v<T> &&
                    is_trivially_copy_constructible_v<E>))
        : has(other.has) {
        if (has) construct_at(detail::expected_address(value_data), other.value_data);
        else construct_at(detail::expected_address(error_data), other.error_data);
    }
    constexpr expected(expected&&)
        requires (is_trivially_move_constructible_v<T> &&
                  is_trivially_move_constructible_v<E>) = default;
    constexpr expected(expected&& other)
        noexcept(is_nothrow_move_constructible_v<T> &&
                 is_nothrow_move_constructible_v<E>)
        requires (is_move_constructible_v<T> && is_move_constructible_v<E> &&
                  !(is_trivially_move_constructible_v<T> &&
                    is_trivially_move_constructible_v<E>))
        : has(other.has) {
        if (has) construct_at(detail::expected_address(value_data), move(other.value_data));
        else construct_at(detail::expected_address(error_data), move(other.error_data));
    }

    template<class U, class G>
    constexpr explicit(!is_convertible_v<const U&, T> ||
                       !is_convertible_v<const G&, E>)
    expected(const expected<U, G>& other)
        requires (is_constructible_v<T, const U&> &&
                  is_constructible_v<E, const G&> &&
                  (is_same_v<remove_cv_t<T>, bool> ||
                   !detail::expected_converts_from_any_cvref_v<
                       T, expected<U, G>>) &&
                  !detail::unexpected_converts_from_any_cvref_v<
                      E, expected<U, G>>)
        : has(other.has_value()) {
        if (has) construct_at(detail::expected_address(value_data), *other);
        else construct_at(detail::expected_address(error_data), other.error());
    }

    template<class U, class G>
    constexpr explicit(!is_convertible_v<U, T> || !is_convertible_v<G, E>)
    expected(expected<U, G>&& other)
        requires (is_constructible_v<T, U> && is_constructible_v<E, G> &&
                  (is_same_v<remove_cv_t<T>, bool> ||
                   !detail::expected_converts_from_any_cvref_v<
                       T, expected<U, G>>) &&
                  !detail::unexpected_converts_from_any_cvref_v<
                      E, expected<U, G>>)
        : has(other.has_value()) {
        if (has) construct_at(detail::expected_address(value_data), move(*other));
        else construct_at(detail::expected_address(error_data), move(other.error()));
    }

    template<class U = T>
    constexpr explicit(!is_convertible_v<U, T>) expected(U&& value)
        requires (!is_same_v<remove_cvref_t<U>, expected> &&
                  !is_unexpected_v<remove_cvref_t<U>> &&
                  (!is_same_v<remove_cv_t<T>, bool> ||
                   !detail::is_expected_v<remove_cvref_t<U>>) &&
                  is_constructible_v<T, U>)
        : value_data(forward<U>(value)), has{true} {}

    template<class G>
    constexpr explicit(!is_convertible_v<const G&, E>)
    expected(const unexpected<G>& error)
        requires is_constructible_v<E, const G&>
        : error_data(error.error()), has{false} {}
    template<class G>
    constexpr explicit(!is_convertible_v<G, E>) expected(unexpected<G>&& error)
        requires is_constructible_v<E, G>
        : error_data(move(error.error())), has{false} {}

    template<class... Args>
    constexpr explicit expected(in_place_t, Args&&... args)
        requires is_constructible_v<T, Args...>
        : value_data(forward<Args>(args)...), has{true} {}
    template<class U, class... Args>
    constexpr explicit expected(in_place_t, initializer_list<U> values,
                                Args&&... args)
        requires is_constructible_v<T, initializer_list<U>&, Args...>
        : value_data(values, forward<Args>(args)...), has{true} {}
    template<class... Args>
    constexpr explicit expected(unexpect_t, Args&&... args)
        requires is_constructible_v<E, Args...>
        : error_data(forward<Args>(args)...), has{false} {}
    template<class U, class... Args>
    constexpr explicit expected(unexpect_t, initializer_list<U> values,
                                Args&&... args)
        requires is_constructible_v<E, initializer_list<U>&, Args...>
        : error_data(values, forward<Args>(args)...), has{false} {}

    constexpr ~expected()
        requires (is_trivially_destructible_v<T> &&
                  is_trivially_destructible_v<E>) = default;
    constexpr ~expected()
        requires (!(is_trivially_destructible_v<T> &&
                    is_trivially_destructible_v<E>)) { destroy(); }

    constexpr expected& operator=(const expected&)
        requires (is_trivially_copy_constructible_v<T> &&
                  is_trivially_copy_assignable_v<T> &&
                  is_trivially_copy_constructible_v<E> &&
                  is_trivially_copy_assignable_v<E> &&
                  is_trivially_destructible_v<T> &&
                  is_trivially_destructible_v<E>) = default;
    constexpr expected& operator=(const expected& other)
        requires (is_copy_constructible_v<T> && is_copy_assignable_v<T> &&
                  is_copy_constructible_v<E> && is_copy_assignable_v<E> &&
                  (is_nothrow_move_constructible_v<T> ||
                   is_nothrow_move_constructible_v<E>) &&
                  !(is_trivially_copy_constructible_v<T> &&
                    is_trivially_copy_assignable_v<T> &&
                    is_trivially_copy_constructible_v<E> &&
                    is_trivially_copy_assignable_v<E> &&
                    is_trivially_destructible_v<T> &&
                    is_trivially_destructible_v<E>)) {
        assign(other); return *this;
    }
    constexpr expected& operator=(expected&&)
        requires (is_trivially_move_constructible_v<T> &&
                  is_trivially_move_assignable_v<T> &&
                  is_trivially_move_constructible_v<E> &&
                  is_trivially_move_assignable_v<E> &&
                  is_trivially_destructible_v<T> &&
                  is_trivially_destructible_v<E>) = default;
    constexpr expected& operator=(expected&& other)
        noexcept(is_nothrow_move_constructible_v<T> &&
                 is_nothrow_move_assignable_v<T> &&
                 is_nothrow_move_constructible_v<E> &&
                 is_nothrow_move_assignable_v<E>)
        requires (is_move_constructible_v<T> && is_move_assignable_v<T> &&
                  is_move_constructible_v<E> && is_move_assignable_v<E> &&
                  (is_nothrow_move_constructible_v<T> ||
                   is_nothrow_move_constructible_v<E>) &&
                  !(is_trivially_move_constructible_v<T> &&
                    is_trivially_move_assignable_v<T> &&
                    is_trivially_move_constructible_v<E> &&
                    is_trivially_move_assignable_v<E> &&
                    is_trivially_destructible_v<T> &&
                    is_trivially_destructible_v<E>)) {
        assign(move(other)); return *this;
    }
    template<class U = T>
    constexpr expected& operator=(U&& value)
        requires (!is_same_v<remove_cvref_t<U>, expected> &&
                  !is_unexpected_v<remove_cvref_t<U>> &&
                  is_constructible_v<T, U> && is_assignable_v<T&, U> &&
                  (is_nothrow_constructible_v<T, U> ||
                   is_nothrow_move_constructible_v<T> ||
                   is_nothrow_move_constructible_v<E>)) {
        if (has) value_data = forward<U>(value);
        else replace_value(forward<U>(value));
        return *this;
    }
    template<class G>
    constexpr expected& operator=(const unexpected<G>& error)
        requires (is_constructible_v<E, const G&> &&
                  is_assignable_v<E&, const G&> &&
                  (is_nothrow_constructible_v<E, const G&> ||
                   is_nothrow_move_constructible_v<T> ||
                   is_nothrow_move_constructible_v<E>)) {
        if (!has) error_data = error.error();
        else replace_error(error.error());
        return *this;
    }
    template<class G>
    constexpr expected& operator=(unexpected<G>&& error)
        requires (is_constructible_v<E, G> && is_assignable_v<E&, G> &&
                  (is_nothrow_constructible_v<E, G> ||
                   is_nothrow_move_constructible_v<T> ||
                   is_nothrow_move_constructible_v<E>)) {
        if (!has) error_data = move(error.error());
        else replace_error(move(error.error()));
        return *this;
    }

    constexpr const T* operator->() const noexcept { return detail::expected_address(value_data); }
    constexpr T* operator->() noexcept { return detail::expected_address(value_data); }
    constexpr const T& operator*() const& noexcept { return value_data; }
    constexpr T& operator*() & noexcept { return value_data; }
    constexpr const T&& operator*() const&& noexcept { return move(value_data); }
    constexpr T&& operator*() && noexcept { return move(value_data); }
    constexpr explicit operator bool() const noexcept { return has; }
    constexpr bool has_value() const noexcept { return has; }

    constexpr const T& value() const& { if (!has) detail::throw_bad_expected_access(error_data); return value_data; }
    constexpr T& value() & { if (!has) detail::throw_bad_expected_access(error_data); return value_data; }
    constexpr const T&& value() const&& { if (!has) detail::throw_bad_expected_access(move(error_data)); return move(value_data); }
    constexpr T&& value() && { if (!has) detail::throw_bad_expected_access(move(error_data)); return move(value_data); }
    constexpr const E& error() const& noexcept { return error_data; }
    constexpr E& error() & noexcept { return error_data; }
    constexpr const E&& error() const&& noexcept { return move(error_data); }
    constexpr E&& error() && noexcept { return move(error_data); }

    template<class U> constexpr T value_or(U&& other) const& {
        return has ? value_data : static_cast<T>(forward<U>(other));
    }
    template<class U> constexpr T value_or(U&& other) && {
        return has ? move(value_data) : static_cast<T>(forward<U>(other));
    }
    template<class G> constexpr E error_or(G&& other) const& {
        return has ? static_cast<E>(forward<G>(other)) : error_data;
    }
    template<class G> constexpr E error_or(G&& other) && {
        return has ? static_cast<E>(forward<G>(other)) : move(error_data);
    }

    template<class... Args> constexpr T& emplace(Args&&... args)
        requires is_nothrow_constructible_v<T, Args...> {
        if (has) destroy_at(detail::expected_address(value_data));
        else destroy_at(detail::expected_address(error_data));
        construct_at(detail::expected_address(value_data), forward<Args>(args)...);
        has = true; return value_data;
    }
    template<class U, class... Args>
    constexpr T& emplace(initializer_list<U> values, Args&&... args)
        noexcept
        requires is_nothrow_constructible_v<T, initializer_list<U>&, Args...> {
        if (has) destroy_at(detail::expected_address(value_data));
        else destroy_at(detail::expected_address(error_data));
        construct_at(detail::expected_address(value_data), values,
                     forward<Args>(args)...);
        has = true; return value_data;
    }

    constexpr void swap(expected& other)
        noexcept(is_nothrow_move_constructible_v<T> && is_nothrow_swappable_v<T> &&
                 is_nothrow_move_constructible_v<E> && is_nothrow_swappable_v<E>)
        requires (is_swappable_v<T> && is_swappable_v<E> &&
                  is_move_constructible_v<T> && is_move_constructible_v<E>) {
        if (has && other.has) detail::expected_swap(value_data, other.value_data);
        else if (!has && !other.has) detail::expected_swap(error_data, other.error_data);
        else if (has) { expected temporary(move(other)); other.replace_value(move(value_data)); replace_error(move(temporary.error_data)); }
        else other.swap(*this);
    }

#define FTL_EXPECTED_MONADIC(QUAL, ARG, ERROR) \
    template<class F> constexpr auto and_then(F&& f) QUAL { \
        using R = remove_cvref_t<invoke_result_t<F, ARG>>; \
        static_assert(detail::is_expected_v<R>); \
        return has ? invoke(forward<F>(f), static_cast<ARG>(value_data)) : R(unexpect, static_cast<ERROR>(error_data)); \
    } \
    template<class F> constexpr auto transform(F&& f) QUAL { \
        using U = remove_cv_t<invoke_result_t<F, ARG>>; \
        using R = expected<U, E>; \
        if (!has) return R(unexpect, static_cast<ERROR>(error_data)); \
        if constexpr (is_void_v<U>) { \
            invoke(forward<F>(f), static_cast<ARG>(value_data)); \
            return R(); \
        } else return R(in_place, invoke(forward<F>(f), static_cast<ARG>(value_data))); \
    }
    FTL_EXPECTED_MONADIC(&, T&, E&)
    FTL_EXPECTED_MONADIC(const&, const T&, const E&)
    FTL_EXPECTED_MONADIC(&&, T&&, E&&)
    FTL_EXPECTED_MONADIC(const&&, const T&&, const E&&)
#undef FTL_EXPECTED_MONADIC

    template<class F> constexpr auto or_else(F&& f) & { using R = remove_cvref_t<invoke_result_t<F, E&>>; return has ? R(in_place, value_data) : invoke(forward<F>(f), error_data); }
    template<class F> constexpr auto or_else(F&& f) const& { using R = remove_cvref_t<invoke_result_t<F, const E&>>; return has ? R(in_place, value_data) : invoke(forward<F>(f), error_data); }
    template<class F> constexpr auto or_else(F&& f) && { using R = remove_cvref_t<invoke_result_t<F, E&&>>; return has ? R(in_place, move(value_data)) : invoke(forward<F>(f), move(error_data)); }
    template<class F> constexpr auto or_else(F&& f) const&& { using R = remove_cvref_t<invoke_result_t<F, const E&&>>; return has ? R(in_place, move(value_data)) : invoke(forward<F>(f), move(error_data)); }

    template<class F> constexpr auto transform_error(F&& f) & { using G = remove_cv_t<invoke_result_t<F, E&>>; return has ? expected<T, G>(in_place, value_data) : expected<T, G>(unexpect, invoke(forward<F>(f), error_data)); }
    template<class F> constexpr auto transform_error(F&& f) const& { using G = remove_cv_t<invoke_result_t<F, const E&>>; return has ? expected<T, G>(in_place, value_data) : expected<T, G>(unexpect, invoke(forward<F>(f), error_data)); }
    template<class F> constexpr auto transform_error(F&& f) && { using G = remove_cv_t<invoke_result_t<F, E&&>>; return has ? expected<T, G>(in_place, move(value_data)) : expected<T, G>(unexpect, invoke(forward<F>(f), move(error_data))); }
    template<class F> constexpr auto transform_error(F&& f) const&& { using G = remove_cv_t<invoke_result_t<F, const E&&>>; return has ? expected<T, G>(in_place, move(value_data)) : expected<T, G>(unexpect, invoke(forward<F>(f), move(error_data))); }

    template<class U, class G>
    friend constexpr bool operator==(const expected& left,
                                     const expected<U, G>& right) {
        return left.has == right.has_value() &&
               (left.has ? left.value_data == *right : left.error_data == right.error());
    }
    template<class U>
    friend constexpr bool operator==(const expected& left, const U& right) {
        return left.has && left.value_data == right;
    }
    template<class G>
    friend constexpr bool operator==(const expected& left,
                                     const unexpected<G>& right) {
        return !left.has && left.error_data == right.error();
    }

private:
    constexpr void destroy() noexcept {
        if (has) destroy_at(detail::expected_address(value_data));
        else destroy_at(detail::expected_address(error_data));
    }
    template<class Other> constexpr void assign(Other&& other) {
        if (has && other.has) value_data = forward<Other>(other).value_data;
        else if (!has && !other.has) error_data = forward<Other>(other).error_data;
        else if (other.has) replace_value(forward<Other>(other).value_data);
        else replace_error(forward<Other>(other).error_data);
    }
    template<class U> constexpr void replace_value(U&& value) {
        if constexpr (is_nothrow_constructible_v<T, U>) {
            destroy_at(detail::expected_address(error_data));
            construct_at(detail::expected_address(value_data), forward<U>(value));
        } else if constexpr (is_nothrow_move_constructible_v<T>) {
            T temporary(forward<U>(value));
            destroy_at(detail::expected_address(error_data));
            construct_at(detail::expected_address(value_data), move(temporary));
        } else {
            E backup(move(error_data));
            destroy_at(detail::expected_address(error_data));
#if defined(_CPPUNWIND) || defined(__cpp_exceptions)
            try {
                construct_at(detail::expected_address(value_data), forward<U>(value));
            } catch (...) {
                construct_at(detail::expected_address(error_data), move(backup));
                throw;
            }
#else
            construct_at(detail::expected_address(value_data), forward<U>(value));
#endif
        }
        has = true;
    }
    template<class G> constexpr void replace_error(G&& error) {
        if constexpr (is_nothrow_constructible_v<E, G>) {
            destroy_at(detail::expected_address(value_data));
            construct_at(detail::expected_address(error_data), forward<G>(error));
        } else if constexpr (is_nothrow_move_constructible_v<E>) {
            E temporary(forward<G>(error));
            destroy_at(detail::expected_address(value_data));
            construct_at(detail::expected_address(error_data), move(temporary));
        } else {
            T backup(move(value_data));
            destroy_at(detail::expected_address(value_data));
#if defined(_CPPUNWIND) || defined(__cpp_exceptions)
            try {
                construct_at(detail::expected_address(error_data), forward<G>(error));
            } catch (...) {
                construct_at(detail::expected_address(value_data), move(backup));
                throw;
            }
#else
            construct_at(detail::expected_address(error_data), forward<G>(error));
#endif
        }
        has = false;
    }
    union { T value_data; E error_data; };
    bool has;
};

template<class T, class E>
    requires is_void_v<T>
class expected<T, E> {
public:
    using value_type = T;
    using error_type = E;
    using unexpected_type = unexpected<E>;
    template<class U> using rebind = expected<U, error_type>;

    constexpr expected() noexcept : empty{}, has{true} {}
    constexpr expected(const expected&)
        requires is_trivially_copy_constructible_v<E> = default;
    constexpr expected(const expected& other)
        requires (is_copy_constructible_v<E> &&
                  !is_trivially_copy_constructible_v<E>)
        : has(other.has) { if (!has) construct_at(detail::expected_address(error_data), other.error_data); }
    constexpr expected(expected&&)
        requires is_trivially_move_constructible_v<E> = default;
    constexpr expected(expected&& other)
        noexcept(is_nothrow_move_constructible_v<E>)
        requires (is_move_constructible_v<E> &&
                  !is_trivially_move_constructible_v<E>)
        : has(other.has) { if (!has) construct_at(detail::expected_address(error_data), move(other.error_data)); }

    template<class U, class G>
    constexpr explicit(!is_convertible_v<const G&, E>)
    expected(const expected<U, G>& other)
        requires (is_void_v<U> && is_constructible_v<E, const G&> &&
                  !detail::unexpected_converts_from_any_cvref_v<
                      E, expected<U, G>>)
        : has(other.has_value()) {
        if (!has) construct_at(detail::expected_address(error_data), other.error());
    }
    template<class U, class G>
    constexpr explicit(!is_convertible_v<G, E>)
    expected(expected<U, G>&& other)
        requires (is_void_v<U> && is_constructible_v<E, G> &&
                  !detail::unexpected_converts_from_any_cvref_v<
                      E, expected<U, G>>)
        : has(other.has_value()) {
        if (!has) construct_at(detail::expected_address(error_data), move(other.error()));
    }
    template<class G>
    constexpr explicit(!is_convertible_v<const G&, E>)
    expected(const unexpected<G>& error) requires is_constructible_v<E, const G&>
        : error_data(error.error()), has{false} {}
    template<class G>
    constexpr explicit(!is_convertible_v<G, E>)
    expected(unexpected<G>&& error) requires is_constructible_v<E, G>
        : error_data(move(error.error())), has{false} {}
    constexpr explicit expected(in_place_t) noexcept : empty{}, has{true} {}
    template<class... Args>
    constexpr explicit expected(unexpect_t, Args&&... args)
        requires is_constructible_v<E, Args...>
        : error_data(forward<Args>(args)...), has{false} {}
    template<class U, class... Args>
    constexpr explicit expected(unexpect_t, initializer_list<U> values,
                                Args&&... args)
        requires is_constructible_v<E, initializer_list<U>&, Args...>
        : error_data(values, forward<Args>(args)...), has{false} {}

    constexpr ~expected() requires is_trivially_destructible_v<E> = default;
    constexpr ~expected() requires (!is_trivially_destructible_v<E>) {
        if (!has) destroy_at(detail::expected_address(error_data));
    }

    constexpr expected& operator=(const expected&)
        requires (is_trivially_copy_constructible_v<E> &&
                  is_trivially_copy_assignable_v<E> &&
                  is_trivially_destructible_v<E>) = default;
    constexpr expected& operator=(const expected& other)
        requires (is_copy_constructible_v<E> && is_copy_assignable_v<E> &&
                  !(is_trivially_copy_constructible_v<E> &&
                    is_trivially_copy_assignable_v<E> &&
                    is_trivially_destructible_v<E>)) {
        assign(other); return *this;
    }
    constexpr expected& operator=(expected&&)
        requires (is_trivially_move_constructible_v<E> &&
                  is_trivially_move_assignable_v<E> &&
                  is_trivially_destructible_v<E>) = default;
    constexpr expected& operator=(expected&& other)
        noexcept(is_nothrow_move_constructible_v<E> &&
                 is_nothrow_move_assignable_v<E>)
        requires (is_move_constructible_v<E> && is_move_assignable_v<E> &&
                  !(is_trivially_move_constructible_v<E> &&
                    is_trivially_move_assignable_v<E> &&
                    is_trivially_destructible_v<E>)) {
        assign(move(other)); return *this;
    }
    template<class G>
    constexpr expected& operator=(const unexpected<G>& error)
        requires (is_constructible_v<E, const G&> &&
                  is_assignable_v<E&, const G&>) {
        assign_error(error.error()); return *this;
    }
    template<class G>
    constexpr expected& operator=(unexpected<G>&& error)
        requires (is_constructible_v<E, G> && is_assignable_v<E&, G>) {
        assign_error(move(error.error())); return *this;
    }

    constexpr void operator*() const noexcept {}
    constexpr explicit operator bool() const noexcept { return has; }
    constexpr bool has_value() const noexcept { return has; }
    constexpr void value() const& { if (!has) detail::throw_bad_expected_access(error_data); }
    constexpr void value() && { if (!has) detail::throw_bad_expected_access(move(error_data)); }
    constexpr const E& error() const& noexcept { return error_data; }
    constexpr E& error() & noexcept { return error_data; }
    constexpr const E&& error() const&& noexcept { return move(error_data); }
    constexpr E&& error() && noexcept { return move(error_data); }
    template<class G = E> constexpr E error_or(G&& other) const& {
        return has ? static_cast<E>(forward<G>(other)) : error_data;
    }
    template<class G = E> constexpr E error_or(G&& other) && {
        return has ? static_cast<E>(forward<G>(other)) : move(error_data);
    }
    constexpr void emplace() noexcept { if (!has) { destroy_at(detail::expected_address(error_data)); has = true; } }
    constexpr void swap(expected& other)
        noexcept(is_nothrow_move_constructible_v<E> &&
                 is_nothrow_swappable_v<E>)
        requires (is_move_constructible_v<E> && is_swappable_v<E>) {
        if (!has && !other.has) detail::expected_swap(error_data, other.error_data);
        else if (has != other.has) {
            expected* good = has ? this : &other;
            expected* bad = has ? &other : this;
            construct_at(detail::expected_address(good->error_data), move(bad->error_data));
            destroy_at(detail::expected_address(bad->error_data));
            good->has = false; bad->has = true;
        }
    }

#define FTL_EXPECTED_VOID_MONADIC(QUAL, ERROR) \
    template<class F> constexpr auto and_then(F&& f) QUAL { \
        using R = remove_cvref_t<invoke_result_t<F>>; \
        static_assert(detail::is_expected_v<R>); \
        return has ? invoke(forward<F>(f)) : R(unexpect, static_cast<ERROR>(error_data)); \
    } \
    template<class F> constexpr auto or_else(F&& f) QUAL { \
        using R = remove_cvref_t<invoke_result_t<F, ERROR>>; \
        return has ? R() : invoke(forward<F>(f), static_cast<ERROR>(error_data)); \
    } \
    template<class F> constexpr auto transform(F&& f) QUAL { \
        using U = remove_cv_t<invoke_result_t<F>>; \
        using R = expected<U, E>; \
        if (!has) return R(unexpect, static_cast<ERROR>(error_data)); \
        if constexpr (is_void_v<U>) { invoke(forward<F>(f)); return R(); } \
        else return R(in_place, invoke(forward<F>(f))); \
    } \
    template<class F> constexpr auto transform_error(F&& f) QUAL { \
        using G = remove_cv_t<invoke_result_t<F, ERROR>>; \
        return has ? expected<void, G>() : expected<void, G>(unexpect, invoke(forward<F>(f), static_cast<ERROR>(error_data))); \
    }
    FTL_EXPECTED_VOID_MONADIC(&, E&)
    FTL_EXPECTED_VOID_MONADIC(const&, const E&)
    FTL_EXPECTED_VOID_MONADIC(&&, E&&)
    FTL_EXPECTED_VOID_MONADIC(const&&, const E&&)
#undef FTL_EXPECTED_VOID_MONADIC

    template<class U, class G> requires is_void_v<U>
    friend constexpr bool operator==(const expected& left, const expected<U, G>& right) { return left.has == right.has_value() && (left.has || left.error_data == right.error()); }
    template<class G> friend constexpr bool operator==(const expected& left, const unexpected<G>& right) { return !left.has && left.error_data == right.error(); }
private:
    template<class Other> constexpr void assign(Other&& other) { if (!has && !other.has) error_data = forward<Other>(other).error_data; else if (has && !other.has) { construct_at(detail::expected_address(error_data), forward<Other>(other).error_data); has = false; } else if (!has && other.has) emplace(); }
    template<class G> constexpr void assign_error(G&& error) {
        if (has) { construct_at(detail::expected_address(error_data), forward<G>(error)); has = false; }
        else error_data = forward<G>(error);
    }
    union { unsigned char empty; E error_data; };
    bool has;
};

template<class T, class E>
constexpr void swap(expected<T, E>& left, expected<T, E>& right)
    noexcept(noexcept(left.swap(right)))
    requires requires { left.swap(right); } { left.swap(right); }

