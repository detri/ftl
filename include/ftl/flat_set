template <class Compare>
concept flat_set_transparent_compare = requires {
  typename Compare::is_transparent;
};
template <class Allocator>
concept flat_set_allocator_like =
    requires { typename Allocator::value_type; } &&
    copy_constructible<Allocator> && equality_comparable<Allocator> &&
    requires(Allocator &allocator,
             typename allocator_traits<Allocator>::size_type size,
             typename allocator_traits<Allocator>::pointer pointer) {
      { allocator.allocate(size) } ->
          same_as<typename allocator_traits<Allocator>::pointer>;
      allocator.deallocate(pointer, size);
    };
template <class Key, class Compare, class Container, bool Multi>
class flat_set_base {
  static_assert(is_same_v<Key, typename Container::value_type>);
public:
  using key_type = Key;
  using value_type = Key;
  using key_compare = Compare;
  using value_compare = Compare;
  using reference = value_type &;
  using const_reference = const value_type &;
  using size_type = typename Container::size_type;
  using difference_type = typename Container::difference_type;
  using iterator = typename Container::const_iterator;
  using const_iterator = iterator;
  using reverse_iterator = typename Container::const_reverse_iterator;
  using const_reverse_iterator = reverse_iterator;
  using container_type = Container;
  flat_set_base() = default;
  explicit flat_set_base(const Compare &compare) : compare_(compare) {}
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  explicit flat_set_base(const Allocator &allocator) : container_(allocator) {}
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(const Compare &compare, const Allocator &allocator)
      : container_(allocator), compare_(compare) {}
  template <input_iterator I>
  flat_set_base(I first, I last, const Compare &compare = Compare())
      : compare_(compare) {
    insert(first, last);
  }
  template <input_iterator I, class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(I first, I last, const Compare &compare,
                const Allocator &allocator)
      : container_(allocator), compare_(compare) {
    insert(first, last);
  }
  template <input_iterator I, class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(I first, I last, const Allocator &allocator)
      : flat_set_base(first, last, Compare(), allocator) {}
  template <ranges::input_range R>
  flat_set_base(from_range_t, R &&range, const Compare &compare = Compare())
      : compare_(compare) {
    insert_range(static_cast<R &&>(range));
  }
  template <ranges::input_range R, class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(from_range_t, R &&range, const Compare &compare,
                const Allocator &allocator)
      : container_(allocator), compare_(compare) {
    insert_range(static_cast<R &&>(range));
  }
  template <ranges::input_range R, class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(from_range_t tag, R &&range, const Allocator &allocator)
      : flat_set_base(tag, static_cast<R &&>(range), Compare(), allocator) {}
  flat_set_base(initializer_list<Key> values,
                const Compare &compare = Compare())
      : flat_set_base(values.begin(), values.end(), compare) {}
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(initializer_list<Key> values, const Compare &compare,
                const Allocator &allocator)
      : flat_set_base(values.begin(), values.end(), compare, allocator) {}
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(initializer_list<Key> values, const Allocator &allocator)
      : flat_set_base(values, Compare(), allocator) {}
  flat_set_base(sorted_unique_t, Container container,
                const Compare &compare = Compare())
    requires(!Multi)
      : container_(move(container)), compare_(compare) {}
  flat_set_base(sorted_equivalent_t, Container container,
                const Compare &compare = Compare())
    requires(Multi)
      : container_(move(container)), compare_(compare) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag, const Container &container, const Compare &compare,
                const Allocator &allocator)
      : container_(container, allocator), compare_(compare) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag tag, const Container &container,
                const Allocator &allocator)
      : flat_set_base(tag, container, Compare(), allocator) {}
  template <class Tag, input_iterator I>
    requires((is_same_v<Tag, sorted_unique_t> && !Multi) ||
             (is_same_v<Tag, sorted_equivalent_t> && Multi))
  flat_set_base(Tag, I first, I last, const Compare &compare = Compare())
      : container_(first, last), compare_(compare) {}
  template <class Tag, input_iterator I, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag, I first, I last, const Compare &compare,
                const Allocator &allocator)
      : container_(first, last, allocator), compare_(compare) {}
  template <class Tag, input_iterator I, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag tag, I first, I last, const Allocator &allocator)
      : flat_set_base(tag, first, last, Compare(), allocator) {}
  template <class Tag>
    requires((is_same_v<Tag, sorted_unique_t> && !Multi) ||
             (is_same_v<Tag, sorted_equivalent_t> && Multi))
  flat_set_base(Tag tag, initializer_list<Key> values,
                const Compare &compare = Compare())
      : flat_set_base(tag, values.begin(), values.end(), compare) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag tag, initializer_list<Key> values, const Compare &compare,
                const Allocator &allocator)
      : flat_set_base(tag, values.begin(), values.end(), compare, allocator) {}
  template <class Tag, class Allocator>
    requires(uses_allocator_v<Container, Allocator> &&
             ((is_same_v<Tag, sorted_unique_t> && !Multi) ||
              (is_same_v<Tag, sorted_equivalent_t> && Multi)))
  flat_set_base(Tag tag, initializer_list<Key> values,
                const Allocator &allocator)
      : flat_set_base(tag, values, Compare(), allocator) {}
  flat_set_base(Container container, const Compare &compare = Compare())
      : container_(move(container)), compare_(compare) {
    normalize();
  }
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(const Container &container, const Compare &compare,
                const Allocator &allocator)
      : container_(container, allocator), compare_(compare) {
    normalize();
  }
  template <class Allocator>
    requires uses_allocator_v<Container, Allocator>
  flat_set_base(const Container &container, const Allocator &allocator)
      : flat_set_base(container, Compare(), allocator) {}
  flat_set_base(const flat_set_base &) = default;
  flat_set_base(flat_set_base &&) = default;
  flat_set_base &operator=(const flat_set_base &other) {
    if (this == &other)
      return *this;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      container_ = other.container_;
      compare_ = other.compare_;
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      clear();
      throw;
    }
#endif
    return *this;
  }
  flat_set_base &operator=(flat_set_base &&other) noexcept(
      is_nothrow_move_assignable_v<Container> &&
      is_nothrow_move_assignable_v<Compare>) {
    if (this == &other)
      return *this;
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      container_ = move(other.container_);
      compare_ = move(other.compare_);
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      clear();
      throw;
    }
#endif
    return *this;
  }
  flat_set_base &operator=(initializer_list<Key> values) {
    clear();
    insert(values);
    return *this;
  }
  iterator begin() const noexcept { return container_.begin(); }
  iterator end() const noexcept { return container_.end(); }
  reverse_iterator rbegin() const noexcept { return container_.rbegin(); }
  reverse_iterator rend() const noexcept { return container_.rend(); }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  const_reverse_iterator crbegin() const noexcept { return rbegin(); }
  const_reverse_iterator crend() const noexcept { return rend(); }
  [[nodiscard]] bool empty() const noexcept { return container_.empty(); }
  size_type size() const noexcept { return container_.size(); }
  size_type max_size() const noexcept { return container_.max_size(); }
  template <class... Args> auto emplace(Args &&...args) {
    Key value(forward<Args>(args)...);
    return insert(move(value));
  }
  template <class... Args>
  iterator emplace_hint(const_iterator, Args &&...args) {
    if constexpr (Multi)
      return emplace(forward<Args>(args)...);
    else
      return emplace(forward<Args>(args)...).first;
  }
  auto insert(const Key &value) { return insert_value(value); }
  auto insert(Key &&value) { return insert_value(move(value)); }
  template <class K>
  auto insert(K &&value)
    requires is_constructible_v<Key, K &&>
  {
    return insert_value(Key(static_cast<K &&>(value)));
  }
  iterator insert(const_iterator, const Key &value) {
    if constexpr (Multi)
      return insert(value);
    else
      return insert(value).first;
  }
  iterator insert(const_iterator, Key &&value) {
    if constexpr (Multi)
      return insert(move(value));
    else
      return insert(move(value)).first;
  }
  template <class K>
  iterator insert(const_iterator hint, K &&value)
    requires is_constructible_v<Key, K &&>
  {
    if constexpr (Multi)
      return insert(static_cast<K &&>(value));
    else
      return insert(static_cast<K &&>(value)).first;
  }
  template <input_iterator I> void insert(I first, I last) {
    insert_bulk(first, last, false);
  }
  template <class Tag, input_iterator I>
    requires((is_same_v<Tag, sorted_unique_t> && !Multi) ||
             (is_same_v<Tag, sorted_equivalent_t> && Multi))
  void insert(Tag, I first, I last) { insert_bulk(first, last, true); }
  template <ranges::input_range R> void insert_range(R &&range) {
    insert(ranges::begin(range), ranges::end(range));
  }
  void insert(initializer_list<Key> values) {
    insert(values.begin(), values.end());
  }
  void insert(sorted_unique_t tag, initializer_list<Key> values)
    requires(!Multi)
  {
    insert(tag, values.begin(), values.end());
  }
  void insert(sorted_equivalent_t tag, initializer_list<Key> values)
    requires(Multi)
  {
    insert(tag, values.begin(), values.end());
  }
  iterator erase(const_iterator position) { return container_.erase(position); }
  iterator erase(const_iterator first, const_iterator last) {
    return container_.erase(first, last);
  }
  size_type erase(const Key &key) {
    auto range = equal_range(key);
    auto count = static_cast<size_type>(range.second - range.first);
    erase(range.first, range.second);
    return count;
  }
  template <class K>
  size_type erase(K &&key)
    requires(flat_set_transparent_compare<Compare> &&
             !is_convertible_v<K &&, iterator> &&
             !is_convertible_v<K &&, const_iterator>)
  {
    auto range = equal_range(key);
    auto count = static_cast<size_type>(range.second - range.first);
    erase(range.first, range.second);
    return count;
  }
  void swap(flat_set_base &other) noexcept {
    container_.swap(other.container_);
    FTL_FLAT_NAMESPACE::swap(compare_, other.compare_);
  }
  void clear() noexcept { container_.clear(); }
  iterator find(const Key &key) const {
    auto found = lower_bound(key);
    return found != end() && equivalent(*found, key) ? found : end();
  }
  template <class K> iterator find(const K &key) const requires flat_set_transparent_compare<Compare> {
    auto found = lower_bound(key);
    return found != end() && equivalent(*found, key) ? found : end();
  }
  size_type count(const Key &key) const {
    auto range = equal_range(key);
    return static_cast<size_type>(range.second - range.first);
  }
  template <class K> size_type count(const K &key) const requires flat_set_transparent_compare<Compare> {
    auto range = equal_range(key);
    return static_cast<size_type>(range.second - range.first);
  }
  bool contains(const Key &key) const {
    return find(key) != end();
  }
  template <class K> bool contains(const K &key) const requires flat_set_transparent_compare<Compare> {
    return find(key) != end();
  }
  iterator lower_bound(const Key &key) const {
    return FTL_FLAT_NAMESPACE::lower_bound(begin(), end(), key, compare_);
  }
  template <class K> iterator lower_bound(const K &key) const requires flat_set_transparent_compare<Compare> {
    return FTL_FLAT_NAMESPACE::lower_bound(begin(), end(), key, compare_);
  }
  iterator upper_bound(const Key &key) const {
    return FTL_FLAT_NAMESPACE::upper_bound(begin(), end(), key, compare_);
  }
  template <class K> iterator upper_bound(const K &key) const requires flat_set_transparent_compare<Compare> {
    return FTL_FLAT_NAMESPACE::upper_bound(begin(), end(), key, compare_);
  }
  pair<iterator, iterator> equal_range(const Key &key) const {
    return {lower_bound(key), upper_bound(key)};
  }
  template <class K> pair<iterator, iterator> equal_range(const K &key) const requires flat_set_transparent_compare<Compare> {
    return {lower_bound(key), upper_bound(key)};
  }
  key_compare key_comp() const { return compare_; }
  value_compare value_comp() const { return compare_; }
  container_type extract() && {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      container_type result(move(container_));
      container_.clear();
      return result;
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      container_.clear();
      throw;
    }
#endif
  }
  void replace(container_type &&container) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
      container_ = move(container);
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      container_.clear();
      throw;
    }
#endif
  }

protected:
  template <input_iterator I>
  void insert_bulk(I first, I last, bool incoming_is_sorted) {
    const auto old_size = container_.size();
    container_.insert(container_.end(), first, last);
    auto middle = container_.begin() + static_cast<difference_type>(old_size);
    if (!incoming_is_sorted)
      FTL_FLAT_NAMESPACE::sort(middle, container_.end(), compare_);

    Container source(move(container_));
    if constexpr (requires { container_.reserve(source.size()); })
      container_.reserve(source.size());
    auto left = source.begin();
    auto left_end = source.begin() + static_cast<difference_type>(old_size);
    auto right = left_end;
    const auto append = [this](auto &value) {
      if constexpr (!Multi)
        if (!container_.empty() && equivalent(container_.back(), value))
          return;
      container_.push_back(move(value));
    };
    while (left != left_end && right != source.end()) {
      if (compare_(*right, *left))
        append(*right++);
      else
        append(*left++);
    }
    while (left != left_end)
      append(*left++);
    while (right != source.end())
      append(*right++);
  }
  template <class V> auto insert_value(V &&value) {
    auto position = Multi ? upper_bound(value) : lower_bound(value);
    if constexpr (!Multi) {
      if (position != end() && equivalent(*position, value))
        return pair<iterator, bool>{position, false};
      auto inserted = container_.insert(position, static_cast<V &&>(value));
      return pair<iterator, bool>{inserted, true};
    } else
      return container_.insert(position, static_cast<V &&>(value));
  }
  template <class Left, class Right>
  bool equivalent(const Left &left, const Right &right) const {
    return !compare_(left, right) && !compare_(right, left);
  }
  void normalize() {
    if (!FTL_FLAT_NAMESPACE::is_sorted(container_.begin(), container_.end(),
                                       compare_))
      FTL_FLAT_NAMESPACE::sort(container_.begin(), container_.end(), compare_);
    if constexpr (!Multi)
      container_.erase(
          FTL_FLAT_NAMESPACE::unique(container_.begin(), container_.end(),
                                     [this](const Key &left, const Key &right) {
                                       return equivalent(left, right);
                                     }),
          container_.end());
  }
  Container container_{};
  FTL_NO_UNIQUE_ADDRESS Compare compare_{};
};
} // namespace detail
template <class Key, class Compare = less<Key>,
          class KeyContainer = vector<Key>>
class flat_set
    : public detail::flat_set_base<Key, Compare, KeyContainer, false> {
  using base = detail::flat_set_base<Key, Compare, KeyContainer, false>;

public:
  using base::base;
  using base::operator=;
  flat_set &operator=(initializer_list<Key> values) {
    base::operator=(values);
    return *this;
  }
};
template <class Key, class Compare = less<Key>,
          class KeyContainer = vector<Key>>
class flat_multiset
    : public detail::flat_set_base<Key, Compare, KeyContainer, true> {
  using base = detail::flat_set_base<Key, Compare, KeyContainer, true>;

public:
  using base::base;
  using base::operator=;
  flat_multiset &operator=(initializer_list<Key> values) {
    base::operator=(values);
    return *this;
  }
};
