template<class Character>
struct char_traits {
    using char_type = Character;
    using int_type = unsigned long long;
    using off_type = ptrdiff_t;
    using pos_type = size_t;

    static constexpr void assign(char_type& left,
                                 const char_type& right) noexcept {
        left = right;
    }
    static constexpr bool eq(char_type left, char_type right) noexcept {
        return left == right;
    }
    static constexpr bool lt(char_type left, char_type right) noexcept {
        return left < right;
    }
    static constexpr int compare(
        const char_type* left, const char_type* right, size_t count) {
        for (size_t index = 0; index < count; ++index) {
            if (lt(left[index], right[index])) return -1;
            if (lt(right[index], left[index])) return 1;
        }
        return 0;
    }
    static constexpr size_t length(const char_type* string) {
        size_t result = 0;
        while (!eq(string[result], char_type{}))
            ++result;
        return result;
    }
    static constexpr const char_type* find(
        const char_type* string, size_t count, const char_type& value) {
        for (size_t index = 0; index < count; ++index)
            if (eq(string[index], value))
                return string + index;
        return nullptr;
    }
    static constexpr char_type* move(
        char_type* destination, const char_type* source, size_t count) {
        if (destination < source)
            for (size_t index = 0; index < count; ++index)
                destination[index] = source[index];
        else
            for (size_t index = count; index; --index)
                destination[index - 1] = source[index - 1];
        return destination;
    }
    static constexpr char_type* copy(
        char_type* destination, const char_type* source, size_t count) {
        for (size_t index = 0; index < count; ++index)
            destination[index] = source[index];
        return destination;
    }
    static constexpr char_type* assign(
        char_type* destination, size_t count, char_type value) {
        for (size_t index = 0; index < count; ++index)
            destination[index] = value;
        return destination;
    }
    static constexpr int_type to_int_type(char_type value) noexcept {
        return static_cast<int_type>(value);
    }
    static constexpr char_type to_char_type(int_type value) noexcept {
        return static_cast<char_type>(value);
    }
    static constexpr bool eq_int_type(int_type left, int_type right) noexcept {
        return left == right;
    }
    static constexpr int_type eof() noexcept { return ~int_type{}; }
    static constexpr int_type not_eof(int_type value) noexcept {
        return eq_int_type(value, eof()) ? 0 : value;
    }
};

template<class Character, class Traits = char_traits<Character>>
class basic_string_view {
public:
    using traits_type            = Traits;
    using value_type             = Character;
    using pointer                = Character*;
    using const_pointer          = const Character*;
    using reference              = Character&;
    using const_reference        = const Character&;
    using const_iterator         = const Character*;
    using iterator               = const_iterator;
    using size_type              = size_t;
    using difference_type        = ptrdiff_t;
    static constexpr size_type npos = size_type(-1);

    constexpr basic_string_view() noexcept = default;
    constexpr basic_string_view(
        const Character* input, size_type length) noexcept
        : first{input}, count{length} {}
    constexpr basic_string_view(const Character* input)
        : first{input}, count{Traits::length(input)} {}

    constexpr const_iterator begin() const noexcept { return first; }
    constexpr const_iterator end() const noexcept { return first + count; }
    constexpr const_iterator cbegin() const noexcept { return begin(); }
    constexpr const_iterator cend() const noexcept { return end(); }
    constexpr const_reference operator[](size_type index) const noexcept {
        return first[index];
    }
    // ponytail: bounds errors fast-fail until <stdexcept> provides out_of_range.
    constexpr const_reference at(size_type index) const {
        if (index >= count)
            FTL_STRING_VIEW_TRAP();
        return first[index];
    }
    constexpr const_reference front() const noexcept { return first[0]; }
    constexpr const_reference back() const noexcept {
        return first[count - 1];
    }
    constexpr const_pointer data() const noexcept { return first; }
    constexpr size_type size() const noexcept { return count; }
    constexpr size_type length() const noexcept { return count; }
    constexpr size_type max_size() const noexcept { return npos; }
    constexpr bool empty() const noexcept { return count == 0; }

    constexpr void remove_prefix(size_type amount) {
        first += amount;
        count -= amount;
    }
    constexpr void remove_suffix(size_type amount) { count -= amount; }
    constexpr void swap(basic_string_view& other) noexcept {
        const auto old_first = first;
        const auto old_count = count;
        first = other.first;
        count = other.count;
        other.first = old_first;
        other.count = old_count;
    }
    constexpr basic_string_view substr(
        size_type position = 0, size_type length = npos) const {
        if (position > count)
            FTL_STRING_VIEW_TRAP();
        const size_type remaining = count - position;
        return {first + position,
                length < remaining ? length : remaining};
    }
    constexpr int compare(basic_string_view other) const noexcept {
        const size_type length = count < other.count ? count : other.count;
        if (const int result = Traits::compare(first, other.first, length))
            return result;
        return count < other.count ? -1 : count > other.count ? 1 : 0;
    }
    constexpr bool starts_with(basic_string_view value) const noexcept {
        return count >= value.count &&
               Traits::compare(first, value.first, value.count) == 0;
    }
    constexpr bool starts_with(Character value) const noexcept {
        return count && Traits::eq(first[0], value);
    }
    constexpr bool ends_with(basic_string_view value) const noexcept {
        return count >= value.count &&
               Traits::compare(first + count - value.count,
                               value.first, value.count) == 0;
    }
    constexpr bool ends_with(Character value) const noexcept {
        return count && Traits::eq(first[count - 1], value);
    }
    constexpr bool contains(basic_string_view value) const noexcept {
        return find(value) != npos;
    }
    constexpr bool contains(Character value) const noexcept {
        return find(value) != npos;
    }
    constexpr size_type find(
        basic_string_view value, size_type position = 0) const noexcept {
        if (value.empty())
            return position <= count ? position : npos;
        for (; position + value.count <= count; ++position)
            if (Traits::compare(first + position,
                                value.first, value.count) == 0)
                return position;
        return npos;
    }
    constexpr size_type find(
        Character value, size_type position = 0) const noexcept {
        const auto* result =
            position < count
                ? Traits::find(first + position, count - position, value)
                : nullptr;
        return result ? size_type(result - first) : npos;
    }

private:
    const Character* first{};
    size_type count{};
};

template<class Character, class Traits>
constexpr bool operator==(
    basic_string_view<Character, Traits> left,
    basic_string_view<Character, Traits> right) noexcept {
    return left.size() == right.size() && left.compare(right) == 0;
}
template<class Character, class Traits>
constexpr bool operator==(
    basic_string_view<Character, Traits> left,
    const Character* right) noexcept {
    return left == basic_string_view<Character, Traits>{right};
}
template<class Character, class Traits>
constexpr bool operator==(
    const Character* left,
    basic_string_view<Character, Traits> right) noexcept {
    return basic_string_view<Character, Traits>{left} == right;
}

using string_view = basic_string_view<char>;
using wstring_view = basic_string_view<wchar_t>;
using u8string_view = basic_string_view<char8_t>;
using u16string_view = basic_string_view<char16_t>;
using u32string_view = basic_string_view<char32_t>;

} // namespace std or ftl

#undef FTL_STRING_VIEW_TRAP
#endif // FTL_STRING_VIEW_HEADER
