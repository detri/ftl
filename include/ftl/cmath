namespace detail {
template <class T>
inline constexpr bool math_arithmetic_v = is_arithmetic_v<remove_cv_t<T>>;

template <class T>
inline T math_domain_error() { return sqrt(T{-1}); }

template <class T>
using math_floating_arg_t =
    conditional_t<is_integral_v<remove_cv_t<T>>, double, remove_cv_t<T>>;

// The usual arithmetic conversions implement the standard's floating-point
// conversion-rank/subrank selection after integer arguments are mapped to
// double as required by the additional math overloads.
template <class Left, class Right>
using math_common_t =
    decltype(declval<math_floating_arg_t<Left>>() +
             declval<math_floating_arg_t<Right>>());

template <class T> constexpr T const_abs(T value) {
  return value == T{} ? T{} : value < T{} ? -value : value;
}
template <class T> constexpr T const_fabs(T value) { return const_abs(value); }
template <class T> constexpr bool const_isnan(T value) { return value != value; }
template <class T> constexpr bool const_isinf(T value) {
  return value == numeric_limits<T>::infinity() ||
         value == -numeric_limits<T>::infinity();
}
template <class T> constexpr bool const_isfinite(T value) {
  return !const_isnan(value) && !const_isinf(value);
}
template <class T> constexpr bool const_isnormal(T value) {
  return const_isfinite(value) && const_abs(value) >= numeric_limits<T>::min();
}
template <class T> constexpr bool const_signbit(T value) {
#if defined(__clang__) || defined(__GNUC__)
  return __builtin_signbit(value);
#elif defined(_MSC_VER)
  // MSVC targets supported by FTL use IEEE binary32/binary64 and represent
  // long double as binary64. Avoid byte-order-sensitive byte indexing.
  if constexpr (sizeof(T) == sizeof(unsigned int))
    return (bit_cast<unsigned int>(value) >> 31) != 0;
  else
    return (bit_cast<unsigned long long>(value) >> 63) != 0;
#else
#error Unsupported compiler representation for constexpr signbit
#endif
}
template <class T> constexpr T const_copysign(T magnitude, T sign) {
  return const_signbit(magnitude) == const_signbit(sign) ? magnitude : -magnitude;
}
template <class T> constexpr T const_trunc(T value) {
  if (!const_isfinite(value) || value == T{}) return value;
  constexpr T bound = T(numeric_limits<long long>::max());
  if (value >= bound || value <= -bound) return value;
  return T(static_cast<long long>(value));
}
template <class T> constexpr T const_floor(T value) {
  const T integer = const_trunc(value);
  return integer > value ? integer - T{1} : integer;
}
template <class T> constexpr T const_ceil(T value) {
  const T integer = const_trunc(value);
  return integer < value ? integer + T{1} : integer;
}
template <class T> constexpr T const_round(T value) {
  return value < T{} ? const_ceil(value - T{0.5})
                     : const_floor(value + T{0.5});
}
template <class T> constexpr T const_scalbn(T value, long exponent) {
  if (!const_isfinite(value) || value == T{}) return value;
  while (exponent > 0) { value *= T{2}; --exponent; }
  while (exponent < 0) { value *= T{0.5}; ++exponent; }
  return value;
}
template <class T> constexpr T const_frexp(T value, int *exponent) {
  *exponent = 0;
  if (!const_isfinite(value) || value == T{}) return value;
  T magnitude = const_abs(value);
  while (magnitude >= T{1}) { magnitude *= T{0.5}; ++*exponent; }
  while (magnitude < T{0.5}) { magnitude *= T{2}; --*exponent; }
  return const_copysign(magnitude, value);
}
template <class T> constexpr int const_ilogb(T value) {
  if (value == T{}) return FP_ILOGB0;
  if (const_isnan(value)) return FP_ILOGBNAN;
  if (const_isinf(value)) return numeric_limits<int>::max();
  int exponent{};
  (void)const_frexp(value, &exponent);
  return exponent - 1;
}
template <class T> constexpr T const_logb(T value) {
  if (value == T{}) return -numeric_limits<T>::infinity();
  if (const_isnan(value) || const_isinf(value)) return const_abs(value);
  return T(const_ilogb(value));
}
template <class T> struct const_divrem_result {
  T remainder;
  unsigned quotient_low_bits;
};

template <class T>
constexpr const_divrem_result<T> const_divrem(T numerator, T denominator) {
  T scaled = denominator;
  unsigned shifts = 0;

  while (scaled <= numerator - scaled) {
    scaled += scaled;
    ++shifts;
  }

  unsigned quotient = 0;
  for (;;) {
    quotient = (quotient << 1) & 7u;
    if (numerator >= scaled) {
      numerator -= scaled;
      quotient |= 1u;
    }
    if (shifts == 0)
      break;
    scaled *= T{0.5};
    --shifts;
  }

  return {numerator, quotient};
}

template <class T> constexpr T const_fmod(T x, T y) {
  if (const_isnan(x) || const_isnan(y) || y == T{} || const_isinf(x))
    return numeric_limits<T>::quiet_NaN();
  if (const_isinf(y)) return x;
  const T magnitude = const_divrem(const_abs(x), const_abs(y)).remainder;
  return const_copysign(magnitude, x);
}
template <class T> constexpr T const_remainder(T x, T y,
                                               long long *quotient = nullptr) {
  if (const_isnan(x) || const_isnan(y) || y == T{} || const_isinf(x))
    return numeric_limits<T>::quiet_NaN();
  if (const_isinf(y)) { if (quotient) *quotient = 0; return x; }

  const T denominator = const_abs(y);
  auto division = const_divrem(const_abs(x), denominator);
  const T complement = denominator - division.remainder;
  const bool round_up = division.remainder > complement ||
      (division.remainder == complement &&
       (division.quotient_low_bits & 1u) != 0);

  if (round_up) {
    division.remainder = -complement;
    division.quotient_low_bits = (division.quotient_low_bits + 1u) & 7u;
  }

  if (quotient) {
    const long long low = static_cast<long long>(division.quotient_low_bits);
    *quotient = const_signbit(x) != const_signbit(y) ? -low : low;
  }

  T result = const_signbit(x) ? -division.remainder : division.remainder;
  return result == T{} ? const_copysign(T{}, x) : result;
}
template <class T, class U> constexpr T const_nextafter(T from, U to) {
  if (const_isnan(from) || const_isnan(to)) return from + to;
  if (from == to) return static_cast<T>(to);
  if (from == T{})
    return const_copysign(numeric_limits<T>::denorm_min(), static_cast<T>(to));
  T magnitude = const_abs(from), ulp = numeric_limits<T>::denorm_min();
  if (magnitude >= numeric_limits<T>::min()) {
    int exponent{};
    const T fraction = const_frexp(magnitude, &exponent);
    ulp = const_scalbn(numeric_limits<T>::epsilon(), exponent - 1);
    if ((to > from) == (from < T{}) && fraction == T{0.5}) ulp *= T{0.5};
  }
  return to > from ? from + ulp : from - ulp;
}
template <class T> constexpr T const_fdim(T x, T y) {
  return const_isnan(x) || const_isnan(y) ? x + y : x > y ? x - y : T{};
}
template <class T> constexpr T const_fmax(T x, T y) {
  if (const_isnan(x)) return y;
  if (const_isnan(y)) return x;
  if (x == y) return const_signbit(x) ? y : x;
  return x > y ? x : y;
}
template <class T> constexpr T const_fmin(T x, T y) {
  if (const_isnan(x)) return y;
  if (const_isnan(y)) return x;
  if (x == y) return const_signbit(x) ? x : y;
  return x < y ? x : y;
}
