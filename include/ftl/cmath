}
inline float fmaf(float x, float y, float z) noexcept { return fma(x, y, z); }
inline long double fmal(long double x, long double y,
                        long double z) noexcept {
  return fma(x, y, z);
}
template <class X, class Y, class Z>
  requires(detail::math_arithmetic_v<X> && detail::math_arithmetic_v<Y> &&
           detail::math_arithmetic_v<Z>)
inline auto fma(X x, Y y, Z z) noexcept {
  using xy = detail::math_common_t<X, Y>;
  using common = detail::math_common_t<xy, Z>;
  return fma(static_cast<common>(x), static_cast<common>(y),
             static_cast<common>(z));
}

