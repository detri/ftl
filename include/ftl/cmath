template <class T>
inline T expint_e1(T x) {
  if (x <= T{1}) {
    T term = -x, sum = term;
    for (unsigned k = 2; k != 256; ++k) {
      term *= -x / T(k);
      const T add = term / T(k);
      sum += add;
      if (fabs(add) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
    }
    return -T(0.577215664901532860606512090082402431L) - log(x) - sum;
  }
  T b = x + T{1}, c = T{1} / numeric_limits<T>::min(), d = T{1} / b;
  T h = d;
  for (unsigned i = 1; i != 256; ++i) {
    const T a = -T(i * i);
    b += T{2};
    d = T{1} / (a * d + b);
    c = b + a / c;
    const T delta = c * d;
    h *= delta;
    if (fabs(delta - T{1}) <= T{4} * numeric_limits<T>::epsilon()) break;
  }
  return h * exp(-x);
}
} // namespace detail

template <class T>
  requires is_floating_point_v<T>
inline T expint(T x) {
  if (isnan(x)) return x;
  if (isinf(x)) return x > T{} ? x : -T{};
  if (x == T{}) return -numeric_limits<T>::infinity();
  if (x < T{}) return -detail::expint_e1(-x);
  if (x > T{40}) {
    T term{1}, sum{1};
    for (unsigned k = 1; k != 128; ++k) {
      term *= T(k) / x;
      if (term > sum && k > 2) break;
      sum += term;
      if (term <= sum * numeric_limits<T>::epsilon()) break;
    }
    return exp(x) * sum / x;
  }
  T term = x, sum = term;
  for (unsigned k = 2; k != 512; ++k) {
    term *= x / T(k);
    const T add = term / T(k);
    sum += add;
    if (fabs(add) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
  }
  return T(0.577215664901532860606512090082402431L) + log(x) + sum;
}
inline float expintf(float x) { return expint(x); }
inline long double expintl(long double x) { return expint(x); }

template <class T>
  requires is_floating_point_v<T>
inline T riemann_zeta(T s) {
  if (isnan(s)) return s;
  if (isinf(s))
    return s > T{} ? T{1} : detail::math_domain_error<T>();
  if (s == T{1}) return numeric_limits<T>::infinity();
  if (s < T{}) {
    if (s == floor(s / T{2}) * T{2}) return T{};
    const T pi = T(3.141592653589793238462643383279502884L);
    return pow(T{2}, s) * pow(pi, s - T{1}) * sin(pi * s / T{2}) *
           tgamma(T{1} - s) * riemann_zeta(T{1} - s);
  }
  const T n = T{24};
  T sum{};
  for (unsigned k = 1; k <= 24; ++k) sum += pow(T(k), -s);
  T rising{1}, power = pow(n, -s);
  sum += n * power / (s - T{1}) - power / T{2};
  constexpr long double coeff[] = {
      1.0L / 12, -1.0L / 720, 1.0L / 30240, -1.0L / 1209600,
      1.0L / 47900160, -691.0L / 1307674368000.0L,
      7.0L / 523069747200.0L, -3617.0L / 10670622842880000.0L};
  for (unsigned k = 1; k <= 8; ++k) {
    if (k == 1) rising = s;
    else rising *= (s + T(2 * k - 3)) * (s + T(2 * k - 2));
    power /= n * n;
    const T add = T(coeff[k - 1]) * rising * n * power;
    sum += add;
    if (fabs(add) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
  }
  return sum;
}
inline float riemann_zetaf(float x) { return riemann_zeta(x); }
inline long double riemann_zetal(long double x) { return riemann_zeta(x); }

// Boost.Math spherical_harmonic.hpp normalization at azimuth zero.
// Copyright John Maddock 2006 (BSL-1.0).
template <class T>
  requires is_floating_point_v<T>
inline T sph_legendre(unsigned l, unsigned m, T theta) {
  if (isnan(theta)) return theta;
  const T pi = T(3.141592653589793238462643383279502884L);
  if (theta < T{} || theta > pi) return detail::math_domain_error<T>();
  if (m > l) return T{};
  T ratio = T{1};
  for (unsigned k = l - m + 1; k <= l + m; ++k) ratio /= T(k);
  const T phase = (m & 1u) ? T{-1} : T{1};
  return phase * sqrt(T(2 * l + 1) * ratio / (T{4} * pi)) *
         assoc_legendre(l, m, cos(theta));
}
inline float sph_legendref(unsigned l, unsigned m, float theta) {
  return sph_legendre(l, m, theta);
}
inline long double sph_legendrel(unsigned l, unsigned m, long double theta) {
  return sph_legendre(l, m, theta);
}

// [cmath.syn]/3: arithmetic arguments use the greatest floating-point rank;
// integer arguments have the rank of double.
#define FTL_SPECIAL_UNARY_ARITHMETIC(name)                                   \
  template <class Arithmetic>                                                \
    requires is_integral_v<remove_cv_t<Arithmetic>>                          \
  inline double name(Arithmetic value) { return name(static_cast<double>(value)); }

#define FTL_SPECIAL_BINARY_ARITHMETIC(name)                                  \
  template <class Left, class Right>                                         \
    requires(detail::math_arithmetic_v<Left> &&                              \
             detail::math_arithmetic_v<Right> &&                             \
             !(is_same_v<remove_cv_t<Left>, remove_cv_t<Right>> &&           \
               is_floating_point_v<remove_cv_t<Left>>))                      \
  inline detail::math_common_t<Left, Right> name(Left left, Right right) {    \
    using result_type = detail::math_common_t<Left, Right>;                  \
    return name(static_cast<result_type>(left), static_cast<result_type>(right)); \
  }

#define FTL_SPECIAL_TERNARY_ARITHMETIC(name)                                 \
  template <class First, class Second, class Third>                          \
    requires(detail::math_arithmetic_v<First> &&                             \
             detail::math_arithmetic_v<Second> &&                            \
             detail::math_arithmetic_v<Third> &&                             \
             !(is_same_v<remove_cv_t<First>, remove_cv_t<Second>> &&         \
               is_same_v<remove_cv_t<First>, remove_cv_t<Third>> &&          \
               is_floating_point_v<remove_cv_t<First>>))                     \
  inline detail::math_common_t<detail::math_common_t<First, Second>, Third>  \
  name(First first, Second second, Third third) {                             \
    using result_type =                                                      \
        detail::math_common_t<detail::math_common_t<First, Second>, Third>;   \
    return name(static_cast<result_type>(first),                             \
                static_cast<result_type>(second),                            \
                static_cast<result_type>(third));                            \
  }

