template <class T>
  requires is_floating_point_v<T>
inline T hypot(T x, T y, T z) noexcept {
  const T maximum = fmax(fabs(x), fmax(fabs(y), fabs(z)));
  if (isinf(maximum)) return maximum;
  if (maximum == T{}) return maximum;
  x /= maximum;
  y /= maximum;
  z /= maximum;
  return maximum * sqrt(x * x + y * y + z * z);
}
template <class X, class Y, class Z>
  requires(detail::math_arithmetic_v<X> && detail::math_arithmetic_v<Y> &&
           detail::math_arithmetic_v<Z> &&
           !(is_same_v<remove_cv_t<X>, remove_cv_t<Y>> &&
             is_same_v<remove_cv_t<X>, remove_cv_t<Z>> &&
             is_floating_point_v<remove_cv_t<X>>))
inline auto hypot(X x, Y y, Z z) noexcept {
  using xy = detail::math_common_t<X, Y>;
  using common = detail::math_common_t<xy, Z>;
  return hypot(static_cast<common>(x), static_cast<common>(y),
               static_cast<common>(z));
}

template <class T>
  requires is_floating_point_v<T>
constexpr T lerp(T a, T b, T t) noexcept {
  if ((a <= T{} && b >= T{}) || (a >= T{} && b <= T{}))
    return t * b + (T{1} - t) * a;
  if (t == T{1}) return b;
  const T result = a + t * (b - a);
  return (t > T{1}) == (b > a) ? (result < b ? b : result)
                                : (result > b ? b : result);
}
