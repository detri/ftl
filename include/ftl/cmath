  return assoc_legendre(l, m, x);
}

namespace detail {
template <class T> inline T stirling_correction_from_inverse(T inverse) {
  const T square = inverse * inverse;
  return inverse *
      (T{1} / T{12} + square *
          (-T{1} / T{360} + square *
              (T{1} / T{1260} - square / T{1680})));
}

template <class T> inline T log_beta_stirling(T a, T b) {
  if (a > b) {
    const T temporary = a;
    a = b;
    b = temporary;
  }

  const T ratio = a / b;
  const T log_scale = log(b) + log1p(ratio);
  const T log_a_fraction = log(a) - log_scale;
  const T log_b_fraction = -log1p(ratio);
  const T inverse_a = T{1} / a;
  const T inverse_b = T{1} / b;
  const T inverse_sum = inverse_b / (T{1} + ratio);
  const T correction = stirling_correction_from_inverse(inverse_a) +
      stirling_correction_from_inverse(inverse_b) -
      stirling_correction_from_inverse(inverse_sum);
  constexpr long double log_sqrt_two_pi =
      0.918938533204672741780329736405617639861L;

  return (a - T{0.5}) * log_a_fraction +
      (b - T{0.5}) * log_b_fraction - T{0.5} * log_scale +
      T(log_sqrt_two_pi) + correction;
}

template <class T> inline T log_beta_positive(T a, T b) {
  if (a > b) {
    const T temporary = a;
    a = b;
    b = temporary;
  }

  if (b < T{32})
    return lgamma(a) + lgamma(b) - lgamma(a + b);

  T recurrence{};
  while (a < T{8}) {
    recurrence += log(b) + log1p(a / b) - log(a);
    a += T{1};
  }

  return log_beta_stirling(a, b) + recurrence;
}
} // namespace detail

// Evaluate in the logarithmic domain with a scaled Stirling form. In
// particular, neither x + y nor an individual log-gamma term must be
// representable when the final beta value is finite or underflows to zero.
template <class T>
  requires is_floating_point_v<T>
inline T beta(T x, T y) {
  if (isnan(x) || isnan(y)) return x + y;
  if (x <= T{} || y <= T{}) return detail::math_domain_error<T>();
  return exp(detail::log_beta_positive(x, y));
}
inline float betaf(float x, float y) { return beta(x, y); }
inline long double betal(long double x, long double y) { return beta(x, y); }

template <class T>
  requires is_floating_point_v<T>
inline T comp_ellint_1(T k) {
  if (isnan(k)) return k;
  if (fabs(k) > T{1}) return detail::math_domain_error<T>();
  if (fabs(k) == T{1}) return numeric_limits<T>::infinity();
  return detail::carlson_rf(T{}, T{1} - k * k, T{1});
}
inline float comp_ellint_1f(float k) { return comp_ellint_1(k); }
inline long double comp_ellint_1l(long double k) { return comp_ellint_1(k); }

template <class T>
  requires is_floating_point_v<T>
inline T comp_ellint_2(T k) {
  if (isnan(k)) return k;
  if (fabs(k) > T{1}) return detail::math_domain_error<T>();
  const T kk = k * k;
  if (kk == T{1}) return T{1};
  return detail::carlson_rf(T{}, T{1} - kk, T{1}) -
         kk * detail::carlson_rd(T{}, T{1} - kk, T{1}) / T{3};
}
inline float comp_ellint_2f(float k) { return comp_ellint_2(k); }
inline long double comp_ellint_2l(long double k) { return comp_ellint_2(k); }

template <class T>
  requires is_floating_point_v<T>
inline T comp_ellint_3(T k, T nu) {
  if (isnan(k) || isnan(nu)) return k + nu;
  if (fabs(k) > T{1} || nu >= T{1}) return detail::math_domain_error<T>();
  if (fabs(k) == T{1}) return numeric_limits<T>::infinity();
  const T y = T{1} - k * k;
  return detail::carlson_rf(T{}, y, T{1}) +
         nu * detail::carlson_rj(T{}, y, T{1}, T{1} - nu) / T{3};
}
inline float comp_ellint_3f(float k, float nu) { return comp_ellint_3(k, nu); }
inline long double comp_ellint_3l(long double k, long double nu) {
  return comp_ellint_3(k, nu);
}

namespace detail {
template <class T>
inline T elliptic_reduce(T phi, T complete, T &reduced) {
  const T half_pi = T(1.570796326794896619231321691639751442L);
  const T n = floor(phi / T(3.141592653589793238462643383279502884L) + T{0.5});
  reduced = phi - n * T(3.141592653589793238462643383279502884L);
  if (reduced > half_pi) reduced -= T{2} * half_pi;
  if (reduced < -half_pi) reduced += T{2} * half_pi;
  return n == T{} ? T{} : T{2} * n * complete;
}
} // namespace detail

template <class T>
  requires is_floating_point_v<T>
inline T ellint_1(T k, T phi) {
  if (isnan(k) || isnan(phi)) return k + phi;
  if (fabs(k) > T{1}) return detail::math_domain_error<T>();
  T p;
  const T offset = detail::elliptic_reduce(phi, comp_ellint_1(k), p);
  const T s = sin(p), c = cos(p), ss = s * s;
  return offset + s * detail::carlson_rf(c * c, T{1} - k * k * ss, T{1});
}
inline float ellint_1f(float k, float phi) { return ellint_1(k, phi); }
inline long double ellint_1l(long double k, long double phi) {
  return ellint_1(k, phi);
}

template <class T>
  requires is_floating_point_v<T>
inline T ellint_2(T k, T phi) {
  if (isnan(k) || isnan(phi)) return k + phi;
  if (fabs(k) > T{1}) return detail::math_domain_error<T>();
  T p;
  const T offset = detail::elliptic_reduce(phi, comp_ellint_2(k), p);
  const T s = sin(p), c = cos(p), ss = s * s, kk = k * k;
  return offset + s * detail::carlson_rf(c * c, T{1} - kk * ss, T{1}) -
         kk * s * ss * detail::carlson_rd(c * c, T{1} - kk * ss, T{1}) / T{3};
}
inline float ellint_2f(float k, float phi) { return ellint_2(k, phi); }
inline long double ellint_2l(long double k, long double phi) {
  return ellint_2(k, phi);
}

template <class T>
  requires is_floating_point_v<T>
inline T ellint_3(T k, T nu, T phi) {
  if (isnan(k) || isnan(nu) || isnan(phi)) return k + nu + phi;
  if (fabs(k) > T{1}) return detail::math_domain_error<T>();
  const T pi = T(3.141592653589793238462643383279502884L);
  const T n = floor(phi / pi + T{0.5});
  T p = phi - n * pi;
  const T offset = n == T{} ? T{} : T{2} * n * comp_ellint_3(k, nu);
  const T s = sin(p), c = cos(p), ss = s * s;
  const T y = T{1} - k * k * ss, q = T{1} - nu * ss;
  if (n != T{} || q <= T{}) {
    if (nu >= T{1}) return detail::math_domain_error<T>();
  }
  return offset + s * detail::carlson_rf(c * c, y, T{1}) +
         nu * s * ss * detail::carlson_rj(c * c, y, T{1}, q) / T{3};
}
inline float ellint_3f(float k, float nu, float phi) {
  return ellint_3(k, nu, phi);
}
inline long double ellint_3l(long double k, long double nu, long double phi) {
  return ellint_3(k, nu, phi);
}

namespace detail {
// Series and large-argument expansions adapted from Boost.Math 1.91.0
// bessel_jy_series.hpp, bessel_jy_asym.hpp, and bessel_ik.hpp (BSL-1.0).
// Copyright Xiaogang Zhang 2006; Copyright Matt Borland 2024.
template <class T>
inline T bessel_series(T nu, T x, bool modified) {
  if (x == T{}) return nu == T{} ? T{1} : T{};
  T term = pow(x / T{2}, nu) / tgamma(nu + T{1});
  T sum = term;
  const T q = (modified ? T{1} : -T{1}) * x * x / T{4};
  for (unsigned k = 1; k != 512; ++k) {
    term *= q / (T(k) * (nu + T(k)));
    sum += term;
    if (fabs(term) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
  }
  return sum;
}

template <class T>
inline T bessel_j_asym(T nu, T x) {
  const T mu = T{4} * nu * nu;
  T p{1}, q{}, term{1};
  for (unsigned k = 1; k != 24; ++k) {
    term *= -(mu - T((2 * k - 1) * (2 * k - 1))) /
            (T(k) * T{8} * x);
    if (k & 1) q += (k & 2) ? -term : term;
    else p += (k & 2) ? -term : term;
    if (fabs(term) < numeric_limits<T>::epsilon() * (fabs(p) + fabs(q))) break;
  }
  const T phase = x - nu * T(1.570796326794896619231321691639751442L) -
                  T(0.785398163397448309615660845819875721L);
  return sqrt(T{2} / (T(3.141592653589793238462643383279502884L) * x)) *
         (cos(phase) * p - sin(phase) * q);
}

template <class T>
inline void bessel_jy_cf1(T v, T x, T &ratio, int &sign) {
  const T tiny = sqrt(numeric_limits<T>::min());
  T c = tiny, d{}, f = tiny;
  sign = 1;
  for (unsigned k = 1; k != 16384; ++k) {
    const T b = T{2} * (v + T(k)) / x;
    c = b - T{1} / c;
    d = b - d;
    if (c == T{}) c = tiny;
    if (d == T{}) d = tiny;
    d = T{1} / d;
    const T delta = c * d;
    f *= delta;
    if (d < T{}) sign = -sign;
    if (fabs(delta - T{1}) < T{2} * numeric_limits<T>::epsilon()) break;
  }
  ratio = -f;
}

template <class T>
inline void bessel_jy_cf2(T v, T x, T &p, T &q) {
  const T tiny = sqrt(numeric_limits<T>::min());
  T cr = -T{0.5} / x, ci = T{1}, fr = cr, fi = ci;
  const T v2 = v * v;
  T a = (T{0.25} - v2) / x, br = T{2} * x, bi = T{2};
  T temp = cr * cr + T{1};
  ci = bi + a * cr / temp;
  cr = br + a / temp;
  T dr = br, di = bi;
  if (fabs(cr) + fabs(ci) < tiny) cr = tiny;
  temp = dr * dr + di * di;
  dr /= temp;
  di = -di / temp;
  T delta_r = cr * dr - ci * di, delta_i = ci * dr + cr * di;
  temp = fr;
  fr = temp * delta_r - fi * delta_i;
  fi = temp * delta_i + fi * delta_r;
  for (unsigned k = 2; k != 1024; ++k) {
    a = (T(k) - T{0.5}) * (T(k) - T{0.5}) - v2;
    bi += T{2};
    temp = cr * cr + ci * ci;
    cr = br + a * cr / temp;
    ci = bi - a * ci / temp;
    dr = br + a * dr;
    di = bi + a * di;
    if (fabs(cr) + fabs(ci) < tiny) cr = tiny;
    if (fabs(dr) + fabs(di) < tiny) dr = tiny;
    temp = dr * dr + di * di;
    dr /= temp;
    di = -di / temp;
    delta_r = cr * dr - ci * di;
    delta_i = ci * dr + cr * di;
    temp = fr;
    fr = temp * delta_r - fi * delta_i;
    fi = temp * delta_i + fi * delta_r;
    if (fabs(delta_r - T{1}) + fabs(delta_i) <
        T{2} * numeric_limits<T>::epsilon()) break;
  }
  p = fr;
  q = fi;
}

template <class T>
inline void bessel_jy_temme(T v, T x, T &y, T &y1) {
  const T pi = T(3.141592653589793238462643383279502884L);
  const T euler = T(0.577215664901532860606512090082402431L);
  const T gp = expm1(lgamma(T{1} + v));
  const T gm = expm1(lgamma(T{1} - v));
  const T spv = sin(pi * v), spv2 = sin(pi * v / T{2});
  const T xp = pow(x / T{2}, v), a = log(x / T{2}), sigma = -a * v;
  const T d = fabs(sigma) < numeric_limits<T>::epsilon()
                  ? T{1} : sinh(sigma) / sigma;
  const T e = fabs(v) < numeric_limits<T>::epsilon()
                  ? v * pi * pi / T{2} : T{2} * spv2 * spv2 / v;
  const T g1 = v == T{} ? -euler
      : (gp - gm) / ((T{1} + gp) * (T{1} + gm) * T{2} * v);
  const T g2 = (T{2} + gp + gm) /
               ((T{1} + gp) * (T{1} + gm) * T{2});
  const T vspv = fabs(v) < numeric_limits<T>::epsilon() ? T{1} / pi : v / spv;
  T f = (g1 * cosh(sigma) - g2 * a * d) * T{2} * vspv;
  T p = vspv / (xp * (T{1} + gm));
  T q = vspv * xp / (T{1} + gp);
  T g = f + e * q, h = p, coefficient{1};
  T sum = g, sum1 = h;
  for (unsigned k = 1; k != 1024; ++k) {
    f = (T(k) * f + p + q) / (T(k * k) - v * v);
    p /= T(k) - v;
    q /= T(k) + v;
    g = f + e * q;
    h = p - T(k) * g;
    coefficient *= -x * x / (T{4} * T(k));
    sum += coefficient * g;
    sum1 += coefficient * h;
    if (fabs(coefficient * g) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
  }
  y = -sum;
  y1 = -T{2} * sum1 / x;
}

template <class T>
inline void bessel_jy_pair(T v, T x, T &j, T &y) {
  const unsigned n = static_cast<unsigned>(round(v));
  const T u = v - T(n);
  const T wronskian = T{2} /
      (x * T(3.141592653589793238462643383279502884L));
  T fv{};
  int sign{};
  bessel_jy_cf1(v, x, fv, sign);
  if (x <= T{2}) {
    T yu{}, yu1{};
    bessel_jy_temme(u, x, yu, yu1);
    T previous = yu, current = yu1;
    for (unsigned k = 1; k <= n; ++k) {
      const T next = T{2} * (u + T(k)) * current / x - previous;
      previous = current;
      current = next;
    }
    y = previous;
    j = wronskian / (y * fv - current);
    return;
  }
  const T init = sqrt(numeric_limits<T>::min());
  T previous = fv * T(sign) * init, current = T(sign) * init;
  for (unsigned k = n; k > 0; --k) {
    T next = T{2} * (u + T(k)) * current / x - previous;
    if (next == T{}) next = previous * numeric_limits<T>::epsilon() / T{2};
    previous = current;
    current = next;
  }
  const T scale = T(sign) * init / current;
  const T fu = previous / current;
  T p{}, q{};
  bessel_jy_cf2(u, x, p, q);
  const T t = u / x - fu;
  T gamma = (p - t) / q;
  if (gamma == T{}) gamma = u * numeric_limits<T>::epsilon() / x;
  const T ju = (current < T{} ? -T{1} : T{1}) *
               sqrt(wronskian / (q + gamma * (p - t)));
  j = ju * scale;
  T yu = gamma * ju;
  T yu1 = yu * (u / x - p - q / gamma);
  previous = yu;
  current = yu1;
  for (unsigned k = 1; k <= n; ++k) {
    const T next = T{2} * (u + T(k)) * current / x - previous;
    previous = current;
    current = next;
  }
  y = previous;
}

template <class T>
inline T bessel_j(T nu, T x) {
  if (x < T{5} || nu > x * x / T{4}) return bessel_series(nu, x, false);
  T j{}, y{};
  bessel_jy_pair(nu, x, j, y);
  return j;
}

template <class T>
inline T bessel_y(T nu, T x) {
  T j{}, y{};
  bessel_jy_pair(nu, x, j, y);
  return y;
}

template <class T>
inline void bessel_ik_temme(T v, T x, T &k0, T &k1) {
  const T pi = T(3.141592653589793238462643383279502884L);
  const T euler = T(0.577215664901532860606512090082402431L);
  const T gp = expm1(lgamma(T{1} + v));
  const T gm = expm1(lgamma(T{1} - v));
  const T a = log(x / T{2}), b = exp(v * a), sigma = -a * v;
  const T c = fabs(v) < numeric_limits<T>::epsilon()
                  ? T{1} : sin(pi * v) / (v * pi);
  const T d = fabs(sigma) < numeric_limits<T>::epsilon()
                  ? T{1} : sinh(sigma) / sigma;
  const T gamma1 = fabs(v) < numeric_limits<T>::epsilon()
                  ? -euler : (gp - gm) * c / (T{2} * v);
  const T gamma2 = (T{2} + gp + gm) * c / T{2};
  T p = (gp + T{1}) / (T{2} * b), q = (T{1} + gm) * b / T{2};
  T f = (cosh(sigma) * gamma1 - a * d * gamma2) / c;
  T h = p, coefficient{1}, sum = f, sum1 = h;
  for (unsigned n = 1; n != 1024; ++n) {
    f = (T(n) * f + p + q) / (T(n * n) - v * v);
    p /= T(n) - v;
    q /= T(n) + v;
    h = p - T(n) * f;
    coefficient *= x * x / (T{4} * T(n));
    sum += coefficient * f;
    sum1 += coefficient * h;
    if (fabs(coefficient * f) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
  }
  k0 = sum;
  k1 = T{2} * sum1 / x;
}

template <class T>
inline void bessel_ik_cf2(T v, T x, T &k0, T &k1) {
  const T epsilon = numeric_limits<T>::epsilon();
  T a = v * v - T{0.25}, b = T{2} * (x + T{1});
  T d = T{1} / b, f = d, delta = d;
  T previous{}, current{1}, big_q = -a, c = -a, sum = T{1} + big_q * delta;
  for (unsigned n = 2; n != 2048; ++n) {
    a -= T{2} * T(n - 1);
    b += T{2};
    d = T{1} / (b + a * d);
    delta *= b * d - T{1};
    f += delta;
    T q = (previous - (b - T{2}) * current) / a;
    previous = current;
    current = q;
    c *= -a / T(n);
    big_q += c * q;
    sum += big_q * delta;
    if (fabs(q) < epsilon && q != T{}) {
      c *= q;
      previous /= q;
      current /= q;
    }
    if (fabs(big_q * delta) < fabs(sum) * epsilon) break;
  }
  const T pi = T(3.141592653589793238462643383279502884L);
  k0 = sqrt(pi / (T{2} * x)) * exp(-x) / sum;
  k1 = k0 * (T{0.5} + v + x + (v * v - T{0.25}) * f) / x;
}

template <class T>
inline T bessel_k_core(T v, T x) {
  const unsigned n = static_cast<unsigned>(round(v));
  const T u = v - T(n);
  T previous{}, current{};
  if (x <= T{2}) bessel_ik_temme(u, x, previous, current);
  else bessel_ik_cf2(u, x, previous, current);
  for (unsigned i = 1; i <= n; ++i) {
    const T next = T{2} * (u + T(i)) * current / x + previous;
    previous = current;
    current = next;
  }
  return previous;
}

template <class T>
inline T bessel_k(T nu, T x) {
  const T asymmetry = fabs(T{4} * nu * nu - T{25}) / (T{8} * x);
  if (x > T{100} && asymmetry < sqrt(sqrt(numeric_limits<T>::epsilon()))) {
    T term{1}, sum{1};
    const T mu = T{4} * nu * nu;
    for (unsigned k = 1; k != 32; ++k) {
      term *= (mu - T((2 * k - 1) * (2 * k - 1))) /
              (T(k) * T{8} * x);
      if (fabs(term) > fabs(sum) && k > 2) break;
      sum += term;
      if (fabs(term) <= fabs(sum) * numeric_limits<T>::epsilon()) break;
    }
    return sqrt(T(3.141592653589793238462643383279502884L) / (T{2} * x)) *
           exp(-x) * sum;
  }
  const T nearest = round(nu);
  if (x <= T{2} && nu == nearest && nearest >= T{} && nearest < T{128}) {
    const unsigned n = static_cast<unsigned>(nearest);
    const T q = x * x / T{4};
    T term{1}, harmonic{}, series{}, derivative{};
    for (unsigned k = 1; k != 256; ++k) {
      harmonic += T{1} / T(k);
      term *= q / (T(k) * T(k));
      series += harmonic * term;
      derivative += harmonic * term * T(2 * k) / x;
      if (fabs(term) <= numeric_limits<T>::epsilon() * (fabs(series) + T{1})) break;
    }
    const T logarithm = log(x / T{2}) + T(0.577215664901532860606512090082402431L);
    T previous = -logarithm * bessel_series(T{}, x, true) + series;
    if (n == 0) return previous;
    T current = bessel_series(T{}, x, true) / x +
                logarithm * bessel_series(T{1}, x, true) - derivative;
    for (unsigned k = 1; k < n; ++k) {
      const T next = previous + T(2 * k) * current / x;
      previous = current;
      current = next;
    }
    return current;
  }
  return bessel_k_core(nu, x);
}
} // namespace detail

template <class T>
  requires is_floating_point_v<T>
inline T cyl_bessel_i(T nu, T x) {
  if (isnan(nu) || isnan(x)) return nu + x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (isinf(x)) return numeric_limits<T>::infinity();
  if (isinf(nu) && nu < T{}) return detail::math_domain_error<T>();
  if (nu >= T{}) return detail::bessel_series(nu, x, true);
  const T positive = -nu;
  if (positive == round(positive))
    return detail::bessel_series(positive, x, true);
  const T pi = T(3.141592653589793238462643383279502884L);
  return detail::bessel_series(positive, x, true) +
         T{2} * sin(pi * positive) * detail::bessel_k(positive, x) / pi;
}
inline float cyl_bessel_if(float nu, float x) { return cyl_bessel_i(nu, x); }
inline long double cyl_bessel_il(long double nu, long double x) {
  return cyl_bessel_i(nu, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T cyl_bessel_j(T nu, T x) {
  if (isnan(nu) || isnan(x)) return nu + x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (isinf(x)) return T{};
  if (isinf(nu) && nu < T{}) return detail::math_domain_error<T>();
  if (nu >= T{}) return detail::bessel_j(nu, x);
  const T positive = -nu;
  if (positive == round(positive))
    return (static_cast<long long>(positive) & 1) ?
        -detail::bessel_j(positive, x) : detail::bessel_j(positive, x);
  const T angle = T(3.141592653589793238462643383279502884L) * positive;
  return cos(angle) * detail::bessel_j(positive, x) -
         sin(angle) * detail::bessel_y(positive, x);
}
inline float cyl_bessel_jf(float nu, float x) { return cyl_bessel_j(nu, x); }
inline long double cyl_bessel_jl(long double nu, long double x) {
  return cyl_bessel_j(nu, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T cyl_bessel_k(T nu, T x) {
  if (isnan(nu) || isnan(x)) return nu + x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (x == T{}) return numeric_limits<T>::infinity();
  if (isinf(x)) return T{};
  if (isinf(nu) && nu < T{}) return detail::math_domain_error<T>();
  return detail::bessel_k(fabs(nu), x);
}
inline float cyl_bessel_kf(float nu, float x) { return cyl_bessel_k(nu, x); }
inline long double cyl_bessel_kl(long double nu, long double x) {
  return cyl_bessel_k(nu, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T cyl_neumann(T nu, T x) {
  if (isnan(nu) || isnan(x)) return nu + x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (x == T{}) return -numeric_limits<T>::infinity();
  if (isinf(x)) return T{};
  if (isinf(nu) && nu < T{}) return detail::math_domain_error<T>();
  if (nu >= T{}) return detail::bessel_y(nu, x);
  const T positive = -nu;
  if (positive == round(positive))
    return (static_cast<long long>(positive) & 1) ?
        -detail::bessel_y(positive, x) : detail::bessel_y(positive, x);
  const T angle = T(3.141592653589793238462643383279502884L) * positive;
  return cos(angle) * detail::bessel_y(positive, x) +
         sin(angle) * detail::bessel_j(positive, x);
}
inline float cyl_neumannf(float nu, float x) { return cyl_neumann(nu, x); }
inline long double cyl_neumannl(long double nu, long double x) {
  return cyl_neumann(nu, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T sph_bessel(unsigned n, T x) {
  if (isnan(x)) return x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (x == T{}) return n == 0 ? T{1} : T{};
  return sqrt(T(1.570796326794896619231321691639751442L) / x) *
         cyl_bessel_j(T(n) + T{0.5}, x);
}
inline float sph_besself(unsigned n, float x) { return sph_bessel(n, x); }
inline long double sph_bessell(unsigned n, long double x) {
  return sph_bessel(n, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T sph_neumann(unsigned n, T x) {
  if (isnan(x)) return x;
  if (x < T{}) return detail::math_domain_error<T>();
  if (x == T{}) return -numeric_limits<T>::infinity();
  return sqrt(T(1.570796326794896619231321691639751442L) / x) *
         cyl_neumann(T(n) + T{0.5}, x);
}
inline float sph_neumannf(unsigned n, float x) { return sph_neumann(n, x); }
inline long double sph_neumannl(unsigned n, long double x) {
  return sph_neumann(n, x);
}

