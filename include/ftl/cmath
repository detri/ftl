             is_same_v<remove_cv_t<A>, remove_cv_t<C>> &&
             is_floating_point_v<remove_cv_t<A>>))
constexpr auto lerp(A a, B b, C t) noexcept {
  using ab = detail::math_common_t<A, B>;
  using common = detail::math_common_t<ab, C>;
  return lerp(static_cast<common>(a), static_cast<common>(b),
              static_cast<common>(t));
}

