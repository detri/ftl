#define FTL_CMATH_UNARY(name)                                                 \
  inline float name(float value) noexcept { return ::ftl_olm_##name##f(value); } \
  inline double name(double value) noexcept { return ::ftl_olm_##name(value); } \
  inline long double name(long double value) noexcept {                       \
    return ::ftl_olm_##name##l(value);                                        \
  }                                                                           \
  inline float name##f(float value) noexcept { return name(value); }           \
  inline long double name##l(long double value) noexcept { return name(value); } \
  template <class Integer>                                                    \
    requires is_integral_v<Integer>                                           \
  inline double name(Integer value) noexcept {                                \
    return name(static_cast<double>(value));                                  \
  }

#define FTL_CMATH_BINARY(name)                                                \
  inline float name(float left, float right) noexcept {                       \
    return ::ftl_olm_##name##f(left, right);                                  \
  }                                                                           \
  inline double name(double left, double right) noexcept {                    \
    return ::ftl_olm_##name(left, right);                                     \
  }                                                                           \
  inline long double name(long double left, long double right) noexcept {     \
    return ::ftl_olm_##name##l(left, right);                                  \
  }                                                                           \
  inline float name##f(float left, float right) noexcept {                    \
    return name(left, right);                                                 \
  }                                                                           \
  inline long double name##l(long double left, long double right) noexcept {  \
    return name(left, right);                                                 \
  }                                                                           \
  template <class Left, class Right>                                          \
    requires(detail::math_arithmetic_v<Left> &&                               \
             detail::math_arithmetic_v<Right>)                                \
  inline detail::math_common_t<Left, Right> name(Left left, Right right)       \
      noexcept {                                                              \
    using common = detail::math_common_t<Left, Right>;                         \
    return name(static_cast<common>(left), static_cast<common>(right));        \
  }

