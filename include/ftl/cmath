namespace detail {
template <class T>
inline constexpr bool math_arithmetic_v = is_arithmetic_v<remove_cv_t<T>>;

template <class Left, class Right>
using math_common_t = conditional_t<
    is_same_v<remove_cv_t<Left>, long double> ||
        is_same_v<remove_cv_t<Right>, long double>,
    long double,
    conditional_t<is_same_v<remove_cv_t<Left>, double> ||
                      is_same_v<remove_cv_t<Right>, double> ||
                      is_integral_v<remove_cv_t<Left>> ||
                      is_integral_v<remove_cv_t<Right>>,
                  double, float>>;
} // namespace detail

