template <class T>
inline T carlson_rf(T x, T y, T z) {
  T a = (x + y + z) / T{3};
  for (unsigned i = 0; i != 64; ++i) {
    const T rx = sqrt(x), ry = sqrt(y), rz = sqrt(z);
    const T lambda = rx * ry + rx * rz + ry * rz;
    x = (x + lambda) / T{4};
    y = (y + lambda) / T{4};
    z = (z + lambda) / T{4};
    a = (a + lambda) / T{4};
    const T dx = (a - x) / a, dy = (a - y) / a;
    const T dz = -dx - dy;
    if (fabs(dx) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dy) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dz) < T{4} * numeric_limits<T>::epsilon()) {
      const T e2 = dx * dy - dz * dz;
      const T e3 = dx * dy * dz;
      return (T{1} + e3 * (T{1} / T{14} + T{3} * e3 / T{104}) +
              e2 * (-T{1} / T{10} + e2 / T{24} - T{3} * e3 / T{44} -
                    T{5} * e2 * e2 / T{208} + e2 * e3 / T{16})) /
             sqrt(a);
    }
  }
  return numeric_limits<T>::quiet_NaN();
}

template <class T>
inline T carlson_rd(T x, T y, T z) {
  T sum{}, factor{1};
  for (unsigned i = 0; i != 64; ++i) {
    const T rx = sqrt(x), ry = sqrt(y), rz = sqrt(z);
    const T lambda = rx * ry + rx * rz + ry * rz;
    sum += factor / (rz * (z + lambda));
    factor /= T{4};
    x = (x + lambda) / T{4};
    y = (y + lambda) / T{4};
    z = (z + lambda) / T{4};
    const T a = (x + y + T{3} * z) / T{5};
    const T dx = (a - x) / a, dy = (a - y) / a;
    const T dz = -(dx + dy) / T{3};
    if (fabs(dx) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dy) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dz) < T{4} * numeric_limits<T>::epsilon()) {
      const T e2 = dx * dy - T{6} * dz * dz;
      const T e3 = (T{3} * dx * dy - T{8} * dz * dz) * dz;
      const T e4 = T{3} * (dx * dy - dz * dz) * dz * dz;
      const T e5 = dx * dy * dz * dz * dz;
      const T poly = T{1} - T{3} * e2 / T{14} + e3 / T{6} +
          T{9} * e2 * e2 / T{88} - T{3} * e4 / T{22} -
          T{9} * e2 * e3 / T{52} + T{3} * e5 / T{26} -
          e2 * e2 * e2 / T{16} + T{3} * e3 * e3 / T{40} +
          T{3} * e2 * e4 / T{20} + T{45} * e2 * e2 * e3 / T{272} -
          T{9} * (e3 * e4 + e2 * e5) / T{68};
      return factor * poly / (a * sqrt(a)) + T{3} * sum;
    }
  }
  return numeric_limits<T>::quiet_NaN();
}

template <class T>
inline T carlson_rc(T x, T y) {
  if (x == y) return T{1} / sqrt(x);
  if (x == T{}) return T(1.570796326794896619231321691639751442L) / sqrt(y);
  if (y > x) {
    const T d = sqrt(y - x);
    return atan(d / sqrt(x)) / d;
  }
  const T d = sqrt(x - y);
  return atanh(d / sqrt(x)) / d;
}

template <class T>
inline T carlson_rj(T x, T y, T z, T p) {
  T sum{}, factor{1};
  for (unsigned i = 0; i != 64; ++i) {
    const T rx = sqrt(x), ry = sqrt(y), rz = sqrt(z), rp = sqrt(p);
    const T lambda = rx * ry + rx * rz + ry * rz;
    const T d = (rp + rx) * (rp + ry) * (rp + rz);
    const T e = (p - x) * (p - y) * (p - z) / (d * d);
    sum += factor * carlson_rc(T{1}, T{1} + e) / d;
    factor /= T{4};
    x = (x + lambda) / T{4};
    y = (y + lambda) / T{4};
    z = (z + lambda) / T{4};
    p = (p + lambda) / T{4};
    const T a = (x + y + z + T{2} * p) / T{5};
    const T dx = (a - x) / a, dy = (a - y) / a, dz = (a - z) / a;
    const T dp = -(dx + dy + dz) / T{2};
    if (fabs(dx) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dy) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dz) < T{4} * numeric_limits<T>::epsilon() &&
        fabs(dp) < T{4} * numeric_limits<T>::epsilon()) {
      const T e2 = dx * dy + dx * dz + dy * dz - T{3} * dp * dp;
      const T e3 = dx * dy * dz + T{2} * e2 * dp + T{4} * dp * dp * dp;
      const T e4 = (T{2} * dx * dy * dz + e2 * dp + T{3} * dp * dp * dp) * dp;
      const T e5 = dx * dy * dz * dp * dp;
      const T poly = T{1} - T{3} * e2 / T{14} + e3 / T{6} +
          T{9} * e2 * e2 / T{88} - T{3} * e4 / T{22} -
          T{9} * e2 * e3 / T{52} + T{3} * e5 / T{26} -
          e2 * e2 * e2 / T{16} + T{3} * e3 * e3 / T{40} +
          T{3} * e2 * e4 / T{20} + T{45} * e2 * e2 * e3 / T{272} -
          T{9} * (e3 * e4 + e2 * e5) / T{68};
      return factor * poly / (a * sqrt(a)) + T{6} * sum;
    }
  }
  return numeric_limits<T>::quiet_NaN();
}
