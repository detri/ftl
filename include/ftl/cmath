// Polynomial recurrences adapted from Boost.Math 1.91.0:
// boost/math/special_functions/{laguerre,legendre,hermite}.hpp (BSL-1.0).
template <class T>
  requires is_floating_point_v<T>
inline T assoc_laguerre(unsigned n, unsigned m, T x) {
  if (n == 0) return T{1};
  T previous = T{1};
  T current = T(m + 1) - x;
  for (unsigned k = 1; k < n; ++k) {
    const T next = ((T(2 * k + m + 1) - x) * current -
                    T(k + m) * previous) /
                   T(k + 1);
    previous = current;
    current = next;
  }
  return current;
}
inline float assoc_laguerref(unsigned n, unsigned m, float x) {
  return assoc_laguerre(n, m, x);
}
inline long double assoc_laguerrel(unsigned n, unsigned m, long double x) {
  return assoc_laguerre(n, m, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T laguerre(unsigned n, T x) { return assoc_laguerre(n, 0, x); }
inline float laguerref(unsigned n, float x) { return laguerre(n, x); }
inline long double laguerrel(unsigned n, long double x) {
  return laguerre(n, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T hermite(unsigned n, T x) {
  if (n == 0) return T{1};
  T previous = T{1};
  T current = T{2} * x;
  for (unsigned k = 1; k < n; ++k) {
    const T next = T{2} * x * current - T(2 * k) * previous;
    previous = current;
    current = next;
  }
  return current;
}
inline float hermitef(unsigned n, float x) { return hermite(n, x); }
inline long double hermitel(unsigned n, long double x) {
  return hermite(n, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T legendre(unsigned l, T x) {
  if (l == 0) return T{1};
  T previous = T{1};
  T current = x;
  for (unsigned n = 1; n < l; ++n) {
    const T next = (T(2 * n + 1) * x * current - T(n) * previous) /
                   T(n + 1);
    previous = current;
    current = next;
  }
  return current;
}
inline float legendref(unsigned l, float x) { return legendre(l, x); }
inline long double legendrel(unsigned l, long double x) {
  return legendre(l, x);
}

template <class T>
  requires is_floating_point_v<T>
inline T assoc_legendre(unsigned l, unsigned m, T x) {
  if (m > l) return T{};
  T pmm = T{1};
  if (m != 0) {
    const T root = sqrt((T{1} - x) * (T{1} + x));
    T factor = T{1};
    for (unsigned i = 1; i <= m; ++i) {
      pmm *= -factor * root;
      factor += T{2};
    }
  }
  if (l == m) return pmm;
  T previous = pmm;
  T current = T(2 * m + 1) * x * pmm;
  for (unsigned n = m + 1; n < l; ++n) {
    const T next = (T(2 * n + 1) * x * current - T(n + m) * previous) /
                   T(n - m + 1);
    previous = current;
    current = next;
  }
  return current;
}
inline float assoc_legendref(unsigned l, unsigned m, float x) {
  return assoc_legendre(l, m, x);
}
inline long double assoc_legendrel(unsigned l, unsigned m, long double x) {
  return assoc_legendre(l, m, x);
}

// Adapted from Boost.Math beta.hpp: evaluate through log-gamma to avoid the
// premature overflow of tgamma(x) * tgamma(y).
template <class T>
  requires is_floating_point_v<T>
inline T beta(T x, T y) {
  return exp(lgamma(x) + lgamma(y) - lgamma(x + y));
}
inline float betaf(float x, float y) { return beta(x, y); }
inline long double betal(long double x, long double y) { return beta(x, y); }

// Boost.Math spherical_harmonic.hpp normalization at azimuth zero.
template <class T>
  requires is_floating_point_v<T>
inline T sph_legendre(unsigned l, unsigned m, T theta) {
  if (m > l) return T{};
  T ratio = T{1};
  for (unsigned k = l - m + 1; k <= l + m; ++k) ratio /= T(k);
  const T pi = T(3.141592653589793238462643383279502884L);
  return sqrt(T(2 * l + 1) * ratio / (T{4} * pi)) *
         assoc_legendre(l, m, cos(theta));
}
inline float sph_legendref(unsigned l, unsigned m, float theta) {
  return sph_legendre(l, m, theta);
}
inline long double sph_legendrel(unsigned l, unsigned m, long double theta) {
  return sph_legendre(l, m, theta);
}

