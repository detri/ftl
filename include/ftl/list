namespace detail {
template <class R, class T>
concept list_compatible_range =
    ranges::input_range<R> && convertible_to<ranges::range_reference_t<R>, T>;
template <class T> struct list_compare {
  constexpr auto operator()(const T &a, const T &b) const {
    if constexpr (three_way_comparable<T>)
      return a <=> b;
    else {
      if (a < b)
        return weak_ordering::less;
      if (b < a)
        return weak_ordering::greater;
      return weak_ordering::equivalent;
    }
  }
};
} // namespace detail

template <class T, class Allocator = allocator<T>> class list {
  struct node_base {
    node_base *next;
    node_base *previous;
  };
  struct node : node_base {
    template <class... Args>
    explicit node(Args &&...args)
        : node_base{nullptr, nullptr}, value(forward<Args>(args)...) {}
    T value;
  };
  using traits = allocator_traits<Allocator>;
  using node_allocator = typename traits::template rebind_alloc<node>;
  using node_traits = allocator_traits<node_allocator>;

public:
  static_assert(is_same_v<typename traits::value_type, T>);
  static_assert(is_object_v<T>);
  using value_type = T;
  using allocator_type = Allocator;
  using pointer = typename traits::pointer;
  using const_pointer = typename traits::const_pointer;
  using reference = T &;
  using const_reference = const T &;
  using size_type = typename traits::size_type;
  using difference_type = typename traits::difference_type;
  template <bool Const> class basic_iterator {
    node_base *current_{};
    explicit basic_iterator(node_base *p) : current_(p) {}
    friend class list;
    template <bool> friend class basic_iterator;

  public:
    using iterator_concept = bidirectional_iterator_tag;
    using iterator_category = bidirectional_iterator_tag;
    using value_type = T;
    using difference_type = typename list::difference_type;
    using reference = conditional_t<Const, const T &, T &>;
    using pointer = conditional_t<Const, const T *, T *>;
    basic_iterator() = default;
    template <bool Other>
      requires(Const && !Other)
    basic_iterator(const basic_iterator<Other> &x) : current_(x.current_) {}
    reference operator*() const { return static_cast<node *>(current_)->value; }
    pointer operator->() const { return addressof(operator*()); }
    basic_iterator &operator++() {
      current_ = current_->next;
      return *this;
    }
    basic_iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }
    basic_iterator &operator--() {
      current_ = current_->previous;
      return *this;
    }
    basic_iterator operator--(int) {
      auto copy = *this;
      --*this;
      return copy;
    }
    template <bool Other>
    bool operator==(const basic_iterator<Other> &x) const {
      return current_ == x.current_;
    }
  };
  using iterator = basic_iterator<false>;
  using const_iterator = basic_iterator<true>;
  using reverse_iterator = FTL_LIST_NAMESPACE::reverse_iterator<iterator>;
  using const_reverse_iterator =
      FTL_LIST_NAMESPACE::reverse_iterator<const_iterator>;

  list() : list(Allocator()) {}
  explicit list(const Allocator &a) : allocator_(a) { reset(); }
  explicit list(size_type n, const Allocator &a = Allocator()) : list(a) {
    while (n--)
      emplace_back();
  }
  list(size_type n, const T &value, const Allocator &a = Allocator())
      : list(a) {
    while (n--)
      emplace_back(value);
  }
  template <input_iterator I>
  list(I first, I last, const Allocator &a = Allocator()) : list(a) {
    for (; first != last; ++first)
      emplace_back(*first);
  }
  template <detail::list_compatible_range<T> R>
  list(from_range_t, R &&range, const Allocator &a = Allocator()) : list(a) {
    append_range(static_cast<R &&>(range));
  }
  list(const list &other)
      : list(traits::select_on_container_copy_construction(other.allocator_)) {
    append_range(other);
  }
  list(list &&other) noexcept : allocator_(move(other.allocator_)) {
    reset();
    steal(other);
  }
  list(const list &other, const type_identity_t<Allocator> &a)
      : list(other.begin(), other.end(), a) {}
  list(list &&other, const type_identity_t<Allocator> &a) : list(a) {
    if (allocator_ == other.allocator_)
      steal(other);
    else {
      insert(end(), make_move_iterator(other.begin()),
             make_move_iterator(other.end()));
      other.clear();
    }
  }
  list(initializer_list<T> values, const Allocator &a = Allocator())
      : list(values.begin(), values.end(), a) {}
  ~list() { clear(); }
  list &operator=(const list &other) {
    if (this == &other)
      return *this;
    if constexpr (traits::propagate_on_container_copy_assignment::value)
      if (!(allocator_ == other.allocator_)) {
        clear();
        allocator_ = other.allocator_;
      }
    assign(other.begin(), other.end());
    return *this;
  }
  list &operator=(list &&other) noexcept(traits::is_always_equal::value) {
    if (this == &other)
      return *this;
    if constexpr (traits::propagate_on_container_move_assignment::value) {
      clear();
      allocator_ = move(other.allocator_);
      steal(other);
    } else if (allocator_ == other.allocator_) {
      clear();
      steal(other);
    } else {
      assign(make_move_iterator(other.begin()),
             make_move_iterator(other.end()));
      other.clear();
    }
    return *this;
  }
  list &operator=(initializer_list<T> values) {
    assign(values);
    return *this;
  }
  template <input_iterator I> void assign(I first, I last) {
    list replacement(first, last, allocator_);
    swap_nodes(replacement);
  }
  template <detail::list_compatible_range<T> R> void assign_range(R &&range) {
    list replacement(from_range, static_cast<R &&>(range), allocator_);
    swap_nodes(replacement);
  }
  void assign(size_type n, const T &value) {
    list replacement(n, value, allocator_);
    swap_nodes(replacement);
  }
  void assign(initializer_list<T> values) {
    assign(values.begin(), values.end());
  }
  allocator_type get_allocator() const noexcept { return allocator_; }
  iterator begin() noexcept { return iterator(head_.next); }
  const_iterator begin() const noexcept { return const_iterator(head_.next); }
  const_iterator cbegin() const noexcept { return begin(); }
  iterator end() noexcept { return iterator(&head_); }
  const_iterator end() const noexcept {
    return const_iterator(const_cast<node_base *>(&head_));
  }
  const_iterator cend() const noexcept { return end(); }
  reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const noexcept {
    return const_reverse_iterator(end());
  }
  const_reverse_iterator crbegin() const noexcept { return rbegin(); }
  reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const noexcept {
    return const_reverse_iterator(begin());
  }
  const_reverse_iterator crend() const noexcept { return rend(); }
  [[nodiscard]] bool empty() const noexcept { return size_ == 0; }
  size_type size() const noexcept { return size_; }
  size_type max_size() const noexcept {
    node_allocator a(allocator_);
    const auto n = node_traits::max_size(a);
    const auto d =
        static_cast<size_type>((numeric_limits<difference_type>::max)());
    return n < d ? n : d;
  }
  reference front() { return *begin(); }
  const_reference front() const { return *begin(); }
  reference back() { return *--end(); }
  const_reference back() const { return *--end(); }
  template <class... Args> reference emplace_front(Args &&...args) {
    return *emplace(begin(), forward<Args>(args)...);
  }
  void push_front(const T &value) { emplace_front(value); }
  void push_front(T &&value) { emplace_front(move(value)); }
  template <detail::list_compatible_range<T> R> void prepend_range(R &&range) {
    insert_range(begin(), static_cast<R &&>(range));
  }
  void pop_front() { erase(begin()); }
  template <class... Args> reference emplace_back(Args &&...args) {
    return *emplace(end(), forward<Args>(args)...);
  }
  void push_back(const T &value) { emplace_back(value); }
  void push_back(T &&value) { emplace_back(move(value)); }
  template <detail::list_compatible_range<T> R> void append_range(R &&range) {
    insert_range(end(), static_cast<R &&>(range));
  }
  void pop_back() { erase(--end()); }
  template <class... Args> iterator emplace(const_iterator p, Args &&...args) {
    node *added = make_node(forward<Args>(args)...);
    link_before(p.current_, added);
    ++size_;
    return iterator(added);
  }
  iterator insert(const_iterator p, const T &value) {
    return emplace(p, value);
  }
  iterator insert(const_iterator p, T &&value) {
    return emplace(p, move(value));
  }
  iterator insert(const_iterator p, size_type n, const T &value) {
    if (!n)
      return iterator(p.current_);
    iterator result = emplace(p, value);
    while (--n)
      emplace(p, value);
    return result;
  }
  template <input_iterator I>
  iterator insert(const_iterator p, I first, I last) {
    if (first == last)
      return iterator(p.current_);
    iterator result = emplace(p, *first);
    while (++first != last)
      emplace(p, *first);
    return result;
  }
  template <detail::list_compatible_range<T> R>
  iterator insert_range(const_iterator p, R &&range) {
    auto first = ranges::begin(range), last = ranges::end(range);
    if (first == last)
      return iterator(p.current_);
    iterator result = emplace(p, *first);
    while (++first != last)
      emplace(p, *first);
    return result;
  }
  iterator insert(const_iterator p, initializer_list<T> values) {
    return insert(p, values.begin(), values.end());
  }
  iterator erase(const_iterator p) {
    node_base *next = p.current_->next;
    unlink(p.current_);
    destroy_node(static_cast<node *>(p.current_));
    --size_;
    return iterator(next);
  }
  iterator erase(const_iterator first, const_iterator last) {
    while (first != last)
      first = erase(first);
    return iterator(last.current_);
  }
  void swap(list &other) noexcept(traits::is_always_equal::value) {
    if constexpr (traits::propagate_on_container_swap::value)
      FTL_LIST_NAMESPACE::swap(allocator_, other.allocator_);
    swap_nodes(other);
  }
  void resize(size_type n) {
    while (size_ > n)
      pop_back();
    while (size_ < n)
      emplace_back();
  }
  void resize(size_type n, const T &value) {
    while (size_ > n)
      pop_back();
    while (size_ < n)
      emplace_back(value);
  }
  void clear() noexcept { erase(begin(), end()); }
  void splice(const_iterator p, list &other) { splice(p, move(other)); }
  void splice(const_iterator p, list &&other) {
    if (!other.empty()) {
      transfer(p.current_, other.head_.next, &other.head_);
      size_ += exchange(other.size_, 0);
    }
  }
  void splice(const_iterator p, list &other, const_iterator i) {
    splice(p, move(other), i);
  }
  void splice(const_iterator p, list &&other, const_iterator i) {
    auto last = next(i);
    if (p != i && p != last) {
      transfer(p.current_, i.current_, last.current_);
      if (this != &other) {
        ++size_;
        --other.size_;
      }
    }
  }
  void splice(const_iterator p, list &other, const_iterator first,
              const_iterator last) {
    splice(p, move(other), first, last);
  }
  void splice(const_iterator p, list &&other, const_iterator first,
              const_iterator last) {
    if (first == last)
      return;
    size_type n{};
    if (this != &other) {
      n = static_cast<size_type>(distance(first, last));
      size_ += n;
      other.size_ -= n;
    }
    transfer(p.current_, first.current_, last.current_);
  }
  size_type remove(const T &value) {
    return remove_if([&](const T &x) { return x == value; });
  }
  template <class Predicate> size_type remove_if(Predicate pred) {
    size_type count{};
    for (auto i = begin(); i != end();)
      if (pred(*i)) {
        i = erase(i);
        ++count;
      } else
        ++i;
    return count;
  }
  size_type unique() { return unique(equal_to<>{}); }
  template <class BinaryPredicate> size_type unique(BinaryPredicate pred) {
    size_type count{};
    if (empty())
      return count;
    auto first = begin(), second = next(first);
    while (second != end())
      if (pred(*first, *second)) {
        second = erase(second);
        ++count;
      } else {
        first = second++;
      }
    return count;
  }
  void merge(list &other) { merge(move(other)); }
  void merge(list &&other) { merge(move(other), less<>{}); }
  template <class Compare> void merge(list &other, Compare comp) {
    merge(move(other), move(comp));
  }
  template <class Compare> void merge(list &&other, Compare comp) {
    if (this == &other)
      return;
    auto position = begin();
    while (!other.empty()) {
      while (position != end() && !comp(other.front(), *position))
        ++position;
      auto moved = other.begin();
      splice(position, other, moved);
    }
  }
  void sort() { sort(less<>{}); }
  template <class Compare> void sort(Compare comp) {
    if (size_ < 2)
      return;
    list right(allocator_);
    auto middle = begin();
    advance(middle, static_cast<difference_type>(size_ / 2));
    right.splice(right.begin(), *this, middle, end());
    sort(comp);
    right.sort(comp);
    merge(right, comp);
  }
  void reverse() noexcept {
    node_base *p = &head_;
    do {
      FTL_LIST_NAMESPACE::swap(p->next, p->previous);
      p = p->previous;
    } while (p != &head_);
  }

private:
  void reset() noexcept {
    head_.next = head_.previous = &head_;
    size_ = 0;
  }
  template <class... Args> node *make_node(Args &&...args) {
    node_allocator a(allocator_);
    auto storage = node_traits::allocate(a, 1);
    node *result = to_address(storage);
#if FTL_HAS_EXCEPTIONS
    try {
      node_traits::construct(a, result, forward<Args>(args)...);
    } catch (...) {
      node_traits::deallocate(a, storage, 1);
      throw;
    }
#else
    node_traits::construct(a, result, forward<Args>(args)...);
#endif
    return result;
  }
  void destroy_node(node *value) noexcept {
    node_allocator a(allocator_);
    node_traits::destroy(a, value);
    node_traits::deallocate(a, typename node_traits::pointer(value), 1);
  }
  static void link_before(node_base *position, node_base *added) {
    added->next = position;
    added->previous = position->previous;
    position->previous->next = added;
    position->previous = added;
  }
  static void unlink(node_base *value) {
    value->previous->next = value->next;
    value->next->previous = value->previous;
  }
  static void transfer(node_base *position, node_base *first, node_base *last) {
    if (position == last)
      return;
    node_base *before_first = first->previous;
    node_base *before_last = last->previous;
    before_first->next = last;
    last->previous = before_first;
    first->previous = position->previous;
    position->previous->next = first;
    before_last->next = position;
    position->previous = before_last;
  }
  void steal(list &other) noexcept {
    if (other.empty())
      return;
    head_.next = other.head_.next;
    head_.previous = other.head_.previous;
    head_.next->previous = head_.previous->next = &head_;
    size_ = exchange(other.size_, 0);
    other.reset();
  }
  void swap_nodes(list &other) noexcept {
    if (this == &other)
      return;
    FTL_LIST_NAMESPACE::swap(head_.next, other.head_.next);
    FTL_LIST_NAMESPACE::swap(head_.previous, other.head_.previous);
    FTL_LIST_NAMESPACE::swap(size_, other.size_);
    fix_head();
    other.fix_head();
  }
  void fix_head() noexcept {
    if (!size_)
      reset();
    else {
      head_.next->previous = &head_;
      head_.previous->next = &head_;
    }
  }
  FTL_NO_UNIQUE_ADDRESS Allocator allocator_;
  node_base head_{};
  size_type size_{};
};

template <class I, class A = allocator<typename iterator_traits<I>::value_type>>
list(I, I, A = A()) -> list<typename iterator_traits<I>::value_type, A>;
template <ranges::input_range R, class A = allocator<ranges::range_value_t<R>>>
list(from_range_t, R &&, A = A()) -> list<ranges::range_value_t<R>, A>;
template <class T, class A>
bool operator==(const list<T, A> &x, const list<T, A> &y) {
  return x.size() == y.size() && equal(x.begin(), x.end(), y.begin());
}
template <class T, class A>
auto operator<=>(const list<T, A> &x, const list<T, A> &y) {
  return lexicographical_compare_three_way(x.begin(), x.end(), y.begin(),
                                           y.end(), detail::list_compare<T>{});
}
template <class T, class A>
void swap(list<T, A> &x, list<T, A> &y) noexcept(noexcept(x.swap(y))) {
  x.swap(y);
}
template <class T, class A, class U>
typename list<T, A>::size_type erase(list<T, A> &c, const U &value) {
  return c.remove(value);
}
template <class T, class A, class P>
typename list<T, A>::size_type erase_if(list<T, A> &c, P pred) {
  return c.remove_if(move(pred));
}
