#undef FTL_INTEGER_LIMITS

template<> struct numeric_limits<bool> {
    static constexpr bool is_specialized = true;
    static constexpr int digits = 1, digits10 = 0;
    static constexpr int max_digits10 = 0;
    static constexpr bool is_signed = false, is_integer = true, is_exact = true;
    static constexpr int radix = 2;
    static constexpr bool min() noexcept { return false; }
    static constexpr bool max() noexcept { return true; }
    static constexpr bool lowest() noexcept { return false; }
    static constexpr bool epsilon() noexcept { return false; }
    static constexpr bool round_error() noexcept { return false; }
    static constexpr int min_exponent = 0, min_exponent10 = 0;
    static constexpr int max_exponent = 0, max_exponent10 = 0;
    static constexpr bool has_infinity = false, has_quiet_NaN = false, has_signaling_NaN = false;
    static constexpr bool infinity() noexcept { return false; }
    static constexpr bool quiet_NaN() noexcept { return false; }
    static constexpr bool signaling_NaN() noexcept { return false; }
    static constexpr bool denorm_min() noexcept { return false; }
    static constexpr bool is_iec559 = false, is_bounded = true, is_modulo = false;
    static constexpr bool traps = false, tinyness_before = false;
    static constexpr float_round_style round_style = round_toward_zero;
};

#if defined(_MSC_VER) && !defined(__clang__)
namespace detail {
template<class T> struct floating_values;
template<> struct floating_values<float> {
    static constexpr float infinity() { return __builtin_bit_cast(float, 0x7f800000u); }
    static constexpr float quiet_nan() { return __builtin_bit_cast(float, 0x7fc00000u); }
    static constexpr float signaling_nan() { return __builtin_bit_cast(float, 0x7f800001u); }
};
template<> struct floating_values<double> {
    static constexpr double infinity() { return __builtin_bit_cast(double, 0x7ff0000000000000ull); }
    static constexpr double quiet_nan() { return __builtin_bit_cast(double, 0x7ff8000000000000ull); }
    static constexpr double signaling_nan() { return __builtin_bit_cast(double, 0x7ff0000000000001ull); }
};
template<> struct floating_values<long double> : floating_values<double> {};
}
#define FTL_FLOAT_INFINITY(T, IEC) detail::floating_values<T>::infinity()
#define FTL_FLOAT_QUIET_NAN(T, IEC) detail::floating_values<T>::quiet_nan()
#define FTL_FLOAT_SIGNALING_NAN(T, IEC) detail::floating_values<T>::signaling_nan()
#else
#define FTL_FLOAT_INFINITY(T, IEC) static_cast<T>(__builtin_huge_val##IEC())
#define FTL_FLOAT_QUIET_NAN(T, IEC) static_cast<T>(__builtin_nan##IEC(""))
#define FTL_FLOAT_SIGNALING_NAN(T, IEC) static_cast<T>(__builtin_nans##IEC(""))
#endif

#define FTL_FLOAT_LIMITS(T, P, IEC) template<> struct numeric_limits<T> { \
    static constexpr bool is_specialized = true; \
    static constexpr T min() noexcept { return P##_MIN__; } \
    static constexpr T max() noexcept { return P##_MAX__; } \
    static constexpr T lowest() noexcept { return -P##_MAX__; } \
    static constexpr int digits = P##_MANT_DIG__, digits10 = P##_DIG__; \
    static constexpr int max_digits10 = 2 + P##_MANT_DIG__ * 301 / 1000; \
    static constexpr bool is_signed = true, is_integer = false, is_exact = false; \
    static constexpr int radix = __FLT_RADIX__; \
    static constexpr T epsilon() noexcept { return P##_EPSILON__; } \
    static constexpr T round_error() noexcept { return static_cast<T>(0.5); } \
    static constexpr int min_exponent = P##_MIN_EXP__, min_exponent10 = P##_MIN_10_EXP__; \
    static constexpr int max_exponent = P##_MAX_EXP__, max_exponent10 = P##_MAX_10_EXP__; \
    static constexpr bool has_infinity = true, has_quiet_NaN = true, has_signaling_NaN = true; \
    static constexpr T infinity() noexcept { return FTL_FLOAT_INFINITY(T, IEC); } \
    static constexpr T quiet_NaN() noexcept { return FTL_FLOAT_QUIET_NAN(T, IEC); } \
    static constexpr T signaling_NaN() noexcept { return FTL_FLOAT_SIGNALING_NAN(T, IEC); } \
    static constexpr T denorm_min() noexcept { return P##_DENORM_MIN__; } \
    static constexpr bool is_iec559 = true, is_bounded = true, is_modulo = false; \
    static constexpr bool traps = false, tinyness_before = false; \
    static constexpr float_round_style round_style = round_to_nearest; \
}

