#ifndef FTL_CWCTYPE_HEADER
#define FTL_CWCTYPE_HEADER

#ifdef FTL_REPLACE_STL
#include <__c_wide_types.hpp>
#else
#include <ftl/__c_wide_types.hpp>
#endif

#if defined(_MSC_VER)
using ftl_native_wctype_t = unsigned short;
using ftl_native_wctrans_t = wchar_t;
#else
using ftl_native_wctype_t = unsigned long;
using ftl_native_wctrans_t = const int *;
#endif

extern "C" {
int iswalnum(unsigned int);
int iswalpha(unsigned int);
int iswblank(unsigned int);
int iswcntrl(unsigned int);
int iswdigit(unsigned int);
int iswgraph(unsigned int);
int iswlower(unsigned int);
int iswprint(unsigned int);
int iswpunct(unsigned int);
int iswspace(unsigned int);
int iswupper(unsigned int);
int iswxdigit(unsigned int);
int iswctype(unsigned int, ftl_native_wctype_t);
ftl_native_wctype_t wctype(const char *);
unsigned int towlower(unsigned int);
unsigned int towupper(unsigned int);
unsigned int towctrans(unsigned int, ftl_native_wctrans_t);
ftl_native_wctrans_t wctrans(const char *);
}

#ifdef FTL_REPLACE_STL
namespace std {
#else
namespace ftl {
#endif

using wctype_t = ftl_native_wctype_t;
using wctrans_t = ftl_native_wctrans_t;
using ::iswalnum;
using ::iswalpha;
using ::iswblank;
using ::iswcntrl;
using ::iswdigit;
using ::iswgraph;
using ::iswlower;
using ::iswprint;
using ::iswpunct;
using ::iswspace;
using ::iswupper;
using ::iswxdigit;
using ::iswctype;
using ::wctype;
using ::towlower;
using ::towupper;
using ::towctrans;
using ::wctrans;

} // namespace std or ftl

#ifndef WEOF
#ifdef FTL_REPLACE_STL
#define WEOF static_cast<std::wint_t>(-1)
#else
#define WEOF static_cast<ftl::wint_t>(-1)
#endif
#endif

#endif // FTL_CWCTYPE_HEADER
