    const Byte *key,
    FTL_RAPIDHASH_STD::size_t len,
    FTL_RAPIDHASH_STD::uint64_t seed_value) noexcept {
    return detail::hash_internal<detail::variant::full>(
        key,
        len,
        seed_value,
