template<class T>
requires (
    FTL_RAPIDHASH_STD::is_trivially_copyable_v<T> && FTL_RAPIDHASH_STD::has_unique_object_representations_v<T>)
struct rapidhash_t {
    [[nodiscard]] constexpr FTL_RAPIDHASH_STD::size_t operator()(
        const T &value) const noexcept {
        if(FTL_RAPIDHASH_STD::is_constant_evaluated()) {
            const auto bytes =
                FTL_RAPIDHASH_STD::bit_cast<
                    FTL_RAPIDHASH_STD::array<FTL_RAPIDHASH_STD::byte, sizeof(T)>>(value);

            return rapidhash(bytes.data(), bytes.size());
        }

        return rapidhash(static_cast<const void *>(FTL_RAPIDHASH_STD::addressof(value)), sizeof(value));
    }
};

struct string_hash {
    using is_avalanching = void;
    using is_transparent = void;

    [[nodiscard]] constexpr FTL_RAPIDHASH_STD::size_t operator()(
        const FTL_RAPIDHASH_STD::string_view value) const noexcept {
        return rapidhash(value);
    }
};
