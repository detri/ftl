template<class T>
concept byte_like =
    FTL_RAPIDHASH_STD::same_as<FTL_RAPIDHASH_STD::remove_cv_t<T>, char> || FTL_RAPIDHASH_STD::same_as<FTL_RAPIDHASH_STD::remove_cv_t<T>, signed char> || FTL_RAPIDHASH_STD::same_as<FTL_RAPIDHASH_STD::remove_cv_t<T>, unsigned char> || FTL_RAPIDHASH_STD::same_as<FTL_RAPIDHASH_STD::remove_cv_t<T>, FTL_RAPIDHASH_STD::byte>;

template<byte_like Byte>
[[nodiscard]] constexpr FTL_RAPIDHASH_STD::uint8_t byte_value(Byte value) noexcept {
    if constexpr(FTL_RAPIDHASH_STD::same_as<FTL_RAPIDHASH_STD::remove_cv_t<Byte>, FTL_RAPIDHASH_STD::byte>) {
        return FTL_RAPIDHASH_STD::to_integer<FTL_RAPIDHASH_STD::uint8_t>(value);
    } else {
        return static_cast<FTL_RAPIDHASH_STD::uint8_t>(value);
    }
}

struct wchar_byte_ptr {
    const wchar_t *data{};
    FTL_RAPIDHASH_STD::size_t offset{};

    [[nodiscard]]
    constexpr FTL_RAPIDHASH_STD::uint8_t operator[](
        const FTL_RAPIDHASH_STD::size_t index) const noexcept {
        using unsigned_wchar = FTL_RAPIDHASH_STD::make_unsigned_t<wchar_t>;

        const FTL_RAPIDHASH_STD::size_t byte_index = offset + index;
        const FTL_RAPIDHASH_STD::size_t char_index =
            byte_index / sizeof(wchar_t);
        const FTL_RAPIDHASH_STD::size_t char_byte =
            byte_index % sizeof(wchar_t);

        const auto value =
            static_cast<unsigned_wchar>(data[char_index]);

        return static_cast<FTL_RAPIDHASH_STD::uint8_t>(
            value >> (char_byte * 8u));
    }

    [[nodiscard]]
    constexpr wchar_byte_ptr operator+(
        const FTL_RAPIDHASH_STD::size_t amount) const noexcept {
        return {data, offset + amount};
    }

    constexpr wchar_byte_ptr &operator+=(
        const FTL_RAPIDHASH_STD::size_t amount) noexcept {
        offset += amount;
        return *this;
    }

    [[nodiscard]]
    constexpr wchar_byte_ptr operator-(
    const FTL_RAPIDHASH_STD::size_t amount) const noexcept
    {
        return {data, offset - amount};
    }

    constexpr wchar_byte_ptr& operator-=(
        const FTL_RAPIDHASH_STD::size_t amount) noexcept
    {
        offset -= amount;
        return *this;
    }
};

template<byte_like Byte>
[[nodiscard]] constexpr FTL_RAPIDHASH_STD::uint64_t read32_constexpr(
    const Byte *p) noexcept {
    return FTL_RAPIDHASH_STD::uint64_t{byte_value(p[0])} | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[1])} << 8) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[2])} << 16) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[3])} << 24);
}

template<byte_like Byte>
[[nodiscard]] constexpr FTL_RAPIDHASH_STD::uint64_t read64_constexpr(
    const Byte *p) noexcept {
    return FTL_RAPIDHASH_STD::uint64_t{byte_value(p[0])} | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[1])} << 8) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[2])} << 16) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[3])} << 24) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[4])} << 32) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[5])} << 40) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[6])} << 48) | (FTL_RAPIDHASH_STD::uint64_t{byte_value(p[7])} << 56);
}

template<byte_like Byte>
[[nodiscard]] RAPIDHASH_ALWAYS_INLINE constexpr FTL_RAPIDHASH_STD::uint64_t read32(
    const Byte *p) noexcept {
    if(FTL_RAPIDHASH_STD::is_constant_evaluated()) {
        return read32_constexpr(p);
    }

    if constexpr(FTL_RAPIDHASH_STD::endian::native == FTL_RAPIDHASH_STD::endian::little) {
        FTL_RAPIDHASH_STD::uint32_t value;
        FTL_RAPIDHASH_STD::memcpy(&value, p, sizeof(value));
        return value;
    } else {
        return read32_constexpr(p);
    }
}

template<byte_like Byte>
[[nodiscard]] RAPIDHASH_ALWAYS_INLINE constexpr FTL_RAPIDHASH_STD::uint64_t read64(
    const Byte *p) noexcept {
    if(FTL_RAPIDHASH_STD::is_constant_evaluated()) {
        return read64_constexpr(p);
    }

    if constexpr(FTL_RAPIDHASH_STD::endian::native == FTL_RAPIDHASH_STD::endian::little) {
        FTL_RAPIDHASH_STD::uint64_t value;
        FTL_RAPIDHASH_STD::memcpy(&value, p, sizeof(value));
        return value;
    } else {
        return read64_constexpr(p);
    }
}

[[nodiscard]]
RAPIDHASH_ALWAYS_INLINE constexpr FTL_RAPIDHASH_STD::uint64_t read32(
    const wchar_byte_ptr p) noexcept {
    return FTL_RAPIDHASH_STD::uint64_t{p[0]} | (FTL_RAPIDHASH_STD::uint64_t{p[1]} << 8u) | (FTL_RAPIDHASH_STD::uint64_t{p[2]} << 16u) | (FTL_RAPIDHASH_STD::uint64_t{p[3]} << 24u);
}

[[nodiscard]]
RAPIDHASH_ALWAYS_INLINE constexpr FTL_RAPIDHASH_STD::uint64_t read64(
    const wchar_byte_ptr p) noexcept {
    return FTL_RAPIDHASH_STD::uint64_t{p[0]} | (FTL_RAPIDHASH_STD::uint64_t{p[1]} << 8u) | (FTL_RAPIDHASH_STD::uint64_t{p[2]} << 16u) | (FTL_RAPIDHASH_STD::uint64_t{p[3]} << 24u) | (FTL_RAPIDHASH_STD::uint64_t{p[4]} << 32u) | (FTL_RAPIDHASH_STD::uint64_t{p[5]} << 40u) | (FTL_RAPIDHASH_STD::uint64_t{p[6]} << 48u) | (FTL_RAPIDHASH_STD::uint64_t{p[7]} << 56u);
}

struct uint128_parts {
    FTL_RAPIDHASH_STD::uint64_t low;
    FTL_RAPIDHASH_STD::uint64_t high;
};

[[nodiscard]] constexpr uint128_parts multiply_portable(
    const FTL_RAPIDHASH_STD::uint64_t lhs,
    const FTL_RAPIDHASH_STD::uint64_t rhs) noexcept {
    const FTL_RAPIDHASH_STD::uint64_t lhs_high = lhs >> 32;
    const FTL_RAPIDHASH_STD::uint64_t rhs_high = rhs >> 32;
    const FTL_RAPIDHASH_STD::uint64_t lhs_low =
        static_cast<FTL_RAPIDHASH_STD::uint32_t>(lhs);
    const FTL_RAPIDHASH_STD::uint64_t rhs_low =
        static_cast<FTL_RAPIDHASH_STD::uint32_t>(rhs);

    const FTL_RAPIDHASH_STD::uint64_t high_high = lhs_high * rhs_high;
    const FTL_RAPIDHASH_STD::uint64_t high_low = lhs_high * rhs_low;
    const FTL_RAPIDHASH_STD::uint64_t low_high = rhs_high * lhs_low;
    const FTL_RAPIDHASH_STD::uint64_t low_low = lhs_low * rhs_low;

    const FTL_RAPIDHASH_STD::uint64_t middle0 =
        low_low + (high_low << 32);

    FTL_RAPIDHASH_STD::uint64_t carry = middle0 < low_low;

    const FTL_RAPIDHASH_STD::uint64_t low =
        middle0 + (low_high << 32);

    carry += low < middle0;

    const FTL_RAPIDHASH_STD::uint64_t high =
        high_high + (high_low >> 32) + (low_high >> 32) + carry;

    return {low, high};
}

RAPIDHASH_ALWAYS_INLINE constexpr void apply_product(
    FTL_RAPIDHASH_STD::uint64_t *lhs,
    FTL_RAPIDHASH_STD::uint64_t *rhs,
    const uint128_parts product) noexcept {
#if defined(RAPIDHASH_PROTECTED)
    *lhs ^= product.low;
    *rhs ^= product.high;
#else
    *lhs = product.low;
    *rhs = product.high;
#endif
}

RAPIDHASH_ALWAYS_INLINE constexpr void mum(
    FTL_RAPIDHASH_STD::uint64_t *lhs,
    FTL_RAPIDHASH_STD::uint64_t *rhs) noexcept {
    if(FTL_RAPIDHASH_STD::is_constant_evaluated()) {
        apply_product(
            lhs,
            rhs,
            multiply_portable(*lhs, *rhs));

        return;
    }

#if defined(__SIZEOF_INT128__)
    const __uint128_t product =
        static_cast<__uint128_t>(*lhs) * static_cast<__uint128_t>(*rhs);

    apply_product(lhs, rhs, {static_cast<FTL_RAPIDHASH_STD::uint64_t>(product), static_cast<FTL_RAPIDHASH_STD::uint64_t>(product >> 64)});
#elif defined(_MSC_VER) && (defined(_WIN64) || defined(_M_HYBRID_CHPE_ARM64))
#    if defined(_M_X64)
    FTL_RAPIDHASH_STD::uint64_t high;
    const FTL_RAPIDHASH_STD::uint64_t low =
        _umul128(*lhs, *rhs, &high);

    apply_product(lhs, rhs, {low, high});
#    else
    const FTL_RAPIDHASH_STD::uint64_t low = *lhs * *rhs;
    const FTL_RAPIDHASH_STD::uint64_t high = __umulh(*lhs, *rhs);

    apply_product(lhs, rhs, {low, high});
#    endif
#else
    apply_product(
        lhs,
        rhs,
        multiply_portable(*lhs, *rhs));
#endif
}

[[nodiscard]] RAPIDHASH_ALWAYS_INLINE constexpr FTL_RAPIDHASH_STD::uint64_t mix(
    FTL_RAPIDHASH_STD::uint64_t lhs,
    FTL_RAPIDHASH_STD::uint64_t rhs) noexcept {
    mum(&lhs, &rhs);
    return lhs ^ rhs;
}

enum class variant {
    full,
    micro,
    nano
};

template<variant Variant, class Pointer>
[[nodiscard]] constexpr FTL_RAPIDHASH_STD::uint64_t hash_internal(
    Pointer p,
    FTL_RAPIDHASH_STD::size_t len,
    FTL_RAPIDHASH_STD::uint64_t seed_value,
    const FTL_RAPIDHASH_STD::uint64_t *secret_value) noexcept {
    seed_value ^=
        mix(seed_value ^ secret_value[2], secret_value[1]);

    FTL_RAPIDHASH_STD::uint64_t a = 0;
    FTL_RAPIDHASH_STD::uint64_t b = 0;
    FTL_RAPIDHASH_STD::size_t i = len;

    if(len <= 16) {
        if(len >= 4) {
            seed_value ^= len;

            if(len >= 8) {
                a = read64(p);
                b = read64(p + len - 8);
            } else {
                a = read32(p);
                b = read32(p + len - 4);
            }
        } else if(len > 0) {
            a =
                (static_cast<FTL_RAPIDHASH_STD::uint64_t>(
                     byte_value(p[0]))
                 << 45)
                | byte_value(p[len - 1]);

            b = byte_value(p[len >> 1]);
        }
    } else {
        if constexpr(Variant == variant::full) {
            if(len > 112) {
                FTL_RAPIDHASH_STD::uint64_t see1 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see2 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see3 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see4 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see5 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see6 = seed_value;

#if defined(RAPIDHASH_COMPACT)
                do {
                    seed_value = mix(
                        read64(p) ^ secret_value[0],
                        read64(p + 8) ^ seed_value);

                    see1 = mix(
                        read64(p + 16) ^ secret_value[1],
                        read64(p + 24) ^ see1);

                    see2 = mix(
                        read64(p + 32) ^ secret_value[2],
                        read64(p + 40) ^ see2);

                    see3 = mix(
                        read64(p + 48) ^ secret_value[3],
                        read64(p + 56) ^ see3);

                    see4 = mix(
                        read64(p + 64) ^ secret_value[4],
                        read64(p + 72) ^ see4);

                    see5 = mix(
                        read64(p + 80) ^ secret_value[5],
                        read64(p + 88) ^ see5);

                    see6 = mix(
                        read64(p + 96) ^ secret_value[6],
                        read64(p + 104) ^ see6);

                    p += 112;
                    i -= 112;
                } while(i > 112);
#else
                while(i > 224) {
                    seed_value = mix(
                        read64(p) ^ secret_value[0],
                        read64(p + 8) ^ seed_value);

                    see1 = mix(
                        read64(p + 16) ^ secret_value[1],
                        read64(p + 24) ^ see1);

                    see2 = mix(
                        read64(p + 32) ^ secret_value[2],
                        read64(p + 40) ^ see2);

                    see3 = mix(
                        read64(p + 48) ^ secret_value[3],
                        read64(p + 56) ^ see3);

                    see4 = mix(
                        read64(p + 64) ^ secret_value[4],
                        read64(p + 72) ^ see4);

                    see5 = mix(
                        read64(p + 80) ^ secret_value[5],
                        read64(p + 88) ^ see5);

                    see6 = mix(
                        read64(p + 96) ^ secret_value[6],
                        read64(p + 104) ^ see6);

                    seed_value = mix(
                        read64(p + 112) ^ secret_value[0],
                        read64(p + 120) ^ seed_value);

                    see1 = mix(
                        read64(p + 128) ^ secret_value[1],
                        read64(p + 136) ^ see1);

                    see2 = mix(
                        read64(p + 144) ^ secret_value[2],
                        read64(p + 152) ^ see2);

                    see3 = mix(
                        read64(p + 160) ^ secret_value[3],
                        read64(p + 168) ^ see3);

                    see4 = mix(
                        read64(p + 176) ^ secret_value[4],
                        read64(p + 184) ^ see4);

                    see5 = mix(
                        read64(p + 192) ^ secret_value[5],
                        read64(p + 200) ^ see5);

                    see6 = mix(
                        read64(p + 208) ^ secret_value[6],
                        read64(p + 216) ^ see6);

                    p += 224;
                    i -= 224;
                }

                if(i > 112) {
                    seed_value = mix(
                        read64(p) ^ secret_value[0],
                        read64(p + 8) ^ seed_value);

                    see1 = mix(
                        read64(p + 16) ^ secret_value[1],
                        read64(p + 24) ^ see1);

                    see2 = mix(
                        read64(p + 32) ^ secret_value[2],
                        read64(p + 40) ^ see2);

                    see3 = mix(
                        read64(p + 48) ^ secret_value[3],
                        read64(p + 56) ^ see3);

                    see4 = mix(
                        read64(p + 64) ^ secret_value[4],
                        read64(p + 72) ^ see4);

                    see5 = mix(
                        read64(p + 80) ^ secret_value[5],
                        read64(p + 88) ^ see5);

                    see6 = mix(
                        read64(p + 96) ^ secret_value[6],
                        read64(p + 104) ^ see6);

                    p += 112;
                    i -= 112;
                }
#endif

                seed_value ^= see1;
                see2 ^= see3;
                see4 ^= see5;
                seed_value ^= see6;
                see2 ^= see4;
                seed_value ^= see2;
            }
        } else if constexpr(Variant == variant::micro) {
            if(i > 80) {
                FTL_RAPIDHASH_STD::uint64_t see1 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see2 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see3 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see4 = seed_value;

                do {
                    seed_value = mix(
                        read64(p) ^ secret_value[0],
                        read64(p + 8) ^ seed_value);

                    see1 = mix(
                        read64(p + 16) ^ secret_value[1],
                        read64(p + 24) ^ see1);

                    see2 = mix(
                        read64(p + 32) ^ secret_value[2],
                        read64(p + 40) ^ see2);

                    see3 = mix(
                        read64(p + 48) ^ secret_value[3],
                        read64(p + 56) ^ see3);

                    see4 = mix(
                        read64(p + 64) ^ secret_value[4],
                        read64(p + 72) ^ see4);

                    p += 80;
                    i -= 80;
                } while(i > 80);

                seed_value ^= see1;
                see2 ^= see3;
                seed_value ^= see4;
                seed_value ^= see2;
            }
        } else {
            if(i > 48) {
                FTL_RAPIDHASH_STD::uint64_t see1 = seed_value;
                FTL_RAPIDHASH_STD::uint64_t see2 = seed_value;

                do {
                    seed_value = mix(
                        read64(p) ^ secret_value[0],
                        read64(p + 8) ^ seed_value);

                    see1 = mix(
                        read64(p + 16) ^ secret_value[1],
                        read64(p + 24) ^ see1);

                    see2 = mix(
                        read64(p + 32) ^ secret_value[2],
                        read64(p + 40) ^ see2);

                    p += 48;
                    i -= 48;
                } while(i > 48);

                seed_value ^= see1;
                seed_value ^= see2;
            }
        }

        if(i > 16) {
            seed_value = mix(
                read64(p) ^ secret_value[2],
                read64(p + 8) ^ seed_value);

            if(i > 32) {
                seed_value = mix(
                    read64(p + 16) ^ secret_value[2],
                    read64(p + 24) ^ seed_value);

                if constexpr(Variant != variant::nano) {
                    if(i > 48) {
                        seed_value = mix(
                            read64(p + 32) ^ secret_value[1],
                            read64(p + 40) ^ seed_value);

                        if(i > 64) {
                            seed_value = mix(
                                read64(p + 48) ^ secret_value[1],
                                read64(p + 56) ^ seed_value);
                        }
                    }
                }

                if constexpr(Variant == variant::full) {
                    if(i > 80) {
                        seed_value = mix(
                            read64(p + 64) ^ secret_value[2],
                            read64(p + 72) ^ seed_value);

                        if(i > 96) {
                            seed_value = mix(
                                read64(p + 80) ^ secret_value[1],
                                read64(p + 88) ^ seed_value);
                        }
                    }
                }
            }
        }

        a = read64(p + i - 16) ^ i;
        b = read64(p + i - 8);
    }

    a ^= secret_value[1];
    b ^= seed_value;

    mum(&a, &b);

    return mix(
        a ^ secret_value[7],
        b ^ secret_value[1] ^ i);
}
