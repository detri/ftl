using size_type = decltype(sizeof(0));

struct decode_result {
  unsigned long scalar = 0;
  size_type units = 0;
  bool valid = false;
};

template <class Character>
[[nodiscard]]
constexpr unsigned long code_unit_value(Character value) noexcept {
  using unsigned_type = FTL_UNICODE_FORMAT_NS::make_unsigned_t<Character>;

  return static_cast<unsigned long>(static_cast<unsigned_type>(value));
}

[[nodiscard]]
constexpr bool is_continuation_byte(unsigned long value) noexcept {
  return value >= 0x80u && value <= 0xbfu;
}

template <class charT, class Iterator>
[[nodiscard]]
constexpr decode_result decode(Iterator first, Iterator last) noexcept {
  if (first == last)
    return {};

  if constexpr (FTL_UNICODE_FORMAT_NS::is_same_v<charT, char>) {
    auto current = first;

    const unsigned long first_byte = code_unit_value(*current++);

    if (first_byte <= 0x7fu)
      return {first_byte, 1, true};

    unsigned length = 0;

    if (first_byte >= 0xc2u && first_byte <= 0xdfu) {
      length = 2;
    } else if (first_byte >= 0xe0u && first_byte <= 0xefu) {
      length = 3;
    } else if (first_byte >= 0xf0u && first_byte <= 0xf4u) {
      length = 4;
    } else {
      return {0, 1, false};
    }

    unsigned long bytes[4]{first_byte, 0, 0, 0};

    for (unsigned index = 1; index < length; ++index) {
      if (current == last)
        return {0, 1, false};

      bytes[index] = code_unit_value(*current++);

      if (!is_continuation_byte(bytes[index])) {
        return {0, 1, false};
      }
    }

    if (length == 3) {
      if (first_byte == 0xe0u && bytes[1] < 0xa0u) {
        return {0, 1, false};
      }

      if (first_byte == 0xedu && bytes[1] > 0x9fu) {
        return {0, 1, false};
      }
    }

    if (length == 4) {
      if (first_byte == 0xf0u && bytes[1] < 0x90u) {
        return {0, 1, false};
      }

      if (first_byte == 0xf4u && bytes[1] > 0x8fu) {
        return {0, 1, false};
      }
    }

    unsigned long scalar = 0;

    if (length == 2) {
      scalar = ((bytes[0] & 0x1fu) << 6) | (bytes[1] & 0x3fu);
    } else if (length == 3) {
      scalar = ((bytes[0] & 0x0fu) << 12) | ((bytes[1] & 0x3fu) << 6) |
               (bytes[2] & 0x3fu);
    } else {
      scalar = ((bytes[0] & 0x07u) << 18) | ((bytes[1] & 0x3fu) << 12) |
               ((bytes[2] & 0x3fu) << 6) | (bytes[3] & 0x3fu);
    }

    return {scalar, static_cast<size_type>(length), true};
  } else if constexpr (sizeof(charT) == 2) {
    const unsigned long first_unit = code_unit_value(*first);

    if (first_unit >= 0xd800u && first_unit <= 0xdbffu) {
      auto current = first;
      ++current;

      if (current == last)
        return {0, 1, false};

      const unsigned long second_unit = code_unit_value(*current);

      if (second_unit < 0xdc00u || second_unit > 0xdfffu) {
        return {0, 1, false};
      }

      const unsigned long scalar =
          0x10000u + ((first_unit - 0xd800u) << 10) + (second_unit - 0xdc00u);

      return {scalar, 2, true};
    }

    if (first_unit >= 0xdc00u && first_unit <= 0xdfffu) {
      return {0, 1, false};
    }

    return {first_unit, 1, true};
  } else {
    const unsigned long scalar = code_unit_value(*first);

    if (scalar > 0x10ffffu || (scalar >= 0xd800u && scalar <= 0xdfffu)) {
      return {0, 1, false};
    }

    return {scalar, 1, true};
  }
}

struct codepoint_range {
  unsigned long first = 0;
  unsigned long last = 0;
};

[[nodiscard]]
consteval unsigned hex_digit(char value) {
  if (value >= '0' && value <= '9') {
    return static_cast<unsigned>(value - '0');
  }

  if (value >= 'a' && value <= 'f') {
    return static_cast<unsigned>(value - 'a' + 10);
  }

  return static_cast<unsigned>(value - 'A' + 10);
}

[[nodiscard]]
consteval unsigned encoded_byte(const char *&current) {
  const unsigned high = hex_digit(*current++);

  const unsigned low = hex_digit(*current++);

  return (high << 4) | low;
}

[[nodiscard]]
consteval unsigned long encoded_integer(const char *&current) {
  unsigned long result = 0;
  unsigned shift = 0;

  for (;;) {
    const unsigned byte = encoded_byte(current);

    result |= static_cast<unsigned long>(byte & 0x7fu) << shift;

    if ((byte & 0x80u) == 0)
      return result;

    shift += 7;
  }
}

template <size_type RangeCount, size_type EncodedSize>
[[nodiscard]]
consteval auto decode_ranges(const char (&encoded)[EncodedSize]) {
  FTL_UNICODE_FORMAT_NS::array<codepoint_range, RangeCount> result{};

  const char *current = encoded;

  unsigned long previous = 0;

  for (size_type index = 0; index < RangeCount; ++index) {
    const unsigned long delta = encoded_integer(current);

    const unsigned long span = encoded_integer(current);

    const unsigned long first = previous + delta;

    const unsigned long last = first + span;

    result[index] = {first, last};

    previous = last + 1;
  }

  return result;
}

template <size_type N>
[[nodiscard]]
constexpr bool
range_contains(const FTL_UNICODE_FORMAT_NS::array<codepoint_range, N> &ranges,
               unsigned long scalar) noexcept {
  size_type first = 0;
  size_type last = N;

  while (first != last) {
    const size_type middle = first + (last - first) / 2;

    if (scalar < ranges[middle].first) {
      last = middle;
    } else if (scalar > ranges[middle].last) {
      first = middle + 1;
    } else {
      return true;
    }
  }

  return false;
}

