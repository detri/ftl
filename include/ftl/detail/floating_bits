          1023> {};

#endif

#ifdef __STDCPP_FLOAT128_T__

template <>
struct floating_format_traits<decltype(0.0f128)> {
  using float_type = decltype(0.0f128);
  using storage_type = floating_bits_detail::binary128_storage;

  static constexpr int fraction_bits = 112;
  static constexpr int exponent_bits = 15;
  static constexpr int exponent_bias = 16383;
  static constexpr int significand_bits = 113;
  static constexpr int total_bits = 128;

  static constexpr int exponent_field_max = (1 << exponent_bits) - 1;

  static constexpr int minimum_significand_exponent =
      1 - exponent_bias - fraction_bits;

  static constexpr int maximum_significand_exponent =
      exponent_field_max - 1 - exponent_bias - fraction_bits;
};

#endif

