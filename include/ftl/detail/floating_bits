#include <bit>
#include <cstdint>
#define FTL_FLOATING_BITS_STD std
#else
#include <ftl/bit>
#include <ftl/cstdint>
#define FTL_FLOATING_BITS_STD ftl
#endif

#if defined(_MSC_VER) && !defined(__clang__)

#define FTL_LONG_DOUBLE_BINARY64 1

#elif defined(__LDBL_MANT_DIG__) && defined(__LDBL_MAX_EXP__) &&               \
    __LDBL_MANT_DIG__ == 53 && __LDBL_MAX_EXP__ == 1024

#define FTL_LONG_DOUBLE_BINARY64 1

#elif defined(__LDBL_MANT_DIG__) && defined(__LDBL_MAX_EXP__) &&               \
    __LDBL_MANT_DIG__ == 64 && __LDBL_MAX_EXP__ == 16384

#define FTL_LONG_DOUBLE_X87 1

#elif defined(__LDBL_MANT_DIG__) && defined(__LDBL_MAX_EXP__) &&               \
    __LDBL_MANT_DIG__ == 113 && __LDBL_MAX_EXP__ == 16384

#define FTL_LONG_DOUBLE_BINARY128 1

#else

#error "FTL floating conversion does not recognize this long double format"

#endif

namespace ftl_float_conversion {

enum class floating_kind { zero, finite, infinity, nan };
enum class long_double_format { binary64, x87_extended80, binary128 };

struct uint128 {
  FTL_FLOATING_BITS_STD::uint64_t low = 0;
  FTL_FLOATING_BITS_STD::uint64_t high = 0;

  [[nodiscard]]
  constexpr bool is_zero() const noexcept {
    return low == 0 && high == 0;
  }

  friend constexpr bool operator==(const uint128 &,
                                   const uint128 &) noexcept = default;
};

/*
 * For finite values:
 *
 *   value = (-1)^negative * significand * 2^exponent
 *
 * The significand is kept in the canonical precision of
 * the source floating-point format rather than reduced by
 * removing trailing zero bits.
 *
 * For NaNs, significand stores the raw fraction/payload bits
 * so decomposition followed by composition preserves the
 * representation.
 */
template <class Float> struct binary_parts {
  floating_kind kind = floating_kind::zero;
  bool negative = false;
  uint128 significand{};
  int exponent = 0;
};

namespace floating_bits_detail {

template <class Float, class Storage, int FractionBits, int ExponentBits,
          int ExponentBias>
struct ieee_binary_format {
  using float_type = Float;
  using storage_type = Storage;

  static constexpr int fraction_bits = FractionBits;
  static constexpr int exponent_bits = ExponentBits;
  static constexpr int exponent_bias = ExponentBias;

  static constexpr int significand_bits = fraction_bits + 1;

  static constexpr int total_bits = 1 + exponent_bits + fraction_bits;

  static constexpr storage_type hidden_bit = storage_type{1} << fraction_bits;

  static constexpr storage_type fraction_mask = hidden_bit - storage_type{1};

  static constexpr storage_type exponent_field_max =
      (storage_type{1} << exponent_bits) - storage_type{1};

  static constexpr storage_type exponent_mask = exponent_field_max
                                                << fraction_bits;

  static constexpr storage_type sign_mask = storage_type{1}
                                            << (fraction_bits + exponent_bits);

  /*
   * The exponent paired with the canonical integer
   * significand.
   *
   * For the smallest normal binary32 value:
   *
   *   0x800000 * 2^-149 == 2^-126
   *
   * Subnormals use the same exponent with a smaller
   * significand.
   */
  static constexpr int minimum_significand_exponent =
      1 - exponent_bias - fraction_bits;

  static constexpr int maximum_significand_exponent =
      static_cast<int>(exponent_field_max) - 1 - exponent_bias - fraction_bits;
};

#if defined(FTL_LONG_DOUBLE_X87)

static_assert(
    FTL_FLOATING_BITS_STD::endian::native ==
        FTL_FLOATING_BITS_STD::endian::little,
    "FTL currently supports x87 long double only on little-endian targets");

struct x87_storage {
  FTL_FLOATING_BITS_STD::uint64_t significand;
  FTL_FLOATING_BITS_STD::uint16_t sign_exponent;
  unsigned char padding[sizeof(long double) - 10];
};

static_assert(sizeof(x87_storage) == sizeof(long double));

#endif

#if defined(FTL_LONG_DOUBLE_BINARY128) || defined(__STDCPP_FLOAT128_T__)

struct binary128_storage {
  FTL_FLOATING_BITS_STD::uint64_t first;
  FTL_FLOATING_BITS_STD::uint64_t second;
};

static_assert(sizeof(binary128_storage) == 16);

#if defined(FTL_LONG_DOUBLE_BINARY128)
static_assert(sizeof(binary128_storage) == sizeof(long double));
#endif

#if defined(__STDCPP_FLOAT128_T__)
static_assert(sizeof(binary128_storage) == sizeof(decltype(0.0f128)));
#endif

[[nodiscard]]
constexpr FTL_FLOATING_BITS_STD::uint64_t
binary128_low(binary128_storage value) noexcept {
  if constexpr (FTL_FLOATING_BITS_STD::endian::native ==
                FTL_FLOATING_BITS_STD::endian::little) {
    return value.first;
  } else {
    return value.second;
  }
}

[[nodiscard]]
constexpr FTL_FLOATING_BITS_STD::uint64_t
binary128_high(binary128_storage value) noexcept {
  if constexpr (FTL_FLOATING_BITS_STD::endian::native ==
                FTL_FLOATING_BITS_STD::endian::little) {
    return value.second;
  } else {
    return value.first;
  }
}

[[nodiscard]]
constexpr binary128_storage
make_binary128_storage(FTL_FLOATING_BITS_STD::uint64_t low,
                       FTL_FLOATING_BITS_STD::uint64_t high) noexcept {
  if constexpr (FTL_FLOATING_BITS_STD::endian::native ==
                FTL_FLOATING_BITS_STD::endian::little) {
    return {low, high};
  } else {
    return {high, low};
  }
}

#endif

} // namespace floating_bits_detail

template <class Float> struct floating_format_traits;

template <>
struct floating_format_traits<float>
    : floating_bits_detail::ieee_binary_format<
          float, FTL_FLOATING_BITS_STD::uint32_t, 23, 8, 127> {};

template <>
struct floating_format_traits<double>
    : floating_bits_detail::ieee_binary_format<
          double, FTL_FLOATING_BITS_STD::uint64_t, 52, 11, 1023> {};

#ifdef __STDCPP_FLOAT16_T__

template <>
struct floating_format_traits<decltype(0.0f16)>
    : floating_bits_detail::ieee_binary_format<
          decltype(0.0f16),
          FTL_FLOATING_BITS_STD::uint16_t,
          10,
          5,
          15> {};

#endif

#ifdef __STDCPP_FLOAT32_T__

template <>
struct floating_format_traits<decltype(0.0f32)>
    : floating_bits_detail::ieee_binary_format<
          decltype(0.0f32),
          FTL_FLOATING_BITS_STD::uint32_t,
          23,
          8,
          127> {};

#endif

