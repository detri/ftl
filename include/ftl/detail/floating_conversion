namespace ftl_float_conversion {

enum class conversion_status {
  success,
  overflow,
  underflow,
  capacity_exceeded
};

template <class Float> struct conversion_result {
  Float value{};
  conversion_status status = conversion_status::success;
};

/*
 * Represents exactly:
 *
 *   (-1)^negative *
 *   significand *
 *   10^exponent
 *
 * The scanner will eventually produce this type.
 */
template <decltype(sizeof(0)) Limbs> struct decimal_number {
  using integer_type = big_uint<Limbs>;
  using limb_type = typename integer_type::limb_type;

  bool negative = false;
  integer_type significand{};
  int exponent = 0;

  /*
   * True when decimal digits beyond the retained
   * significand contained at least one nonzero digit.
   *
   * Numerically, the real magnitude is then strictly
   * greater than:
   *
   *   significand * 10^exponent
   *
   * but smaller than the next retained decimal unit.
   */
  bool discarded_nonzero = false;

  constexpr decimal_number() noexcept = default;

  constexpr decimal_number(limb_type value, int decimal_exponent,
                           bool is_negative = false,
                           bool has_discarded_nonzero = false) noexcept
      : negative(is_negative), significand(value), exponent(decimal_exponent),
        discarded_nonzero(has_discarded_nonzero) {}

  constexpr decimal_number(const integer_type &value, int decimal_exponent,
                           bool is_negative = false,
                           bool has_discarded_nonzero = false) noexcept
      : negative(is_negative), significand(value), exponent(decimal_exponent),
        discarded_nonzero(has_discarded_nonzero) {}
};

struct hexadecimal_number {
  bool negative = false;

  /*
   * Represents the retained magnitude exactly as:
   *
   *   significand * 2^exponent
   *
   * Up to 128 significant bits are retained, enough
   * for binary128's 113-bit precision plus rounding
   * information.
   */
  uint128 significand{};

  int exponent = 0;

  bool discarded_nonzero = false;
};

