template <class Float, decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr conversion_result<Float>
decimal_to_binary(const decimal_number<Limbs> &number) noexcept {
  using format = floating_format_traits<Float>;

  using integer_type = big_uint<Limbs>;

  static_assert(floating_conversion_detail::decimal_binary_supported<Float>);

  constexpr int precision = format::significand_bits;

  constexpr long long minimum_significand_exponent =
      format::minimum_significand_exponent;

  constexpr long long maximum_significand_exponent =
      format::maximum_significand_exponent;

  constexpr long long minimum_normal_value_exponent =
      minimum_significand_exponent + precision - 1;

  constexpr long long maximum_value_exponent =
      maximum_significand_exponent + precision - 1;

  if (number.significand.is_zero()) {
    binary_parts<Float> parts{floating_kind::zero, number.negative, {}, 0};

    return {compose(parts), conversion_status::success};
  }

  integer_type numerator = number.significand;

  integer_type denominator(1);

  /*
   * Convert:
   *
   *   S * 10^e
   *
   * into:
   *
   *   N / D * 2^q
   *
   * using 10^e = 5^e * 2^e.
   */
  const long long decimal_exponent = number.exponent;

  const unsigned long long power_of_five_exponent =
      decimal_exponent < 0 ? static_cast<unsigned long long>(-decimal_exponent)
                           : static_cast<unsigned long long>(decimal_exponent);

  /*
   * 5^n > 2^(2n), so beyond this point the
   * required power cannot fit this working
   * bigint at all.
   *
   * Before reporting capacity failure, classify
   * obvious format overflow/underflow cases.
   */
  if (decimal_exponent > 0) {
    const long long lower_binary_bound =
        static_cast<long long>(numerator.bit_width()) - 1 +
        decimal_exponent * 3;

    if (lower_binary_bound > maximum_value_exponent) {
      return {{}, conversion_status::overflow};
    }
  } else if (decimal_exponent < 0) {
    const long long magnitude = -decimal_exponent;

    const long long upper_binary_bound =
        static_cast<long long>(numerator.bit_width()) - magnitude * 3;

    if (upper_binary_bound <= minimum_significand_exponent - 1) {
      return {{}, conversion_status::underflow};
    }
  }

  if (power_of_five_exponent > integer_type::bit_capacity / 2) {
    return {{}, conversion_status::capacity_exceeded};
  }

  if (decimal_exponent >= 0) {
    if (!numerator.multiply_pow5(
            static_cast<unsigned>(power_of_five_exponent))) {
      return {{}, conversion_status::capacity_exceeded};
    }
  } else {
    if (!denominator.multiply_pow5(
            static_cast<unsigned>(power_of_five_exponent))) {
      return {{}, conversion_status::capacity_exceeded};
    }
  }

  const long long binary_factor = decimal_exponent;

  const long long ratio_exponent =
      floating_conversion_detail::floor_log2_ratio(numerator, denominator);

  const long long value_exponent = ratio_exponent + binary_factor;

  /*
   * Above the largest finite binade means there
   * is no possible finite result.
   *
   * Values in the largest binade are allowed to
   * proceed because rounding may still either
   * produce max() or overflow.
   */
  if (value_exponent > maximum_value_exponent) {
    return {{}, conversion_status::overflow};
  }

  /*
   * Anything strictly below half of the minimum
   * subnormal necessarily rounds to zero.
   *
   * The exact halfway binade is retained so ties
   * can be resolved correctly below.
   */
  if (value_exponent < minimum_significand_exponent - 1) {
    return {{}, conversion_status::underflow};
  }

  long long target_exponent;

  if (value_exponent >= minimum_normal_value_exponent) {
    target_exponent = value_exponent - (precision - 1);
  } else {
    /*
     * Subnormals all use the same canonical
     * significand exponent.
     */
    target_exponent = minimum_significand_exponent;
  }

  const long long quotient_shift = binary_factor - target_exponent;

  const auto rounded =
      floating_conversion_detail::rounded_scaled_quotient<precision>(
          numerator, denominator, quotient_shift, number.discarded_nonzero);

  if (!rounded.success) {
    return {{}, conversion_status::capacity_exceeded};
  }

  uint128 significand = rounded.value;

  if (significand.is_zero()) {
    return {{}, conversion_status::underflow};
  }

  const uint128 carry_limit =
      floating_conversion_detail::uint128_bit(static_cast<unsigned>(precision));

  /*
   * Rounding 1.111... upward can produce
   * 10.000..., which renormalizes by one bit.
   */
  if (significand == carry_limit) {
    significand = floating_conversion_detail::shift_right_one(significand);

    ++target_exponent;

    if (target_exponent > maximum_significand_exponent) {
      return {{}, conversion_status::overflow};
    }
  }

  binary_parts<Float> parts{floating_kind::finite, number.negative, significand,
                            static_cast<int>(target_exponent)};

  return {compose(parts), conversion_status::success};
}

template <class Float>
[[nodiscard]]
constexpr conversion_result<Float>
hexadecimal_to_binary(const hexadecimal_number &number) noexcept {
  using format = floating_format_traits<Float>;

  static_assert(floating_conversion_detail::decimal_binary_supported<Float>);

  constexpr int precision = format::significand_bits;

  static_assert(precision <= 113);

  constexpr long long minimum_significand_exponent =
      format::minimum_significand_exponent;

  constexpr long long maximum_significand_exponent =
      format::maximum_significand_exponent;

  constexpr long long minimum_normal_value_exponent =
      minimum_significand_exponent + precision - 1;

  constexpr long long maximum_value_exponent =
      maximum_significand_exponent + precision - 1;

  if (number.significand.is_zero()) {
    binary_parts<Float> parts{floating_kind::zero, number.negative, {}, 0};

    return {compose(parts), conversion_status::success};
  }

  const unsigned source_width =
      floating_conversion_detail::bit_width_uint128(number.significand);

  const long long value_exponent = static_cast<long long>(number.exponent) +
                                   static_cast<long long>(source_width) - 1;

  if (value_exponent > maximum_value_exponent) {
    return {{}, conversion_status::overflow};
  }

  if (value_exponent < minimum_significand_exponent - 1) {
    return {{}, conversion_status::underflow};
  }

  long long target_exponent;

  if (value_exponent >= minimum_normal_value_exponent) {
    target_exponent = value_exponent - (precision - 1);
  } else {
    target_exponent = minimum_significand_exponent;
  }

  const long long right_shift =
      target_exponent - static_cast<long long>(number.exponent);

  uint128 significand{};

  if (right_shift > 0) {
    significand = floating_conversion_detail::round_shift_right(
        number.significand, static_cast<unsigned long long>(right_shift),
        number.discarded_nonzero);
  } else {
    /*
     * Sticky input has already filled all 128
     * retained bits. Since every supported target
     * has <=113 bits of precision, such a value
     * necessarily takes the right-shift path.
     */
    if (number.discarded_nonzero) {
      return {{}, conversion_status::capacity_exceeded};
    }

    const unsigned long long left_shift =
        static_cast<unsigned long long>(-right_shift);

    if (left_shift >= 128 ||
        static_cast<unsigned long long>(source_width) + left_shift >
            static_cast<unsigned long long>(precision)) {
      return {{}, conversion_status::capacity_exceeded};
    }

    significand = floating_conversion_detail::shift_left_uint128(
        number.significand, left_shift);
  }

  if (significand.is_zero()) {
    return {{}, conversion_status::underflow};
  }

  const uint128 carry_limit =
      floating_conversion_detail::uint128_bit(static_cast<unsigned>(precision));

  if (significand == carry_limit) {
    significand = floating_conversion_detail::shift_right_one(significand);

    ++target_exponent;

    if (target_exponent > maximum_significand_exponent) {
      return {{}, conversion_status::overflow};
    }
  }

  binary_parts<Float> parts{floating_kind::finite, number.negative, significand,
                            static_cast<int>(target_exponent)};

  return {compose(parts), conversion_status::success};
}

template <class Float>
[[nodiscard]]
constexpr floating_special_scan_result<Float>
scan_floating_special(const char *first, const char *last) noexcept {
  using format = floating_format_traits<Float>;

  static_assert(floating_conversion_detail::decimal_binary_supported<Float>);

  floating_special_scan_result<Float> result{};
  result.ptr = first;

  const char *current = first;

  bool negative = false;

  if (current != last && *current == '-') {
    negative = true;
    ++current;
  } else if (current != last && *current == '+') {
    /*
     * from_chars permits '+' only in an exponent,
     * never as the leading sign.
     */
    return result;
  }

  /*
   * INF / INFINITY, case-insensitive.
   *
   * If the complete "inity" suffix is not present,
   * the shorter valid spelling "inf" still matches.
   */
  if (floating_conversion_detail::matches_ascii_case_insensitive(current, last,
                                                                 "inf", 3)) {
    current += 3;

    if (floating_conversion_detail::matches_ascii_case_insensitive(
            current, last, "inity", 5)) {
      current += 5;
    }

    binary_parts<Float> parts{floating_kind::infinity, negative, {}, 0};

    result.ptr = current;
    result.value = compose(parts);

    result.status = floating_special_scan_status::success;

    return result;
  }

  /*
   * NAN / NAN(n-char-sequence), case-insensitive
   * in the "nan" portion.
   *
   * The payload syntax is accepted but its
   * interpretation is implementation-defined.
   * FTL currently canonicalizes every accepted
   * payload to one quiet NaN representation.
   */
  if (floating_conversion_detail::matches_ascii_case_insensitive(current, last,
                                                                 "nan", 3)) {
    current += 3;

    const char *suffix_begin = current;

    if (current != last && *current == '(') {
      const char *payload = current + 1;

      while (payload != last &&
             floating_conversion_detail::nan_sequence_character(*payload)) {
        ++payload;
      }

      /*
       * The optional parenthesized suffix only
       * participates if it is complete.
       *
       * nan()
       * nan(foo)
       * nan(payload_123)
       *
       * are accepted, while:
       *
       * nan(foo
       * nan(foo!)
       *
       * simply match the shorter "nan" form.
       */
      if (payload != last && *payload == ')') {
        current = payload + 1;
      } else {
        current = suffix_begin;
      }
    }

    /*
     * Manufacture a canonical quiet NaN.
     *
     * For IEEE binary32/binary64 the most
     * significant fraction bit is the quiet bit.
     */
    const uint128 quiet_bit = floating_conversion_detail::uint128_bit(
        static_cast<unsigned>(format::fraction_bits - 1));

    binary_parts<Float> parts{floating_kind::nan, negative, quiet_bit, 0};

    result.ptr = current;
    result.value = compose(parts);

    result.status = floating_special_scan_status::success;

    return result;
  }

  return result;
}

template <class Float>
[[nodiscard]]
constexpr decimal_scan_result<Float>
scan_decimal(const char *first, const char *last,
             decimal_exponent_mode exponent_mode =
                 decimal_exponent_mode::optional) noexcept {
  using traits = floating_conversion_detail::decimal_scan_traits<Float>;

  using result_type = decimal_scan_result<Float>;

  using number_type = typename result_type::number_type;

  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  static_assert(floating_conversion_detail::decimal_binary_supported<Float>);

  result_type result{};
  result.ptr = first;

  const char *current = first;

  bool negative = false;

  if (current != last && *current == '-') {
    negative = true;
    ++current;
  } else if (current != last && *current == '+') {
    /*
     * Leading '+' is never accepted by floating
     * from_chars.
     */
    return result;
  }

  number_type number{};
  number.negative = negative;

  bool have_digit = false;
  bool have_nonzero = false;
  bool after_point = false;

  decltype(sizeof(0)) retained_digits = 0;

  uint64_t positive_adjustment = 0;
  uint64_t negative_adjustment = 0;

  bool count_overflow = false;

  const auto increment_count = [&](uint64_t &value) constexpr {
    if (value == static_cast<uint64_t>(-1)) {
      count_overflow = true;
    } else {
      ++value;
    }
  };

  while (current != last) {
    const char character = *current;

    if (character >= '0' && character <= '9') {
      have_digit = true;

      const unsigned digit = static_cast<unsigned>(character - '0');

      bool discarded = false;

      /*
       * Leading zeroes do not consume significant
       * digit storage, but they still matter to
       * decimal-point positioning.
       */
      if (have_nonzero || digit != 0) {
        have_nonzero = true;

        if (retained_digits < traits::max_significant_digits) {
          if (!number.significand.multiply(10))
            return result;

          if (!number.significand.add(
                  static_cast<typename number_type::limb_type>(digit)))
            return result;

          ++retained_digits;
        } else {
          discarded = true;

          if (digit != 0)
            number.discarded_nonzero = true;
        }
      }

      /*
       * Full normalized exponent:
       *
       *   - digits after decimal point
       *   + digits discarded from the retained
       *     integer significand
       *
       * A discarded fractional digit contributes
       * both terms, so they cancel exactly.
       */
      if (after_point) {
        if (!discarded)
          increment_count(negative_adjustment);
      } else if (discarded) {
        increment_count(positive_adjustment);
      }

      ++current;
      continue;
    }

    if (!after_point && character == '.') {
      after_point = true;
      ++current;
      continue;
    }

    break;
  }

  if (!have_digit)
    return result;

  const char *exponent_marker = current;

  bool exponent_present = false;
  bool explicit_negative = false;

  floating_conversion_detail::decimal_wide_count explicit_magnitude{};

  if (exponent_mode != decimal_exponent_mode::forbidden && current != last &&
      (*current == 'e' || *current == 'E')) {
    const char *exponent_current = current + 1;

    if (exponent_current != last &&
        (*exponent_current == '+' || *exponent_current == '-')) {
      explicit_negative = *exponent_current == '-';

      ++exponent_current;
    }

    const char *exponent_digits = exponent_current;

    while (exponent_current != last && *exponent_current >= '0' &&
           *exponent_current <= '9') {
      floating_conversion_detail::append_decimal_digit(
          explicit_magnitude, static_cast<unsigned>(*exponent_current - '0'));

      ++exponent_current;
    }

    if (exponent_current != exponent_digits) {
      exponent_present = true;
      current = exponent_current;
    } else {
      /*
       * An optional malformed exponent is not
       * part of the matched subject sequence.
       */
      current = exponent_marker;
    }
  }

  if (exponent_mode == decimal_exponent_mode::required && !exponent_present) {
    /*
     * Scientific-only from_chars requires the
     * exponent part. In its absence, the entire
     * pattern fails rather than accepting only the
     * significand.
     */
    return result;
  }

  if (count_overflow) {
    /*
     * A valid object range this large is beyond
     * uint64_t counting on the platforms FTL
     * currently targets. Its decimal displacement
     * is necessarily far outside every binary32/64
     * exponent range.
     */
    number.exponent = positive_adjustment != 0
                          ? floating_conversion_detail::scanned_exponent_limit
                          : -floating_conversion_detail::scanned_exponent_limit;
  } else {
    number.exponent = floating_conversion_detail::combine_decimal_exponent(
        positive_adjustment, negative_adjustment, explicit_negative,
        explicit_magnitude);
  }

  result.ptr = current;
  result.number = number;
  result.status = decimal_scan_status::success;

  return result;
}

template <class Float>
[[nodiscard]]
constexpr hexadecimal_scan_result scan_hexadecimal(const char *first,
                                                   const char *last) noexcept {
  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  static_assert(floating_conversion_detail::decimal_binary_supported<Float>);

  hexadecimal_scan_result result{};
  result.ptr = first;

  const char *current = first;

  hexadecimal_number number{};

  if (current != last && *current == '-') {
    number.negative = true;
    ++current;
  } else if (current != last && *current == '+') {
    return result;
  }

  bool have_digit = false;
  bool have_nonzero = false;
  bool after_point = false;

  decltype(sizeof(0)) retained_digits = 0;

  uint64_t positive_adjustment = 0;
  uint64_t negative_adjustment = 0;

  bool count_overflow = false;

  const auto increment_count = [&](uint64_t &value) constexpr {
    if (value == static_cast<uint64_t>(-1)) {
      count_overflow = true;
    } else {
      ++value;
    }
  };

  while (current != last) {
    const unsigned digit =
        floating_conversion_detail::hexadecimal_digit_value(*current);

    if (digit < 16) {
      have_digit = true;

      bool discarded = false;

      if (have_nonzero || digit != 0) {
        have_nonzero = true;

        if (retained_digits <
            floating_conversion_detail::hexadecimal_retained_digits) {
          number.significand =
              floating_conversion_detail::shift_left_four(number.significand);

          number.significand.low |=
              static_cast<FTL_FLOATING_CONVERSION_STD::uint64_t>(digit);

          ++retained_digits;
        } else {
          discarded = true;

          if (digit != 0)
            number.discarded_nonzero = true;
        }
      }

      /*
       * Same normalization principle as decimal:
       *
       * retained fractional hex digit -> -4 bits
       * discarded integer hex digit  -> +4 bits
       * discarded fractional digit   -> cancels
       */
      if (after_point) {
        if (!discarded)
          increment_count(negative_adjustment);
      } else if (discarded) {
        increment_count(positive_adjustment);
      }

      ++current;
      continue;
    }

    if (!after_point && *current == '.') {
      after_point = true;
      ++current;
      continue;
    }

    break;
  }

  if (!have_digit)
    return result;

  const char *exponent_marker = current;

  bool explicit_negative = false;
  bool exponent_present = false;

  floating_conversion_detail::decimal_wide_count explicit_magnitude{};

  if (current != last && (*current == 'p' || *current == 'P')) {
    const char *exponent_current = current + 1;

    if (exponent_current != last &&
        (*exponent_current == '+' || *exponent_current == '-')) {
      explicit_negative = *exponent_current == '-';

      ++exponent_current;
    }

    const char *exponent_digits = exponent_current;

    while (exponent_current != last && *exponent_current >= '0' &&
           *exponent_current <= '9') {
      floating_conversion_detail::append_decimal_digit(
          explicit_magnitude, static_cast<unsigned>(*exponent_current - '0'));

      ++exponent_current;
    }

    if (exponent_current != exponent_digits) {
      exponent_present = true;
      current = exponent_current;
    } else {
      /*
       * Malformed optional exponent is not part
       * of the matched subject sequence.
       */
      current = exponent_marker;
    }
  }

  if (!exponent_present) {
    explicit_negative = false;
    explicit_magnitude = {};
  }

  if (count_overflow) {
    number.exponent = positive_adjustment != 0
                          ? floating_conversion_detail::scanned_exponent_limit
                          : -floating_conversion_detail::scanned_exponent_limit;
  } else {
    number.exponent = floating_conversion_detail::combine_hexadecimal_exponent(
        positive_adjustment, negative_adjustment, explicit_negative,
        explicit_magnitude);
  }

  result.ptr = current;
  result.number = number;

  result.status = hexadecimal_scan_status::success;

  return result;
}

template <class Float>
[[nodiscard]]
inline floating_format_result
format_fixed_precision(char *first, char *last, Float value,
                       unsigned precision) noexcept {
  using size_type = decltype(sizeof(0));

  namespace detail = floating_conversion_detail;

  static_assert(detail::decimal_binary_supported<Float>);

  const auto parts = decompose(value);

  /*
   * Canonical special spellings.
   */
  if (parts.kind == floating_kind::infinity) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required) {
      return {last, floating_format_status::value_too_large};
    }

    char *output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'i';
    *output++ = 'n';
    *output++ = 'f';

    return {output, floating_format_status::success};
  }

  if (parts.kind == floating_kind::nan) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required) {
      return {last, floating_format_status::value_too_large};
    }

    char *output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'n';
    *output++ = 'a';
    *output++ = 'n';

    return {output, floating_format_status::success};
  }

  detail::formatting_bigint scaled{};

  if (!parts.significand.is_zero()) {
    if (!detail::assign_uint128(scaled, parts.significand)) {
      return {last, floating_format_status::value_too_large};
    }
  }

  /*
   * We only need powers of five while the binary
   * denominator still exists.
   *
   * Once precision >= -exponent:
   *
   *   value * 10^precision
   *
   * is already an integer followed by additional
   * decimal zeroes, so those zeroes can be emitted
   * directly instead of materialized in the bigint.
   */
  unsigned scaled_precision = 0;

  if (parts.kind == floating_kind::finite && parts.exponent < 0) {
    const unsigned exact_precision = static_cast<unsigned>(-parts.exponent);

    scaled_precision =
        precision < exact_precision ? precision : exact_precision;
  }

  if (!scaled.is_zero() && scaled_precision != 0) {
    if (!scaled.multiply_pow5(scaled_precision)) {
      return {last, floating_format_status::value_too_large};
    }
  }

  const long long binary_shift =
      parts.kind == floating_kind::finite
          ? static_cast<long long>(parts.exponent) + scaled_precision
          : 0;

  if (!scaled.is_zero()) {
    if (binary_shift >= 0) {
      if (!scaled.shift_left(static_cast<size_type>(binary_shift))) {
        return {last, floating_format_status::value_too_large};
      }
    } else {
      if (!detail::round_big_uint_shift_right(
              scaled, static_cast<size_type>(-binary_shift))) {
        return {last, floating_format_status::value_too_large};
      }
    }
  }

  detail::decimal_chunk_buffer chunks{};

  if (!detail::extract_decimal_chunks(scaled, chunks)) {
    return {last, floating_format_status::value_too_large};
  }

  const size_type scaled_digits = chunks.digit_count;

  const size_type scaled_fraction_digits =
      static_cast<size_type>(scaled_precision);

  const size_type integer_digits = scaled_digits > scaled_fraction_digits
                                       ? scaled_digits - scaled_fraction_digits
                                       : 1;

  /*
   * Public precision is an int, so this arithmetic
   * comfortably fits unsigned long long on every
   * supported target.
   */
  const unsigned long long required =
      static_cast<unsigned long long>(parts.negative) +
      static_cast<unsigned long long>(integer_digits) +
      (precision != 0 ? 1ull + static_cast<unsigned long long>(precision)
                      : 0ull);

  if (static_cast<unsigned long long>(last - first) < required) {
    return {last, floating_format_status::value_too_large};
  }

  char *output = first;

  if (parts.negative)
    *output++ = '-';

  const size_type extra_zeroes =
      static_cast<size_type>(precision - scaled_precision);

  /*
   * The retained scaled integer already has
   * integer digits before the radix point.
   */
  if (scaled_digits > scaled_fraction_digits) {
    const size_type split = scaled_digits - scaled_fraction_digits;

    size_type emitted = 0;

    detail::emit_decimal_chunks(chunks, [&](char digit) {
      *output++ = digit;

      ++emitted;

      if (precision != 0 && emitted == split) {
        *output++ = '.';
      }
    });

    for (size_type index = 0; index < extra_zeroes; ++index) {
      *output++ = '0';
    }

    return {output, floating_format_status::success};
  }

  /*
   * Magnitude < 1 after rounding at this
   * precision.
   */
  *output++ = '0';

  if (precision != 0)
    *output++ = '.';

  const size_type leading_zeroes = scaled_fraction_digits - scaled_digits;

  for (size_type index = 0; index < leading_zeroes; ++index) {
    *output++ = '0';
  }

  detail::emit_decimal_chunks(chunks, [&](char digit) { *output++ = digit; });

  for (size_type index = 0; index < extra_zeroes; ++index) {
    *output++ = '0';
  }

  return {output, floating_format_status::success};
}

template <class Float>
[[nodiscard]]
inline floating_format_result format_scientific_precision(
    char* first,
    char* last,
    Float value,
    unsigned precision) noexcept {
  using size_type = decltype(sizeof(0));

  namespace detail = floating_conversion_detail;

  static_assert(detail::decimal_binary_supported<Float>);

  const auto parts = decompose(value);

  if (parts.kind == floating_kind::infinity) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required)
      return {last, floating_format_status::value_too_large};

    char* output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'i';
    *output++ = 'n';
    *output++ = 'f';

    return {output, floating_format_status::success};
  }

  if (parts.kind == floating_kind::nan) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required)
      return {last, floating_format_status::value_too_large};

    char* output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'n';
    *output++ = 'a';
    *output++ = 'n';

    return {output, floating_format_status::success};
  }

  detail::exact_decimal_digits decimal{};

  if (parts.kind == floating_kind::zero) {
    decimal.digits[0] = '0';
    decimal.count = 1;
    decimal.exponent = 0;
  } else {
    if (!detail::build_exact_decimal_digits(parts, decimal))
      return {last, floating_format_status::value_too_large};
  }

  const unsigned long long significant_digits =
      static_cast<unsigned long long>(precision) + 1;

  if (significant_digits < decimal.count) {
    detail::round_decimal_significant_digits(
        decimal,
        static_cast<size_type>(significant_digits));
  }

  const unsigned exponent_digits =
      detail::decimal_exponent_digits(decimal.exponent);

  const unsigned long long required =
      static_cast<unsigned long long>(parts.negative) +
      1ull +
      (precision != 0
           ? 1ull + static_cast<unsigned long long>(precision)
           : 0ull) +
      2ull +
      exponent_digits;

  if (static_cast<unsigned long long>(last - first) < required)
    return {last, floating_format_status::value_too_large};

  char* output = first;

  if (parts.negative)
    *output++ = '-';

  *output++ = decimal.digits[0];

  if (precision != 0)
    *output++ = '.';

  for (unsigned long long index = 1;
       index < significant_digits;
       ++index) {
    if (index < decimal.count)
      *output++ = decimal.digits[static_cast<size_type>(index)];
    else
      *output++ = '0';
  }

  detail::emit_scientific_exponent(decimal.exponent, [&](char character) {
    *output++ = character;
  });

  return {output, floating_format_status::success};
}

template <class Float>
[[nodiscard]]
inline floating_format_result format_general_precision(
    char* first,
    char* last,
    Float value,
    unsigned precision) noexcept {
  using size_type = decltype(sizeof(0));

  namespace detail = floating_conversion_detail;

  static_assert(detail::decimal_binary_supported<Float>);

  const auto parts = decompose(value);

  /*
   * %g applies no precision-dependent formatting to
   * infinity or NaN.
   */
  if (parts.kind == floating_kind::infinity ||
      parts.kind == floating_kind::nan) {
    return format_scientific_precision(first, last, value, 0);
  }

  /*
   * printf-style %g treats precision zero as one
   * significant digit.
   */
  const unsigned significant_digits =
      precision == 0 ? 1 : precision;

  /*
   * Build the exact decimal once, round it to the
   * requested significant-digit precision, then emit
   * the final %g representation directly.
   *
   * This is important for the to_chars capacity
   * contract: trailing zeroes removed by %g must not
   * count against [first, last).
   */
  detail::exact_decimal_digits decimal{};

  if (parts.kind == floating_kind::zero) {
    decimal.digits[0] = '0';
    decimal.count = 1;
    decimal.exponent = 0;
  } else {
    if (!detail::build_exact_decimal_digits(parts, decimal))
      return {last, floating_format_status::value_too_large};
  }

  const size_type requested_digits =
      static_cast<size_type>(significant_digits);

  if (requested_digits < decimal.count) {
    detail::round_decimal_significant_digits(
        decimal, requested_digits);
  }

  size_type digit_count =
      requested_digits < decimal.count
          ? requested_digits
          : decimal.count;

  /*
   * %g removes trailing zeroes from the significand.
   *
   * The decimal exponent remains unchanged, so this is
   * also correct for integer zeroes:
   *
   *   digits = "12", exponent = 2
   *
   * still emits 120 in fixed notation.
   */
  while (digit_count > 1 &&
         decimal.digits[digit_count - 1] == '0') {
    --digit_count;
  }

  const long long exponent = decimal.exponent;

  const bool use_fixed =
      exponent >= -4 &&
      exponent < static_cast<long long>(significant_digits);

  unsigned long long required =
      static_cast<unsigned long long>(parts.negative);

  if (use_fixed) {
    const long long point = exponent + 1;

    if (point <= 0) {
      required +=
          2ull +
          static_cast<unsigned long long>(-point) +
          static_cast<unsigned long long>(digit_count);
    } else if (point >= static_cast<long long>(digit_count)) {
      required += static_cast<unsigned long long>(point);
    } else {
      required +=
          static_cast<unsigned long long>(digit_count) + 1ull;
    }
  } else {
    required +=
        static_cast<unsigned long long>(digit_count) +
        static_cast<unsigned long long>(digit_count > 1) +
        2ull +
        detail::decimal_exponent_digits(exponent);
  }

  if (static_cast<unsigned long long>(last - first) < required)
    return {last, floating_format_status::value_too_large};

  char* output = first;

  if (parts.negative)
    *output++ = '-';

  if (use_fixed) {
    const long long point = exponent + 1;

    if (point <= 0) {
      *output++ = '0';
      *output++ = '.';

      for (long long index = 0; index < -point; ++index)
        *output++ = '0';

      for (size_type index = 0; index < digit_count; ++index)
        *output++ = decimal.digits[index];

      return {output, floating_format_status::success};
    }

    if (point >= static_cast<long long>(digit_count)) {
      for (size_type index = 0; index < digit_count; ++index)
        *output++ = decimal.digits[index];

      for (long long index = static_cast<long long>(digit_count);
           index < point;
           ++index) {
        *output++ = '0';
      }

      return {output, floating_format_status::success};
    }

    const size_type split = static_cast<size_type>(point);

    for (size_type index = 0; index < split; ++index)
      *output++ = decimal.digits[index];

    *output++ = '.';

    for (size_type index = split; index < digit_count; ++index)
      *output++ = decimal.digits[index];

    return {output, floating_format_status::success};
  }

  *output++ = decimal.digits[0];

  if (digit_count > 1) {
    *output++ = '.';

    for (size_type index = 1; index < digit_count; ++index)
      *output++ = decimal.digits[index];
  }

  detail::emit_scientific_exponent(
      exponent,
      [&](char character) {
        *output++ = character;
      });

  return {output, floating_format_status::success};
}

template <class Float>
[[nodiscard]]
inline floating_format_result format_hexadecimal_precision(
    char* first, char* last, Float value, unsigned precision) noexcept {
  using size_type = decltype(sizeof(0));

  namespace detail = floating_conversion_detail;

  static_assert(detail::decimal_binary_supported<Float>);

  const auto parts = decompose(value);

  if (parts.kind == floating_kind::infinity) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required)
      return {last, floating_format_status::value_too_large};

    char* output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'i';
    *output++ = 'n';
    *output++ = 'f';

    return {output, floating_format_status::success};
  }

  if (parts.kind == floating_kind::nan) {
    const size_type required = parts.negative ? 4 : 3;

    if (static_cast<size_type>(last - first) < required)
      return {last, floating_format_status::value_too_large};

    char* output = first;

    if (parts.negative)
      *output++ = '-';

    *output++ = 'n';
    *output++ = 'a';
    *output++ = 'n';

    return {output, floating_format_status::success};
  }

  constexpr unsigned source_precision =
      static_cast<unsigned>(floating_format_traits<Float>::significand_bits);

  constexpr unsigned source_fraction_bits = source_precision - 1;

  /*
   * Number of hexadecimal fractional digits needed
   * to represent every source significand bit exactly.
   *
   * binary32  -> 6
   * binary64  -> 13
   * x87       -> 16
   * binary128 -> 28
   */
  constexpr unsigned exact_hexadecimal_precision =
      (source_fraction_bits + 3) / 4;

  const unsigned materialized_precision =
      precision < exact_hexadecimal_precision
          ? precision
          : exact_hexadecimal_precision;

  uint128 scaled{};

  long long exponent = 0;

  if (parts.kind == floating_kind::zero) {
    scaled = {};
    exponent = 0;
  } else {
    scaled = parts.significand;

    /*
     * The %a exponent is anchored so that the
     * significand is interpreted relative to the
     * format's canonical leading-bit position.
     *
     * For normal values this gives the ordinary
     * unbiased exponent. For subnormals it naturally
     * remains at the minimum normal exponent.
     */
    exponent =
        static_cast<long long>(parts.exponent) +
        static_cast<long long>(source_fraction_bits);

    const long long scale_shift =
        static_cast<long long>(materialized_precision) * 4 -
        static_cast<long long>(source_fraction_bits);

    if (scale_shift >= 0) {
      scaled = detail::shift_left_uint128(
          scaled, static_cast<unsigned long long>(scale_shift));
    } else {
      scaled = detail::round_shift_right(
          scaled, static_cast<unsigned long long>(-scale_shift), false);
    }
  }

  const unsigned exponent_digits = detail::hexadecimal_exponent_digits(exponent);

  const unsigned long long required =
      static_cast<unsigned long long>(parts.negative) +
      1ull +
      (precision != 0
           ? 1ull + static_cast<unsigned long long>(precision)
           : 0ull) +
      2ull +
      exponent_digits;

  if (static_cast<unsigned long long>(last - first) < required)
    return {last, floating_format_status::value_too_large};

  char* output = first;

  if (parts.negative)
    *output++ = '-';

  /*
   * scaled contains exactly:
   *
   *   one leading hex digit
   *   + materialized_precision fractional digits
   *
   * with digit zero at the least-significant end.
   */
  *output++ = detail::hexadecimal_digit_character(
      detail::uint128_hexadecimal_digit(scaled, materialized_precision));

  if (precision != 0)
    *output++ = '.';

  for (unsigned index = materialized_precision; index != 0; --index) {
    *output++ = detail::hexadecimal_digit_character(
        detail::uint128_hexadecimal_digit(scaled, index - 1));
  }

  for (unsigned index = materialized_precision; index < precision; ++index)
    *output++ = '0';

  detail::emit_hexadecimal_exponent(exponent, [&](char character) {
    *output++ = character;
  });

  return {output, floating_format_status::success};
}

template <class Float>
[[nodiscard]]
inline floating_format_result format_hexadecimal_default_precision(
    char* first, char* last, Float value) noexcept {
  constexpr unsigned fraction_bits =
      static_cast<unsigned>(floating_format_traits<Float>::significand_bits - 1);
  constexpr unsigned exact_precision = (fraction_bits + 3) / 4;

  /*
   * Omitted %a precision means enough digits for an exact representation,
   * but trailing fractional zeroes are not required. Format into scratch
   * first so a caller buffer only needs to fit the final trimmed result.
   */
  char scratch[64]{};

  auto result = format_hexadecimal_precision(
      scratch, scratch + sizeof(scratch), value, exact_precision);

  if (result.status != floating_format_status::success)
    return {last, floating_format_status::value_too_large};

  char* end = result.ptr;
  char* exponent = scratch;

  while (exponent != end && *exponent != 'p')
    ++exponent;

  /*
   * inf / nan have no exponent and need no trimming.
   */
  if (exponent != end) {
    char* point = scratch;

    while (point != exponent && *point != '.')
      ++point;

    if (point != exponent) {
      char* mantissa_end = exponent;

      while (mantissa_end != point + 1 && mantissa_end[-1] == '0')
        --mantissa_end;

      if (mantissa_end == point + 1)
        --mantissa_end;

      char* output = mantissa_end;

      for (char* source = exponent; source != end; ++source)
        *output++ = *source;

      end = output;
    }
  }

  const auto required = static_cast<decltype(sizeof(0))>(end - scratch);

  if (static_cast<decltype(sizeof(0))>(last - first) < required)
    return {last, floating_format_status::value_too_large};

  char* output = first;

  for (char* source = scratch; source != end; ++source)
    *output++ = *source;

  return {output, floating_format_status::success};
}

