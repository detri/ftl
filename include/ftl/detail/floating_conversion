/*
 * Conservative significant-digit retention bounds.
 *
 * Any binary32 rounding midpoint has an exact
 * terminating decimal representation shorter than
 * 128 significant digits.
 *
 * Any binary64 rounding midpoint has one shorter
 * than 800 significant digits.
 *
 * Therefore, after retaining this many digits,
 * discarded input cannot hide an unknown midpoint:
 * a sticky nonzero bit is sufficient to determine
 * which side of an exact retained midpoint the full
 * input lies on.
 */
template <class Float> struct decimal_scan_traits;

template <> struct decimal_scan_traits<float> {
  static constexpr decltype(sizeof(0)) limb_capacity = 8;

  static constexpr decltype(sizeof(0)) max_significant_digits = 128;
};

template <> struct decimal_scan_traits<double> {
  static constexpr decltype(sizeof(0)) limb_capacity = 48;

  static constexpr decltype(sizeof(0)) max_significant_digits = 800;
};

template <> struct decimal_scan_traits<long double> {
  /*
   * The worst supported representation is IEEE
   * binary128.
   *
   * Its smallest rounding boundaries can require
   * roughly 11,530 significant decimal digits for
   * an exact terminating representation.
   *
   * Keep a conservative 12,000-digit prefix.
   * 640 64-bit limbs provide 40,960 bits, enough
   * for that decimal significand and the exact
   * powers-of-five arithmetic around it.
   */
  static constexpr decltype(sizeof(0)) limb_capacity = 640;

  static constexpr decltype(sizeof(0)) max_significant_digits = 12000;
};

#ifdef __STDCPP_FLOAT16_T__
template <>
struct decimal_scan_traits<decltype(0.0f16)>
    : decimal_scan_traits<float> {};
#endif

#ifdef __STDCPP_FLOAT32_T__
template <>
struct decimal_scan_traits<decltype(0.0f32)>
    : decimal_scan_traits<float> {};
#endif

#ifdef __STDCPP_FLOAT64_T__
template <>
struct decimal_scan_traits<decltype(0.0f64)>
    : decimal_scan_traits<double> {};
#endif

#ifdef __STDCPP_FLOAT128_T__
template <>
struct decimal_scan_traits<decltype(0.0f128)>
    : decimal_scan_traits<long double> {};
#endif

#ifdef __STDCPP_BFLOAT16_T__
template <>
struct decimal_scan_traits<decltype(0.0bf16)>
    : decimal_scan_traits<float> {};
#endif

template <class Float>
using scanned_decimal_number =
    decimal_number<decimal_scan_traits<Float>::limb_capacity>;

/*
 * We only need a final exponent large enough to
 * distinguish every representable floating value
 * from obvious overflow/underflow.
 */
inline constexpr int scanned_exponent_limit = 1000000;

[[nodiscard]]
constexpr char ascii_lower(char value) noexcept {
  if (value >= 'A' && value <= 'Z') {
    return static_cast<char>(value - 'A' + 'a');
  }

  return value;
}

[[nodiscard]]
constexpr bool
matches_ascii_case_insensitive(const char *first, const char *last,
                               const char *spelling,
                               decltype(sizeof(0)) count) noexcept {
  const char *current = first;

  for (decltype(sizeof(0)) index = 0; index < count; ++index) {
    if (current == last)
      return false;

    if (ascii_lower(*current) != spelling[index])
      return false;

    ++current;
  }

  return true;
}

[[nodiscard]]
constexpr bool nan_sequence_character(char value) noexcept {
  return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'z') ||
         (value >= 'A' && value <= 'Z') || value == '_';
}

/*
 * A tiny unsigned 65-bit magnitude.
 *
 * Character-count adjustments are at most uint64_t
 * wide on our supported targets. We retain one
 * extra bit so a textual exponent can be combined
 * with those counts without losing cancellation.
 *
 * high == 2 is a saturation sentinel meaning
 * "larger than any character-count adjustment".
 */
struct decimal_wide_count {
  FTL_FLOATING_CONVERSION_STD::uint64_t low = 0;
  unsigned high = 0;

  [[nodiscard]]
  constexpr bool saturated() const noexcept {
    return high >= 2;
  }
};

constexpr void
add_count(decimal_wide_count &value,
          FTL_FLOATING_CONVERSION_STD::uint64_t amount) noexcept {
  if (value.saturated())
    return;

  const auto old = value.low;

  value.low += amount;

  if (value.low < old)
    ++value.high;

  if (value.high >= 2) {
    value.high = 2;
    value.low = 0;
  }
}

constexpr void append_decimal_digit(decimal_wide_count &value,
                                    unsigned digit) noexcept {
  if (value.saturated())
    return;

  const auto product = big_uint_detail::multiply_64(value.low, 10);

  unsigned high = value.high * 10 + static_cast<unsigned>(product.high);

  auto low = product.low;

  const auto old = low;
  low += static_cast<FTL_FLOATING_CONVERSION_STD::uint64_t>(digit);

  if (low < old)
    ++high;

  if (high >= 2) {
    value.high = 2;
    value.low = 0;
    return;
  }

  value.high = high;
  value.low = low;
}

[[nodiscard]]
constexpr int compare_count(decimal_wide_count left,
                            decimal_wide_count right) noexcept {
  if (left.high < right.high)
    return -1;

  if (left.high > right.high)
    return 1;

  if (left.low < right.low)
    return -1;

  if (left.low > right.low)
    return 1;

  return 0;
}

[[nodiscard]]
constexpr decimal_wide_count subtract_count(decimal_wide_count left,
                                            decimal_wide_count right) noexcept {
  /*
   * Precondition: left >= right and neither is
   * saturated.
   */
  decimal_wide_count result{};

  result.low = left.low - right.low;

  const unsigned borrow = left.low < right.low ? 1u : 0u;

  result.high = left.high - right.high - borrow;

  return result;
}

[[nodiscard]]
constexpr int clamp_exponent(bool negative,
                             decimal_wide_count magnitude) noexcept {
  if (magnitude.saturated() || magnitude.high != 0 ||
      magnitude.low > static_cast<FTL_FLOATING_CONVERSION_STD::uint64_t>(
                          scanned_exponent_limit)) {
    return negative ? -scanned_exponent_limit : scanned_exponent_limit;
  }

  const int value = static_cast<int>(magnitude.low);

  return negative ? -value : value;
}

[[nodiscard]]
constexpr int combine_decimal_exponent(
    FTL_FLOATING_CONVERSION_STD::uint64_t positive_adjustment,
    FTL_FLOATING_CONVERSION_STD::uint64_t negative_adjustment,
    bool explicit_negative, decimal_wide_count explicit_magnitude) noexcept {
  decimal_wide_count positive{};
  decimal_wide_count negative{};

  add_count(positive, positive_adjustment);

  add_count(negative, negative_adjustment);

  if (explicit_negative) {
    if (explicit_magnitude.saturated())
      return -scanned_exponent_limit;

    add_count(negative, explicit_magnitude.low);

    /*
     * explicit_magnitude.high can only be 0 or 1
     * here. Add its 2^64 contribution directly.
     */
    if (explicit_magnitude.high != 0) {
      if (negative.high >= 1)
        return -scanned_exponent_limit;

      ++negative.high;
    }
  } else {
    if (explicit_magnitude.saturated())
      return scanned_exponent_limit;

    add_count(positive, explicit_magnitude.low);

    if (explicit_magnitude.high != 0) {
      if (positive.high >= 1)
        return scanned_exponent_limit;

      ++positive.high;
    }
  }

  const int ordering = compare_count(positive, negative);

  if (ordering == 0)
    return 0;

  if (ordering > 0) {
    if (positive.saturated())
      return scanned_exponent_limit;

    return clamp_exponent(false, subtract_count(positive, negative));
  }

  if (negative.saturated())
    return -scanned_exponent_limit;

  return clamp_exponent(true, subtract_count(negative, positive));
}

inline constexpr decltype(sizeof(0)) hexadecimal_retained_digits = 32;

[[nodiscard]]
constexpr unsigned hexadecimal_digit_value(char value) noexcept {
  if (value >= '0' && value <= '9')
    return static_cast<unsigned>(value - '0');

  if (value >= 'a' && value <= 'f')
    return static_cast<unsigned>(value - 'a') + 10;

  if (value >= 'A' && value <= 'F')
    return static_cast<unsigned>(value - 'A') + 10;

  return 255;
}

constexpr void add_scaled_count(decimal_wide_count &value,
                                FTL_FLOATING_CONVERSION_STD::uint64_t amount,
                                unsigned scale) noexcept {
  if (value.saturated())
    return;

  const auto product = big_uint_detail::multiply_64(
      amount, static_cast<FTL_FLOATING_CONVERSION_STD::uint64_t>(scale));

  if (product.high >= 2) {
    value.high = 2;
    value.low = 0;
    return;
  }

  add_count(value, product.low);

  if (value.saturated())
    return;

  value.high += static_cast<unsigned>(product.high);

  if (value.high >= 2) {
    value.high = 2;
    value.low = 0;
  }
}

[[nodiscard]]
constexpr int combine_hexadecimal_exponent(
    FTL_FLOATING_CONVERSION_STD::uint64_t positive_digit_adjustment,
    FTL_FLOATING_CONVERSION_STD::uint64_t negative_digit_adjustment,
    bool explicit_negative, decimal_wide_count explicit_magnitude) noexcept {
  decimal_wide_count positive{};
  decimal_wide_count negative{};

  /*
   * Each hexadecimal digit changes the binary
   * exponent by four.
   */
  add_scaled_count(positive, positive_digit_adjustment, 4);

  add_scaled_count(negative, negative_digit_adjustment, 4);

  if (explicit_negative) {
    if (explicit_magnitude.saturated())
      return -scanned_exponent_limit;

    add_count(negative, explicit_magnitude.low);

    if (explicit_magnitude.high != 0) {
      if (negative.high >= 1)
        return -scanned_exponent_limit;

      ++negative.high;
    }
  } else {
    if (explicit_magnitude.saturated())
      return scanned_exponent_limit;

    add_count(positive, explicit_magnitude.low);

    if (explicit_magnitude.high != 0) {
      if (positive.high >= 1)
        return scanned_exponent_limit;

      ++positive.high;
    }
  }

  const int ordering = compare_count(positive, negative);

  if (ordering == 0)
    return 0;

  if (ordering > 0) {
    if (positive.saturated())
      return scanned_exponent_limit;

    return clamp_exponent(false, subtract_count(positive, negative));
  }

  if (negative.saturated())
    return -scanned_exponent_limit;

  return clamp_exponent(true, subtract_count(negative, positive));
}

[[nodiscard]]
constexpr unsigned
bit_width_64(FTL_FLOATING_CONVERSION_STD::uint64_t value) noexcept {
  unsigned result = 0;

  while (value != 0) {
    ++result;
    value >>= 1;
  }

  return result;
}

[[nodiscard]]
constexpr unsigned bit_width_uint128(uint128 value) noexcept {
  if (value.high != 0) {
    return 64 + bit_width_64(value.high);
  }

  return bit_width_64(value.low);
}

[[nodiscard]]
constexpr uint128 shift_left_four(uint128 value) noexcept {
  return {value.low << 4, (value.high << 4) | (value.low >> 60)};
}

[[nodiscard]]
constexpr uint128 shift_left_uint128(uint128 value,
                                     unsigned long long shift) noexcept {
  if (shift == 0)
    return value;

  if (shift >= 128)
    return {};

  if (shift >= 64) {
    return {0, value.low << (shift - 64)};
  }

  return {value.low << shift,
          (value.high << shift) | (value.low >> (64 - shift))};
}

[[nodiscard]]
constexpr uint128 shift_right_uint128(uint128 value,
                                      unsigned long long shift) noexcept {
  if (shift == 0)
    return value;

  if (shift >= 128)
    return {};

  if (shift >= 64) {
    return {value.high >> (shift - 64), 0};
  }

  return {(value.low >> shift) | (value.high << (64 - shift)),
          value.high >> shift};
}

[[nodiscard]]
constexpr bool uint128_bit_is_set(uint128 value, unsigned bit) noexcept {
  if (bit < 64) {
    return ((value.low >> bit) & 1u) != 0;
  }

  if (bit < 128) {
    return ((value.high >> (bit - 64)) & 1u) != 0;
  }

  return false;
}

/*
 * Test whether any of bits [0, count) are set.
 */
[[nodiscard]]
constexpr bool uint128_has_low_bits(uint128 value, unsigned count) noexcept {
  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  if (count == 0)
    return false;

  if (count >= 128)
    return !value.is_zero();

  if (count <= 64) {
    if (count == 64)
      return value.low != 0;

    const uint64_t mask = (uint64_t{1} << count) - 1;

    return (value.low & mask) != 0;
  }

  if (value.low != 0)
    return true;

  const unsigned high_count = count - 64;

  if (high_count == 64)
    return value.high != 0;

  const uint64_t mask = (uint64_t{1} << high_count) - 1;

  return (value.high & mask) != 0;
}

constexpr void increment_uint128(uint128 &value) noexcept;

[[nodiscard]]
constexpr bool uint128_is_odd(uint128 value) noexcept;

/*
 * Exact nearest-even division by a power of two.
 *
 * discarded_nonzero represents bits strictly below
 * the retained 128-bit significand.
 */
[[nodiscard]]
constexpr uint128 round_shift_right(uint128 value, unsigned long long shift,
                                    bool discarded_nonzero) noexcept {
  if (shift == 0)
    return value;

  /*
   * Even the largest 128-bit retained value is
   * strictly below the halfway point once the
   * divisor exceeds 2^128.
   */
  if (shift > 128)
    return {};

  const uint128 quotient = shift_right_uint128(value, shift);

  const unsigned guard_bit = static_cast<unsigned>(shift - 1);

  if (!uint128_bit_is_set(value, guard_bit)) {
    return quotient;
  }

  const bool below_guard = uint128_has_low_bits(value, guard_bit);

  uint128 rounded = quotient;

  if (below_guard || discarded_nonzero || uint128_is_odd(quotient)) {
    increment_uint128(rounded);
  }

  return rounded;
}

/*
 * Return one limb from:
 *
 *   value << shift
 *
 * without actually constructing the shifted bigint.
 */
template <decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr typename big_uint<Limbs>::limb_type
shifted_limb(const big_uint<Limbs> &value, decltype(sizeof(0)) index,
             decltype(sizeof(0)) shift) noexcept {
  using integer_type = big_uint<Limbs>;
  using size_type = typename integer_type::size_type;
  using limb_type = typename integer_type::limb_type;

  constexpr size_type limb_bits = integer_type::limb_bits;

  const size_type limb_shift = shift / limb_bits;

  const size_type bit_shift = shift % limb_bits;

  if (index < limb_shift)
    return 0;

  const size_type source = index - limb_shift;

  limb_type result = value.limb(source) << bit_shift;

  if (bit_shift != 0 && source != 0) {
    result |= value.limb(source - 1) >> (limb_bits - bit_shift);
  }

  return result;
}

/*
 * Compare:
 *
 *   left  << left_shift
 *
 * against:
 *
 *   right << right_shift
 *
 * without requiring either shifted value to fit in
 * its fixed bigint capacity.
 */
template <decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr int compare_shifted(const big_uint<Limbs> &left,
                              decltype(sizeof(0)) left_shift,
                              const big_uint<Limbs> &right,
                              decltype(sizeof(0)) right_shift) noexcept {
  using integer_type = big_uint<Limbs>;
  using size_type = typename integer_type::size_type;

  if (left.is_zero())
    return right.is_zero() ? 0 : -1;

  if (right.is_zero())
    return 1;

  /*
   * A common factor of two has no effect on ordering.
   * Cancelling it also keeps the virtual shifts small.
   */
  const size_type common_shift =
      left_shift < right_shift ? left_shift : right_shift;

  left_shift -= common_shift;
  right_shift -= common_shift;

  const size_type left_width = left.bit_width() + left_shift;

  const size_type right_width = right.bit_width() + right_shift;

  if (left_width < right_width)
    return -1;

  if (left_width > right_width)
    return 1;

  const size_type limb_count =
      (left_width + integer_type::limb_bits - 1) / integer_type::limb_bits;

  size_type index = limb_count;

  while (index != 0) {
    --index;

    const auto left_value = shifted_limb(left, index, left_shift);

    const auto right_value = shifted_limb(right, index, right_shift);

    if (left_value < right_value)
      return -1;

    if (left_value > right_value)
      return 1;
  }

  return 0;
}

/*
 * Exact:
 *
 *   floor(log2(numerator / denominator))
 */
template <decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr long long
floor_log2_ratio(const big_uint<Limbs> &numerator,
                 const big_uint<Limbs> &denominator) noexcept {
  long long exponent = static_cast<long long>(numerator.bit_width()) -
                       static_cast<long long>(denominator.bit_width());

  if (exponent >= 0) {
    if (compare_shifted(numerator, 0, denominator,
                        static_cast<decltype(sizeof(0))>(exponent)) < 0) {
      --exponent;
    }
  } else {
    if (compare_shifted(numerator, static_cast<decltype(sizeof(0))>(-exponent),
                        denominator, 0) < 0) {
      --exponent;
    }
  }

  return exponent;
}

[[nodiscard]]
constexpr bool uint128_less(uint128 left, uint128 right) noexcept {
  if (left.high < right.high)
    return true;

  if (left.high > right.high)
    return false;

  return left.low < right.low;
}

[[nodiscard]]
constexpr uint128 uint128_bit(unsigned bit) noexcept {
  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  if (bit < 64) {
    return {uint64_t{1} << bit, 0};
  }

  return {0, uint64_t{1} << (bit - 64)};
}

constexpr void set_uint128_bit(uint128 &value, unsigned bit) noexcept {
  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  if (bit < 64) {
    value.low |= uint64_t{1} << bit;
  } else {
    value.high |= uint64_t{1} << (bit - 64);
  }
}

constexpr void increment_uint128(uint128 &value) noexcept {
  ++value.low;

  if (value.low == 0)
    ++value.high;
}

inline constexpr decltype(sizeof(0)) formatting_bigint_limbs = 640;

inline constexpr decltype(sizeof(0)) decimal_chunk_capacity = 660;

inline constexpr FTL_FLOATING_CONVERSION_STD::uint64_t decimal_chunk_base =
    10000000000000000000ull;

inline constexpr unsigned decimal_chunk_digits = 19;

using formatting_bigint = big_uint<formatting_bigint_limbs>;

struct decimal_chunk_buffer {
  FTL_FLOATING_CONVERSION_STD::uint64_t chunks[decimal_chunk_capacity]{};

  decltype(sizeof(0)) count = 0;
  decltype(sizeof(0)) digit_count = 0;
};

inline constexpr decltype(sizeof(0)) exact_decimal_digit_capacity =
    decimal_chunk_capacity * decimal_chunk_digits;

struct exact_decimal_digits {
  char digits[exact_decimal_digit_capacity]{};
  decltype(sizeof(0)) count = 0;
  long long exponent = 0;
};

[[nodiscard]]
constexpr bool assign_uint128(formatting_bigint &destination,
                              uint128 value) noexcept {
  formatting_bigint result(value.low);

  if (value.high != 0) {
    formatting_bigint high(value.high);

    if (!high.shift_left(64))
      return false;

    if (!result.add(high))
      return false;
  }

  destination = result;
  return true;
}

/*
 * Exact nearest-even division by 2^shift.
 */
[[nodiscard]]
constexpr bool round_big_uint_shift_right(formatting_bigint &value,
                                          decltype(sizeof(0)) shift) noexcept {
  if (shift == 0)
    return true;

  const bool guard = value.test_bit(shift - 1);

  const bool sticky = value.any_low_bits(shift - 1);

  value.shift_right(shift);

  if (guard && (sticky || (value.limb(0) & 1u) != 0)) {
    return value.add(1);
  }

  return true;
}

[[nodiscard]]
constexpr unsigned
decimal_digit_count(FTL_FLOATING_CONVERSION_STD::uint64_t value) noexcept {
  unsigned count = 1;

  while (value >= 10) {
    value /= 10;
    ++count;
  }

  return count;
}

[[nodiscard]]
constexpr bool extract_decimal_chunks(formatting_bigint value,
                                      decimal_chunk_buffer &output) noexcept {
  if (value.is_zero()) {
    output.chunks[0] = 0;
    output.count = 1;
    output.digit_count = 1;

    return true;
  }

  while (!value.is_zero()) {
    if (output.count == decimal_chunk_capacity) {
      return false;
    }

    const auto division = value.divide(decimal_chunk_base);

    if (!division.success)
      return false;

    output.chunks[output.count++] = division.remainder;
  }

  output.digit_count = (output.count - 1) * decimal_chunk_digits +
                       decimal_digit_count(output.chunks[output.count - 1]);

  return true;
}

template <class Emit>
constexpr void emit_uint64_decimal(FTL_FLOATING_CONVERSION_STD::uint64_t value,
                                   bool leading_zeroes, Emit &&emit) {
  char reversed[decimal_chunk_digits]{};

  unsigned count = 0;

  do {
    reversed[count++] = static_cast<char>('0' + value % 10);

    value /= 10;
  } while (value != 0);

  if (leading_zeroes) {
    while (count < decimal_chunk_digits) {
      reversed[count++] = '0';
    }
  }

  while (count != 0)
    emit(reversed[--count]);
}

template <class Emit>
constexpr void emit_decimal_chunks(const decimal_chunk_buffer &chunks,
                                   Emit &&emit) {
  decltype(sizeof(0)) index = chunks.count;

  while (index != 0) {
    --index;

    emit_uint64_decimal(chunks.chunks[index], index != chunks.count - 1, emit);
  }
}

template <class Float>
[[nodiscard]]
constexpr bool build_exact_decimal_digits(
    const binary_parts<Float>& parts,
    exact_decimal_digits& output) noexcept {
  using size_type = decltype(sizeof(0));

  formatting_bigint exact{};

  if (!assign_uint128(exact, parts.significand))
    return false;

  size_type decimal_scale = 0;

  if (parts.exponent >= 0) {
    if (!exact.shift_left(static_cast<size_type>(parts.exponent)))
      return false;
  } else {
    decimal_scale =
        static_cast<size_type>(-static_cast<long long>(parts.exponent));

    if (!exact.multiply_pow5(static_cast<unsigned>(decimal_scale)))
      return false;
  }

  decimal_chunk_buffer chunks{};

  if (!extract_decimal_chunks(exact, chunks))
    return false;

  if (chunks.digit_count > exact_decimal_digit_capacity)
    return false;

  size_type index = 0;

  emit_decimal_chunks(chunks, [&](char digit) {
    output.digits[index++] = digit;
  });

  output.count = index;
  output.exponent =
      static_cast<long long>(output.count) -
      static_cast<long long>(decimal_scale) - 1;

  return true;
}

constexpr void round_decimal_significant_digits(
    exact_decimal_digits& value,
    decltype(sizeof(0)) keep) noexcept {
  if (keep >= value.count)
    return;

  const char first_discarded = value.digits[keep];

  bool discarded_nonzero = false;

  for (decltype(sizeof(0)) index = keep + 1;
       index < value.count;
       ++index) {
    if (value.digits[index] != '0') {
      discarded_nonzero = true;
      break;
    }
  }

  bool round_up = false;

  if (first_discarded > '5') {
    round_up = true;
  } else if (first_discarded == '5') {
    if (discarded_nonzero ||
        ((value.digits[keep - 1] - '0') & 1) != 0) {
      round_up = true;
    }
  }

  if (!round_up)
    return;

  decltype(sizeof(0)) index = keep;

  while (index != 0) {
    --index;

    if (value.digits[index] != '9') {
      ++value.digits[index];
      return;
    }

    value.digits[index] = '0';
  }

  /*
   * 9.99... rounded upward becomes 1.00... with a
   * decimal exponent one larger.
   */
  value.digits[0] = '1';

  for (decltype(sizeof(0)) digit = 1; digit < keep; ++digit)
    value.digits[digit] = '0';

  ++value.exponent;
}

[[nodiscard]]
constexpr unsigned long long decimal_exponent_magnitude(
    long long exponent) noexcept {
  return exponent < 0
      ? static_cast<unsigned long long>(-exponent)
      : static_cast<unsigned long long>(exponent);
}

[[nodiscard]]
constexpr unsigned decimal_exponent_digits(
    long long exponent) noexcept {
  unsigned long long magnitude = decimal_exponent_magnitude(exponent);
  unsigned digits = 1;

  while (magnitude >= 10) {
    magnitude /= 10;
    ++digits;
  }

  return digits < 2 ? 2 : digits;
}

template <class Emit>
constexpr void emit_scientific_exponent(long long exponent, Emit&& emit) {
  unsigned long long magnitude = decimal_exponent_magnitude(exponent);

  emit('e');
  emit(exponent < 0 ? '-' : '+');

  char reversed[32]{};
  unsigned count = 0;

  do {
    reversed[count++] =
        static_cast<char>('0' + magnitude % 10);
    magnitude /= 10;
  } while (magnitude != 0);

  while (count < 2)
    reversed[count++] = '0';

  while (count != 0)
    emit(reversed[--count]);
}

inline constexpr unsigned shortest_decimal_digit_capacity = 40;

struct shortest_decimal_representation {
  char digits[shortest_decimal_digit_capacity]{};
  unsigned digit_count = 0;

  /*
   * The represented magnitude is:
   *
   *   integer(digits) * 10^exponent
   *
   * digits contains no leading or trailing zeroes except
   * for the representation of zero itself.
   */
  long long exponent = 0;
};

[[nodiscard]]
constexpr bool decrement_uint128(uint128& value) noexcept {
  using uint64_t = FTL_FLOATING_CONVERSION_STD::uint64_t;

  if (value.is_zero())
    return false;

  if (value.low != 0) {
    --value.low;
    return true;
  }

  value.low = ~uint64_t{0};
  --value.high;
  return true;
}

[[nodiscard]]
constexpr bool rounded_decimal_significand(
    const exact_decimal_digits& exact,
    unsigned significant_digits,
    uint128& significand,
    long long& exponent) noexcept {
  if (significant_digits == 0 ||
      significant_digits > exact.count ||
      significant_digits > shortest_decimal_digit_capacity)
    return false;

  big_uint<2> integer{};

  for (unsigned index = 0; index < significant_digits; ++index) {
    if (!integer.multiply(10))
      return false;

    if (!integer.add(
            static_cast<FTL_FLOATING_CONVERSION_STD::uint64_t>(
                exact.digits[index] - '0')))
      return false;
  }

  significand.low =
      integer.limb_count() > 0 ? integer.limb(0) : 0;

  significand.high =
      integer.limb_count() > 1 ? integer.limb(1) : 0;

  exponent =
      exact.exponent -
      static_cast<long long>(significant_digits - 1);

  if (significant_digits == exact.count)
    return true;

  const char first_discarded = exact.digits[significant_digits];

  bool discarded_nonzero = false;

  for (decltype(exact.count) index = significant_digits + 1;
       index < exact.count;
       ++index) {
    if (exact.digits[index] != '0') {
      discarded_nonzero = true;
      break;
    }
  }

  bool round_up = false;

  if (first_discarded > '5') {
    round_up = true;
  } else if (first_discarded == '5') {
    if (discarded_nonzero ||
        ((exact.digits[significant_digits - 1] - '0') & 1) != 0) {
      round_up = true;
    }
  }

  if (round_up)
    increment_uint128(significand);

  return true;
}

[[nodiscard]]
constexpr bool make_shortest_decimal_representation(
    uint128 significand,
    long long exponent,
    shortest_decimal_representation& output) noexcept {
  output = {};

  if (significand.is_zero()) {
    output.digits[0] = '0';
    output.digit_count = 1;
    output.exponent = 0;
    return true;
  }

  big_uint<2> integer(significand.low);

  if (significand.high != 0) {
    big_uint<2> high(significand.high);

    if (!high.shift_left(64))
      return false;

    if (!integer.add(high))
      return false;
  }

  char reversed[shortest_decimal_digit_capacity]{};
  unsigned count = 0;

  while (!integer.is_zero()) {
    if (count == shortest_decimal_digit_capacity)
      return false;

    const auto division = integer.divide(10);

    if (!division.success)
      return false;

    reversed[count++] =
        static_cast<char>('0' + division.remainder);
  }

  for (unsigned index = 0; index < count; ++index)
    output.digits[index] = reversed[count - index - 1];

  /*
   * Decimal trailing zeroes are part of the scale, not
   * the shortest significand.
   */
  while (count > 1 && output.digits[count - 1] == '0') {
    --count;
    ++exponent;
  }

  output.digit_count = count;
  output.exponent = exponent;
  return true;
}

[[nodiscard]]
constexpr char hexadecimal_digit_character(unsigned value) noexcept {
  return value < 10
      ? static_cast<char>('0' + value)
      : static_cast<char>('a' + value - 10);
}

[[nodiscard]]
constexpr unsigned uint128_hexadecimal_digit(uint128 value,
                                             unsigned index) noexcept {
  const unsigned shift = index * 4;

  if (shift < 64)
    return static_cast<unsigned>((value.low >> shift) & 0xfu);

  return static_cast<unsigned>((value.high >> (shift - 64)) & 0xfu);
}

[[nodiscard]]
constexpr unsigned hexadecimal_exponent_digits(long long exponent) noexcept {
  unsigned long long magnitude = decimal_exponent_magnitude(exponent);
  unsigned digits = 1;

  while (magnitude >= 10) {
    magnitude /= 10;
    ++digits;
  }

  return digits;
}

template <class Emit>
constexpr void emit_hexadecimal_exponent(long long exponent, Emit&& emit) {
  unsigned long long magnitude = decimal_exponent_magnitude(exponent);

  emit('p');
  emit(exponent < 0 ? '-' : '+');

  char reversed[32]{};
  unsigned count = 0;

  do {
    reversed[count++] = static_cast<char>('0' + magnitude % 10);
    magnitude /= 10;
  } while (magnitude != 0);

  while (count != 0)
    emit(reversed[--count]);
}

[[nodiscard]]
constexpr char* trim_general_fixed(char* first, char* last) noexcept {
  char* point = first;

  while (point != last && *point != '.')
    ++point;

  if (point == last)
    return last;

  char* end = last;

  while (end != point + 1 && end[-1] == '0')
    --end;

  if (end == point + 1)
    --end;

  return end;
}

[[nodiscard]]
constexpr char* trim_general_scientific(char* first, char* last) noexcept {
  char* exponent = first;

  while (exponent != last && *exponent != 'e')
    ++exponent;

  if (exponent == last)
    return last;

  char* point = first;

  while (point != exponent && *point != '.')
    ++point;

  if (point == exponent)
    return last;

  char* mantissa_end = exponent;

  while (mantissa_end != point + 1 && mantissa_end[-1] == '0')
    --mantissa_end;

  if (mantissa_end == point + 1)
    --mantissa_end;

  char* output = mantissa_end;

  for (char* source = exponent; source != last; ++source)
    *output++ = *source;

  return output;
}

template <class Float>
[[nodiscard]]
constexpr bool rounded_decimal_exponent(
    const binary_parts<Float>& parts,
    unsigned significant_digits,
    long long& exponent) noexcept {
  if (parts.kind == floating_kind::zero) {
    exponent = 0;
    return true;
  }

  exact_decimal_digits decimal{};

  if (!build_exact_decimal_digits(parts, decimal))
    return false;

  if (static_cast<decltype(sizeof(0))>(significant_digits) < decimal.count) {
    round_decimal_significant_digits(
        decimal,
        static_cast<decltype(sizeof(0))>(significant_digits));
  }

  exponent = decimal.exponent;
  return true;
}

[[nodiscard]]
constexpr uint128 shift_left_one(uint128 value) noexcept {
  return {value.low << 1, (value.high << 1) | (value.low >> 63)};
}

[[nodiscard]]
constexpr uint128 shift_right_one(uint128 value) noexcept {
  return {(value.low >> 1) | (value.high << 63), value.high >> 1};
}

[[nodiscard]]
constexpr bool uint128_is_odd(uint128 value) noexcept {
  return (value.low & 1u) != 0;
}

/*
 * Transactionally multiply a fixed bigint by a
 * portable 128-bit integer:
 *
 *   value * (high * 2^64 + low)
 */
template <decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr bool multiply_uint128(big_uint<Limbs> &value,
                                uint128 factor) noexcept {
  big_uint<Limbs> low_part = value;
  big_uint<Limbs> high_part = value;

  if (!low_part.multiply(factor.low))
    return false;

  if (!high_part.multiply(factor.high))
    return false;

  if (!high_part.shift_left(64))
    return false;

  if (!low_part.add(high_part))
    return false;

  value = low_part;
  return true;
}

struct scaled_compare_result {
  bool success;
  int ordering;
};

/*
 * Compare:
 *
 *   numerator / denominator * 2^binary_shift
 *
 * against an unsigned integer factor.
 */
template <decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr scaled_compare_result
compare_scaled_to_integer(const big_uint<Limbs> &numerator,
                          const big_uint<Limbs> &denominator,
                          long long binary_shift, uint128 factor) noexcept {
  using integer_type = big_uint<Limbs>;
  using size_type = typename integer_type::size_type;

  integer_type scaled_denominator = denominator;

  if (!multiply_uint128(scaled_denominator, factor)) {
    return {false, 0};
  }

  if (binary_shift >= 0) {
    return {true,
            compare_shifted(numerator, static_cast<size_type>(binary_shift),
                            scaled_denominator, 0)};
  }

  return {true, compare_shifted(numerator, 0, scaled_denominator,
                                static_cast<size_type>(-binary_shift))};
}

struct rounded_quotient_result {
  bool success;
  uint128 value;
};

/*
 * Compute exactly:
 *
 *   round_to_nearest_even(
 *       numerator / denominator *
 *       2^binary_shift)
 *
 * The caller guarantees that the exact quotient is
 * less than 2^Precision.
 *
 * No bigint / bigint division is required. Since the
 * final quotient has at most 53 bits for the formats
 * handled by this slice, a binary search over the
 * integer result is both simple and exact.
 */
template <int Precision, decltype(sizeof(0)) Limbs>
[[nodiscard]]
constexpr rounded_quotient_result rounded_scaled_quotient(
    const big_uint<Limbs> &numerator, const big_uint<Limbs> &denominator,
    long long binary_shift, bool discarded_nonzero = false) noexcept {
  static_assert(Precision > 0);

  /*
   * binary128 requires 113 significant bits.
   * The midpoint comparison needs one additional
   * bit, so both comfortably fit uint128.
   */
  static_assert(Precision <= 113);

  uint128 quotient{};

  /*
   * Build floor(A / B) one quotient bit at a
   * time, most-significant first.
   *
   * The caller guarantees the exact result is
   * below 2^Precision.
   */
  for (int bit = Precision - 1; bit >= 0; --bit) {
    uint128 candidate = quotient;

    set_uint128_bit(candidate, static_cast<unsigned>(bit));

    const auto comparison = compare_scaled_to_integer(numerator, denominator,
                                                      binary_shift, candidate);

    if (!comparison.success)
      return {false, {}};

    if (comparison.ordering >= 0)
      quotient = candidate;
  }

  /*
   * Compare against:
   *
   *   quotient + 1/2
   *
   * exactly by comparing:
   *
   *   2A ? B * (2*quotient + 1)
   */
  uint128 midpoint = shift_left_one(quotient);

  increment_uint128(midpoint);

  const auto midpoint_comparison = compare_scaled_to_integer(
      numerator, denominator, binary_shift + 1, midpoint);

  if (!midpoint_comparison.success)
    return {false, {}};

  if (midpoint_comparison.ordering > 0) {
    increment_uint128(quotient);
  } else if (midpoint_comparison.ordering == 0) {
    /*
     * A discarded nonzero decimal tail means the
     * complete input lies strictly above the
     * retained midpoint.
     */
    if (discarded_nonzero || uint128_is_odd(quotient)) {
      increment_uint128(quotient);
    }
  }

  return {true, quotient};
}

