namespace detail {

template <class T>
concept member_size =
    !disable_sized_range<remove_cv_t<T>> &&
    requires(T &value) { requires integer_like<decltype(value.size())>; };

template <class T>
concept has_adl_size =
    class_or_enum<T> && !disable_sized_range<remove_cv_t<T>> &&
    requires(T &value) {
      requires integer_like<decltype(detail::adl_size(value))>;
    };

template <class T>
concept subtraction_size =
    forward_iterator<iterator_t<T>> &&
    sized_sentinel_for<sentinel_t<T>, iterator_t<T>> &&
    requires(T &value) { ranges::end(value) - ranges::begin(value); };

template <class Difference>
using unsigned_like_t = make_unsigned_t<remove_cv_t<Difference>>;

template <class T> consteval bool size_noexcept() {
  if constexpr (is_array_v<T>) {
    return true;
  } else if constexpr (member_size<T>) {
    return noexcept(declval<T &>().size());
  } else if constexpr (has_adl_size<T>) {
    return noexcept(detail::adl_size(declval<T &>()));
  } else {
    return noexcept(ranges::end(declval<T &>()) -
                    ranges::begin(declval<T &>()));
  }
}

struct size_fn {
  template <class T>
    requires((is_array_v<remove_reference_t<T>> &&
              extent_v<remove_reference_t<T>> != 0) ||
             member_size<remove_reference_t<T>> ||
             has_adl_size<remove_reference_t<T>> ||
             subtraction_size<remove_reference_t<T>>)
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(size_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (is_array_v<U>) {
      return extent_v<U>;
    } else if constexpr (member_size<U>) {
      return value.size();
    } else if constexpr (has_adl_size<U>) {
      return detail::adl_size(value);
    } else {
      using Difference = decltype(ranges::end(value) - ranges::begin(value));

      return static_cast<unsigned_like_t<Difference>>(ranges::end(value) -
                                                      ranges::begin(value));
    }
  }
};

} // namespace detail

inline constexpr detail::size_fn size{};

template <class T>
concept sized_range = range<T> && requires(T &value) { ranges::size(value); };

template <sized_range T>
using range_size_t = decltype(ranges::size(declval<T &>()));

namespace detail {

struct ssize_fn {
  template <class T>
    requires requires(T &&value) { ranges::size(static_cast<T &&>(value)); }
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(noexcept(ranges::size(static_cast<T &&>(value)))) {
    using Size = decltype(ranges::size(static_cast<T &&>(value)));
    using Result = common_type_t<ptrdiff_t, make_signed_t<Size>>;

    return static_cast<Result>(ranges::size(static_cast<T &&>(value)));
  }
};

template <class T>
concept member_empty = requires(T &value) { static_cast<bool>(value.empty()); };

template <class T>
concept size_empty = requires(T &value) { ranges::size(value) == 0; };

template <class T>
concept iterator_empty = forward_iterator<iterator_t<T>> && requires(T &value) {
  static_cast<bool>(ranges::begin(value) == ranges::end(value));
};

template <class T> consteval bool empty_noexcept() {
  if constexpr (member_empty<T>) {
    return noexcept(static_cast<bool>(declval<T &>().empty()));
  } else if constexpr (size_empty<T>) {
    return noexcept(ranges::size(declval<T &>()) == 0);
  } else {
    return noexcept(static_cast<bool>(ranges::begin(declval<T &>()) ==
                                      ranges::end(declval<T &>())));
  }
}

struct empty_fn {
  template <class T>
    requires(member_empty<remove_reference_t<T>> ||
             size_empty<remove_reference_t<T>> ||
             iterator_empty<remove_reference_t<T>>)
  [[nodiscard]]
  constexpr bool operator()(T &&value) const
      noexcept(empty_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (member_empty<U>) {
      return static_cast<bool>(value.empty());
    } else if constexpr (size_empty<U>) {
      return ranges::size(value) == 0;
    } else {
      return static_cast<bool>(ranges::begin(value) == ranges::end(value));
    }
  }
};

template <class T>
concept member_data = requires(T &value) {
  requires is_pointer_v<decltype(value.data())>;
  requires is_object_v<remove_pointer_t<decltype(value.data())>>;
};

template <class T>
concept iterator_data =
    contiguous_iterator<iterator_t<T>> &&
    requires(T &value) {
      FTL_RANGE_ACCESS_NAMESPACE::detail::iterator_to_address(
          ranges::begin(value));
    };

template <class T> consteval bool data_noexcept() {
  if constexpr (member_data<T>) {
    return noexcept(declval<T &>().data());
  } else {
    return noexcept(FTL_RANGE_ACCESS_NAMESPACE::detail::iterator_to_address(
        ranges::begin(declval<T &>())));
  }
}

struct data_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             (member_data<remove_reference_t<T>> ||
              iterator_data<remove_reference_t<T>>))
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(data_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (member_data<U>) {
      return value.data();
    } else {
      return FTL_RANGE_ACCESS_NAMESPACE::detail::iterator_to_address(
          ranges::begin(value));
    }
  }
};

} // namespace detail

