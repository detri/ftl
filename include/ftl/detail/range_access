FTL_BEGIN_NAMESPACE

struct from_range_t {
  explicit from_range_t() = default;
};

inline constexpr from_range_t from_range{};

namespace ranges {

template <class> inline constexpr bool enable_borrowed_range = false;

template <class> inline constexpr bool disable_sized_range = false;

namespace detail {

template <class T> constexpr T *range_access_addressof(T &value) noexcept {
#if defined(_MSC_VER) || __has_builtin(__builtin_addressof)
  return __builtin_addressof(value);
#else
  return &value;
#endif
}

template <class T, class = void> inline constexpr bool complete_type = false;

template <class T>
inline constexpr bool complete_type<T, void_t<decltype(sizeof(T))>> = true;

template <class T>
concept borrowable_range_argument =
    is_lvalue_reference_v<T> || enable_borrowed_range<remove_cvref_t<T>>;

template <class T>
concept class_or_enum =
    is_class_v<remove_reference_t<T>> || is_enum_v<remove_reference_t<T>>;

template <class T>
concept integer_like =
    integral<remove_cv_t<T>> && !same_as<remove_cv_t<T>, bool>;

/*
 * Poison pills force unqualified calls below to use ADL only.
 */
void begin() = delete;
void end() = delete;
void rbegin() = delete;
void rend() = delete;
void size() = delete;

template <class T>
constexpr auto adl_begin(T &value) noexcept(noexcept(begin(value)))
    -> decltype(begin(value)) {
  return begin(value);
}

template <class T>
constexpr auto adl_end(T &value) noexcept(noexcept(end(value)))
    -> decltype(end(value)) {
  return end(value);
}

template <class T>
constexpr auto adl_rbegin(T &value) noexcept(noexcept(rbegin(value)))
    -> decltype(rbegin(value)) {
  return rbegin(value);
}

template <class T>
constexpr auto adl_rend(T &value) noexcept(noexcept(rend(value)))
    -> decltype(rend(value)) {
  return rend(value);
}

template <class T>
constexpr auto adl_size(T &value) noexcept(noexcept(size(value)))
    -> decltype(size(value)) {
  return size(value);
}

template <class T>
concept member_begin = requires(T &value) {
  { value.begin() } -> input_or_output_iterator;
};

template <class T>
concept has_adl_begin = class_or_enum<T> && requires(T &value) {
  { detail::adl_begin(value) } -> input_or_output_iterator;
};

template <class T> consteval bool begin_noexcept() {
  if constexpr (is_array_v<T>) {
    return true;
  } else if constexpr (member_begin<T>) {
    return noexcept(declval<T &>().begin());
  } else {
    return noexcept(detail::adl_begin(declval<T &>()));
  }
}

struct begin_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             (is_array_v<remove_reference_t<T>> ||
              member_begin<remove_reference_t<T>> ||
              has_adl_begin<remove_reference_t<T>>))
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(begin_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (is_array_v<U>) {
      static_assert(complete_type<remove_all_extents_t<U>>);
      return value + 0;
    } else if constexpr (member_begin<U>) {
      return value.begin();
    } else {
      return detail::adl_begin(value);
    }
  }
};

} // namespace detail

inline constexpr detail::begin_fn begin{};

template <class T> using iterator_t = decltype(ranges::begin(declval<T &>()));

namespace detail {

template <class T>
concept member_end = requires(T &value) {
  { value.end() } -> sentinel_for<iterator_t<T>>;
};

template <class T>
concept has_adl_end = class_or_enum<T> && requires(T &value) {
  { detail::adl_end(value) } -> sentinel_for<iterator_t<T>>;
};

template <class T> consteval bool end_noexcept() {
  if constexpr (is_array_v<T>) {
    return true;
  } else if constexpr (member_end<T>) {
    return noexcept(declval<T &>().end());
  } else {
    return noexcept(detail::adl_end(declval<T &>()));
  }
}

struct end_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             ((is_array_v<remove_reference_t<T>> &&
               extent_v<remove_reference_t<T>> != 0) ||
              member_end<remove_reference_t<T>> ||
              has_adl_end<remove_reference_t<T>>))
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(end_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (is_array_v<U>) {
      static_assert(complete_type<remove_all_extents_t<U>>);
      return value + extent_v<U>;
    } else if constexpr (member_end<U>) {
      return value.end();
    } else {
      return detail::adl_end(value);
    }
  }
};

} // namespace detail

inline constexpr detail::end_fn end{};

template <class T>
concept range = requires(T &value) {
  ranges::begin(value);
  ranges::end(value);
};

template <range T> using sentinel_t = decltype(ranges::end(declval<T &>()));

template <class T>
concept input_range = range<T> && input_iterator<iterator_t<T>>;

namespace detail {

template <class R>
[[nodiscard]]
constexpr auto &possibly_const_range(R &value) noexcept {
  if constexpr (input_range<const R>) {
    return static_cast<const R &>(value);
  } else {
    return value;
  }
}

template <class T> consteval bool cbegin_noexcept() {
  using R = remove_reference_t<T>;
  using P = decltype(possibly_const_range(declval<R &>()));
  using I = decltype(ranges::begin(declval<P>()));

  return noexcept(const_iterator<I>(ranges::begin(declval<P>())));
}

struct cbegin_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             requires(remove_reference_t<T> &value) {
               const_iterator<decltype(ranges::begin(
                   detail::possibly_const_range(value)))>(
                   ranges::begin(detail::possibly_const_range(value)));
             })
  [[nodiscard]]
  constexpr auto operator()(T &&value) const noexcept(cbegin_noexcept<T>()) {
    auto &selected = detail::possibly_const_range(value);
    auto current = ranges::begin(selected);

    return const_iterator<decltype(current)>(
        FTL_RANGE_ACCESS_NAMESPACE::move(current));
  }
};

template <class T> consteval bool cend_noexcept() {
  using R = remove_reference_t<T>;
  using P = decltype(possibly_const_range(declval<R &>()));
  using S = decltype(ranges::end(declval<P>()));

  return noexcept(const_sentinel<S>(ranges::end(declval<P>())));
}

struct cend_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             requires(remove_reference_t<T> &value) {
               const_sentinel<decltype(ranges::end(detail::possibly_const_range(
                   value)))>(ranges::end(detail::possibly_const_range(value)));
             })
  [[nodiscard]]
  constexpr auto operator()(T &&value) const noexcept(cend_noexcept<T>()) {
    auto &selected = detail::possibly_const_range(value);
    auto current = ranges::end(selected);

    return const_sentinel<decltype(current)>(
        FTL_RANGE_ACCESS_NAMESPACE::move(current));
  }
};

} // namespace detail

inline constexpr detail::cbegin_fn cbegin{};
inline constexpr detail::cend_fn cend{};

template <range T> using const_iterator_t = const_iterator<iterator_t<T>>;

template <range T> using const_sentinel_t = const_sentinel<sentinel_t<T>>;

namespace detail {

template <class T>
concept member_rbegin = requires(T &value) {
  { value.rbegin() } -> input_or_output_iterator;
};

template <class T>
concept has_adl_rbegin = class_or_enum<T> && requires(T &value) {
  { detail::adl_rbegin(value) } -> input_or_output_iterator;
};

template <class T>
concept reversible_fallback = requires(T &value) {
  requires same_as<decltype(ranges::begin(value)),
                   decltype(ranges::end(value))>;

  requires bidirectional_iterator<decltype(ranges::begin(value))>;
};

template <class T> consteval bool rbegin_noexcept() {
  if constexpr (member_rbegin<T>) {
    return noexcept(declval<T &>().rbegin());
  } else if constexpr (has_adl_rbegin<T>) {
    return noexcept(detail::adl_rbegin(declval<T &>()));
  } else {
    return noexcept(make_reverse_iterator(ranges::end(declval<T &>())));
  }
}

struct rbegin_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             (member_rbegin<remove_reference_t<T>> ||
              has_adl_rbegin<remove_reference_t<T>> ||
              reversible_fallback<remove_reference_t<T>>))
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(rbegin_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (member_rbegin<U>) {
      return value.rbegin();
    } else if constexpr (has_adl_rbegin<U>) {
      return detail::adl_rbegin(value);
    } else {
      return make_reverse_iterator(ranges::end(value));
    }
  }
};

template <class T>
concept member_rend = requires(T &value) {
  {
    value.rend()
  } -> sentinel_for<decltype(declval<const rbegin_fn &>()(value))>;
};

template <class T>
concept has_adl_rend = class_or_enum<T> && requires(T &value) {
  {
    detail::adl_rend(value)
  } -> sentinel_for<decltype(declval<const rbegin_fn &>()(value))>;
};

template <class T> consteval bool rend_noexcept() {
  if constexpr (member_rend<T>) {
    return noexcept(declval<T &>().rend());
  } else if constexpr (has_adl_rend<T>) {
    return noexcept(detail::adl_rend(declval<T &>()));
  } else {
    return noexcept(make_reverse_iterator(ranges::begin(declval<T &>())));
  }
}

struct rend_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             (member_rend<remove_reference_t<T>> ||
              has_adl_rend<remove_reference_t<T>> ||
              reversible_fallback<remove_reference_t<T>>))
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(rend_noexcept<remove_reference_t<T>>()) {
    using U = remove_reference_t<T>;

    if constexpr (member_rend<U>) {
      return value.rend();
    } else if constexpr (has_adl_rend<U>) {
      return detail::adl_rend(value);
    } else {
      return make_reverse_iterator(ranges::begin(value));
    }
  }
};

} // namespace detail

