inline constexpr detail::data_fn data{};

namespace detail {

template <class T>
[[nodiscard]]
constexpr const T *as_const_pointer(const T *pointer) noexcept {
  return pointer;
}

struct cdata_fn {
  template <class T>
    requires(borrowable_range_argument<T &&> &&
             requires(remove_reference_t<T> &value) {
               detail::as_const_pointer(
                   ranges::data(detail::possibly_const_range(value)));
             })
  [[nodiscard]]
  constexpr auto operator()(T &&value) const
      noexcept(noexcept(detail::as_const_pointer(
          ranges::data(detail::possibly_const_range(value))))) {
    auto &selected = detail::possibly_const_range(value);

    return detail::as_const_pointer(ranges::data(selected));
  }
};

} // namespace detail

