template <range T> using range_difference_t = iter_difference_t<iterator_t<T>>;

template <range T> using range_value_t = iter_value_t<iterator_t<T>>;

template <range T> using range_reference_t = iter_reference_t<iterator_t<T>>;

template <range T>
using range_const_reference_t = iter_const_reference_t<iterator_t<T>>;

template <range T>
using range_rvalue_reference_t = iter_rvalue_reference_t<iterator_t<T>>;

template <range T>
using range_common_reference_t = iter_common_reference_t<iterator_t<T>>;

template <class T>
concept forward_range = input_range<T> && forward_iterator<iterator_t<T>>;

template <class T>
concept bidirectional_range =
    forward_range<T> && bidirectional_iterator<iterator_t<T>>;

template <class T>
concept random_access_range =
    bidirectional_range<T> && random_access_iterator<iterator_t<T>>;

template <class T>
concept contiguous_range =
    random_access_range<T> && contiguous_iterator<iterator_t<T>> &&
    requires(T &value) {
      { ranges::data(value) } -> same_as<add_pointer_t<range_reference_t<T>>>;
    };

template <class R, class T>
concept output_range = range<R> && output_iterator<iterator_t<R>, T>;

template <class T>
concept common_range = range<T> && same_as<iterator_t<T>, sentinel_t<T>>;

template <class T>
concept constant_range = input_range<T> && constant_iterator<iterator_t<T>>;

template <class T>
concept borrowed_range = range<T> && detail::borrowable_range_argument<T>;

// [range.view]

class view_base {};

template <class Derived>
  requires(is_class_v<Derived> && same_as<Derived, remove_cv_t<Derived>>)
class view_interface;

namespace detail {

/*
 * Deduction of U succeeds only when Derived publicly and unambiguously
 * inherits exactly one view_interface specialization, which is what
 * is-derived-from-view-interface requires.
 */
template <class Derived, class U>
  requires(!same_as<Derived, view_interface<U>>)
void view_interface_base_of(const Derived &, const view_interface<U> &);

template <class T>
concept derived_from_view_interface =
    requires(const T &value) { detail::view_interface_base_of(value, value); };

template <class T> inline constexpr bool is_initializer_list_v = false;

template <class T>
inline constexpr bool is_initializer_list_v<initializer_list<T>> = true;

} // namespace detail

template <class T>
inline constexpr bool enable_view =
    derived_from<T, view_base> || detail::derived_from_view_interface<T>;

template <class T>
concept view = range<T> && movable<T> && enable_view<T>;

template <class T>
concept viewable_range =
    range<T> &&
    ((view<remove_cvref_t<T>> && constructible_from<remove_cvref_t<T>, T>) ||
     (!view<remove_cvref_t<T>> &&
      (is_lvalue_reference_v<T> ||
       (movable<remove_reference_t<T>> &&
        !detail::is_initializer_list_v<remove_cvref_t<T>>))));

} // namespace ranges

