template <class C, class T> struct regex_access {
  static const rx_program<C, T> &program(const basic_regex<C, T> &r) {
    return r.program_;
  }
  static const T &traits(const basic_regex<C, T> &r) { return r.traits_; }
  static size_t marks(const basic_regex<C, T> &r) { return r.marks_; }
  static bool valid(const basic_regex<C, T> &r) { return r.valid_; }
  static size_t captures(const basic_regex<C, T> &r) {
    return r.capture_count_;
  }
};

template <class BI> BI iter_at(BI i, size_t n) {
  while (n--)
    ++i;
  return i;
}

template <class BI, class A> struct match_access {
  using M = match_results<BI, A>;

  static void fail(M &m, BI origin, BI last) {
    m.ready_ = true;
    m.subs_.clear();
    m.origin_ = origin;
    m.unmatched_.first = m.unmatched_.second = last;
    m.unmatched_.matched = false;
    m.prefix_ = m.suffix_ = m.unmatched_;
  }

  static void assign(M &m, BI origin, BI search_first, BI last,
                     const vector<rx_cap> &caps) {
    m.ready_ = true;
    m.origin_ = origin;
    m.subs_.resize(caps.size());
    m.unmatched_.first = m.unmatched_.second = last;
    m.unmatched_.matched = false;

    for (size_t i = 0; i < caps.size(); ++i) {
      auto &d = m.subs_[i];
      if (caps[i].matched) {
        d.first = iter_at(origin, caps[i].first);
        d.second = iter_at(origin, caps[i].second);
        d.matched = true;
      } else
        d = m.unmatched_;
    }

    if (!m.subs_.empty() && m.subs_[0].matched) {
      m.prefix_.first = search_first;
      m.prefix_.second = m.subs_[0].first;
      m.prefix_.matched = m.prefix_.first != m.prefix_.second;
      m.suffix_.first = m.subs_[0].second;
      m.suffix_.second = last;
      m.suffix_.matched = m.suffix_.first != m.suffix_.second;
    } else
      m.prefix_ = m.suffix_ = m.unmatched_;
  }

  static void adjust_prefix_first(M &m, BI first) {
    if (!m.ready_ || m.subs_.empty() || !m.subs_[0].matched)
      return;
    m.prefix_.first = first;
    m.prefix_.matched = m.prefix_.first != m.prefix_.second;
  }
};

template <class BI, class A, class C, class T>
bool rx_search_impl(BI origin, BI first, BI last, match_results<BI, A> &m,
                    const basic_regex<C, T> &re,
                    regex_constants::match_flag_type flags, bool full = false) {
  if (!regex_access<C, T>::valid(re)) {
    match_access<BI, A>::fail(m, origin, last);
    return false;
  }

  bool prev_available = match_has(flags, regex_constants::match_prev_avail);
  C prev_char{};

  if (prev_available) {
    BI prev = first;
    --prev;
    prev_char = static_cast<C>(*prev);
  }

  basic_string<C> input;
  size_t offset = 0;
  for (auto i = origin; i != last; ++i) {
    if (i == first)
      offset = input.size();
    input.push_back(static_cast<C>(*i));
  }
  if (first == last)
    offset = input.size();

  auto &p = regex_access<C, T>::program(re);
  auto &tr = regex_access<C, T>::traits(re);
  size_t caps = regex_access<C, T>::captures(re) + 1;

  if (full) {
    auto r = rx_run(p, input, offset, true, flags, tr, caps, offset,
                    prev_available, prev_char);
    if (r.ok) {
      if (syntax_has(p.flags, regex_constants::nosubs) && r.caps.size() > 1)
        r.caps.resize(1);
      match_access<BI, A>::assign(m, origin, first, last, r.caps);
      return true;
    }
    match_access<BI, A>::fail(m, origin, last);
    return false;
  }

  bool continuous = match_has(flags, regex_constants::match_continuous);
  for (size_t s = offset; s <= input.size(); ++s) {
    auto r = rx_run(p, input, s, false, flags, tr, caps, offset, prev_available,
                    prev_char);
    if (r.ok) {
      if (syntax_has(p.flags, regex_constants::nosubs) && r.caps.size() > 1)
        r.caps.resize(1);
      match_access<BI, A>::assign(m, origin, first, last, r.caps);
      return true;
    }
    if (continuous)
      break;
  }
  match_access<BI, A>::fail(m, origin, last);
  return false;
}

