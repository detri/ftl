  regex_token_iterator(
      BI first, BI last, const regex_type &re, initializer_list<int> subs,
      regex_constants::match_flag_type flags = regex_constants::match_default)
      : begin_(first), end_(last), re_(addressof(re)), flags_(flags),
        pos_(first, last, re, flags), rend_(), subs_(subs), last_end_(first) {
    init();
  }

  template <size_t N>
  regex_token_iterator(
      BI first, BI last, const regex_type &re, const int (&subs)[N],
      regex_constants::match_flag_type flags = regex_constants::match_default)
      : begin_(first), end_(last), re_(addressof(re)), flags_(flags),
        pos_(first, last, re, flags), rend_(), subs_(subs, subs + N),
        last_end_(first) {
    init();
  }

  regex_token_iterator(BI, BI, const regex_type &&, int = 0,
                       regex_constants::match_flag_type =
                           regex_constants::match_default) = delete;

  regex_token_iterator(BI, BI, const regex_type &&, const vector<int> &,
                       regex_constants::match_flag_type =
                           regex_constants::match_default) = delete;

  regex_token_iterator(BI, BI, const regex_type &&, initializer_list<int>,
                       regex_constants::match_flag_type =
                           regex_constants::match_default) = delete;

  template <size_t N>
  regex_token_iterator(BI, BI, const regex_type &&, const int (&)[N],
                       regex_constants::match_flag_type =
                           regex_constants::match_default) = delete;

  reference operator*() const { return current_; }
  pointer operator->() const { return addressof(current_); }

  regex_token_iterator &operator++() {
    if (done_)
      return *this;
    if (suffix_) {
      done_ = true;
      return *this;
    }

    if (++sub_index_ < subs_.size()) {
      load();
      return *this;
    }

    last_end_ = (*pos_)[0].second;
    ++pos_;
    sub_index_ = 0;

    if (pos_ != rend_) {
      load();
      return *this;
    }

    if (has_minus_one() && last_end_ != end_) {
      current_.first = last_end_;
      current_.second = end_;
      current_.matched = true;
      suffix_ = true;
      return *this;
    }

    done_ = true;
    return *this;
  }

  regex_token_iterator operator++(int) {
    auto t = *this;
    ++*this;
    return t;
  }

  bool operator==(const regex_token_iterator &x) const {
    if (done_ && x.done_)
      return true;
    if (done_ != x.done_)
      return false;

    return begin_ == x.begin_ && end_ == x.end_ && re_ == x.re_ &&
           flags_ == x.flags_ && subs_ == x.subs_ &&
           sub_index_ == x.sub_index_ && suffix_ == x.suffix_ && pos_ == x.pos_;
  }

  bool operator==(default_sentinel_t) const {
    return *this == regex_token_iterator();
  }

private:
  bool has_minus_one() const {
    for (int x : subs_)
      if (x == -1)
        return true;
    return false;
  }

  void init() {
    if (subs_.empty()) {
      done_ = true;
      return;
    }

    if (pos_ != rend_) {
      done_ = false;
      load();
      return;
    }

    if (has_minus_one() && begin_ != end_) {
      current_.first = begin_;
      current_.second = end_;
      current_.matched = true;
      done_ = false;
      suffix_ = true;
    } else {
      done_ = true;
    }
  }

  void load() {
    int s = subs_[sub_index_];

    if (s == -1) {
      current_.first = last_end_;
      current_.second = (*pos_)[0].first;
      current_.matched = true;
    } else if (s >= 0 && static_cast<size_t>(s) < pos_->size()) {
      current_ = (*pos_)[static_cast<size_t>(s)];
    } else {
      current_.first = current_.second = end_;
      current_.matched = false;
    }
  }

  BI begin_{}, end_{}, last_end_{};
  const regex_type *re_ = nullptr;
  regex_constants::match_flag_type flags_ = regex_constants::match_default;
  regex_iterator<BI, C, T> pos_{}, rend_{};
  vector<int> subs_;
  size_t sub_index_ = 0;
  value_type current_{};
  bool done_ = true, suffix_ = false;
};

using cregex_token_iterator = regex_token_iterator<const char *>;
using wcregex_token_iterator = regex_token_iterator<const wchar_t *>;
using sregex_token_iterator = regex_token_iterator<string::const_iterator>;
using wsregex_token_iterator = regex_token_iterator<wstring::const_iterator>;

template <class Out, class BI, class C, class T, class FI>
Out regex_replace(
    Out out, BI first, BI last, const basic_regex<C, T> &re, FI ff, FI fl,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  using namespace regex_constants;
  regex_iterator<BI, C, T> i(first, last, re, flags), e;
  BI copied = first;
  for (; i != e; ++i) {
    const auto &m = *i;
    if (!detail::match_has(flags, format_no_copy))
      out = copy(copied, m[0].first, out);
    out = m.format(out, ff, fl, flags);
    copied = m[0].second;
    if (detail::match_has(flags, format_first_only))
      break;
  }
  if (!detail::match_has(flags, format_no_copy))
    out = copy(copied, last, out);
  return out;
}

template <class Out, class BI, class C, class T>
Out regex_replace(
    Out out, BI first, BI last, const basic_regex<C, T> &re, const C *fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  return regex_replace(out, first, last, re, fmt,
                       fmt + char_traits<C>::length(fmt), flags);
}

template <class Out, class BI, class C, class T, class ST, class SA>
Out regex_replace(
    Out out, BI first, BI last, const basic_regex<C, T> &re,
    const basic_string<C, ST, SA> &fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  return regex_replace(out, first, last, re, fmt.begin(), fmt.end(), flags);
}

template <class C, class ST, class SA, class T, class FT, class FA>
basic_string<C, ST, SA> regex_replace(
    const basic_string<C, ST, SA> &s, const basic_regex<C, T> &re,
    const basic_string<C, FT, FA> &fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  basic_string<C, ST, SA> out;
  regex_replace(back_inserter(out), s.begin(), s.end(), re, fmt.begin(),
                fmt.end(), flags);
  return out;
}

template <class C, class ST, class SA, class T>
basic_string<C, ST, SA> regex_replace(
    const basic_string<C, ST, SA> &s, const basic_regex<C, T> &re, const C *fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  basic_string<C, ST, SA> out;
  regex_replace(back_inserter(out), s.begin(), s.end(), re, fmt,
                fmt + char_traits<C>::length(fmt), flags);
  return out;
}

template <class T, class C, class ST, class SA>
basic_string<C> regex_replace(
    const C *s, const basic_regex<C, T> &re, const basic_string<C, ST, SA> &fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  basic_string<C> out;
  const C *last = s + char_traits<C>::length(s);
  regex_replace(back_inserter(out), s, last, re, fmt, flags);
  return out;
}

template <class T, class C>
basic_string<C> regex_replace(
    const C *s, const basic_regex<C, T> &re, const C *fmt,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  basic_string<C> out;
  const C *last = s + char_traits<C>::length(s);
  regex_replace(back_inserter(out), s, last, re, fmt, flags);
  return out;
}

