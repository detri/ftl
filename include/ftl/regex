template <class BidirectionalIterator,
          class Allocator = allocator<sub_match<BidirectionalIterator>>>
class match_results {
public:
  using value_type = sub_match<BidirectionalIterator>;
  using const_reference = const value_type &;
  using reference = value_type &;
  using const_iterator = typename vector<value_type, Allocator>::const_iterator;
  using iterator = const_iterator;
  using difference_type =
      typename iterator_traits<BidirectionalIterator>::difference_type;
  using size_type = typename allocator_traits<Allocator>::size_type;
  using allocator_type = Allocator;
  using char_type = typename iterator_traits<BidirectionalIterator>::value_type;
  using string_type = basic_string<char_type>;

  match_results() : match_results(Allocator()) {}

  explicit match_results(const Allocator &a) : subs_(a) {}

  match_results(const match_results &) = default;

  match_results(const match_results &m, const Allocator &a)
      : subs_(m.subs_, a), prefix_(m.prefix_), suffix_(m.suffix_),
        unmatched_(m.unmatched_), origin_(m.origin_), ready_(m.ready_) {}

  match_results(match_results &&) noexcept = default;

  match_results(match_results &&m, const Allocator &a)
      : subs_(move(m.subs_), a), prefix_(m.prefix_), suffix_(m.suffix_),
        unmatched_(m.unmatched_), origin_(m.origin_), ready_(m.ready_) {}

  match_results &operator=(const match_results &) = default;
  match_results &operator=(match_results &&) = default;

  bool ready() const noexcept { return ready_; }
  size_type size() const noexcept { return subs_.size(); }
  size_type max_size() const noexcept { return subs_.max_size(); }
  bool empty() const noexcept { return subs_.empty(); }

  difference_type length(size_type n = 0) const { return (*this)[n].length(); }
  difference_type position(size_type n = 0) const {
    return distance(origin_, (*this)[n].first);
  }
  string_type str(size_type n = 0) const { return (*this)[n].str(); }

  const_reference operator[](size_type n) const {
    return n < subs_.size() ? subs_[n] : unmatched_;
  }
  const_reference prefix() const { return prefix_; }
  const_reference suffix() const { return suffix_; }

  const_iterator begin() const { return subs_.begin(); }
  const_iterator end() const { return subs_.end(); }
  const_iterator cbegin() const { return subs_.cbegin(); }
  const_iterator cend() const { return subs_.cend(); }

  template <class Out>
  Out format(Out out, const char_type *ff, const char_type *fl,
             regex_constants::match_flag_type flags =
                 regex_constants::format_default) const {
    using namespace regex_constants;

    auto emit = [&](const value_type &s) {
      if (s.matched) {
        for (auto i = s.first; i != s.second; ++i)
          *out++ = *i;
      }
    };

    //
    // POSIX sed replacement syntax.
    //
    if (detail::match_has(flags, format_sed)) {
      for (auto p = ff; p != fl; ++p) {
        if (detail::ascii_eq(*p, '&')) {
          emit((*this)[0]);
          continue;
        }

        if (detail::ascii_eq(*p, '\\') && p + 1 != fl) {
          ++p;

          if (detail::ascii_digit(*p)) {
            size_t n = static_cast<size_t>(*p - static_cast<char_type>('0'));

            emit((*this)[n]);
          } else {
            *out++ = *p;
          }

          continue;
        }

        *out++ = *p;
      }

      return out;
    }

    //
    // ECMAScript replacement syntax.
    //
    const size_t capture_count =
        size() == 0 ? 0 : static_cast<size_t>(size() - 1);

    for (auto p = ff; p != fl; ++p) {
      if (!detail::ascii_eq(*p, '$') || p + 1 == fl) {
        *out++ = *p;
        continue;
      }

      auto q = p + 1;

      if (detail::ascii_eq(*q, '$')) {
        *out++ = static_cast<char_type>('$');
        p = q;
        continue;
      }

      if (detail::ascii_eq(*q, '&')) {
        emit((*this)[0]);
        p = q;
        continue;
      }

      if (detail::ascii_eq(*q, '`')) {
        emit(prefix_);
        p = q;
        continue;
      }

      if (detail::ascii_eq(*q, '\'')) {
        emit(suffix_);
        p = q;
        continue;
      }

      if (detail::ascii_digit(*q)) {
        size_t digit_count = 1;

        if (q + 1 != fl && detail::ascii_digit(*(q + 1))) {
          digit_count = 2;
        }

        size_t n = static_cast<size_t>(*q - static_cast<char_type>('0'));

        if (digit_count == 2) {
          n = n * 10 +
              static_cast<size_t>(*(q + 1) - static_cast<char_type>('0'));

          //
          // ECMAScript's two-digit fallback:
          //
          //   $10 with one capture => $1 followed by literal '0'.
          //
          if (n > capture_count) {
            digit_count = 1;
            n = static_cast<size_t>(*q - static_cast<char_type>('0'));
          }
        }

        if (n >= 1 && n <= capture_count) {
          emit((*this)[n]);

          if (digit_count == 2)
            ++q;

          p = q;
          continue;
        }

        //
        // Invalid numeric references are literal, including $0.
        //
        *out++ = static_cast<char_type>('$');

        for (size_t i = 0; i < digit_count; ++i)
          *out++ = *(q + static_cast<ptrdiff_t>(i));

        p = q + static_cast<ptrdiff_t>(digit_count - 1);
        continue;
      }

      //
      // '$' followed by anything else is literal.
      //
      *out++ = *p;
    }

    return out;
  }

  string_type format(const char_type *fmt,
                     regex_constants::match_flag_type flags =
                         regex_constants::format_default) const {
    string_type out;
    format(back_inserter(out), fmt, fmt + char_traits<char_type>::length(fmt),
           flags);
    return out;
  }

  template <class Out, class ST, class SA>
  Out format(Out out, const basic_string<char_type, ST, SA> &fmt,
             regex_constants::match_flag_type flags =
                 regex_constants::format_default) const {
    return format(out, fmt.data(), fmt.data() + fmt.size(), flags);
  }

  template <class ST, class SA>
  basic_string<char_type, ST, SA>
  format(const basic_string<char_type, ST, SA> &fmt,
         regex_constants::match_flag_type flags =
             regex_constants::format_default) const {
    basic_string<char_type, ST, SA> out;
    format(back_inserter(out), fmt.data(), fmt.data() + fmt.size(), flags);
    return out;
  }

  allocator_type get_allocator() const { return subs_.get_allocator(); }

  void swap(match_results &x) {
    subs_.swap(x.subs_);
    auto p = prefix_;
    prefix_ = x.prefix_;
    x.prefix_ = p;
    auto s = suffix_;
    suffix_ = x.suffix_;
    x.suffix_ = s;
    auto u = unmatched_;
    unmatched_ = x.unmatched_;
    x.unmatched_ = u;
    auto o = origin_;
    origin_ = x.origin_;
    x.origin_ = o;
    bool r = ready_;
    ready_ = x.ready_;
    x.ready_ = r;
  }

private:
  vector<value_type, Allocator> subs_;
  value_type prefix_{}, suffix_{}, unmatched_{};
  BidirectionalIterator origin_{};
  bool ready_ = false;

  friend struct detail::match_access<BidirectionalIterator, Allocator>;
};

template <class BI, class A>
void swap(match_results<BI, A> &a, match_results<BI, A> &b) {
  a.swap(b);
}

template <class BI, class A>
bool operator==(const match_results<BI, A> &a, const match_results<BI, A> &b) {
  if (!a.ready() && !b.ready())
    return true;
  if (a.ready() != b.ready())
    return false;
  if (a.empty() || b.empty())
    return a.empty() && b.empty();
  return a.prefix() == b.prefix() && a.size() == b.size() &&
         equal(a.begin(), a.end(), b.begin()) && a.suffix() == b.suffix();
}

