template <class BI, class C = typename iterator_traits<BI>::value_type,
          class T = regex_traits<C>>
class regex_iterator {
public:
  using regex_type = basic_regex<C, T>;
  using value_type = match_results<BI>;
  using difference_type = ptrdiff_t;
  using pointer = const value_type *;
  using reference = const value_type &;
  using iterator_category = forward_iterator_tag;
  using iterator_concept = input_iterator_tag;

  regex_iterator() = default;

  regex_iterator(
      BI first, BI last, const regex_type &re,
      regex_constants::match_flag_type flags = regex_constants::match_default)
      : origin_(first), end_(last), re_(addressof(re)), flags_(flags) {
    find(first, flags_);
  }

  regex_iterator(BI, BI, const regex_type &&,
                 regex_constants::match_flag_type =
                     regex_constants::match_default) = delete;

  reference operator*() const { return match_; }
  pointer operator->() const { return addressof(match_); }

  regex_iterator &operator++() {
    if (done_)
      return *this;

    BI previous_end = match_[0].second;
    BI start = previous_end;
    bool empty = match_[0].first == match_[0].second;

    if (empty) {
      if (start == end_) {
        done_ = true;
        return *this;
      }

      value_type nonempty;
      auto f = flags_ | regex_constants::match_not_null |
               regex_constants::match_continuous;

      if (detail::rx_search_impl(origin_, start, end_, nonempty, *re_, f,
                                 false)) {
        match_ = move(nonempty);
        return *this;
      }

      ++start;
    }

    flags_ |= regex_constants::match_prev_avail;

    if (find(start, flags_)) {
      detail::match_access<BI, typename value_type::allocator_type>::
          adjust_prefix_first(match_, previous_end);
    }

    return *this;
  }

  regex_iterator operator++(int) {
    auto t = *this;
    ++*this;
    return t;
  }

  bool operator==(const regex_iterator &x) const {
    if (done_ && x.done_)
      return true;
    if (done_ != x.done_)
      return false;

    return origin_ == x.origin_ && end_ == x.end_ && re_ == x.re_ &&
           flags_ == x.flags_ && match_[0] == x.match_[0];
  }

  bool operator==(default_sentinel_t) const {
    return *this == regex_iterator();
  }

private:
  bool find(BI first, regex_constants::match_flag_type f) {
    if (!re_ ||
        !detail::rx_search_impl(origin_, first, end_, match_, *re_, f, false)) {
      done_ = true;
      return false;
    }

    done_ = false;
    return true;
  }

  BI origin_{}, end_{};
  const regex_type *re_ = nullptr;
  regex_constants::match_flag_type flags_ = regex_constants::match_default;
  value_type match_{};
  bool done_ = true;
};

