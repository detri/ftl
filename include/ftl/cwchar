inline wchar_t *wcscpy(wchar_t *s1, const wchar_t *s2) {
  wchar_t *result = s1;

  for (;;) {
    const wchar_t value = cwchar_detail::load(s2++);
    cwchar_detail::store(s1++, value);

    if (value == L'\0') {
      break;
    }
  }

  return result;
}

