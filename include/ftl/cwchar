FTL_CWCHAR_NO_BUILTIN
inline size_t wcsftime(wchar_t *s, size_t maxsize, const wchar_t *format,
                       const tm *timeptr) {
  cwchar_detail::time_writer writer{s, maxsize};

  const wchar_t *current = format;

  while (*current != L'\0') {
    if (*current != L'%') {
      writer.append(*current++);
      continue;
    }

    ++current;

    if (*current == L'\0') {
      writer.append(L'%');
      break;
    }

    /*
     * E and O request locale-specific alternative forms.
     * The C locale has no alternatives, so the modifier is
     * ignored and the ordinary conversion is used.
     */
    if (*current == L'E' || *current == L'O') {
      ++current;

      if (*current == L'\0') {
        break;
      }
    }

    cwchar_detail::append_time_format(writer, *current, *timeptr);

    ++current;
  }

  if (!writer.finish()) {
    return 0;
  }

  return writer.size;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcstok(wchar_t *s1, const wchar_t *s2, wchar_t **ptr) {
  wchar_t *current = s1 != nullptr ? s1 : *ptr;

  while (cwchar_detail::load(current) != L'\0' &&
         cwchar_detail::contains(s2, cwchar_detail::load(current))) {
    ++current;
  }

  if (cwchar_detail::load(current) == L'\0') {
    *ptr = current;
    return nullptr;
  }

  wchar_t *token = current;

  while (cwchar_detail::load(current) != L'\0' &&
         !cwchar_detail::contains(s2, cwchar_detail::load(current))) {
    ++current;
  }

  if (cwchar_detail::load(current) != L'\0') {
    cwchar_detail::store(current, L'\0');
    ++current;
  }

  *ptr = current;
  return token;
}

