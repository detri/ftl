  if (cwchar_detail::load(s2) == L'\0') {
    return s1;
  }

  while (cwchar_detail::load(s1) != L'\0') {
    const wchar_t *haystack = s1;
    const wchar_t *needle = s2;

    while (cwchar_detail::load(needle) != L'\0' &&
           cwchar_detail::load(haystack) == cwchar_detail::load(needle)) {
      ++haystack;
      ++needle;
