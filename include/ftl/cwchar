inline constexpr wint_t wide_eof = static_cast<wint_t>(~0u);

inline wchar_t load(const wchar_t *pointer) {
#if defined(_MSC_VER) && !defined(__clang__)
  return *static_cast<const volatile wchar_t *>(pointer);
#else
  return *pointer;
#endif
}

inline void store(wchar_t *pointer, wchar_t value) {
#if defined(_MSC_VER) && !defined(__clang__)
  *static_cast<volatile wchar_t *>(pointer) = value;
#else
  *pointer = value;
#endif
}

inline bool contains(const wchar_t *set, wchar_t value) {
  while (load(set) != L'\0') {
    if (load(set) == value) {
      return true;
    }

    ++set;
  }

  return false;
}

inline bool is_space(wchar_t value) {
  return value == L' ' || value == L'\t' || value == L'\n' || value == L'\v' ||
         value == L'\f' || value == L'\r';
}

inline int digit_value(wchar_t value) {
  if (value >= L'0' && value <= L'9') {
    return static_cast<int>(value - L'0');
  }

  if (value >= L'a' && value <= L'z') {
    return static_cast<int>(value - L'a') + 10;
  }

  if (value >= L'A' && value <= L'Z') {
    return static_cast<int>(value - L'A') + 10;
  }

  return -1;
}

inline bool valid_digit(wchar_t value, int base) {
  const int digit = digit_value(value);
  return digit >= 0 && digit < base;
}

inline const wchar_t *prepare_integer(const wchar_t *string, int &base,
                                      bool &negative) {
  const wchar_t *current = string;

  while (is_space(load(current))) {
    ++current;
  }

  negative = false;

  if (load(current) == L'+' || load(current) == L'-') {
    negative = load(current) == L'-';
    ++current;
  }

  if (base == 0) {
    if (load(current) == L'0') {
      if ((load(current + 1) == L'x' || load(current + 1) == L'X') &&
          valid_digit(load(current + 2), 16)) {
        base = 16;
        current += 2;
      } else {
        base = 8;
      }
    } else {
      base = 10;
    }
  } else if (base == 16 && load(current) == L'0' &&
             (load(current + 1) == L'x' || load(current + 1) == L'X') &&
             valid_digit(load(current + 2), 16)) {
    current += 2;
  }

  return current;
}

template <class Signed, class Unsigned>
Signed parse_signed_integer(const wchar_t *string, wchar_t **end, int base) {
  if (base != 0 && (base < 2 || base > 36)) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Signed{};
  }

  bool negative = false;
  const wchar_t *current = prepare_integer(string, base, negative);

  const wchar_t *digits_begin = current;

  const Unsigned positive_limit =
      static_cast<Unsigned>(numeric_limits<Signed>::max());

  const Unsigned limit =
      negative ? positive_limit + Unsigned{1} : positive_limit;

  Unsigned value = 0;
  bool overflow = false;

  for (;;) {
    const int digit = digit_value(load(current));

    if (digit < 0 || digit >= base) {
      break;
    }

    const auto unsigned_digit = static_cast<Unsigned>(digit);

    if (value > (limit - unsigned_digit) / static_cast<Unsigned>(base)) {
      overflow = true;
    } else if (!overflow) {
      value = value * static_cast<Unsigned>(base) + unsigned_digit;
    }

    ++current;
  }

  if (current == digits_begin) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Signed{};
  }

  if (end != nullptr) {
    *end = const_cast<wchar_t *>(current);
  }

  if (overflow) {
    errno = ERANGE;

    return negative ? numeric_limits<Signed>::min()
                    : numeric_limits<Signed>::max();
  }

  if (!negative) {
    return static_cast<Signed>(value);
  }

  if (value == positive_limit + Unsigned{1}) {
    return numeric_limits<Signed>::min();
  }

  return -static_cast<Signed>(value);
}

template <class Unsigned>
Unsigned parse_unsigned_integer(const wchar_t *string, wchar_t **end,
                                int base) {
  if (base != 0 && (base < 2 || base > 36)) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Unsigned{};
  }

  bool negative = false;
  const wchar_t *current = prepare_integer(string, base, negative);

  const wchar_t *digits_begin = current;

  constexpr Unsigned limit = numeric_limits<Unsigned>::max();

  Unsigned value = 0;
  bool overflow = false;

  for (;;) {
    const int digit = digit_value(load(current));

    if (digit < 0 || digit >= base) {
      break;
    }

    const auto unsigned_digit = static_cast<Unsigned>(digit);

    if (value > (limit - unsigned_digit) / static_cast<Unsigned>(base)) {
      overflow = true;
    } else if (!overflow) {
      value = value * static_cast<Unsigned>(base) + unsigned_digit;
    }

    ++current;
  }

  if (current == digits_begin) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Unsigned{};
  }

  if (end != nullptr) {
    *end = const_cast<wchar_t *>(current);
  }

  if (overflow) {
    errno = ERANGE;
    return limit;
  }

  return negative ? Unsigned{} - value : value;
}

inline wchar_t ascii_lower(wchar_t value) {
  if (value >= L'A' && value <= L'Z') {
    return static_cast<wchar_t>(value - L'A' + L'a');
  }

  return value;
}

inline bool matches_ascii_case_insensitive(const wchar_t *string,
                                           const wchar_t *expected) {
  while (*expected != L'\0') {
    const wchar_t actual = load(string);

    if (actual == L'\0') {
      return false;
    }

    if (ascii_lower(actual) != ascii_lower(*expected)) {
      return false;
    }

    ++string;
    ++expected;
  }

  return true;
}

inline bool nan_payload_character(wchar_t value) {
  return (value >= L'0' && value <= L'9') || (value >= L'a' && value <= L'z') ||
         (value >= L'A' && value <= L'Z') || value == L'_';
}

inline int decimal_digit_value(wchar_t value) {
  if (value >= L'0' && value <= L'9') {
    return static_cast<int>(value - L'0');
  }

  return -1;
}

inline int hexadecimal_digit_value(wchar_t value) {
  if (value >= L'0' && value <= L'9') {
    return static_cast<int>(value - L'0');
  }

  if (value >= L'a' && value <= L'f') {
    return static_cast<int>(value - L'a') + 10;
  }

  if (value >= L'A' && value <= L'F') {
    return static_cast<int>(value - L'A') + 10;
  }

  return -1;
}

inline void adjust_float_exponent(int &exponent, int adjustment) {
  constexpr int exponent_limit = 100000;

  if (adjustment > 0) {
    if (exponent > exponent_limit - adjustment) {
      exponent = exponent_limit;
    } else {
      exponent += adjustment;
    }
  } else {
    if (exponent < -exponent_limit - adjustment) {
      exponent = -exponent_limit;
    } else {
      exponent += adjustment;
    }
  }
}

inline bool parse_float_exponent(const wchar_t *string, const wchar_t *&end,
                                 int &exponent) {
  const wchar_t *current = string;

  bool negative = false;

  if (load(current) == L'+' || load(current) == L'-') {
    negative = load(current) == L'-';
    ++current;
  }

  if (decimal_digit_value(load(current)) < 0) {
    return false;
  }

  constexpr int exponent_limit = 100000;
  int magnitude = 0;

  while (true) {
    const int digit = decimal_digit_value(load(current));

    if (digit < 0) {
      break;
    }

    if (magnitude < exponent_limit) {
      if (magnitude > (exponent_limit - digit) / 10) {
        magnitude = exponent_limit;
      } else {
        magnitude = magnitude * 10 + digit;
      }
    }

    ++current;
  }

  exponent = negative ? -magnitude : magnitude;
  end = current;
  return true;
}

inline long double scale_float(long double value, int base, int exponent) {
  if (value == 0.0L || exponent == 0) {
    return value;
  }

  const bool divide = exponent < 0;

  unsigned int magnitude =
      static_cast<unsigned int>(divide ? -exponent : exponent);

  long double factor = static_cast<long double>(base);

  while (magnitude != 0) {
    if ((magnitude & 1u) != 0) {
      value = divide ? value / factor : value * factor;
    }

    magnitude >>= 1u;

    if (magnitude != 0) {
      factor *= factor;
    }
  }

  return value;
}

inline bool has_hexadecimal_significand(const wchar_t *string) {
  if (load(string) != L'0' ||
      (load(string + 1) != L'x' && load(string + 1) != L'X')) {
    return false;
  }

  const wchar_t *current = string + 2;
  bool have_digit = false;

  while (hexadecimal_digit_value(load(current)) >= 0) {
    have_digit = true;
    ++current;
  }

  if (load(current) == L'.') {
    ++current;

    while (hexadecimal_digit_value(load(current)) >= 0) {
      have_digit = true;
      ++current;
    }
  }

  return have_digit;
}

template <class Float>
Float finish_floating_conversion(long double magnitude, bool negative,
                                 bool mathematically_nonzero) {
  if (magnitude > static_cast<long double>(numeric_limits<Float>::max())) {
    errno = ERANGE;

    const Float infinity = numeric_limits<Float>::infinity();

    return negative ? -infinity : infinity;
  }

  if (mathematically_nonzero && magnitude == 0.0L) {
    errno = ERANGE;

    const Float zero = Float{};
    return negative ? -zero : zero;
  }

  const Float result = static_cast<Float>(magnitude);

  /*
   * If conversion to the narrower destination flushed a
   * nonzero value to zero, this is an underflow.
   *
   * For a representable nonzero subnormal result, whether
   * errno becomes ERANGE is implementation-defined; FTL
   * leaves it unchanged.
   */
  if (mathematically_nonzero && result == Float{} && magnitude != 0.0L) {
    errno = ERANGE;

    const Float zero = Float{};
    return negative ? -zero : zero;
  }

  return negative ? -result : result;
}

template <class Float>
Float parse_floating(const wchar_t *string, wchar_t **end) {
  const wchar_t *const original = string;
  const wchar_t *current = string;

  while (is_space(load(current))) {
    ++current;
  }

  bool negative = false;

  if (load(current) == L'+' || load(current) == L'-') {
    negative = load(current) == L'-';
    ++current;
  }

  /*
   * C requires either INFINITY, or INF when the following
   * character does not continue an INFINITY prefix.
   */
  if (matches_ascii_case_insensitive(current, L"infinity")) {
    current += 8;

    if (end != nullptr) {
      *end = const_cast<wchar_t *>(current);
    }

    const Float infinity = numeric_limits<Float>::infinity();

    return negative ? -infinity : infinity;
  }

  if (matches_ascii_case_insensitive(current, L"inf") &&
      ascii_lower(load(current + 3)) != L'i') {
    current += 3;

    if (end != nullptr) {
      *end = const_cast<wchar_t *>(current);
    }

    const Float infinity = numeric_limits<Float>::infinity();

    return negative ? -infinity : infinity;
  }

  if (matches_ascii_case_insensitive(current, L"nan")) {
    const wchar_t *nan_end = current + 3;

    if (load(nan_end) == L'(') {
      const wchar_t *payload = nan_end + 1;

      while (nan_payload_character(load(payload))) {
        ++payload;
      }

      /*
       * NAN followed by '(' is accepted only when the
       * payload is syntactically complete.
       */
      if (load(payload) != L')') {
        if (end != nullptr) {
          *end = const_cast<wchar_t *>(original);
        }

        return Float{};
      }

      nan_end = payload + 1;
    }

    if (end != nullptr) {
      *end = const_cast<wchar_t *>(nan_end);
    }

    const Float nan = numeric_limits<Float>::quiet_NaN();

    return negative ? -nan : nan;
  }

  const bool hexadecimal = has_hexadecimal_significand(current);

  const int base = hexadecimal ? 16 : 10;
  const int digit_exponent = hexadecimal ? 4 : 1;

  if (hexadecimal) {
    current += 2;
  }

  const wchar_t *significand_begin = current;

  /*
   * Keep a few guard digits beyond the precision of long
   * double. Extra digits are represented as a fractional tail
   * and an exponent adjustment, so arbitrarily long inputs do
   * not overflow the accumulator merely because they contain
   * many digits.
   */
  const int maximum_stored_digits =
      hexadecimal ? (numeric_limits<long double>::digits + 3) / 4 + 2
                  : numeric_limits<long double>::digits10 + 4;

  long double significand = 0.0L;
  long double tail = 0.0L;
  long double tail_factor = 1.0L / static_cast<long double>(base);

  int stored_digits = 0;
  int scale_exponent = 0;

  bool after_point = false;
  bool point_seen = false;
  bool have_digit = false;
  bool have_nonzero_digit = false;
  bool dropping_digits = false;

  for (;;) {
    const wchar_t value = load(current);

    const int digit = hexadecimal ? hexadecimal_digit_value(value)
                                  : decimal_digit_value(value);

    if (digit >= 0) {
      have_digit = true;

      if (after_point) {
        adjust_float_exponent(scale_exponent, -digit_exponent);
      }

      if (digit != 0 || have_nonzero_digit) {
        have_nonzero_digit = true;

        if (stored_digits < maximum_stored_digits) {
          significand = significand * static_cast<long double>(base) +
                        static_cast<long double>(digit);

          ++stored_digits;
        } else {
          /*
           * Factoring each discarded digit out into
           * the exponent keeps the leading
           * significand bounded:
           *
           * 123456 -> 123.456 * 10^3
           */
          adjust_float_exponent(scale_exponent, digit_exponent);

          if (!dropping_digits) {
            dropping_digits = true;
            tail_factor = 1.0L / static_cast<long double>(base);
          }

          tail += static_cast<long double>(digit) * tail_factor;

          tail_factor /= static_cast<long double>(base);
        }
      }

      ++current;
      continue;
    }

    if (!point_seen && value == L'.') {
      point_seen = true;
      after_point = true;
      ++current;
      continue;
    }

    break;
  }

  if (!have_digit) {
    /*
     * A failed hexadecimal candidate was never selected by
     * has_hexadecimal_significand(), so this also handles
     * inputs such as "." cleanly.
     */
    static_cast<void>(significand_begin);

    if (end != nullptr) {
      *end = const_cast<wchar_t *>(original);
    }

    return Float{};
  }

  int explicit_exponent = 0;
  const wchar_t exponent_marker = hexadecimal ? L'p' : L'e';

  if (ascii_lower(load(current)) == exponent_marker) {
    const wchar_t *exponent_end = nullptr;
    int parsed_exponent = 0;

    if (parse_float_exponent(current + 1, exponent_end, parsed_exponent)) {
      explicit_exponent = parsed_exponent;
      current = exponent_end;
    }
  }

  if (end != nullptr) {
    *end = const_cast<wchar_t *>(current);
  }

  /*
   * This special case matters. "0e999999" is exactly zero,
   * not a floating overflow caused by its enormous exponent.
   */
  if (!have_nonzero_digit) {
    const Float zero = Float{};
    return negative ? -zero : zero;
  }

  adjust_float_exponent(scale_exponent, explicit_exponent);

  const long double magnitude =
      scale_float(significand + tail, hexadecimal ? 2 : 10, scale_exponent);

  return finish_floating_conversion<Float>(magnitude, negative, true);
}

struct time_writer {
  wchar_t *destination;
  size_t capacity;
  size_t size = 0;
  bool overflow = false;

  void append(wchar_t value) {
    if (size + 1 >= capacity) {
      overflow = true;
    } else if (destination != nullptr) {
      destination[size] = value;
    }

    ++size;
  }

  void append(const wchar_t *string) {
    while (*string != L'\0') {
      append(*string++);
    }
  }

  bool finish() {
    if (overflow || size >= capacity) {
      return false;
    }

    if (destination != nullptr) {
      destination[size] = L'\0';
    }

    return true;
  }
};

inline bool leap_year(long long year) {
  return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
}

inline int days_in_year(long long year) { return leap_year(year) ? 366 : 365; }

inline int positive_mod(long long value, int divisor) {
  int result = static_cast<int>(value % divisor);

  if (result < 0) {
    result += divisor;
  }

  return result;
}

inline void append_unsigned(time_writer &writer, unsigned long long value,
                            int width, wchar_t padding = L'0') {
  wchar_t digits[32];
  int count = 0;

  do {
    digits[count++] = static_cast<wchar_t>(L'0' + value % 10);

    value /= 10;
  } while (value != 0);

  while (count < width) {
    writer.append(padding);
    --width;
  }

  while (count != 0) {
    writer.append(digits[--count]);
  }
}

inline void append_signed_year(time_writer &writer, long long year) {
  if (year < 0) {
    writer.append(L'-');

    const auto magnitude = static_cast<unsigned long long>(-(year + 1)) + 1;

    append_unsigned(writer, magnitude, 4);
    return;
  }

  append_unsigned(writer, static_cast<unsigned long long>(year), 4);
}

inline int iso_weekday(int weekday) { return weekday == 0 ? 7 : weekday; }

struct iso_week_date {
  long long year;
  int week;
};

inline iso_week_date make_iso_week_date(const tm &value) {
  long long year = static_cast<long long>(value.tm_year) + 1900;

  const int weekday = iso_weekday(value.tm_wday);

  /*
   * ISO week-years are most easily located by finding the
   * Thursday belonging to this week. The year containing that
   * Thursday is the ISO week-based year.
   */
  int thursday = value.tm_yday + 1 + (4 - weekday);

  if (thursday < 1) {
    --year;
    thursday += days_in_year(year);
  } else {
    const int year_days = days_in_year(year);

    if (thursday > year_days) {
      thursday -= year_days;
      ++year;
    }
  }

  return {year, (thursday - 1) / 7 + 1};
}

inline void append_hour_12(time_writer &writer, int hour) {
  int converted = hour % 12;

  if (converted == 0) {
    converted = 12;
  }

  append_unsigned(writer, static_cast<unsigned>(converted), 2);
}

inline constexpr const wchar_t *abbreviated_weekdays[] = {
    L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat"};

inline constexpr const wchar_t *weekdays[] = {
    L"Sunday",   L"Monday", L"Tuesday", L"Wednesday",
    L"Thursday", L"Friday", L"Saturday"};

inline constexpr const wchar_t *abbreviated_months[] = {
    L"Jan", L"Feb", L"Mar", L"Apr", L"May", L"Jun",
    L"Jul", L"Aug", L"Sep", L"Oct", L"Nov", L"Dec"};

inline constexpr const wchar_t *months[] = {
    L"January",   L"February", L"March",    L"April",
    L"May",       L"June",     L"July",     L"August",
    L"September", L"October",  L"November", L"December"};

inline bool valid_weekday(int weekday) { return weekday >= 0 && weekday < 7; }

inline bool valid_month(int month) { return month >= 0 && month < 12; }

inline void append_time_format(time_writer &writer, wchar_t conversion,
                               const tm &value) {
  const long long year = static_cast<long long>(value.tm_year) + 1900;

  switch (conversion) {
  case L'%':
    writer.append(L'%');
    break;

  case L'a':
    if (valid_weekday(value.tm_wday)) {
      writer.append(abbreviated_weekdays[value.tm_wday]);
    }
    break;

  case L'A':
    if (valid_weekday(value.tm_wday)) {
      writer.append(weekdays[value.tm_wday]);
    }
    break;

  case L'b':
  case L'h':
    if (valid_month(value.tm_mon)) {
      writer.append(abbreviated_months[value.tm_mon]);
    }
    break;

  case L'B':
    if (valid_month(value.tm_mon)) {
      writer.append(months[value.tm_mon]);
    }
    break;

  case L'C': {
    long long century = year / 100;

    if (year < 0 && year % 100 != 0) {
      --century;
    }

    if (century < 0) {
      writer.append(L'-');
      append_unsigned(writer,
                      static_cast<unsigned long long>(-(century + 1)) + 1, 2);
    } else {
      append_unsigned(writer, static_cast<unsigned long long>(century), 2);
    }

    break;
  }

  case L'c':
    /*
     * FTL C locale:
     * "%a %b %e %H:%M:%S %Y"
     */
    append_time_format(writer, L'a', value);
    writer.append(L' ');
    append_time_format(writer, L'b', value);
    writer.append(L' ');
    append_unsigned(writer, static_cast<unsigned>(value.tm_mday), 2, L' ');
    writer.append(L' ');
    append_time_format(writer, L'H', value);
    writer.append(L':');
    append_time_format(writer, L'M', value);
    writer.append(L':');
    append_time_format(writer, L'S', value);
    writer.append(L' ');
    append_time_format(writer, L'Y', value);
    break;

  case L'd':
    append_unsigned(writer, static_cast<unsigned>(value.tm_mday), 2);
    break;

  case L'D':
    append_time_format(writer, L'm', value);
    writer.append(L'/');
    append_time_format(writer, L'd', value);
    writer.append(L'/');
    append_time_format(writer, L'y', value);
    break;

  case L'e':
    append_unsigned(writer, static_cast<unsigned>(value.tm_mday), 2, L' ');
    break;

  case L'F':
    append_time_format(writer, L'Y', value);
    writer.append(L'-');
    append_time_format(writer, L'm', value);
    writer.append(L'-');
    append_time_format(writer, L'd', value);
    break;

  case L'g': {
    const auto iso = make_iso_week_date(value);

    append_unsigned(writer, static_cast<unsigned>(positive_mod(iso.year, 100)),
                    2);
    break;
  }

  case L'G': {
    const auto iso = make_iso_week_date(value);
    append_signed_year(writer, iso.year);
    break;
  }

  case L'H':
    append_unsigned(writer, static_cast<unsigned>(value.tm_hour), 2);
    break;

  case L'I':
    append_hour_12(writer, value.tm_hour);
    break;

  case L'j':
    append_unsigned(writer, static_cast<unsigned>(value.tm_yday + 1), 3);
    break;

  case L'm':
    append_unsigned(writer, static_cast<unsigned>(value.tm_mon + 1), 2);
    break;

  case L'M':
    append_unsigned(writer, static_cast<unsigned>(value.tm_min), 2);
    break;

  case L'n':
    writer.append(L'\n');
    break;

  case L'p':
    writer.append(value.tm_hour < 12 ? L"AM" : L"PM");
    break;

  case L'r':
    append_time_format(writer, L'I', value);
    writer.append(L':');
    append_time_format(writer, L'M', value);
    writer.append(L':');
    append_time_format(writer, L'S', value);
    writer.append(L' ');
    append_time_format(writer, L'p', value);
    break;

  case L'R':
    append_time_format(writer, L'H', value);
    writer.append(L':');
    append_time_format(writer, L'M', value);
    break;

  case L'S':
    append_unsigned(writer, static_cast<unsigned>(value.tm_sec), 2);
    break;

  case L't':
    writer.append(L'\t');
    break;

  case L'T':
    append_time_format(writer, L'H', value);
    writer.append(L':');
    append_time_format(writer, L'M', value);
    writer.append(L':');
    append_time_format(writer, L'S', value);
    break;

  case L'u':
    append_unsigned(writer, static_cast<unsigned>(iso_weekday(value.tm_wday)),
                    1);
    break;

  case L'U': {
    const int week = (value.tm_yday + 7 - value.tm_wday) / 7;

    append_unsigned(writer, static_cast<unsigned>(week), 2);
    break;
  }

  case L'V': {
    const auto iso = make_iso_week_date(value);

    append_unsigned(writer, static_cast<unsigned>(iso.week), 2);
    break;
  }

  case L'w':
    append_unsigned(writer, static_cast<unsigned>(value.tm_wday), 1);
    break;

  case L'W': {
    const int monday_weekday = (value.tm_wday + 6) % 7;

    const int week = (value.tm_yday + 7 - monday_weekday) / 7;

    append_unsigned(writer, static_cast<unsigned>(week), 2);
    break;
  }

  case L'x':
    /*
     * FTL C locale: "%m/%d/%y".
     */
    append_time_format(writer, L'D', value);
    break;

  case L'X':
    /*
     * FTL C locale: "%H:%M:%S".
     */
    append_time_format(writer, L'T', value);
    break;

  case L'y':
    append_unsigned(writer, static_cast<unsigned>(positive_mod(year, 100)), 2);
    break;

  case L'Y':
    append_signed_year(writer, year);
    break;

  case L'z':
  case L'Z':
    /*
     * The standard permits no characters when timezone
     * information is unavailable. FTL's portable tm has no
     * timezone offset or timezone-name member.
     */
    break;

  default:
    /*
     * Unknown conversion specifications have no portable
     * useful interpretation. Preserve them literally rather
     * than introducing undefined memory behavior.
     */
    writer.append(L'%');
    writer.append(conversion);
    break;
  }
}

