FTL_CWCHAR_NO_BUILTIN
inline int vswprintf(wchar_t *s, size_t n, const wchar_t *format, va_list arg) {
  cwchar_detail::format_writer writer{s, n};
  return cwchar_detail::format_wide(writer, format, arg);
}

FTL_CWCHAR_NO_BUILTIN
inline int swprintf(wchar_t *s, size_t n, const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vswprintf(s, n, format, arguments);

  va_end(arguments);
  return result;
}

inline int vfwprintf(FILE *stream, const wchar_t *format, va_list arg) {
  if (::ftl_stdio_runtime::orient(stream, 1) < 0)
    return -1;
  cwchar_detail::format_writer writer{nullptr, 0};
  writer.stream = stream;
  writer.stream_locked = true;
  ::ftl_stdio_runtime::lock_file(stream);
  int result = cwchar_detail::format_wide(writer, format, arg);
  ::ftl_stdio_runtime::unlock_file(stream);
  return result;
}

inline int fwprintf(FILE *stream, const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vfwprintf(stream, format, arguments);

  va_end(arguments);
  return result;
}

inline int vfwscanf(FILE *stream, const wchar_t *format, va_list arg) {
  return ::ftl_wstdio_runtime::vfwscanf(stream, format, arg);
}

inline int fwscanf(FILE *stream, const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vfwscanf(stream, format, arguments);

  va_end(arguments);
  return result;
}

inline int vswscanf(const wchar_t *string, const wchar_t *format, va_list arg) {
  return ::ftl_wstdio_runtime::vswscanf(string, format, arg);
}

inline int swscanf(const wchar_t *string, const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vswscanf(string, format, arguments);

  va_end(arguments);
  return result;
}

inline int vwprintf(const wchar_t *format, va_list arg) {
  return vfwprintf(::ftl_stdio_runtime::output_stream(), format, arg);
}

inline int wprintf(const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vwprintf(format, arguments);

  va_end(arguments);
  return result;
}

inline int vwscanf(const wchar_t *format, va_list arg) {
  return vfwscanf(::ftl_stdio_runtime::input_stream(), format, arg);
}

inline int wscanf(const wchar_t *format, ...) {
  va_list arguments;
  va_start(arguments, format);

  const int result = vwscanf(format, arguments);

  va_end(arguments);
  return result;
}

inline wint_t fgetwc(FILE *stream) {
  if (::ftl_stdio_runtime::orient(stream, 1) < 0)
    return cwchar_detail::wide_eof;
  const int value = ::ftl_stdio_runtime::read_wide_byte(stream);
  if (value == EOF)
    return cwchar_detail::wide_eof;
  if (value > 0x7f) {
    errno = EILSEQ;
    return cwchar_detail::wide_eof;
  }
  return static_cast<wint_t>(value);
}

inline wchar_t *fgetws(wchar_t *string, int count, FILE *stream) {
  if (!string || count <= 0)
    return nullptr;
  if (::ftl_stdio_runtime::orient(stream, 1) < 0)
    return nullptr;
  ::ftl_stdio_runtime::lock_file(stream);
  int used = 0;
  while (used + 1 < count) {
    int value = ::ftl_stdio_runtime::read_wide_byte_locked(stream);
    if (value == EOF)
      break;
    if (value > 0x7f) {
      errno = EILSEQ;
      break;
    }
    string[used++] = static_cast<wchar_t>(value);
    if (value == L'\n')
      break;
  }
  ::ftl_stdio_runtime::unlock_file(stream);
  if (used == 0)
    return nullptr;
  string[used] = L'\0';
  return string;
}

inline wint_t fputwc(wchar_t character, FILE *stream) {
  if (::ftl_stdio_runtime::orient(stream, 1) < 0 ||
      !cwchar_detail::valid_wide_character(character)) {
    errno = EILSEQ;
    return cwchar_detail::wide_eof;
  }
  return ::ftl_stdio_runtime::write_wide_byte(
             static_cast<unsigned char>(character), stream) == EOF
             ? cwchar_detail::wide_eof
             : static_cast<wint_t>(character);
}

inline int fputws(const wchar_t *string, FILE *stream) {
  if (::ftl_stdio_runtime::orient(stream, 1) < 0)
    return -1;
  ::ftl_stdio_runtime::lock_file(stream);
  while (*string) {
    wchar_t value = *string++;
    if (!cwchar_detail::valid_wide_character(value) ||
        ::ftl_stdio_runtime::write_wide_byte_locked(
            static_cast<unsigned char>(value), stream) == EOF) {
      ::ftl_stdio_runtime::unlock_file(stream);
      return -1;
    }
  }
  ::ftl_stdio_runtime::unlock_file(stream);
  return 0;
}

inline int fwide(FILE *stream, int mode) {
  return ::ftl_stdio_runtime::orient(stream, mode);
}

inline wint_t getwc(FILE *stream) {
  return fgetwc(stream);
}

inline wint_t getwchar() {
  return fgetwc(::ftl_stdio_runtime::input_stream());
}

inline wint_t putwc(wchar_t character, FILE *stream) {
  return fputwc(character, stream);
}

inline wint_t putwchar(wchar_t character) {
  return fputwc(character, ::ftl_stdio_runtime::output_stream());
}

inline wint_t ungetwc(wint_t character, FILE *stream) {
  if (character == cwchar_detail::wide_eof) {
    return cwchar_detail::wide_eof;
  }

  if (character > 0x7f || ::ftl_stdio_runtime::orient(stream, 1) < 0)
    return cwchar_detail::wide_eof;
  return ::ftl_stdio_runtime::unget_wide_byte(static_cast<int>(character),
                                               stream) == EOF
             ? cwchar_detail::wide_eof
             : character;
}

