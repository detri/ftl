  wchar_t *result = s1;

  while (cwchar_detail::load(s1) != L'\0') {
    ++s1;
  }

  for (;;) {
    const wchar_t value = cwchar_detail::load(s2++);
    cwchar_detail::store(s1++, value);

    if (value == L'\0') {
      break;
    }
  }

  return result;
