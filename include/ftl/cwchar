  while (index < n) {
    const wchar_t value = cwchar_detail::load(s2 + index);

    if (value == L'\0') {
      break;
    }

    cwchar_detail::store(s1 + index, value);
    ++index;
  }

  while (index < n) {
    cwchar_detail::store(s1 + index, L'\0');
    ++index;
  }

  return result;
}

