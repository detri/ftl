using size_t = decltype(sizeof(0));

namespace cwchar_detail {

inline wchar_t load(const wchar_t *pointer) {
#if defined(_MSC_VER) && !defined(__clang__)
  return *static_cast<const volatile wchar_t *>(pointer);
#else
  return *pointer;
#endif
}

inline void store(wchar_t *pointer, wchar_t value) {
#if defined(_MSC_VER) && !defined(__clang__)
  *static_cast<volatile wchar_t *>(pointer) = value;
#else
  *pointer = value;
#endif
}

inline bool contains(const wchar_t *set, wchar_t value) {
  while (load(set) != L'\0') {
    if (load(set) == value) {
      return true;
    }

    ++set;
  }

  return false;
}

inline bool is_space(wchar_t value) {
  return value == L' ' || value == L'\t' || value == L'\n' || value == L'\v' ||
         value == L'\f' || value == L'\r';
}

inline int digit_value(wchar_t value) {
  if (value >= L'0' && value <= L'9') {
    return static_cast<int>(value - L'0');
  }

  if (value >= L'a' && value <= L'z') {
    return static_cast<int>(value - L'a') + 10;
  }

  if (value >= L'A' && value <= L'Z') {
    return static_cast<int>(value - L'A') + 10;
  }

  return -1;
}

inline bool valid_digit(wchar_t value, int base) {
  const int digit = digit_value(value);
  return digit >= 0 && digit < base;
}

inline const wchar_t *prepare_integer(const wchar_t *string, int &base,
                                      bool &negative) {
  const wchar_t *current = string;

  while (is_space(load(current))) {
    ++current;
  }

  negative = false;

  if (load(current) == L'+' || load(current) == L'-') {
    negative = load(current) == L'-';
    ++current;
  }

  if (base == 0) {
    if (load(current) == L'0') {
      if ((load(current + 1) == L'x' || load(current + 1) == L'X') &&
          valid_digit(load(current + 2), 16)) {
        base = 16;
        current += 2;
      } else {
        base = 8;
      }
    } else {
      base = 10;
    }
  } else if (base == 16 && load(current) == L'0' &&
             (load(current + 1) == L'x' || load(current + 1) == L'X') &&
             valid_digit(load(current + 2), 16)) {
    current += 2;
  }

  return current;
}

template <class Signed, class Unsigned>
Signed parse_signed_integer(const wchar_t *string, wchar_t **end, int base) {
  if (base != 0 && (base < 2 || base > 36)) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Signed{};
  }

  bool negative = false;
  const wchar_t *current = prepare_integer(string, base, negative);

  const wchar_t *digits_begin = current;

  const Unsigned positive_limit =
      static_cast<Unsigned>(numeric_limits<Signed>::max());

  const Unsigned limit =
      negative ? positive_limit + Unsigned{1} : positive_limit;

  Unsigned value = 0;
  bool overflow = false;

  for (;;) {
    const int digit = digit_value(load(current));

    if (digit < 0 || digit >= base) {
      break;
    }

    const auto unsigned_digit = static_cast<Unsigned>(digit);

    if (value > (limit - unsigned_digit) / static_cast<Unsigned>(base)) {
      overflow = true;
    } else if (!overflow) {
      value = value * static_cast<Unsigned>(base) + unsigned_digit;
    }

    ++current;
  }

  if (current == digits_begin) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Signed{};
  }

  if (end != nullptr) {
    *end = const_cast<wchar_t *>(current);
  }

  if (overflow) {
    errno = ERANGE;

    return negative ? numeric_limits<Signed>::min()
                    : numeric_limits<Signed>::max();
  }

  if (!negative) {
    return static_cast<Signed>(value);
  }

  if (value == positive_limit + Unsigned{1}) {
    return numeric_limits<Signed>::min();
  }

  return -static_cast<Signed>(value);
}

template <class Unsigned>
Unsigned parse_unsigned_integer(const wchar_t *string, wchar_t **end,
                                int base) {
  if (base != 0 && (base < 2 || base > 36)) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Unsigned{};
  }

  bool negative = false;
  const wchar_t *current = prepare_integer(string, base, negative);

  const wchar_t *digits_begin = current;

  constexpr Unsigned limit = numeric_limits<Unsigned>::max();

  Unsigned value = 0;
  bool overflow = false;

  for (;;) {
    const int digit = digit_value(load(current));

    if (digit < 0 || digit >= base) {
      break;
    }

    const auto unsigned_digit = static_cast<Unsigned>(digit);

    if (value > (limit - unsigned_digit) / static_cast<Unsigned>(base)) {
      overflow = true;
    } else if (!overflow) {
      value = value * static_cast<Unsigned>(base) + unsigned_digit;
    }

    ++current;
  }

  if (current == digits_begin) {
    if (end != nullptr) {
      *end = const_cast<wchar_t *>(string);
    }

    return Unsigned{};
  }

  if (end != nullptr) {
    *end = const_cast<wchar_t *>(current);
  }

  if (overflow) {
    errno = ERANGE;
    return limit;
  }

  return negative ? Unsigned{} - value : value;
}

} // namespace cwchar_detail

FTL_CWCHAR_NO_BUILTIN
inline long wcstol(const wchar_t *nptr, wchar_t **endptr, int base) {
  return cwchar_detail::parse_signed_integer<long, unsigned long>(nptr, endptr,
                                                                  base);
}

FTL_CWCHAR_NO_BUILTIN
inline long long wcstoll(const wchar_t *nptr, wchar_t **endptr, int base) {
  return cwchar_detail::parse_signed_integer<long long, unsigned long long>(
      nptr, endptr, base);
}

FTL_CWCHAR_NO_BUILTIN
inline unsigned long wcstoul(const wchar_t *nptr, wchar_t **endptr, int base) {
  return cwchar_detail::parse_unsigned_integer<unsigned long>(nptr, endptr,
                                                              base);
}

FTL_CWCHAR_NO_BUILTIN
inline unsigned long long wcstoull(const wchar_t *nptr, wchar_t **endptr,
                                   int base) {
  return cwchar_detail::parse_unsigned_integer<unsigned long long>(nptr, endptr,
                                                                   base);
}

inline wint_t btowc(int c) {
  if (c < 0 || c > 0x7f) {
    return static_cast<wint_t>(~0u);
  }

  return static_cast<wint_t>(static_cast<unsigned char>(c));
}

inline int wctob(wint_t c) {
  if (c > 0x7fu) {
    return -1;
  }

  return static_cast<int>(c);
}

inline int mbsinit(const mbstate_t *ps) {
  return ps == nullptr || (ps->state == 0 && ps->value == 0);
}

namespace cwchar_detail {

inline void reset_state(mbstate_t &state) {
  state.state = 0;
  state.value = 0;
}

inline bool valid_multibyte_byte(unsigned char value) { return value <= 0x7f; }

inline bool valid_wide_character(wchar_t value) {
  return static_cast<unsigned long long>(value) <= 0x7full;
}

} // namespace cwchar_detail

inline size_t mbrtowc(wchar_t *pwc, const char *s, size_t n, mbstate_t *ps) {
  static mbstate_t internal_state{};

  if (ps == nullptr) {
    ps = &internal_state;
  }

  if (s == nullptr) {
    static constexpr char empty[] = "";

    s = empty;
    n = 1;
    pwc = nullptr;
  }

  if (n == 0) {
    return static_cast<size_t>(-2);
  }

  const auto byte = static_cast<unsigned char>(*s);

  if (!cwchar_detail::valid_multibyte_byte(byte)) {
    errno = EILSEQ;
    cwchar_detail::reset_state(*ps);
    return static_cast<size_t>(-1);
  }

  cwchar_detail::reset_state(*ps);

  if (pwc != nullptr) {
    *pwc = static_cast<wchar_t>(byte);
  }

  if (byte == 0) {
    return 0;
  }

  return 1;
}

inline size_t mbrlen(const char *s, size_t n, mbstate_t *ps) {
  return mbrtowc(nullptr, s, n, ps);
}

inline size_t wcrtomb(char *s, wchar_t wc, mbstate_t *ps) {
  static mbstate_t internal_state{};

  if (ps == nullptr) {
    ps = &internal_state;
  }

  if (s == nullptr) {
    cwchar_detail::reset_state(*ps);
    return 1;
  }

  if (!cwchar_detail::valid_wide_character(wc)) {
    errno = EILSEQ;
    cwchar_detail::reset_state(*ps);
    return static_cast<size_t>(-1);
  }

  *s = static_cast<char>(static_cast<unsigned char>(wc));

  cwchar_detail::reset_state(*ps);
  return 1;
}

inline size_t mbsrtowcs(wchar_t *destination, const char **source,
                        size_t length, mbstate_t *ps) {
  static mbstate_t internal_state{};

  if (ps == nullptr) {
    ps = &internal_state;
  }

  const char *current = *source;

  /*
   * When destination is null, the conversion is a sizing pass.
   * The source pointer is not modified.
   */
  if (destination == nullptr) {
    size_t count = 0;

    for (;;) {
      const auto byte = static_cast<unsigned char>(*current);

      if (!cwchar_detail::valid_multibyte_byte(byte)) {
        errno = EILSEQ;
        cwchar_detail::reset_state(*ps);
        return static_cast<size_t>(-1);
      }

      if (byte == 0) {
        cwchar_detail::reset_state(*ps);
        return count;
      }

      ++count;
      ++current;
    }
  }

  size_t count = 0;

  while (count < length) {
    const auto byte = static_cast<unsigned char>(*current);

    if (!cwchar_detail::valid_multibyte_byte(byte)) {
      errno = EILSEQ;
      cwchar_detail::reset_state(*ps);
      *source = current;
      return static_cast<size_t>(-1);
    }

    if (byte == 0) {
      destination[count] = L'\0';
      *source = nullptr;
      cwchar_detail::reset_state(*ps);
      return count;
    }

    destination[count] = static_cast<wchar_t>(byte);

    ++count;
    ++current;
  }

  *source = current;
  cwchar_detail::reset_state(*ps);
  return count;
}

inline size_t wcsrtombs(char *destination, const wchar_t **source,
                        size_t length, mbstate_t *ps) {
  static mbstate_t internal_state{};

  if (ps == nullptr) {
    ps = &internal_state;
  }

  const wchar_t *current = *source;

  /*
   * As with mbsrtowcs, a null destination performs a sizing
   * conversion without updating the source pointer.
   */
  if (destination == nullptr) {
    size_t count = 0;

    for (;;) {
      const wchar_t value = *current;

      if (!cwchar_detail::valid_wide_character(value)) {
        errno = EILSEQ;
        cwchar_detail::reset_state(*ps);
        return static_cast<size_t>(-1);
      }

      if (value == L'\0') {
        cwchar_detail::reset_state(*ps);
        return count;
      }

      ++count;
      ++current;
    }
  }

  size_t count = 0;

  while (count < length) {
    const wchar_t value = *current;

    if (!cwchar_detail::valid_wide_character(value)) {
      errno = EILSEQ;
      cwchar_detail::reset_state(*ps);
      *source = current;
      return static_cast<size_t>(-1);
    }

    if (value == L'\0') {
      destination[count] = '\0';
      *source = nullptr;
      cwchar_detail::reset_state(*ps);
      return count;
    }

    destination[count] = static_cast<char>(static_cast<unsigned char>(value));

    ++count;
    ++current;
  }

  *source = current;
  cwchar_detail::reset_state(*ps);
  return count;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcscpy(wchar_t *s1, const wchar_t *s2) {
  wchar_t *result = s1;

  for (;;) {
    const wchar_t value = cwchar_detail::load(s2++);
    cwchar_detail::store(s1++, value);

    if (value == L'\0') {
      break;
    }
  }

  return result;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcsncpy(wchar_t *s1, const wchar_t *s2, size_t n) {
  wchar_t *result = s1;
  size_t index = 0;

  while (index < n) {
    const wchar_t value = cwchar_detail::load(s2 + index);

    if (value == L'\0') {
      break;
    }

    cwchar_detail::store(s1 + index, value);
    ++index;
  }

  while (index < n) {
    cwchar_detail::store(s1 + index, L'\0');
    ++index;
  }

  return result;
}

/*
 * Reuse the already-hardened byte primitive. wchar_t object
 * representations are trivially copyable through unsigned char storage.
 */
inline wchar_t *wmemcpy(wchar_t *s1, const wchar_t *s2, size_t n) {
  memcpy(s1, s2, n * sizeof(wchar_t));
  return s1;
}

inline wchar_t *wmemmove(wchar_t *s1, const wchar_t *s2, size_t n) {
  memmove(s1, s2, n * sizeof(wchar_t));
  return s1;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcscat(wchar_t *s1, const wchar_t *s2) {
  wchar_t *result = s1;

  while (cwchar_detail::load(s1) != L'\0') {
    ++s1;
  }

  for (;;) {
    const wchar_t value = cwchar_detail::load(s2++);
    cwchar_detail::store(s1++, value);

    if (value == L'\0') {
      break;
    }
  }

  return result;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcsncat(wchar_t *s1, const wchar_t *s2, size_t n) {
  wchar_t *result = s1;

  while (cwchar_detail::load(s1) != L'\0') {
    ++s1;
  }

  size_t index = 0;

  while (index < n) {
    const wchar_t value = cwchar_detail::load(s2 + index);

    if (value == L'\0') {
      break;
    }

    cwchar_detail::store(s1 + index, value);
    ++index;
  }

  cwchar_detail::store(s1 + index, L'\0');
  return result;
}

FTL_CWCHAR_NO_BUILTIN
inline int wcscmp(const wchar_t *s1, const wchar_t *s2) {
  for (;;) {
    const wchar_t left = cwchar_detail::load(s1);
    const wchar_t right = cwchar_detail::load(s2);

    if (left < right) {
      return -1;
    }

    if (left > right) {
      return 1;
    }

    if (left == L'\0') {
      return 0;
    }

    ++s1;
    ++s2;
  }
}

/*
 * FTL currently implements only C-locale collation.
 */
inline int wcscoll(const wchar_t *s1, const wchar_t *s2) {
  return wcscmp(s1, s2);
}

FTL_CWCHAR_NO_BUILTIN
inline int wcsncmp(const wchar_t *s1, const wchar_t *s2, size_t n) {
  for (size_t index = 0; index < n; ++index) {
    const wchar_t left = cwchar_detail::load(s1 + index);
    const wchar_t right = cwchar_detail::load(s2 + index);

    if (left < right) {
      return -1;
    }

    if (left > right) {
      return 1;
    }

    if (left == L'\0') {
      return 0;
    }
  }

  return 0;
}

/*
 * In the C locale, the identity transformation has the required
 * relationship with wcscoll.
 */
FTL_CWCHAR_NO_BUILTIN
inline size_t wcsxfrm(wchar_t *s1, const wchar_t *s2, size_t n) {
  size_t length = 0;

  while (cwchar_detail::load(s2 + length) != L'\0') {
    ++length;
  }

  if (n == 0) {
    return length;
  }

  if (length < n) {
    for (size_t index = 0; index <= length; ++index) {
      cwchar_detail::store(s1 + index, cwchar_detail::load(s2 + index));
    }
  } else {
    for (size_t index = 0; index < n; ++index) {
      cwchar_detail::store(s1 + index, cwchar_detail::load(s2 + index));
    }
  }

  return length;
}

FTL_CWCHAR_NO_BUILTIN
inline int wmemcmp(const wchar_t *s1, const wchar_t *s2, size_t n) {
  for (size_t index = 0; index < n; ++index) {
    const wchar_t left = cwchar_detail::load(s1 + index);
    const wchar_t right = cwchar_detail::load(s2 + index);

    if (left < right) {
      return -1;
    }

    if (left > right) {
      return 1;
    }
  }

  return 0;
}

FTL_CWCHAR_NO_BUILTIN
inline const wchar_t *wcschr(const wchar_t *s, wchar_t c) {
  for (;;) {
    const wchar_t value = cwchar_detail::load(s);

    if (value == c) {
      return s;
    }

    if (value == L'\0') {
      return nullptr;
    }

    ++s;
  }
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcschr(wchar_t *s, wchar_t c) {
  return const_cast<wchar_t *>(wcschr(static_cast<const wchar_t *>(s), c));
}

FTL_CWCHAR_NO_BUILTIN
inline size_t wcscspn(const wchar_t *s1, const wchar_t *s2) {
  size_t count = 0;

  while (cwchar_detail::load(s1 + count) != L'\0') {
    if (cwchar_detail::contains(s2, cwchar_detail::load(s1 + count))) {
      break;
    }

    ++count;
  }

  return count;
}

FTL_CWCHAR_NO_BUILTIN
inline const wchar_t *wcspbrk(const wchar_t *s1, const wchar_t *s2) {
  while (cwchar_detail::load(s1) != L'\0') {
    if (cwchar_detail::contains(s2, cwchar_detail::load(s1))) {
      return s1;
    }

    ++s1;
  }

  return nullptr;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcspbrk(wchar_t *s1, const wchar_t *s2) {
  return const_cast<wchar_t *>(wcspbrk(static_cast<const wchar_t *>(s1), s2));
}

FTL_CWCHAR_NO_BUILTIN
inline const wchar_t *wcsrchr(const wchar_t *s, wchar_t c) {
  const wchar_t *result = nullptr;

  for (;;) {
    const wchar_t value = cwchar_detail::load(s);

    if (value == c) {
      result = s;
    }

    if (value == L'\0') {
      return result;
    }

    ++s;
  }
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcsrchr(wchar_t *s, wchar_t c) {
  return const_cast<wchar_t *>(wcsrchr(static_cast<const wchar_t *>(s), c));
}

FTL_CWCHAR_NO_BUILTIN
inline size_t wcsspn(const wchar_t *s1, const wchar_t *s2) {
  size_t count = 0;

  while (cwchar_detail::load(s1 + count) != L'\0') {
    if (!cwchar_detail::contains(s2, cwchar_detail::load(s1 + count))) {
      break;
    }

    ++count;
  }

  return count;
}

FTL_CWCHAR_NO_BUILTIN
inline const wchar_t *wcsstr(const wchar_t *s1, const wchar_t *s2) {
  if (cwchar_detail::load(s2) == L'\0') {
    return s1;
  }

  while (cwchar_detail::load(s1) != L'\0') {
    const wchar_t *haystack = s1;
    const wchar_t *needle = s2;

    while (cwchar_detail::load(needle) != L'\0' &&
           cwchar_detail::load(haystack) == cwchar_detail::load(needle)) {
      ++haystack;
      ++needle;
    }

    if (cwchar_detail::load(needle) == L'\0') {
      return s1;
    }

    ++s1;
  }

  return nullptr;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcsstr(wchar_t *s1, const wchar_t *s2) {
  return const_cast<wchar_t *>(wcsstr(static_cast<const wchar_t *>(s1), s2));
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wcstok(wchar_t *s1, const wchar_t *s2, wchar_t **ptr) {
  wchar_t *current = s1 != nullptr ? s1 : *ptr;

  while (cwchar_detail::load(current) != L'\0' &&
         cwchar_detail::contains(s2, cwchar_detail::load(current))) {
    ++current;
  }

  if (cwchar_detail::load(current) == L'\0') {
    *ptr = current;
    return nullptr;
  }

  wchar_t *token = current;

  while (cwchar_detail::load(current) != L'\0' &&
         !cwchar_detail::contains(s2, cwchar_detail::load(current))) {
    ++current;
  }

  if (cwchar_detail::load(current) != L'\0') {
    cwchar_detail::store(current, L'\0');
    ++current;
  }

  *ptr = current;
  return token;
}

FTL_CWCHAR_NO_BUILTIN
inline const wchar_t *wmemchr(const wchar_t *s, wchar_t c, size_t n) {
  for (size_t index = 0; index < n; ++index) {
    if (cwchar_detail::load(s + index) == c) {
      return s + index;
    }
  }

  return nullptr;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wmemchr(wchar_t *s, wchar_t c, size_t n) {
  return const_cast<wchar_t *>(wmemchr(static_cast<const wchar_t *>(s), c, n));
}

FTL_CWCHAR_NO_BUILTIN
inline size_t wcslen(const wchar_t *s) {
  size_t length = 0;

  while (cwchar_detail::load(s + length) != L'\0') {
    ++length;
  }

  return length;
}

FTL_CWCHAR_NO_BUILTIN
inline wchar_t *wmemset(wchar_t *s, wchar_t c, size_t n) {
  for (size_t index = 0; index < n; ++index) {
    cwchar_detail::store(s + index, c);
  }

  return s;
}

