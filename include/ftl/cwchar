inline void reset_state(mbstate_t &state) {
  state.state = 0;
  state.value = 0;
}

inline bool valid_multibyte_byte(unsigned char value) { return value <= 0x7f; }

inline bool valid_wide_character(wchar_t value) {
  return static_cast<unsigned long long>(value) <= 0x7full;
