FTL_CWCHAR_NO_BUILTIN
inline int wcscmp(const wchar_t *s1, const wchar_t *s2) {
  for (;;) {
    const wchar_t left = cwchar_detail::load(s1);
    const wchar_t right = cwchar_detail::load(s2);

    if (left < right) {
      return -1;
    }

    if (left > right) {
      return 1;
    }

    if (left == L'\0') {
      return 0;
    }

    ++s1;
    ++s2;
  }
}

