FTL_CWCHAR_NO_BUILTIN
inline size_t wcsxfrm(wchar_t *s1, const wchar_t *s2, size_t n) {
  size_t length = 0;

  while (cwchar_detail::load(s2 + length) != L'\0') {
    ++length;
  }

  if (n == 0) {
    return length;
  }

  if (length < n) {
    for (size_t index = 0; index <= length; ++index) {
      cwchar_detail::store(s1 + index, cwchar_detail::load(s2 + index));
    }
  } else {
    for (size_t index = 0; index < n; ++index) {
      cwchar_detail::store(s1 + index, cwchar_detail::load(s2 + index));
    }
  }

  return length;
}

