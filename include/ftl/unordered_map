namespace detail {
[[noreturn]] inline void unordered_map_range_failure() {
#if FTL_HAS_EXCEPTIONS
  throw out_of_range("unordered_map");
#else
  FTL_UNORDERED_MAP_TRAP();
#endif
}
} // namespace detail

template <class Key, class T, class Hash, class Predicate, class Allocator>
class unordered_map;
template <class Key, class T, class Hash, class Predicate, class Allocator>
class unordered_multimap;

template <class Key, class T, class Hash = hash<Key>,
          class Predicate = equal_to<Key>,
          class Allocator = allocator<pair<const Key, T>>>
class unordered_map : public detail::unordered_map_base<Key, T, Hash, Predicate,
                                                        Allocator, false> {
  using base =
      detail::unordered_map_base<Key, T, Hash, Predicate, Allocator, false>;

public:
  using base::base;
  using base::merge;
  using base::operator=;
  using typename base::key_type;
  using typename base::mapped_type;
  unordered_map &operator=(initializer_list<typename base::value_type> values) { base::operator=(values); return *this; }
  template <class H, class P>
  void merge(unordered_map<Key, T, H, P, Allocator> &source) {
    using source_base = detail::unordered_map_base<Key, T, H, P, Allocator, false>;
    this->template merge_from<H, P, false>(static_cast<source_base &>(source));
  }
  template <class H, class P>
  void merge(unordered_multimap<Key, T, H, P, Allocator> &source) {
    using source_base = detail::unordered_map_base<Key, T, H, P, Allocator, true>;
    this->template merge_from<H, P, true>(static_cast<source_base &>(source));
  }
  template <class Source> void merge(Source &&source) requires(!is_lvalue_reference_v<Source>) { merge(source); }
  mapped_type &operator[](const key_type &key) {
    return this->try_emplace(key).first->second;
  }
  mapped_type &operator[](key_type &&key) {
    return this->try_emplace(move(key)).first->second;
  }
  mapped_type &at(const key_type &key) {
    auto found = this->find(key);
    if (found == this->end())
      detail::unordered_map_range_failure();
    return found->second;
  }
  const mapped_type &at(const key_type &key) const {
    auto found = this->find(key);
    if (found == this->end())
      detail::unordered_map_range_failure();
    return found->second;
  }
};

template <class Key, class T, class Hash = hash<Key>,
          class Predicate = equal_to<Key>,
          class Allocator = allocator<pair<const Key, T>>>
class unordered_multimap
    : public detail::unordered_map_base<Key, T, Hash, Predicate, Allocator,
                                        true> {
  using base =
      detail::unordered_map_base<Key, T, Hash, Predicate, Allocator, true>;

public:
  using base::base;
  using base::merge;
  using base::operator=;
  unordered_multimap &operator=(initializer_list<typename base::value_type> values) { base::operator=(values); return *this; }
  template <class H, class P>
  void merge(unordered_map<Key, T, H, P, Allocator> &source) {
    using source_base = detail::unordered_map_base<Key, T, H, P, Allocator, false>;
    this->template merge_from<H, P, false>(static_cast<source_base &>(source));
  }
  template <class H, class P>
  void merge(unordered_multimap<Key, T, H, P, Allocator> &source) {
    using source_base = detail::unordered_map_base<Key, T, H, P, Allocator, true>;
    this->template merge_from<H, P, true>(static_cast<source_base &>(source));
  }
  template <class Source> void merge(Source &&source) requires(!is_lvalue_reference_v<Source>) { merge(source); }
};

