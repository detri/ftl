    detail::promise_store_at_thread_exit(
        state_, [&] { return state_->try_store_value(); });
  }

  void set_exception_at_thread_exit(exception_ptr exception) {
    require_state();

    detail::promise_store_at_thread_exit(
        state_, [&] { return state_->try_store_exception(move(exception)); });
  }

private:
  [[nodiscard]]
  detail::future_state<void> &require_state() {
    if (!state_) {
      detail::throw_future_error(future_errc::no_state);
    }

    return *state_;
  }

  shared_ptr<detail::future_state<void>> state_;
};

template <class R> void swap(promise<R> &left, promise<R> &right) noexcept {
  left.swap(right);
}

template <class R, class Allocator>
struct uses_allocator<promise<R>, Allocator> : true_type {};

