struct future_access;

inline future_status
future_status_from_wait_result(future_wait_result result) noexcept {
  switch (result) {
  case future_wait_result::ready:
    return future_status::ready;

  case future_wait_result::timeout:
    return future_status::timeout;

  case future_wait_result::deferred:
    return future_status::deferred;
  }

  return future_status::timeout;
}

template <class Rep, class Period>
uint64_t
future_timeout_nanoseconds(const chrono::duration<Rep, Period> &duration) {
  using wide_nanoseconds = chrono::duration<long double, nano>;

  const long double value = wide_nanoseconds(duration).count();

  if (!(value > 0))
    return 0;

  constexpr uint64_t maximum = 0x7fffffffffffffffULL;

  constexpr long double maximum_as_float = 9223372036854775807.0L;

  if (value >= maximum_as_float)
    return maximum;

  uint64_t result = static_cast<uint64_t>(value);

  // Never shorten a positive timeout merely
  // because its duration does not exactly fit
  // integral nanoseconds.
  if (static_cast<long double>(result) < value)
    ++result;

  return result;
}

template <class R> class future_handle {
public:
  future_handle() noexcept = default;

  explicit future_handle(shared_ptr<future_state<R>> state) noexcept
      : state_(move(state)) {}

  [[nodiscard]]
  bool valid() const noexcept {
    return static_cast<bool>(state_);
  }

  void wait() const { require_state().wait(); }

  template <class Rep, class Period>
  future_status
  wait_for(const chrono::duration<Rep, Period> &relative_time) const {
    future_state<R> &state = require_state();

    // Probe first so a deferred state does not touch
    // the supplied duration at all.
    const future_wait_result immediate = state.wait_for(0);

    if (immediate != future_wait_result::timeout)
      return future_status_from_wait_result(immediate);

    return future_status_from_wait_result(
        state.wait_for(future_timeout_nanoseconds(relative_time)));
  }

  template <class Clock, class Duration>
  future_status
  wait_until(const chrono::time_point<Clock, Duration> &absolute_time) const {
    static_assert(chrono::is_clock_v<Clock>);

    future_state<R> &state = require_state();

    // A deferred function is not executed by a timed
    // wait and reports deferred immediately.
    const future_wait_result immediate = state.wait_for(0);

    if (immediate != future_wait_result::timeout)
      return future_status_from_wait_result(immediate);

    for (;;) {
      const auto now = Clock::now();

      if (!(now < absolute_time)) {
        return state.is_ready() ? future_status::ready : future_status::timeout;
      }

      const future_wait_result result =
          state.wait_for(future_timeout_nanoseconds(absolute_time - now));

      if (result != future_wait_result::timeout)
        return future_status_from_wait_result(result);

      // For clocks that move backwards, recompute the
      // remaining duration rather than treating one
      // steady-clock timeout as authoritative.
      if (!(Clock::now() < absolute_time)) {
        return state.is_ready() ? future_status::ready : future_status::timeout;
      }
    }
  }

  [[nodiscard]]
  future_state<R> &state() const {
    return require_state();
  }

  [[nodiscard]]
  shared_ptr<future_state<R>> take_state() noexcept {
    return move(state_);
  }

private:
  [[nodiscard]]
  future_state<R> &require_state() const {
    if (!state_)
      throw_future_error(future_errc::no_state);

    return *state_;
  }

  shared_ptr<future_state<R>> state_;
};

} // namespace detail

template <class R> class future {
  static_assert(is_object_v<R>);
  static_assert(is_destructible_v<R>);

  template <class> friend class shared_future;

  friend struct detail::future_access;

public:
  future() noexcept = default;

  future(future &&) noexcept = default;

  future(const future &) = delete;

  ~future() = default;

  future &operator=(const future &) = delete;

  future &operator=(future &&) noexcept = default;

  shared_future<R> share() noexcept;

  R get() {
    auto state = handle_.take_state();

    if (!state)
      detail::throw_future_error(future_errc::no_state);

    // take_state() occurs before waiting/retrieval so
    // *this remains invalid even if the stored
    // exception or R's move constructor throws.
    state->rethrow_if_exception();

    return move(state->value());
  }

  [[nodiscard]]
  bool valid() const noexcept {
    return handle_.valid();
  }

  void wait() const { handle_.wait(); }

  template <class Rep, class Period>
  future_status
  wait_for(const chrono::duration<Rep, Period> &relative_time) const {
    return handle_.wait_for(relative_time);
  }

  template <class Clock, class Duration>
  future_status
  wait_until(const chrono::time_point<Clock, Duration> &absolute_time) const {
    return handle_.wait_until(absolute_time);
  }

private:
  explicit future(shared_ptr<detail::future_state<R>> state) noexcept
      : handle_(move(state)) {}

  detail::future_handle<R> handle_;
};

