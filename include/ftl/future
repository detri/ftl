template <class R, class... ArgTypes> class packaged_task<R(ArgTypes...)> {
  using erased_type = detail::packaged_task_erased<R, ArgTypes...>;

public:
  packaged_task() noexcept = default;

  template <class F>
    requires(!is_same_v<remove_cvref_t<F>, packaged_task>)
  explicit packaged_task(F &&callable) {
    static_assert(is_invocable_r_v<R, F &, ArgTypes...>);

    using callable_type = decay_t<F>;

    auto state = make_shared<detail::future_state<R>>();

    unique_ptr<erased_type> task{
        new detail::packaged_task_model<callable_type, R, ArgTypes...>{
            forward<F>(callable)}};

    state_ = move(state);
    task_ = move(task);
  }

  ~packaged_task() { detail::abandon_promise_state(state_); }

  packaged_task(const packaged_task &) = delete;

  packaged_task &operator=(const packaged_task &) = delete;

  packaged_task(packaged_task &&) noexcept = default;

  packaged_task &operator=(packaged_task &&other) noexcept {
    if (this != &other) {
      detail::abandon_promise_state(state_);

      state_ = move(other.state_);
      task_ = move(other.task_);
    }

    return *this;
  }

  void swap(packaged_task &other) noexcept {
    state_.swap(other.state_);
    task_.swap(other.task_);
  }

  [[nodiscard]]
  bool valid() const noexcept {
    return static_cast<bool>(state_);
  }

  future<R> get_future() {
    auto &state = require_state();

    if (!state.try_mark_future_retrieved()) {
      detail::throw_future_error(future_errc::future_already_retrieved);
    }

    return detail::future_access::make_future<R>(state_);
  }

  void operator()(ArgTypes... args) {
    require_state();

    task_->invoke_task(state_, forward<ArgTypes>(args)...);
  }

  void make_ready_at_thread_exit(ArgTypes... args) {
    require_state();

    task_->invoke_task_at_thread_exit(state_, forward<ArgTypes>(args)...);
  }

  void reset() {
    require_state();

    // Construct the replacement state before
    // touching the callable, so allocation failure
    // leaves the existing task untouched.
    auto replacement_state = make_shared<detail::future_state<R>>();

    unique_ptr<erased_type> replacement_task{task_->move_task()};

    // The old future, if any, observes
    // broken_promise unless its state was already
    // satisfied.
    detail::abandon_promise_state(state_);

    state_ = move(replacement_state);

    task_ = move(replacement_task);
  }

private:
  [[nodiscard]]
  detail::future_state<R> &require_state() {
    if (!state_) {
      detail::throw_future_error(future_errc::no_state);
    }

    return *state_;
  }

  shared_ptr<detail::future_state<R>> state_;

  unique_ptr<erased_type> task_;
};

template <class R, class... ArgTypes>
void swap(packaged_task<R(ArgTypes...)> &left,
          packaged_task<R(ArgTypes...)> &right) noexcept {
  left.swap(right);
}

template <class R, class... ArgTypes>
packaged_task(R (*)(ArgTypes...)) -> packaged_task<R(ArgTypes...)>;

template <class F>
packaged_task(F)
    -> packaged_task<typename detail::packaged_task_guide<F>::type>;

namespace detail {

[[nodiscard]]
constexpr bool launch_contains(launch policy, launch value) noexcept {
  return (policy & value) == value;
}

} // namespace detail

template <class F, class... Args>
[[nodiscard]]
future<invoke_result_t<decay_t<F>, decay_t<Args>...>>
async(launch policy, F &&function, Args &&...arguments) {
  using function_type = decay_t<F>;

  using result_type = invoke_result_t<function_type, decay_t<Args>...>;

  static_assert(is_constructible_v<function_type, F>);

  static_assert((is_constructible_v<decay_t<Args>, Args> && ...));

  static_assert(is_invocable_v<function_type, decay_t<Args>...>);

  using state_type =
      detail::async_state<result_type, function_type, decay_t<Args>...>;

  // This construction performs all decay-copy /
  // decay-move materialization in the thread that
  // called async, before any worker is started.
  auto state = make_shared<state_type>(forward<F>(function),
                                       forward<Args>(arguments)...);

  const bool allow_async = detail::launch_contains(policy, launch::async);

  const bool allow_deferred = detail::launch_contains(policy, launch::deferred);

  if (allow_async) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif

      state->start_async(state);

      return detail::future_access::make_future<result_type>(move(state));

#if FTL_HAS_EXCEPTIONS
    } catch (const system_error &error) {
      // Exact launch::async is required to
      // report failure to start a thread.
      //
      // When deferred is also permitted,
      // retaining the already-materialized
      // callable/arguments and falling back
      // to deferred avoids throwing the
      // resource exhaustion error.
      if (!allow_deferred ||
          error.code() !=
              make_error_code(errc::resource_unavailable_try_again)) {
        throw;
      }
    }
#endif
  }

  if (allow_deferred) {
    state->select_deferred();

    return detail::future_access::make_future<result_type>(move(state));
  }

  // N4950 gives undefined behavior when no
  // supported policy bit is selected.
  terminate();
}

template <class F, class... Args>
[[nodiscard]]
future<invoke_result_t<decay_t<F>, decay_t<Args>...>>
async(F &&function, Args &&...arguments) {
  return FTL_FUTURE_NAMESPACE::async(launch::async | launch::deferred,
                                     forward<F>(function),
                                     forward<Args>(arguments)...);
}

