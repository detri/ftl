template <class R, class Callable, class... Args>
bool packaged_task_store_ready(future_state<R> &state, Callable &callable,
                               Args &&...args) {
#if FTL_HAS_EXCEPTIONS
  try {
#endif
    if constexpr (is_void_v<R>) {
      invoke_r<R>(callable, forward<Args>(args)...);

      return state.try_set_value();
    } else if constexpr (is_reference_v<R>) {
      R result = invoke_r<R>(callable, forward<Args>(args)...);

      return state.try_set_value(result);
    } else {
      return state.try_set_value(invoke_r<R>(callable, forward<Args>(args)...));
    }

#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    return state.try_set_exception(current_exception());
  }
#endif
}

template <class R, class Callable, class... Args>
bool packaged_task_store_deferred(future_state<R> &state, Callable &callable,
                                  Args &&...args) {
#if FTL_HAS_EXCEPTIONS
  try {
#endif
    if constexpr (is_void_v<R>) {
      invoke_r<R>(callable, forward<Args>(args)...);

      return state.try_store_value();
    } else if constexpr (is_reference_v<R>) {
      R result = invoke_r<R>(callable, forward<Args>(args)...);

      return state.try_store_value(result);
    } else {
      return state.try_store_value(
          invoke_r<R>(callable, forward<Args>(args)...));
    }

#if FTL_HAS_EXCEPTIONS
  } catch (...) {
    return state.try_store_exception(current_exception());
  }
#endif
}

template <class R, class... ArgTypes> class packaged_task_erased {
public:
  virtual ~packaged_task_erased() = default;

  packaged_task_erased(const packaged_task_erased &) = delete;

  packaged_task_erased &operator=(const packaged_task_erased &) = delete;

  virtual void invoke_task(const shared_ptr<future_state<R>> &state,
                           ArgTypes &&...args) = 0;

  virtual void
  invoke_task_at_thread_exit(const shared_ptr<future_state<R>> &state,
                             ArgTypes &&...args) = 0;

  virtual packaged_task_erased *move_task() = 0;

protected:
  packaged_task_erased() = default;

  [[nodiscard]]
  bool claim_invocation() noexcept {
    return !invoked_.exchange(true, memory_order_acq_rel);
  }

private:
  atomic<bool> invoked_{false};
};

template <class Callable, class R, class... ArgTypes>
class packaged_task_model final : public packaged_task_erased<R, ArgTypes...> {
public:
  template <class F>
  explicit packaged_task_model(F &&callable)
      : callable_(forward<F>(callable)) {}

  void invoke_task(const shared_ptr<future_state<R>> &state,
                   ArgTypes &&...args) override {
    if (!this->claim_invocation()) {
      throw_future_error(future_errc::promise_already_satisfied);
    }

    if (!packaged_task_store_ready<R>(*state, callable_,
                                      forward<ArgTypes>(args)...)) {
      throw_future_error(future_errc::promise_already_satisfied);
    }
  }

  void invoke_task_at_thread_exit(const shared_ptr<future_state<R>> &state,
                                  ArgTypes &&...args) override {
    // Register first. A registration failure
    // therefore cannot leave a stored result
    // that has no legal publication mechanism.
    auto *action = register_future_thread_exit_action(state);

    if (!this->claim_invocation()) {
      throw_future_error(future_errc::promise_already_satisfied);
    }

    if (!packaged_task_store_deferred<R>(*state, callable_,
                                         forward<ArgTypes>(args)...)) {
      throw_future_error(future_errc::promise_already_satisfied);
    }

    action->arm();
  }

  packaged_task_erased<R, ArgTypes...> *move_task() override {
    return new packaged_task_model{move(callable_)};
  }

private:
  Callable callable_;
};

template <bool Static, class R, class... Args>
struct packaged_task_function_pointer_guide;

// static operator():
// all parameters belong to the callable signature.
template <class R, class... Args>
struct packaged_task_function_pointer_guide<true, R, Args...> {
  using type = R(Args...);
};

// explicit-object operator():
// the first parameter is the explicit object parameter.
template <class R, class G, class... Args>
struct packaged_task_function_pointer_guide<false, R, G, Args...> {
  using type = R(Args...);
};

template <class F, class Signature = decltype(&F::operator())>
struct packaged_task_guide;

// Implicit-object operator().
//
// N4950 permits:
//   cv opt(&) opt(noexcept)
//
// Deliberately no && forms.

template <class F, class R, class G, class... Args>
struct packaged_task_guide<F, R (G::*)(Args...)> {
  using type = R(Args...);
};

