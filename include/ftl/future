  using type = R(Args...);
};

// C++23 static operator() and explicit-object operator()
// both produce function-pointer-shaped types.
//
// A static operator() can be named through an object as:
//
//   value.operator()
//
// An explicit-object operator() cannot. For the latter,
// the first function-pointer parameter is therefore the
// explicit object parameter and gets stripped.

template <class F, class R, class... Args>
struct packaged_task_guide<F, R (*)(Args...)>
    : packaged_task_function_pointer_guide<
          is_invocable_v<F &, Args...>,
          R,
          Args...> {};

template <class F, class R, class... Args>
struct packaged_task_guide<F, R (*)(Args...) noexcept>
    : packaged_task_function_pointer_guide<
          is_invocable_v<F &, Args...>,
          R,
          Args...> {};

