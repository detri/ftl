namespace detail {

// This is the narrow internal construction boundary that
// promise, packaged_task, and async can all reuse later.
// They do not need friendship with every future specialization.
struct future_access {
  template <class R>
  static future<R> make_future(shared_ptr<future_state<R>> state) noexcept {
    return future<R>{move(state)};
  }
};

} // namespace detail

namespace detail {

template <class State>
class promise_thread_exit_action final : public thread_exit_action {
public:
  explicit promise_thread_exit_action(shared_ptr<State> state)
      : thread_exit_action(&promise_thread_exit_action::invoke),
        state_(move(state)) {}

  void arm() noexcept { armed_ = true; }

private:
  static void invoke(thread_exit_action *base) noexcept {
    auto *self = static_cast<promise_thread_exit_action *>(base);

    if (self->armed_)
      self->state_->make_ready();

    delete self;
  }

  shared_ptr<State> state_;
  bool armed_ = false;
};

template <class State>
promise_thread_exit_action<State> *
register_future_thread_exit_action(const shared_ptr<State> &state) {
  auto *action = new promise_thread_exit_action<State>{state};

  if (!register_thread_exit_action(action)) {
    delete action;

    // FTL cannot provide the required
    // post-TLS publication semantics if its
    // internal thread-exit runtime cannot be
    // installed. Do not expose an exception
    // outside the standard's specified surface
    // and, critically, do not publish early.
    terminate();
  }

  return action;
}

template <class State, class Store>
void promise_store_at_thread_exit(const shared_ptr<State> &state,
                                  Store &&store) {
  // Register before mutating the shared state.
  //
  // If storing the result later throws or reports
  // an already-satisfied state, the registered
  // action remains deliberately unarmed and simply
  // destroys itself at thread exit.
  auto *action = register_future_thread_exit_action(state);

  if (!forward<Store>(store)()) {
    throw_future_error(future_errc::promise_already_satisfied);
  }

  // Only a successfully stored result is eligible
  // for deferred publication.
  action->arm();
}

inline exception_ptr broken_promise_exception() noexcept {
#if FTL_HAS_EXCEPTIONS
  try {
    throw future_error{future_errc::broken_promise};
  } catch (...) {
    return current_exception();
  }
#else
  return exception_ptr{};
#endif
}

template <class R>
void abandon_promise_state(shared_ptr<future_state<R>> &state) noexcept {
  if (!state)
    return;

  // A stored *_at_thread_exit result is already
  // satisfied even though it has deliberately not
  // been published as ready yet. Do not replace it
  // with broken_promise.
  if (!state->is_satisfied()) {
    state->abandon_with_exception(broken_promise_exception());
  }

  state.reset();
}

} // namespace detail

template <class R> class promise {
  static_assert(is_object_v<R>);
  static_assert(is_destructible_v<R>);

public:
  promise() : state_(make_shared<detail::future_state<R>>()) {}

  template <class Allocator>
  promise(allocator_arg_t, const Allocator &allocator)
      : state_(allocate_shared<detail::future_state<R>>(allocator)) {}

  promise(promise &&) noexcept = default;

  promise(const promise &) = delete;

  ~promise() { detail::abandon_promise_state(state_); }

  promise &operator=(promise &&other) noexcept {
    if (this != &other) {
      detail::abandon_promise_state(state_);

      state_ = move(other.state_);
    }

    return *this;
  }

  promise &operator=(const promise &) = delete;

  void swap(promise &other) noexcept { state_.swap(other.state_); }

  future<R> get_future() {
    auto &state = require_state();

    if (!state.try_mark_future_retrieved()) {
      detail::throw_future_error(future_errc::future_already_retrieved);
    }

    return detail::future_access::make_future<R>(state_);
  }

  void set_value(const R &value) {
    auto &state = require_state();

    if (!state.try_set_value(value)) {
      detail::throw_future_error(future_errc::promise_already_satisfied);
    }
  }

  void set_value(R &&value) {
    auto &state = require_state();

    if (!state.try_set_value(move(value))) {
      detail::throw_future_error(future_errc::promise_already_satisfied);
    }
  }

  void set_exception(exception_ptr exception) {
    auto &state = require_state();

    if (!state.try_set_exception(move(exception))) {
      detail::throw_future_error(future_errc::promise_already_satisfied);
    }
  }

  void set_value_at_thread_exit(const R &value) {
    require_state();

    detail::promise_store_at_thread_exit(
        state_, [&] { return state_->try_store_value(value); });
  }

  void set_value_at_thread_exit(R &&value) {
    require_state();

    detail::promise_store_at_thread_exit(
        state_, [&] { return state_->try_store_value(move(value)); });
  }

  void set_exception_at_thread_exit(exception_ptr exception) {
    require_state();

    detail::promise_store_at_thread_exit(
        state_, [&] { return state_->try_store_exception(move(exception)); });
  }

private:
  [[nodiscard]]
  detail::future_state<R> &require_state() {
    if (!state_) {
      detail::throw_future_error(future_errc::no_state);
    }

    return *state_;
  }

  shared_ptr<detail::future_state<R>> state_;
};

