template <class State> class fpos {
public:
  constexpr fpos() : state_(), offset_() {}
  explicit constexpr fpos(streamoff offset) : state_(), offset_(offset) {}

  constexpr operator streamoff() const { return offset_; }
  constexpr void state(State value) { state_ = value; }
  constexpr State state() const { return state_; }

  constexpr fpos &operator+=(streamoff offset) {
    offset_ += offset;
    return *this;
  }
  constexpr fpos &operator-=(streamoff offset) {
    offset_ -= offset;
    return *this;
  }

private:
  State state_;
  streamoff offset_;
};

template <class State>
constexpr bool operator==(const fpos<State> &left, const fpos<State> &right) {
  return streamoff(left) == streamoff(right);
}
template <class State>
constexpr fpos<State> operator+(fpos<State> position, streamoff offset) {
  return position += offset;
}
template <class State>
constexpr fpos<State> operator+(streamoff offset, fpos<State> position) {
  return position += offset;
}
template <class State>
constexpr fpos<State> operator-(fpos<State> position, streamoff offset) {
  return position -= offset;
}
template <class State>
constexpr streamoff operator-(const fpos<State> &left,
                              const fpos<State> &right) {
  return streamoff(left) - streamoff(right);
}

