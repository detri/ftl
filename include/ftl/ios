class ios_base {
public:
  using fmtflags = unsigned int;
  static constexpr fmtflags boolalpha = 1u << 0;
  static constexpr fmtflags dec = 1u << 1;
  static constexpr fmtflags fixed = 1u << 2;
  static constexpr fmtflags hex = 1u << 3;
  static constexpr fmtflags internal = 1u << 4;
  static constexpr fmtflags left = 1u << 5;
  static constexpr fmtflags oct = 1u << 6;
  static constexpr fmtflags right = 1u << 7;
  static constexpr fmtflags scientific = 1u << 8;
  static constexpr fmtflags showbase = 1u << 9;
  static constexpr fmtflags showpoint = 1u << 10;
  static constexpr fmtflags showpos = 1u << 11;
  static constexpr fmtflags skipws = 1u << 12;
  static constexpr fmtflags unitbuf = 1u << 13;
  static constexpr fmtflags uppercase = 1u << 14;
  static constexpr fmtflags adjustfield = left | right | internal;
  static constexpr fmtflags basefield = dec | oct | hex;
  static constexpr fmtflags floatfield = scientific | fixed;

  using iostate = unsigned int;
  static constexpr iostate goodbit = 0;
  static constexpr iostate badbit = 1u << 0;
  static constexpr iostate eofbit = 1u << 1;
  static constexpr iostate failbit = 1u << 2;

  using openmode = unsigned int;
  static constexpr openmode app = 1u << 0;
  static constexpr openmode ate = 1u << 1;
  static constexpr openmode binary = 1u << 2;
  static constexpr openmode in = 1u << 3;
  static constexpr openmode noreplace = 1u << 4;
  static constexpr openmode out = 1u << 5;
  static constexpr openmode trunc = 1u << 6;

  using seekdir = unsigned int;
  static constexpr seekdir beg = 0;
  static constexpr seekdir cur = 1;
  static constexpr seekdir end = 2;

  class failure : public system_error {
  public:
    explicit failure(const string &message,
                     const error_code &code = make_error_code(io_errc::stream))
        : system_error(code, message) {}
    explicit failure(const char *message,
                     const error_code &code = make_error_code(io_errc::stream))
        : system_error(code, message) {}
  };

  class Init {
  public:
    Init();
    ~Init();
  };

  fmtflags flags() const { return flags_; }
  fmtflags flags(fmtflags value) {
    fmtflags previous = flags_;
    flags_ = value;
    return previous;
  }
  fmtflags setf(fmtflags value) {
    fmtflags previous = flags_;
    flags_ |= value;
    return previous;
  }
  fmtflags setf(fmtflags value, fmtflags mask) {
    fmtflags previous = flags_;
    flags_ = (flags_ & ~mask) | (value & mask);
    return previous;
  }
  void unsetf(fmtflags mask) { flags_ &= ~mask; }

  streamsize precision() const { return precision_; }
  streamsize precision(streamsize value) {
    streamsize previous = precision_;
    precision_ = value;
    return previous;
  }
  streamsize width() const { return width_; }
  streamsize width(streamsize value) {
    streamsize previous = width_;
    width_ = value;
    return previous;
  }

  locale imbue(const locale &value) {
    locale previous = locale_;
    locale_ = value;
    call_callbacks(imbue_event);
    return previous;
  }
  locale getloc() const { return locale_; }

  static int xalloc() {
    static atomic<int> next{0};
    return next.fetch_add(1, memory_order_relaxed);
  }
  long &iword(int index) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
    ensure_word(index);
    return words_[static_cast<size_t>(index)].integer;
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      storage_failure();
      static long fallback = 0;
      fallback = 0;
      return fallback;
    }
#endif
  }
  void *&pword(int index) {
#if FTL_HAS_EXCEPTIONS
    try {
#endif
    ensure_word(index);
    return words_[static_cast<size_t>(index)].pointer;
#if FTL_HAS_EXCEPTIONS
    } catch (...) {
      storage_failure();
      static void *fallback = nullptr;
      fallback = nullptr;
      return fallback;
    }
#endif
  }

  virtual ~ios_base() { call_callbacks(erase_event); }

  enum event { erase_event, imbue_event, copyfmt_event };
  using event_callback = void (*)(event, ios_base &, int);
  void register_callback(event_callback function, int index) {
    callbacks_.push_back({function, index});
  }

  ios_base(const ios_base &) = delete;
  ios_base &operator=(const ios_base &) = delete;

  static bool sync_with_stdio(bool synchronize = true) {
    static atomic<bool> synchronized{true};
    return synchronized.exchange(synchronize, memory_order_relaxed);
  }

protected:
  ios_base() = default;
  virtual void storage_failure() {}

  void move(ios_base &other) {
    flags_ = other.flags_;
    precision_ = other.precision_;
    width_ = other.width_;
    locale_ = other.locale_;
    words_ = static_cast<vector<word> &&>(other.words_);
    callbacks_ = static_cast<vector<callback> &&>(other.callbacks_);
  }
  void move(ios_base &&other) { move(other); }
  void swap(ios_base &other) noexcept {
    FTL_IOS_NAMESPACE::swap(flags_, other.flags_);
    FTL_IOS_NAMESPACE::swap(precision_, other.precision_);
    FTL_IOS_NAMESPACE::swap(width_, other.width_);
    FTL_IOS_NAMESPACE::swap(locale_, other.locale_);
    FTL_IOS_NAMESPACE::swap(words_, other.words_);
    FTL_IOS_NAMESPACE::swap(callbacks_, other.callbacks_);
  }
  void copyfmt_from(const ios_base &other) {
    call_callbacks(erase_event);
    flags_ = other.flags_;
    precision_ = other.precision_;
    width_ = other.width_;
    locale_ = other.locale_;
    words_ = other.words_;
    callbacks_ = other.callbacks_;
    call_callbacks(copyfmt_event);
  }

private:
  struct word { long integer = 0; void *pointer = nullptr; };
  struct callback { event_callback function; int index; };

  void ensure_word(int index) {
    if (index < 0) {
#if FTL_HAS_EXCEPTIONS
      throw bad_alloc();
#else
      terminate();
#endif
    }
    size_t count = static_cast<size_t>(index) + 1;
    if (words_.size() < count)
      words_.resize(count);
  }
  void call_callbacks(event value) noexcept {
    for (size_t index = callbacks_.size(); index != 0; --index)
      callbacks_[index - 1].function(value, *this, callbacks_[index - 1].index);
  }

  fmtflags flags_ = skipws | dec;
  streamsize precision_ = 6;
  streamsize width_ = 0;
  locale locale_{};
  vector<word> words_{};
  vector<callback> callbacks_{};
};

namespace detail {
inline int locale_stream_base(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::hex) ? 16
       : (stream.flags() & ios_base::oct) ? 8
       : (stream.flags() & ios_base::dec) ? 10 : 0;
}
inline bool locale_stream_boolalpha(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::boolalpha) != 0;
}
inline bool locale_stream_showbase(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::showbase) != 0;
}
inline bool locale_stream_showpoint(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::showpoint) != 0;
}
inline bool locale_stream_showpos(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::showpos) != 0;
}
inline bool locale_stream_uppercase(const ios_base &stream) noexcept {
  return (stream.flags() & ios_base::uppercase) != 0;
}
inline int locale_stream_float_mode(const ios_base &stream) noexcept {
  auto mode = stream.flags() & ios_base::floatfield;
  return mode == ios_base::fixed ? 1 : mode == ios_base::scientific ? 2
       : mode == ios_base::floatfield ? 3 : 0;
}
inline int locale_stream_adjust(const ios_base &stream) noexcept {
  auto mode = stream.flags() & ios_base::adjustfield;
  return mode == ios_base::left ? 1 : mode == ios_base::internal ? 2 : 0;
}
inline streamsize locale_stream_precision(const ios_base &stream) noexcept {
  return stream.precision();
}
inline streamsize locale_stream_take_width(ios_base &stream) noexcept {
  return stream.width(0);
}
inline locale locale_stream_locale(ios_base &stream) { return stream.getloc(); }
inline unsigned int locale_stream_failbit() noexcept { return ios_base::failbit; }
inline unsigned int locale_stream_eofbit() noexcept { return ios_base::eofbit; }
} // namespace detail

