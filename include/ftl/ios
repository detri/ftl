template <class Character, class Traits> class basic_ios : public ios_base {
public:
  using char_type = Character;
  using traits_type = Traits;
  using int_type = typename traits_type::int_type;
  using pos_type = typename traits_type::pos_type;
  using off_type = typename traits_type::off_type;

  explicit basic_ios(basic_streambuf<char_type, traits_type> *buffer) { init(buffer); }
  virtual ~basic_ios() = default;

  explicit operator bool() const { return !fail(); }
  bool operator!() const { return fail(); }
  iostate rdstate() const { return state_; }
  void clear(iostate state = goodbit) {
    state_ = buffer_ == nullptr ? state | badbit : state;
    if ((state_ & exceptions_) != 0) {
#if FTL_HAS_EXCEPTIONS
      throw failure("basic_ios::clear");
#else
      terminate();
#endif
    }
  }
  void setstate(iostate state) { clear(rdstate() | state); }
  bool good() const { return rdstate() == goodbit; }
  bool eof() const { return (rdstate() & eofbit) != 0; }
  bool fail() const { return (rdstate() & (failbit | badbit)) != 0; }
  bool bad() const { return (rdstate() & badbit) != 0; }
  iostate exceptions() const { return exceptions_; }
  void exceptions(iostate value) { exceptions_ = value; clear(rdstate()); }

  basic_ostream<char_type, traits_type> *tie() const { return tie_; }
  basic_ostream<char_type, traits_type> *tie(basic_ostream<char_type, traits_type> *value) {
    auto *previous = tie_; tie_ = value; return previous;
  }
  basic_streambuf<char_type, traits_type> *rdbuf() const { return buffer_; }
  basic_streambuf<char_type, traits_type> *rdbuf(basic_streambuf<char_type, traits_type> *value) {
    auto *previous = buffer_; buffer_ = value; clear(); return previous;
  }
  basic_ios &copyfmt(const basic_ios &other) {
    if (this == &other) return *this;
    ios_base::copyfmt_from(other);
    fill_ = other.fill_;
    tie_ = other.tie_;
    exceptions(other.exceptions());
    return *this;
  }
  char_type fill() const { return fill_; }
  char_type fill(char_type value) { char_type old = fill_; fill_ = value; return old; }
  locale imbue(const locale &value);
  char narrow(char_type value, char fallback) const {
    return use_facet<ctype<char_type>>(getloc()).narrow(value, fallback);
  }
  char_type widen(char value) const {
    return use_facet<ctype<char_type>>(getloc()).widen(value);
  }

  basic_ios(const basic_ios &) = delete;
  basic_ios &operator=(const basic_ios &) = delete;

protected:
  basic_ios() = default;
  void init(basic_streambuf<char_type, traits_type> *buffer) {
    buffer_ = buffer; tie_ = nullptr; fill_ = char_type(' '); exceptions_ = goodbit;
    state_ = buffer == nullptr ? badbit : goodbit;
  }
  void move(basic_ios &other) {
    ios_base::move(other); tie_ = other.tie_; fill_ = other.fill_;
    state_ = other.state_; exceptions_ = other.exceptions_; buffer_ = nullptr;
  }
  void move(basic_ios &&other) { move(other); }
  void swap(basic_ios &other) noexcept {
    ios_base::swap(other);
    auto *tie = tie_; tie_ = other.tie_; other.tie_ = tie;
    char_type fill = fill_; fill_ = other.fill_; other.fill_ = fill;
    iostate state = state_; state_ = other.state_; other.state_ = state;
    iostate except = exceptions_; exceptions_ = other.exceptions_; other.exceptions_ = except;
  }
  void set_rdbuf(basic_streambuf<char_type, traits_type> *buffer) { buffer_ = buffer; }
  void __setstate_nothrow(iostate value) noexcept {
    state_ |= value;
    if (!buffer_) state_ |= badbit;
  }
  void storage_failure() override { setstate(badbit); }

private:
  basic_ostream<char_type, traits_type> *tie_ = nullptr;
  basic_streambuf<char_type, traits_type> *buffer_ = nullptr;
  char_type fill_{};
  iostate state_ = badbit;
  iostate exceptions_ = goodbit;
};

template <class C, class T>
locale basic_ios<C, T>::imbue(const locale &value) {
  locale previous = ios_base::imbue(value);
  if (rdbuf()) rdbuf()->pubimbue(value);
  return previous;
}

#define FTL_IOS_FLAG_MANIP(name, flag, set) \
  inline ios_base &name(ios_base &stream) { \
    if constexpr (set) stream.setf(ios_base::flag); else stream.unsetf(ios_base::flag); \
    return stream; \
  }
FTL_IOS_FLAG_MANIP(boolalpha, boolalpha, true)
FTL_IOS_FLAG_MANIP(noboolalpha, boolalpha, false)
FTL_IOS_FLAG_MANIP(showbase, showbase, true)
FTL_IOS_FLAG_MANIP(noshowbase, showbase, false)
FTL_IOS_FLAG_MANIP(showpoint, showpoint, true)
FTL_IOS_FLAG_MANIP(noshowpoint, showpoint, false)
FTL_IOS_FLAG_MANIP(showpos, showpos, true)
FTL_IOS_FLAG_MANIP(noshowpos, showpos, false)
FTL_IOS_FLAG_MANIP(skipws, skipws, true)
FTL_IOS_FLAG_MANIP(noskipws, skipws, false)
FTL_IOS_FLAG_MANIP(uppercase, uppercase, true)
FTL_IOS_FLAG_MANIP(nouppercase, uppercase, false)
FTL_IOS_FLAG_MANIP(unitbuf, unitbuf, true)
FTL_IOS_FLAG_MANIP(nounitbuf, unitbuf, false)
#undef FTL_IOS_FLAG_MANIP

inline ios_base &internal(ios_base &s) { s.setf(ios_base::internal, ios_base::adjustfield); return s; }
inline ios_base &left(ios_base &s) { s.setf(ios_base::left, ios_base::adjustfield); return s; }
inline ios_base &right(ios_base &s) { s.setf(ios_base::right, ios_base::adjustfield); return s; }
inline ios_base &dec(ios_base &s) { s.setf(ios_base::dec, ios_base::basefield); return s; }
inline ios_base &hex(ios_base &s) { s.setf(ios_base::hex, ios_base::basefield); return s; }
inline ios_base &oct(ios_base &s) { s.setf(ios_base::oct, ios_base::basefield); return s; }
inline ios_base &fixed(ios_base &s) { s.setf(ios_base::fixed, ios_base::floatfield); return s; }
inline ios_base &scientific(ios_base &s) { s.setf(ios_base::scientific, ios_base::floatfield); return s; }
