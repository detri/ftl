class drop_while_view
    : public view_interface<
        drop_while_view<V, Pred>
    >
{
private:
    FTL_NO_UNIQUE_ADDRESS
    V base_ = V();

    FTL_NO_UNIQUE_ADDRESS
    detail::movable_box<Pred> pred_;

    FTL_NO_UNIQUE_ADDRESS
    detail::drop_while_cache<V> cache_{};

public:
    drop_while_view()
        requires (
            default_initializable<V> &&
            default_initializable<Pred>
        )
        = default;

    constexpr explicit drop_while_view(
        V base,
        Pred pred
    )
        : base_(
            FTL_RANGES_NAMESPACE::move(base)
        ),
          pred_(
            FTL_RANGES_NAMESPACE::move(pred)
        )
    {
    }

    [[nodiscard]]
    constexpr V base() const&
        requires copy_constructible<V>
    {
        return base_;
    }

    [[nodiscard]]
    constexpr V base() &&
    {
        return FTL_RANGES_NAMESPACE::move(base_);
    }

    [[nodiscard]]
    constexpr const Pred& pred() const
    {
        return *pred_;
    }

    [[nodiscard]]
    constexpr auto begin()
    {
        if constexpr (forward_range<V>)
        {
            auto& cached =
                cache_.cached_begin;

            if (!cached.has_value())
            {
                auto iterator =
                    ranges::begin(base_);

                const auto bound =
                    ranges::end(base_);

                while (
                    iterator != bound &&
                    FTL_RANGES_NAMESPACE::invoke(
                        *pred_,
                        *iterator
                    )
                )
                {
                    ++iterator;
                }

                cached.emplace(
                    FTL_RANGES_NAMESPACE::move(
                        iterator
                    )
                );
            }

            return *cached;
        }
        else
        {
            auto iterator =
                ranges::begin(base_);

            const auto bound =
                ranges::end(base_);

            while (
                iterator != bound &&
                FTL_RANGES_NAMESPACE::invoke(
                    *pred_,
                    *iterator
                )
            )
            {
                ++iterator;
            }

            return iterator;
        }
    }

    [[nodiscard]]
    constexpr auto end()
    {
        return ranges::end(base_);
    }
};

