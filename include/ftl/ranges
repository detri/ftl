struct zip_transform_fn {
    template<class F, viewable_range... R>
        requires (sizeof...(R) > 0) && constructible_from<decay_t<F>, F> &&
            regular_invocable<decay_t<F>&, range_reference_t<all_t<R>>...> &&
            (!is_void_v<invoke_result_t<decay_t<F>&, range_reference_t<all_t<R>>...>>)
    constexpr auto operator()(F&& function, R&&... ranges) const {
        using Fn = decay_t<F>;
        using Z = zip_view<all_t<R>...>;
        return zip_transform_view<Fn, all_t<R>...>(
            Z(all(static_cast<R&&>(ranges))...),
            tuple_invoke<Fn>{static_cast<F&&>(function)});
    }
};
