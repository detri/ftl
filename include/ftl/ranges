namespace detail {

struct counted_fn {
    template<class Iterator, class DifferenceType>
        requires (
            input_or_output_iterator<
                decay_t<Iterator>
            > &&
            convertible_to<
                DifferenceType&&,
                iter_difference_t<
                    decay_t<Iterator>
                >
            >
        )
    constexpr auto operator()(
        Iterator&& iterator,
        DifferenceType&& count
    ) const {
        using iterator_type =
            decay_t<Iterator>;

        using difference_type =
            iter_difference_t<iterator_type>;

        if constexpr (
            contiguous_iterator<iterator_type>
        ) {
            return span(
                FTL_RANGES_NAMESPACE::to_address(
                    iterator
                ),
                static_cast<size_t>(
                    static_cast<difference_type>(
                        static_cast<
                            DifferenceType&&
                        >(count)
                    )
                )
            );
        } else if constexpr (
            random_access_iterator<iterator_type>
        ) {
            /*
             * N4950 explicitly requires that the iterator
             * expression be evaluated only once.
             */
            iterator_type first(
                static_cast<Iterator&&>(iterator)
            );

            const difference_type length =
                static_cast<difference_type>(
                    static_cast<
                        DifferenceType&&
                    >(count)
                );

            return subrange(
                first,
                first + length
            );
        } else {
            return subrange(
                counted_iterator<iterator_type>(
                    static_cast<
                        Iterator&&
                    >(iterator),
                    static_cast<
                        DifferenceType&&
                    >(count)
                ),
                default_sentinel
            );
        }
    }
};

} // namespace detail

inline constexpr detail::counted_fn counted{};

namespace detail {

template<class T>
struct as_const_empty_view_traits {
    static constexpr bool matches = false;
};

template<class Element>
struct as_const_empty_view_traits<
    empty_view<Element>
> {
    static constexpr bool matches = true;
    using element_type = Element;
};

template<class T>
struct as_const_span_traits {
    static constexpr bool matches = false;
};

template<class Element, size_t Extent>
struct as_const_span_traits<
    span<Element, Extent>
> {
    static constexpr bool matches = true;
    using element_type = Element;
    static constexpr size_t extent = Extent;
};

template<class T>
struct as_const_ref_view_traits {
    static constexpr bool constant = false;
    static constexpr bool matches = false;
};

template<class Range>
struct as_const_ref_view_traits<
    ref_view<Range>
> {
    static constexpr bool matches = true;
    static constexpr bool constant =
        constant_range<const Range>;

    using range_type = Range;
};

struct as_const_fn
    : range_adaptor_closure<as_const_fn>
{
    template<viewable_range R>
    constexpr auto operator()(R&& range) const {
        using source_type = remove_cvref_t<R>;

        if constexpr (
            constant_range<all_t<R>>
        ) {
            return all(
                static_cast<R&&>(range)
            );
        } else if constexpr (
            as_const_empty_view_traits<
                source_type
            >::matches
        ) {
            using element_type =
                typename as_const_empty_view_traits<
                    source_type
                >::element_type;

            return views::empty<const element_type>;
        } else if constexpr (
            as_const_span_traits<
                source_type
            >::matches
        ) {
            using traits =
                as_const_span_traits<
                    source_type
                >;

            using element_type =
                typename traits::element_type;

            return span<
                const element_type,
                traits::extent
            >(
                static_cast<R&&>(range)
            );
        } else if constexpr (
            as_const_ref_view_traits<
                source_type
            >::matches &&
            as_const_ref_view_traits<
                source_type
            >::constant
        ) {
            using range_type =
                typename as_const_ref_view_traits<
                    source_type
                >::range_type;

            return ref_view<const range_type>(
                static_cast<const range_type&>(
                    range.base()
                )
            );
        } else if constexpr (
            is_lvalue_reference_v<R&&> &&
            constant_range<const source_type> &&
            !view<source_type>
        ) {
            return ref_view<const source_type>(
                static_cast<const source_type&>(
                    range
                )
            );
        } else {
            return as_const_view<all_t<R>>(
                all(static_cast<R&&>(range))
            );
        }
    }
};

} // namespace detail

inline constexpr detail::as_const_fn as_const{};

