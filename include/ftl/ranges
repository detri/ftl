namespace ranges {

namespace detail {

template<class T, class U>
concept different_from =
    !same_as<remove_cvref_t<T>, remove_cvref_t<U>>;

template<class From, class To>
concept uses_nonqualification_pointer_conversion =
    is_pointer_v<From> &&
    is_pointer_v<To> &&
    !convertible_to<
        remove_pointer_t<From> (*)[],
        remove_pointer_t<To> (*)[]
    >;

template<class From, class To>
concept convertible_to_non_slicing =
    convertible_to<From, To> &&
    !uses_nonqualification_pointer_conversion<
        decay_t<From>,
        decay_t<To>
    >;

template<class T>
using make_unsigned_like_t = make_unsigned_t<remove_cv_t<T>>;

template<class T>
[[nodiscard]]
constexpr make_unsigned_like_t<T>
to_unsigned_like(T value) noexcept {
    return static_cast<make_unsigned_like_t<T>>(value);
}

template<class T>
[[nodiscard]]
constexpr make_signed_t<remove_cv_t<T>>
to_signed_like(T value) noexcept {
    return static_cast<make_signed_t<remove_cv_t<T>>>(value);
}

template<bool Const, class T>
using maybe_const_t = conditional_t<Const, const T, T>;

template<class R>
concept simple_view =
    view<R> &&
    range<const R> &&
    same_as<iterator_t<R>, iterator_t<const R>> &&
    same_as<sentinel_t<R>, sentinel_t<const R>>;

template<class Iterator>
concept has_arrow =
    input_iterator<Iterator> &&
    (
        is_pointer_v<Iterator> ||
        requires(const Iterator& iterator) {
            iterator.operator->();
        }
    );

/*
 * tuple-like recognises exactly the standard tuple-like specializations,
 * which is what pair-like conversions on subrange are specified against.
 */
template<class T>
inline constexpr bool is_tuple_like_v = false;

template<class T1, class T2>
inline constexpr bool is_tuple_like_v<pair<T1, T2>> = true;

template<class... Types>
inline constexpr bool is_tuple_like_v<tuple<Types...>> = true;

template<class T, size_t Size>
inline constexpr bool is_tuple_like_v<array<T, Size>> = true;

template<class T>
concept tuple_like = is_tuple_like_v<remove_cvref_t<T>>;

template<class T>
concept pair_like =
    tuple_like<T> &&
    tuple_size_v<remove_cvref_t<T>> == 2;

} // namespace detail

// [view.interface]

template<class Derived>
    requires (
        is_class_v<Derived> &&
        same_as<Derived, remove_cv_t<Derived>>
    )
class view_interface {
private:
    [[nodiscard]]
    constexpr Derived& derived() noexcept {
        return static_cast<Derived&>(*this);
    }

    [[nodiscard]]
    constexpr const Derived& derived() const noexcept {
        return static_cast<const Derived&>(*this);
    }

public:
    [[nodiscard]]
    constexpr bool empty()
        requires (
            sized_range<Derived> ||
            forward_range<Derived>
        )
    {
        if constexpr (sized_range<Derived>) {
            return ranges::size(derived()) == 0;
        } else {
            return ranges::begin(derived()) == ranges::end(derived());
        }
    }

    [[nodiscard]]
    constexpr bool empty() const
        requires (
            sized_range<const Derived> ||
            forward_range<const Derived>
        )
    {
        if constexpr (sized_range<const Derived>) {
            return ranges::size(derived()) == 0;
        } else {
            return ranges::begin(derived()) == ranges::end(derived());
        }
    }

    [[nodiscard]]
    constexpr auto cbegin()
        requires input_range<Derived>
    {
        return ranges::cbegin(derived());
    }

    [[nodiscard]]
    constexpr auto cbegin() const
        requires input_range<const Derived>
    {
        return ranges::cbegin(derived());
    }

    [[nodiscard]]
    constexpr auto cend()
        requires input_range<Derived>
    {
        return ranges::cend(derived());
    }

    [[nodiscard]]
    constexpr auto cend() const
        requires input_range<const Derived>
    {
        return ranges::cend(derived());
    }

    constexpr explicit operator bool()
        requires requires(Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    constexpr explicit operator bool() const
        requires requires(const Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    [[nodiscard]]
    constexpr auto data()
        requires contiguous_iterator<iterator_t<Derived>>
    {
        return FTL_RANGES_NAMESPACE::to_address(
            ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto data() const
        requires (
            range<const Derived> &&
            contiguous_iterator<iterator_t<const Derived>>
        )
    {
        return FTL_RANGES_NAMESPACE::to_address(
            ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto size()
        requires (
            forward_range<Derived> &&
            sized_sentinel_for<
                sentinel_t<Derived>,
                iterator_t<Derived>
            >
        )
    {
        return detail::to_unsigned_like(
            ranges::end(derived()) - ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto size() const
        requires (
            forward_range<const Derived> &&
            sized_sentinel_for<
                sentinel_t<const Derived>,
                iterator_t<const Derived>
            >
        )
    {
        return detail::to_unsigned_like(
            ranges::end(derived()) - ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr decltype(auto) front()
        requires forward_range<Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) front() const
        requires forward_range<const Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) back()
        requires (
            bidirectional_range<Derived> &&
            common_range<Derived>
        )
    {
        return *ranges::prev(ranges::end(derived()));
    }

    [[nodiscard]]
    constexpr decltype(auto) back() const
        requires (
            bidirectional_range<const Derived> &&
            common_range<const Derived>
        )
    {
        return *ranges::prev(ranges::end(derived()));
    }

    template<random_access_range Range = Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) {
        return ranges::begin(derived())[index];
    }

    template<random_access_range Range = const Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) const {
        return ranges::begin(derived())[index];
    }
};

// [range.dangling]

struct dangling {
    constexpr dangling() noexcept = default;

    template<class... Args>
    constexpr dangling(Args&&...) noexcept {}
};

template<range R>
using borrowed_iterator_t =
    conditional_t<
        borrowed_range<R>,
        iterator_t<R>,
        dangling
    >;

// [range.subrange]

enum class subrange_kind : bool {
    unsized,
    sized
};

namespace detail {

template<class T, bool Present>
struct maybe_present {
    FTL_NO_UNIQUE_ADDRESS T value = T();
};

template<class T>
struct maybe_present<T, false> {};

template<class T, class U, class V>
concept pair_like_convertible_from =
    !range<T> &&
    !is_reference_v<T> &&
    pair_like<T> &&
    constructible_from<T, U, V> &&
    convertible_to_non_slicing<U, tuple_element_t<0, T>> &&
    convertible_to<V, tuple_element_t<1, T>>;

} // namespace detail

template<
    input_or_output_iterator Iterator,
    sentinel_for<Iterator> Sentinel = Iterator,
    subrange_kind Kind =
        sized_sentinel_for<Sentinel, Iterator>
            ? subrange_kind::sized
            : subrange_kind::unsized
>
    requires (
        Kind == subrange_kind::sized ||
        !sized_sentinel_for<Sentinel, Iterator>
    )
class subrange
    : public view_interface<subrange<Iterator, Sentinel, Kind>> {
private:
    static constexpr bool stores_size =
        Kind == subrange_kind::sized &&
        !sized_sentinel_for<Sentinel, Iterator>;

    using size_type =
        detail::make_unsigned_like_t<iter_difference_t<Iterator>>;

    FTL_NO_UNIQUE_ADDRESS Iterator first_ = Iterator();
    FTL_NO_UNIQUE_ADDRESS Sentinel last_ = Sentinel();
    FTL_NO_UNIQUE_ADDRESS detail::maybe_present<
        size_type,
        stores_size
    > size_{};

public:
    subrange()
        requires default_initializable<Iterator>
        = default;

    template<detail::convertible_to_non_slicing<Iterator> From>
        requires (!stores_size)
    constexpr subrange(From first, Sentinel last)
        : first_(FTL_RANGES_NAMESPACE::move(first)),
          last_(FTL_RANGES_NAMESPACE::move(last)) {}

    template<detail::convertible_to_non_slicing<Iterator> From>
        requires (Kind == subrange_kind::sized)
    constexpr subrange(From first, Sentinel last, size_type count)
        : first_(FTL_RANGES_NAMESPACE::move(first)),
          last_(FTL_RANGES_NAMESPACE::move(last)) {
        if constexpr (stores_size) {
            size_.value = count;
        }
    }

    template<detail::different_from<subrange> R>
        requires (
            borrowed_range<R> &&
            detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
            convertible_to<sentinel_t<R>, Sentinel> &&
            (!stores_size || sized_range<R>)
        )
    constexpr subrange(R&& other)
        : subrange(
            ranges::begin(other),
            ranges::end(other)
        ) {
        if constexpr (stores_size) {
            size_.value = ranges::size(other);
        }
    }

    template<borrowed_range R>
        requires (
            detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
            convertible_to<sentinel_t<R>, Sentinel> &&
            Kind == subrange_kind::sized
        )
    constexpr subrange(R&& other, size_type count)
        : subrange(
            ranges::begin(other),
            ranges::end(other),
            count
        ) {}

    template<detail::different_from<subrange> PairLike>
        requires detail::pair_like_convertible_from<
            PairLike,
            const Iterator&,
            const Sentinel&
        >
    constexpr operator PairLike() const {
        return PairLike(first_, last_);
    }

    [[nodiscard]]
    constexpr Iterator begin() const
        requires copyable<Iterator>
    {
        return first_;
    }

    [[nodiscard]]
    constexpr Iterator begin()
        requires (!copyable<Iterator>)
    {
        return FTL_RANGES_NAMESPACE::move(first_);
    }

    [[nodiscard]]
    constexpr Sentinel end() const {
        return last_;
    }

    [[nodiscard]]
    constexpr bool empty() const {
        return first_ == last_;
    }

    [[nodiscard]]
    constexpr size_type size() const
        requires (Kind == subrange_kind::sized)
    {
        if constexpr (stores_size) {
            return size_.value;
        } else {
            return detail::to_unsigned_like(last_ - first_);
        }
    }

    [[nodiscard]]
    constexpr subrange next(
        iter_difference_t<Iterator> count = 1
    ) const&
        requires forward_iterator<Iterator>
    {
        auto result = *this;
        result.advance(count);
        return result;
    }

    [[nodiscard]]
    constexpr subrange next(
        iter_difference_t<Iterator> count = 1
    ) && {
        advance(count);
        return FTL_RANGES_NAMESPACE::move(*this);
    }

    [[nodiscard]]
    constexpr subrange prev(
        iter_difference_t<Iterator> count = 1
    ) const
        requires bidirectional_iterator<Iterator>
    {
        auto result = *this;
        result.advance(-count);
        return result;
    }

    constexpr subrange& advance(
        iter_difference_t<Iterator> count
    ) {
        if constexpr (bidirectional_iterator<Iterator>) {
            if (count < 0) {
                ranges::advance(first_, count);

                if constexpr (stores_size) {
                    size_.value += detail::to_unsigned_like(-count);
                }

                return *this;
            }
        }

        auto remainder = ranges::advance(first_, count, last_);

        if constexpr (stores_size) {
            size_.value -= detail::to_unsigned_like(count - remainder);
        }

        return *this;
    }
};

template<input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(Iterator, Sentinel) -> subrange<Iterator, Sentinel>;

template<input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(
    Iterator,
    Sentinel,
    detail::make_unsigned_like_t<iter_difference_t<Iterator>>
) -> subrange<Iterator, Sentinel, subrange_kind::sized>;

template<borrowed_range R>
subrange(R&&) -> subrange<
    iterator_t<R>,
    sentinel_t<R>,
    (
        sized_range<R> ||
        sized_sentinel_for<sentinel_t<R>, iterator_t<R>>
    )
        ? subrange_kind::sized
        : subrange_kind::unsized
>;

template<borrowed_range R>
subrange(
    R&&,
    detail::make_unsigned_like_t<range_difference_t<R>>
) -> subrange<iterator_t<R>, sentinel_t<R>, subrange_kind::sized>;

template<size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
    requires (
        (Index == 0 && copyable<Iterator>) ||
        Index == 1
    )
[[nodiscard]]
constexpr auto get(const subrange<Iterator, Sentinel, Kind>& value) {
    if constexpr (Index == 0) {
        return value.begin();
    } else {
        return value.end();
    }
}

template<size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
    requires (Index < 2)
[[nodiscard]]
constexpr auto get(subrange<Iterator, Sentinel, Kind>&& value) {
    if constexpr (Index == 0) {
        return value.begin();
    } else {
        return value.end();
    }
}

template<class Iterator, class Sentinel, subrange_kind Kind>
inline constexpr bool
enable_borrowed_range<subrange<Iterator, Sentinel, Kind>> = true;

template<range R>
using borrowed_subrange_t =
    conditional_t<
        borrowed_range<R>,
        subrange<iterator_t<R>>,
        dangling
    >;

namespace detail {

template<class Iterator, class Sentinel, subrange_kind Kind>
inline constexpr bool
is_tuple_like_v<subrange<Iterator, Sentinel, Kind>> = true;

} // namespace detail

// [range.adaptor.object]

template<class Derived>
    requires (
        is_object_v<Derived> &&
        same_as<Derived, remove_cv_t<Derived>>
    )
class range_adaptor_closure {};

namespace detail {

template<class Derived, class Base>
    requires (!same_as<Derived, range_adaptor_closure<Base>>)
void range_adaptor_closure_base_of(
    const Derived&,
    const range_adaptor_closure<Base>&
);

template<class T>
concept range_adaptor_closure_object =
    !range<T> &&
    requires(const T& value) {
        detail::range_adaptor_closure_base_of(value, value);
    };

template<class Left, class Right>
class range_adaptor_pipeline
    : public range_adaptor_closure<
        range_adaptor_pipeline<Left, Right>
    > {
private:
    FTL_NO_UNIQUE_ADDRESS Left left_;
    FTL_NO_UNIQUE_ADDRESS Right right_;

public:
    template<class L, class R>
    constexpr explicit range_adaptor_pipeline(L&& left, R&& right)
        : left_(static_cast<L&&>(left)),
          right_(static_cast<R&&>(right)) {}

    template<class R>
    constexpr decltype(auto) operator()(R&& value) &
        requires requires(Left& left, Right& right, R&& range) {
            right(left(static_cast<R&&>(range)));
        }
    {
        return right_(left_(static_cast<R&&>(value)));
    }

    template<class R>
    constexpr decltype(auto) operator()(R&& value) const&
        requires requires(
            const Left& left,
            const Right& right,
            R&& range
        ) {
            right(left(static_cast<R&&>(range)));
        }
    {
        return right_(left_(static_cast<R&&>(value)));
    }

    template<class R>
    constexpr decltype(auto) operator()(R&& value) &&
        requires requires(Left left, Right right, R&& range) {
            FTL_RANGES_NAMESPACE::move(right)(
                FTL_RANGES_NAMESPACE::move(left)(
                    static_cast<R&&>(range)
                )
            );
        }
    {
        return FTL_RANGES_NAMESPACE::move(right_)(
            FTL_RANGES_NAMESPACE::move(left_)(
                static_cast<R&&>(value)
            )
        );
    }
};

template<class Adaptor, class Range, class... Args>
concept adaptor_invocable =
    requires(Range&& range, Args&&... args) {
        Adaptor{}(
            static_cast<Range&&>(range),
            static_cast<Args&&>(args)...
        );
    };

template<class Adaptor, class... Args>
class range_adaptor_partial
    : public range_adaptor_closure<
        range_adaptor_partial<Adaptor, Args...>
    > {
private:
    FTL_NO_UNIQUE_ADDRESS tuple<Args...> arguments_;

    template<class Self, class R, size_t... Index>
    static constexpr decltype(auto) apply_to(
        Self&& self,
        R&& range,
        index_sequence<Index...>
    ) {
        return Adaptor{}(
            static_cast<R&&>(range),
            FTL_RANGES_NAMESPACE::get<Index>(
                static_cast<Self&&>(self).arguments_
            )...
        );
    }

public:
    template<class... Values>
    constexpr explicit range_adaptor_partial(Values&&... values)
        : arguments_(static_cast<Values&&>(values)...) {}

    template<class R>
        requires adaptor_invocable<Adaptor, R, Args&...>
    constexpr decltype(auto) operator()(R&& range) & {
        return apply_to(
            *this,
            static_cast<R&&>(range),
            index_sequence_for<Args...>{}
        );
    }

    template<class R>
        requires adaptor_invocable<Adaptor, R, const Args&...>
    constexpr decltype(auto) operator()(R&& range) const& {
        return apply_to(
            *this,
            static_cast<R&&>(range),
            index_sequence_for<Args...>{}
        );
    }

    template<class R>
        requires adaptor_invocable<Adaptor, R, Args...>
    constexpr decltype(auto) operator()(R&& range) && {
        return apply_to(
            FTL_RANGES_NAMESPACE::move(*this),
            static_cast<R&&>(range),
            index_sequence_for<Args...>{}
        );
    }

    template<class R>
        requires adaptor_invocable<Adaptor, R, const Args...>
    constexpr decltype(auto) operator()(R&& range) const&& {
        return apply_to(
            FTL_RANGES_NAMESPACE::move(*this),
            static_cast<R&&>(range),
            index_sequence_for<Args...>{}
        );
    }
};

template<class Adaptor, class... Args>
[[nodiscard]]
constexpr auto partial_adaptor(Args&&... args) {
    return range_adaptor_partial<Adaptor, decay_t<Args>...>(
        static_cast<Args&&>(args)...
    );
}

} // namespace detail

template<class Range, class Closure>
    requires (
        range<remove_cvref_t<Range>> &&
        detail::range_adaptor_closure_object<remove_cvref_t<Closure>> &&
        invocable<Closure, Range>
    )
[[nodiscard]]
constexpr decltype(auto) operator|(Range&& value, Closure&& closure) {
    return static_cast<Closure&&>(closure)(static_cast<Range&&>(value));
}

template<class Left, class Right>
    requires (
        detail::range_adaptor_closure_object<remove_cvref_t<Left>> &&
        detail::range_adaptor_closure_object<remove_cvref_t<Right>> &&
        constructible_from<decay_t<Left>, Left> &&
        constructible_from<decay_t<Right>, Right>
    )
[[nodiscard]]
constexpr auto operator|(Left&& left, Right&& right) {
    return detail::range_adaptor_pipeline<
        decay_t<Left>,
        decay_t<Right>
    >(
        static_cast<Left&&>(left),
        static_cast<Right&&>(right)
    );
}

// [range.move.wrap] and the non-propagating cache

namespace detail {

template<class T, bool = is_trivially_destructible_v<T>>
struct optional_storage {
    union {
        unsigned char empty_;
        T value_;
    };

    bool engaged_ = false;

    constexpr optional_storage() noexcept : empty_() {}

    constexpr ~optional_storage() {
        if (engaged_) {
            value_.~T();
        }
    }
};

template<class T>
struct optional_storage<T, true> {
    union {
        unsigned char empty_;
        T value_;
    };

    bool engaged_ = false;

    constexpr optional_storage() noexcept : empty_() {}
};

template<class T>
concept boxable =
    move_constructible<T> &&
    is_object_v<T>;

template<class T>
concept box_stores_value_directly =
    (
        copy_constructible<T> &&
        (
            copyable<T> ||
            (
                is_nothrow_move_constructible_v<T> &&
                is_nothrow_copy_constructible_v<T>
            )
        )
    ) ||
    (
        !copy_constructible<T> &&
        (
            movable<T> ||
            is_nothrow_move_constructible_v<T>
        )
    );

/*
 * movable-box: wraps a merely move-constructible object so that views
 * holding it stay movable, and copyable when the wrapped type is.
 */
template<boxable T>
class movable_box {
private:
    optional_storage<T> storage_;

    constexpr void destroy() noexcept {
        if (storage_.engaged_) {
            storage_.value_.~T();
            storage_.engaged_ = false;
        }
    }

    template<class... Args>
    constexpr void construct(Args&&... args) {
        FTL_RANGES_NAMESPACE::construct_at(
            FTL_RANGES_NAMESPACE::addressof(storage_.value_),
            static_cast<Args&&>(args)...
        );
        storage_.engaged_ = true;
    }

public:
    constexpr movable_box()
        noexcept(is_nothrow_default_constructible_v<T>)
        requires default_initializable<T>
    {
        construct();
    }

    template<class... Args>
        requires constructible_from<T, Args...>
    constexpr explicit movable_box(in_place_t, Args&&... args)
        noexcept(is_nothrow_constructible_v<T, Args...>)
    {
        construct(static_cast<Args&&>(args)...);
    }

    constexpr explicit movable_box(const T& value)
        requires copy_constructible<T>
    {
        construct(value);
    }

    constexpr explicit movable_box(T&& value) {
        construct(FTL_RANGES_NAMESPACE::move(value));
    }

    constexpr movable_box(const movable_box& other)
        requires copy_constructible<T>
    {
        if (other.storage_.engaged_) {
            construct(other.storage_.value_);
        }
    }

    constexpr movable_box(movable_box&& other)
        noexcept(is_nothrow_move_constructible_v<T>)
    {
        if (other.storage_.engaged_) {
            construct(
                FTL_RANGES_NAMESPACE::move(other.storage_.value_)
            );
        }
    }

    constexpr ~movable_box() {
        destroy();
    }

    constexpr movable_box& operator=(const movable_box& other)
        requires copy_constructible<T>
    {
        if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
            if constexpr (copyable<T>) {
                if (storage_.engaged_ && other.storage_.engaged_) {
                    storage_.value_ = other.storage_.value_;
                    return *this;
                }
            }

            destroy();

            if (other.storage_.engaged_) {
                construct(other.storage_.value_);
            }
        }

        return *this;
    }

    constexpr movable_box& operator=(movable_box&& other)
        noexcept(is_nothrow_move_constructible_v<T>)
    {
        if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
            if constexpr (movable<T>) {
                if (storage_.engaged_ && other.storage_.engaged_) {
                    storage_.value_ =
                        FTL_RANGES_NAMESPACE::move(other.storage_.value_);
                    return *this;
                }
            }

            destroy();

            if (other.storage_.engaged_) {
                construct(
                    FTL_RANGES_NAMESPACE::move(other.storage_.value_)
                );
            }
        }

        return *this;
    }

    [[nodiscard]]
    constexpr bool has_value() const noexcept {
        return storage_.engaged_;
    }

    [[nodiscard]]
    constexpr T& operator*() noexcept {
        return storage_.value_;
    }

    [[nodiscard]]
    constexpr const T& operator*() const noexcept {
        return storage_.value_;
    }

    [[nodiscard]]
    constexpr T* operator->() noexcept {
        return FTL_RANGES_NAMESPACE::addressof(storage_.value_);
    }

    [[nodiscard]]
    constexpr const T* operator->() const noexcept {
        return FTL_RANGES_NAMESPACE::addressof(storage_.value_);
    }
};

template<boxable T>
    requires box_stores_value_directly<T>
class movable_box<T> {
private:
    FTL_NO_UNIQUE_ADDRESS T value_ = T();

public:
    movable_box()
        requires default_initializable<T>
        = default;

    template<class... Args>
        requires constructible_from<T, Args...>
    constexpr explicit movable_box(in_place_t, Args&&... args)
        noexcept(is_nothrow_constructible_v<T, Args...>)
        : value_(static_cast<Args&&>(args)...) {}

    constexpr explicit movable_box(const T& value)
        requires copy_constructible<T>
        : value_(value) {}

    constexpr explicit movable_box(T&& value)
        : value_(FTL_RANGES_NAMESPACE::move(value)) {}

    movable_box(const movable_box&) = default;
    movable_box(movable_box&&) = default;

    constexpr movable_box& operator=(const movable_box& other)
        noexcept(is_nothrow_copy_constructible_v<T>)
        requires copy_constructible<T>
    {
        if constexpr (copyable<T>) {
            if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
                value_ = other.value_;
            }
        } else {
            if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
                FTL_RANGES_NAMESPACE::destroy_at(
                    FTL_RANGES_NAMESPACE::addressof(value_)
                );
                FTL_RANGES_NAMESPACE::construct_at(
                    FTL_RANGES_NAMESPACE::addressof(value_),
                    other.value_
                );
            }
        }

        return *this;
    }

    constexpr movable_box& operator=(movable_box&& other)
        noexcept(is_nothrow_move_constructible_v<T>)
    {
        if constexpr (movable<T>) {
            if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
                value_ = FTL_RANGES_NAMESPACE::move(other.value_);
            }
        } else {
            if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
                FTL_RANGES_NAMESPACE::destroy_at(
                    FTL_RANGES_NAMESPACE::addressof(value_)
                );
                FTL_RANGES_NAMESPACE::construct_at(
                    FTL_RANGES_NAMESPACE::addressof(value_),
                    FTL_RANGES_NAMESPACE::move(other.value_)
                );
            }
        }

        return *this;
    }

    [[nodiscard]]
    constexpr bool has_value() const noexcept {
        return true;
    }

    [[nodiscard]]
    constexpr T& operator*() noexcept {
        return value_;
    }

    [[nodiscard]]
    constexpr const T& operator*() const noexcept {
        return value_;
    }

    [[nodiscard]]
    constexpr T* operator->() noexcept {
        return FTL_RANGES_NAMESPACE::addressof(value_);
    }

    [[nodiscard]]
    constexpr const T* operator->() const noexcept {
        return FTL_RANGES_NAMESPACE::addressof(value_);
    }
};

/*
 * non-propagating-cache: caching state that is deliberately reset by
 * copy and move so that views stay semantically value-like.
 */
template<class T>
    requires is_object_v<T>
class non_propagating_cache {
private:
    optional_storage<T> storage_;

public:
    constexpr non_propagating_cache() noexcept = default;

    constexpr non_propagating_cache(const non_propagating_cache&) noexcept {}

    constexpr non_propagating_cache(non_propagating_cache&& other) noexcept {
        other.reset();
    }

    constexpr ~non_propagating_cache() = default;

    constexpr non_propagating_cache& operator=(
        const non_propagating_cache& other
    ) noexcept {
        if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
            reset();
        }

        return *this;
    }

    constexpr non_propagating_cache& operator=(
        non_propagating_cache&& other
    ) noexcept {
        reset();
        other.reset();
        return *this;
    }

    [[nodiscard]]
    constexpr bool has_value() const noexcept {
        return storage_.engaged_;
    }

    [[nodiscard]]
    constexpr T& operator*() noexcept {
        return storage_.value_;
    }

    [[nodiscard]]
    constexpr const T& operator*() const noexcept {
        return storage_.value_;
    }

    constexpr void reset() noexcept {
        if (storage_.engaged_) {
            storage_.value_.~T();
            storage_.engaged_ = false;
        }
    }

    template<class... Args>
        requires constructible_from<T, Args...>
    constexpr T& emplace(Args&&... args) {
        reset();
        FTL_RANGES_NAMESPACE::construct_at(
            FTL_RANGES_NAMESPACE::addressof(storage_.value_),
            static_cast<Args&&>(args)...
        );
        storage_.engaged_ = true;
        return storage_.value_;
    }

    /*
     * Initialises directly from *iterator so that types which are not
     * movable can still be cached.
     */
    template<class Iterator>
    constexpr T& emplace_deref(const Iterator& iterator) {
        reset();
        ::new (
            static_cast<void*>(
                FTL_RANGES_NAMESPACE::addressof(storage_.value_)
            )
        ) T(*iterator);
        storage_.engaged_ = true;
        return storage_.value_;
    }
};

