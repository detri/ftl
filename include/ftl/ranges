class common_view : public view_interface<common_view<V>> {
    V base_ = V();

    template<class Base>
    static constexpr auto begin_impl(Base& base) {
        if constexpr (random_access_range<Base> && sized_range<Base>)
            return ranges::begin(base);
        else
            return common_iterator<iterator_t<Base>, sentinel_t<Base>>(ranges::begin(base));
