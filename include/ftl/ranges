struct as_const_fn : range_adaptor_closure<as_const_fn> {
  template <viewable_range R>
    requires input_range<all_t<R>>
  constexpr auto operator()(R &&range) const {
    using source_type = remove_cvref_t<R>;

    if constexpr (constant_range<all_t<R>>) {
      return all(static_cast<R &&>(range));
    } else if constexpr (as_const_empty_view_traits<source_type>::matches) {
      using element_type =
          typename as_const_empty_view_traits<source_type>::element_type;

      return views::empty<const element_type>;
    } else if constexpr (as_const_span_traits<source_type>::matches) {
      using traits = as_const_span_traits<source_type>;

      using element_type = typename traits::element_type;

      return span<const element_type, traits::extent>(static_cast<R &&>(range));
    } else if constexpr (as_const_ref_view_traits<source_type>::matches &&
                         as_const_ref_view_traits<source_type>::constant) {
      using range_type =
          typename as_const_ref_view_traits<source_type>::range_type;

      return ref_view<const range_type>(
          static_cast<const range_type &>(range.base()));
    } else if constexpr (is_lvalue_reference_v<R &&> &&
                         constant_range<const source_type> &&

                         !view<source_type>) {
      return ref_view<const source_type>(
          static_cast<const source_type &>(range));
