                                   const sentinel &bound) {
    return iterator == bound.end_ ||
           !FTL_RANGES_NAMESPACE::invoke(*bound.pred_, *iterator);
  }

  friend constexpr bool operator==(const sentinel &bound,
                                   const iterator_t<Base> &iterator) {
    return iterator == bound;
  }

  friend constexpr bool operator!=(const iterator_t<Base> &iterator,
                                   const sentinel &bound) {
    return !(iterator == bound);
  }

  friend constexpr bool operator!=(const sentinel &bound,
                                   const iterator_t<Base> &iterator) {
    return !(bound == iterator);
  }

  template <bool OtherConst = !Const>
    requires sentinel_for<sentinel_t<Base>, iterator_t<OtherBase<OtherConst>>>
  friend constexpr bool
  operator==(const iterator_t<OtherBase<OtherConst>> &iterator,
             const sentinel &bound) {
    return iterator == bound.end_ ||
           !FTL_RANGES_NAMESPACE::invoke(*bound.pred_, *iterator);
  }

