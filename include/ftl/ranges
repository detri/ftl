  constexpr reverse_iterator<iterator_t<V>> end() {
    return reverse_iterator<iterator_t<V>>(ranges::begin(base_));
  }

  [[nodiscard]]
  constexpr auto end() const
    requires common_range<const V>
  {
    return reverse_iterator<iterator_t<const V>>(ranges::begin(base_));
  }

  [[nodiscard]]
  constexpr auto size()
    requires sized_range<V>
  {
    return ranges::size(base_);
