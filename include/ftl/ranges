template <class...> inline constexpr bool to_dependent_false = false;

template <class Container>
concept to_reservable_container =
    sized_range<Container> &&
    requires(Container &container, range_size_t<Container> count) {
      container.reserve(count);

      { container.capacity() } -> same_as<decltype(count)>;

      { container.max_size() } -> same_as<decltype(count)>;
    };

template <class Container, class Reference>
concept to_container_appendable = requires(Container &container,
                                           Reference &&reference) {
  requires(
      requires {
        container.emplace_back(static_cast<Reference &&>(reference));
      } ||
      requires { container.push_back(static_cast<Reference &&>(reference)); } ||
      requires {
        container.emplace_hint(container.end(),
                               static_cast<Reference &&>(reference));
      } ||
      requires {
        container.insert(container.end(), static_cast<Reference &&>(reference));
      });
};

template <class Container, class Reference>
constexpr void to_container_append(Container &container,
                                   Reference &&reference) {
  if constexpr (requires {
                  container.emplace_back(static_cast<Reference &&>(reference));
                }) {
    container.emplace_back(static_cast<Reference &&>(reference));
  } else if constexpr (requires {
                         container.push_back(
                             static_cast<Reference &&>(reference));
                       }) {
    container.push_back(static_cast<Reference &&>(reference));
  } else if constexpr (requires {
                         container.emplace_hint(
                             container.end(),
                             static_cast<Reference &&>(reference));
                       }) {
    container.emplace_hint(container.end(),
                           static_cast<Reference &&>(reference));
  } else {
    container.insert(container.end(), static_cast<Reference &&>(reference));
  }
}

template <class R, class = void>
struct to_cpp17_input_common_range_impl : false_type {};

template <class R>
struct to_cpp17_input_common_range_impl<
    R, void_t<typename iterator_traits<iterator_t<R>>::iterator_category>>
    : bool_constant<common_range<R> &&
                    derived_from<typename iterator_traits<
                                     iterator_t<R>>::iterator_category,
                                 input_iterator_tag>> {};

template <class R>
concept to_cpp17_input_common_range =
    to_cpp17_input_common_range_impl<R>::value;

template <class C, input_range R, class... Args>
constexpr C to_nonrecursive(R &&range, Args &&...args) {
  if constexpr (constructible_from<C, R, Args...>) {
    return C(static_cast<R &&>(range), static_cast<Args &&>(args)...);
  } else if constexpr (constructible_from<C, from_range_t, R, Args...>) {
    return C(from_range, static_cast<R &&>(range),
             static_cast<Args &&>(args)...);
  } else if constexpr (to_cpp17_input_common_range<R> &&
                       constructible_from<C, iterator_t<R>, sentinel_t<R>,
                                          Args...>) {
    return C(ranges::begin(range), ranges::end(range),
             static_cast<Args &&>(args)...);
  } else if constexpr (constructible_from<C, Args...> &&
                       to_container_appendable<C, range_reference_t<R>>) {
    C result = C(static_cast<Args &&>(args)...);

    if constexpr (sized_range<R> && to_reservable_container<C>) {
      result.reserve(static_cast<range_size_t<C>>(ranges::size(range)));
    }

    auto current = ranges::begin(range);

    const auto bound = ranges::end(range);

    for (; current != bound; ++current) {
      to_container_append(result, *current);
    }

    return result;
  } else {
    static_assert(to_dependent_false<C, R, Args...>,
                  "ranges::to cannot construct or insert into "
                  "the requested target type");
  }
}

