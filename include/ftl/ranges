template <input_range V>
  requires view<V>
class stride_view : public view_interface<stride_view<V>> {
  V base_ = V();
  range_difference_t<V> stride_ = 1;

  template <bool Const>
  class iterator : public detail::stride_iterator_category<
                       detail::maybe_const_t<Const, V>> {
    using Base = detail::maybe_const_t<Const, V>;

    iterator_t<Base> current_;
    sentinel_t<Base> end_{};
    range_difference_t<Base> stride_ = 1;
    range_difference_t<Base> missing_ = 0;

    friend class stride_view;
    template <bool> friend class iterator;

    constexpr iterator(iterator_t<Base> current, sentinel_t<Base> end,
                       range_difference_t<Base> stride,
                       range_difference_t<Base> missing = 0)
        : current_(FTL_RANGES_NAMESPACE::move(current)),
          end_(FTL_RANGES_NAMESPACE::move(end)), stride_(stride),
          missing_(missing) {}

  public:
    using iterator_concept = conditional_t<
        random_access_range<Base>, random_access_iterator_tag,
        conditional_t<bidirectional_range<Base>, bidirectional_iterator_tag,
                      conditional_t<forward_range<Base>, forward_iterator_tag,
                                    input_iterator_tag>>>;

    using value_type = range_value_t<Base>;
    using difference_type = range_difference_t<Base>;

    iterator()
      requires default_initializable<iterator_t<Base>>
    = default;

    constexpr iterator(iterator<!Const> other)
      requires Const && convertible_to<iterator_t<V>, iterator_t<Base>> &&
                   convertible_to<sentinel_t<V>, sentinel_t<Base>>
        : current_(FTL_RANGES_NAMESPACE::move(other.current_)),
          end_(FTL_RANGES_NAMESPACE::move(other.end_)), stride_(other.stride_),
          missing_(other.missing_) {}

    constexpr iterator_t<Base> base() && {
      return FTL_RANGES_NAMESPACE::move(current_);
    }

    constexpr const iterator_t<Base> &base() const & noexcept {
      return current_;
    }

    constexpr decltype(auto) operator*() const { return *current_; }

    constexpr iterator &operator++() {
      missing_ = ranges::advance(current_, stride_, end_);
      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    constexpr iterator operator++(int)
      requires forward_range<Base>
    {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<Base>
    {
      ranges::advance(current_, missing_ - stride_);
      missing_ = 0;
      return *this;
    }

    constexpr iterator operator--(int)
      requires bidirectional_range<Base>
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    constexpr iterator &operator+=(difference_type n)
      requires random_access_range<Base>
    {
      if (n > 0) {
        ranges::advance(current_, stride_ * (n - 1));
        missing_ = ranges::advance(current_, stride_, end_);
      } else if (n < 0) {
        ranges::advance(current_, stride_ * n + missing_);
        missing_ = 0;
      }

      return *this;
    }

    constexpr iterator &operator-=(difference_type n)
      requires random_access_range<Base>
    {
      return *this += -n;
    }

    constexpr decltype(auto) operator[](difference_type n) const
      requires random_access_range<Base>
    {
      return *(*this + n);
    }

    friend constexpr bool operator==(const iterator &value,
                                     default_sentinel_t) {
      return value.current_ == value.end_;
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right)
      requires equality_comparable<iterator_t<Base>>
    {
      return left.current_ == right.current_;
    }

    friend constexpr bool operator<(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return left.current_ < right.current_;
    }

    friend constexpr bool operator>(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return right < left;
    }

    friend constexpr bool operator<=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(right < left);
    }

    friend constexpr bool operator>=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(left < right);
    }

    friend constexpr auto operator<=>(const iterator &left,
                                      const iterator &right)
      requires random_access_range<Base> &&
               three_way_comparable<iterator_t<Base>>
    {
      return left.current_ <=> right.current_;
    }

    friend constexpr iterator operator+(const iterator &value,
                                        difference_type n)
      requires random_access_range<Base>
    {
      auto result = value;
      result += n;
      return result;
    }

    friend constexpr iterator operator+(difference_type n,
                                        const iterator &value)
      requires random_access_range<Base>
    {
      return value + n;
    }

    friend constexpr iterator operator-(const iterator &value,
                                        difference_type n)
      requires random_access_range<Base>
    {
      auto result = value;
      result -= n;
      return result;
    }

    friend constexpr difference_type operator-(const iterator &left,
                                               const iterator &right)
      requires sized_sentinel_for<iterator_t<Base>, iterator_t<Base>>
    {
      auto distance = left.current_ - right.current_;

      if constexpr (forward_range<Base>) {
        return (distance + left.missing_ - right.missing_) / left.stride_;
      } else if (distance < 0) {
        return -((-distance + left.stride_ - 1) / left.stride_);
      } else {
        return (distance + left.stride_ - 1) / left.stride_;
      }
    }

    friend constexpr difference_type operator-(default_sentinel_t,
                                               const iterator &value)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      auto distance = value.end_ - value.current_;
      return (distance + value.stride_ - 1) / value.stride_;
    }

    friend constexpr difference_type operator-(const iterator &value,
                                               default_sentinel_t sentinel)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      return -(sentinel - value);
    }

    friend constexpr range_rvalue_reference_t<Base>
    iter_move(const iterator &value) noexcept(
        noexcept(ranges::iter_move(value.current_))) {
      return ranges::iter_move(value.current_);
    }

    friend constexpr void
    iter_swap(const iterator &left, const iterator &right) noexcept(
        noexcept(ranges::iter_swap(left.current_, right.current_)))
      requires indirectly_swappable<iterator_t<Base>>
    {
      ranges::iter_swap(left.current_, right.current_);
    }
  };

public:
  stride_view()
    requires default_initializable<V>
  = default;

  constexpr explicit stride_view(V base, range_difference_t<V> stride)
      : base_(FTL_RANGES_NAMESPACE::move(base)), stride_(stride) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr range_difference_t<V> stride() const noexcept { return stride_; }

  constexpr auto begin()
    requires(!detail::simple_view<V>)
  {
    return iterator<false>(ranges::begin(base_), ranges::end(base_), stride_);
  }

  constexpr auto begin() const
    requires range<const V>
  {
    return iterator<true>(ranges::begin(base_), ranges::end(base_),
                          static_cast<range_difference_t<const V>>(stride_));
  }

  constexpr auto end()
    requires(!detail::simple_view<V>)
  {
    if constexpr (common_range<V> && sized_range<V> && forward_range<V>) {
      auto missing = (stride_ - ranges::distance(base_) % stride_) % stride_;

      return iterator<false>(ranges::end(base_), ranges::end(base_), stride_,
                             missing);
    } else if constexpr (common_range<V> && !bidirectional_range<V>) {
      return iterator<false>(ranges::end(base_), ranges::end(base_), stride_);
    } else {
      return default_sentinel;
    }
  }

  constexpr auto end() const
    requires range<const V>
  {
    using difference_type = range_difference_t<const V>;
    auto stride = static_cast<difference_type>(stride_);

    if constexpr (common_range<const V> && sized_range<const V> &&
                  forward_range<const V>) {
      auto missing = (stride - ranges::distance(base_) % stride) % stride;

      return iterator<true>(ranges::end(base_), ranges::end(base_), stride,
                            missing);
    } else if constexpr (common_range<const V> &&
                         !bidirectional_range<const V>) {
      return iterator<true>(ranges::end(base_), ranges::end(base_), stride);
    } else {
      return default_sentinel;
    }
  }

  constexpr auto size()
    requires sized_range<V>
  {
    auto count = ranges::size(base_);
    auto stride = static_cast<decltype(count)>(stride_);
    return (count + stride - 1) / stride;
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    auto count = ranges::size(base_);
    auto stride = static_cast<decltype(count)>(stride_);
    return (count + stride - 1) / stride;
  }
};

template <class R>
stride_view(R &&, range_difference_t<views::all_t<R>>)
    -> stride_view<views::all_t<R>>;

template <class V>
inline constexpr bool enable_borrowed_range<stride_view<V>> =
    enable_borrowed_range<V>;

namespace detail {
template <class... Ranges>
concept zip_is_common =
    (sizeof...(Ranges) == 1 && (common_range<Ranges> && ...)) ||
    (!(bidirectional_range<Ranges> && ...) && (common_range<Ranges> && ...)) ||
    ((random_access_range<Ranges> && ...) && (sized_range<Ranges> && ...));

template <bool Const, class... Views>
concept zip_all_random_access =
    (random_access_range<maybe_const_t<Const, Views>> && ...);

template <bool Const, class... Views>
concept zip_all_bidirectional =
    (bidirectional_range<maybe_const_t<Const, Views>> && ...);

template <bool Const, class... Views>
concept zip_all_forward = (forward_range<maybe_const_t<Const, Views>> && ...);

template <bool Const, class... Views> struct zip_iterator_category {};

template <bool Const, class... Views>
  requires zip_all_forward<Const, Views...>
struct zip_iterator_category<Const, Views...> {
  using iterator_category = input_iterator_tag;
};

template <class Difference>
constexpr auto zip_absolute_value(Difference value) noexcept {
  using unsigned_type = make_unsigned_like_t<Difference>;

  const auto converted = static_cast<unsigned_type>(value);

  if constexpr (is_signed_v<Difference>) {
    if (value < Difference{0}) {
      return unsigned_type{0} - converted;
    }
  }

  return converted;
}

template <class Difference, class LeftTuple, class RightTuple, size_t... Index>
constexpr Difference zip_min_absolute_difference(const LeftTuple &left,
                                                 const RightTuple &right,
                                                 index_sequence<Index...>) {
  Difference result = static_cast<Difference>(get<0>(left) - get<0>(right));

  (
      [&] {
        const Difference candidate =
            static_cast<Difference>(get<Index>(left) - get<Index>(right));

        if (zip_absolute_value(candidate) < zip_absolute_value(result)) {
          result = candidate;
        }
      }(),
      ...);

  return result;
}
} // namespace detail

template <input_range... Views>
  requires((view<Views> && ...) && sizeof...(Views) > 0)
class zip_view : public view_interface<zip_view<Views...>> {
private:
  tuple<Views...> views_;

  template <bool Const> class iterator;

  template <bool Const> class sentinel;

  template <size_t... Index>
  constexpr iterator<false> begin_impl(index_sequence<Index...>) {
    return iterator<false>(
        tuple<iterator_t<Views>...>(ranges::begin(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr iterator<true> begin_impl(index_sequence<Index...>) const {
    return iterator<true>(tuple<iterator_t<const Views>...>(
        ranges::begin(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr sentinel<false> sentinel_end_impl(index_sequence<Index...>) {
    return sentinel<false>(
        tuple<sentinel_t<Views>...>(ranges::end(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr sentinel<true> sentinel_end_impl(index_sequence<Index...>) const {
    return sentinel<true>(
        tuple<sentinel_t<const Views>...>(ranges::end(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr iterator<false> iterator_end_impl(index_sequence<Index...>) {
    return iterator<false>(
        tuple<iterator_t<Views>...>(ranges::end(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr iterator<true> iterator_end_impl(index_sequence<Index...>) const {
    return iterator<true>(
        tuple<iterator_t<const Views>...>(ranges::end(get<Index>(views_))...));
  }

  template <size_t... Index>
  constexpr auto size_impl(index_sequence<Index...>)
    requires(sized_range<Views> && ...)
  {
    using size_type =
        detail::make_unsigned_like_t<common_type_t<range_size_t<Views>...>>;

    size_type result = static_cast<size_type>(ranges::size(get<0>(views_)));

    (
        [&] {
          const size_type candidate =
              static_cast<size_type>(ranges::size(get<Index>(views_)));

          if (candidate < result) {
            result = candidate;
          }
        }(),
        ...);

    return result;
  }

  template <size_t... Index>
  constexpr auto size_impl(index_sequence<Index...>) const
    requires(sized_range<const Views> && ...)
  {
    using size_type = detail::make_unsigned_like_t<
        common_type_t<range_size_t<const Views>...>>;

    size_type result = static_cast<size_type>(ranges::size(get<0>(views_)));

    (
        [&] {
          const size_type candidate =
              static_cast<size_type>(ranges::size(get<Index>(views_)));

          if (candidate < result) {
            result = candidate;
          }
        }(),
        ...);

    return result;
  }

  template <bool Const>
  class iterator : public detail::zip_iterator_category<Const, Views...> {
  public:
    using iterator_concept = conditional_t<
        detail::zip_all_random_access<Const, Views...>,
        random_access_iterator_tag,
        conditional_t<detail::zip_all_bidirectional<Const, Views...>,
                      bidirectional_iterator_tag,
                      conditional_t<detail::zip_all_forward<Const, Views...>,
                                    forward_iterator_tag, input_iterator_tag>>>;

    using value_type =
        tuple<range_value_t<detail::maybe_const_t<Const, Views>>...>;

    using difference_type = common_type_t<
        range_difference_t<detail::maybe_const_t<Const, Views>>...>;

    using reference =
        tuple<range_reference_t<detail::maybe_const_t<Const, Views>>...>;

  private:
    using current_tuple =
        tuple<iterator_t<detail::maybe_const_t<Const, Views>>...>;

    current_tuple current_;

    // private helpers...

    constexpr explicit iterator(current_tuple current)
        : current_(FTL_RANGES_NAMESPACE::move(current)) {}

    template <size_t... Index>
    constexpr reference dereference(index_sequence<Index...>) const {
      return reference(*get<Index>(current_)...);
    }

    template <size_t... Index>
    constexpr void increment(index_sequence<Index...>) {
      (++get<Index>(current_), ...);
    }

    template <size_t... Index>
    constexpr void decrement(index_sequence<Index...>) {
      (--get<Index>(current_), ...);
    }

    template <size_t... Index>
    constexpr void advance(difference_type offset, index_sequence<Index...>) {
      ((get<Index>(current_) +=
        static_cast<range_difference_t<detail::maybe_const_t<Const, Views>>>(
            offset)),
       ...);
    }

    template <size_t... Index>
    constexpr void retreat(difference_type offset, index_sequence<Index...>) {
      ((get<Index>(current_) -=
        static_cast<range_difference_t<detail::maybe_const_t<Const, Views>>>(
            offset)),
       ...);
    }

    template <size_t... Index>
    constexpr auto move_values(index_sequence<Index...>) const noexcept(
        (noexcept(ranges::iter_move(get<Index>(current_))) && ...) &&
        (is_nothrow_move_constructible_v<
             range_rvalue_reference_t<detail::maybe_const_t<Const, Views>>> &&
         ...)) {
      return tuple<
          range_rvalue_reference_t<detail::maybe_const_t<Const, Views>>...>(
          ranges::iter_move(get<Index>(current_))...);
    }

    template <size_t... Index>
    static consteval bool swap_is_noexcept(index_sequence<Index...>) {
      return (noexcept(ranges::iter_swap(
                  get<Index>(declval<const current_tuple &>()),
                  get<Index>(declval<const current_tuple &>()))) &&
              ...);
    }

    template <size_t... Index>
    static constexpr void swap_values(
        const iterator &left, const iterator &right,
        index_sequence<
            Index...>) noexcept(swap_is_noexcept(index_sequence<Index...>{})) {
      (ranges::iter_swap(get<Index>(left.current_), get<Index>(right.current_)),
       ...);
    }

    friend class zip_view;
    friend class iterator<!Const>;
    friend class sentinel<Const>;
    friend class sentinel<!Const>;

  public:
    iterator() = default;

    constexpr iterator(iterator<!Const> other)
      requires(Const &&
               (convertible_to<iterator_t<Views>, iterator_t<const Views>> &&
                ...))
        : current_(FTL_RANGES_NAMESPACE::move(other.current_)) {}

    [[nodiscard]]
    constexpr const auto &base() const noexcept {
      return current_;
    }

    [[nodiscard]]
    constexpr reference operator*() const {
      return dereference(index_sequence_for<Views...>{});
    }

    constexpr iterator &operator++() {
      increment(index_sequence_for<Views...>{});

      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    constexpr iterator operator++(int)
      requires(detail::zip_all_forward<Const, Views...>)
    {
      auto previous = *this;
      ++*this;
      return previous;
    }

    constexpr iterator &operator--()
      requires(detail::zip_all_bidirectional<Const, Views...>)
    {
      decrement(index_sequence_for<Views...>{});

      return *this;
    }

    constexpr iterator operator--(int)
      requires(detail::zip_all_bidirectional<Const, Views...>)
    {
      auto previous = *this;
      --*this;
      return previous;
    }

    constexpr iterator &operator+=(difference_type offset)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      advance(offset, index_sequence_for<Views...>{});

      return *this;
    }

    constexpr iterator &operator-=(difference_type offset)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      retreat(offset, index_sequence_for<Views...>{});

      return *this;
    }

    [[nodiscard]]
    constexpr reference operator[](difference_type offset) const
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      return *(*this + offset);
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right)
      requires(equality_comparable<
                   iterator_t<detail::maybe_const_t<Const, Views>>> &&
               ...)
    {
      if constexpr (detail::zip_all_bidirectional<Const, Views...>) {
        return left.current_ == right.current_;
      } else {
        return [&]<size_t... Index>(index_sequence<Index...>) {
          return ((get<Index>(left.current_) == get<Index>(right.current_)) ||
                  ...);
        }(index_sequence_for<Views...>{});
      }
    }

    friend constexpr auto operator<=>(const iterator &left,
                                      const iterator &right)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      return left.current_ <=> right.current_;
    }

    friend constexpr iterator operator+(const iterator &value,
                                        difference_type offset)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      auto result = value;
      result += offset;
      return result;
    }

    friend constexpr iterator operator+(difference_type offset,
                                        const iterator &value)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      auto result = value;
      result += offset;
      return result;
    }

    friend constexpr iterator operator-(const iterator &value,
                                        difference_type offset)
      requires(detail::zip_all_random_access<Const, Views...>)
    {
      auto result = value;
      result -= offset;
      return result;
    }

    friend constexpr difference_type operator-(const iterator &left,
                                               const iterator &right)
      requires(
          sized_sentinel_for<iterator_t<detail::maybe_const_t<Const, Views>>,
                             iterator_t<detail::maybe_const_t<Const, Views>>> &&
          ...)
    {
      return detail::zip_min_absolute_difference<difference_type>(
          left.current_, right.current_, index_sequence_for<Views...>{});
    }

    friend constexpr auto iter_move(const iterator &value) noexcept(
        (noexcept(ranges::iter_move(
             declval<
                 const iterator_t<detail::maybe_const_t<Const, Views>> &>())) &&
         ...) &&
        (is_nothrow_move_constructible_v<
             range_rvalue_reference_t<detail::maybe_const_t<Const, Views>>> &&
         ...)) {
      return value.move_values(index_sequence_for<Views...>{});
    }

    friend constexpr void
    iter_swap(const iterator &left, const iterator &right) noexcept(
        swap_is_noexcept(index_sequence_for<Views...>{}))
      requires(indirectly_swappable<
                   iterator_t<detail::maybe_const_t<Const, Views>>> &&
               ...)
    {
      swap_values(left, right, index_sequence_for<Views...>{});
    }
  };

  template <bool Const> class sentinel {
  private:
    using end_tuple = tuple<sentinel_t<detail::maybe_const_t<Const, Views>>...>;

    end_tuple end_;

    constexpr explicit sentinel(end_tuple end)
        : end_(FTL_RANGES_NAMESPACE::move(end)) {}

    template <bool OtherConst>
    constexpr bool equal(const iterator<OtherConst> &value) const
      requires(
          sentinel_for<sentinel_t<detail::maybe_const_t<Const, Views>>,
                       iterator_t<detail::maybe_const_t<OtherConst, Views>>> &&
          ...)
    {
      return [&]<size_t... Index>(index_sequence<Index...>) {
        return ((get<Index>(value.current_) == get<Index>(end_)) || ...);
      }(index_sequence_for<Views...>{});
    }

    template <bool OtherConst>
    constexpr auto distance_from(const iterator<OtherConst> &value) const
      requires(sized_sentinel_for<
                   sentinel_t<detail::maybe_const_t<Const, Views>>,
                   iterator_t<detail::maybe_const_t<OtherConst, Views>>> &&
               ...)
    {
      using difference_type = common_type_t<
          range_difference_t<detail::maybe_const_t<OtherConst, Views>>...>;

      return detail::zip_min_absolute_difference<difference_type>(
          value.current_, end_, index_sequence_for<Views...>{});
    }

    friend class zip_view;
    friend class sentinel<!Const>;

  public:
    sentinel() = default;

    constexpr sentinel(sentinel<!Const> other)
      requires(Const &&
               (convertible_to<sentinel_t<Views>, sentinel_t<const Views>> &&
                ...))
        : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}

    template <bool OtherConst>
      requires(
          sentinel_for<sentinel_t<detail::maybe_const_t<Const, Views>>,
                       iterator_t<detail::maybe_const_t<OtherConst, Views>>> &&
          ...)
    friend constexpr bool operator==(const iterator<OtherConst> &value,
                                     const sentinel &bound) {
      return bound.equal(value);
    }

    template <bool OtherConst>
      requires(sized_sentinel_for<
                   sentinel_t<detail::maybe_const_t<Const, Views>>,
                   iterator_t<detail::maybe_const_t<OtherConst, Views>>> &&
               ...)
    friend constexpr auto operator-(const iterator<OtherConst> &value,
                                    const sentinel &bound) {
      return bound.distance_from(value);
    }

    template <bool OtherConst>
      requires(sized_sentinel_for<
                   sentinel_t<detail::maybe_const_t<Const, Views>>,
                   iterator_t<detail::maybe_const_t<OtherConst, Views>>> &&
               ...)
    friend constexpr auto operator-(const sentinel &bound,
                                    const iterator<OtherConst> &value) {
      return -bound.distance_from(value);
    }
  };

public:
  zip_view() = default;

  constexpr explicit zip_view(Views... views)
      : views_(FTL_RANGES_NAMESPACE::move(views)...) {}

  [[nodiscard]]
  constexpr auto begin()
    requires(!(detail::simple_view<Views> && ...))
  {
    return begin_impl(index_sequence_for<Views...>{});
  }

  [[nodiscard]]
  constexpr auto begin() const
    requires(range<const Views> && ...)
  {
    return begin_impl(index_sequence_for<Views...>{});
  }

  [[nodiscard]]
  constexpr auto end()
    requires(!(detail::simple_view<Views> && ...))
  {
    if constexpr (!detail::zip_is_common<Views...>) {
      return sentinel_end_impl(index_sequence_for<Views...>{});
    } else if constexpr ((random_access_range<Views> && ...)) {
      using result_iterator = iterator<false>;

      return begin() +
             static_cast<typename result_iterator::difference_type>(size());
    } else {
      return iterator_end_impl(index_sequence_for<Views...>{});
    }
  }

  [[nodiscard]]
  constexpr auto end() const
    requires(range<const Views> && ...)
  {
    if constexpr (!detail::zip_is_common<const Views...>) {
      return sentinel_end_impl(index_sequence_for<Views...>{});
    } else if constexpr ((random_access_range<const Views> && ...)) {
      using result_iterator = iterator<true>;

      return begin() +
             static_cast<typename result_iterator::difference_type>(size());
    } else {
      return iterator_end_impl(index_sequence_for<Views...>{});
    }
  }

  [[nodiscard]]
  constexpr auto size()
    requires(sized_range<Views> && ...)
  {
    return size_impl(index_sequence_for<Views...>{});
  }

  [[nodiscard]]
  constexpr auto size() const
    requires(sized_range<const Views> && ...)
  {
    return size_impl(index_sequence_for<Views...>{});
  }
};

