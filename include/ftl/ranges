namespace detail
{

struct reverse_view_empty_cache
{
};

template<class V>
using reverse_view_cache_t =
    conditional_t<
        common_range<V>,
        reverse_view_empty_cache,
        non_propagating_cache<
            reverse_iterator<iterator_t<V>>
        >
    >;

} // namespace detail


template<view V>
    requires bidirectional_range<V>
class reverse_view
    : public view_interface<reverse_view<V>>
{
private:
    FTL_NO_UNIQUE_ADDRESS
    detail::reverse_view_cache_t<V> cached_begin_{};

    FTL_NO_UNIQUE_ADDRESS
    V base_ = V();

public:
    reverse_view()
        requires default_initializable<V>
        = default;

    constexpr explicit reverse_view(V base)
        : base_(static_cast<V&&>(base))
    {
    }

    [[nodiscard]]
    constexpr V base() const&
        requires copy_constructible<V>
    {
        return base_;
    }

    [[nodiscard]]
    constexpr V base() &&
    {
        return static_cast<V&&>(base_);
    }

    [[nodiscard]]
    constexpr reverse_iterator<iterator_t<V>> begin()
    {
        if constexpr (!common_range<V>)
        {
            if (cached_begin_.has_value())
                return *cached_begin_;
        }

        reverse_iterator<iterator_t<V>> result(
            ranges::next(
                ranges::begin(base_),
                ranges::end(base_)
            )
        );

        if constexpr (!common_range<V>)
            cached_begin_.emplace(result);

        return result;
    }

    [[nodiscard]]
    constexpr reverse_iterator<iterator_t<V>> begin()
        requires common_range<V>
    {
        return reverse_iterator<iterator_t<V>>(
            ranges::end(base_)
        );
    }

    [[nodiscard]]
    constexpr auto begin() const
        requires common_range<const V>
    {
        return reverse_iterator<iterator_t<const V>>(
            ranges::end(base_)
        );
    }

    [[nodiscard]]
    constexpr reverse_iterator<iterator_t<V>> end()
    {
        return reverse_iterator<iterator_t<V>>(
            ranges::begin(base_)
        );
    }

    [[nodiscard]]
    constexpr auto end() const
        requires common_range<const V>
    {
        return reverse_iterator<iterator_t<const V>>(
            ranges::begin(base_)
        );
    }

    [[nodiscard]]
    constexpr auto size()
        requires sized_range<V>
    {
        return ranges::size(base_);
    }

    [[nodiscard]]
    constexpr auto size() const
        requires sized_range<const V>
    {
        return ranges::size(base_);
    }
};


template<class R>
reverse_view(R&&) -> reverse_view<views::all_t<R>>;


template<class V>
inline constexpr bool enable_borrowed_range<reverse_view<V>> =
    enable_borrowed_range<V>;

