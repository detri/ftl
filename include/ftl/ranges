    constexpr auto begin() const
        requires forward_range<const V> && is_reference_v<range_reference_t<const V>> &&
            input_range<range_reference_t<const V>>
    { return iterator<true>(*this, ranges::begin(base_)); }

    constexpr auto end() {
        if constexpr (forward_range<V> && inner_is_reference<false> &&
            forward_range<InnerRange> && common_range<V> && common_range<InnerRange>)
            return iterator<false>(*this, ranges::end(base_));
        else return sentinel<false>(*this);
    }
    constexpr auto end() const
        requires forward_range<const V> && is_reference_v<range_reference_t<const V>> &&
            input_range<range_reference_t<const V>>
    {
        using CInner = range_reference_t<const V>;
        if constexpr (forward_range<CInner> && common_range<const V> && common_range<CInner>)
            return iterator<true>(*this, ranges::end(base_));
        else return sentinel<true>(*this);
    }

    template<bool Const>
    class iterator {
        using Parent = conditional_t<Const, const join_view, join_view>;
        using BaseType = Base<Const>;
        using OuterType = Outer<Const>;
        using InnerType = Inner<Const>;
        static constexpr bool ref = inner_is_reference<Const>;

        OuterType outer_value_{};
        detail::join_inner_storage<InnerType> inner_;
        Parent* parent_ = nullptr;

        constexpr OuterType& outer() {
            if constexpr (forward_range<BaseType>) return outer_value_;
            else return *parent_->outer_;
        }
        constexpr const OuterType& outer() const {
            if constexpr (forward_range<BaseType>) return outer_value_;
            else return *parent_->outer_;
        }
        constexpr decltype(auto) current_inner_range() const {
            if constexpr (ref) return *outer();
            else return *parent_->inner_range_;
        }
        constexpr void satisfy() {
            auto bound = ranges::end(parent_->base_);
            while (outer() != bound) {
                if constexpr (ref) {
                    auto&& range = *outer();
                    inner_.set(ranges::begin(range));
                    if (inner_.get() != ranges::end(range)) return;
                } else {
                    auto& range = parent_->inner_range_.emplace_deref(outer());
                    inner_.set(ranges::begin(range));
                    if (inner_.get() != ranges::end(range)) return;
                }
                ++outer();
            }
            inner_.clear();
        }

        friend class iterator<!Const>;
        friend class sentinel<Const>;
        friend class sentinel<!Const>;

    public:
        using iterator_concept = conditional_t<
            ref && bidirectional_range<BaseType> && bidirectional_range<range_reference_t<BaseType>> &&
                common_range<range_reference_t<BaseType>>, bidirectional_iterator_tag,
            conditional_t<ref && forward_range<BaseType> && forward_range<range_reference_t<BaseType>>,
                forward_iterator_tag, input_iterator_tag>>;
        using iterator_category = conditional_t<same_as<iterator_concept, bidirectional_iterator_tag>,
            bidirectional_iterator_tag, conditional_t<same_as<iterator_concept, forward_iterator_tag>,
            forward_iterator_tag, input_iterator_tag>>;
        using value_type = range_value_t<range_reference_t<BaseType>>;
        using difference_type = common_type_t<range_difference_t<BaseType>,
            range_difference_t<range_reference_t<BaseType>>>;

        iterator() = default;
        constexpr iterator(Parent& parent, OuterType outer)
            requires forward_range<BaseType>
            : outer_value_(FTL_RANGES_NAMESPACE::move(outer)), parent_(FTL_RANGES_NAMESPACE::addressof(parent))
        { satisfy(); }
        constexpr explicit iterator(Parent& parent)
            requires (!forward_range<BaseType>)
            : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) { satisfy(); }
        constexpr iterator(iterator<!Const> other)
            requires Const && convertible_to<iterator_t<V>, OuterType> &&
                convertible_to<iterator_t<InnerRange>, InnerType>
            : outer_value_(FTL_RANGES_NAMESPACE::move(other.outer_value_)),
              parent_(other.parent_) {
            if (outer_value_ != ranges::end(parent_->base_))
                inner_.set(InnerType(other.inner_.get()));
        }

        constexpr decltype(auto) operator*() const { return *inner_.get(); }
        constexpr InnerType operator->() const requires copyable<InnerType> { return inner_.get(); }
        constexpr iterator& operator++() {
            auto&& range = current_inner_range();
            if (++inner_.get() == ranges::end(range)) { ++outer(); satisfy(); }
            return *this;
        }
        constexpr void operator++(int) { ++*this; }
        constexpr iterator operator++(int)
            requires ref && forward_range<BaseType> && forward_range<range_reference_t<BaseType>>
        { auto copy = *this; ++*this; return copy; }
        constexpr iterator& operator--()
            requires ref && bidirectional_range<BaseType> &&
                bidirectional_range<range_reference_t<BaseType>> && common_range<range_reference_t<BaseType>>
        {
            if (outer() == ranges::end(parent_->base_)) {
                --outer();
                inner_.set(ranges::end(*outer()));
            }
            while (inner_.get() == ranges::begin(*outer())) {
                --outer();
                inner_.set(ranges::end(*outer()));
            }
            --inner_.get();
            return *this;
        }
        constexpr iterator operator--(int) requires requires(iterator current) { --current; }
        { auto copy = *this; --*this; return copy; }

        friend constexpr bool operator==(const iterator& left, const iterator& right)
            requires ref && forward_range<BaseType> && equality_comparable<InnerType>
        { return left.outer() == right.outer() && left.inner_.get() == right.inner_.get(); }
    };

    template<bool Const>
    class sentinel {
        using BaseType = Base<Const>;
        sentinel_t<BaseType> end_{};
        friend class sentinel<!Const>;
    public:
        sentinel() = default;
        constexpr explicit sentinel(conditional_t<Const, const join_view, join_view>& parent)
            : end_(ranges::end(parent.base_)) {}
        constexpr sentinel(sentinel<!Const> other)
            requires Const && convertible_to<sentinel_t<V>, sentinel_t<BaseType>>
            : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}
        template<bool C>
        friend constexpr bool operator==(const iterator<C>& current, const sentinel& bound)
            requires sentinel_for<sentinel_t<BaseType>, iterator_t<Base<C>>>
        { return current.outer() == bound.end_; }
    };
};

