namespace detail {
template <class I, bool = forward_iterator<I>> struct join_inner_storage {
  non_propagating_cache<I> value;

  constexpr I &get() { return *value; }

  constexpr const I &get() const { return *value; }

  constexpr void set(I current) {
    value.emplace(FTL_RANGES_NAMESPACE::move(current));
  }

  constexpr void clear() { value.reset(); }
};

template <class I> struct join_inner_storage<I, true> {
  I value{};

  constexpr I &get() { return value; }

  constexpr const I &get() const { return value; }

  constexpr void set(I current) { value = FTL_RANGES_NAMESPACE::move(current); }

  constexpr void clear() { value = I(); }
};

template <class Base, bool = is_reference_v<range_reference_t<Base>> &&
                             forward_range<Base> &&
                             forward_range<range_reference_t<Base>>>
struct join_iterator_category {};

template <class Base> struct join_iterator_category<Base, true> {
private:
  using outer_category =
      typename iterator_traits<iterator_t<Base>>::iterator_category;

  using inner_range = range_reference_t<Base>;

  using inner_category =
      typename iterator_traits<iterator_t<inner_range>>::iterator_category;

public:
  using iterator_category = conditional_t<
      derived_from<outer_category, bidirectional_iterator_tag> &&
          derived_from<inner_category, bidirectional_iterator_tag> &&
          common_range<inner_range>,
      bidirectional_iterator_tag,
      conditional_t<derived_from<outer_category, forward_iterator_tag> &&
                        derived_from<inner_category, forward_iterator_tag>,
                    forward_iterator_tag, input_iterator_tag>>;
};
} // namespace detail

template <input_range V>
  requires view<V> && input_range<range_reference_t<V>>
class join_view : public view_interface<join_view<V>> {
  using InnerRange = range_reference_t<V>;
  template <bool Const> using Base = conditional_t<Const, const V, V>;
  template <bool Const> using Outer = iterator_t<Base<Const>>;
  template <bool Const>
  using Inner = iterator_t<range_reference_t<Base<Const>>>;
  template <bool Const>
  static constexpr bool inner_is_reference =
      is_reference_v<range_reference_t<Base<Const>>>;

  V base_ = V();
  detail::non_propagating_cache<iterator_t<V>> outer_;
  detail::non_propagating_cache<remove_cvref_t<InnerRange>> inner_range_;

public:
  template <bool Const> class iterator;
  template <bool Const> class sentinel;

  join_view()
    requires default_initializable<V>
  = default;

  constexpr explicit join_view(V base)
      : base_(FTL_RANGES_NAMESPACE::move(base)) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr auto begin() {
    if constexpr (forward_range<V>)
      return iterator<false>(*this, ranges::begin(base_));
    else {
      outer_.emplace(ranges::begin(base_));
      return iterator<false>(*this);
    }
  }

  constexpr auto begin() const
    requires forward_range<const V> &&
             is_reference_v<range_reference_t<const V>> &&
             input_range<range_reference_t<const V>>
  {
    return iterator<true>(*this, ranges::begin(base_));
  }

  constexpr auto end() {
    if constexpr (forward_range<V> && inner_is_reference<false> &&
                  forward_range<InnerRange> && common_range<V> &&
                  common_range<InnerRange>)
      return iterator<false>(*this, ranges::end(base_));
    else
      return sentinel<false>(*this);
  }

  constexpr auto end() const
    requires forward_range<const V> &&
             is_reference_v<range_reference_t<const V>> &&
             input_range<range_reference_t<const V>>
  {
    using CInner = range_reference_t<const V>;
    if constexpr (forward_range<CInner> && common_range<const V> &&
                  common_range<CInner>)
      return iterator<true>(*this, ranges::end(base_));
    else
      return sentinel<true>(*this);
  }

  template <bool Const>
  class iterator : public detail::join_iterator_category<Base<Const>> {
    using Parent = conditional_t<Const, const join_view, join_view>;
    using BaseType = Base<Const>;
    using OuterType = Outer<Const>;
    using InnerType = Inner<Const>;
    static constexpr bool ref = inner_is_reference<Const>;

    detail::maybe_present<OuterType, forward_range<BaseType>> outer_value_{};
    detail::join_inner_storage<InnerType> inner_;
    Parent *parent_ = nullptr;

    constexpr OuterType &outer() {
      if constexpr (forward_range<BaseType>) {
        return outer_value_.value;
      } else {
        return *parent_->outer_;
      }
    }

    constexpr const OuterType &outer() const {
      if constexpr (forward_range<BaseType>) {
        return outer_value_.value;
      } else {
        return *parent_->outer_;
      }
    }

    constexpr decltype(auto) current_inner_range() const {
      if constexpr (ref)
        return *outer();
      else
        return *parent_->inner_range_;
    }

    constexpr void satisfy() {
      auto bound = ranges::end(parent_->base_);
      while (outer() != bound) {
        if constexpr (ref) {
          auto &&range = *outer();
          inner_.set(ranges::begin(range));
          if (inner_.get() != ranges::end(range))
            return;
        } else {
          auto &range = parent_->inner_range_.emplace_deref(outer());
          inner_.set(ranges::begin(range));
          if (inner_.get() != ranges::end(range))
            return;
        }
        ++outer();
      }
      inner_.clear();
    }

    friend class iterator<!Const>;
    friend class sentinel<Const>;
    friend class sentinel<!Const>;

  public:
    using iterator_concept = conditional_t<
        ref && bidirectional_range<BaseType> &&
            bidirectional_range<range_reference_t<BaseType>> &&
            common_range<range_reference_t<BaseType>>,
        bidirectional_iterator_tag,
        conditional_t<ref && forward_range<BaseType> &&
                          forward_range<range_reference_t<BaseType>>,
                      forward_iterator_tag, input_iterator_tag>>;
    using value_type = range_value_t<range_reference_t<BaseType>>;
    using difference_type =
        common_type_t<range_difference_t<BaseType>,
                      range_difference_t<range_reference_t<BaseType>>>;

    iterator() = default;

    constexpr iterator(Parent &parent, OuterType outer)
      requires forward_range<BaseType>
        : outer_value_{FTL_RANGES_NAMESPACE::move(outer)},
          parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {
      satisfy();
    }

    constexpr explicit iterator(Parent &parent)
      requires(!forward_range<BaseType>)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {
      satisfy();
    }

    constexpr iterator(iterator<!Const> other)
      requires Const && convertible_to<iterator_t<V>, OuterType> &&
                   convertible_to<iterator_t<InnerRange>, InnerType>
        : outer_value_{FTL_RANGES_NAMESPACE::move(other.outer_value_.value)},
          parent_(other.parent_) {
      if (outer_value_.value != ranges::end(parent_->base_)) {
        inner_.set(InnerType(other.inner_.get()));
      }
    }

    [[nodiscard]]
    constexpr const OuterType &outer_base() const {
      return outer();
    }

    constexpr decltype(auto) operator*() const { return *inner_.get(); }

    constexpr InnerType operator->() const
      requires copyable<InnerType>
    {
      return inner_.get();
    }

    constexpr iterator &operator++() {
      auto &&range = current_inner_range();
      if (++inner_.get() == ranges::end(range)) {
        ++outer();
        satisfy();
      }
      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    constexpr iterator operator++(int)
      requires ref && forward_range<BaseType> &&
               forward_range<range_reference_t<BaseType>>
    {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires ref && bidirectional_range<BaseType> &&
               bidirectional_range<range_reference_t<BaseType>> &&
               common_range<range_reference_t<BaseType>>
    {
      if (outer() == ranges::end(parent_->base_)) {
        --outer();
        inner_.set(ranges::end(*outer()));
      }
      while (inner_.get() == ranges::begin(*outer())) {
        --outer();
        inner_.set(ranges::end(*outer()));
      }
      --inner_.get();
      return *this;
    }

    constexpr iterator operator--(int)
      requires requires(iterator current) { --current; }
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right)
      requires ref && forward_range<BaseType> && equality_comparable<InnerType>
    {
      return left.outer() == right.outer() &&
             left.inner_.get() == right.inner_.get();
    }
  };

  template <bool Const> class sentinel {
    using BaseType = Base<Const>;
    sentinel_t<BaseType> end_{};
    friend class sentinel<!Const>;

  public:
    sentinel() = default;

    constexpr explicit sentinel(
        conditional_t<Const, const join_view, join_view> &parent)
        : end_(ranges::end(parent.base_)) {}

    constexpr sentinel(sentinel<!Const> other)
      requires Const && convertible_to<sentinel_t<V>, sentinel_t<BaseType>>
        : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}

    template <bool C>
    friend constexpr bool operator==(const iterator<C> &current,
                                     const sentinel &bound)
      requires sentinel_for<sentinel_t<BaseType>, iterator_t<Base<C>>>
    {
      return current.outer_base() == bound.end_;
    }
  };
};

