    operator-(const iterator<false> &value, const sentinel &bound)
      requires sized_sentinel_for<sentinel_t<V>, iterator_t<V>>
    {
      return value.last_ele_.value - bound.end_;
    }

    friend constexpr range_difference_t<V>
    operator-(const sentinel &bound, const iterator<false> &value)
      requires sized_sentinel_for<sentinel_t<V>, iterator_t<V>>
    {
      return bound.end_ - value.last_ele_.value;
    }
  };

public:
  constexpr explicit slide_view(V base, range_difference_t<V> count)
      : base_(FTL_RANGES_NAMESPACE::move(base)), count_(count) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr auto begin()
    requires(!(detail::simple_view<V> && detail::slide_caches_nothing<const V>))
  {
    auto first = ranges::begin(base_);

    if constexpr (detail::slide_caches_first<V>) {
      if (!cache_.has_value()) {
        cache_.emplace(ranges::next(first, count_ - 1, ranges::end(base_)));
      }

      return iterator<false>(first, *cache_, count_);
    } else {
      return iterator<false>(first, count_);
    }
  }

  constexpr auto begin() const
    requires detail::slide_caches_nothing<const V>
  {
    return iterator<true>(ranges::begin(base_),
                          static_cast<range_difference_t<const V>>(count_));
  }

  constexpr auto end()
    requires(!(detail::simple_view<V> && detail::slide_caches_nothing<const V>))
  {
    if constexpr (detail::slide_caches_nothing<V>) {
      return iterator<false>(ranges::begin(base_) +
                                 static_cast<range_difference_t<V>>(size()),
                             count_);
    } else if constexpr (detail::slide_caches_last<V>) {
      if (!cache_.has_value()) {
        cache_.emplace(
            ranges::prev(ranges::end(base_), count_ - 1, ranges::begin(base_)));
      }

      return iterator<false>(*cache_, count_);
    } else if constexpr (common_range<V>) {
      return iterator<false>(ranges::end(base_), ranges::end(base_), count_);
    } else {
      return sentinel(ranges::end(base_));
    }
  }

  constexpr auto end() const
    requires detail::slide_caches_nothing<const V>
  {
    return begin() + static_cast<range_difference_t<const V>>(size());
  }

  constexpr auto size()
    requires sized_range<V>
  {
    auto result = ranges::distance(base_) - count_ + 1;
    if (result < 0)
      result = 0;
    return detail::to_unsigned_like(result);
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    auto result = ranges::distance(base_) -
                  static_cast<range_difference_t<const V>>(count_) + 1;

    if (result < 0)
      result = 0;

    return detail::to_unsigned_like(result);
  }
};

template <class R>
slide_view(R &&, range_difference_t<views::all_t<R>>)
    -> slide_view<views::all_t<R>>;

template <class V>
inline constexpr bool enable_borrowed_range<slide_view<V>> =
    enable_borrowed_range<V>;

template <forward_range V, class Pred>
  requires view<V> && is_object_v<Pred> &&
           indirect_binary_predicate<Pred, iterator_t<V>, iterator_t<V>>
class chunk_by_view : public view_interface<chunk_by_view<V, Pred>> {
  V base_ = V();
  detail::movable_box<Pred> pred_;

  constexpr iterator_t<V> find_next(iterator_t<V> current) {
    auto end = ranges::end(base_);
    if (current == end)
      return current;
    auto next = current;
    while (++next != end &&
           FTL_RANGES_NAMESPACE::invoke(*pred_, *current, *next))
      current = next;
    return next;
  }

  constexpr iterator_t<V> find_previous(iterator_t<V> current)
    requires bidirectional_range<V>
  {
    auto previous = ranges::begin(base_);
    auto next = find_next(previous);
    while (next != current) {
      previous = next;
      next = find_next(previous);
    }
    return previous;
  }

public:
  class iterator {
    chunk_by_view *parent_ = nullptr;
    iterator_t<V> current_{};
    iterator_t<V> next_{};

  public:
    using iterator_concept =
        conditional_t<bidirectional_range<V>, bidirectional_iterator_tag,
                      forward_iterator_tag>;
    using iterator_category = input_iterator_tag;
    using value_type = subrange<iterator_t<V>>;
    using difference_type = range_difference_t<V>;

    iterator() = default;

    constexpr iterator(chunk_by_view &parent, iterator_t<V> current,
                       iterator_t<V> next)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)),
          current_(FTL_RANGES_NAMESPACE::move(current)),
          next_(FTL_RANGES_NAMESPACE::move(next)) {}

    constexpr auto operator*() const { return subrange(current_, next_); }

    constexpr iterator &operator++() {
      current_ = next_;
      next_ = parent_->find_next(current_);
      return *this;
    }

    constexpr iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<V>
    {
      next_ = current_;
      current_ = parent_->find_previous(current_);
      return *this;
    }

    constexpr iterator operator--(int)
      requires bidirectional_range<V>
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right) {
      return left.current_ == right.current_;
    }

    constexpr const iterator_t<V> &base() const noexcept { return current_; }
  };

  class sentinel {
    sentinel_t<V> end_{};

  public:
    sentinel() = default;

    constexpr explicit sentinel(sentinel_t<V> end)
        : end_(FTL_RANGES_NAMESPACE::move(end)) {}

    friend constexpr bool operator==(const iterator &current,
                                     const sentinel &end) {
      return current.base() == end.end_;
    }
  };

  chunk_by_view()
    requires default_initializable<V> && default_initializable<Pred>
  = default;

  constexpr explicit chunk_by_view(V base, Pred pred)
      : base_(FTL_RANGES_NAMESPACE::move(base)),
        pred_(FTL_RANGES_NAMESPACE::move(pred)) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr const Pred &pred() const { return *pred_; }

  constexpr iterator begin() {
    auto first = ranges::begin(base_);
    return iterator(*this, first, find_next(first));
  }

  constexpr auto end() {
    if constexpr (common_range<V>) {
      auto last = ranges::end(base_);
      return iterator(*this, last, last);
    } else
      return sentinel(ranges::end(base_));
  }
};

template <class R, class Pred>
chunk_by_view(R &&, Pred) -> chunk_by_view<views::all_t<R>, Pred>;

template <view V, bool = forward_range<V>>
  requires input_range<V>
class chunk_view;

template <forward_range V>
  requires view<V>
class chunk_view<V, true> : public view_interface<chunk_view<V, true>> {
  V base_ = V();
  range_difference_t<V> count_ = 1;

  template <bool Const> class iterator {
    using Base = detail::maybe_const_t<Const, V>;

    iterator_t<Base> current_{};
    sentinel_t<Base> end_{};
    range_difference_t<Base> count_ = 1;
    range_difference_t<Base> missing_ = 0;

    friend class chunk_view;
    template <bool> friend class iterator;

    constexpr iterator(iterator_t<Base> current, sentinel_t<Base> end,
                       range_difference_t<Base> count,
                       range_difference_t<Base> missing = 0)
        : current_(FTL_RANGES_NAMESPACE::move(current)),
          end_(FTL_RANGES_NAMESPACE::move(end)), count_(count),
          missing_(missing) {}

  public:
    using iterator_concept = conditional_t<
        random_access_range<Base>, random_access_iterator_tag,
        conditional_t<bidirectional_range<Base>, bidirectional_iterator_tag,
                      forward_iterator_tag>>;

    using iterator_category = input_iterator_tag;
    using value_type = decltype(views::take(subrange(current_, end_), count_));
    using difference_type = range_difference_t<Base>;

    iterator() = default;

    constexpr iterator(iterator<!Const> other)
      requires Const && convertible_to<iterator_t<V>, iterator_t<Base>> &&
                   convertible_to<sentinel_t<V>, sentinel_t<Base>>
        : current_(FTL_RANGES_NAMESPACE::move(other.current_)),
          end_(FTL_RANGES_NAMESPACE::move(other.end_)),
          count_(static_cast<difference_type>(other.count_)),
          missing_(static_cast<difference_type>(other.missing_)) {}

    constexpr iterator_t<Base> base() const { return current_; }

    constexpr value_type operator*() const {
      return views::take(subrange(current_, end_), count_);
    }

    constexpr iterator &operator++() {
      missing_ = ranges::advance(current_, count_, end_);
      return *this;
    }

    constexpr iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<Base>
    {
      ranges::advance(current_, missing_ - count_);
      missing_ = 0;
      return *this;
    }

    constexpr iterator operator--(int)
      requires bidirectional_range<Base>
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    constexpr iterator &operator+=(difference_type offset)
      requires random_access_range<Base>
    {
      if (offset > 0) {
        ranges::advance(current_, count_ * (offset - 1));
        missing_ = ranges::advance(current_, count_, end_);
      } else if (offset < 0) {
        ranges::advance(current_, count_ * offset + missing_);
        missing_ = 0;
      }

      return *this;
    }

    constexpr iterator &operator-=(difference_type offset)
      requires random_access_range<Base>
    {
      return *this += -offset;
    }

    constexpr value_type operator[](difference_type offset) const
      requires random_access_range<Base>
    {
      return views::take(subrange(current_ + offset * count_, end_), count_);
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right) {
      return left.current_ == right.current_;
    }

    friend constexpr bool operator==(const iterator &value,
                                     default_sentinel_t) {
      return value.current_ == value.end_;
    }

    friend constexpr bool operator<(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return left.current_ < right.current_;
    }

    friend constexpr bool operator>(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return right < left;
    }

    friend constexpr bool operator<=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(right < left);
    }

    friend constexpr bool operator>=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(left < right);
    }

    friend constexpr auto operator<=>(const iterator &left,
                                      const iterator &right)
      requires random_access_range<Base> &&
               three_way_comparable<iterator_t<Base>>
    {
      return left.current_ <=> right.current_;
    }

    friend constexpr iterator operator+(const iterator &value,
                                        difference_type offset)
      requires random_access_range<Base>
    {
      auto result = value;
      result += offset;
      return result;
    }

    friend constexpr iterator operator+(difference_type offset,
                                        const iterator &value)
      requires random_access_range<Base>
    {
      return value + offset;
    }

    friend constexpr iterator operator-(const iterator &value,
                                        difference_type offset)
      requires random_access_range<Base>
    {
      auto result = value;
      result -= offset;
      return result;
    }

    friend constexpr difference_type operator-(const iterator &left,
                                               const iterator &right)
      requires sized_sentinel_for<iterator_t<Base>, iterator_t<Base>>
    {
      return (left.current_ - right.current_ + left.missing_ - right.missing_) /
             left.count_;
    }

    friend constexpr difference_type operator-(default_sentinel_t,
                                               const iterator &value)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      auto distance = value.end_ - value.current_;
      return (distance + value.count_ - 1) / value.count_;
    }

    friend constexpr difference_type operator-(const iterator &value,
                                               default_sentinel_t sentinel)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      return -(sentinel - value);
    }
  };

public:
  chunk_view()
    requires default_initializable<V>
  = default;

  constexpr explicit chunk_view(V base, range_difference_t<V> count)
      : base_(FTL_RANGES_NAMESPACE::move(base)), count_(count) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr auto begin()
    requires(!detail::simple_view<V>)
  {
    return iterator<false>(ranges::begin(base_), ranges::end(base_), count_);
  }

  constexpr auto begin() const
    requires forward_range<const V>
  {
    return iterator<true>(ranges::begin(base_), ranges::end(base_),
                          static_cast<range_difference_t<const V>>(count_));
  }

  constexpr auto end()
    requires(!detail::simple_view<V>)
  {
    if constexpr (common_range<V> && sized_range<V>) {
      auto missing = (count_ - ranges::distance(base_) % count_) % count_;

      return iterator<false>(ranges::end(base_), ranges::end(base_), count_,
                             missing);
    } else if constexpr (common_range<V> && !bidirectional_range<V>) {
      return iterator<false>(ranges::end(base_), ranges::end(base_), count_);
    } else {
      return default_sentinel;
    }
  }

  constexpr auto end() const
    requires forward_range<const V>
  {
    using difference_type = range_difference_t<const V>;
    auto count = static_cast<difference_type>(count_);

    if constexpr (common_range<const V> && sized_range<const V>) {
      auto missing = (count - ranges::distance(base_) % count) % count;

      return iterator<true>(ranges::end(base_), ranges::end(base_), count,
                            missing);
    } else if constexpr (common_range<const V> &&
                         !bidirectional_range<const V>) {
      return iterator<true>(ranges::end(base_), ranges::end(base_), count);
    } else {
      return default_sentinel;
    }
  }

  constexpr auto size()
    requires sized_range<V>
  {
    auto size = ranges::size(base_);
    auto count = static_cast<decltype(size)>(count_);
    return (size + count - 1) / count;
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    auto size = ranges::size(base_);
    auto count = static_cast<decltype(size)>(count_);
    return (size + count - 1) / count;
  }
};

template <view V>
  requires input_range<V> && (!forward_range<V>)
class chunk_view<V, false> : public view_interface<chunk_view<V, false>> {
  V base_ = V();
  range_difference_t<V> count_ = 1;

  detail::non_propagating_cache<iterator_t<V>> current_;

  range_difference_t<V> remaining_ = 0;
  bool initialized_ = false;

public:
  class inner_view : public view_interface<inner_view> {
    chunk_view *parent_ = nullptr;

  public:
    class iterator {
      chunk_view *parent_ = nullptr;

    public:
      using iterator_concept = input_iterator_tag;
      using iterator_category = input_iterator_tag;
      using value_type = range_value_t<V>;
      using difference_type = range_difference_t<V>;

      iterator() = default;

      constexpr explicit iterator(chunk_view &parent)
          : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}

      constexpr decltype(auto) operator*() const { return **parent_->current_; }

      constexpr iterator &operator++() {
        ++*parent_->current_;

        if (*parent_->current_ == ranges::end(parent_->base_)) {
          parent_->remaining_ = 0;
        } else {
          --parent_->remaining_;
        }

        return *this;
      }

      constexpr void operator++(int) { ++*this; }

      friend constexpr bool operator==(const iterator &current,
                                       default_sentinel_t) {
        return current.parent_->inner_done();
      }
    };

    inner_view() = default;

    constexpr explicit inner_view(chunk_view &parent)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}

    constexpr iterator begin() { return iterator(*parent_); }

    constexpr default_sentinel_t end() const noexcept { return {}; }
  };

  class outer_iterator {
    chunk_view *parent_ = nullptr;

  public:
    using iterator_concept = input_iterator_tag;
    using iterator_category = input_iterator_tag;
    using value_type = inner_view;
    using difference_type = range_difference_t<V>;

    outer_iterator() = default;

    constexpr explicit outer_iterator(chunk_view &parent)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}

    constexpr inner_view operator*() const { return inner_view(*parent_); }

    constexpr outer_iterator &operator++() {
      ranges::advance(*parent_->current_, parent_->remaining_,
                      ranges::end(parent_->base_));

      parent_->remaining_ = parent_->count_;

      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    friend constexpr bool operator==(const outer_iterator &current,
                                     default_sentinel_t) {
      return current.parent_->done();
    }
  };

  chunk_view()
    requires default_initializable<V>
  = default;

  constexpr explicit chunk_view(V base, range_difference_t<V> count)
      : base_(FTL_RANGES_NAMESPACE::move(base)), count_(count) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr bool inner_done() { return remaining_ == 0; }

  constexpr bool done() {
    return (current_.has_value() && *current_ == ranges::end(base_) &&
            remaining_ != 0);
  }

  constexpr outer_iterator begin() {
    current_.emplace(ranges::begin(base_));

    remaining_ = count_;

    return outer_iterator(*this);
  }

  constexpr default_sentinel_t end() const noexcept { return {}; }
};

template <class R>
chunk_view(R &&, range_difference_t<views::all_t<R>>)
    -> chunk_view<views::all_t<R>>;

template <class V, bool Forward>
inline constexpr bool enable_borrowed_range<chunk_view<V, Forward>> =
    Forward && enable_borrowed_range<V>;

namespace detail {
template <class R>
concept cartesian_product_common_argument =
    common_range<R> || (random_access_range<R> && sized_range<R>);

template <cartesian_product_common_argument R>
constexpr auto cartesian_product_common_argument_end(R &range) {
  if constexpr (common_range<R>) {
    return ranges::end(range);
  } else {
    return ranges::begin(range) + ranges::distance(range);
  }
}
} // namespace detail

template <input_range First, forward_range... Views>
  requires view<First> && (view<Views> && ...)
class cartesian_product_view
    : public view_interface<cartesian_product_view<First, Views...>> {
  tuple<First, Views...> views_{};
  static constexpr size_t count = 1 + sizeof...(Views);

  template <size_t... I>
  constexpr auto size_impl(index_sequence<I...>)
    requires sized_range<First> && (sized_range<Views> && ...)
  {
    common_type_t<range_size_t<First>, range_size_t<Views>...> result = 1;
    ((result *= ranges::size(get<I>(views_))), ...);
    return result;
  }

  template <size_t... I>
  constexpr auto size_impl(index_sequence<I...>) const
    requires sized_range<const First> && (sized_range<const Views> && ...)
  {
    common_type_t<range_size_t<const First>, range_size_t<const Views>...>
        result = 1;
    ((result *= ranges::size(get<I>(views_))), ...);
    return result;
  }

  template <bool Const, class T>
  using base_t = conditional_t<Const, const T, T>;

public:
  template <bool Const> class iterator {
    template <bool> friend class iterator;
    using parent_type = conditional_t<Const, const cartesian_product_view,
                                      cartesian_product_view>;
    parent_type *parent_ = nullptr;
    tuple<iterator_t<base_t<Const, First>>, iterator_t<base_t<Const, Views>>...>
        current_;
    common_type_t<range_difference_t<base_t<Const, First>>,
                  range_difference_t<base_t<Const, Views>>...>
        position_ = 0;
    bool done_ = true;

    template <size_t I> constexpr void increment_component() {
      auto &current = get<I>(current_);
      ++current;
      if (current != ranges::end(get<I>(parent_->views_)))
        return;
      if constexpr (I == 0)
        done_ = true;
      else {
        current = ranges::begin(get<I>(parent_->views_));
        increment_component<I - 1>();
      }
    }

    template <size_t I>
    constexpr void decrement_component()
      requires bidirectional_range<base_t<Const, First>> &&
               (bidirectional_range<base_t<Const, Views>> && ...) &&
               common_range<base_t<Const, First>> &&
               (common_range<base_t<Const, Views>> && ...)
    {
      auto &current = get<I>(current_);
      auto begin = ranges::begin(get<I>(parent_->views_));
      if (current != begin) {
        --current;
        return;
      }
      current = ranges::end(get<I>(parent_->views_));
      --current;
      if constexpr (I > 0)
        decrement_component<I - 1>();
    }

    template <size_t... I> constexpr auto deref(index_sequence<I...>) const {
      return tuple<range_reference_t<base_t<Const, First>>,
                   range_reference_t<base_t<Const, Views>>...>(
          *get<I>(current_)...);
    }

    template <size_t... I>
    constexpr void set_last(index_sequence<I...>)
      requires bidirectional_range<base_t<Const, First>> &&
               (bidirectional_range<base_t<Const, Views>> && ...) &&
               common_range<base_t<Const, First>> &&
               (common_range<base_t<Const, Views>> && ...)
    {
      ((get<I>(current_) = ranges::end(get<I>(parent_->views_)),
        --get<I>(current_)),
       ...);
    }

  public:
    using iterator_concept = conditional_t<
        random_access_range<base_t<Const, First>> &&
            (random_access_range<base_t<Const, Views>> && ...) &&
            common_range<base_t<Const, First>> &&
            (common_range<base_t<Const, Views>> && ...),
        random_access_iterator_tag,
        conditional_t<bidirectional_range<base_t<Const, First>> &&
                          (bidirectional_range<base_t<Const, Views>> && ...) &&
                          common_range<base_t<Const, First>> &&
                          (common_range<base_t<Const, Views>> && ...),
                      bidirectional_iterator_tag,
                      conditional_t<forward_range<base_t<Const, First>>,
                                    forward_iterator_tag, input_iterator_tag>>>;
    using iterator_category = input_iterator_tag;
    using value_type = tuple<range_value_t<base_t<Const, First>>,
                             range_value_t<base_t<Const, Views>>...>;
    using difference_type =
        common_type_t<range_difference_t<base_t<Const, First>>,
                      range_difference_t<base_t<Const, Views>>...>;

    iterator() = default;

    constexpr iterator(parent_type &parent,
                       tuple<iterator_t<base_t<Const, First>>,
                             iterator_t<base_t<Const, Views>>...>
                           current,
                       bool done, difference_type position = 0)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)),
          current_(FTL_RANGES_NAMESPACE::move(current)), position_(position),
          done_(done) {}

    template <bool Other>
    constexpr iterator(iterator<Other> other)
      requires Const && (!Other) &&
                   convertible_to<iterator_t<First>, iterator_t<const First>> &&
                   (convertible_to<iterator_t<Views>,
                                   iterator_t<const Views>> &&
                    ...)
        : parent_(other.parent_),
          current_(FTL_RANGES_NAMESPACE::move(other.current_)),
          position_(other.position_), done_(other.done_) {}

    constexpr auto operator*() const {
      return deref(make_index_sequence<count>{});
    }

    constexpr iterator &operator++() {
      increment_component<count - 1>();
      ++position_;
      return *this;
    }

    constexpr auto operator++(int) {
      if constexpr (forward_range<base_t<Const, First>>) {
        auto copy = *this;
        ++*this;
        return copy;
      } else
        ++*this;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<base_t<Const, First>> &&
               (bidirectional_range<base_t<Const, Views>> && ...) &&
               common_range<base_t<Const, First>> &&
               (common_range<base_t<Const, Views>> && ...)
    {
      if (done_) {
        set_last(make_index_sequence<count>{});
        done_ = false;
      } else
        decrement_component<count - 1>();
      --position_;
      return *this;
