    requires sentinel_for<sentinel_t<Base>, iterator_t<OtherBase<OtherConst>>>
  friend constexpr bool
  operator==(const sentinel &bound,
             const iterator_t<OtherBase<OtherConst>> &iterator) {
    return iterator == bound;
  }

  template <bool OtherConst = !Const>
    requires sentinel_for<sentinel_t<Base>, iterator_t<OtherBase<OtherConst>>>
  friend constexpr bool
  operator!=(const iterator_t<OtherBase<OtherConst>> &iterator,
             const sentinel &bound) {
