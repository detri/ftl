template<input_range V, forward_range Pattern, bool = forward_range<V>>
    requires view<V> && view<Pattern> &&
        indirectly_comparable<iterator_t<V>, iterator_t<Pattern>, equal_to> &&
        (forward_range<V> || detail::tiny_range<Pattern>)
class lazy_split_view;

template<input_range V, forward_range Pattern>
    requires view<V> && view<Pattern> &&
        indirectly_comparable<iterator_t<V>, iterator_t<Pattern>, equal_to> &&
        forward_range<V>
class lazy_split_view<V, Pattern, true>
    : public view_interface<lazy_split_view<V, Pattern, true>> {
    split_view<V, Pattern> split_;
public:
    using inner_view = subrange<iterator_t<V>>;
    lazy_split_view() requires default_initializable<V> && default_initializable<Pattern> = default;
    constexpr explicit lazy_split_view(V base, Pattern pattern)
        : split_(FTL_RANGES_NAMESPACE::move(base), FTL_RANGES_NAMESPACE::move(pattern)) {}
    constexpr V base() const& requires copy_constructible<V> { return split_.base(); }
    constexpr V base() && { return FTL_RANGES_NAMESPACE::move(split_).base(); }
    constexpr auto begin() { return split_.begin(); }
    constexpr auto end() { return split_.end(); }
};

template<input_range V, forward_range Pattern>
    requires view<V> && view<Pattern> &&
        indirectly_comparable<iterator_t<V>, iterator_t<Pattern>, equal_to> &&
        (!forward_range<V>) && detail::tiny_range<Pattern>
class lazy_split_view<V, Pattern, false>
    : public view_interface<lazy_split_view<V, Pattern, false>> {
    V base_ = V();
    Pattern pattern_ = Pattern();
    iterator_t<V> current_{};
    bool initialized_ = false;
    bool done_ = false;
    bool trailing_empty_ = false;
    bool inner_consumed_ = false;

    constexpr bool empty_pattern() { return ranges::begin(pattern_) == ranges::end(pattern_); }
    constexpr bool at_delimiter() {
        return current_ != ranges::end(base_) && !empty_pattern() &&
            *current_ == *ranges::begin(pattern_);
    }

public:
    class outer_iterator;
    class inner_view;

    lazy_split_view() requires default_initializable<V> && default_initializable<Pattern> = default;
    constexpr explicit lazy_split_view(V base, Pattern pattern)
        : base_(FTL_RANGES_NAMESPACE::move(base)), pattern_(FTL_RANGES_NAMESPACE::move(pattern)) {}
    constexpr V base() const& requires copy_constructible<V> { return base_; }
    constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

    constexpr outer_iterator begin() {
        current_ = ranges::begin(base_);
        initialized_ = true;
        done_ = current_ == ranges::end(base_);
        trailing_empty_ = false;
        return outer_iterator(*this);
    }
    constexpr default_sentinel_t end() const noexcept { return {}; }

    constexpr bool inner_done(bool incremented) {
        return current_ == ranges::end(base_) || at_delimiter() ||
            (empty_pattern() && incremented);
    }
    constexpr bool done() const noexcept { return done_; }

    class inner_view : public view_interface<inner_view> {
        lazy_split_view* parent_ = nullptr;
    public:
        class iterator {
            lazy_split_view* parent_ = nullptr;
            bool incremented_ = false;
        public:
            using iterator_concept = input_iterator_tag;
            using iterator_category = input_iterator_tag;
            using value_type = range_value_t<V>;
            using difference_type = range_difference_t<V>;
            iterator() = default;
            constexpr explicit iterator(lazy_split_view& parent)
                : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}
            constexpr decltype(auto) operator*() const { return *parent_->current_; }
            constexpr iterator& operator++() {
                ++parent_->current_;
                incremented_ = true;
                if (parent_->empty_pattern()) parent_->inner_consumed_ = true;
                return *this;
            }
            constexpr void operator++(int) { ++*this; }
            friend constexpr bool operator==(const iterator& current, default_sentinel_t) {
                return current.parent_->inner_done(current.incremented_);
            }
        };
        inner_view() = default;
        constexpr explicit inner_view(lazy_split_view& parent)
            : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}
        constexpr iterator begin() {
            parent_->inner_consumed_ = false;
            return iterator(*parent_);
        }
        constexpr default_sentinel_t end() const noexcept { return {}; }
    };

    class outer_iterator {
        lazy_split_view* parent_ = nullptr;
    public:
        using iterator_concept = input_iterator_tag;
        using iterator_category = input_iterator_tag;
        using value_type = inner_view;
        using difference_type = range_difference_t<V>;
        outer_iterator() = default;
        constexpr explicit outer_iterator(lazy_split_view& parent)
            : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}
        constexpr inner_view operator*() const { return inner_view(*parent_); }
        constexpr outer_iterator& operator++() {
            if (parent_->trailing_empty_) {
                parent_->trailing_empty_ = false;
                parent_->done_ = true;
                return *this;
            }
            const bool empty = parent_->empty_pattern();
            if (empty) {
                if (!parent_->inner_consumed_ && parent_->current_ != ranges::end(parent_->base_))
                    ++parent_->current_;
                parent_->inner_consumed_ = false;
                parent_->done_ = parent_->current_ == ranges::end(parent_->base_);
                return *this;
            }
            while (parent_->current_ != ranges::end(parent_->base_) && !parent_->at_delimiter())
                ++parent_->current_;
            if (parent_->current_ == ranges::end(parent_->base_)) {
                parent_->done_ = true;
                return *this;
            }
            ++parent_->current_;
            if (parent_->current_ == ranges::end(parent_->base_)) parent_->trailing_empty_ = true;
            return *this;
        }
        constexpr void operator++(int) { ++*this; }
        friend constexpr bool operator==(const outer_iterator& current, default_sentinel_t) {
            return current.parent_->done();
        }
    };
};

