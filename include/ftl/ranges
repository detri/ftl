template <forward_range V, size_t N>
  requires view<V> && (N > 0)
class adjacent_view : public view_interface<adjacent_view<V, N>> {
  V base_ = V();

  struct as_sentinel {};

  template <bool Const> class iterator;

  template <bool Const> class sentinel;

  template <bool Const> class iterator {
    using Base = detail::maybe_const_t<Const, V>;

    array<iterator_t<Base>, N> current_{};

    friend class adjacent_view;
    template <bool> friend class iterator;
    template <bool> friend class sentinel;

    constexpr iterator(iterator_t<Base> first, sentinel_t<Base> last) {
      current_[0] = FTL_RANGES_NAMESPACE::move(first);

      for (size_t index = 1; index < N; ++index) {
        current_[index] = ranges::next(current_[index - 1], 1, last);
      }
    }

    constexpr iterator(as_sentinel, iterator_t<Base> first,
                       iterator_t<Base> last) {
      if constexpr (!bidirectional_range<Base>) {
        for (size_t index = 0; index < N; ++index) {
          current_[index] = last;
        }
      } else {
        current_[N - 1] = FTL_RANGES_NAMESPACE::move(last);

        for (size_t index = N - 1; index > 0; --index) {
          current_[index - 1] = ranges::prev(current_[index], 1, first);
        }
      }
    }

    template <size_t... Index>
    static auto value_type_impl(index_sequence<Index...>)
        -> tuple<conditional_t<true, range_value_t<Base>,
                               integral_constant<size_t, Index>>...>;

    template <size_t... Index>
    constexpr auto dereference(index_sequence<Index...>) const {
      return tuple<decltype(*current_[Index])...>(*current_[Index]...);
    }

    template <size_t... Index>
    constexpr auto subscript(range_difference_t<Base> offset,
                             index_sequence<Index...>) const {
      return tuple<decltype(current_[Index][offset])...>(
          current_[Index][offset]...);
    }

    template <size_t... Index>
    constexpr auto move_values(index_sequence<Index...>) const noexcept(
        noexcept(ranges::iter_move(declval<const iterator_t<Base> &>())) &&
        is_nothrow_move_constructible_v<range_rvalue_reference_t<Base>>) {
      return tuple<decltype(ranges::iter_move(current_[Index]))...>(
          ranges::iter_move(current_[Index])...);
    }

