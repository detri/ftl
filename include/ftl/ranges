        {
            return subrange<
                iterator_type,
                iterator_type,
                kind
            >(
                range.end().base(),
                range.begin().base(),
                range.size()
            );
        }
        else
        {
            return subrange<
                iterator_type,
                iterator_type,
                kind
            >(
                range.end().base(),
                range.begin().base()
            );
        }
    }


    // Ordinary range -> reverse_view<views::all_t<R>>

    template<class R>
        requires (
            !detail::is_reverse_view_v<
                remove_cvref_t<R>
            > &&
            !detail::is_reversed_subrange_v<
                remove_cvref_t<R>
            > &&
            viewable_range<R> &&
            bidirectional_range<all_t<R>>
