template <class... R>
using join_with_reference_t = common_reference_t<range_reference_t<R>...>;

template <class... R>
using join_with_value_t = common_type_t<range_value_t<R>...>;

template <class... R>
using join_with_rvalue_reference_t =
    common_reference_t<range_rvalue_reference_t<R>...>;

template <class Reference, class RvalueReference, class Iterator>
concept join_with_indirectly_readable = requires(const Iterator iterator) {
  { *iterator } -> convertible_to<Reference>;

  { ranges::iter_move(iterator) } -> convertible_to<RvalueReference>;
};

template <class First, class Second>
concept join_with_concatable =
    requires {
      typename join_with_reference_t<First, Second>;

      typename join_with_value_t<First, Second>;

      typename join_with_rvalue_reference_t<First, Second>;
    } &&
    common_reference_with<join_with_reference_t<First, Second> &&,
                          join_with_value_t<First, Second> &> &&
    common_reference_with<join_with_reference_t<First, Second> &&,
                          join_with_rvalue_reference_t<First, Second> &&> &&
    common_reference_with<join_with_rvalue_reference_t<First, Second> &&,
                          const join_with_value_t<First, Second> &> &&
    join_with_indirectly_readable<join_with_reference_t<First, Second>,
                                  join_with_rvalue_reference_t<First, Second>,
                                  iterator_t<First>> &&
    join_with_indirectly_readable<join_with_reference_t<First, Second>,
                                  join_with_rvalue_reference_t<First, Second>,
                                  iterator_t<Second>>;

template <class R>
concept join_with_bidirectional_common =
    bidirectional_range<R> && common_range<R>;

template <class T>
[[nodiscard]]
constexpr remove_reference_t<T> &join_with_as_lvalue(T &&value) noexcept {
  return value;
}

/*
 * The outer iterator is stored in the iterator only
 * when the outer range is forward.
 *
 * Input-only outer ranges store it in the parent view.
 */
template <class Iterator, bool = forward_iterator<Iterator>>
struct join_with_outer_storage {};

template <class Iterator> struct join_with_outer_storage<Iterator, true> {
  FTL_NO_UNIQUE_ADDRESS
  Iterator value = Iterator();

  constexpr join_with_outer_storage() = default;

  constexpr explicit join_with_outer_storage(Iterator iterator)
      : value(FTL_RANGES_NAMESPACE::move(iterator)) {}
};

/*
 * Freestanding two-alternative iterator storage.
 *
 * This substitutes for variant<PatternIter, InnerIter>
 * without making <ranges> depend on <variant>.
 */
template <class PatternIterator, class InnerIterator>
class join_with_iterator_state {
private:
  enum class active_state : unsigned char { none, pattern, inner };

  optional_storage<PatternIterator> pattern_;

  optional_storage<InnerIterator> inner_;

  active_state active_ = active_state::none;

  constexpr void destroy_pattern() noexcept {
    if (pattern_.engaged_) {
      FTL_RANGES_NAMESPACE::destroy_at(
          FTL_RANGES_NAMESPACE::addressof(pattern_.value_));

      pattern_.engaged_ = false;
    }
  }

  constexpr void destroy_inner() noexcept {
    if (inner_.engaged_) {
      FTL_RANGES_NAMESPACE::destroy_at(
          FTL_RANGES_NAMESPACE::addressof(inner_.value_));

      inner_.engaged_ = false;
    }
  }

public:
  constexpr join_with_iterator_state() noexcept = default;

  constexpr join_with_iterator_state(const join_with_iterator_state &other)
    requires(copy_constructible<PatternIterator> &&
             copy_constructible<InnerIterator>)
  {
    if (other.holds_pattern()) {
      emplace_pattern(other.pattern());
    } else if (other.holds_inner()) {
      emplace_inner(other.inner());
    }
  }

  constexpr join_with_iterator_state(join_with_iterator_state &&other) noexcept(
      is_nothrow_move_constructible_v<PatternIterator> &&
      is_nothrow_move_constructible_v<InnerIterator>)
    requires(move_constructible<PatternIterator> &&
             move_constructible<InnerIterator>)
  {
    if (other.holds_pattern()) {
      emplace_pattern(FTL_RANGES_NAMESPACE::move(other.pattern()));
    } else if (other.holds_inner()) {
      emplace_inner(FTL_RANGES_NAMESPACE::move(other.inner()));
    }
  }

  constexpr join_with_iterator_state &
  operator=(const join_with_iterator_state &other)
    requires(copy_constructible<PatternIterator> &&
             copy_constructible<InnerIterator>)
  {
    if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
      reset();

      if (other.holds_pattern()) {
        emplace_pattern(other.pattern());
      } else if (other.holds_inner()) {
        emplace_inner(other.inner());
      }
    }

    return *this;
  }

  constexpr join_with_iterator_state &
  operator=(join_with_iterator_state &&other) noexcept(
      is_nothrow_move_constructible_v<PatternIterator> &&
      is_nothrow_move_constructible_v<InnerIterator>)
    requires(move_constructible<PatternIterator> &&
             move_constructible<InnerIterator>)
  {
    if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
      reset();

      if (other.holds_pattern()) {
        emplace_pattern(FTL_RANGES_NAMESPACE::move(other.pattern()));
      } else if (other.holds_inner()) {
        emplace_inner(FTL_RANGES_NAMESPACE::move(other.inner()));
      }
    }

    return *this;
  }

  constexpr ~join_with_iterator_state() { reset(); }

  [[nodiscard]]
  constexpr bool empty() const noexcept {
    return active_ == active_state::none;
  }

  [[nodiscard]]
  constexpr bool holds_pattern() const noexcept {
    return active_ == active_state::pattern;
  }

  [[nodiscard]]
  constexpr bool holds_inner() const noexcept {
    return active_ == active_state::inner;
  }

  constexpr void reset() noexcept {
    if (holds_pattern()) {
      destroy_pattern();
    } else if (holds_inner()) {
      destroy_inner();
    }

    active_ = active_state::none;
  }

  template <class Value>
    requires constructible_from<PatternIterator, Value>
  constexpr void emplace_pattern(Value &&value) {
    reset();

    FTL_RANGES_NAMESPACE::construct_at(
        FTL_RANGES_NAMESPACE::addressof(pattern_.value_),
        static_cast<Value &&>(value));

    pattern_.engaged_ = true;

    active_ = active_state::pattern;
  }

  template <class Value>
    requires constructible_from<InnerIterator, Value>
  constexpr void emplace_inner(Value &&value) {
    reset();

    FTL_RANGES_NAMESPACE::construct_at(
        FTL_RANGES_NAMESPACE::addressof(inner_.value_),
        static_cast<Value &&>(value));

    inner_.engaged_ = true;

    active_ = active_state::inner;
  }

  [[nodiscard]]
  constexpr PatternIterator &pattern() noexcept {
    return pattern_.value_;
  }

  [[nodiscard]]
  constexpr const PatternIterator &pattern() const noexcept {
    return pattern_.value_;
  }

  [[nodiscard]]
  constexpr InnerIterator &inner() noexcept {
    return inner_.value_;
  }

  [[nodiscard]]
  constexpr const InnerIterator &inner() const noexcept {
    return inner_.value_;
  }

  [[nodiscard]]
  constexpr bool equal(const join_with_iterator_state &other) const
    requires(equality_comparable<PatternIterator> &&
             equality_comparable<InnerIterator>)
  {
    if (active_ != other.active_) {
      return false;
    }

    if (holds_pattern()) {
      return pattern() == other.pattern();
    }

    if (holds_inner()) {
      return inner() == other.inner();
    }

    return true;
  }
};

template <class Base, class PatternBase,
          class InnerBase = range_reference_t<Base>,
          bool = is_reference_v<InnerBase> && forward_range<Base> &&
                 forward_range<InnerBase>>
struct join_with_iterator_category {};

template <class Base, class PatternBase, class InnerBase>
struct join_with_iterator_category<Base, PatternBase, InnerBase, true> {
private:
  using outer_category =
      typename iterator_traits<iterator_t<Base>>::iterator_category;

  using inner_category =
      typename iterator_traits<iterator_t<InnerBase>>::iterator_category;

  using pattern_category =
      typename iterator_traits<iterator_t<PatternBase>>::iterator_category;

  using reference_type =
      common_reference_t<iter_reference_t<iterator_t<InnerBase>>,
                         iter_reference_t<iterator_t<PatternBase>>>;

public:
  using iterator_category = conditional_t<
      !is_reference_v<reference_type>, input_iterator_tag,
      conditional_t<
          derived_from<outer_category, bidirectional_iterator_tag> &&
              derived_from<inner_category, bidirectional_iterator_tag> &&
              derived_from<pattern_category, bidirectional_iterator_tag> &&
              common_range<InnerBase> && common_range<PatternBase>,
          bidirectional_iterator_tag,
          conditional_t<
              derived_from<outer_category, forward_iterator_tag> &&
                  derived_from<inner_category, forward_iterator_tag> &&
                  derived_from<pattern_category, forward_iterator_tag>,
              forward_iterator_tag, input_iterator_tag>>>;
};

} // namespace detail

template <input_range V, forward_range Pattern>
  requires(view<V> && input_range<range_reference_t<V>> && view<Pattern> &&
           detail::join_with_concatable<range_reference_t<V>, Pattern>)
class join_with_view : public view_interface<join_with_view<V, Pattern>> {
private:
  using InnerRange = range_reference_t<V>;

  FTL_NO_UNIQUE_ADDRESS
  V base_ = V();

  FTL_NO_UNIQUE_ADDRESS
  detail::maybe_present<detail::non_propagating_cache<iterator_t<V>>,
                        !forward_range<V>>
      outer_cache_;

  FTL_NO_UNIQUE_ADDRESS
  detail::maybe_present<
      detail::non_propagating_cache<remove_cvref_t<InnerRange>>,
      !is_reference_v<InnerRange>>
      inner_cache_;

  FTL_NO_UNIQUE_ADDRESS
  Pattern pattern_ = Pattern();

  template <bool Const>
  using Parent = detail::maybe_const_t<Const, join_with_view>;

  template <bool Const> using Base = detail::maybe_const_t<Const, V>;

  template <bool Const>
  using PatternBase = detail::maybe_const_t<Const, Pattern>;

  template <bool Const> using InnerBase = range_reference_t<Base<Const>>;

  template <bool Const> using OuterIterator = iterator_t<Base<Const>>;

  template <bool Const> using InnerIterator = iterator_t<InnerBase<Const>>;

  template <bool Const> using PatternIterator = iterator_t<PatternBase<Const>>;

  template <bool Const> class iterator;

  template <bool Const> class sentinel;

  template <bool Const>
  class iterator
      : public detail::join_with_iterator_category<Base<Const>,
                                                   PatternBase<Const>> {
  private:
    using ParentType = Parent<Const>;

    using BaseType = Base<Const>;

    using InnerBaseType = InnerBase<Const>;

    using PatternBaseType = PatternBase<Const>;

    using OuterIter = OuterIterator<Const>;

    using InnerIter = InnerIterator<Const>;

    using PatternIter = PatternIterator<Const>;

    static constexpr bool ref_is_glvalue = is_reference_v<InnerBaseType>;

    ParentType *parent_ = nullptr;

    FTL_NO_UNIQUE_ADDRESS
    detail::join_with_outer_storage<OuterIter> outer_;

    FTL_NO_UNIQUE_ADDRESS
    detail::join_with_iterator_state<PatternIter, InnerIter> current_;

    template <bool> friend class iterator;

    template <bool> friend class sentinel;

    friend class join_with_view;

    [[nodiscard]]
    constexpr OuterIter &outer() {
      if constexpr (forward_range<BaseType>) {
        return outer_.value;
      } else {
        return *parent_->outer_cache_.value;
      }
    }

    [[nodiscard]]
    constexpr const OuterIter &outer() const {
      if constexpr (forward_range<BaseType>) {
        return outer_.value;
      } else {
        return *parent_->outer_cache_.value;
      }
    }

    [[nodiscard]]
    constexpr auto &update_inner() {
      if constexpr (ref_is_glvalue) {
        return detail::join_with_as_lvalue(*outer());
      } else {
        return parent_->inner_cache_.value.emplace_deref(outer());
      }
    }

    [[nodiscard]]
    constexpr auto &get_inner() {
      if constexpr (ref_is_glvalue) {
        return detail::join_with_as_lvalue(*outer());
      } else {
        return *parent_->inner_cache_.value;
      }
    }

    constexpr void satisfy() {
      while (true) {
        if (current_.holds_pattern()) {
          if (current_.pattern() != ranges::end(parent_->pattern_)) {
            break;
          }

          auto &inner = update_inner();

          current_.emplace_inner(ranges::begin(inner));
        } else if (current_.holds_inner()) {
          if (current_.inner() != ranges::end(get_inner())) {
            break;
          }

          ++outer();

          if (outer() == ranges::end(parent_->base_)) {
            current_.reset();
            break;
          }

          current_.emplace_pattern(ranges::begin(parent_->pattern_));
        } else {
          break;
        }
      }
    }

    constexpr iterator(ParentType &parent, OuterIter outer)
      requires forward_range<BaseType>
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)),
          outer_(FTL_RANGES_NAMESPACE::move(outer)) {
      if (this->outer() != ranges::end(parent_->base_)) {
        auto &inner = update_inner();

        current_.emplace_inner(ranges::begin(inner));

        satisfy();
      }
    }

    constexpr explicit iterator(ParentType &parent)
      requires(!forward_range<BaseType>)
        : parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {
      if (outer() != ranges::end(parent_->base_)) {
        auto &inner = update_inner();

        current_.emplace_inner(ranges::begin(inner));

        satisfy();
      }
    }

  public:
    using iterator_concept = conditional_t<
        ref_is_glvalue && bidirectional_range<BaseType> &&
            detail::join_with_bidirectional_common<InnerBaseType> &&
            detail::join_with_bidirectional_common<PatternBaseType>,
        bidirectional_iterator_tag,
        conditional_t<ref_is_glvalue && forward_range<BaseType> &&
                          forward_range<InnerBaseType>,
                      forward_iterator_tag, input_iterator_tag>>;

    using value_type =
        common_type_t<iter_value_t<InnerIter>, iter_value_t<PatternIter>>;

    using difference_type = common_type_t<iter_difference_t<OuterIter>,
                                          iter_difference_t<InnerIter>,
                                          iter_difference_t<PatternIter>>;

    iterator() = default;

    constexpr iterator(iterator<!Const> other)
      requires(Const && convertible_to<iterator_t<V>, OuterIter> &&
               convertible_to<iterator_t<InnerRange>, InnerIter> &&
               convertible_to<iterator_t<Pattern>, PatternIter>)
        : parent_(other.parent_),
          outer_(OuterIter(FTL_RANGES_NAMESPACE::move(other.outer_.value))) {
      if (other.current_.holds_pattern()) {
        current_.emplace_pattern(
            PatternIter(FTL_RANGES_NAMESPACE::move(other.current_.pattern())));
      } else if (other.current_.holds_inner()) {
        current_.emplace_inner(
            InnerIter(FTL_RANGES_NAMESPACE::move(other.current_.inner())));
      }
    }

    [[nodiscard]]
    constexpr const OuterIter &outer_base() const {
      return outer();
    }

    [[nodiscard]]
    constexpr decltype(auto) operator*() const {
      using reference = common_reference_t<iter_reference_t<InnerIter>,
                                           iter_reference_t<PatternIter>>;

      if (current_.holds_pattern()) {
        return static_cast<reference>(*current_.pattern());
      }

      return static_cast<reference>(*current_.inner());
    }

    constexpr iterator &operator++() {
      if (current_.holds_pattern()) {
        ++current_.pattern();
      } else {
        ++current_.inner();
      }

      satisfy();

      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    constexpr iterator operator++(int)
      requires(ref_is_glvalue && forward_iterator<OuterIter> &&
               forward_iterator<InnerIter>)
    {
      auto previous = *this;

      ++*this;

      return previous;
    }

    constexpr iterator &operator--()
      requires(ref_is_glvalue && bidirectional_range<BaseType> &&
               detail::join_with_bidirectional_common<InnerBaseType> &&
               detail::join_with_bidirectional_common<PatternBaseType>)
    {
      if (outer() == ranges::end(parent_->base_)) {
        --outer();

        auto &inner = detail::join_with_as_lvalue(*outer());

        current_.emplace_inner(ranges::end(inner));
      }

      while (true) {
        if (current_.holds_pattern()) {
          if (current_.pattern() == ranges::begin(parent_->pattern_)) {
            --outer();

            auto &inner = detail::join_with_as_lvalue(*outer());

            current_.emplace_inner(ranges::end(inner));
          } else {
            break;
          }
        } else {
          auto &inner = detail::join_with_as_lvalue(*outer());

          if (current_.inner() == ranges::begin(inner)) {
            current_.emplace_pattern(ranges::end(parent_->pattern_));
          } else {
            break;
          }
        }
      }

      if (current_.holds_pattern()) {
        --current_.pattern();
      } else {
        --current_.inner();
      }

      return *this;
    }

    constexpr iterator operator--(int)
      requires requires(iterator value) { --value; }
    {
      auto previous = *this;

      --*this;

      return previous;
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right)
      requires(ref_is_glvalue && forward_range<BaseType> &&
               equality_comparable<InnerIter>)
    {
      return left.outer() == right.outer() &&
             left.current_.equal(right.current_);
    }

    friend constexpr decltype(auto) iter_move(const iterator &value) {
      using rvalue_reference =
          common_reference_t<iter_rvalue_reference_t<InnerIter>,
                             iter_rvalue_reference_t<PatternIter>>;

      if (value.current_.holds_pattern()) {
        return static_cast<rvalue_reference>(
            ranges::iter_move(value.current_.pattern()));
      }

      return static_cast<rvalue_reference>(
          ranges::iter_move(value.current_.inner()));
    }

    friend constexpr void iter_swap(const iterator &left, const iterator &right)
      requires indirectly_swappable<InnerIter, PatternIter>
    {
      if (left.current_.holds_pattern()) {
        if (right.current_.holds_pattern()) {
          ranges::iter_swap(left.current_.pattern(), right.current_.pattern());
        } else {
          ranges::iter_swap(left.current_.pattern(), right.current_.inner());
        }
      } else {
        if (right.current_.holds_pattern()) {
          ranges::iter_swap(left.current_.inner(), right.current_.pattern());
        } else {
          ranges::iter_swap(left.current_.inner(), right.current_.inner());
        }
      }
    }
  };

  template <bool Const> class sentinel {
  private:
    using ParentType = Parent<Const>;

    using BaseType = Base<Const>;

    FTL_NO_UNIQUE_ADDRESS
    sentinel_t<BaseType> end_ = sentinel_t<BaseType>();

    template <bool> friend class sentinel;

    constexpr explicit sentinel(ParentType &parent)
        : end_(ranges::end(parent.base_)) {}

    friend class join_with_view;

  public:
    sentinel() = default;

    constexpr sentinel(sentinel<!Const> other)
      requires(Const && convertible_to<sentinel_t<V>, sentinel_t<BaseType>>)
        : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}

    template <bool OtherConst>
      requires sentinel_for<sentinel_t<BaseType>, iterator_t<Base<OtherConst>>>
    friend constexpr bool operator==(const iterator<OtherConst> &current,
                                     const sentinel &bound) {
      return current.outer_base() == bound.end_;
    }
  };

public:
  join_with_view()
    requires(default_initializable<V> && default_initializable<Pattern>)
  = default;

  constexpr explicit join_with_view(V base, Pattern pattern)
      : base_(FTL_RANGES_NAMESPACE::move(base)),
        pattern_(FTL_RANGES_NAMESPACE::move(pattern)) {}

  template <input_range R>
    requires(constructible_from<V, views::all_t<R>> &&
             constructible_from<Pattern,
                                single_view<range_value_t<InnerRange>>>)
  constexpr explicit join_with_view(R &&range,
                                    range_value_t<InnerRange> element)
      : base_(views::all(static_cast<R &&>(range))),
        pattern_(single_view<range_value_t<InnerRange>>(
            FTL_RANGES_NAMESPACE::move(element))) {}

  [[nodiscard]]
  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  [[nodiscard]]
  constexpr V base() && {
    return FTL_RANGES_NAMESPACE::move(base_);
  }

  [[nodiscard]]
  constexpr auto begin() {
    if constexpr (forward_range<V>) {
      constexpr bool use_const = detail::simple_view<V> &&
                                 is_reference_v<InnerRange> &&
                                 detail::simple_view<Pattern>;

      return iterator<use_const>(*this, ranges::begin(base_));
    } else {
      outer_cache_.value.emplace(ranges::begin(base_));

      return iterator<false>(*this);
    }
  }

  [[nodiscard]]
  constexpr auto begin() const
    requires(
        forward_range<const V> && forward_range<const Pattern> &&
        is_reference_v<range_reference_t<const V>> &&
        input_range<range_reference_t<const V>> &&
        detail::join_with_concatable<range_reference_t<const V>, const Pattern>)
  {
    return iterator<true>(*this, ranges::begin(base_));
  }

  [[nodiscard]]
  constexpr auto end() {
    constexpr bool use_const =
        detail::simple_view<V> && detail::simple_view<Pattern>;

    if constexpr (forward_range<V> && is_reference_v<InnerRange> &&
                  forward_range<InnerRange> && common_range<V> &&
                  common_range<InnerRange>) {
      return iterator<use_const>(*this, ranges::end(base_));
    } else {
      return sentinel<use_const>(*this);
    }
  }

  [[nodiscard]]
  constexpr auto end() const
    requires(
        forward_range<const V> && forward_range<const Pattern> &&
        is_reference_v<range_reference_t<const V>> &&
        input_range<range_reference_t<const V>> &&
        detail::join_with_concatable<range_reference_t<const V>, const Pattern>)
  {
    using ConstInnerRange = range_reference_t<const V>;

    if constexpr (forward_range<ConstInnerRange> && common_range<const V> &&
                  common_range<ConstInnerRange>) {
      return iterator<true>(*this, ranges::end(base_));
    } else {
      return sentinel<true>(*this);
    }
  }
};

template <class R, class P>
join_with_view(R &&, P &&) -> join_with_view<views::all_t<R>, views::all_t<P>>;

template <input_range R>
join_with_view(R &&, range_value_t<range_reference_t<R>>)
    -> join_with_view<views::all_t<R>,
                      single_view<range_value_t<range_reference_t<R>>>>;

namespace views {
namespace detail {

struct join_with_fn {
  template <viewable_range R, viewable_range P>
    requires requires(R &&range, P &&pattern) {
      join_with_view<all_t<R>, all_t<P>>(all(static_cast<R &&>(range)),
                                         all(static_cast<P &&>(pattern)));
    }
  constexpr auto operator()(R &&range, P &&pattern) const {
    return join_with_view<all_t<R>, all_t<P>>(all(static_cast<R &&>(range)),
                                              all(static_cast<P &&>(pattern)));
  }

  template <viewable_range R, class T>
    requires(!viewable_range<T> && input_range<range_reference_t<all_t<R>>> &&
             constructible_from<range_value_t<range_reference_t<all_t<R>>>, T>)
  constexpr auto operator()(R &&range, T &&element) const {
    using value_type = range_value_t<range_reference_t<all_t<R>>>;

    using pattern_type = single_view<value_type>;

    return join_with_view<all_t<R>, pattern_type>(
        all(static_cast<R &&>(range)),
        pattern_type(value_type(static_cast<T &&>(element))));
  }

  template <class P>
    requires constructible_from<decay_t<P>, P>
  constexpr auto operator()(P &&pattern) const {
    return FTL_RANGES_NAMESPACE::ranges::detail::partial_adaptor<join_with_fn>(
        static_cast<P &&>(pattern));
  }
};

