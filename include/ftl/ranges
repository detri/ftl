    invoke_tuple(F &&function, Tuple &&values, index_sequence<I...>) noexcept(
        tuple_nothrow_invocable_impl<F, Tuple>(index_sequence<I...>{})) {
  return FTL_RANGES_NAMESPACE::invoke(static_cast<F &&>(function),
                                      get<I>(static_cast<Tuple &&>(values))...);
