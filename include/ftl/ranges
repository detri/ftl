template<forward_range V, forward_range Pattern>
    requires view<V> && view<Pattern> &&
        indirectly_comparable<iterator_t<V>, iterator_t<Pattern>, equal_to>
class split_view : public view_interface<split_view<V, Pattern>> {
    V base_ = V();
    Pattern pattern_ = Pattern();

    struct match {
        iterator_t<V> first{};
        iterator_t<V> last{};
        bool found = false;
    };

    constexpr match find_next(iterator_t<V> current) {
        const auto end = ranges::end(base_);
        const auto pattern_begin = ranges::begin(pattern_);
        const auto pattern_end = ranges::end(pattern_);
        if (pattern_begin == pattern_end) {
            auto next = current;
            if (next != end) ++next;
            return {next, next, current != end};
        }
        for (; current != end; ++current) {
            auto input = current;
            auto delimiter = pattern_begin;
            while (input != end && delimiter != pattern_end && *input == *delimiter) {
                ++input;
                ++delimiter;
            }
            if (delimiter == pattern_end) return {current, input, true};
            if (input == end) {
                current = input;
                break;
            }
        }
        return {current, current, false};
    }

public:
    class iterator;
    class sentinel;
    split_view() requires default_initializable<V> && default_initializable<Pattern> = default;
    constexpr explicit split_view(V base, Pattern pattern)
        : base_(FTL_RANGES_NAMESPACE::move(base)), pattern_(FTL_RANGES_NAMESPACE::move(pattern)) {}
    constexpr V base() const& requires copy_constructible<V> { return base_; }
    constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

    constexpr iterator begin() { return iterator(*this, ranges::begin(base_)); }
    constexpr auto end() {
        if constexpr (common_range<V>) return iterator(*this, ranges::end(base_), true);
        else return sentinel(*this);
    }

    class iterator {
        split_view* parent_ = nullptr;
        iterator_t<V> current_{};
        match next_{};
        bool trailing_empty_ = false;

        friend class split_view;
        friend class sentinel;
        constexpr iterator(split_view& parent, iterator_t<V> current, bool end = false)
            : parent_(FTL_RANGES_NAMESPACE::addressof(parent)), current_(current) {
            if (!end) next_ = parent_->find_next(current_);
        }
    public:
        using iterator_concept = forward_iterator_tag;
        using iterator_category = input_iterator_tag;
        using value_type = subrange<iterator_t<V>>;
        using difference_type = range_difference_t<V>;
        iterator() = default;
        constexpr const iterator_t<V>& base() const noexcept { return current_; }
        constexpr bool trailing_empty() const noexcept { return trailing_empty_; }
        constexpr value_type operator*() const { return {current_, next_.first}; }
        constexpr iterator& operator++() {
            if (trailing_empty_) {
                trailing_empty_ = false;
                return *this;
            }
            if (!next_.found) {
                current_ = next_.first;
                return *this;
            }
            const auto end = ranges::end(parent_->base_);
            if (next_.first == next_.last) {
                current_ = next_.last;
            } else {
                current_ = next_.last;
                if (current_ == end) {
                    trailing_empty_ = true;
                    next_ = {current_, current_, false};
                    return *this;
                }
            }
            next_ = parent_->find_next(current_);
            return *this;
        }
        constexpr iterator operator++(int) { auto copy = *this; ++*this; return copy; }
        friend constexpr bool operator==(const iterator& left, const iterator& right) {
            return left.current_ == right.current_ && left.trailing_empty_ == right.trailing_empty_;
        }
    };

    class sentinel {
        sentinel_t<V> end_{};
    public:
        sentinel() = default;
        constexpr explicit sentinel(split_view& parent) : end_(ranges::end(parent.base_)) {}
        friend constexpr bool operator==(const iterator& current, const sentinel& bound) {
            return current.base() == bound.end_ && !current.trailing_empty();
        }
    };
};

