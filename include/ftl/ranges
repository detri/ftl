using namespace ranges::detail;

template<class R>
concept can_ref_view =
    requires(R&& value) {
        ref_view{static_cast<R&&>(value)};
    };

template<class R>
concept can_owning_view =
    requires(R&& value) {
        owning_view{static_cast<R&&>(value)};
    };

struct all_fn : range_adaptor_closure<all_fn> {
    template<viewable_range R>
    [[nodiscard]]
    constexpr auto operator()(R&& value) const
        noexcept(
            []() consteval {
                if constexpr (view<remove_cvref_t<R>>) {
                    return is_nothrow_constructible_v<
                        remove_cvref_t<R>,
                        R
                    >;
                } else if constexpr (can_ref_view<R>) {
                    return noexcept(ref_view{declval<R>()});
                } else {
                    return noexcept(owning_view{declval<R>()});
                }
            }()
        )
    {
        if constexpr (view<remove_cvref_t<R>>) {
            return remove_cvref_t<R>(
                static_cast<R&&>(value)
            );
        } else if constexpr (can_ref_view<R>) {
            return ref_view{static_cast<R&&>(value)};
        } else {
            static_assert(can_owning_view<R>);
            return owning_view{static_cast<R&&>(value)};
        }
    }
};

struct single_fn {
    template<class T>
    [[nodiscard]]
    constexpr auto operator()(T&& value) const
    {
        return single_view<decay_t<T>>(
            static_cast<T&&>(value)
        );
    }
};

