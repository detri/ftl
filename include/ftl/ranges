            const difference_type offset =
                distance < requested
                    ? distance
                    : requested;

            auto first =
                ranges::begin(range);

            auto last =
                ranges::end(range);

            return raw_range(
                first + offset,
                last
            );
        }
        else
        {
            using base_type =
                all_t<R>;

            using difference_type =
                range_difference_t<R>;

            return drop_view<base_type>(
                all(static_cast<R&&>(range)),
