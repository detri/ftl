template<class W, class Bound>
struct drop_apply<iota_view<W, Bound>>
{
    using raw_range =
        iota_view<W, Bound>;

    template<
        viewable_range R,
        class Count
    >
        requires convertible_to<
            Count,
            range_difference_t<R>
        >
    [[nodiscard]]
    static constexpr auto call(
        R&& range,
        Count&& count
    )
    {
        if constexpr (
            random_access_range<raw_range> &&
            sized_range<raw_range>
        )
        {
            using difference_type =
                range_difference_t<R>;

            const difference_type distance =
                static_cast<difference_type>(
                    ranges::distance(range)
                );

            const difference_type requested =
                static_cast<difference_type>(
                    static_cast<Count&&>(count)
                );

            const difference_type offset =
                distance < requested
                    ? distance
                    : requested;

            auto first =
                ranges::begin(range);

            auto last =
                ranges::end(range);

            return raw_range(
                first + offset,
                last
            );
        }
        else
        {
            using base_type =
                all_t<R>;

            using difference_type =
                range_difference_t<R>;

            return drop_view<base_type>(
                all(static_cast<R&&>(range)),
                static_cast<difference_type>(
                    static_cast<Count&&>(count)
                )
