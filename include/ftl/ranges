    template<class Base>
    static constexpr auto end_impl(Base& base) {
        if constexpr (random_access_range<Base> && sized_range<Base>)
            return ranges::begin(base) + ranges::distance(base);
        else
            return common_iterator<iterator_t<Base>, sentinel_t<Base>>(ranges::end(base));
    }

public:
    common_view() requires default_initializable<V> = default;
    constexpr explicit common_view(V base) : base_(FTL_RANGES_NAMESPACE::move(base)) {}

    constexpr V base() const& requires copy_constructible<V> { return base_; }
    constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

    constexpr auto begin() { return begin_impl(base_); }
    constexpr auto begin() const requires range<const V> && copyable<iterator_t<const V>>
    { return begin_impl(base_); }
    constexpr auto end() { return end_impl(base_); }
    constexpr auto end() const requires range<const V> && copyable<iterator_t<const V>>
    { return end_impl(base_); }
    constexpr auto size() requires sized_range<V> { return ranges::size(base_); }
    constexpr auto size() const requires sized_range<const V> { return ranges::size(base_); }
};

