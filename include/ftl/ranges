      input_iterator_tag>;
};
} // namespace detail

template <view V, class F>
  requires transform_view_constraints<V, F>
class transform_view : public view_interface<transform_view<V, F>> {
  V base_ = V();
  detail::movable_box<F> function_;

  template <bool Const> using base_t = conditional_t<Const, const V, V>;

public:
  template <bool Const> class iterator;
  template <bool Const> class sentinel;

  transform_view()
    requires default_initializable<V> && default_initializable<F>
  = default;

  constexpr explicit transform_view(V base, F function)
      : base_(FTL_RANGES_NAMESPACE::move(base)),
        function_(FTL_RANGES_NAMESPACE::move(function)) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr iterator<false> begin() {
    return iterator<false>(*this, ranges::begin(base_));
  }

  constexpr iterator<true> begin() const
    requires range<const V> &&
             regular_invocable<const F &, range_reference_t<const V>>
  {
    return iterator<true>(*this, ranges::begin(base_));
  }

  constexpr auto end() {
    if constexpr (common_range<V>)
      return iterator<false>(*this, ranges::end(base_));
    else
      return sentinel<false>(*this, ranges::end(base_));
  }

  constexpr auto end() const
    requires range<const V> &&
             regular_invocable<const F &, range_reference_t<const V>>
  {
    if constexpr (common_range<const V>)
      return iterator<true>(*this, ranges::end(base_));
    else
      return sentinel<true>(*this, ranges::end(base_));
  }

  constexpr auto size()
    requires sized_range<V>
  {
    return ranges::size(base_);
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    return ranges::size(base_);
  }

  template <bool Const>
  class iterator : public detail::transform_iterator_category<
                       base_t<Const>, conditional_t<Const, const F, F>> {
    using Parent = conditional_t<Const, const transform_view, transform_view>;
    using Base = base_t<Const>;
    iterator_t<Base> current_;
    Parent *parent_ = nullptr;

    friend class iterator<!Const>;
    friend class sentinel<Const>;
    friend class sentinel<!Const>;

  public:
    using iterator_concept = conditional_t<
        random_access_range<Base>, random_access_iterator_tag,
        conditional_t<bidirectional_range<Base>, bidirectional_iterator_tag,
                      conditional_t<forward_range<Base>, forward_iterator_tag,
                                    input_iterator_tag>>>;
    using value_type =
        remove_cvref_t<invoke_result_t<conditional_t<Const, const F &, F &>,
                                       range_reference_t<Base>>>;
    using difference_type = range_difference_t<Base>;

    iterator()
      requires default_initializable<iterator_t<Base>>
    = default;

    constexpr iterator(Parent &parent, iterator_t<Base> current)
        : current_(FTL_RANGES_NAMESPACE::move(current)),
          parent_(FTL_RANGES_NAMESPACE::addressof(parent)) {}

    constexpr iterator(iterator<!Const> other)
      requires Const && convertible_to<iterator_t<V>, iterator_t<Base>>
        : current_(FTL_RANGES_NAMESPACE::move(other.current_)),
          parent_(other.parent_) {}

    constexpr const iterator_t<Base> &base() const & noexcept {
      return current_;
    }

    constexpr iterator_t<Base> base() && {
      return FTL_RANGES_NAMESPACE::move(current_);
    }

    constexpr decltype(auto) operator*() const
        noexcept(noexcept(FTL_RANGES_NAMESPACE::invoke(*parent_->function_,
                                                       *current_))) {
      return FTL_RANGES_NAMESPACE::invoke(*parent_->function_, *current_);
    }

    constexpr iterator &operator++() {
      ++current_;
      return *this;
    }

    constexpr void operator++(int) { ++current_; }

    constexpr iterator operator++(int)
      requires forward_range<Base>
    {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<Base>
    {
      --current_;
      return *this;
    }

    constexpr iterator operator--(int)
      requires bidirectional_range<Base>
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    constexpr iterator &operator+=(difference_type n)
      requires random_access_range<Base>
    {
      current_ += n;
      return *this;
    }

    constexpr iterator &operator-=(difference_type n)
      requires random_access_range<Base>
    {
      current_ -= n;
      return *this;
    }

    constexpr decltype(auto) operator[](difference_type n) const
      requires random_access_range<Base>
    {
      return FTL_RANGES_NAMESPACE::invoke(*parent_->function_, current_[n]);
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right)
      requires equality_comparable<iterator_t<Base>>
    {
      return left.current_ == right.current_;
    }

    friend constexpr bool operator<(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return left.current_ < right.current_;
    }

    friend constexpr bool operator>(const iterator &left, const iterator &right)
      requires random_access_range<Base>
    {
      return right < left;
    }

    friend constexpr bool operator<=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(right < left);
    }

    friend constexpr bool operator>=(const iterator &left,
                                     const iterator &right)
      requires random_access_range<Base>
    {
      return !(left < right);
    }

    friend constexpr iterator operator+(iterator current, difference_type n)
      requires random_access_range<Base>
    {
      current += n;
      return current;
    }

    friend constexpr iterator operator+(difference_type n, iterator current)
      requires random_access_range<Base>
    {
      current += n;
      return current;
    }

    friend constexpr iterator operator-(iterator current, difference_type n)
      requires random_access_range<Base>
    {
      current -= n;
      return current;
    }

    friend constexpr difference_type operator-(const iterator &left,
                                               const iterator &right)
      requires sized_sentinel_for<iterator_t<Base>, iterator_t<Base>>
    {
      return left.current_ - right.current_;
    }
  };

  template <bool Const> class sentinel {
    using Base = base_t<Const>;
    sentinel_t<Base> end_{};
    friend class sentinel<!Const>;
    template <bool C> friend class iterator;

  public:
    sentinel() = default;

    constexpr sentinel(transform_view &, sentinel_t<Base> end)
        : end_(FTL_RANGES_NAMESPACE::move(end)) {}
    constexpr sentinel(const transform_view &, sentinel_t<Base> end)
        : end_(FTL_RANGES_NAMESPACE::move(end)) {}

    constexpr sentinel(sentinel<!Const> other)
      requires Const && convertible_to<sentinel_t<V>, sentinel_t<Base>>
        : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}

    constexpr sentinel_t<Base> base() const { return end_; }

    friend constexpr bool operator==(const iterator<Const> &current,
                                     const sentinel &end) {
      return current.base() == end.end_;
    }

    friend constexpr range_difference_t<Base>
    operator-(const iterator<Const> &current, const sentinel &end)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      return current.current_ - end.end_;
    }

    friend constexpr range_difference_t<Base>
    operator-(const sentinel &end, const iterator<Const> &current)
      requires sized_sentinel_for<sentinel_t<Base>, iterator_t<Base>>
    {
      return end.end_ - current.current_;
    }
  };
};

