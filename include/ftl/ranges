template<
    viewable_range R,
    class Count
>
    requires convertible_to<
        Count,
        range_difference_t<R>
    >
[[nodiscard]]
constexpr auto apply_take(
    R&& range,
    Count&& count
)
{
    using raw_range =
        remove_cvref_t<R>;

    using difference_type =
        range_difference_t<R>;

    const difference_type requested =
        static_cast<difference_type>(
            static_cast<Count&&>(count)
        );

    if constexpr (
        take_is_empty_view_v<raw_range>
    )
    {
        return static_cast<R&&>(range);
    }
    else if constexpr (
        take_is_subrange_v<raw_range> &&
        random_access_range<raw_range> &&
        sized_range<raw_range>
    )
    {
        const difference_type distance =
            static_cast<difference_type>(
                ranges::distance(range)
            );

        const difference_type length =
            distance < requested
                ? distance
                : requested;

        auto first =
            ranges::begin(range);

        return subrange<iterator_t<R>>(
            first,
            first + length
        );
    }
    else if constexpr (
        take_is_iota_view_v<raw_range> &&
        random_access_range<raw_range> &&
        sized_range<raw_range>
    )
    {
        const difference_type distance =
            static_cast<difference_type>(
                ranges::distance(range)
            );

        const difference_type length =
            distance < requested
                ? distance
                : requested;

        auto first =
            ranges::begin(range);

        return iota_view(
            *first,
            *(first + length)
        );
    }
    else
    {
        using base_type =
            all_t<R>;

        return take_view<base_type>(
            all(static_cast<R&&>(range)),
            requested
        );
    }
}


