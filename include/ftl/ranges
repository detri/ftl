    requires(tuple_invocable<F &, Tuple &&>())
  constexpr decltype(auto) operator()(Tuple &&values) & noexcept(
      tuple_nothrow_invocable<F &, Tuple &&>()) {
    return invoke_tuple(
        function, static_cast<Tuple &&>(values),
        make_index_sequence<tuple_size_v<remove_cvref_t<Tuple>>>{});
  }

  template <class Tuple>
    requires(tuple_invocable<const F &, Tuple &&>())
  constexpr decltype(auto) operator()(Tuple &&values) const & noexcept(
      tuple_nothrow_invocable<const F &, Tuple &&>()) {
