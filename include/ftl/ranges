inline constexpr bool enable_borrowed_range<zip_view<Views...>> =
    (enable_borrowed_range<Views> && ...);

template <view V>
  requires input_range<V>
class enumerate_view : public view_interface<enumerate_view<V>> {
  V base_ = V();

  template <bool Const> class iterator {
    using Base = detail::maybe_const_t<Const, V>;

    template <bool OtherConst>
    using common_iterator_t =
        iterator_t<detail::maybe_const_t<Const || OtherConst, V>>;

  public:
    using iterator_concept = conditional_t<
        random_access_range<Base>, random_access_iterator_tag,
        conditional_t<bidirectional_range<Base>, bidirectional_iterator_tag,
                      conditional_t<forward_range<Base>, forward_iterator_tag,
                                    input_iterator_tag>>>;

    using iterator_category = input_iterator_tag;
    using value_type = tuple<range_difference_t<Base>, range_value_t<Base>>;
    using difference_type = range_difference_t<Base>;

  private:
    iterator_t<Base> current_;
    difference_type position_ = 0;

    friend class enumerate_view;
    template <bool> friend class iterator;

    constexpr iterator(iterator_t<Base> current, difference_type position)
        : current_(FTL_RANGES_NAMESPACE::move(current)), position_(position) {}

  public:
    iterator() = default;

    constexpr iterator(iterator<!Const> other)
      requires Const && convertible_to<iterator_t<V>, iterator_t<const V>>
        : current_(FTL_RANGES_NAMESPACE::move(other.current_)),
          position_(other.position_) {}

    constexpr auto operator*() const {
      return tuple<difference_type, range_reference_t<Base>>(position_,
                                                             *current_);
    }

    constexpr const iterator_t<Base> &base() const noexcept { return current_; }

    constexpr iterator &operator++() {
      ++current_;
      ++position_;
      return *this;
    }

    constexpr void operator++(int) { ++*this; }

    constexpr iterator operator++(int)
      requires forward_range<Base>
    {
      auto copy = *this;
      ++*this;
      return copy;
    }

    constexpr iterator &operator--()
      requires bidirectional_range<Base>
    {
      --current_;
      --position_;
      return *this;
    }

    constexpr iterator operator--(int)
      requires bidirectional_range<Base>
    {
      auto copy = *this;
      --*this;
      return copy;
    }

    constexpr iterator &operator+=(difference_type offset)
      requires random_access_range<Base>
    {
      current_ += offset;
      position_ += offset;
      return *this;
    }

    constexpr iterator &operator-=(difference_type offset)
      requires random_access_range<Base>
    {
      return *this += -offset;
    }

    constexpr auto operator[](difference_type offset) const
      requires random_access_range<Base>
    {
      return *(*this + offset);
    }

    template <bool OtherConst>
    friend constexpr bool operator==(const iterator &left,
                                     const iterator<OtherConst> &right)
      requires requires { left.base() == right.base(); }
    {
      return left.base() == right.base();
    }

    template <bool OtherConst>
    friend constexpr bool operator<(const iterator &left,
                                    const iterator<OtherConst> &right)
      requires requires { left.base() < right.base(); }
    {
      return left.base() < right.base();
    }

    template <bool OtherConst>
    friend constexpr bool operator>(const iterator &left,
                                    const iterator<OtherConst> &right)
      requires requires { right < left; }
    {
      return right < left;
    }

    template <bool OtherConst>
    friend constexpr bool operator<=(const iterator &left,
                                     const iterator<OtherConst> &right)
      requires requires { right < left; }
    {
      return !(right < left);
    }

    template <bool OtherConst>
    friend constexpr bool operator>=(const iterator &left,
                                     const iterator<OtherConst> &right)
      requires requires { left < right; }
    {
      return !(left < right);
    }

    friend constexpr iterator operator+(iterator value, difference_type offset)
      requires random_access_range<Base>
    {
      return value += offset;
    }

    friend constexpr iterator operator+(difference_type offset, iterator value)
      requires random_access_range<Base>
    {
      return value += offset;
    }

    friend constexpr iterator operator-(iterator value, difference_type offset)
      requires random_access_range<Base>
    {
      return value -= offset;
    }

    template <bool OtherConst>
    friend constexpr auto operator-(const iterator &left,
                                    const iterator<OtherConst> &right)
      requires constructible_from<common_iterator_t<OtherConst>,
                                  const iterator_t<Base> &> &&
               constructible_from<
                   common_iterator_t<OtherConst>,
                   const iterator_t<detail::maybe_const_t<OtherConst, V>> &> &&
               sized_sentinel_for<common_iterator_t<OtherConst>,
                                  common_iterator_t<OtherConst>>
    {
      common_iterator_t<OtherConst> left_current(left.base());
      common_iterator_t<OtherConst> right_current(right.base());
      return left_current - right_current;
    }

    constexpr difference_type position() const noexcept { return position_; }
  };

  template <bool Const> class sentinel {
    using Base = detail::maybe_const_t<Const, V>;

    sentinel_t<Base> end_{};

    friend class enumerate_view;
    template <bool> friend class sentinel;

    constexpr explicit sentinel(sentinel_t<Base> end)
        : end_(FTL_RANGES_NAMESPACE::move(end)) {}

  public:
    sentinel() = default;

    constexpr sentinel(sentinel<!Const> other)
      requires Const && convertible_to<sentinel_t<V>, sentinel_t<const V>>
        : end_(FTL_RANGES_NAMESPACE::move(other.end_)) {}

    constexpr const sentinel_t<Base> &base() const noexcept { return end_; }

    template <bool OtherConst>
    friend constexpr bool operator==(const iterator<OtherConst> &current,
                                     const sentinel &end)
      requires requires { current.base() == end.end_; }
    {
      return current.base() == end.end_;
    }
  };

public:
  enumerate_view()
    requires default_initializable<V>
  = default;

  constexpr explicit enumerate_view(V base)
      : base_(FTL_RANGES_NAMESPACE::move(base)) {}

  constexpr V base() const &
    requires copy_constructible<V>
  {
    return base_;
  }

  constexpr V base() && { return FTL_RANGES_NAMESPACE::move(base_); }

  constexpr iterator<false> begin() {
    return iterator<false>(ranges::begin(base_), 0);
  }

  constexpr iterator<true> begin() const
    requires input_range<const V>
  {
    return iterator<true>(ranges::begin(base_), 0);
  }

  constexpr auto end() {
    if constexpr (common_range<V> && sized_range<V>) {
      return iterator<false>(
          ranges::end(base_),
          static_cast<range_difference_t<V>>(ranges::size(base_)));
    } else {
      return sentinel<false>(ranges::end(base_));
    }
  }

  constexpr auto end() const
    requires input_range<const V>
  {
    if constexpr (common_range<const V> && sized_range<const V>) {
      return iterator<true>(
          ranges::end(base_),
          static_cast<range_difference_t<const V>>(ranges::size(base_)));
    } else {
      return sentinel<true>(ranges::end(base_));
    }
  }

  constexpr auto size()
    requires sized_range<V>
  {
    return ranges::size(base_);
  }

  constexpr auto size() const
    requires sized_range<const V>
  {
    return ranges::size(base_);
  }
};

