namespace ranges {

namespace detail {

template<class T, class U>
concept different_from =
    !same_as<remove_cvref_t<T>, remove_cvref_t<U>>;

template<class From, class To>
concept uses_nonqualification_pointer_conversion =
    is_pointer_v<From> &&
    is_pointer_v<To> &&
    !convertible_to<
        remove_pointer_t<From> (*)[],
        remove_pointer_t<To> (*)[]
    >;

template<class From, class To>
concept convertible_to_non_slicing =
    convertible_to<From, To> &&
    !uses_nonqualification_pointer_conversion<
        decay_t<From>,
        decay_t<To>
    >;

template<class T>
using make_unsigned_like_t = make_unsigned_t<remove_cv_t<T>>;

template<class T>
[[nodiscard]]
constexpr make_unsigned_like_t<T>
to_unsigned_like(T value) noexcept {
    return static_cast<make_unsigned_like_t<T>>(value);
}

template<class T>
[[nodiscard]]
constexpr make_signed_t<remove_cv_t<T>>
to_signed_like(T value) noexcept {
    return static_cast<make_signed_t<remove_cv_t<T>>>(value);
}

template<bool Const, class T>
using maybe_const_t = conditional_t<Const, const T, T>;

template<class R>
concept simple_view =
    view<R> &&
    range<const R> &&
    same_as<iterator_t<R>, iterator_t<const R>> &&
    same_as<sentinel_t<R>, sentinel_t<const R>>;

template<class Iterator>
concept has_arrow =
    input_iterator<Iterator> &&
    (
        is_pointer_v<Iterator> ||
        requires(const Iterator& iterator) {
            iterator.operator->();
        }
    );

/*
 * tuple-like recognises exactly the standard tuple-like specializations,
 * which is what pair-like conversions on subrange are specified against.
 */
template<class T>
inline constexpr bool is_tuple_like_v = false;

template<class T1, class T2>
inline constexpr bool is_tuple_like_v<pair<T1, T2>> = true;

template<class... Types>
inline constexpr bool is_tuple_like_v<tuple<Types...>> = true;

template<class T, size_t Size>
inline constexpr bool is_tuple_like_v<array<T, Size>> = true;

template<class T>
concept tuple_like = is_tuple_like_v<remove_cvref_t<T>>;

template<class T>
concept pair_like =
    tuple_like<T> &&
    tuple_size_v<remove_cvref_t<T>> == 2;

} // namespace detail

// [view.interface]

template<class Derived>
    requires (
        is_class_v<Derived> &&
        same_as<Derived, remove_cv_t<Derived>>
    )
class view_interface {
private:
    [[nodiscard]]
    constexpr Derived& derived() noexcept {
        return static_cast<Derived&>(*this);
    }

    [[nodiscard]]
    constexpr const Derived& derived() const noexcept {
        return static_cast<const Derived&>(*this);
    }

public:
    [[nodiscard]]
    constexpr bool empty()
        requires (
            sized_range<Derived> ||
            forward_range<Derived>
        )
    {
        if constexpr (sized_range<Derived>) {
            return ranges::size(derived()) == 0;
        } else {
            return ranges::begin(derived()) == ranges::end(derived());
        }
    }

    [[nodiscard]]
    constexpr bool empty() const
        requires (
            sized_range<const Derived> ||
            forward_range<const Derived>
        )
    {
        if constexpr (sized_range<const Derived>) {
            return ranges::size(derived()) == 0;
        } else {
            return ranges::begin(derived()) == ranges::end(derived());
        }
    }

    [[nodiscard]]
    constexpr auto cbegin()
        requires input_range<Derived>
    {
        return ranges::cbegin(derived());
    }

    [[nodiscard]]
    constexpr auto cbegin() const
        requires input_range<const Derived>
    {
        return ranges::cbegin(derived());
    }

    [[nodiscard]]
    constexpr auto cend()
        requires input_range<Derived>
    {
        return ranges::cend(derived());
    }

    [[nodiscard]]
    constexpr auto cend() const
        requires input_range<const Derived>
    {
        return ranges::cend(derived());
    }

    constexpr explicit operator bool()
        requires requires(Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    constexpr explicit operator bool() const
        requires requires(const Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    [[nodiscard]]
    constexpr auto data()
        requires contiguous_iterator<iterator_t<Derived>>
    {
        return FTL_RANGES_NAMESPACE::to_address(
            ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto data() const
        requires (
            range<const Derived> &&
            contiguous_iterator<iterator_t<const Derived>>
        )
    {
        return FTL_RANGES_NAMESPACE::to_address(
            ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto size()
        requires (
            forward_range<Derived> &&
            sized_sentinel_for<
                sentinel_t<Derived>,
                iterator_t<Derived>
            >
        )
    {
        return detail::to_unsigned_like(
            ranges::end(derived()) - ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr auto size() const
        requires (
            forward_range<const Derived> &&
            sized_sentinel_for<
                sentinel_t<const Derived>,
                iterator_t<const Derived>
            >
        )
    {
        return detail::to_unsigned_like(
            ranges::end(derived()) - ranges::begin(derived())
        );
    }

    [[nodiscard]]
    constexpr decltype(auto) front()
        requires forward_range<Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) front() const
        requires forward_range<const Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) back()
        requires (
            bidirectional_range<Derived> &&
            common_range<Derived>
        )
    {
        return *ranges::prev(ranges::end(derived()));
    }

    [[nodiscard]]
    constexpr decltype(auto) back() const
        requires (
            bidirectional_range<const Derived> &&
            common_range<const Derived>
        )
    {
        return *ranges::prev(ranges::end(derived()));
    }

    template<random_access_range Range = Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) {
        return ranges::begin(derived())[index];
    }

    template<random_access_range Range = const Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) const {
        return ranges::begin(derived())[index];
    }
};

// [range.dangling]

struct dangling {
    constexpr dangling() noexcept = default;

    template<class... Args>
    constexpr dangling(Args&&...) noexcept {}
};

template<range R>
using borrowed_iterator_t =
    conditional_t<
        borrowed_range<R>,
        iterator_t<R>,
        dangling
    >;

// [range.subrange]

enum class subrange_kind : bool {
    unsized,
    sized
};

namespace detail {

template<class T, bool Present>
struct maybe_present {
    FTL_NO_UNIQUE_ADDRESS T value = T();
};

template<class T>
struct maybe_present<T, false> {};

template<class T, class U, class V>
concept pair_like_convertible_from =
    !range<T> &&
    !is_reference_v<T> &&
    pair_like<T> &&
    constructible_from<T, U, V> &&
    convertible_to_non_slicing<U, tuple_element_t<0, T>> &&
    convertible_to<V, tuple_element_t<1, T>>;

} // namespace detail

template<
    input_or_output_iterator Iterator,
    sentinel_for<Iterator> Sentinel = Iterator,
    subrange_kind Kind =
        sized_sentinel_for<Sentinel, Iterator>
            ? subrange_kind::sized
            : subrange_kind::unsized
>
    requires (
        Kind == subrange_kind::sized ||
        !sized_sentinel_for<Sentinel, Iterator>
    )
class subrange
    : public view_interface<subrange<Iterator, Sentinel, Kind>> {
private:
    static constexpr bool stores_size =
        Kind == subrange_kind::sized &&
        !sized_sentinel_for<Sentinel, Iterator>;

    using size_type =
        detail::make_unsigned_like_t<iter_difference_t<Iterator>>;

    FTL_NO_UNIQUE_ADDRESS Iterator first_ = Iterator();
    FTL_NO_UNIQUE_ADDRESS Sentinel last_ = Sentinel();
    FTL_NO_UNIQUE_ADDRESS detail::maybe_present<
        size_type,
        stores_size
    > size_{};

public:
    subrange()
        requires default_initializable<Iterator>
        = default;

    template<detail::convertible_to_non_slicing<Iterator> From>
        requires (!stores_size)
    constexpr subrange(From first, Sentinel last)
        : first_(FTL_RANGES_NAMESPACE::move(first)),
          last_(FTL_RANGES_NAMESPACE::move(last)) {}

    template<detail::convertible_to_non_slicing<Iterator> From>
        requires (Kind == subrange_kind::sized)
    constexpr subrange(From first, Sentinel last, size_type count)
        : first_(FTL_RANGES_NAMESPACE::move(first)),
          last_(FTL_RANGES_NAMESPACE::move(last)) {
        if constexpr (stores_size) {
            size_.value = count;
        }
    }

    template<detail::different_from<subrange> R>
        requires (
            borrowed_range<R> &&
            detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
            convertible_to<sentinel_t<R>, Sentinel> &&
            (!stores_size || sized_range<R>)
        )
    constexpr subrange(R&& other)
        : subrange(
            ranges::begin(other),
            ranges::end(other)
        ) {
        if constexpr (stores_size) {
            size_.value = ranges::size(other);
        }
    }

    template<borrowed_range R>
        requires (
            detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
            convertible_to<sentinel_t<R>, Sentinel> &&
            Kind == subrange_kind::sized
        )
    constexpr subrange(R&& other, size_type count)
        : subrange(
            ranges::begin(other),
            ranges::end(other),
            count
        ) {}

    template<detail::different_from<subrange> PairLike>
        requires detail::pair_like_convertible_from<
            PairLike,
            const Iterator&,
            const Sentinel&
        >
    constexpr operator PairLike() const {
        return PairLike(first_, last_);
    }

    [[nodiscard]]
    constexpr Iterator begin() const
        requires copyable<Iterator>
    {
        return first_;
    }

    [[nodiscard]]
    constexpr Iterator begin()
        requires (!copyable<Iterator>)
    {
        return FTL_RANGES_NAMESPACE::move(first_);
    }

    [[nodiscard]]
    constexpr Sentinel end() const {
        return last_;
    }

    [[nodiscard]]
    constexpr bool empty() const {
        return first_ == last_;
    }

    [[nodiscard]]
    constexpr size_type size() const
        requires (Kind == subrange_kind::sized)
    {
        if constexpr (stores_size) {
            return size_.value;
        } else {
            return detail::to_unsigned_like(last_ - first_);
        }
    }

    [[nodiscard]]
    constexpr subrange next(
        iter_difference_t<Iterator> count = 1
    ) const&
        requires forward_iterator<Iterator>
    {
        auto result = *this;
        result.advance(count);
        return result;
    }

    [[nodiscard]]
    constexpr subrange next(
        iter_difference_t<Iterator> count = 1
    ) && {
        advance(count);
        return FTL_RANGES_NAMESPACE::move(*this);
    }

    [[nodiscard]]
    constexpr subrange prev(
        iter_difference_t<Iterator> count = 1
    ) const
        requires bidirectional_iterator<Iterator>
    {
        auto result = *this;
        result.advance(-count);
        return result;
    }

    constexpr subrange& advance(
        iter_difference_t<Iterator> count
    ) {
        if constexpr (bidirectional_iterator<Iterator>) {
            if (count < 0) {
                ranges::advance(first_, count);

                if constexpr (stores_size) {
                    size_.value += detail::to_unsigned_like(-count);
                }

                return *this;
            }
        }

        auto remainder = ranges::advance(first_, count, last_);

        if constexpr (stores_size) {
            size_.value -= detail::to_unsigned_like(count - remainder);
        }

        return *this;
    }
};

template<input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(Iterator, Sentinel) -> subrange<Iterator, Sentinel>;

template<input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(
    Iterator,
    Sentinel,
    detail::make_unsigned_like_t<iter_difference_t<Iterator>>
) -> subrange<Iterator, Sentinel, subrange_kind::sized>;

template<borrowed_range R>
subrange(R&&) -> subrange<
    iterator_t<R>,
    sentinel_t<R>,
    (
        sized_range<R> ||
        sized_sentinel_for<sentinel_t<R>, iterator_t<R>>
    )
        ? subrange_kind::sized
        : subrange_kind::unsized
>;

template<borrowed_range R>
subrange(
    R&&,
    detail::make_unsigned_like_t<range_difference_t<R>>
) -> subrange<iterator_t<R>, sentinel_t<R>, subrange_kind::sized>;

template<size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
    requires (
        (Index == 0 && copyable<Iterator>) ||
        Index == 1
    )
[[nodiscard]]
constexpr auto get(const subrange<Iterator, Sentinel, Kind>& value) {
    if constexpr (Index == 0) {
        return value.begin();
    } else {
        return value.end();
    }
}

template<size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
    requires (Index < 2)
[[nodiscard]]
constexpr auto get(subrange<Iterator, Sentinel, Kind>&& value) {
    if constexpr (Index == 0) {
        return value.begin();
    } else {
        return value.end();
    }
}

template<class Iterator, class Sentinel, subrange_kind Kind>
inline constexpr bool
enable_borrowed_range<subrange<Iterator, Sentinel, Kind>> = true;

template<range R>
using borrowed_subrange_t =
    conditional_t<
        borrowed_range<R>,
        subrange<iterator_t<R>>,
        dangling
    >;

namespace detail {

template<class Iterator, class Sentinel, subrange_kind Kind>
inline constexpr bool
is_tuple_like_v<subrange<Iterator, Sentinel, Kind>> = true;

