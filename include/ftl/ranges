namespace ranges {
namespace detail {
template <class T, class U>
concept different_from = !same_as<remove_cvref_t<T>, remove_cvref_t<U>>;

template <class From, class To>
concept uses_nonqualification_pointer_conversion =
    is_pointer_v<From> && is_pointer_v<To> &&
    !convertible_to<remove_pointer_t<From> (*)[], remove_pointer_t<To> (*)[]>;

template <class From, class To>
concept convertible_to_non_slicing =
    convertible_to<From, To> &&
    !uses_nonqualification_pointer_conversion<decay_t<From>, decay_t<To>>;

template <class T> using make_unsigned_like_t = make_unsigned_t<remove_cv_t<T>>;

template <class T>
[[nodiscard]]
constexpr make_unsigned_like_t<T> to_unsigned_like(T value) noexcept {
  return static_cast<make_unsigned_like_t<T>>(value);
}

template <class T>
[[nodiscard]]
constexpr make_signed_t<remove_cv_t<T>> to_signed_like(T value) noexcept {
  return static_cast<make_signed_t<remove_cv_t<T>>>(value);
}

template <bool Const, class T>
using maybe_const_t = conditional_t<Const, const T, T>;

template <class R>
concept simple_view =
    view<R> && range<const R> && same_as<iterator_t<R>, iterator_t<const R>> &&
    same_as<sentinel_t<R>, sentinel_t<const R>>;

template <class Iterator>
concept has_arrow =
    input_iterator<Iterator> &&
    (is_pointer_v<Iterator> ||
     requires(const Iterator &iterator) { iterator.operator->(); });

/*
 * tuple-like recognises exactly the standard tuple-like specializations,
 * which is what pair-like conversions on subrange are specified against.
 */
template <class T> inline constexpr bool is_tuple_like_v = false;

template <class T1, class T2>
inline constexpr bool is_tuple_like_v<pair<T1, T2>> = true;

template <class... Types>
inline constexpr bool is_tuple_like_v<tuple<Types...>> = true;

template <class T, size_t Size>
inline constexpr bool is_tuple_like_v<array<T, Size>> = true;

template <class T>
concept tuple_like = is_tuple_like_v<remove_cvref_t<T>>;

template <class T>
concept pair_like = tuple_like<T> && tuple_size_v<remove_cvref_t<T>> == 2;
} // namespace detail

// [view.interface]

template <class Derived>
  requires(is_class_v<Derived> && same_as<Derived, remove_cv_t<Derived>>)
class view_interface {
private:
  [[nodiscard]]
  constexpr Derived &derived() noexcept {
    return static_cast<Derived &>(*this);
  }

  [[nodiscard]]
  constexpr const Derived &derived() const noexcept {
    return static_cast<const Derived &>(*this);
  }

public:
  [[nodiscard]]
  constexpr bool empty()
    requires(sized_range<Derived> || forward_range<Derived>)
  {
    if constexpr (sized_range<Derived>) {
      return ranges::size(derived()) == 0;
    } else {
      return ranges::begin(derived()) == ranges::end(derived());
    }
  }

  [[nodiscard]]
  constexpr bool empty() const
    requires(sized_range<const Derived> || forward_range<const Derived>)
  {
    if constexpr (sized_range<const Derived>) {
      return ranges::size(derived()) == 0;
    } else {
      return ranges::begin(derived()) == ranges::end(derived());
    }
  }

  [[nodiscard]]
  constexpr auto cbegin()
    requires input_range<Derived>
  {
    return ranges::cbegin(derived());
  }

  [[nodiscard]]
  constexpr auto cbegin() const
    requires input_range<const Derived>
  {
    return ranges::cbegin(derived());
  }

  [[nodiscard]]
  constexpr auto cend()
    requires input_range<Derived>
  {
    return ranges::cend(derived());
  }

  [[nodiscard]]
  constexpr auto cend() const
    requires input_range<const Derived>
  {
    return ranges::cend(derived());
  }

  constexpr explicit operator bool()
    requires requires(Derived &value) { ranges::empty(value); }
  {
    return !ranges::empty(derived());
  }

  constexpr explicit operator bool() const
    requires requires(const Derived &value) { ranges::empty(value); }
  {
    return !ranges::empty(derived());
  }

  [[nodiscard]]
  constexpr auto data()
    requires contiguous_iterator<iterator_t<Derived>>
  {
    return FTL_RANGES_NAMESPACE::to_address(ranges::begin(derived()));
  }

  [[nodiscard]]
  constexpr auto data() const
    requires(range<const Derived> &&
             contiguous_iterator<iterator_t<const Derived>>)
  {
    return FTL_RANGES_NAMESPACE::to_address(ranges::begin(derived()));
  }

  [[nodiscard]]
  constexpr auto size()
    requires(forward_range<Derived> &&
             sized_sentinel_for<sentinel_t<Derived>, iterator_t<Derived>>)
  {
    return detail::to_unsigned_like(ranges::end(derived()) -
                                    ranges::begin(derived()));
  }

  [[nodiscard]]
  constexpr auto size() const
    requires(forward_range<const Derived> &&
             sized_sentinel_for<sentinel_t<const Derived>,
                                iterator_t<const Derived>>)
  {
    return detail::to_unsigned_like(ranges::end(derived()) -
                                    ranges::begin(derived()));
  }

  [[nodiscard]]
  constexpr decltype(auto) front()
    requires forward_range<Derived>
  {
    return *ranges::begin(derived());
  }

  [[nodiscard]]
  constexpr decltype(auto) front() const
    requires forward_range<const Derived>
  {
    return *ranges::begin(derived());
  }

  [[nodiscard]]
  constexpr decltype(auto) back()
    requires(bidirectional_range<Derived> && common_range<Derived>)
  {
    return *ranges::prev(ranges::end(derived()));
  }

  [[nodiscard]]
  constexpr decltype(auto) back() const
    requires(bidirectional_range<const Derived> && common_range<const Derived>)
  {
    return *ranges::prev(ranges::end(derived()));
  }

  template <random_access_range Range = Derived>
  [[nodiscard]]
  constexpr decltype(auto) operator[](range_difference_t<Range> index) {
    return ranges::begin(derived())[index];
  }

  template <random_access_range Range = const Derived>
  [[nodiscard]]
  constexpr decltype(auto) operator[](range_difference_t<Range> index) const {
    return ranges::begin(derived())[index];
  }
};

