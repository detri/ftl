      : count_(static_cast<Count &&>(count)) {}

  template <viewable_range R>
    requires convertible_to<const Count &, range_difference_t<R>>
  [[nodiscard]]
  constexpr auto operator()(R &&range) const & {
    return apply_take(static_cast<R &&>(range), count_);
  }

  template <viewable_range R>
    requires convertible_to<Count, range_difference_t<R>>
  [[nodiscard]]
  constexpr auto operator()(R &&range) && {
    return apply_take(static_cast<R &&>(range), static_cast<Count &&>(count_));
  }
};
