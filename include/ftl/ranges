// [range.subrange]

enum class subrange_kind : bool { unsized, sized };

namespace detail {
template <class T, bool Present> struct maybe_present {
  FTL_NO_UNIQUE_ADDRESS T value = T();
};

template <class T> struct maybe_present<T, false> {};

template <class T, class U, class V>
concept pair_like_convertible_from =
    !range<T> && !is_reference_v<T> && pair_like<T> &&
    constructible_from<T, U, V> &&
    convertible_to_non_slicing<U, tuple_element_t<0, T>> &&
    convertible_to<V, tuple_element_t<1, T>>;
} // namespace detail

template <input_or_output_iterator Iterator,
          sentinel_for<Iterator> Sentinel = Iterator,
          subrange_kind Kind = sized_sentinel_for<Sentinel, Iterator>
                                   ? subrange_kind::sized
                                   : subrange_kind::unsized>
  requires(Kind == subrange_kind::sized ||
           !sized_sentinel_for<Sentinel, Iterator>)
class subrange : public view_interface<subrange<Iterator, Sentinel, Kind>> {
private:
  static constexpr bool stores_size =
      Kind == subrange_kind::sized && !sized_sentinel_for<Sentinel, Iterator>;

  using size_type = detail::make_unsigned_like_t<iter_difference_t<Iterator>>;

  FTL_NO_UNIQUE_ADDRESS Iterator first_ = Iterator();
  FTL_NO_UNIQUE_ADDRESS Sentinel last_ = Sentinel();
  FTL_NO_UNIQUE_ADDRESS detail::maybe_present<size_type, stores_size> size_{};

public:
  subrange()
    requires default_initializable<Iterator>
  = default;

  template <detail::convertible_to_non_slicing<Iterator> From>
    requires(!stores_size)
  constexpr subrange(From first, Sentinel last)
      : first_(FTL_RANGES_NAMESPACE::move(first)),
        last_(FTL_RANGES_NAMESPACE::move(last)) {}

  template <detail::convertible_to_non_slicing<Iterator> From>
    requires(Kind == subrange_kind::sized)
  constexpr subrange(From first, Sentinel last, size_type count)
      : first_(FTL_RANGES_NAMESPACE::move(first)),
        last_(FTL_RANGES_NAMESPACE::move(last)) {
    if constexpr (stores_size) {
      size_.value = count;
    }
  }

  template <detail::different_from<subrange> R>
    requires(borrowed_range<R> &&
             detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
             convertible_to<sentinel_t<R>, Sentinel> &&
             (!stores_size || sized_range<R>))
  constexpr subrange(R &&other)
      : subrange(ranges::begin(other), ranges::end(other)) {
    if constexpr (stores_size) {
      size_.value = ranges::size(other);
    }
  }

  template <borrowed_range R>
    requires(detail::convertible_to_non_slicing<iterator_t<R>, Iterator> &&
             convertible_to<sentinel_t<R>, Sentinel> &&
             Kind == subrange_kind::sized)
  constexpr subrange(R &&other, size_type count)
      : subrange(ranges::begin(other), ranges::end(other), count) {}

  template <detail::different_from<subrange> PairLike>
    requires detail::pair_like_convertible_from<PairLike, const Iterator &,
                                                const Sentinel &>
  constexpr operator PairLike() const {
    return PairLike(first_, last_);
  }

  [[nodiscard]]
  constexpr Iterator begin() const
    requires copyable<Iterator>
  {
    return first_;
  }

  [[nodiscard]]
  constexpr Iterator begin()
    requires(!copyable<Iterator>)
  {
    return FTL_RANGES_NAMESPACE::move(first_);
  }

  [[nodiscard]]
  constexpr Sentinel end() const {
    return last_;
  }

  [[nodiscard]]
  constexpr bool empty() const {
    return first_ == last_;
  }

  [[nodiscard]]
  constexpr size_type size() const
    requires(Kind == subrange_kind::sized)
  {
    if constexpr (stores_size) {
      return size_.value;
    } else {
      return detail::to_unsigned_like(last_ - first_);
    }
  }

  [[nodiscard]]
  constexpr subrange next(iter_difference_t<Iterator> count = 1) const &
    requires forward_iterator<Iterator>
  {
    auto result = *this;
    result.advance(count);
    return result;
  }

  [[nodiscard]]
  constexpr subrange next(iter_difference_t<Iterator> count = 1) && {
    advance(count);
    return FTL_RANGES_NAMESPACE::move(*this);
  }

  [[nodiscard]]
  constexpr subrange prev(iter_difference_t<Iterator> count = 1) const
    requires bidirectional_iterator<Iterator>
  {
    auto result = *this;
    result.advance(-count);
    return result;
  }

  constexpr subrange &advance(iter_difference_t<Iterator> count) {
    if constexpr (bidirectional_iterator<Iterator>) {
      if (count < 0) {
        ranges::advance(first_, count);

        if constexpr (stores_size) {
          size_.value += detail::to_unsigned_like(-count);
        }

        return *this;
      }
    }

    auto remainder = ranges::advance(first_, count, last_);

    if constexpr (stores_size) {
      size_.value -= detail::to_unsigned_like(count - remainder);
    }

    return *this;
  }
};

template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(Iterator, Sentinel) -> subrange<Iterator, Sentinel>;

template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel>
subrange(Iterator, Sentinel,
         detail::make_unsigned_like_t<iter_difference_t<Iterator>>)
    -> subrange<Iterator, Sentinel, subrange_kind::sized>;

template <borrowed_range R>
subrange(R &&) -> subrange<iterator_t<R>, sentinel_t<R>,
                           (sized_range<R> ||
                            sized_sentinel_for<sentinel_t<R>, iterator_t<R>>)
                               ? subrange_kind::sized
                               : subrange_kind::unsized>;

template <borrowed_range R>
subrange(R &&, detail::make_unsigned_like_t<range_difference_t<R>>)
    -> subrange<iterator_t<R>, sentinel_t<R>, subrange_kind::sized>;

template <size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
  requires((Index == 0 && copyable<Iterator>) || Index == 1)
[[nodiscard]]
constexpr auto get(const subrange<Iterator, Sentinel, Kind> &value) {
  if constexpr (Index == 0) {
    return value.begin();
  } else {
    return value.end();
  }
}

template <size_t Index, class Iterator, class Sentinel, subrange_kind Kind>
  requires(Index < 2)
[[nodiscard]]
constexpr auto get(subrange<Iterator, Sentinel, Kind> &&value) {
  if constexpr (Index == 0) {
    return value.begin();
  } else {
    return value.end();
  }
}

template <class Iterator, class Sentinel, subrange_kind Kind>
inline constexpr bool
    enable_borrowed_range<subrange<Iterator, Sentinel, Kind>> = true;

template <range R>
using borrowed_subrange_t =
    conditional_t<borrowed_range<R>, subrange<iterator_t<R>>, dangling>;

