take_is_empty_view_v =
    take_is_empty_view<T>::value;


template<class T>
struct take_is_subrange
    : false_type
{
};

template<
    class Iterator,
    class Sentinel,
    subrange_kind Kind
>
struct take_is_subrange<
    subrange<Iterator, Sentinel, Kind>
> : true_type
{
};

template<class T>
inline constexpr bool
take_is_subrange_v =
    take_is_subrange<T>::value;


template<class T>
struct take_is_iota_view
    : false_type
{
};

template<class W, class Bound>
struct take_is_iota_view<
    iota_view<W, Bound>
> : true_type
{
};

template<class T>
inline constexpr bool
take_is_iota_view_v =
    take_is_iota_view<T>::value;


template<
    viewable_range R,
    class Count
>
    requires convertible_to<
        Count,
        range_difference_t<R>
    >
[[nodiscard]]
constexpr auto apply_take(
    R&& range,
    Count&& count
)
{
    using raw_range =
        remove_cvref_t<R>;

    using difference_type =
        range_difference_t<R>;

    const difference_type requested =
        static_cast<difference_type>(
            static_cast<Count&&>(count)
        );

    if constexpr (
        take_is_empty_view_v<raw_range>
    )
    {
        return static_cast<R&&>(range);
    }
    else if constexpr (
        take_is_subrange_v<raw_range> &&
        random_access_range<raw_range> &&
        sized_range<raw_range>
    )
    {
        const difference_type distance =
            static_cast<difference_type>(
                ranges::distance(range)
            );

        const difference_type length =
            distance < requested
                ? distance
                : requested;

        auto first =
            ranges::begin(range);

        return subrange<iterator_t<R>>(
            first,
            first + length
        );
    }
    else if constexpr (
        take_is_iota_view_v<raw_range> &&
        random_access_range<raw_range> &&
        sized_range<raw_range>
    )
    {
        const difference_type distance =
            static_cast<difference_type>(
                ranges::distance(range)
            );

        const difference_type length =
            distance < requested
                ? distance
                : requested;

        auto first =
            ranges::begin(range);

        return iota_view(
            *first,
            *(first + length)
        );
    }
    else
    {
        using base_type =
            all_t<R>;

        return take_view<base_type>(
            all(static_cast<R&&>(range)),
            requested
        );
    }
}


template<class Count>
class take_closure
    : public range_adaptor_closure<
        take_closure<Count>
    >
{
private:
    FTL_NO_UNIQUE_ADDRESS
    Count count_;

public:
    constexpr explicit take_closure(
        Count count
    )
        : count_(
            static_cast<Count&&>(count)
        )
    {
    }

    template<viewable_range R>
        requires convertible_to<
            const Count&,
            range_difference_t<R>
        >
    [[nodiscard]]
    constexpr auto operator()(
        R&& range
    ) const&
    {
        return apply_take(
            static_cast<R&&>(range),
            count_
        );
    }

    template<viewable_range R>
        requires convertible_to<
            Count,
            range_difference_t<R>
        >
    [[nodiscard]]
    constexpr auto operator()(
        R&& range
    ) &&
    {
        return apply_take(
            static_cast<R&&>(range),
            static_cast<Count&&>(count_)
        );
    }
};

} // namespace detail



struct take_fn
{
    template<
        viewable_range R,
        class Count
    >
        requires convertible_to<
            Count,
            range_difference_t<R>
        >
    [[nodiscard]]
    constexpr auto operator()(
        R&& range,
        Count&& count
    ) const
    {
        return detail::apply_take(
            static_cast<R&&>(range),
            static_cast<Count&&>(count)
        );
    }

    template<class Count>
        requires constructible_from<
            decay_t<Count>,
            Count
        >
    [[nodiscard]]
    constexpr auto operator()(
        Count&& count
    ) const
    {
        using stored_type =
            decay_t<Count>;

        return detail::take_closure<
            stored_type
        >(
            stored_type(
                static_cast<Count&&>(count)
            )
        );
    }
};

inline constexpr take_fn take{};

