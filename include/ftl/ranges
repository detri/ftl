  using reference = range_reference_t<R>;

  reference operator*() const;

  pointer operator->() const;

  to_input_iterator &operator++();

  to_input_iterator operator++(int);

  bool operator==(const to_input_iterator &) const;
};

template <template <class...> class C, class R, class... Args>
auto to_deduce_container(int) -> decltype(C(declval<R>(), declval<Args>()...));

template <template <class...> class C, class R, class... Args>
auto to_deduce_container(long)
    -> decltype(C(from_range, declval<R>(), declval<Args>()...));

template <template <class...> class C, class R, class... Args>
auto to_deduce_container(...)
    -> decltype(C(declval<to_input_iterator<R>>(),
                  declval<to_input_iterator<R>>(), declval<Args>()...));

template <template <class...> class C, class R, class... Args>
using to_deduced_container_t = decltype(to_deduce_container<C, R, Args...>(0));

} // namespace detail

template <class C, input_range R, class... Args>
  requires(!view<C>)
constexpr C to(R &&range, Args &&...args) {
  static_assert(is_class_v<C> && same_as<C, remove_cv_t<C>>,
                "ranges::to requires a cv-unqualified class type");

  if constexpr (!input_range<C>) {
    return detail::to_nonrecursive<C>(static_cast<R &&>(range),
                                      static_cast<Args &&>(args)...);
  } else if constexpr (convertible_to<range_reference_t<R>, range_value_t<C>>) {
    return detail::to_nonrecursive<C>(static_cast<R &&>(range),
                                      static_cast<Args &&>(args)...);
  } else if constexpr (input_range<range_reference_t<R>>) {
    auto converted = views::transform(
        ref_view(range), []<class Element>(Element &&element) constexpr {
          return FTL_RANGES_NAMESPACE::ranges::to<range_value_t<C>>(
              static_cast<Element &&>(element));
        });

    return FTL_RANGES_NAMESPACE::ranges::to<C>(
        FTL_RANGES_NAMESPACE::move(converted), static_cast<Args &&>(args)...);
  } else {
    static_assert(detail::to_dependent_false<C, R, Args...>,
                  "ranges::to cannot recursively convert "
                  "the source range");
  }
}

template <template <class...> class C, input_range R, class... Args>
constexpr auto to(R &&range, Args &&...args) {
  using result_type = detail::to_deduced_container_t<C, R, Args...>;

  return FTL_RANGES_NAMESPACE::ranges::to<result_type>(
      static_cast<R &&>(range), static_cast<Args &&>(args)...);
}

namespace detail {

template <class C> struct to_type_fn {
  template <input_range R, class... Args>
  constexpr C operator()(R &&range, Args &&...args) const {
    return FTL_RANGES_NAMESPACE::ranges::to<C>(static_cast<R &&>(range),
                                               static_cast<Args &&>(args)...);
  }
};

template <template <class...> class C> struct to_template_fn {
  template <input_range R, class... Args>
  constexpr auto operator()(R &&range, Args &&...args) const {
    return FTL_RANGES_NAMESPACE::ranges::to<C>(static_cast<R &&>(range),
                                               static_cast<Args &&>(args)...);
  }
};

} // namespace detail

template <class C, class... Args>
  requires(!view<C>)
constexpr auto to(Args &&...args) {
  static_assert(is_class_v<C> && same_as<C, remove_cv_t<C>>,
                "ranges::to requires a cv-unqualified class type");

  return detail::partial_adaptor<detail::to_type_fn<C>>(
      static_cast<Args &&>(args)...);
}

template <template <class...> class C, class... Args>
constexpr auto to(Args &&...args) {
  return detail::partial_adaptor<detail::to_template_fn<C>>(
      static_cast<Args &&>(args)...);
}

} // namespace ranges

