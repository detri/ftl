template<
    view V,
    class Pred
>
    requires (
        input_range<V> &&
        is_object_v<Pred> &&
        indirect_unary_predicate<
            Pred,
            iterator_t<V>
        >
    )
class filter_view<V, Pred>::iterator
    : public detail::filter_iterator_category<V>
{
private:
    iterator_t<V> current_;

    filter_view* parent_ = nullptr;

public:
    using iterator_concept =
        conditional_t<
            bidirectional_range<V>,
            bidirectional_iterator_tag,
            conditional_t<
                forward_range<V>,
                forward_iterator_tag,
                input_iterator_tag
            >
        >;

    using value_type =
        range_value_t<V>;

    using difference_type =
        range_difference_t<V>;

    iterator()
        requires default_initializable<
            iterator_t<V>
        >
        = default;

    constexpr iterator(
        filter_view& parent,
        iterator_t<V> current
    )
        : current_(
            FTL_RANGES_NAMESPACE::move(
                current
            )
        ),
          parent_(
            FTL_RANGES_NAMESPACE::addressof(
                parent
            )
        )
    {
    }

    [[nodiscard]]
    constexpr const iterator_t<V>&
    base() const& noexcept
    {
        return current_;
    }

    [[nodiscard]]
    constexpr iterator_t<V>
    base() &&
    {
        return FTL_RANGES_NAMESPACE::move(
            current_
        );
    }

    [[nodiscard]]
    constexpr range_reference_t<V>
    operator*() const
    {
        return *current_;
    }

    [[nodiscard]]
    constexpr iterator_t<V>
    operator->() const
        requires (
            detail::filter_has_arrow<
                iterator_t<V>
            > &&
            copyable<
                iterator_t<V>
            >
        )
    {
        return current_;
    }

    constexpr iterator&
    operator++()
    {
        ++current_;

        const auto bound =
            ranges::end(parent_->base_);

        while (
            current_ != bound &&
            !FTL_RANGES_NAMESPACE::invoke(
                *parent_->pred_,
                *current_
            )
        )
        {
            ++current_;
        }

        return *this;
    }

    constexpr void
    operator++(int)
    {
        ++*this;
    }

    constexpr iterator
    operator++(int)
        requires forward_range<V>
    {
        auto previous = *this;
        ++*this;
        return previous;
    }

    constexpr iterator&
    operator--()
        requires bidirectional_range<V>
    {
        do
        {
            --current_;
        }
        while (
            !FTL_RANGES_NAMESPACE::invoke(
                *parent_->pred_,
                *current_
            )
        );

        return *this;
    }

    constexpr iterator
    operator--(int)
        requires bidirectional_range<V>
    {
        auto previous = *this;
        --*this;
        return previous;
    }

    friend constexpr bool operator==(
        const iterator& left,
        const iterator& right
    )
        requires equality_comparable<
            iterator_t<V>
        >
    {
        return left.current_ == right.current_;
    }

    friend constexpr bool operator!=(
        const iterator& left,
        const iterator& right
    )
        requires equality_comparable<
            iterator_t<V>
        >
    {
        return !(left == right);
    }
};

template<
    view V,
    class Pred
>
    requires (
        input_range<V> &&
        is_object_v<Pred> &&
        indirect_unary_predicate<
            Pred,
            iterator_t<V>
        >
    )
class filter_view<V, Pred>::sentinel
{
private:
    sentinel_t<V> end_ =
        sentinel_t<V>();

public:
    sentinel() = default;

    constexpr explicit sentinel(
        filter_view& parent
    )
        : end_(
            ranges::end(parent.base_)
        )
    {
    }

    [[nodiscard]]
    constexpr sentinel_t<V>
    base() const
    {
        return end_;
    }

    friend constexpr bool operator==(
        const iterator& value,
        const sentinel& bound
    )
    {
        return value.base() == bound.end_;
    }

    friend constexpr bool operator==(
        const sentinel& bound,
        const iterator& value
    )
    {
        return value == bound;
    }

    friend constexpr bool operator!=(
        const iterator& value,
        const sentinel& bound
    )
    {
        return !(value == bound);
    }

    friend constexpr bool operator!=(
        const sentinel& bound,
        const iterator& value
    )
    {
        return !(bound == value);
    }
};

template<
    view V,
    class Pred
>
    requires (
        input_range<V> &&
        is_object_v<Pred> &&
        indirect_unary_predicate<
            Pred,
            iterator_t<V>
        >
    )
constexpr auto
filter_view<V, Pred>::begin()
    -> iterator
{
    if constexpr (forward_range<V>)
    {
        auto& cached =
            cache_.cached_begin;

        if (!cached.has_value())
        {
            auto current =
                ranges::begin(base_);

            const auto bound =
                ranges::end(base_);

            while (
                current != bound &&
                !FTL_RANGES_NAMESPACE::invoke(
                    *pred_,
                    *current
                )
            )
            {
                ++current;
            }

            cached.emplace(
                FTL_RANGES_NAMESPACE::move(
                    current
                )
            );
        }

        return iterator(
            *this,
            *cached
        );
    }
    else
    {
        auto current =
            ranges::begin(base_);

        const auto bound =
            ranges::end(base_);

        while (
            current != bound &&
            !FTL_RANGES_NAMESPACE::invoke(
                *pred_,
                *current
            )
        )
        {
            ++current;
        }

        return iterator(
            *this,
            FTL_RANGES_NAMESPACE::move(
                current
            )
        );
    }
}


template<
    view V,
    class Pred
>
    requires (
        input_range<V> &&
        is_object_v<Pred> &&
        indirect_unary_predicate<
            Pred,
            iterator_t<V>
        >
    )
constexpr auto
filter_view<V, Pred>::end()
{
    if constexpr (common_range<V>)
    {
        return iterator(
            *this,
            ranges::end(base_)
        );
    }
    else
    {
        return sentinel(*this);
    }
}

template<class R, class Pred>
filter_view(
    R&&,
    Pred
) -> filter_view<
    views::all_t<R>,
    Pred
>;

