// [range.adaptor.object]

template <class Derived>
  requires(is_object_v<Derived> && same_as<Derived, remove_cv_t<Derived>>)
class range_adaptor_closure {};

namespace detail {
template <class Derived, class Base>
  requires(!same_as<Derived, range_adaptor_closure<Base>>)
void range_adaptor_closure_base_of(const Derived &,
                                   const range_adaptor_closure<Base> &);

template <class T>
concept range_adaptor_closure_object = !range<T> && requires(const T &value) {
  detail::range_adaptor_closure_base_of(value, value);
};

template <class Left, class Right>
class range_adaptor_pipeline
    : public range_adaptor_closure<range_adaptor_pipeline<Left, Right>> {
private:
  FTL_NO_UNIQUE_ADDRESS Left left_;
  FTL_NO_UNIQUE_ADDRESS Right right_;

public:
  template <class L, class R>
    requires(constructible_from<Left, L &&> && constructible_from<Right, R &&>)
  constexpr explicit range_adaptor_pipeline(L &&left, R &&right) noexcept(
      is_nothrow_constructible_v<Left, L &&> &&
      is_nothrow_constructible_v<Right, R &&>)
      : left_(static_cast<L &&>(left)), right_(static_cast<R &&>(right)) {}

  template <class R>
  constexpr decltype(auto) operator()(R &&value) & noexcept(
      noexcept(declval<Right &>()(declval<Left &>()(declval<R &&>()))))
    requires requires(Left &left, Right &right, R &&range) {
      right(left(static_cast<R &&>(range)));
    }
  {
    return right_(left_(static_cast<R &&>(value)));
  }

  template <class R>
  constexpr decltype(auto) operator()(R &&value) const & noexcept(noexcept(
      declval<const Right &>()(declval<const Left &>()(declval<R &&>()))))
    requires requires(const Left &left, const Right &right, R &&range) {
      right(left(static_cast<R &&>(range)));
    }
  {
    return right_(left_(static_cast<R &&>(value)));
  }

  template <class R>
  constexpr decltype(auto) operator()(R &&value) && noexcept(
      noexcept(declval<Right &&>()(declval<Left &&>()(declval<R &&>()))))
    requires requires(Left &&left, Right &&right, R &&range) {
      static_cast<Right &&>(right)(
          static_cast<Left &&>(left)(static_cast<R &&>(range)));
    }
  {
    return static_cast<Right &&>(right_)(
        static_cast<Left &&>(left_)(static_cast<R &&>(value)));
  }

  template <class R>
  constexpr decltype(auto) operator()(R &&value) const && noexcept(noexcept(
      declval<const Right &&>()(declval<const Left &&>()(declval<R &&>()))))
    requires requires(const Left &&left, const Right &&right, R &&range) {
      static_cast<const Right &&>(right)(
          static_cast<const Left &&>(left)(static_cast<R &&>(range)));
    }
  {
    return static_cast<const Right &&>(right_)(
        static_cast<const Left &&>(left_)(static_cast<R &&>(value)));
  }
};

template <class Adaptor, class Range, class... Args>
concept adaptor_invocable = requires(Range &&range, Args &&...args) {
  Adaptor{}(static_cast<Range &&>(range), static_cast<Args &&>(args)...);
};

template <class Adaptor, class... Args>
class range_adaptor_partial
    : public range_adaptor_closure<range_adaptor_partial<Adaptor, Args...>> {
private:
  FTL_NO_UNIQUE_ADDRESS tuple<Args...> arguments_;

  template <class Self, class R, size_t... Index>
  static constexpr decltype(auto) apply_to(Self &&self, R &&range,
                                           index_sequence<Index...>) {
    return Adaptor{}(static_cast<R &&>(range),
                     FTL_RANGES_NAMESPACE::get<Index>(
                         static_cast<Self &&>(self).arguments_)...);
  }

public:
  template <class... Values>
    requires(sizeof...(Values) == sizeof...(Args) &&
             (constructible_from<Args, Values &&> && ...))
  constexpr explicit range_adaptor_partial(Values &&...values) noexcept(
      (is_nothrow_constructible_v<Args, Values &&> && ...))
      : arguments_(static_cast<Values &&>(values)...) {}

  template <class R>
    requires adaptor_invocable<Adaptor, R, Args &...>
  constexpr decltype(auto) operator()(R &&range) & {
    return apply_to(*this, static_cast<R &&>(range),
                    index_sequence_for<Args...>{});
  }

  template <class R>
    requires adaptor_invocable<Adaptor, R, const Args &...>
  constexpr decltype(auto) operator()(R &&range) const & {
    return apply_to(*this, static_cast<R &&>(range),
                    index_sequence_for<Args...>{});
  }

  template <class R>
    requires adaptor_invocable<Adaptor, R, Args...>
  constexpr decltype(auto) operator()(R &&range) && {
    return apply_to(FTL_RANGES_NAMESPACE::move(*this), static_cast<R &&>(range),
                    index_sequence_for<Args...>{});
  }

  template <class R>
    requires adaptor_invocable<Adaptor, R, const Args...>
  constexpr decltype(auto) operator()(R &&range) const && {
    return apply_to(FTL_RANGES_NAMESPACE::move(*this), static_cast<R &&>(range),
                    index_sequence_for<Args...>{});
  }
};

template <class Adaptor, class... Args>
[[nodiscard]]
constexpr auto partial_adaptor(Args &&...args) {
  return range_adaptor_partial<Adaptor, decay_t<Args>...>(
      static_cast<Args &&>(args)...);
}
} // namespace detail

template <class Range, class Closure>
  requires(range<remove_cvref_t<Range>> &&
           detail::range_adaptor_closure_object<remove_cvref_t<Closure>> &&
           invocable<Closure, Range>)
[[nodiscard]]
constexpr decltype(auto) operator|(Range &&value, Closure &&closure) noexcept(
    noexcept(static_cast<Closure &&>(closure)(static_cast<Range &&>(value)))) {
  return static_cast<Closure &&>(closure)(static_cast<Range &&>(value));
}

template <class Left, class Right>
  requires(detail::range_adaptor_closure_object<remove_cvref_t<Left>> &&
           detail::range_adaptor_closure_object<remove_cvref_t<Right>> &&
           constructible_from<decay_t<Left>, Left> &&
           constructible_from<decay_t<Right>, Right>)
[[nodiscard]]
constexpr auto operator|(Left &&left, Right &&right) noexcept(
    noexcept(detail::range_adaptor_pipeline<decay_t<Left>, decay_t<Right>>(
        static_cast<Left &&>(left), static_cast<Right &&>(right)))) {
  return detail::range_adaptor_pipeline<decay_t<Left>, decay_t<Right>>(
      static_cast<Left &&>(left), static_cast<Right &&>(right));
}

// [range.move.wrap] and the non-propagating cache

namespace detail {
template <class T, bool = is_trivially_destructible_v<T>>
struct optional_storage {
  union {
    unsigned char empty_;
    T value_;
  };

  bool engaged_ = false;

  constexpr optional_storage() noexcept : empty_() {}

  constexpr ~optional_storage() {
    if (engaged_) {
      value_.~T();
    }
  }
};

template <class T> struct optional_storage<T, true> {
  union {
    unsigned char empty_;
    T value_;
  };

  bool engaged_ = false;

  constexpr optional_storage() noexcept : empty_() {}
};

template <class T>
concept boxable = move_constructible<T> && is_object_v<T>;

template <class T>
concept box_stores_value_directly =
    (copy_constructible<T> &&
     (copyable<T> || (is_nothrow_move_constructible_v<T> &&
                      is_nothrow_copy_constructible_v<T>))) ||
    (!copy_constructible<T> &&
     (movable<T> || is_nothrow_move_constructible_v<T>));

/*
 * movable-box: wraps a merely move-constructible object so that views
 * holding it stay movable, and copyable when the wrapped type is.
 */
template <boxable T> class movable_box {
private:
  optional_storage<T> storage_;

  constexpr void destroy() noexcept {
    if (storage_.engaged_) {
      storage_.value_.~T();
      storage_.engaged_ = false;
    }
  }

  template <class... Args> constexpr void construct(Args &&...args) {
    FTL_RANGES_NAMESPACE::construct_at(
        FTL_RANGES_NAMESPACE::addressof(storage_.value_),
        static_cast<Args &&>(args)...);
    storage_.engaged_ = true;
  }

public:
  constexpr movable_box() noexcept(is_nothrow_default_constructible_v<T>)
    requires default_initializable<T>
  {
    construct();
  }

  template <class... Args>
    requires constructible_from<T, Args...>
  constexpr explicit movable_box(in_place_t, Args &&...args) noexcept(
      is_nothrow_constructible_v<T, Args...>) {
    construct(static_cast<Args &&>(args)...);
  }

  constexpr explicit movable_box(const T &value)
    requires copy_constructible<T>
  {
    construct(value);
  }

  constexpr explicit movable_box(T &&value) {
    construct(FTL_RANGES_NAMESPACE::move(value));
  }

  constexpr movable_box(const movable_box &other)
    requires copy_constructible<T>
  {
    if (other.storage_.engaged_) {
      construct(other.storage_.value_);
    }
  }

  constexpr movable_box(movable_box &&other) noexcept(
      is_nothrow_move_constructible_v<T>) {
    if (other.storage_.engaged_) {
      construct(FTL_RANGES_NAMESPACE::move(other.storage_.value_));
    }
  }

  constexpr ~movable_box() { destroy(); }

  constexpr movable_box &operator=(const movable_box &other)
    requires copy_constructible<T>
  {
    if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
      if constexpr (copyable<T>) {
        if (storage_.engaged_ && other.storage_.engaged_) {
          storage_.value_ = other.storage_.value_;
          return *this;
        }
      }

      destroy();

      if (other.storage_.engaged_) {
        construct(other.storage_.value_);
      }
    }

    return *this;
  }

  constexpr movable_box &
  operator=(movable_box &&other) noexcept(is_nothrow_move_constructible_v<T>) {
    if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
      if constexpr (movable<T>) {
        if (storage_.engaged_ && other.storage_.engaged_) {
          storage_.value_ = FTL_RANGES_NAMESPACE::move(other.storage_.value_);
          return *this;
        }
      }

      destroy();

      if (other.storage_.engaged_) {
        construct(FTL_RANGES_NAMESPACE::move(other.storage_.value_));
      }
    }

    return *this;
  }

  [[nodiscard]]
  constexpr bool has_value() const noexcept {
    return storage_.engaged_;
  }

  [[nodiscard]]
  constexpr T &operator*() noexcept {
    return storage_.value_;
  }

  [[nodiscard]]
  constexpr const T &operator*() const noexcept {
    return storage_.value_;
  }

  [[nodiscard]]
  constexpr T *operator->() noexcept {
    return FTL_RANGES_NAMESPACE::addressof(storage_.value_);
  }

  [[nodiscard]]
  constexpr const T *operator->() const noexcept {
    return FTL_RANGES_NAMESPACE::addressof(storage_.value_);
  }
};

template <boxable T>
  requires box_stores_value_directly<T>
class movable_box<T> {
private:
  FTL_NO_UNIQUE_ADDRESS T value_ = T();

public:
  movable_box()
    requires default_initializable<T>
  = default;

  template <class... Args>
    requires constructible_from<T, Args...>
  constexpr explicit movable_box(in_place_t, Args &&...args) noexcept(
      is_nothrow_constructible_v<T, Args...>)
      : value_(static_cast<Args &&>(args)...) {}

  constexpr explicit movable_box(const T &value)
    requires copy_constructible<T>
      : value_(value) {}

  constexpr explicit movable_box(T &&value)
      : value_(FTL_RANGES_NAMESPACE::move(value)) {}

  movable_box(const movable_box &) = default;

  movable_box(movable_box &&) = default;

  constexpr movable_box &operator=(const movable_box &other) noexcept(
      is_nothrow_copy_constructible_v<T>)
    requires copy_constructible<T>
  {
    if constexpr (copyable<T>) {
      if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
        value_ = other.value_;
      }
    } else {
      if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
        FTL_RANGES_NAMESPACE::destroy_at(
            FTL_RANGES_NAMESPACE::addressof(value_));
        FTL_RANGES_NAMESPACE::construct_at(
            FTL_RANGES_NAMESPACE::addressof(value_), other.value_);
      }
    }

    return *this;
  }

  constexpr movable_box &
  operator=(movable_box &&other) noexcept(is_nothrow_move_constructible_v<T>) {
    if constexpr (movable<T>) {
      if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
        value_ = FTL_RANGES_NAMESPACE::move(other.value_);
      }
    } else {
      if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
        FTL_RANGES_NAMESPACE::destroy_at(
            FTL_RANGES_NAMESPACE::addressof(value_));
        FTL_RANGES_NAMESPACE::construct_at(
            FTL_RANGES_NAMESPACE::addressof(value_),
            FTL_RANGES_NAMESPACE::move(other.value_));
      }
    }

    return *this;
  }

  [[nodiscard]]
  constexpr bool has_value() const noexcept {
    return true;
  }

  [[nodiscard]]
  constexpr T &operator*() noexcept {
    return value_;
  }

  [[nodiscard]]
  constexpr const T &operator*() const noexcept {
    return value_;
  }

  [[nodiscard]]
  constexpr T *operator->() noexcept {
    return FTL_RANGES_NAMESPACE::addressof(value_);
  }

  [[nodiscard]]
  constexpr const T *operator->() const noexcept {
    return FTL_RANGES_NAMESPACE::addressof(value_);
  }
};

/*
 * non-propagating-cache: caching state that is deliberately reset by
 * copy and move so that views stay semantically value-like.
 */
template <class T, bool = default_initializable<T> && movable<T>>
  requires is_object_v<T>
class non_propagating_cache {
  optional_storage<T> storage_;

public:
  constexpr non_propagating_cache() noexcept = default;

  constexpr non_propagating_cache(const non_propagating_cache &) noexcept {}

  constexpr non_propagating_cache(non_propagating_cache &&other) noexcept {
    other.reset();
  }

  constexpr ~non_propagating_cache() = default;

  constexpr non_propagating_cache &
  operator=(const non_propagating_cache &other) noexcept {
    if (this != FTL_RANGES_NAMESPACE::addressof(other))
      reset();
    return *this;
  }

  constexpr non_propagating_cache &
  operator=(non_propagating_cache &&other) noexcept {
    reset();
    other.reset();
    return *this;
  }

  constexpr bool has_value() const noexcept { return storage_.engaged_; }

  constexpr T &operator*() noexcept { return storage_.value_; }

  constexpr const T &operator*() const noexcept { return storage_.value_; }

  constexpr void reset() noexcept {
    if (storage_.engaged_) {
      storage_.value_.~T();
      storage_.engaged_ = false;
    }
  }

  template <class... Args>
    requires constructible_from<T, Args...>
  constexpr T &emplace(Args &&...args) {
    reset();
    FTL_RANGES_NAMESPACE::construct_at(
        FTL_RANGES_NAMESPACE::addressof(storage_.value_),
        static_cast<Args &&>(args)...);
    storage_.engaged_ = true;
    return storage_.value_;
  }

  template <class Iterator>
  constexpr T &emplace_deref(const Iterator &iterator) {
    reset();
    ::new (static_cast<void *>(
        FTL_RANGES_NAMESPACE::addressof(storage_.value_))) T(*iterator);
    storage_.engaged_ = true;
    return storage_.value_;
  }
};

template <class T> class non_propagating_cache<T, true> {
private:
  T value_{};
  bool engaged_ = false;

public:
  constexpr non_propagating_cache() noexcept = default;

  constexpr non_propagating_cache(const non_propagating_cache &) noexcept {}

  constexpr non_propagating_cache(non_propagating_cache &&other) noexcept {
    other.reset();
  }

  constexpr ~non_propagating_cache() = default;

  constexpr non_propagating_cache &
  operator=(const non_propagating_cache &other) noexcept {
    if (this != FTL_RANGES_NAMESPACE::addressof(other)) {
      reset();
    }

    return *this;
  }

  constexpr non_propagating_cache &
  operator=(non_propagating_cache &&other) noexcept {
    reset();
    other.reset();
    return *this;
  }

  [[nodiscard]]
  constexpr bool has_value() const noexcept {
    return engaged_;
  }

  [[nodiscard]]
  constexpr T &operator*() noexcept {
    return value_;
  }

  [[nodiscard]]
  constexpr const T &operator*() const noexcept {
    return value_;
  }

  constexpr void reset() noexcept { engaged_ = false; }

  template <class... Args>
    requires constructible_from<T, Args...>
  constexpr T &emplace(Args &&...args) {
    value_ = T(static_cast<Args &&>(args)...);
    engaged_ = true;
    return value_;
  }

  template <class Iterator>
  constexpr T &emplace_deref(const Iterator &iterator) {
    value_ = T(*iterator);
    engaged_ = true;
    return value_;
  }
};
