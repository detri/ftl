    is_reverse_view<T>::value;


template<class T>
struct reversed_subrange_traits
    : false_type
{
};

template<class Iterator, subrange_kind Kind>
struct reversed_subrange_traits<
    subrange<
        reverse_iterator<Iterator>,
        reverse_iterator<Iterator>,
        Kind
    >
> : true_type
{
    using iterator_type = Iterator;

    static constexpr subrange_kind kind = Kind;
};

template<class T>
inline constexpr bool is_reversed_subrange_v =
    reversed_subrange_traits<T>::value;

} // namespace detail

namespace views
{

struct reverse_fn
    : range_adaptor_closure<reverse_fn>
{
    // views::reverse(reverse_view<V>) -> V

    template<class R>
        requires (
            detail::is_reverse_view_v<
                remove_cvref_t<R>
            > &&
            requires(R&& value)
            {
                static_cast<R&&>(value).base();
            }
        )
    [[nodiscard]]
    constexpr auto operator()(R&& range) const
    {
        return static_cast<R&&>(range).base();
    }


    // views::reverse(
    //     subrange<
    //         reverse_iterator<I>,
    //         reverse_iterator<I>,
    //         K
    //     >
    // ) -> subrange<I, I, K>

    template<class R>
        requires detail::is_reversed_subrange_v<
            remove_cvref_t<R>
        >
    [[nodiscard]]
    constexpr auto operator()(R&& range) const
    {
        using traits =
            detail::reversed_subrange_traits<
                remove_cvref_t<R>
            >;

        using iterator_type =
            typename traits::iterator_type;

        constexpr subrange_kind kind =
            traits::kind;

        if constexpr (
            kind == subrange_kind::sized
        )
        {
            return subrange<
                iterator_type,
                iterator_type,
                kind
            >(
                range.end().base(),
                range.begin().base(),
                range.size()
            );
        }
        else
        {
            return subrange<
                iterator_type,
                iterator_type,
                kind
            >(
                range.end().base(),
                range.begin().base()
            );
        }
    }


    // Ordinary range -> reverse_view<views::all_t<R>>

    template<class R>
        requires (
            !detail::is_reverse_view_v<
                remove_cvref_t<R>
            > &&
            !detail::is_reversed_subrange_v<
                remove_cvref_t<R>
            > &&
            viewable_range<R> &&
            bidirectional_range<all_t<R>>
        )
    [[nodiscard]]
    constexpr auto operator()(R&& range) const
    {
        using base_type = all_t<R>;

        return reverse_view<base_type>(
            all(static_cast<R&&>(range))
        );
    }
};

inline constexpr reverse_fn reverse{};

