concept drop_simple_view = take_simple_view<T>;

template <class V, bool = forward_range<V> &&
                          !(random_access_range<V> && sized_range<V>)>
struct drop_cache {};

template <class V> struct drop_cache<V, true> {
  non_propagating_cache<iterator_t<V>> cached_begin;
};
