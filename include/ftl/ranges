template<input_range V> requires view<V>
class stride_view : public view_interface<stride_view<V>> {
    V base_ = V();
    range_difference_t<V> stride_ = 1;
public:
    class iterator {
        iterator_t<V> current_{};
        sentinel_t<V> end_{};
        range_difference_t<V> stride_ = 1;
        range_difference_t<V> missing_ = 0;
    public:
        using iterator_concept = conditional_t<random_access_range<V>, random_access_iterator_tag,
            conditional_t<bidirectional_range<V>, bidirectional_iterator_tag,
            conditional_t<forward_range<V>, forward_iterator_tag, input_iterator_tag>>>;
        using iterator_category = iterator_concept;
        using value_type = range_value_t<V>;
        using difference_type = range_difference_t<V>;
        iterator() = default;
        constexpr iterator(iterator_t<V> current, sentinel_t<V> end, difference_type stride,
            difference_type missing = 0)
            : current_(FTL_RANGES_NAMESPACE::move(current)), end_(FTL_RANGES_NAMESPACE::move(end)),
              stride_(stride), missing_(missing) {}
        template<class Other>
            requires (!same_as<remove_cvref_t<Other>, iterator>) &&
                constructible_from<iterator_t<V>, decltype(declval<const Other&>().base())> &&
                constructible_from<sentinel_t<V>, decltype(declval<const Other&>().end_base())>
        constexpr iterator(const Other& other)
            : current_(other.base()), end_(other.end_base()), stride_(other.stride()), missing_(other.missing()) {}
        constexpr decltype(auto) operator*() const { return *current_; }
        constexpr iterator& operator++() {
            missing_ = ranges::advance(current_, stride_, end_);
            return *this;
        }
        constexpr auto operator++(int) {
            if constexpr (forward_range<V>) { auto copy = *this; ++*this; return copy; }
            else ++*this;
        }
        constexpr iterator& operator--() requires bidirectional_range<V> {
            ranges::advance(current_, missing_ - stride_);
