namespace detail {
template <class T>
concept repeat_integer_like_with_usable_difference_type =
    signed_integral<T> ||
    (integral<T> && !same_as<remove_cv_t<T>, bool> && weakly_incrementable<T>);

template <class Bound>
using repeat_index_t =
    conditional_t<same_as<Bound, unreachable_sentinel_t>, ptrdiff_t, Bound>;

template <class Bound>
using repeat_difference_t =
    conditional_t<signed_integral<repeat_index_t<Bound>>, repeat_index_t<Bound>,
                  iota_diff_t<repeat_index_t<Bound>>>;
} // namespace detail

template <move_constructible W, semiregular Bound = unreachable_sentinel_t>
  requires(is_object_v<W> && same_as<W, remove_cv_t<W>> &&
           (detail::repeat_integer_like_with_usable_difference_type<Bound> ||
            same_as<Bound, unreachable_sentinel_t>))
class repeat_view : public view_interface<repeat_view<W, Bound>> {
private:
  FTL_NO_UNIQUE_ADDRESS
  detail::movable_box<W> value_;

  FTL_NO_UNIQUE_ADDRESS
  Bound bound_ = Bound();

  class iterator {
  private:
    using index_type = detail::repeat_index_t<Bound>;

    const W *value_ = nullptr;
    index_type current_ = index_type();

    constexpr explicit iterator(const W *value,
                                index_type current = index_type())
        : value_(value), current_(current) {}

    friend class repeat_view;

  public:
    using iterator_concept = random_access_iterator_tag;

    using iterator_category = random_access_iterator_tag;

    using value_type = W;

    using difference_type = detail::repeat_difference_t<Bound>;

    iterator() = default;

    [[nodiscard]]
    constexpr const W &operator*() const noexcept {
      return *value_;
    }

    constexpr iterator &operator++() {
      ++current_;
      return *this;
    }

    constexpr iterator operator++(int) {
      auto previous = *this;
      ++*this;
      return previous;
    }

    constexpr iterator &operator--() {
      --current_;
      return *this;
    }

    constexpr iterator operator--(int) {
      auto previous = *this;
      --*this;
      return previous;
    }

    constexpr iterator &operator+=(difference_type offset) {
      current_ += offset;
      return *this;
    }

    constexpr iterator &operator-=(difference_type offset) {
      current_ -= offset;
      return *this;
    }

    [[nodiscard]]
    constexpr const W &operator[](difference_type offset) const noexcept {
      return *(*this + offset);
    }

    friend constexpr bool operator==(const iterator &left,
                                     const iterator &right) {
      return left.current_ == right.current_;
    }

    friend constexpr strong_ordering
    operator<=>(const iterator &left, const iterator &right) noexcept {
      if (left.current_ < right.current_) {
        return strong_ordering::less;
      }

      if (left.current_ > right.current_) {
        return strong_ordering::greater;
      }

      return strong_ordering::equal;
    }

    friend constexpr iterator operator+(iterator value,
                                        difference_type offset) {
      value += offset;
      return value;
    }

    friend constexpr iterator operator+(difference_type offset,
                                        iterator value) {
      value += offset;
      return value;
    }

    friend constexpr iterator operator-(iterator value,
                                        difference_type offset) {
      value -= offset;
      return value;
    }

    friend constexpr difference_type operator-(const iterator &left,
                                               const iterator &right) {
      return static_cast<difference_type>(left.current_) -
             static_cast<difference_type>(right.current_);
    }
  };

public:
  repeat_view()
    requires default_initializable<W>
  = default;

  constexpr explicit repeat_view(const W &value, Bound bound = Bound())
    requires copy_constructible<W>
      : value_(value), bound_(bound) {}

  constexpr explicit repeat_view(W &&value, Bound bound = Bound())
      : value_(FTL_RANGES_NAMESPACE::move(value)), bound_(bound) {}

  template <class... WArgs, class... BoundArgs>
    requires(constructible_from<W, WArgs...> &&
             constructible_from<Bound, BoundArgs...>)
  constexpr explicit repeat_view(
      piecewise_construct_t, tuple<WArgs...> value_arguments,
      tuple<BoundArgs...> bound_arguments = tuple<>())
      : value_(FTL_RANGES_NAMESPACE::make_from_tuple<W>(
            FTL_RANGES_NAMESPACE::move(value_arguments))),
        bound_(FTL_RANGES_NAMESPACE::make_from_tuple<Bound>(
            FTL_RANGES_NAMESPACE::move(bound_arguments))) {}

  [[nodiscard]]
  constexpr iterator begin() const {
    return iterator(FTL_RANGES_NAMESPACE::addressof(*value_));
  }

  [[nodiscard]]
  constexpr iterator end() const
    requires(!same_as<Bound, unreachable_sentinel_t>)
  {
    return iterator(FTL_RANGES_NAMESPACE::addressof(*value_), bound_);
  }

  [[nodiscard]]
  constexpr unreachable_sentinel_t end() const noexcept {
    return unreachable_sentinel;
  }

  [[nodiscard]]
  constexpr auto size() const
    requires(!same_as<Bound, unreachable_sentinel_t>)
  {
    return detail::iota_to_unsigned_like(bound_);
  }
};

template <class W, class Bound> repeat_view(W, Bound) -> repeat_view<W, Bound>;

namespace detail {
template <class Base, bool = forward_range<Base>>
struct stride_iterator_category {};

template <class Base> struct stride_iterator_category<Base, true> {
private:
  using base_category =
      typename iterator_traits<iterator_t<Base>>::iterator_category;

public:
  using iterator_category =
      conditional_t<derived_from<base_category, random_access_iterator_tag>,
                    random_access_iterator_tag, base_category>;
};
