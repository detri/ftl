template<view V>
class drop_view
    : public view_interface<drop_view<V>>
{
private:
    FTL_NO_UNIQUE_ADDRESS
    V base_ = V();

    range_difference_t<V> count_ = 0;

    FTL_NO_UNIQUE_ADDRESS
    detail::drop_cache<V> cache_{};

public:
    drop_view()
        requires default_initializable<V>
        = default;

    constexpr explicit drop_view(
        V base,
        range_difference_t<V> count
    )
        : base_(FTL_RANGES_NAMESPACE::move(base)),
          count_(count)
    {
    }

    [[nodiscard]]
    constexpr V base() const&
        requires copy_constructible<V>
    {
        return base_;
    }

    [[nodiscard]]
    constexpr V base() &&
    {
        return FTL_RANGES_NAMESPACE::move(base_);
    }

    [[nodiscard]]
    constexpr auto begin()
        requires (
            !(
                detail::drop_simple_view<V> &&
                random_access_range<const V> &&
                sized_range<const V>
            )
        )
    {
        if constexpr (
            random_access_range<V> &&
            sized_range<V>
        )
        {
            return ranges::next(
                ranges::begin(base_),
                count_,
                ranges::end(base_)
            );
        }
        else if constexpr (forward_range<V>)
        {
            auto& cached =
                cache_.cached_begin;

            if (!cached.has_value())
            {
                cached.emplace(
                    ranges::next(
                        ranges::begin(base_),
                        count_,
                        ranges::end(base_)
                    )
                );
            }

            return *cached;
        }
        else
        {
            return ranges::next(
                ranges::begin(base_),
                count_,
                ranges::end(base_)
            );
        }
    }

    [[nodiscard]]
    constexpr auto begin() const
        requires (
            random_access_range<const V> &&
            sized_range<const V>
        )
    {
        return ranges::next(
            ranges::begin(base_),
            static_cast<
                range_difference_t<const V>
            >(count_),
            ranges::end(base_)
        );
    }

    [[nodiscard]]
    constexpr auto end()
        requires (!detail::drop_simple_view<V>)
    {
        return ranges::end(base_);
    }

    [[nodiscard]]
    constexpr auto end() const
        requires range<const V>
    {
        return ranges::end(base_);
    }

    [[nodiscard]]
    constexpr auto size()
        requires sized_range<V>
    {
        const auto base_size =
            ranges::size(base_);

        const auto count =
            static_cast<decltype(base_size)>(
                count_
            );

        return base_size < count
            ? decltype(base_size){0}
            : base_size - count;
    }

    [[nodiscard]]
    constexpr auto size() const
        requires sized_range<const V>
    {
        const auto base_size =
            ranges::size(base_);

        const auto count =
            static_cast<decltype(base_size)>(
                count_
            );

        return base_size < count
            ? decltype(base_size){0}
            : base_size - count;
    }
};


