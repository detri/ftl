inline constexpr bool enable_borrowed_range<drop_view<V>> =
    enable_borrowed_range<V>;

namespace views {
namespace detail {
template <class RawRange> struct drop_apply {
  template <viewable_range R, class Count>
    requires convertible_to<Count, range_difference_t<R>>
  [[nodiscard]]
  static constexpr auto call(R &&range, Count &&count) {
    using base_type = all_t<R>;

    using difference_type = range_difference_t<R>;

    return drop_view<base_type>(
        all(static_cast<R &&>(range)),
        static_cast<difference_type>(static_cast<Count &&>(count)));
  }
};

template <class T> struct drop_apply<empty_view<T>> {
  template <class R, class Count>
  [[nodiscard]]
  static constexpr empty_view<T> call(R &&, Count &&) noexcept {
    return {};
  }
};

template <class W, class Bound> struct drop_apply<iota_view<W, Bound>> {
  using raw_range = iota_view<W, Bound>;

  template <viewable_range R, class Count>
    requires convertible_to<Count, range_difference_t<R>>
  [[nodiscard]]
  static constexpr auto call(R &&range, Count &&count) {
    if constexpr (random_access_range<raw_range> && sized_range<raw_range>) {
      using difference_type = range_difference_t<R>;

      const difference_type distance =
          static_cast<difference_type>(ranges::distance(range));

      const difference_type requested =
          static_cast<difference_type>(static_cast<Count &&>(count));

      const difference_type offset =
          distance < requested ? distance : requested;

      auto first = ranges::begin(range);

      auto last = ranges::end(range);

      return raw_range(first + offset, last);
    } else {
      using base_type = all_t<R>;

      using difference_type = range_difference_t<R>;

      return drop_view<base_type>(
          all(static_cast<R &&>(range)),
          static_cast<difference_type>(static_cast<Count &&>(count)));
    }
  }
};

template <input_or_output_iterator Iterator, sentinel_for<Iterator> Sentinel,
          subrange_kind Kind>
  requires(Kind == subrange_kind::sized ||
           !sized_sentinel_for<Sentinel, Iterator>)
struct drop_apply<subrange<Iterator, Sentinel, Kind>> {
  using raw_range = subrange<Iterator, Sentinel, Kind>;

  static constexpr bool stores_size =
      Kind == subrange_kind::sized && !sized_sentinel_for<Sentinel, Iterator>;

  template <viewable_range R, class Count>
    requires convertible_to<Count, range_difference_t<R>>
  [[nodiscard]]
  static constexpr auto call(R &&range, Count &&count) {
    if constexpr (random_access_range<raw_range> && sized_range<raw_range>) {
      using difference_type = range_difference_t<R>;

      const difference_type distance =
          static_cast<difference_type>(ranges::distance(range));

      const difference_type requested =
          static_cast<difference_type>(static_cast<Count &&>(count));

      const difference_type offset =
          distance < requested ? distance : requested;

      auto first = ranges::begin(range);

      auto last = ranges::end(range);

      if constexpr (stores_size) {
        return raw_range(first + offset, last,
                         ranges::detail::to_unsigned_like(distance - offset));
      } else {
        return raw_range(first + offset, last);
      }
    } else {
      using base_type = all_t<R>;

      using difference_type = range_difference_t<R>;

      return drop_view<base_type>(
          all(static_cast<R &&>(range)),
          static_cast<difference_type>(static_cast<Count &&>(count)));
    }
  }
};

template <viewable_range R, class Count>
  requires convertible_to<Count, range_difference_t<R>>
[[nodiscard]]
constexpr auto apply_drop(R &&range, Count &&count) {
  using raw_range = remove_cvref_t<R>;

  return drop_apply<raw_range>::call(static_cast<R &&>(range),
                                     static_cast<Count &&>(count));
}
} // namespace detail

struct drop_fn {
  template <viewable_range R, class Count>
    requires convertible_to<Count, range_difference_t<R>>
  [[nodiscard]]
  constexpr auto operator()(R &&range, Count &&count) const {
    return detail::apply_drop(static_cast<R &&>(range),
                              static_cast<Count &&>(count));
  }

  template <class Count>
    requires constructible_from<decay_t<Count>, Count>
  [[nodiscard]]
  constexpr auto operator()(Count &&count) const {
    using stored_type = decay_t<Count>;

    return FTL_RANGES_NAMESPACE::ranges::detail::partial_adaptor<drop_fn>(
        static_cast<Count &&>(count));
  }
};

inline constexpr drop_fn drop{};
} // namespace views

