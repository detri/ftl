template<view V>
class take_view
    : public view_interface<take_view<V>>
{
private:
    FTL_NO_UNIQUE_ADDRESS
    V base_ = V();

    range_difference_t<V> count_ = 0;

    template<bool Const>
    class sentinel;

public:
    take_view()
        requires default_initializable<V>
        = default;

    constexpr explicit take_view(
        V base,
        range_difference_t<V> count
    )
        : base_(static_cast<V&&>(base)),
          count_(count)
    {
    }

    [[nodiscard]]
    constexpr V base() const&
        requires copy_constructible<V>
    {
        return base_;
    }

    [[nodiscard]]
    constexpr V base() &&
    {
        return static_cast<V&&>(base_);
    }

    [[nodiscard]]
    constexpr auto begin()
        requires (!detail::take_simple_view<V>)
    {
        if constexpr (sized_range<V>)
        {
            if constexpr (random_access_range<V>)
            {
                return ranges::begin(base_);
            }
            else
            {
                using difference_type =
                    range_difference_t<V>;

                const auto length =
                    static_cast<difference_type>(
                        size()
                    );

                return counted_iterator<
                    iterator_t<V>
                >(
                    ranges::begin(base_),
                    length
                );
            }
        }
        else if constexpr (
            sized_sentinel_for<
                sentinel_t<V>,
                iterator_t<V>
            >
        )
        {
            auto iterator =
                ranges::begin(base_);

            const auto available =
                ranges::end(base_) - iterator;

            const auto length =
                available < count_
                    ? available
                    : count_;

            return counted_iterator<
                iterator_t<V>
            >(
                static_cast<
                    iterator_t<V>&&
                >(iterator),
                length
            );
        }
        else
        {
            return counted_iterator<
                iterator_t<V>
            >(
                ranges::begin(base_),
                count_
            );
        }
    }

    [[nodiscard]]
    constexpr auto begin() const
        requires range<const V>
    {
        if constexpr (sized_range<const V>)
        {
            if constexpr (
                random_access_range<const V>
            )
            {
                return ranges::begin(base_);
            }
            else
            {
                using difference_type =
                    range_difference_t<const V>;

                const auto length =
                    static_cast<difference_type>(
                        size()
                    );

                return counted_iterator<
                    iterator_t<const V>
                >(
                    ranges::begin(base_),
                    length
                );
            }
        }
        else if constexpr (
            sized_sentinel_for<
                sentinel_t<const V>,
                iterator_t<const V>
            >
        )
        {
            using difference_type =
                range_difference_t<const V>;

            auto iterator =
                ranges::begin(base_);

            const auto available =
                ranges::end(base_) - iterator;

            const auto requested =
                static_cast<difference_type>(
                    count_
                );

            const auto length =
                available < requested
                    ? available
                    : requested;

            return counted_iterator<
                iterator_t<const V>
            >(
                static_cast<
                    iterator_t<const V>&&
                >(iterator),
                length
            );
        }
        else
        {
            return counted_iterator<
                iterator_t<const V>
            >(
                ranges::begin(base_),
                static_cast<
                    range_difference_t<const V>
                >(count_)
            );
        }
    }

    [[nodiscard]]
    constexpr auto end()
        requires (!detail::take_simple_view<V>)
    {
        if constexpr (sized_range<V>)
        {
            if constexpr (random_access_range<V>)
            {
                return ranges::begin(base_) +
                    static_cast<
                        range_difference_t<V>
                    >(size());
            }
            else
            {
                return default_sentinel;
            }
        }
        else if constexpr (
            sized_sentinel_for<
                sentinel_t<V>,
                iterator_t<V>
            >
        )
        {
            return default_sentinel;
        }
        else
        {
            return sentinel<false>{
                ranges::end(base_)
            };
        }
    }

    [[nodiscard]]
    constexpr auto end() const
        requires range<const V>
    {
        if constexpr (sized_range<const V>)
        {
            if constexpr (
                random_access_range<const V>
            )
            {
                return ranges::begin(base_) +
                    static_cast<
                        range_difference_t<const V>
                    >(size());
            }
            else
            {
                return default_sentinel;
            }
        }
        else if constexpr (
            sized_sentinel_for<
                sentinel_t<const V>,
                iterator_t<const V>
            >
        )
        {
            return default_sentinel;
        }
        else
        {
            return sentinel<true>{
                ranges::end(base_)
            };
        }
    }

    [[nodiscard]]
    constexpr auto size()
        requires sized_range<V>
    {
        auto base_size =
            ranges::size(base_);

        const auto requested =
            static_cast<decltype(base_size)>(
                count_
            );

        return base_size < requested
            ? base_size
            : requested;
    }

    [[nodiscard]]
    constexpr auto size() const
        requires sized_range<const V>
    {
        auto base_size =
            ranges::size(base_);

        const auto requested =
            static_cast<decltype(base_size)>(
                count_
            );

        return base_size < requested
            ? base_size
            : requested;
    }
};


template<view V>
template<bool Const>
class take_view<V>::sentinel
{
private:
    using Base =
        conditional_t<
            Const,
            const V,
            V
        >;

    template<bool OtherConst>
    using CountedIterator =
        counted_iterator<
            iterator_t<
                conditional_t<
                    OtherConst,
                    const V,
                    V
                >
            >
        >;

    FTL_NO_UNIQUE_ADDRESS
    sentinel_t<Base> end_ =
        sentinel_t<Base>();

    template<bool>
    friend class sentinel;

public:
    sentinel() = default;

    constexpr explicit sentinel(
        sentinel_t<Base> end
    )
        : end_(
            static_cast<
                sentinel_t<Base>&&
            >(end)
        )
    {
    }

    constexpr sentinel(
        sentinel<!Const> other
    )
        requires (
            Const &&
            convertible_to<
                sentinel_t<V>,
                sentinel_t<Base>
            >
        )
        : end_(
            static_cast<
                sentinel_t<V>&&
            >(other.end_)
        )
    {
    }

    [[nodiscard]]
    constexpr sentinel_t<Base> base() const
    {
        return end_;
    }

    friend constexpr bool operator==(
        const CountedIterator<Const>& iterator,
        const sentinel& bound
    )
    {
        return
            iterator.count() == 0 ||
            iterator.base() == bound.end_;
    }

    friend constexpr bool operator==(
        const sentinel& bound,
        const CountedIterator<Const>& iterator
    )
    {
        return iterator == bound;
    }

    friend constexpr bool operator!=(
        const CountedIterator<Const>& iterator,
        const sentinel& bound
    )
    {
        return !(iterator == bound);
    }

    friend constexpr bool operator!=(
        const sentinel& bound,
        const CountedIterator<Const>& iterator
    )
    {
        return !(bound == iterator);
    }

    template<bool OtherConst = !Const>
        requires sentinel_for<
            sentinel_t<Base>,
            iterator_t<
                conditional_t<
                    OtherConst,
                    const V,
                    V
                >
            >
        >
    friend constexpr bool operator==(
        const CountedIterator<OtherConst>& iterator,
        const sentinel& bound
    )
    {
        return
            iterator.count() == 0 ||
            iterator.base() == bound.end_;
    }

    template<bool OtherConst = !Const>
        requires sentinel_for<
            sentinel_t<Base>,
            iterator_t<
                conditional_t<
                    OtherConst,
                    const V,
                    V
                >
            >
        >
    friend constexpr bool operator==(
        const sentinel& bound,
        const CountedIterator<OtherConst>& iterator
    )
    {
        return iterator == bound;
    }

    template<bool OtherConst = !Const>
        requires sentinel_for<
            sentinel_t<Base>,
            iterator_t<
                conditional_t<
                    OtherConst,
                    const V,
                    V
                >
            >
        >
    friend constexpr bool operator!=(
        const CountedIterator<OtherConst>& iterator,
        const sentinel& bound
    )
    {
        return !(iterator == bound);
    }

    template<bool OtherConst = !Const>
        requires sentinel_for<
            sentinel_t<Base>,
            iterator_t<
                conditional_t<
                    OtherConst,
                    const V,
                    V
                >
            >
        >
    friend constexpr bool operator!=(
        const sentinel& bound,
        const CountedIterator<OtherConst>& iterator
    )
    {
        return !(bound == iterator);
    }
};


