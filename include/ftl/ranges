    using function_type = decay_t<F>;

    using base_type = all_t<R>;

    return forward_range<base_type> && move_constructible<function_type> &&
           is_object_v<function_type> && constructible_from<function_type, F> &&
           FTL_RANGES_NAMESPACE::ranges::detail::adjacent_transformable<
               function_type, base_type, N>;
  }
