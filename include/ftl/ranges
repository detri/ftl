        return lazy_split_view<all_t<R>, all_t<P>>(
            all(static_cast<R&&>(range)), all(static_cast<P&&>(pattern)));
    }
    template<viewable_range R, class T>
        requires (!viewable_range<T>) && constructible_from<range_value_t<R>, T> &&
            requires { lazy_split_view<all_t<R>, single_view<range_value_t<R>>>(
                all(declval<R>()), single_view<range_value_t<R>>(declval<range_value_t<R>>())); }
    constexpr auto operator()(R&& range, T&& element) const {
        return lazy_split_view<all_t<R>, single_view<range_value_t<R>>>(
            all(static_cast<R&&>(range)),
            single_view<range_value_t<R>>(range_value_t<R>(static_cast<T&&>(element))));
    }
    template<class P> requires constructible_from<decay_t<P>, P>
    constexpr auto operator()(P&& pattern) const {
        return FTL_RANGES_NAMESPACE::ranges::detail::partial_adaptor<lazy_split_fn>(static_cast<P&&>(pattern));
    }
};
