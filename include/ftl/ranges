template<
    input_or_output_iterator Iterator,
    sentinel_for<Iterator> Sentinel,
    subrange_kind Kind
>
    requires (
        Kind == subrange_kind::sized ||
        !sized_sentinel_for<
            Sentinel,
            Iterator
        >
    )
struct drop_apply<
    subrange<
        Iterator,
        Sentinel,
        Kind
    >
>
{
    using raw_range =
        subrange<
            Iterator,
            Sentinel,
            Kind
        >;

    static constexpr bool stores_size =
        Kind == subrange_kind::sized &&
        !sized_sentinel_for<
            Sentinel,
            Iterator
        >;

    template<
        viewable_range R,
        class Count
    >
        requires convertible_to<
            Count,
            range_difference_t<R>
        >
    [[nodiscard]]
    static constexpr auto call(
        R&& range,
        Count&& count
    )
    {
        if constexpr (
            random_access_range<raw_range> &&
            sized_range<raw_range>
        )
        {
            using difference_type =
                range_difference_t<R>;

            const difference_type distance =
                static_cast<difference_type>(
                    ranges::distance(range)
                );

            const difference_type requested =
                static_cast<difference_type>(
                    static_cast<Count&&>(count)
                );

            const difference_type offset =
                distance < requested
                    ? distance
                    : requested;

            auto first =
                ranges::begin(range);

            auto last =
                ranges::end(range);

            if constexpr (stores_size)
            {
                return raw_range(
                    first + offset,
                    last,
                    ranges::detail::to_unsigned_like(
                        distance - offset
                    )
                );
            }
            else
            {
                return raw_range(
                    first + offset,
                    last
                );
            }
        }
        else
        {
