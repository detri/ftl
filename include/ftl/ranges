  cartesian_product_view()
    requires default_initializable<First> &&
                 (default_initializable<Views> && ...)
  = default;

  constexpr explicit cartesian_product_view(First first, Views... views)
      : views_(FTL_RANGES_NAMESPACE::move(first),
               FTL_RANGES_NAMESPACE::move(views)...) {}

  constexpr iterator<false> begin() {
    return [&]<size_t... I>(index_sequence<I...>) {
      auto current = tuple<iterator_t<First>, iterator_t<Views>...>(
          ranges::begin(get<I>(views_))...);

      const bool done =
          ((get<I>(current) == ranges::end(get<I>(views_))) || ...);

      return iterator<false>(*this, FTL_RANGES_NAMESPACE::move(current), done);
    }(make_index_sequence<count>{});
  }

  constexpr iterator<true> begin() const
    requires input_range<const First> && (forward_range<const Views> && ...)
  {
    return [&]<size_t... I>(index_sequence<I...>) {
      auto current = tuple<iterator_t<const First>, iterator_t<const Views>...>(
          ranges::begin(get<I>(views_))...);

      const bool done =
          ((get<I>(current) == ranges::end(get<I>(views_))) || ...);

      return iterator<true>(*this, FTL_RANGES_NAMESPACE::move(current), done);
    }(make_index_sequence<count>{});
  }

  constexpr iterator<false> end()
    requires detail::cartesian_product_common_argument<First>
  {
    return [&]<size_t... I>(index_sequence<I...>) {
      auto current = tuple<iterator_t<First>, iterator_t<Views>...>(
          detail::cartesian_product_common_argument_end(get<0>(views_)),
          ranges::begin(get<I + 1>(views_))...);

      using result_iterator = iterator<false>;

      using difference_type = typename result_iterator::difference_type;

      difference_type position = 0;

      if constexpr (same_as<typename result_iterator::iterator_concept,
                            random_access_iterator_tag>) {
        position =
            static_cast<difference_type>(ranges::distance(get<0>(views_)));

        ((position *=
          static_cast<difference_type>(ranges::distance(get<I + 1>(views_)))),
         ...);
      }

      return result_iterator(*this, FTL_RANGES_NAMESPACE::move(current), true,
                             position);
    }(make_index_sequence<sizeof...(Views)>{});
  }

  constexpr iterator<true> end() const
    requires(input_range<const First> && (forward_range<const Views> && ...) &&
             detail::cartesian_product_common_argument<const First>)
  {
    return [&]<size_t... I>(index_sequence<I...>) {
      auto current = tuple<iterator_t<const First>, iterator_t<const Views>...>(
          detail::cartesian_product_common_argument_end(get<0>(views_)),
          ranges::begin(get<I + 1>(views_))...);

      using result_iterator = iterator<true>;

      using difference_type = typename result_iterator::difference_type;

      difference_type position = 0;

      if constexpr (same_as<typename result_iterator::iterator_concept,
                            random_access_iterator_tag>) {
        position =
            static_cast<difference_type>(ranges::distance(get<0>(views_)));

        ((position *=
          static_cast<difference_type>(ranges::distance(get<I + 1>(views_)))),
         ...);
      }

      return result_iterator(*this, FTL_RANGES_NAMESPACE::move(current), true,
                             position);
    }(make_index_sequence<sizeof...(Views)>{});
  }

  constexpr default_sentinel_t end() const noexcept { return {}; }

  constexpr auto size()
    requires sized_range<First> && (sized_range<Views> && ...)
  {
    return size_impl(make_index_sequence<count>{});
  }

  constexpr auto size() const
    requires sized_range<const First> && (sized_range<const Views> && ...)
  {
    return size_impl(make_index_sequence<count>{});
  }
