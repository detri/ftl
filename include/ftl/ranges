class view_base {};

namespace detail {

struct view_interface_marker {};

template<class T>
inline constexpr bool is_initializer_list_v = false;

template<class T>
inline constexpr bool is_initializer_list_v<initializer_list<T>> = true;

} // namespace detail

template<class Derived>
    requires (
        is_class_v<Derived> &&
        same_as<Derived, remove_cv_t<Derived>>
    )
class view_interface : public detail::view_interface_marker {
private:
    [[nodiscard]]
    constexpr Derived& derived() noexcept {
        return static_cast<Derived&>(*this);
    }

    [[nodiscard]]
    constexpr const Derived& derived() const noexcept {
        return static_cast<const Derived&>(*this);
    }

public:
    [[nodiscard]]
    constexpr bool empty()
        requires forward_range<Derived>
    {
        return ranges::begin(derived()) ==
               ranges::end(derived());
    }

    [[nodiscard]]
    constexpr bool empty() const
        requires forward_range<const Derived>
    {
        return ranges::begin(derived()) ==
               ranges::end(derived());
    }

    constexpr explicit operator bool()
        requires requires(Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    constexpr explicit operator bool() const
        requires requires(const Derived& value) {
            ranges::empty(value);
        }
    {
        return !ranges::empty(derived());
    }

    [[nodiscard]]
    constexpr auto data()
        requires contiguous_iterator<iterator_t<Derived>>
    {
        return ranges::data(derived());
    }

    [[nodiscard]]
    constexpr auto data() const
        requires contiguous_iterator<iterator_t<const Derived>>
    {
        return ranges::data(derived());
    }

    [[nodiscard]]
    constexpr auto size()
        requires (
            forward_range<Derived> &&
            sized_sentinel_for<
                sentinel_t<Derived>,
                iterator_t<Derived>
            >
        )
    {
        return ranges::end(derived()) -
               ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr auto size() const
        requires (
            forward_range<const Derived> &&
            sized_sentinel_for<
                sentinel_t<const Derived>,
                iterator_t<const Derived>
            >
        )
    {
        return ranges::end(derived()) -
               ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) front()
        requires forward_range<Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) front() const
        requires forward_range<const Derived>
    {
        return *ranges::begin(derived());
    }

    [[nodiscard]]
    constexpr decltype(auto) back()
        requires (
            bidirectional_range<Derived> &&
            common_range<Derived>
        )
    {
        auto last = ranges::end(derived());
        --last;
        return *last;
    }

    [[nodiscard]]
    constexpr decltype(auto) back() const
        requires (
            bidirectional_range<const Derived> &&
            common_range<const Derived>
        )
    {
        auto last = ranges::end(derived());
        --last;
        return *last;
    }

    template<random_access_range Range = Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) {
        return ranges::begin(derived())[index];
    }

    template<random_access_range Range = const Derived>
    [[nodiscard]]
    constexpr decltype(auto) operator[](
        range_difference_t<Range> index
    ) const {
        return ranges::begin(derived())[index];
    }
};

template<class T>
inline constexpr bool enable_view =
    derived_from<T, view_base> ||
    derived_from<T, detail::view_interface_marker>;

template<class T>
concept view =
    range<T> &&
    movable<T> &&
    enable_view<T>;

template<class T>
concept viewable_range =
    range<T> &&
    (
        (
            view<remove_cvref_t<T>> &&
            constructible_from<remove_cvref_t<T>, T>
        ) ||
        (
            !view<remove_cvref_t<T>> &&
            (
                is_lvalue_reference_v<T> ||
                (
                    movable<remove_reference_t<T>> &&
                    !detail::is_initializer_list_v<
                        remove_cvref_t<T>
                    >
                )
            )
        )
    );

// [range.ref.view]

template<range R>
    requires is_object_v<R>
class ref_view
    : public view_interface<ref_view<R>> {
private:
    template<class T>
    static void bindable_reference(T&) noexcept;

    template<class T>
    static void bindable_reference(T&&) = delete;

public:
    template<class T>
        requires (
            !same_as<remove_cvref_t<T>, ref_view> &&
            convertible_to<T, R&> &&
            requires {
                bindable_reference(declval<T>());
            }
        )
    constexpr ref_view(T&& value)
        noexcept(noexcept(
            static_cast<R&>(
                static_cast<T&&>(value)
            )
        ))
        : range_(
            addressof(
                static_cast<R&>(
                    static_cast<T&&>(value)
                )
            )
        ) {}

    [[nodiscard]]
    constexpr R& base() const noexcept {
        return *range_;
    }

    [[nodiscard]]
    constexpr iterator_t<R> begin() const {
        return ranges::begin(*range_);
    }

    [[nodiscard]]
    constexpr sentinel_t<R> end() const {
        return ranges::end(*range_);
    }

    [[nodiscard]]
    constexpr bool empty() const
        requires requires(R& value) {
            ranges::empty(value);
        }
    {
        return ranges::empty(*range_);
    }

    [[nodiscard]]
    constexpr auto size() const
        requires sized_range<R>
    {
        return ranges::size(*range_);
    }

    [[nodiscard]]
    constexpr auto data() const
        requires contiguous_iterator<iterator_t<R>>
    {
        return ranges::data(*range_);
    }

private:
    R* range_;
};

template<class R>
ref_view(R&) -> ref_view<R>;

template<class R>
inline constexpr bool enable_borrowed_range<ref_view<R>> =
    true;

// [range.owning.view]

template<range R>
    requires (
        movable<R> &&
        is_object_v<R>
    )
class owning_view
    : public view_interface<owning_view<R>> {
public:
    owning_view()
        requires default_initializable<R>
        = default;

    constexpr owning_view(R&& range)
        noexcept(is_nothrow_move_constructible_v<R>)
        : range_(static_cast<R&&>(range)) {}

    owning_view(owning_view&&) = default;
    owning_view& operator=(owning_view&&) = default;

    [[nodiscard]]
    constexpr R& base() & noexcept {
        return range_;
    }

    [[nodiscard]]
    constexpr const R& base() const& noexcept {
        return range_;
    }

    [[nodiscard]]
    constexpr R&& base() && noexcept {
        return static_cast<R&&>(range_);
    }

    [[nodiscard]]
    constexpr const R&& base() const&& noexcept {
        return static_cast<const R&&>(range_);
    }

    [[nodiscard]]
    constexpr iterator_t<R> begin() {
        return ranges::begin(range_);
    }

    [[nodiscard]]
    constexpr auto begin() const
        requires range<const R>
    {
        return ranges::begin(range_);
    }

    [[nodiscard]]
    constexpr sentinel_t<R> end() {
        return ranges::end(range_);
    }

    [[nodiscard]]
    constexpr auto end() const
        requires range<const R>
    {
        return ranges::end(range_);
    }

    [[nodiscard]]
    constexpr bool empty()
        requires requires(R& value) {
            ranges::empty(value);
        }
    {
        return ranges::empty(range_);
    }

    [[nodiscard]]
    constexpr bool empty() const
        requires requires(const R& value) {
            ranges::empty(value);
        }
    {
        return ranges::empty(range_);
    }

    [[nodiscard]]
    constexpr auto size()
        requires sized_range<R>
    {
        return ranges::size(range_);
    }

    [[nodiscard]]
    constexpr auto size() const
        requires sized_range<const R>
    {
        return ranges::size(range_);
    }

    [[nodiscard]]
    constexpr auto data()
        requires contiguous_iterator<iterator_t<R>>
    {
        return ranges::data(range_);
    }

    [[nodiscard]]
    constexpr auto data() const
        requires contiguous_iterator<iterator_t<const R>>
    {
        return ranges::data(range_);
    }

private:
    R range_ = R();
};

template<class R>
owning_view(R&&) -> owning_view<R>;

// [range.empty.view]

template<class T>
    requires is_object_v<T>
class empty_view
    : public view_interface<empty_view<T>> {
public:
    static constexpr T* begin() noexcept {
        return nullptr;
    }

    static constexpr T* end() noexcept {
        return nullptr;
    }

    static constexpr T* data() noexcept {
        return nullptr;
    }

    static constexpr size_t size() noexcept {
        return 0;
    }

    static constexpr bool empty() noexcept {
        return true;
    }
};

template<class T>
inline constexpr bool enable_borrowed_range<empty_view<T>> =
    true;

// [range.single.view]

template<class T>
    requires (
        copy_constructible<T> &&
        is_object_v<T>
    )
class single_view
    : public view_interface<single_view<T>> {
public:
    single_view()
        requires default_initializable<T>
        = default;

    constexpr explicit single_view(const T& value)
        noexcept(is_nothrow_copy_constructible_v<T>)
        : value_(value) {}

    constexpr explicit single_view(T&& value)
        noexcept(is_nothrow_move_constructible_v<T>)
        : value_(static_cast<T&&>(value)) {}

    template<class... Args>
        requires constructible_from<T, Args...>
    constexpr explicit single_view(
        in_place_t,
        Args&&... args
    )
        noexcept(
            is_nothrow_constructible_v<T, Args...>
        )
        : value_(
            static_cast<Args&&>(args)...
        ) {}

    [[nodiscard]]
    constexpr T* begin() noexcept {
        return addressof(value_);
    }

    [[nodiscard]]
    constexpr const T* begin() const noexcept {
        return addressof(value_);
    }

    [[nodiscard]]
    constexpr T* end() noexcept {
        return addressof(value_) + 1;
    }

    [[nodiscard]]
    constexpr const T* end() const noexcept {
        return addressof(value_) + 1;
    }

    [[nodiscard]]
    constexpr T* data() noexcept {
        return addressof(value_);
    }

    [[nodiscard]]
    constexpr const T* data() const noexcept {
        return addressof(value_);
    }

    static constexpr size_t size() noexcept {
        return 1;
    }

    static constexpr bool empty() noexcept {
        return false;
    }

private:
    T value_ = T();
};

template<class T>
single_view(T) -> single_view<T>;

// [range.all]

namespace views {

namespace detail {

template<class R>
concept can_ref_view =
    requires(R&& value) {
        ref_view{
            static_cast<R&&>(value)
        };
    };

template<class R>
concept can_owning_view =
    requires(R&& value) {
        owning_view{
            static_cast<R&&>(value)
        };
    };

struct all_fn {
    template<viewable_range R>
    [[nodiscard]]
    constexpr auto operator()(R&& range) const
        noexcept(
            []() consteval {
                if constexpr (
                    view<remove_cvref_t<R>>
                ) {
                    return is_nothrow_constructible_v<
                        remove_cvref_t<R>,
                        R
                    >;
                } else if constexpr (
                    can_ref_view<R>
                ) {
                    return noexcept(
                        ref_view{
                            declval<R>()
                        }
                    );
                } else {
                    return noexcept(
                        owning_view{
                            declval<R>()
                        }
                    );
                }
            }()
        )
    {
        if constexpr (
            view<remove_cvref_t<R>>
        ) {
            return remove_cvref_t<R>(
                static_cast<R&&>(range)
            );
        } else if constexpr (
            can_ref_view<R>
        ) {
            return ref_view{
                static_cast<R&&>(range)
            };
        } else {
            static_assert(can_owning_view<R>);

            return owning_view{
                static_cast<R&&>(range)
            };
        }
    }
};

struct single_fn {
    template<class T>
    [[nodiscard]]
    constexpr auto operator()(T&& value) const
        noexcept(
            is_nothrow_constructible_v<
                decay_t<T>,
                T
            >
        )
    {
        return single_view<decay_t<T>>(
            static_cast<T&&>(value)
        );
    }
};

} // namespace detail

inline constexpr detail::all_fn all{};

template<class R>
using all_t =
    decltype(all(declval<R>()));

template<class T>
inline constexpr empty_view<T> empty{};

inline constexpr detail::single_fn single{};

} // namespace views

} // namespace ranges

