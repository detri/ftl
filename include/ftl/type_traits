template<class T>
constexpr void swap(T&, T&)
    noexcept(is_nothrow_move_constructible_v<T> &&
             is_nothrow_move_assignable_v<T>)
    requires (is_move_constructible_v<T> && is_move_assignable_v<T>);

template<class T, class U>
struct is_swappable_with
    : bool_constant<requires(T&& left, U&& right) {
        swap(static_cast<T&&>(left), static_cast<U&&>(right));
        swap(static_cast<U&&>(right), static_cast<T&&>(left));
    }> {};

