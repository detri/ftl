struct is_nothrow_swappable_with
    : bool_constant<is_swappable_with_v<T, U> && requires(T&& left, U&& right) {
        requires noexcept(swap(static_cast<T&&>(left),
                               static_cast<U&&>(right)));
        requires noexcept(swap(static_cast<U&&>(right),
                               static_cast<T&&>(left)));
    }> {};

