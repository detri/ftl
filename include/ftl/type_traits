template<class From, class To>
struct copy_cv { using type = To; };
template<class From, class To>
struct copy_cv<const From, To> { using type = const To; };
template<class From, class To>
struct copy_cv<volatile From, To> { using type = volatile To; };
template<class From, class To>
struct copy_cv<const volatile From, To> { using type = const volatile To; };

template<class T>
struct xref {
    template<class U>
    using apply = typename copy_cv<remove_reference_t<T>, U>::type;
};
template<class T>
struct xref<T&> {
    template<class U>
    using apply = typename copy_cv<remove_reference_t<T>, U>::type&;
};
template<class T>
struct xref<T&&> {
    template<class U>
    using apply = typename copy_cv<remove_reference_t<T>, U>::type&&;
};

template<class T, class U, class = void>
struct common_ref {};

template<class From, class To>
inline constexpr bool convertible_intrinsic_v =
    bool(FTL_IS_CONVERTIBLE(From, To));

template<class T, class U>
using copy_cv12_t = typename copy_cv<T, typename copy_cv<U, T>::type>::type;

template<class T, class U>
using copy_cv21_t = typename copy_cv<U, typename copy_cv<T, U>::type>::type;

template<class T, class U>
using common_ref_cond_t = decltype(
    false
        ? declval<copy_cv12_t<T, U>&>()
        : declval<copy_cv21_t<T, U>&>()
);

template<class T, class U>
    requires is_reference_v<common_ref_cond_t<T, U>>
struct common_ref<
    T&,
    U&,
    void_t<common_ref_cond_t<T, U>>
> {
    using type = common_ref_cond_t<T, U>;
};

template<class T, class U>
using common_ref_rvalue_t =
    remove_reference_t<
        typename common_ref<T&, U&>::type
    >&&;

template<class T, class U>
    requires (
        convertible_intrinsic_v<
            T&&,
            common_ref_rvalue_t<T, U>
        > &&
        convertible_intrinsic_v<
            U&&,
            common_ref_rvalue_t<T, U>
        >
    )
struct common_ref<
    T&&,
    U&&,
    void_t<typename common_ref<T&, U&>::type>
> {
    using type = common_ref_rvalue_t<T, U>;
};

template<class T, class U>
    requires convertible_intrinsic_v<
                 T&&, typename common_ref<const T&, U&>::type>
struct common_ref<T&&, U&, void_t<typename common_ref<const T&, U&>::type>> {
    using type = typename common_ref<const T&, U&>::type;
};

template<class T, class U>
struct common_ref<T&, U&&> : common_ref<U&&, T&> {};

template<class T, class U>
concept has_common_ref = requires { typename common_ref<T, U>::type; };

template<class T, class U>
using basic_common_reference_t = typename basic_common_reference<
    remove_cvref_t<T>, remove_cvref_t<U>, xref<T>::template apply,
    xref<U>::template apply>::type;

template<class T, class U>
concept has_basic_common_reference = requires {
    typename basic_common_reference_t<T, U>;
};

template<class T, class U>
concept has_conditional_result = requires {
    typename type_identity<decltype(false ? declval<T>() : declval<U>())>::type;
};

template<class T, class U, bool = has_common_ref<T, U>,
         bool = has_basic_common_reference<T, U>,
         bool = has_conditional_result<T, U>>
struct common_reference_two : common_type<T, U> {};

template<class T, class U, bool HasBasic, bool HasConditional>
struct common_reference_two<T, U, true, HasBasic, HasConditional>
    : common_ref<T, U> {};

template<class T, class U, bool HasConditional>
struct common_reference_two<T, U, false, true, HasConditional> {
    using type = basic_common_reference_t<T, U>;
};

template<class T, class U>
struct common_reference_two<T, U, false, false, true> {
    using type = decltype(false ? declval<T>() : declval<U>());
};

