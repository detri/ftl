template<class T>
struct is_reference_wrapper : false_type {};

template<class T>
struct is_reference_wrapper<reference_wrapper<T>> : true_type {};

template<class F, class T, class... Args>
    requires is_member_function_pointer_v<decay_t<F>> &&
             is_base_of_v<typename member_pointer_class<decay_t<F>>::type,
                          decay_t<T>>
constexpr auto invoke(F&& function, T&& object, Args&&... args)
    noexcept(noexcept((static_cast<T&&>(object).*function)(
        static_cast<Args&&>(args)...)))
    -> decltype((static_cast<T&&>(object).*function)(
        static_cast<Args&&>(args)...)) {
    return (static_cast<T&&>(object).*function)(static_cast<Args&&>(args)...);
}

template<class F, class T, class... Args>
    requires is_member_function_pointer_v<decay_t<F>> &&
             is_reference_wrapper<decay_t<T>>::value
constexpr auto invoke(F&& function, T&& object, Args&&... args)
    noexcept(noexcept((object.get().*function)(static_cast<Args&&>(args)...)))
    -> decltype((object.get().*function)(static_cast<Args&&>(args)...)) {
    return (object.get().*function)(static_cast<Args&&>(args)...);
}

template<class F, class T, class... Args>
    requires is_member_function_pointer_v<decay_t<F>> &&
             (!is_base_of_v<typename member_pointer_class<decay_t<F>>::type,
                            decay_t<T>>) &&
             (!is_reference_wrapper<decay_t<T>>::value)
constexpr auto invoke(F&& function, T&& object, Args&&... args)
    noexcept(noexcept(((*static_cast<T&&>(object)).*function)(
        static_cast<Args&&>(args)...)))
    -> decltype(((*static_cast<T&&>(object)).*function)(
        static_cast<Args&&>(args)...)) {
    return ((*static_cast<T&&>(object)).*function)(static_cast<Args&&>(args)...);
}

template<class F, class T>
    requires is_member_object_pointer_v<decay_t<F>> &&
             is_base_of_v<typename member_pointer_class<decay_t<F>>::type,
                          decay_t<T>>
constexpr auto invoke(F&& member, T&& object) noexcept
    -> decltype(static_cast<T&&>(object).*member) {
    return static_cast<T&&>(object).*member;
}

template<class F, class T>
    requires is_member_object_pointer_v<decay_t<F>> &&
             is_reference_wrapper<decay_t<T>>::value
constexpr auto invoke(F&& member, T&& object) noexcept
    -> decltype(object.get().*member) {
    return object.get().*member;
}

template<class F, class T>
    requires is_member_object_pointer_v<decay_t<F>> &&
             (!is_base_of_v<typename member_pointer_class<decay_t<F>>::type,
                            decay_t<T>>) &&
             (!is_reference_wrapper<decay_t<T>>::value)
constexpr auto invoke(F&& member, T&& object)
    noexcept(noexcept((*static_cast<T&&>(object)).*member))
    -> decltype((*static_cast<T&&>(object)).*member) {
    return (*static_cast<T&&>(object)).*member;
}

template<class F, class... Args>
    requires (!is_member_pointer_v<decay_t<F>>)
constexpr auto invoke(F&& function, Args&&... args)
    noexcept(noexcept(static_cast<F&&>(function)(static_cast<Args&&>(args)...)))
    -> decltype(static_cast<F&&>(function)(static_cast<Args&&>(args)...)) {
    return static_cast<F&&>(function)(static_cast<Args&&>(args)...);
}

template<class, class F, class... Args>
struct invoke_result_impl {};

template<class F, class... Args>
struct invoke_result_impl<
    void_t<
        decltype(
            detail::invoke(
                declval<F>(),
                declval<Args>()...
            )
        )
    >,
    F,
    Args...
> {
    using type =
        decltype(
            detail::invoke(
                declval<F>(),
                declval<Args>()...
            )
        );
};
}

template<class F, class... Args>
struct invoke_result : detail::invoke_result_impl<void, F, Args...> {};

template<class F, class... Args>
using invoke_result_t = typename invoke_result<F, Args...>::type;

template<class F, class... Args>
struct is_invocable
    : bool_constant<requires { typename invoke_result_t<F, Args...>; }> {};

template<class F, class... Args>
inline constexpr bool is_invocable_v = is_invocable<F, Args...>::value;

template<class R, class F, class... Args>
struct is_invocable_r
    : bool_constant<[] consteval {
        if constexpr (!is_invocable_v<F, Args...>)
            return false;
        else if constexpr (is_void_v<R>)
            return true;
        else
            return requires {
                detail::convertible_sink<R>(detail::invoke(
                    declval<F>(), declval<Args>()...));
            };
    }()> {};

template<class R, class F, class... Args>
inline constexpr bool is_invocable_r_v = is_invocable_r<R, F, Args...>::value;

template<class F, class... Args>
struct is_nothrow_invocable
    : bool_constant<
          [] consteval
          {
              if constexpr (
                  !is_invocable_v<
                      F,
                      Args...
                  >
              )
              {
                  return false;
              }
              else
              {
                  return noexcept(
                      detail::invoke(
                          declval<F>(),
                          declval<Args>()...
                      )
                  );
              }
          }()
      >
{
};

template<class F, class... Args>
inline constexpr bool is_nothrow_invocable_v =
    is_nothrow_invocable<F, Args...>::value;

template<class R, class F, class... Args>
struct is_nothrow_invocable_r
    : bool_constant<[] consteval {
        if constexpr (!is_invocable_r_v<R, F, Args...>)
            return false;
        else if constexpr (is_void_v<R>)
            return noexcept(detail::invoke(declval<F>(), declval<Args>()...));
        else
            return noexcept(detail::convertible_sink<R>(detail::invoke(
                declval<F>(), declval<Args>()...)));
    }()> {};

template<class R, class F, class... Args>
inline constexpr bool is_nothrow_invocable_r_v =
    is_nothrow_invocable_r<R, F, Args...>::value;

namespace detail {
template<class Class>
union member_storage {
    char active;
    Class object;
    constexpr member_storage() : active{} {}
    constexpr ~member_storage() {}
};

template<class Class1, class Class2>
union corresponding_storage {
    char active;
    Class1 left;
    Class2 right;
    constexpr corresponding_storage() : active{} {}
    constexpr ~corresponding_storage() {}
};
}

template<class Class, class Member>
constexpr bool is_pointer_interconvertible_with_class(
    Member Class::* member) noexcept {
#if FTL_NATIVE_MSVC
    return __is_pointer_interconvertible_with_class(Class, member);
#elif __has_builtin(__builtin_is_pointer_interconvertible_with_class)
    return __builtin_is_pointer_interconvertible_with_class(member);
#else
    detail::member_storage<Class> storage;
    return static_cast<const volatile void*>(&storage.object) ==
           static_cast<const volatile void*>(&(storage.object.*member));
#endif
}

template<class Class1, class Class2, class Member1, class Member2>
constexpr bool is_corresponding_member(Member1 Class1::* left,
                                       Member2 Class2::* right) noexcept {
#if FTL_NATIVE_MSVC
    return __is_corresponding_member(Class1, Class2, left, right);
#elif __has_builtin(__builtin_is_corresponding_member)
    return __builtin_is_corresponding_member(left, right);
#else
#if FTL_HAS_IS_LAYOUT_COMPATIBLE
    if constexpr (!is_layout_compatible_v<Class1, Class2>)
        return false;
    else {
#endif
        detail::corresponding_storage<Class1, Class2> storage;
        return static_cast<const volatile void*>(&(storage.left.*left)) ==
               static_cast<const volatile void*>(&(storage.right.*right));
#if FTL_HAS_IS_LAYOUT_COMPATIBLE
    }
#endif
#endif
}

