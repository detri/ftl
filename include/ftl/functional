#define FTL_DETAIL_MOVE_ONLY_FUNCTION(Suffix, Qual, Cast, Q, Noex)             \
  template <class R, class... A> class move_only_function<R(A...) Suffix> {    \
    struct erased {                                                            \
      virtual ~erased() = default;                                             \
      virtual R call(A &&...) Qual noexcept(Noex) = 0;                         \
    };                                                                         \
    template <class F> struct model final : erased {                           \
      F value;                                                                 \
      template <class G>                                                       \
      explicit model(G &&object) : value(forward<G>(object)) {}                \
      R call(A &&...args) Qual noexcept(Noex) override {                       \
        return invoke_r<R>(Cast, forward<A>(args)...);                         \
      }                                                                        \
    };                                                                         \
    erased *target_ = nullptr;                                                 \
                                                                               \
  public:                                                                      \
    move_only_function() noexcept = default;                                   \
    move_only_function(nullptr_t) noexcept {}                                  \
    move_only_function(move_only_function &&other) noexcept                    \
        : target_(exchange(other.target_, nullptr)) {}                         \
    move_only_function(const move_only_function &) = delete;                   \
    template <class F>                                                         \
      requires(!is_same_v<remove_cvref_t<F>, move_only_function>) &&           \
              is_constructible_v<decay_t<F>, F> &&                             \
              is_invocable_r_v<R, detail::mof_call_t<decay_t<F>, Q>, A...> &&  \
              (!Noex ||                                                        \
               is_nothrow_invocable_r_v<R, detail::mof_call_t<decay_t<F>, Q>,  \
                                        A...>)                                 \
    move_only_function(F &&value) {                                            \
      using T = decay_t<F>;                                                    \
      if constexpr (is_pointer_v<T> || is_member_pointer_v<T>)                 \
        if (!value)                                                            \
          return;                                                              \
      target_ = new model<T>(forward<F>(value));                               \
    }                                                                          \
    ~move_only_function() { delete target_; }                                  \
    move_only_function &operator=(move_only_function &&other) noexcept {       \
      move_only_function(move(other)).swap(*this);                             \
      return *this;                                                            \
    }                                                                          \
    move_only_function &operator=(nullptr_t) noexcept {                        \
      delete target_;                                                          \
      target_ = nullptr;                                                       \
      return *this;                                                            \
    }                                                                          \
    template <class F> move_only_function &operator=(F &&value) {              \
      move_only_function(forward<F>(value)).swap(*this);                       \
      return *this;                                                            \
    }                                                                          \
    void swap(move_only_function &other) noexcept {                            \
      auto *value = target_;                                                   \
      target_ = other.target_;                                                 \
      other.target_ = value;                                                   \
    }                                                                          \
    explicit operator bool() const noexcept { return target_ != nullptr; }     \
    R operator()(A... args) Qual noexcept(Noex) {                              \
      return target_->call(forward<A>(args)...);                               \
    }                                                                          \
  };

FTL_DETAIL_MOVE_ONLY_FUNCTION(, , value, 0, false)
FTL_DETAIL_MOVE_ONLY_FUNCTION(noexcept, , value, 0, true)
FTL_DETAIL_MOVE_ONLY_FUNCTION(&, &, value, 0, false)
FTL_DETAIL_MOVE_ONLY_FUNCTION(& noexcept, &, value, 0, true)
FTL_DETAIL_MOVE_ONLY_FUNCTION(&&, &&, move(value), 1, false)
FTL_DETAIL_MOVE_ONLY_FUNCTION(&& noexcept, &&, move(value), 1, true)
FTL_DETAIL_MOVE_ONLY_FUNCTION(const, const, static_cast<const F &>(value), 2,
                              false)
