namespace detail {
template <size_t Index, class Tuple>
constexpr decltype(auto) bind_arg(Tuple &&arguments) {
  return get<Index>(forward<Tuple>(arguments));
}
template <class T, class Tuple>
constexpr decltype(auto) bind_resolve(T &value, Tuple &&arguments) {
  if constexpr (is_reference_wrapper_v<remove_cv_t<T>>)
    return value.get();
  else if constexpr (is_bind_expression_v<remove_cv_t<T>>)
    return apply(value, forward<Tuple>(arguments));
  else if constexpr (is_placeholder_v<remove_cv_t<T>> != 0)
    return bind_arg<is_placeholder_v<remove_cv_t<T>> - 1>(
        forward<Tuple>(arguments));
  else
    return static_cast<T &>(value);
}
template <class F, class... Bound> class bind_t {
  F function;
  tuple<Bound...> bound;
  template <class Self, class Tuple, size_t... I>
  static constexpr decltype(auto) call(Self &&self, Tuple &&args,
                                       index_sequence<I...>) {
    return invoke(forward<Self>(self).function,
                  bind_resolve(get<I>(forward<Self>(self).bound), args)...);
  }

public:
  template <class G, class... A>
  constexpr bind_t(G &&f, A &&...a)
      : function(forward<G>(f)), bound(forward<A>(a)...) {}
  template <class... A> constexpr decltype(auto) operator()(A &&...a) {
    auto args = forward_as_tuple(forward<A>(a)...);
    return call(*this, args, index_sequence_for<Bound...>{});
  }
  template <class... A> constexpr decltype(auto) operator()(A &&...a) const {
    auto args = forward_as_tuple(forward<A>(a)...);
    return call(*this, args, index_sequence_for<Bound...>{});
  }
};
} // namespace detail
template <class F, class... A> constexpr auto bind(F &&function, A &&...args) {
  return detail::bind_t<decay_t<F>, decay_t<A>...>(forward<F>(function),
                                                   forward<A>(args)...);
}
template <class R, class F, class... A>
constexpr auto bind(F &&function, A &&...args) {
  return bind(forward<F>(function), forward<A>(args)...);
}
template <class F, class... A>
struct is_bind_expression<detail::bind_t<F, A...>> : true_type {};

template <class Member> class mem_fn_t {
public:
  constexpr explicit mem_fn_t(Member value) noexcept : member(value) {}
  template <class... A>
  constexpr decltype(auto) operator()(A &&...args) const
      noexcept(is_nothrow_invocable_v<Member, A...>) {
    return invoke(member, forward<A>(args)...);
  }

private:
  Member member;
};
template <class R, class T> constexpr auto mem_fn(R T::*member) noexcept {
  return mem_fn_t<R T::*>(member);
}

