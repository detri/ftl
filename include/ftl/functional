namespace detail {
constexpr size_t rapid_hash_word(unsigned long long value) noexcept {
  return ftl_rapidhash::rapidhash_t<unsigned long long>{}(value);
}

inline size_t rapid_hash_object(const void *object, size_t length) noexcept {
  return static_cast<size_t>(ftl_rapidhash::rapidhash(object, length));
}
} // namespace detail

template <class T>
  requires(is_integral_v<T> || is_enum_v<T>)
struct hash<T> {
  constexpr size_t operator()(T value) const noexcept {
    return ftl_rapidhash::rapidhash_t<T>{}(value);
  }
};

template <class T> struct hash<T *> {
  size_t operator()(T *value) const noexcept {
    return detail::rapid_hash_object(&value, sizeof(value));
  }
};

template <> struct hash<nullptr_t> {
  constexpr size_t operator()(nullptr_t) const noexcept {
    return detail::rapid_hash_word(0);
  }
};

#define FTL_DETAIL_FLOAT_HASH(T)                                               \
  template <> struct hash<T> {                                                 \
    size_t operator()(T value) const noexcept {                                \
      if (value == static_cast<T>(0))                                          \
        return detail::rapid_hash_word(0);                                     \
      return detail::rapid_hash_object(&value, sizeof(value));                 \
    }                                                                          \
  }
