template <class T = void> struct less {
  constexpr bool operator()(const T &left, const T &right) const
      noexcept(noexcept(left < right)) {
    if constexpr (is_pointer_v<T>)
      return detail::pointer_total_less(left, right);
    else
      return left < right;
  }
};

template <> struct less<void> {
  using is_transparent = void;

  template <class T, class U>
    requires requires { typename common_type_t<T *, U *>; }
  constexpr bool operator()(T *left, U *right) const noexcept {
    return detail::pointer_total_less(left, right);
  }

  template <class T, class U>
  constexpr auto operator()(T &&left, U &&right) const
      noexcept(noexcept(forward<T>(left) < forward<U>(right)))
          -> decltype(forward<T>(left) < forward<U>(right)) {
    if constexpr (detail::uses_builtin_object_pointer_less_v<T, U>) {
      return detail::pointer_total_less(
          static_cast<const volatile void *>(forward<T>(left)),
          static_cast<const volatile void *>(forward<U>(right)));
    } else {
      return forward<T>(left) < forward<U>(right);
    }
  }
};

template <class T = void> struct greater {
  constexpr bool operator()(const T &left, const T &right) const
      noexcept(noexcept(left > right)) {
    if constexpr (is_pointer_v<T>)
      return detail::pointer_total_less(right, left);
    else
      return left > right;
  }
};

template <> struct greater<void> {
  using is_transparent = void;

  template <class T, class U>
    requires requires { typename common_type_t<T *, U *>; }
  constexpr bool operator()(T *left, U *right) const noexcept {
    return detail::pointer_total_less(right, left);
  }

  template <class T, class U>
  constexpr auto operator()(T &&left, U &&right) const
      noexcept(noexcept(forward<T>(left) > forward<U>(right)))
          -> decltype(forward<T>(left) > forward<U>(right)) {
    if constexpr (detail::uses_builtin_object_pointer_greater_v<T, U>) {
      return detail::pointer_total_less(
          static_cast<const volatile void *>(forward<U>(right)),
          static_cast<const volatile void *>(forward<T>(left)));
    } else {
      return forward<T>(left) > forward<U>(right);
    }
  }
};

template <class T = void> struct greater_equal {
  constexpr bool operator()(const T &left, const T &right) const
      noexcept(noexcept(left >= right)) {
    if constexpr (is_pointer_v<T>)
      return !detail::pointer_total_less(left, right);
    else
      return left >= right;
  }
};

template <> struct greater_equal<void> {
  using is_transparent = void;

  template <class T, class U>
    requires requires { typename common_type_t<T *, U *>; }
  constexpr bool operator()(T *left, U *right) const noexcept {
    return !detail::pointer_total_less(left, right);
  }

  template <class T, class U>
  constexpr auto operator()(T &&left, U &&right) const
      noexcept(noexcept(forward<T>(left) >= forward<U>(right)))
          -> decltype(forward<T>(left) >= forward<U>(right)) {
    if constexpr (detail::uses_builtin_object_pointer_greater_equal_v<T, U>) {
      return !detail::pointer_total_less(
          static_cast<const volatile void *>(forward<T>(left)),
          static_cast<const volatile void *>(forward<U>(right)));
    } else {
      return forward<T>(left) >= forward<U>(right);
    }
  }
};

template <class T = void> struct less_equal {
  constexpr bool operator()(const T &left, const T &right) const
      noexcept(noexcept(left <= right)) {
    if constexpr (is_pointer_v<T>)
      return !detail::pointer_total_less(right, left);
    else
      return left <= right;
  }
};

template <> struct less_equal<void> {
  using is_transparent = void;

  template <class T, class U>
    requires requires { typename common_type_t<T *, U *>; }
  constexpr bool operator()(T *left, U *right) const noexcept {
    return !detail::pointer_total_less(right, left);
  }

  template <class T, class U>
  constexpr auto operator()(T &&left, U &&right) const
      noexcept(noexcept(forward<T>(left) <= forward<U>(right)))
          -> decltype(forward<T>(left) <= forward<U>(right)) {
    if constexpr (detail::uses_builtin_object_pointer_less_equal_v<T, U>) {
      return !detail::pointer_total_less(
          static_cast<const volatile void *>(forward<U>(right)),
          static_cast<const volatile void *>(forward<T>(left)));
    } else {
      return forward<T>(left) <= forward<U>(right);
    }
  }
};

namespace ranges {

struct equal_to {
  using is_transparent = void;

  template <class T, class U>
    requires equality_comparable_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(static_cast<T &&>(left) ==
                        static_cast<U &&>(right))) {
    return static_cast<T &&>(left) ==
           static_cast<U &&>(right);
  }
};

struct not_equal_to {
  using is_transparent = void;

  template <class T, class U>
    requires equality_comparable_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(equal_to{}(
          static_cast<T &&>(left),
          static_cast<U &&>(right)))) {
    return !equal_to{}(
        static_cast<T &&>(left),
        static_cast<U &&>(right));
  }
};

struct greater {
  using is_transparent = void;

  template <class T, class U>
    requires totally_ordered_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(less{}(
          static_cast<U &&>(right),
          static_cast<T &&>(left)))) {
    return less{}(
        static_cast<U &&>(right),
        static_cast<T &&>(left));
  }
};

struct greater_equal {
  using is_transparent = void;

  template <class T, class U>
    requires totally_ordered_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(less{}(
          static_cast<T &&>(left),
          static_cast<U &&>(right)))) {
    return !less{}(
        static_cast<T &&>(left),
        static_cast<U &&>(right));
  }
};

struct less_equal {
  using is_transparent = void;

  template <class T, class U>
    requires totally_ordered_with<T, U>
  constexpr bool operator()(T &&left, U &&right) const
      noexcept(noexcept(less{}(
          static_cast<U &&>(right),
          static_cast<T &&>(left)))) {
    return !less{}(
        static_cast<U &&>(right),
        static_cast<T &&>(left));
  }
};

