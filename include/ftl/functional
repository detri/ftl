namespace detail {
template <class T> constexpr T *functional_addressof(T &value) noexcept {
#if defined(_MSC_VER) || __has_builtin(__builtin_addressof)
  return __builtin_addressof(value);
#else
  return &value;
#endif
}

template <class> inline constexpr bool is_reference_wrapper_v = false;
template <class T>
inline constexpr bool is_reference_wrapper_v<reference_wrapper<T>> = true;

template <class Member, class Object, class... Args>
constexpr decltype(auto) invoke_member_function(Member member, Object &&object,
                                                Args &&...args) {
  if constexpr (is_reference_wrapper_v<remove_cvref_t<Object>>)
    return (object.get().*member)(forward<Args>(args)...);
  else if constexpr (requires {
                       (forward<Object>(object).*
                        member)(forward<Args>(args)...);
                     })
    return (forward<Object>(object).*member)(forward<Args>(args)...);
  else
    return ((*forward<Object>(object)).*member)(forward<Args>(args)...);
}

template <class Member, class Object>
constexpr decltype(auto) invoke_member_object(Member member, Object &&object) {
  if constexpr (is_reference_wrapper_v<remove_cvref_t<Object>>)
    return object.get().*member;
  else if constexpr (requires { forward<Object>(object).*member; })
    return forward<Object>(object).*member;
  else
    return (*forward<Object>(object)).*member;
}

template <class T, class U>
concept has_member_greater = requires(T &&left, U &&right) {
  static_cast<T &&>(left).operator>(static_cast<U &&>(right));
};

template <class T, class U>
concept has_nonmember_greater = requires(T &&left, U &&right) {
  operator>(static_cast<T &&>(left), static_cast<U &&>(right));
};

template <class T, class U>
concept has_member_greater_equal = requires(T &&left, U &&right) {
  static_cast<T &&>(left).operator>=(static_cast<U &&>(right));
};

template <class T, class U>
concept has_nonmember_greater_equal = requires(T &&left, U &&right) {
  operator>=(static_cast<T &&>(left), static_cast<U &&>(right));
};

template <class T, class U>
concept has_member_less_equal = requires(T &&left, U &&right) {
  static_cast<T &&>(left).operator<=(static_cast<U &&>(right));
};

template <class T, class U>
concept has_nonmember_less_equal = requires(T &&left, U &&right) {
  operator<=(static_cast<T &&>(left), static_cast<U &&>(right));
};

template <class T, class U>
inline constexpr bool uses_builtin_object_pointer_greater_v =
    is_convertible_v<T, const volatile void *> &&
    is_convertible_v<U, const volatile void *> && !has_member_greater<T, U> &&
    !has_nonmember_greater<T, U> && !has_member_three_way<T, U> &&
    !has_nonmember_three_way<T, U>;

template <class T, class U>
inline constexpr bool uses_builtin_object_pointer_greater_equal_v =
    is_convertible_v<T, const volatile void *> &&
    is_convertible_v<U, const volatile void *> &&
    !has_member_greater_equal<T, U> && !has_nonmember_greater_equal<T, U> &&
    !has_member_three_way<T, U> && !has_nonmember_three_way<T, U>;

template <class T, class U>
inline constexpr bool uses_builtin_object_pointer_less_equal_v =
    is_convertible_v<T, const volatile void *> &&
    is_convertible_v<U, const volatile void *> &&
    !has_member_less_equal<T, U> && !has_nonmember_less_equal<T, U> &&
    !has_member_three_way<T, U> && !has_nonmember_three_way<T, U>;
} // namespace detail

template <class Callable, class... Args>
constexpr decltype(auto)
invoke(Callable &&callable,
       Args &&...args) noexcept(is_nothrow_invocable_v<Callable, Args...>) {

  if constexpr (is_member_function_pointer_v<remove_cvref_t<Callable>>)
    return detail::invoke_member_function(forward<Callable>(callable),
                                          forward<Args>(args)...);
  else if constexpr (is_member_object_pointer_v<remove_cvref_t<Callable>>)
    return detail::invoke_member_object(forward<Callable>(callable),
                                        forward<Args>(args)...);
  else
    return forward<Callable>(callable)(forward<Args>(args)...);
}

template <class R, class Callable, class... Args>
constexpr R invoke_r(Callable &&callable, Args &&...args) noexcept(
    is_nothrow_invocable_r_v<R, Callable, Args...>)
  requires is_invocable_r_v<R, Callable, Args...>
{
  if constexpr (is_void_v<R>)
    invoke(forward<Callable>(callable), forward<Args>(args)...);
  else
    return invoke(forward<Callable>(callable), forward<Args>(args)...);
}

template <class T> class reference_wrapper {
public:
  using type = T;

  constexpr reference_wrapper(T &value) noexcept
      : pointer{detail::functional_addressof(value)} {}
  reference_wrapper(T &&) = delete;

  constexpr operator T &() const noexcept { return *pointer; }
  constexpr T &get() const noexcept { return *pointer; }

  template <class... Args>
  constexpr invoke_result_t<T &, Args...> operator()(Args &&...args) const
      noexcept(is_nothrow_invocable_v<T &, Args...>) {
    return invoke(get(), forward<Args>(args)...);
  }

private:
  T *pointer;
};

template <class T> reference_wrapper(T &) -> reference_wrapper<T>;

template <class T> constexpr reference_wrapper<T> ref(T &value) noexcept {
  return reference_wrapper<T>{value};
}
template <class T> void ref(const T &&) = delete;
template <class T>
constexpr reference_wrapper<T> ref(reference_wrapper<T> value) noexcept {
  return value;
}

template <class T>
constexpr reference_wrapper<const T> cref(const T &value) noexcept {
  return reference_wrapper<const T>{value};
}
template <class T> void cref(const T &&) = delete;
template <class T>
constexpr reference_wrapper<const T> cref(reference_wrapper<T> value) noexcept {
  return {value.get()};
}

