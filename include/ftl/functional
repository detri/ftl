#define FTL_DETAIL_BINARY_FUNCTOR(Name, Op)                                    \
  template <class T = void> struct Name {                                      \
    constexpr T operator()(const T &a, const T &b) const                       \
        noexcept(noexcept(a Op b)) {                                           \
      return a Op b;                                                           \
    }                                                                          \
  };                                                                           \
  template <> struct Name<void> {                                              \
    using is_transparent = void;                                               \
    template <class T, class U>                                                \
    constexpr auto operator()(T &&a, U &&b) const                              \
        noexcept(noexcept(forward<T>(a) Op forward<U>(b)))                     \
            -> decltype(forward<T>(a) Op forward<U>(b)) {                      \
      return forward<T>(a) Op forward<U>(b);                                   \
    }                                                                          \
  }

