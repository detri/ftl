namespace detail {
template <class PatternIterator, class Iterator, class Predicate>
constexpr pair<Iterator, Iterator>
search_subsequence(PatternIterator pattern_first, PatternIterator pattern_last,
                   Iterator first, Iterator last, Predicate predicate) {
  if (pattern_first == pattern_last)
    return {first, first};
  for (Iterator candidate = first; candidate != last; ++candidate) {
    Iterator current = candidate;
    PatternIterator pattern = pattern_first;
    while (current != last && pattern != pattern_last &&
           predicate(*current, *pattern)) {
      ++current;
      ++pattern;
    }
    if (pattern == pattern_last)
      return {candidate, current};
    if (current == last)
      break;
  }
  return {last, last};
}
} // namespace detail

template <class ForwardIterator1, class BinaryPredicate = equal_to<>>
class default_searcher {
public:
  constexpr default_searcher(ForwardIterator1 first, ForwardIterator1 last,
                             BinaryPredicate predicate = BinaryPredicate())
      : first_(first), last_(last), predicate_(predicate) {}
  template <class ForwardIterator2>
  constexpr pair<ForwardIterator2, ForwardIterator2>
  operator()(ForwardIterator2 first, ForwardIterator2 last) const {
    return detail::search_subsequence(first_, last_, first, last, predicate_);
  }

private:
  ForwardIterator1 first_, last_;
  BinaryPredicate predicate_;
};

template <class RandomAccessIterator,
          class Hash =
              hash<typename iterator_traits<RandomAccessIterator>::value_type>,
          class BinaryPredicate = equal_to<>>
class boyer_moore_searcher {
public:
  boyer_moore_searcher(RandomAccessIterator first, RandomAccessIterator last,
                       Hash hash_function = Hash(),
                       BinaryPredicate predicate = BinaryPredicate())
      : first_(first), last_(last), hash_(hash_function),
        predicate_(predicate) {}
  template <class Iterator>
  pair<Iterator, Iterator> operator()(Iterator first, Iterator last) const {
    // ponytail: quadratic fallback; add skip tables when profiling warrants it.
    return detail::search_subsequence(first_, last_, first, last, predicate_);
  }

private:
  RandomAccessIterator first_, last_;
  Hash hash_;
  BinaryPredicate predicate_;
};

