namespace detail {
template <class F> class not_fn_t {
  F function;

public:
  template <class G>
  constexpr explicit not_fn_t(G &&value) : function(forward<G>(value)) {}
  template <class... A>
  constexpr auto operator()(A &&...args) & noexcept(
      noexcept(!invoke(function, forward<A>(args)...)))
      -> decltype(!invoke(function, forward<A>(args)...)) {
    return !invoke(function, forward<A>(args)...);
  }
  template <class... A>
  constexpr auto operator()(A &&...args) const & noexcept(
      noexcept(!invoke(function, forward<A>(args)...)))
      -> decltype(!invoke(function, forward<A>(args)...)) {
    return !invoke(function, forward<A>(args)...);
  }
  template <class... A>
  constexpr auto operator()(A &&...args) && noexcept(
      noexcept(!invoke(move(function), forward<A>(args)...)))
      -> decltype(!invoke(move(function), forward<A>(args)...)) {
    return !invoke(move(function), forward<A>(args)...);
  }
  template <class... A>
  constexpr auto operator()(A &&...args) const && noexcept(
      noexcept(!invoke(move(function), forward<A>(args)...)))
      -> decltype(!invoke(move(function), forward<A>(args)...)) {
    return !invoke(move(function), forward<A>(args)...);
  }
};
} // namespace detail

template <class F> constexpr auto not_fn(F &&function) {
  return detail::not_fn_t<decay_t<F>>(forward<F>(function));
}

namespace detail {
template <bool Back, class F, class... Stored> class bind_partial_t {
  F function;
  tuple<Stored...> stored;
  template <class Self, class... A, size_t... I>
  static constexpr decltype(auto) call(Self &&self, index_sequence<I...>,
                                       A &&...args) {
    if constexpr (Back)
      return invoke(forward<Self>(self).function, forward<A>(args)...,
                    get<I>(forward<Self>(self).stored)...);
    else
      return invoke(forward<Self>(self).function,
                    get<I>(forward<Self>(self).stored)..., forward<A>(args)...);
  }

public:
  template <class G, class... A>
  constexpr explicit bind_partial_t(G &&f, A &&...args)
      : function(forward<G>(f)), stored(forward<A>(args)...) {}
#define FTL_DETAIL_PARTIAL_CALL(Qual)                                          \
  template <class... A>                                                        \
  constexpr decltype(auto) operator()(A &&...a) Qual noexcept(                 \
      noexcept(call(static_cast<bind_partial_t Qual>(*this),                   \
                    index_sequence_for<Stored...>{}, forward<A>(a)...))) {     \
    return call(static_cast<bind_partial_t Qual>(*this),                       \
                index_sequence_for<Stored...>{}, forward<A>(a)...);            \
  }
  FTL_DETAIL_PARTIAL_CALL(&)
  FTL_DETAIL_PARTIAL_CALL(const &)
  FTL_DETAIL_PARTIAL_CALL(&&)
  FTL_DETAIL_PARTIAL_CALL(const &&)
#undef FTL_DETAIL_PARTIAL_CALL
};
} // namespace detail
template <class F, class... A>
constexpr auto bind_front(F &&function, A &&...args) {
  return detail::bind_partial_t<false, decay_t<F>, decay_t<A>...>(
      forward<F>(function), forward<A>(args)...);
}
template <class F, class... A>
constexpr auto bind_back(F &&function, A &&...args) {
  return detail::bind_partial_t<true, decay_t<F>, decay_t<A>...>(
      forward<F>(function), forward<A>(args)...);
}

