template <class> class function;
template <class R, class... Args> class function<R(Args...)> {
  template <class T> static const void *type_token() noexcept {
    static const unsigned char token{};
    return &token;
  }
  struct erased {
    virtual ~erased() = default;
    virtual erased *clone() const = 0;
    virtual R call(Args &&...) = 0;
#if FTL_HAS_RTTI
    virtual const type_info &type() const noexcept = 0;
#endif
    virtual const void *token() const noexcept = 0;
    virtual void *address() noexcept = 0;
    virtual const void *address() const noexcept = 0;
  };
  template <class F> struct model final : erased {
    F value;
    template <class G> explicit model(G &&object) : value(forward<G>(object)) {}
    erased *clone() const override { return new model(value); }
    R call(Args &&...args) override {
      return invoke_r<R>(value, forward<Args>(args)...);
    }
#if FTL_HAS_RTTI
    const type_info &type() const noexcept override { return typeid(F); }
#endif
    const void *token() const noexcept override { return type_token<F>(); }
    void *address() noexcept override { return &value; }
    const void *address() const noexcept override { return &value; }
  };
  erased *target_ = nullptr;

public:
  using result_type = R;
  function() noexcept = default;
  function(nullptr_t) noexcept {}
  function(const function &other)
      : target_(other.target_ ? other.target_->clone() : nullptr) {}
  function(function &&other) noexcept
      : target_(exchange(other.target_, nullptr)) {}
  template <class F>
    requires(!is_same_v<remove_cvref_t<F>, function>) &&
            is_copy_constructible_v<decay_t<F>> &&
            is_invocable_r_v<R, decay_t<F> &, Args...>
  function(F &&value) {
    using T = decay_t<F>;
    if constexpr (is_pointer_v<T> || is_member_pointer_v<T>)
      if (!value)
        return;
    target_ = new model<T>(forward<F>(value));
  }
  ~function() { delete target_; }
  function &operator=(const function &other) {
    function(other).swap(*this);
    return *this;
  }
  function &operator=(function &&other) noexcept {
    function(move(other)).swap(*this);
    return *this;
  }
  function &operator=(nullptr_t) noexcept {
    delete target_;
    target_ = nullptr;
    return *this;
  }
  template <class F> function &operator=(F &&value) {
    function(forward<F>(value)).swap(*this);
    return *this;
  }
  template <class F> function &operator=(reference_wrapper<F> value) noexcept {
    function(value).swap(*this);
    return *this;
  }
  void swap(function &other) noexcept {
    auto *value = target_;
    target_ = other.target_;
    other.target_ = value;
  }
  explicit operator bool() const noexcept { return target_ != nullptr; }
  R operator()(Args... args) const {
    if (!target_) {
#if FTL_HAS_EXCEPTIONS
      throw bad_function_call{};
#else
      terminate();
#endif
    }
    return target_->call(forward<Args>(args)...);
  }
#if FTL_HAS_RTTI
  const type_info &target_type() const noexcept {
    return target_ ? target_->type() : typeid(void);
  }
#endif
  template <class T> T *target() noexcept {
    using U = remove_cv_t<T>;

    return target_ && target_->token() == type_token<U>()
               ? static_cast<T *>(target_->address())
               : nullptr;
  }
  template <class T> const T *target() const noexcept {
    using U = remove_cv_t<T>;

    return target_ && target_->token() == type_token<U>()
               ? static_cast<const T *>(target_->address())
               : nullptr;
  }
};
template <class R, class... A>
void swap(function<R(A...)> &left, function<R(A...)> &right) noexcept {
  left.swap(right);
}
template <class R, class... A>
bool operator==(const function<R(A...)> &value, nullptr_t) noexcept {
  return !value;
}

