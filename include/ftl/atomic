enum class memory_order : unsigned char {
  relaxed,
  consume,
  acquire,
  release,
  acq_rel,
  seq_cst
};

inline constexpr memory_order memory_order_relaxed = memory_order::relaxed;
inline constexpr memory_order memory_order_consume = memory_order::consume;
inline constexpr memory_order memory_order_acquire = memory_order::acquire;
inline constexpr memory_order memory_order_release = memory_order::release;
inline constexpr memory_order memory_order_acq_rel = memory_order::acq_rel;
inline constexpr memory_order memory_order_seq_cst = memory_order::seq_cst;

template <class T> T kill_dependency(T value) noexcept { return value; }

namespace detail {

constexpr memory_order atomic_failure_order(memory_order order) noexcept {
  if (order == memory_order_release)
    return memory_order_relaxed;

  if (order == memory_order_acq_rel)
    return memory_order_acquire;

  return order;
}

template <class T>
concept atomic_object_pointer =
    is_pointer_v<T> && is_object_v<remove_pointer_t<T>> &&
    requires { sizeof(remove_pointer_t<T>); };

template <class T>
concept atomic_integral = is_integral_v<T> && !is_same_v<remove_cv_t<T>, bool>;

template <class T>
concept atomic_floating = is_floating_point_v<T>;

template <class T>
concept atomic_additive =
    atomic_integral<T> || atomic_floating<T> || atomic_object_pointer<T>;

template <class T, bool IsPointer = is_pointer_v<T>,
          bool HasValueDifference = atomic_integral<T> || atomic_floating<T>>
struct atomic_difference_type {};

template <class T> struct atomic_difference_type<T, true, false> {
  using difference_type = ptrdiff_t;
};

template <class T> struct atomic_difference_type<T, false, true> {
  using difference_type = T;
};

template <class T>
using atomic_operand_t = conditional_t<is_pointer_v<T>, ptrdiff_t, T>;

template <size_t Size> struct atomic_word;

template <> struct atomic_word<1> {
  using type = uint8_t;
};

template <> struct atomic_word<2> {
  using type = uint16_t;
};

template <> struct atomic_word<4> {
  using type = uint32_t;
};

template <> struct atomic_word<8> {
  using type = uint64_t;
};

template <class T> using atomic_word_t = typename atomic_word<sizeof(T)>::type;

template <class T> atomic_word_t<T> atomic_to_word(const T &value) noexcept {
  return bit_cast<atomic_word_t<T>>(value);
}

template <class T> T atomic_from_word(atomic_word_t<T> value) noexcept {
  return bit_cast<T>(value);
}

template <class T>
constexpr T atomic_integral_add(T left, T right) noexcept
  requires atomic_integral<T>
{
  using U = make_unsigned_t<T>;

  return static_cast<T>(static_cast<U>(left) + static_cast<U>(right));
}

template <class T>
constexpr T atomic_integral_sub(T left, T right) noexcept
  requires atomic_integral<T>
{
  using U = make_unsigned_t<T>;

  return static_cast<T>(static_cast<U>(left) - static_cast<U>(right));
}

template <class T>
T atomic_pointer_add(T pointer, ptrdiff_t amount) noexcept
  requires atomic_object_pointer<T>
{
  using word_type = atomic_word_t<T>;

  constexpr word_type scale =
      static_cast<word_type>(sizeof(remove_pointer_t<T>));

  const word_type bits = atomic_to_word(pointer);

  const word_type offset = static_cast<word_type>(amount) * scale;

  return atomic_from_word<T>(static_cast<word_type>(bits + offset));
}

template <class T>
T atomic_pointer_sub(T pointer, ptrdiff_t amount) noexcept
  requires atomic_object_pointer<T>
{
  using word_type = atomic_word_t<T>;

  constexpr word_type scale =
      static_cast<word_type>(sizeof(remove_pointer_t<T>));

  const word_type bits = atomic_to_word(pointer);

  const word_type offset = static_cast<word_type>(amount) * scale;

  return atomic_from_word<T>(static_cast<word_type>(bits - offset));
}

