template <class T>
T atomic_load_object(const volatile T *value, memory_order order) noexcept {
  using word_type = atomic_word_t<T>;

  const auto *word = reinterpret_cast<const volatile word_type *>(value);

  return atomic_from_word<T>(msvc_atomic_word_load(word, order));
}

template <class T>
void atomic_store_object(volatile T *value, T desired,
                         memory_order order) noexcept {
  using word_type = atomic_word_t<T>;

  auto *word = reinterpret_cast<volatile word_type *>(value);

  msvc_atomic_word_store(word, atomic_to_word(desired), order);
}

template <class T>
T atomic_exchange_object(volatile T *value, T desired, memory_order) noexcept {
  using word_type = atomic_word_t<T>;

  auto *word = reinterpret_cast<volatile word_type *>(value);

  return atomic_from_word<T>(
      msvc_atomic_word_exchange(word, atomic_to_word(desired)));
}

template <class T>
bool atomic_compare_exchange_object(volatile T *value, T &expected, T desired,
                                    bool, memory_order, memory_order) noexcept {
  using word_type = atomic_word_t<T>;

  auto *word = reinterpret_cast<volatile word_type *>(value);

  const word_type expected_word = atomic_to_word(expected);

  const word_type observed = msvc_atomic_word_compare_exchange(
      word, atomic_to_word(desired), expected_word);

  if (observed == expected_word)
    return true;

  expected = atomic_from_word<T>(observed);
  return false;
}

