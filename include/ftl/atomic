template <class Word>
Word msvc_atomic_word_load(const volatile Word *value,
                           memory_order order) noexcept {
  Word result;

  if constexpr (sizeof(Word) == 1) {
    result = static_cast<Word>(
        __iso_volatile_load8(reinterpret_cast<const volatile __int8 *>(value)));
  } else if constexpr (sizeof(Word) == 2) {
    result = static_cast<Word>(__iso_volatile_load16(
        reinterpret_cast<const volatile __int16 *>(value)));
  } else if constexpr (sizeof(Word) == 4) {
    result = static_cast<Word>(__iso_volatile_load32(
        reinterpret_cast<const volatile __int32 *>(value)));
  } else {
    result = static_cast<Word>(__iso_volatile_load64(
        reinterpret_cast<const volatile __int64 *>(value)));
  }

  if (order == memory_order_consume || order == memory_order_acquire ||
      order == memory_order_seq_cst) {
    _ReadWriteBarrier();
  }

  return result;
}

template <class Word>
void msvc_atomic_word_store(volatile Word *value, Word desired,
                            memory_order order) noexcept {
  if (order == memory_order_seq_cst) {
    if constexpr (sizeof(Word) == 1) {
      (void)_InterlockedExchange8(reinterpret_cast<volatile char *>(value),
                                  static_cast<char>(desired));
    } else if constexpr (sizeof(Word) == 2) {
      (void)_InterlockedExchange16(reinterpret_cast<volatile short *>(value),
                                   static_cast<short>(desired));
    } else if constexpr (sizeof(Word) == 4) {
      (void)_InterlockedExchange(reinterpret_cast<volatile long *>(value),
                                 static_cast<long>(desired));
    } else {
      (void)_InterlockedExchange64(reinterpret_cast<volatile __int64 *>(value),
                                   static_cast<__int64>(desired));
    }

    return;
  }

  if (order == memory_order_release)
    _ReadWriteBarrier();

  if constexpr (sizeof(Word) == 1) {
    __iso_volatile_store8(reinterpret_cast<volatile __int8 *>(value),
                          static_cast<__int8>(desired));
  } else if constexpr (sizeof(Word) == 2) {
    __iso_volatile_store16(reinterpret_cast<volatile __int16 *>(value),
                           static_cast<__int16>(desired));
  } else if constexpr (sizeof(Word) == 4) {
    __iso_volatile_store32(reinterpret_cast<volatile __int32 *>(value),
                           static_cast<__int32>(desired));
  } else {
    __iso_volatile_store64(reinterpret_cast<volatile __int64 *>(value),
                           static_cast<__int64>(desired));
  }
}

