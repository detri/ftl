template <class T>
bool atomic_compare_exchange_object(volatile T *value, T &expected, T desired,
                                    bool weak, memory_order success,
                                    memory_order failure) noexcept {
  using word_type = atomic_word_t<T>;

  auto *word = reinterpret_cast<volatile word_type *>(value);

  word_type expected_word = atomic_to_word(expected);

  const bool exchanged = __atomic_compare_exchange_n(
      word, &expected_word, atomic_to_word(desired), weak,
      atomic_builtin_order(success), atomic_builtin_order(failure));

  if (!exchanged)
    expected = atomic_from_word<T>(expected_word);

  return exchanged;
}

