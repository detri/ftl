extern "C" inline void atomic_thread_fence(memory_order order) noexcept {
#if defined(_MSC_VER)
  if (order == memory_order_relaxed)
    return;

  if (order == memory_order_seq_cst) {
    volatile long barrier = 0;
    (void)detail::_InterlockedExchangeAdd(&barrier, 0);
    return;
  }

  detail::_ReadWriteBarrier();
#else
  __atomic_thread_fence(detail::atomic_builtin_order(order));
#endif
}

extern "C" inline void atomic_signal_fence(memory_order order) noexcept {
#if defined(_MSC_VER)
  if (order != memory_order_relaxed)
    detail::_ReadWriteBarrier();
#else
  __atomic_signal_fence(detail::atomic_builtin_order(order));
#endif
}

