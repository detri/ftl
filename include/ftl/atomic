template <class T>
inline constexpr bool atomic_native_word_size_v =
    sizeof(T) == 1 || sizeof(T) == 2 || sizeof(T) == 4 || sizeof(T) == 8;

template <class T>
inline constexpr bool atomic_native_lock_free_v = [] {
  if constexpr (!atomic_native_word_size_v<T>) {
    return false;
  } else {
#if defined(_MSC_VER)
    return true;
#else
    return __atomic_always_lock_free(sizeof(T), nullptr);
#endif
  }
}();

template <class T>
inline constexpr size_t atomic_storage_alignment_v =
    atomic_native_lock_free_v<T>
        ? (alignof(T) > sizeof(T) ? alignof(T) : sizeof(T))
        : alignof(T);

template <class T>
struct atomic_object_bytes {
  unsigned char data[sizeof(T)];
};

template <class T>
inline constexpr bool atomic_might_have_non_value_bits_v =
    !has_unique_object_representations_v<T> &&
    !is_floating_point_v<T>;

#if defined(__clang__)

#if __has_builtin(__builtin_clear_padding)
inline constexpr bool atomic_padding_normalization_supported = true;
#else
inline constexpr bool atomic_padding_normalization_supported = false;
#endif

#elif defined(_MSC_VER)

inline constexpr bool atomic_padding_normalization_supported = true;

#elif defined(__GNUC__)

inline constexpr bool atomic_padding_normalization_supported = true;

#else

inline constexpr bool atomic_padding_normalization_supported = false;

#endif

template <class T>
void atomic_clear_non_value_bits(T &value) noexcept {
  if constexpr (!atomic_might_have_non_value_bits_v<T>) {
    return;
  }

#if defined(__clang__)

#if __has_builtin(__builtin_clear_padding)
  __builtin_clear_padding(&value);
#else
  (void)value;
#endif

#elif defined(_MSC_VER)

  ::__builtin_zero_non_value_bits(&value);

#elif defined(__GNUC__)

  __builtin_clear_padding(&value);

#else

  (void)value;

#endif
}

template <class T>
atomic_object_bytes<T>
atomic_object_read_bytes(const volatile T *value) noexcept {
  atomic_object_bytes<T> result{};

  const auto *source =
      reinterpret_cast<const volatile unsigned char *>(value);

  for (size_t index = 0; index < sizeof(T); ++index)
    result.data[index] = source[index];

  return result;
}

template <class T>
T atomic_object_read(const volatile T *value) noexcept {
  return bit_cast<T>(
      atomic_object_read_bytes(value));
}

template <class T>
void atomic_object_write(volatile T *value, const T &desired) noexcept {
  const auto bytes =
      bit_cast<atomic_object_bytes<T>>(desired);

  auto *destination =
      reinterpret_cast<volatile unsigned char *>(value);

  for (size_t index = 0; index < sizeof(T); ++index)
    destination[index] = bytes.data[index];
}

template <class T>
bool atomic_bytes_equal(
    const atomic_object_bytes<T> &left,
    const atomic_object_bytes<T> &right) noexcept {
  for (size_t index = 0; index < sizeof(T); ++index) {
    if (left.data[index] != right.data[index])
      return false;
  }

  return true;
}

template <class T>
atomic_object_bytes<T>
atomic_normalized_bytes(const T &value) noexcept {
  auto bytes =
      bit_cast<atomic_object_bytes<T>>(value);

  if constexpr (
      atomic_might_have_non_value_bits_v<T> &&
      atomic_padding_normalization_supported) {
    T normalized =
        bit_cast<T>(bytes);

    atomic_clear_non_value_bits(
        normalized);

    bytes =
        bit_cast<atomic_object_bytes<T>>(
            normalized);
  }

  return bytes;
}

template <class T>
bool atomic_value_representation_equal(
    const T &left,
    const T &right) noexcept {
  return atomic_bytes_equal(
      atomic_normalized_bytes(left),
      atomic_normalized_bytes(right));
}

struct alignas(64) atomic_object_bucket {
  uint32_t locked = 0;
  uint32_t version = 0;
};

inline atomic_object_bucket atomic_object_buckets[64]{};

inline atomic_object_bucket &
atomic_object_bucket_for(const volatile void *address) noexcept {
  const auto bits =
      reinterpret_cast<uintptr_t>(const_cast<const void *>(address));

  const size_t index = static_cast<size_t>(((bits >> 4) ^ (bits >> 10)) & 63u);

  return atomic_object_buckets[index];
}

inline void atomic_object_lock(atomic_object_bucket &bucket) noexcept {
  for (;;) {
    uint32_t expected = 0;

    if (atomic_compare_exchange_object(&bucket.locked, expected, uint32_t{1},
                                       false, memory_order_seq_cst,
                                       memory_order_seq_cst)) {
      return;
    }

    atomic_wait_until_changed<4>(
        &bucket.locked, uint32_t{1}, [&bucket]() noexcept {
          return atomic_load_object(&bucket.locked, memory_order_relaxed);
        });
  }
}

inline void atomic_object_unlock(atomic_object_bucket &bucket) noexcept {
  atomic_store_object(&bucket.locked, uint32_t{0}, memory_order_seq_cst);

  atomic_notify_one<4>(&bucket.locked);
}

class atomic_object_guard {
public:
  explicit atomic_object_guard(const volatile void *address) noexcept
      : bucket_(atomic_object_bucket_for(address)) {
    atomic_object_lock(bucket_);
  }

  atomic_object_guard(const atomic_object_guard &) = delete;

  atomic_object_guard &operator=(const atomic_object_guard &) = delete;

  ~atomic_object_guard() { atomic_object_unlock(bucket_); }

private:
  atomic_object_bucket &bucket_;
};

template <class T> T atomic_locked_load(const volatile T *value) noexcept {
  atomic_object_guard hold{value};

  return atomic_object_read(value);
}

template <class T>
void atomic_locked_store(volatile T *value, T desired) noexcept {
  atomic_object_guard hold{value};

  atomic_object_write(value, desired);
}

template <class T>
T atomic_locked_exchange(volatile T *value, T desired) noexcept {
  atomic_object_guard hold{value};

  T old = atomic_object_read(value);

  atomic_object_write(value, desired);

  return old;
}

template <class T>
bool atomic_locked_compare_exchange(
    volatile T *value,
    T &expected,
    T desired) noexcept {
  atomic_object_guard hold{value};

  const T observed =
      atomic_object_read(value);

  if (atomic_value_representation_equal(
          observed,
          expected)) {
    atomic_object_write(
        value,
        desired);

    return true;
  }

  // Do not use operator=. atomic_ref<T> only requires
  // T to be trivially copyable, not copy-assignable.
  atomic_object_write(
      &expected,
      observed);

  return false;
}

template <class T>
void atomic_locked_wait(
    const volatile T *value,
    T old) noexcept {
  auto &bucket =
      atomic_object_bucket_for(value);

  for (;;) {
    {
      atomic_object_guard hold{value};

      const T observed =
          atomic_object_read(value);

      if (!atomic_value_representation_equal(
              observed,
              old)) {
        return;
      }
    }

    const uint32_t version =
        atomic_load_object(
            &bucket.version,
            memory_order_seq_cst);

    // Close the lost-wakeup window between checking
    // the value and blocking on the proxy version.
    {
      atomic_object_guard hold{value};

      const T observed =
          atomic_object_read(value);

      if (!atomic_value_representation_equal(
              observed,
              old)) {
        return;
      }
    }

    atomic_wait_until_changed<4>(
        &bucket.version,
        version,
        [&bucket]() noexcept {
          return atomic_load_object(
              &bucket.version,
              memory_order_relaxed);
        });
  }
}

inline void atomic_locked_notify(const volatile void *value) noexcept {
  auto &bucket = atomic_object_bucket_for(value);

  (void)atomic_fetch_add_integral(&bucket.version, uint32_t{1},
                                  memory_order_seq_cst);

  // Buckets are shared by unrelated objects.
  // Wake-all prevents notify_one from waking
  // the wrong object's waiter and stranding
  // the intended waiter.
  atomic_notify_all<4>(&bucket.version);
}

template<class T>
T atomic_dispatch_load(
    const volatile T* value,
    memory_order order) noexcept {
    if constexpr (atomic_native_lock_free_v<T>) {
        return atomic_load_object(
            value,
            order);
    } else {
        return atomic_locked_load(
            value);
    }
}

