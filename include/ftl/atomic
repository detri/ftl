template<class T>
bool atomic_dispatch_compare_exchange(
    volatile T* value,
    T& expected,
    T desired,
    bool weak,
    memory_order success,
    memory_order failure) noexcept {
    if constexpr (!atomic_native_lock_free_v<T>) {
        return atomic_locked_compare_exchange(
            value,
            expected,
            desired);
    } else if constexpr (
        !atomic_might_have_non_value_bits_v<T> ||
        !atomic_padding_normalization_supported
    ) {
        return atomic_compare_exchange_object(
            value,
            expected,
            desired,
            weak,
            success,
            failure);
    } else {
        // Hardware CAS compares the whole representation.
        // First compare value representations ourselves,
        // then use the actually observed raw representation
        // as the hardware comparand.
        T observed =
            atomic_load_object(
                value,
                failure);

        for (;;) {
            if (!atomic_value_representation_equal(
                    observed,
                    expected)) {
                atomic_object_write(
                    &expected,
                    observed);

                return false;
            }

            T raw_expected = observed;

            if (atomic_compare_exchange_object(
                    value,
                    raw_expected,
                    desired,
                    weak,
                    success,
                    failure)) {
                return true;
            }

            if (weak) {
                atomic_object_write(
                    &expected,
                    raw_expected);

                return false;
            }

            observed = raw_expected;
        }
    }
}

template<class T>
void atomic_dispatch_wait(
    const volatile T* value,
    T old,
    memory_order order) noexcept {
    if constexpr (!atomic_native_lock_free_v<T>) {
        atomic_locked_wait(
            value,
            old);
    } else if constexpr (
        !atomic_might_have_non_value_bits_v<T> ||
        !atomic_padding_normalization_supported
    ) {
        using word_type =
            atomic_word_t<T>;

        const word_type old_word =
            atomic_to_word(old);

        atomic_wait_until_changed<
            sizeof(T)>(
                value,
                old_word,
                [value, order]() noexcept
                    -> word_type {
                    return atomic_to_word(
                        atomic_load_object(
                            value,
                            order));
                });
    } else {
        using word_type =
            atomic_word_t<T>;

        for (;;) {
            const T observed =
                atomic_load_object(
                    value,
                    order);

            if (!atomic_value_representation_equal(
                    observed,
                    old)) {
                return;
            }

            const word_type observed_word =
                atomic_to_word(observed);

            atomic_wait_until_changed<
                sizeof(T)>(
                    value,
                    observed_word,
                    [value, order]() noexcept
                        -> word_type {
                        return atomic_to_word(
                            atomic_load_object(
                                value,
                                order));
                    });

            // Raw bits changed. They may have been
            // padding-only, so loop and perform the
            // semantic comparison again.
        }
    }
}

template<class T>
void atomic_dispatch_notify_one(
    const volatile T* value) noexcept {
    if constexpr (atomic_native_lock_free_v<T>) {
        atomic_notify_one<sizeof(T)>(
            value);
    } else {
        atomic_locked_notify(
            value);
    }
}

template<class T>
void atomic_dispatch_notify_all(
    const volatile T* value) noexcept {
    if constexpr (atomic_native_lock_free_v<T>) {
        atomic_notify_all<sizeof(T)>(
            value);
    } else {
        // Shared proxy buckets require wake-all even
        // for notify_one, so this currently has the
        // same implementation.
        atomic_locked_notify(
            value);
    }
}

template<class T>
T atomic_dispatch_fetch_add(
    volatile T* value,
    atomic_operand_t<T> operand,
    memory_order order) noexcept
  requires atomic_additive<T>
{
    if constexpr (
        atomic_integral<T> &&
        atomic_native_lock_free_v<T>
    ) {
        return atomic_fetch_add_integral(
            value,
            operand,
            order);
    } else {
        T current =
            atomic_dispatch_load(
                value,
                memory_order_relaxed);

        for (;;) {
            T desired;

            if constexpr (atomic_integral<T>) {
                desired =
                    atomic_integral_add(
                        current,
                        operand);
            } else if constexpr (
                atomic_floating<T>
            ) {
                desired =
                    static_cast<T>(
                        current + operand);
            } else {
                desired =
                    atomic_pointer_add(
                        current,
                        operand);
            }

            if (atomic_dispatch_compare_exchange(
                    value,
                    current,
                    desired,
                    true,
                    order,
                    memory_order_relaxed)) {
                return current;
            }
        }
    }
}

